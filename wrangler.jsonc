{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "site-01-moscow-avtokran",
  "compatibility_date": "2026-08-17",
  "observability": {
    "enabled": true
  },
  // Без "main": сайт чисто статический (см. astro.config.mjs) — Cloudflare
  // отдаёт файлы из dist/ напрямую через ASSETS, без выполнения воркер-кода
  // на каждый запрос. Раньше здесь стоял "main": "dist/_worker.js/index.js"
  // от автоматического astro add cloudflare — это и ломало "/" в 404
  // (index.astro пытался рендериться на лету вместо отдачи готового HTML).
  // Адрес *.workers.dev отключён намеренно.
  //
  // Cloudflare по умолчанию поднимает воркер ещё и на служебном поддомене вида
  // site-01-moscow-avtokran.kran-network-leads.workers.dev — открытом наружу,
  // отдающем HTTP 200 и индексируемом. Это два вреда сразу.
  //
  // Первый: полный дубль сайта по второму адресу. Один и тот же контент по двум
  // хостам — это ровно та ситуация, из-за которой один из адресов признают
  // неглавным зеркалом.
  //
  // Второй, и он тяжелее: в самом имени хоста стоят обе строки, которые мы
  // вычищали из сборок — номер сайта в сети (site-01) и поддомен аккаунта
  // (kran-network-leads). Поддомен аккаунта общий, поэтому КАЖДЫЙ сайт,
  // задеплоенный сюда, объявлял бы сеть прямо в адресе, сколько бы мы ни
  // чистили HTML и JS.
  //
  // Сайт остаётся доступен по своему домену moskran-servis.ru (Custom Domain,
  // привязан в панели Cloudflare) — эта привязка от workers_dev не зависит.
  "workers_dev": false,
  "assets": {
    "directory": "dist"
  }
}
