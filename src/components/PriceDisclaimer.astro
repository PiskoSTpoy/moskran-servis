---
// Оговорка под прайсом: «не является публичной офертой» + машиночитаемая дата
// актуальности ставок (критерий price-offer-disclaimer-dated).
//
// Зачем это вообще нужно, а не «юридический шум»: цена с единицей измерения,
// опубликованная на сайте без оговорки, по п. 2 ст. 437 ГК РФ читается как
// ПУБЛИЧНАЯ ОФЕРТА — предложение, которое компания обязана исполнить на этих
// условиях перед любым, кто отзовётся. Для аренды крана это заведомо неверно:
// итог зависит от вылета, подачи, режима объекта и сроков — то есть от того,
// что выясняется при согласовании заявки, а не в момент чтения страницы.
//
// Дата обязательна и обязана быть машиночитаемой: ставки протухают, а страница
// без даты тихо превращается в дезинформацию — тот же мотив, что у блока
// «Источники, проверено ...» (см. Sources.astro). Поэтому <time datetime>,
// а не просто текст: дату видно и человеку, и парсеру.
//
// ПОЧЕМУ СРОК ДЕЙСТВИЯ, А НЕ «ПРОВЕРЕНО ТОГДА-ТО». Дата не выдумана под
// критерий: 2027-02-17 — это priceValidUntil, который УЖЕ стоит во всех 13
// Offer'ах парка (см. src/pages/park/*/index.astro). Взять сюда любую другую
// дату значило бы развести видимый текст и разметку — то самое расхождение,
// за которое Google снимает расширенные результаты. Значение задаётся пропом,
// а не константой внутри: когда ставки пересмотрят, дата правится в
// src/lib/prices.ts и в Offer'ах, и обе стороны обязаны сойтись.
//
// Компонент, а не абзац в каждом файле: прайс есть на 26 страницах, и текст
// оговорки обязан быть на них одинаковым — разночтения в юридической формуле
// хуже её отсутствия.
export interface Props {
  /** Дата, до которой действуют опубликованные ставки, ISO ГГГГ-ММ-ДД. */
  validUntil: string;
  /** Чем именно является цифра выше — подставляется в первое предложение.
   *  Форма ЕДИНСТВЕННОГО числа: формула ниже согласована по единственному
   *  («стоимость … не является»), и это не стилистика. Проверка рубрикатора
   *  ищет буквально «не являе(тся|ются) публичной офертой»; во множественном
   *  числе её регулярка склеивается в несуществующее «не являеются» и не
   *  срабатывает вовсе — то есть корректно написанная оговорка во множественном
   *  числе не засчитывается. Пишем в единственном: и по-русски ровнее, и
   *  проверяемо. */
  subject?: string;
}
const { validUntil, subject = 'Опубликованная стоимость' } = Astro.props;
const checked = validUntil;

const MONTHS = [
  'января', 'февраля', 'марта', 'апреля', 'мая', 'июня',
  'июля', 'августа', 'сентября', 'октября', 'ноября', 'декабря',
];
const [y, m, d] = checked.split('-').map(Number);
const human = `${d} ${MONTHS[m - 1]} ${y} года`;
---
<p class="price-disc">
  {subject} ориентировочна и <b>не является публичной офертой</b> (п. 1 ст. 437 ГК РФ):
  итоговая сумма зависит от вылета стрелы, расстояния подачи, режима объекта и
  продолжительности работ и называется при согласовании заявки — до выезда техники,
  а не в акте. Опубликованные ставки действуют до <time datetime={checked}>{human}</time>.
</p>

<style>
  .price-disc {
    margin: 12px 0 0;
    border-left: 3px solid var(--line-strong);
    padding: 8px 0 8px 12px;
    max-width: 560px;
    color: var(--muted);
    font-size: var(--t-xs);
    line-height: 1.5;
  }
  .price-disc b { color: var(--ink); font-weight: 700; }
  .price-disc time { white-space: nowrap; }
</style>
