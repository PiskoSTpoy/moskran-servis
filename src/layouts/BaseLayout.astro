  <script>
    // Мобильная CTA-панель: два необязательных улучшения поверх работающей без JS вёрстки.
    (function () {
      const bar = document.getElementById('mobile-cta');
      if (!bar) return;

      // 1) Точный отступ снизу. CSS уже резервирует расчётную высоту, но при
      //    увеличенном шрифте (зум 200%, WCAG 1.4.4) или другом safe-area реальная
      //    высота отличается — измеряем и переписываем переменную фактическим значением.
      const syncSpace = () => {
        const h = bar.getBoundingClientRect().height;
        if (h > 0) document.documentElement.style.setProperty('--mcta-space', h + 'px');
        else document.documentElement.style.removeProperty('--mcta-space');
      };
      syncSpace();
      window.addEventListener('resize', syncSpace);
      window.addEventListener('orientationchange', syncSpace);
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(syncSpace).catch(() => {});

      // 2) Панель уходит, когда форма заявки и так на экране — она бы только
      //    закрывала её. Только ДОБАВЛЯЕТ класс при пересечении: если
      //    IntersectionObserver не поддерживается или ни разу не сработает,
      //    панель просто остаётся видимой (безопасный fallback, не исчезает навсегда).
      const order = document.getElementById('zayavka');
      if (order && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => bar.classList.toggle('is-hidden', e.isIntersecting));
          },
          { threshold: 0.15 }
        );
        io.observe(order);
      }
    })();
  </script>


  <script>
    // Волна 13-D — 3D-наклон карточек-ссылок и блик, идущий за курсором.
    // Скрипт НИЧЕГО не показывает и не прячет: он только пишет четыре CSS-переменные
    // (--rx/--ry — угол, --gx/--gy — центр блика), которые CSS применяет внутри уже
    // существующего hover-состояния. Не подключился скрипт — карточка ведёт себя как
    // в Волне 10 (подъём + жёсткая тень + блик по центру сверху).
    (function initCardTilt() {
      const SELECTOR = 'a.park-card, a.keysy-card, a.post-card';
      const cards = Array.from(document.querySelectorAll<HTMLElement>(SELECTOR));
      if (!cards.length) return;

      // Явные JS-гейты, а не только CSS @media: при reduced-motion ИЛИ грубом
      // указателе (тач) слушатели не навешиваются вовсе — нулевая цена на мобильных.
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const finePointer = window.matchMedia('(pointer: fine)');

      const MAX_DEG = 6; // ровно ±6°, как в постановке
      let attached = false;

      function onMove(e: PointerEvent) {
        const card = e.currentTarget as HTMLElement;
        const rect = card.getBoundingClientRect();
        if (!rect.width || !rect.height) return;
        const px = (e.clientX - rect.left) / rect.width;   // 0..1
        const py = (e.clientY - rect.top) / rect.height;   // 0..1
        // Курсор у правого края → карта поворачивается правым краем от зрителя.
        card.style.setProperty('--ry', ((px - 0.5) * 2 * MAX_DEG).toFixed(2) + 'deg');
        card.style.setProperty('--rx', ((0.5 - py) * 2 * MAX_DEG).toFixed(2) + 'deg');
        card.style.setProperty('--gx', (px * 100).toFixed(1) + '%');
        card.style.setProperty('--gy', (py * 100).toFixed(1) + '%');
      }

      function reset(card: HTMLElement) {
        card.style.removeProperty('--rx');
        card.style.removeProperty('--ry');
        card.style.removeProperty('--gx');
        card.style.removeProperty('--gy');
      }

      function onLeave(e: PointerEvent) { reset(e.currentTarget as HTMLElement); }

      function attach() {
        if (attached) return;
        attached = true;
        // pointermove вешается на сами карточки, а не на документ: он не срабатывает,
        // пока курсор вне карточки, поэтому «дорогих» глобальных обработчиков нет.
        cards.forEach((c) => {
          c.addEventListener('pointermove', onMove);
          c.addEventListener('pointerleave', onLeave);
        });
      }

      function detach() {
        if (!attached) return;
        attached = false;
        cards.forEach((c) => {
          c.removeEventListener('pointermove', onMove);
          c.removeEventListener('pointerleave', onLeave);
          reset(c);
        });
      }

      function evaluate() {
        if (reduceMotion.matches || !finePointer.matches) detach();
        else attach();
      }

      evaluate();
      reduceMotion.addEventListener('change', evaluate);
      finePointer.addEventListener('change', evaluate);
    })();
  </script>
