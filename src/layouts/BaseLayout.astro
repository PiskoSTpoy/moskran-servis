  {/* Волна 12 — мобильная закреплённая CTA-панель. Две обычные ссылки: без JS
      работает в полном объёме. Телефон — тот же, что в шапке, подвале и на
      странице контактов (единственный телефон сайта). В конце <body>, чтобы не
      разрывать tab-порядок страницы: панель визуально последняя и в DOM тоже. */}
  <nav class="mcta" id="mobile-cta" aria-label="Быстрые действия">
    <a class="mcta__btn mcta__btn--primary" href="/#zayavka">Заказать кран</a>
    <a class="mcta__btn mcta__btn--call" href="tel:+79032690060">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.2a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>
      <span>Позвонить</span>
    </a>
