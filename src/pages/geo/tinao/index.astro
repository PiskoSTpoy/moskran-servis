---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ZoneTable from '../../../components/ZoneTable.astro';

const title = 'Аренда автокрана в Новой Москве (ТиНАО) — Коммунарка';
const description = 'Автокран в Новой Москве: Новомосковский и Троицкий округа. Новая застройка Коммунарки и Саларьева, большие расстояния и меньше ограничений.';

// Волна 39: сводная таблица зон округа. Ни одного нового факта — это
// пересборка того, что ниже на этой же странице сказано прозой. У строки
// таблицы есть подпись столбца, поэтому значение достаётся без чтения
// всего абзаца — и человеком, и языковой моделью, которая цитирует
// страницу в ответе (критерий рубрикатора geo-table-present).
const zoneRows = [
  ['Состав территории', 'ТиНАО объединяет Новомосковский (НАО) и Троицкий (ТАО) административные округа: формально это два округа, по характеру заявок — одна территория.'],
  ['Коммунарка и Саларьево', 'Северная часть, ближе к МКАД: наиболее интенсивное жилищное строительство Новой Москвы, современные проезды, минимум ограничений старой застройки.'],
  ['Троицк', 'Наукоград значительно южнее Коммунарки со смешанной застройкой; десять научно-исследовательских институтов, включая АО «ГНЦ РФ ТРИНИТИ», ИЗМИРАН, ИСАН и ИФВД им. Верещагина, — это кластер отдельных периметров, у каждого свой пропускной режим.'],
  ['Стройка метро вдоль Калужского шоссе', 'С октября 2025 года идёт проходка тоннеля второго этапа Троицкой линии — 16,8 км до конечной станции Троицк; 12 августа 2025 года открылось электродепо «Столбово».'],
  ['Логистика', 'Определяющий фактор территории — расстояние: чем южнее объект, тем больше логистическое плечо и стоимость подачи.'],
  ['Чем проще, чем в «старой» Москве', 'Меньше жёстких требований по перекрытию проезда и согласованию с ЦОДД: площадки просторнее, и кран обычно встаёт без выхода на проезжую часть.'],
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'География', item: 'https://moskran-servis.ru/#geo' },
    { '@type': 'ListItem', position: 3, name: 'Новая Москва (ТиНАО)', item: 'https://moskran-servis.ru/geo/tinao/' },
  ],
};

const faqs = [
  { q: 'ТиНАО — это два разных округа?', a: 'Формально да: Новомосковский (НАО) и Троицкий (ТАО) административные округа, присоединённые к Москве в 2012 году. На практике их часто объединяют под общим названием «Новая Москва» или ТиНАО — территория огромна (превышает площадь «старой» Москвы) и неоднородна, от плотной новой застройки на севере до почти сельской местности на юге.' },
  { q: 'В чём разница между работой в Коммунарке и в Троицке?', a: 'Коммунарка и Саларьево — районы активной новой жилой застройки, ближе к МКАД, с современной инфраструктурой подъезда и логикой работы, близкой к обычным московским округам. Троицк — исторически отдельный наукоград, присоединённый к Москве, расположен значительно южнее, там больше индивидуальной застройки и объектов научных учреждений.' },
  { q: 'Есть ли в Новой Москве районы, куда логистика особенно дорогая?', a: 'Да, чем дальше от МКАД на юг территории ТиНАО, тем больше логистическое плечо — для объектов в районе Троицка и южнее стоимость подачи техники ощутимо выше, чем для Коммунарки или Ватутинок, расположенных ближе к границе основной городской черты.' },
];
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BaseLayout title={title} description={description} path="/geo/tinao/" ldExtra={[breadcrumbLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/#geo">География</a><span>/</span><span>Новая Москва (ТиНАО)</span>
  </nav>
  <section class="section wrap" style="padding-top:8px">
    <div class="section-head">
      <span class="eyebrow">География: Новомосковский и Троицкий округа</span>
      <h1>Аренда автокрана в Новой Москве (ТиНАО)</h1>
      <p>Территория, присоединённая к Москве в 2012 году, — по площади больше, чем «старая» Москва в прежних границах, и максимально неоднородна: от плотной новой застройки Коммунарки и Саларьева до наукограда Троицка и почти сельской местности дальше на юг.</p>
    </div>
    <div class="tools">
      <p class="tools__lead">Два инструмента, которые отвечают на разные вопросы по объекту в этом округе.</p>
      <p><a href="/proverka-dokumentov/">Проверка комплекта документов</a> — что из допуска уже есть, чего не хватает и сколько времени добавляет каждая недостающая позиция. Именно она чаще всего и определяет дату выезда.</p>
      <p><a href="/#zayavka">Ориентир по стоимости</a> — формула расчёта смены и коэффициент за пропускной режим, на главной странице, вместе с формой заявки.</p>
    </div>
  </section>
  <section class="section wrap prose" style="padding-top:0">
    <h2 style="margin-bottom:18px">Два округа под одним общим названием</h2>
    <p>ТиНАО объединяет Новомосковский (НАО) и Троицкий (ТАО) административные округа — с точки зрения регистрации это два формально разных округа, но по общему укладу территории и характеру заявок мы рассматриваем их на одной странице: логика подбора техники и специфика площадок здесь ближе друг к другу, чем к любому из округов «старой» Москвы.</p>

    <ZoneTable
      caption="ТиНАО по зонам: что меняет заявку"
      columns={['Территория округа', 'Что определяет заявку']}
      rows={zoneRows}
    />

    <h2 style="margin:36px 0 18px">Коммунарка и Саларьево — активная новая застройка</h2>
    <p>Северная часть территории, ближе к МКАД, — зона наиболее интенсивного жилищного строительства последних лет в Новой Москве. Работа техники здесь по логике близка к обычным московским округам: современные проезды, стандартные требования к площадке, минимум специфических ограничений старой застройки.</p>

    <h2 style="margin:36px 0 18px">Троицк — наукоград в составе Москвы</h2>
    <p>Расположен значительно южнее Коммунарки, исторически был отдельным городом с научной специализацией (физические институты) и вошёл в состав Москвы вместе со всей территорией ТиНАО. Застройка здесь более смешанная — от многоквартирных домов до частного сектора. В границах наукограда работает десять научно-исследовательских институтов, включая головное предприятие Госкорпорации «Росатом» — АО «ГНЦ РФ ТРИНИТИ», ИЗМИРАН, ИСАН и ИФВД им. Верещагина: это не одна закрытая территория на весь Троицк, а кластер отдельных периметров со своим пропускным режимом у каждого — подробный разбор на странице услуги <a href="/uslugi/kran-na-rezhimnyy-obekt/tinao/">«Кран на режимный объект в ТиНАО»</a>.</p>

    <h2 style="margin:36px 0 18px">Логистика — главный фактор для этой территории</h2>
    <p>В отличие от округов «старой» Москвы, где основные различия — в плотности застройки и типе согласований, для ТиНАО определяющий фактор — расстояние. Чем южнее расположен объект (Троицк и территории за ним), тем больше логистическое плечо подачи техники и тем ощутимее это на стоимости и сроках выезда. Мы называем реалистичную стоимость подачи по конкретному адресу, а не усреднённую по всей огромной территории округов.</p>

    <h2 style="margin:36px 0 18px">Стройка метро вдоль Калужского шоссе</h2>
    <p>С октября 2025 года вдоль Калужского шоссе идёт проходка тоннеля второго этапа Троицкой линии метро — 16,8 км до конечной станции Троицк, а 12 августа 2025 года в округе уже открылось электродепо «Столбово». Это многолетняя стройка, растянутая на весь коридор, а не точечный объект — подробнее о том, что это значит для тяжёлого класса техники, на странице услуги <a href="/uslugi/arenda-avtokrana-40-50-tonn/tinao/">«Автокран 40–50 тонн в Новой Москве»</a>.</p>

    <h2 style="margin:36px 0 18px">Что проще, а что сложнее здесь, чем в «старой» Москве</h2>
    <p>Проще — как правило, меньше жёстких требований по перекрытию проезда и согласованию с ЦОДД, характерных для плотной застройки центра: большинство новых площадок ТиНАО просторнее, и установка крана без выхода на проезжую часть обычно возможна. Сложнее — сама логистика: расстояние и, для некоторых участков, менее развитая дорожная сеть по сравнению с основной территорией города.</p>

    <h2 style="margin:36px 0 18px">Цена работы в ТиНАО</h2>
    <p>Базовая ставка — по грузоподъёмности крана (см. <a href="/#zayavka" style="color:var(--yellow)">ориентир по стоимости на главной</a>), не отличается от остальной Москвы. Стоимость подачи техники зависит от конкретного расстояния до объекта и растёт по мере удаления на юг от границы с основной городской чертой — называем точную цифру по адресу при расчёте заявки.</p>
  </section>
  <section class="section wrap" id="faq-geo">
    <div class="section-head"><span class="eyebrow">Вопросы</span><h2>Частые вопросы про работу в ТиНАО</h2></div>
    <div class="faq">{faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}</div>
  </section>
  <section class="section wrap"><a class="btn" href="/#zayavka">Оставить заявку на объект в ТиНАО →</a></section>
</main>
<style>
  .tools { background: var(--bg-2); border-left: 3px solid transparent; background-image: var(--hazard-edge); background-repeat: no-repeat; background-size: 3px 100%; background-position: left top; background-origin: border-box; padding: 18px 20px; max-width: 560px; display: grid; gap: 10px; font-size: var(--t-md); }
  .tools__lead { color: var(--muted); font-size: var(--t-md); }
  .tools a { color: var(--yellow); font-weight: 700; text-decoration: none; }
  .tools a:hover { text-decoration: underline; }
</style>
</BaseLayout>
