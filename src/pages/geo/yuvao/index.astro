---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ZoneTable from '../../../components/ZoneTable.astro';

const title = 'Аренда автокрана в ЮВАО Москвы — Марьино и Люблино';
const description = 'Автокран в ЮВАО Москвы: Марьино, Люблино, Печатники, Капотня. Работа в промышленных зонах у Московского НПЗ, спальные районы, Некрасовка.';

// Волна 39: сводная таблица зон округа. Ни одного нового факта — это
// пересборка того, что ниже на этой же странице сказано прозой. У строки
// таблицы есть подпись столбца, поэтому значение достаётся без чтения
// всего абзаца — и человеком, и языковой моделью, которая цитирует
// страницу в ответе (критерий рубрикатора geo-table-present).
const zoneRows = [
  ['Промышленные зоны — Капотня, Печатники, Южнопортовый', 'Московский нефтеперерабатывающий завод в Капотне, складские и производственные территории вдоль набережных: заявка идёт с пропускным режимом действующего предприятия.'],
  ['Крупные спальные районы — Марьино, Люблино, Кузьминки, Текстильщики', 'Одни из самых населённых районов Москвы: плотная многоэтажная застройка с относительно широкими внутриквартальными проездами.'],
  ['Некрасовка', 'Один из самых молодых районов округа, застроен преимущественно за последнее десятилетие; ближе к МКАД и границе с областью — логистическое плечо больше.'],
  ['Лефортово и Нижегородский район', 'Историческая застройка Лефортова с прилегающим парком соседствует с редевелопментом территории бывшего завода «Серп и молот».'],
  ['Юго-Восточная хорда', 'Магистраль протяжённостью около 25,5 км с крупными эстакадами связала 22 района, включая Марьино и Люблино, — маршруты подачи тяжёлой техники по округу изменились.'],
];

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'География', item: 'https://moskran-servis.ru/#geo' },
    { '@type': 'ListItem', position: 3, name: 'ЮВАО', item: 'https://moskran-servis.ru/geo/yuvao/' },
  ],
};

const districts = [
  'Выхино-Жулебино', 'Капотня', 'Кузьминки', 'Лефортово', 'Люблино', 'Марьино',
  'Некрасовка', 'Нижегородский', 'Печатники', 'Рязанский', 'Текстильщики', 'Южнопортовый',
];

const faqs = [
  {
    q: 'Работаете ли вы на территории промзоны у Капотни?',
    a: 'Да, но с важной оговоркой: территории, прилегающие к Московскому нефтеперерабатывающему заводу, — это, как правило, объекты с повышенными требованиями промышленной безопасности и строгим пропускным режимом. Оформление допуска техники и бригады на такие объекты закладываем в график заранее, с запасом по срокам больше стандартного — подробности на странице услуги «Кран на режимный объект».',
  },
  {
    q: 'Некрасовка — это уже окраина, логистика туда дороже?',
    a: 'Некрасовка расположена ближе к МКАД и к границе с Московской областью, чем большинство районов округа, — стоимость подачи техники туда действительно обычно выше, чем для более центральных районов ЮВАО, но не драматично: это по-прежнему в пределах города, а не выездной тариф за МКАД. Точную стоимость подачи называем при расчёте заявки по адресу объекта.',
  },
  {
    q: 'В Марьино и Люблино в основном жилая застройка — какие задачи там чаще всего?',
    a: 'Преимущественно капитальный ремонт фасадов и кровель многоквартирных домов, монтаж лёгкого инженерного оборудования, подача материалов при реконструкции — типовой набор задач для спальных районов Москвы. Проезды здесь, как правило, шире, чем в исторической застройке центра, что упрощает работу техники.',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<BaseLayout title={title} description={description} path="/geo/yuvao/" ldExtra={[breadcrumbLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/#geo">География</a><span>/</span><span>ЮВАО</span>
  </nav>

  <section class="section wrap" style="padding-top:8px">
    <div class="section-head">
      <span class="eyebrow">География: Юго-Восточный округ</span>
      <h1>Аренда автокрана в ЮВАО Москвы</h1>
      <p>Маршруты подачи техники по ЮВАО изменила Юго-Восточная хорда — магистраль протяжённостью около 25,5 км с крупными эстакадами, напрямую связавшая 22 района города, включая Марьино и Люблино. Внутри округа при этом два разных режима заявки: на промышленных территориях Капотни, Печатников и Южнопортового пропуск оформляют с запасом больше стандартного, в спальных Марьине, Люблине и Кузьминках работают обычным порядком.</p>
      <p>Юго-Восточный округ сочетает крупные спальные районы (Марьино, Люблино, Кузьминки), промышленные зоны у Московского нефтеперерабатывающего завода в Капотне и активно застраиваемую Некрасовку на границе с областью. Разбираем специфику работы техники по каждому типу территории.</p>
    </div>
    <div class="tools">
      <p class="tools__lead">Два инструмента, которые отвечают на разные вопросы по объекту в этом округе.</p>
      <p><a href="/proverka-dokumentov/">Проверка комплекта документов</a> — что из допуска уже есть, чего не хватает и сколько времени добавляет каждая недостающая позиция. Именно она чаще всего и определяет дату выезда.</p>
      <p><a href="/#zayavka">Ориентир по стоимости</a> — формула расчёта смены и коэффициент за пропускной режим, на главной странице, вместе с формой заявки.</p>
    </div>
  </section>

  <section class="section wrap prose" style="padding-top:0">
    <h2 style="margin-bottom:18px">Районы ЮВАО, где мы регулярно работаем</h2>
    <p>{districts.join(', ')} — двенадцать районов округа с заметно разной спецификой: от плотных промышленных территорий у Капотни до новой жилой застройки Некрасовки.</p>

    <ZoneTable
      caption="ЮВАО по зонам: что меняет заявку"
      columns={['Территория округа', 'Что определяет заявку']}
      rows={zoneRows}
    />

    <h2 style="margin:36px 0 18px">Промышленные зоны: Капотня, Печатники, Южнопортовый</h2>
    <p>Эта часть округа исторически связана с крупными промышленными объектами — прежде всего Московским нефтеперерабатывающим заводом в Капотне, а также складскими и производственными территориями вдоль набережных Москвы-реки в Печатниках и Южнопортовом районе. Заявки здесь чаще связаны с монтажом промышленного оборудования, а не с жилой застройкой, и почти всегда требуют оформления пропуска — территории с действующим производством, как правило, имеют строгий контрольно-пропускной режим с расширенным списком требований к технике и бригаде (медицинские допуски, инструктаж по промышленной безопасности предприятия). Закладываем на это больше времени, чем на стандартный пропуск офисного бизнес-центра. Порядок оформления пропуска у Капотни разобран на <a href="/uslugi/kran-na-rezhimnyy-obekt/yuvao/">странице услуги «Кран на режимный объект в ЮВАО»</a>.</p>

    <h2 style="margin:36px 0 18px">Крупные спальные районы: Марьино, Люблино, Кузьминки, Текстильщики</h2>
    <p>Одни из самых населённых районов Москвы — плотная жилая застройка, преимущественно многоэтажная, с относительно широкими внутриквартальными проездами по сравнению с историческим центром. Основной объём заявок — капитальный ремонт фасадов и кровель, замена лифтового оборудования (подъём нового лифтового блока — отдельная, регулярная для этой части округа задача), монтаж инженерных систем при реконструкции жилых домов советской постройки.</p>

    <h2 style="margin:36px 0 18px">Некрасовка — новая застройка на границе с областью</h2>
    <p>Один из самых молодых жилых районов округа, застроенный преимущественно в последнее десятилетие. Расположен ближе к МКАД и к границе с Московской областью, чем большинство других районов ЮВАО — это увеличивает логистическое плечо подачи техники по сравнению с более центральными частями округа, но остаётся в пределах городского, не выездного тарифа. Застройка здесь современная, проезды широкие, специфических ограничений по подъезду, характерных для старой застройки, как правило, нет. Есть, впрочем, своя специфика ниже уровня проезда: район стоит на территории бывших Люберецких полей аэрации, и для башенного крана это отдельный вопрос к изысканиям — разобран на странице <a href="/uslugi/bashennyy-kran/yuvao/">башенного крана в ЮВАО</a>.</p>

    <h2 style="margin:36px 0 18px">Юго-Восточная хорда меняет маршруты по округу</h2>
    <p>Через Печатники и Текстильщики прошла Юго-Восточная хорда — новая магистраль протяжённостью около 25,5 км с несколькими крупными эстакадами, напрямую связавшая 22 района Москвы, включая Марьино и Люблино. Для подачи тяжёлой техники между объектами округа это не абстрактная стройка, а конкретное изменение маршрута — подробный разбор с картой сокращённых плеч подачи на <a href="/uslugi/arenda-avtokrana-40-50-tonn/yuvao/">странице услуги «Автокран 40–50 тонн в ЮВАО»</a>.</p>

    <h2 style="margin:36px 0 18px">Лефортово и Нижегородский район — смешанная застройка</h2>
    <p>Эта часть округа сочетает историческую застройку (район Лефортово с прилегающим парком) и активно обновляющуюся территорию бывшего завода «Серп и молот» в Нижегородском районе, где идёт масштабная редевелопмент-застройка бывшей промышленной зоны под жильё. Для объектов на территории редевелопмента специфика близка к новым жилым комплексам — современные проезды, но часто действующий на переходный период пропускной режим стройплощадки в целом.</p>

    <h2 style="margin:36px 0 18px">Цена работы в ЮВАО</h2>
    <p>Базовая ставка — по грузоподъёмности крана (см. <a href="/#zayavka" style="color:var(--yellow)">ориентир по стоимости на главной</a>). Для объектов на территории действующих промышленных предприятий (Капотня и прилегающие зоны) закладываем дополнительное время на пропуск — подробности на странице услуги «Кран на режимный объект». Для удалённых от центра округа районов (Некрасовка) стоимость подачи техники обсуждается индивидуально по адресу.</p>
  </section>

  <section class="section wrap" id="faq-geo">
    <div class="section-head">
      <span class="eyebrow">Вопросы</span>
      <h2>Частые вопросы про работу в ЮВАО</h2>
    </div>
    <div class="faq">
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="section wrap">
    <a class="btn" href="/#zayavka">Оставить заявку на объект в ЮВАО →</a>
  </section>
</main>
<style>
  .tools { background: var(--bg-2); border-left: 3px solid transparent; background-image: var(--hazard-edge); background-repeat: no-repeat; background-size: 3px 100%; background-position: left top; background-origin: border-box; padding: 18px 20px; max-width: 560px; display: grid; gap: 10px; font-size: var(--t-md); }
  .tools__lead { color: var(--muted); font-size: var(--t-md); }
  .tools a { color: var(--yellow); font-weight: 700; text-decoration: none; }
  .tools a:hover { text-decoration: underline; }
</style>
</BaseLayout>
