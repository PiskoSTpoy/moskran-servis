---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ZoneTable from '../../../components/ZoneTable.astro';

const title = 'Аренда автокрана в ЮЗАО Москвы — Академический район';
const description = 'Автокран в ЮЗАО Москвы: научные и академические учреждения, Ленинский проспект, Битцевский лесопарк. Согласование на территории институтов.';

// Волна 39: сводная таблица зон округа. Ни одного нового факта — это
// пересборка того, что ниже на этой же странице сказано прозой. У строки
// таблицы есть подпись столбца, поэтому значение достаётся без чтения
// всего абзаца — и человеком, и языковой моделью, которая цитирует
// страницу в ответе (критерий рубрикатора geo-table-present).
const zoneRows = [
  ['Академический район и институты РАН', 'У территорий научных учреждений собственный пропускной режим, отличный от типового коммерческого объекта.'],
  ['Ленинский проспект', 'Для площадок, примыкающих к проспекту, чаще актуально согласование частичного перекрытия проезжей части при установке крана на выносные опоры.'],
  ['Граница Битцевского лесопарка — Северное и Южное Бутово, Тёплый Стан, Ясенево', 'Сама территория парка закрыта для любых строительных работ; заявки идут по прилегающей жилой застройке.'],
  ['Типовая застройка — Черёмушки, Коньково, Зюзино', 'Основной объём — капремонт фасадов и кровель жилых домов советского периода и монтаж инженерного оборудования.'],
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'География', item: 'https://moskran-servis.ru/#geo' },
    { '@type': 'ListItem', position: 3, name: 'ЮЗАО', item: 'https://moskran-servis.ru/geo/yuzao/' },
  ],
};

const districts = [
  'Академический', 'Гагаринский', 'Зюзино', 'Коньково', 'Котловка', 'Ломоносовский',
  'Обручевский', 'Северное Бутово', 'Тёплый Стан', 'Черёмушки', 'Южное Бутово', 'Ясенево',
];

const faqs = [
  { q: 'Работаете ли вы на территории научных институтов Академического района?', a: 'Да, но территории институтов Российской академии наук — как правило, объекты с собственным пропускным режимом, отличным от типового коммерческого. Уточняем требования конкретного учреждения заранее, не полагаясь на стандартный срок оформления.' },
  { q: 'Насколько сложно работать краном рядом с Битцевским лесопарком?', a: 'Сам парк — природоохранная территория с ограничениями на любые работы внутри границ, но прилегающая жилая застройка (Северное и Южное Бутово, Ясенево) — типовые спальные районы без специфических ограничений, кроме стандартных требований к подъезду.' },
  { q: 'Ленинский проспект — насколько интенсивное движение для подачи техники?', a: 'Это одна из главных магистралей юго-запада города, с интенсивным трафиком на всём протяжении. Для площадок, примыкающих непосредственно к проспекту, чаще актуально согласование частичного перекрытия, чем для внутриквартальных территорий.' },
];
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BaseLayout title={title} description={description} path="/geo/yuzao/" ldExtra={[breadcrumbLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/#geo">География</a><span>/</span><span>ЮЗАО</span>
  </nav>
  <section class="section wrap" style="padding-top:8px">
    <div class="section-head">
      <span class="eyebrow">География: Юго-Западный округ</span>
      <h1>Аренда автокрана в ЮЗАО Москвы</h1>
      <p>Типовая заявка в ЮЗАО — капремонт фасадов и кровель домов 1960-х годов в Черёмушках, Конькове и Зюзине, и особый порядок допуска нужен ровно в двух местах округа. Это промзона №35 «Воронцово», где НИИ, электродепо метрополитена и обычное производство стоят в одном периметре с разными процедурами допуска, и промзона №9 «Черёмушки» в Котловке, где на месте снесённых корпусов строится реновационный квартал.</p>
      <p>Юго-Западный округ известен концентрацией научных и академических учреждений (Академический район, институты РАН), проходит вдоль Ленинского проспекта и граничит с Битцевским лесопарком — одним из крупнейших лесных массивов в черте города.</p>
    </div>
    <div class="tools">
      <p class="tools__lead">Два инструмента, которые отвечают на разные вопросы по объекту в этом округе.</p>
      <p><a href="/proverka-dokumentov/">Проверка комплекта документов</a> — что из допуска уже есть, чего не хватает и сколько времени добавляет каждая недостающая позиция. Именно она чаще всего и определяет дату выезда.</p>
      <p><a href="/#zayavka">Ориентир по стоимости</a> — формула расчёта смены и коэффициент за пропускной режим, на главной странице, вместе с формой заявки.</p>
    </div>
  </section>
  <section class="section wrap prose" style="padding-top:0">
    <h2 style="margin-bottom:18px">Районы ЮЗАО, где мы регулярно работаем</h2>
    <p>{districts.join(', ')} — от плотной застройки вдоль Ленинского проспекта до более просторных районов на границе с областью (Южное Бутово, Ясенево).</p>

    <ZoneTable
      caption="ЮЗАО по зонам: что меняет заявку"
      columns={['Территория округа', 'Что определяет заявку']}
      rows={zoneRows}
    />

    <h2 style="margin:36px 0 18px">Академический район и институты РАН</h2>
    <p>Округ исторически связан с концентрацией научных учреждений — институтов Российской академии наук, вузов. Территории таких учреждений обычно имеют собственный пропускной режим, отличный от типового коммерческого объекта — это не формальность, а отдельная процедура конкретного института. Уточняем требования заранее по каждому такому объекту, а не полагаемся на стандартный срок согласования.</p>

    <h2 style="margin:36px 0 18px">Ленинский проспект — логистика и согласования</h2>
    <p>Одна из главных магистралей юго-запада города с интенсивным движением. Для площадок, примыкающих непосредственно к проспекту, чаще актуально согласование частичного перекрытия проезжей части при установке крана на выносные опоры, чем для территорий в глубине жилых кварталов.</p>

    <h2 style="margin:36px 0 18px">Соседство с Битцевским лесопарком</h2>
    <p>Битцевский лес — крупный природоохранный массив на границе округа с прилегающими районами Северное и Южное Бутово, Тёплый Стан, Ясенево. Сама территория парка закрыта для любых строительных работ, но прилегающая жилая застройка — типовые спальные районы без специфических ограничений сверх стандартных требований к подъезду и площадке.</p>

    <h2 style="margin:36px 0 18px">Типовая застройка: Черёмушки, Коньково, Зюзино</h2>
    <p>Основной объём заявок здесь — капитальный ремонт фасадов и кровель жилых домов советского периода, монтаж инженерного оборудования. Название «Черёмушки» стало нарицательным для типовой жилой застройки 1960-х — соответственно, и специфика работ здесь максимально типовая для города, без региональных особенностей. Два исключения из этого правила — обе промзоны на стыке районов округа, у них разная логика допуска. Промзона №35 «Воронцово» (Коньково, Черёмушки, Обручевский район) — НИИ, электродепо метрополитена и обычное производство рядом друг с другом, с разными процедурами допуска техники — разбор на <a href="/uslugi/kran-na-rezhimnyy-obekt/yuzao/">странице услуги «Кран на режимный объект в ЮЗАО»</a>. Промзона №9 «Черёмушки» в Котловке — обратный случай: старые производственные корпуса снесены, на их месте строится новый реновационный квартал, разбор — на странице услуги <a href="/uslugi/bashennyy-kran/yuzao/">«Башенный кран в ЮЗАО»</a>.</p>

    <h2 style="margin:36px 0 18px">Цена работы в ЮЗАО</h2>
    <p>Базовая ставка — по грузоподъёмности крана (см. <a href="/#zayavka" style="color:var(--yellow)">ориентир по стоимости на главной</a>). Для объектов на территории научных учреждений закладываем время на специфичное согласование допуска. Для площадок у Ленинского проспекта — возможная надбавка на согласование перекрытия с ГИБДД.</p>
  </section>
  <section class="section wrap" id="faq-geo">
    <div class="section-head"><span class="eyebrow">Вопросы</span><h2>Частые вопросы про работу в ЮЗАО</h2></div>
    <div class="faq">{faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}</div>
  </section>
  <section class="section wrap"><a class="btn" href="/#zayavka">Оставить заявку на объект в ЮЗАО →</a></section>
</main>
<style>
  .tools { background: var(--bg-2); border-left: 3px solid transparent; background-image: var(--hazard-edge); background-repeat: no-repeat; background-size: 3px 100%; background-position: left top; background-origin: border-box; padding: 18px 20px; max-width: 560px; display: grid; gap: 10px; font-size: var(--t-md); }
  .tools__lead { color: var(--muted); font-size: var(--t-md); }
  .tools a { color: var(--yellow); font-weight: 700; text-decoration: none; }
  .tools a:hover { text-decoration: underline; }
</style>
</BaseLayout>
