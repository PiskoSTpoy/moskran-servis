---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ZoneTable from '../../../components/ZoneTable.astro';

const title = 'Аренда автокрана в ЗАО Москвы — Кунцево, Раменки, Крылатское';
const description = 'Автокран в ЗАО Москвы: Раменки (МГУ), Кунцево, Крылатское, Дорогомилово. Престижная жилая застройка, Кутузовский проспект, Ново-Переделкино.';

// Волна 39: сводная таблица зон округа. Ни одного нового факта — это
// пересборка того, что ниже на этой же странице сказано прозой. У строки
// таблицы есть подпись столбца, поэтому значение достаётся без чтения
// всего абзаца — и человеком, и языковой моделью, которая цитирует
// страницу в ответе (критерий рубрикатора geo-table-present).
const zoneRows = [
  ['Кутузовский проспект — Дорогомилово, Фили-Давыдково', 'Для площадок, примыкающих к проспекту, чаще актуально согласование частичного перекрытия проезжей части при установке на выносные опоры.'],
  ['Раменки и территория МГУ', 'Высокая концентрация учебных и научных учреждений: работа на территории крупного вуза почти всегда требует отдельного допуска.'],
  ['Кунцево и Крылатское', 'Премиальная жилая застройка с активным строительством и капремонтом: повышенное внимание управляющих компаний и заказчиков к порядку работ.'],
  ['Филёвский Парк: территория Хруничева', 'На Новозаводской улице соседствуют действующая площадка ГКНПЦ им. М.В. Хруничева и освобождённая часть той же территории в пойме, где построен Национальный космический центр.'],
  ['Кунцево: Рублёво-Архангельское и «СберСити»', 'За МКАД в Захарковской пойме Москвы-реки с 2012 года застраивается квартал на 695 га, из которых 461 га отведён под застройку.'],
  ['Ново-Переделкино и Солнцево', 'Наиболее удалённые районы округа у границы с Новой Москвой: логистическое плечо больше, стоимость подачи обсуждается отдельно.'],
];

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'География', item: 'https://moskran-servis.ru/#geo' },
    { '@type': 'ListItem', position: 3, name: 'ЗАО', item: 'https://moskran-servis.ru/geo/zao/' },
  ],
};

const districts = [
  'Дорогомилово', 'Крылатское', 'Кунцево', 'Можайский', 'Ново-Переделкино', 'Очаково-Матвеевское',
  'Проспект Вернадского', 'Раменки', 'Солнцево', 'Тропарёво-Никулино', 'Филёвский парк', 'Фили-Давыдково',
];

const faqs = [
  {
    q: 'Работаете ли вы на территории МГУ и прилегающих научных учреждений в Раменках?',
    a: 'Да, но территории крупных учебных и научных учреждений почти всегда требуют отдельного согласования допуска техники — это не типовой коммерческий пропуск, а более специфичная процедура конкретного учреждения. Уточняем требования заранее по каждому такому объекту, срок согласования называем после запроса, не по общему шаблону.',
  },
  {
    q: 'Кутузовский проспект — насколько сложно согласовать работы вблизи него?',
    a: 'Сам проспект — одна из главных магистралей города с интенсивным движением, поэтому для площадок, примыкающих непосредственно к проспекту, чаще актуально согласование частичного перекрытия проезжей части, чем для внутриквартальных территорий. Для дворов и площадок в глубине жилых кварталов Дорогомилова и Филей ограничение по подъезду обычно связано скорее с плотностью застройки, чем с самим проспектом.',
  },
  {
    q: 'Чем отличается работа в Ново-Переделкино и Солнцево от более центральных районов округа?',
    a: 'Эти районы ближе к МКАД и к Новой Москве, застройка здесь смешанная — от старых дачных посёлков (историческое Переделкино) до новых жилых комплексов. Логистическое плечо подачи техники немного больше, чем для Кунцева или Раменок, но ограничений по подъезду, характерных для плотной старой застройки, здесь, как правило, меньше.',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<BaseLayout title={title} description={description} path="/geo/zao/" ldExtra={[breadcrumbLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/#geo">География</a><span>/</span><span>ЗАО</span>
  </nav>

  <section class="section wrap" style="padding-top:8px">
    <div class="section-head">
      <span class="eyebrow">География: Западный округ</span>
      <h1>Аренда автокрана в ЗАО Москвы</h1>
      <p>Заявки в ЗАО расходятся в две стороны от Кутузовского проспекта: у самого проспекта и в Раменках дату сдвигает согласование частичного перекрытия проезжей части и допуск на территорию МГУ, а за МКАД в Кунцеве идёт «СберСити» — Рублёво-Архангельское на 695 га, из которых 461 га отведён под застройку. Это не одна площадка, а многолетний фронт работ: жилые кварталы, школьный кампус, набережные и станция метро Рублёво-Архангельской линии с открытием для пассажиров осенью 2026 года.</p>
      <p>Западный округ — один из самых престижных по жилой застройке в городе: Кунцево, Крылатское, Раменки с территорией МГУ, набережные вдоль Кутузовского проспекта. При этом округ неоднороден — есть и промышленные территории, и более удалённые от центра районы вроде Ново-Переделкина и Солнцева.</p>
    </div>
    <div class="tools">
      <p class="tools__lead">Два инструмента, которые отвечают на разные вопросы по объекту в этом округе.</p>
      <p><a href="/proverka-dokumentov/">Проверка комплекта документов</a> — что из допуска уже есть, чего не хватает и сколько времени добавляет каждая недостающая позиция. Именно она чаще всего и определяет дату выезда.</p>
      <p><a href="/#zayavka">Ориентир по стоимости</a> — формула расчёта смены и коэффициент за пропускной режим, на главной странице, вместе с формой заявки.</p>
    </div>
  </section>

  <section class="section wrap prose" style="padding-top:0">
    <h2 style="margin-bottom:18px">Районы ЗАО, где мы регулярно работаем</h2>
    <p>{districts.join(', ')} — двенадцать районов, от плотной застройки вдоль Кутузовского проспекта до более просторных территорий на границе с Новой Москвой.</p>

    <ZoneTable
      caption="ЗАО по зонам: что меняет заявку"
      columns={['Территория округа', 'Что определяет заявку']}
      rows={zoneRows}
    />

    <h2 style="margin:36px 0 18px">Кутузовский проспект и прилегающие районы: Дорогомилово, Фили-Давыдково</h2>
    <p>Одна из главных магистралей города с интенсивным движением на всём протяжении. Для площадок, примыкающих непосредственно к проспекту, чаще актуально согласование частичного перекрытия проезжей части при установке крана на выносные опоры, чем для внутриквартальных территорий в глубине застройки. При этом сама жилая застройка вдоль проспекта — преимущественно современные и советские многоэтажные дома с достаточно широкими дворами по сравнению с историческим центром, что упрощает подбор точки установки техники.</p>

    <h2 style="margin:36px 0 18px">Раменки и территория МГУ</h2>
    <p>Район с высокой концентрацией учебных и научных учреждений, включая главное здание и территорию Московского государственного университета на Воробьёвых горах. Работа на территории крупных образовательных учреждений почти всегда требует отдельного согласования — это не типовой коммерческий пропуск бизнес-центра, а специфичная процедура конкретного учреждения со своими сроками и требованиями. Уточняем это заранее, отдельно по каждому такому объекту, а не полагаемся на стандартный срок оформления пропуска.</p>

    <h2 style="margin:36px 0 18px">Кунцево и Крылатское — премиальная жилая застройка</h2>
    <p>Эти районы — одни из самых востребованных по жилой недвижимости в городе, с активным строительством и капитальным ремонтом существующего жилого фонда. Специфика заявок здесь — повышенное внимание заказчиков (управляющих компаний и застройщиков) к аккуратности проведения работ и минимизации неудобств для жителей: время работ чаще согласовывается с учётом шумовых ограничений в жилой застройке, чем в промышленных или коммерческих зонах округа.</p>

    <h2 style="margin:36px 0 18px">Филёвский парк — территория Хруничева</h2>
    <p>Отдельная специфика — часть района Филёвский Парк, где на Новозаводской улице соседствуют действующая площадка ГКНПЦ им. М.В. Хруничева и освобождённая часть той же территории в пойме, где построен Национальный космический центр. Две зоны с разным пропускным режимом в одном периметре — разбор допуска техники к каждой из них на <a href="/uslugi/kran-na-rezhimnyy-obekt/zao/">странице услуги «Кран на режимный объект в ЗАО»</a>.</p>

    <h2 style="margin:36px 0 18px">Кунцево — Рублёво-Архангельское и «СберСити»</h2>
    <p>В Захарковской пойме Москвы-реки за МКАД, в районе Кунцево, с 2012 года застраивается Рублёво-Архангельское — квартал «СберСити» на 695 га, из которых 461 га отведены под застройку. Это принципиально другая часть округа, чем премиальная жилая застройка ближе к центру Кунцева и Крылатского, — прежде пустовавшая территория, где параллельно строятся жилые кварталы, школьный кампус, набережные и станция метро Рублёво-Архангельской линии с открытием для пассажиров осенью 2026 года. Логистика подачи техники сюда — тема отдельной страницы услуги <a href="/uslugi/arenda-avtokrana-40-50-tonn/zao/">«Автокран 40–50 тонн в ЗАО»</a>.</p>

    <h2 style="margin:36px 0 18px">Ново-Переделкино и Солнцево — граница с Новой Москвой</h2>
    <p>Наиболее удалённые от центра округа районы, ближе к МКАД и к территории Новой Москвы. Логистическое плечо подачи техники сюда несколько больше, чем для Кунцева или Раменок в центральной части округа — стоимость подачи обсуждается индивидуально по адресу. Застройка здесь смешанная: от исторических дачных посёлков (Переделкино связано с известной писательской дачной территорией) до современных жилых комплексов — по мере роста новой застройки объём заявок из этой части округа последовательно растёт. Для башенного крана та же граница округа разобрана на <a href="/uslugi/bashennyy-kran/zao/">странице услуги «Башенный кран в ЗАО»</a> — как площадку без геометрических ограничений, в отличие от точечной застройки Раменок.</p>

    <h2 style="margin:36px 0 18px">Цена работы в ЗАО</h2>
    <p>Базовая ставка — по грузоподъёмности крана (см. <a href="/#zayavka" style="color:var(--yellow)">ориентир по стоимости на главной</a>). Для объектов у Кутузовского проспекта, где может понадобиться перекрытие проезда, — отдельная статья на согласование с ГИБДД, называем заранее. Для территорий учебных и научных учреждений закладываем время на специфичное для конкретного объекта согласование допуска. Для удалённых районов (Ново-Переделкино, Солнцево) стоимость подачи — по расчёту от точки базирования техники.</p>
  </section>

  <section class="section wrap" id="faq-geo">
    <div class="section-head">
      <span class="eyebrow">Вопросы</span>
      <h2>Частые вопросы про работу в ЗАО</h2>
    </div>
    <div class="faq">
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="section wrap">
    <a class="btn" href="/#zayavka">Оставить заявку на объект в ЗАО →</a>
  </section>
</main>
<style>
  .tools { background: var(--bg-2); border-left: 3px solid transparent; background-image: var(--hazard-edge); background-repeat: no-repeat; background-size: 3px 100%; background-position: left top; background-origin: border-box; padding: 18px 20px; max-width: 560px; display: grid; gap: 10px; font-size: var(--t-md); }
  .tools__lead { color: var(--muted); font-size: var(--t-md); }
  .tools a { color: var(--yellow); font-weight: 700; text-decoration: none; }
  .tools a:hover { text-decoration: underline; }
</style>
</BaseLayout>
