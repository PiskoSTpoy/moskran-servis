---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ZoneTable from '../../../components/ZoneTable.astro';

const title = 'Аренда автокрана в СВАО Москвы — район ВДНХ и Останкино';
const description = 'Автокран в СВАО Москвы: район ВДНХ и Останкино, Ярославское шоссе, Лосиный остров. Работа рядом с объектами культурного наследия и парковыми зонами.';

// Волна 39: сводная таблица зон округа. Ни одного нового факта — это
// пересборка того, что ниже на этой же странице сказано прозой. У строки
// таблицы есть подпись столбца, поэтому значение достаётся без чтения
// всего абзаца — и человеком, и языковой моделью, которая цитирует
// страницу в ответе (критерий рубрикатора geo-table-present).
const zoneRows = [
  ['ВДНХ и Останкино', 'Объекты федерального значения с собственными регламентами доступа техники — согласование требуется даже для работ на прилегающих территориях.'],
  ['Граница с «Лосиным островом» — Ростокино, Свиблово, Северное Медведково', 'Национальный парк имеет природоохранный статус: работы на границе парковой зоны требуют отдельного согласования.'],
  ['Плотная жилая застройка — Бибирево, Отрадное, часть Бутырского, Марьина роща', 'Типовые задачи спальных районов: капремонт фасадов и кровель, монтаж инженерного оборудования, подача материалов при реконструкции жилого фонда советской постройки.'],
  ['Отрадное у Ботанического сада', 'У метро и МЦК «Владыкино» строился ЖК «Сигнальный 16» — пять корпусов переменной этажности от 17 до 33 этажей вплотную к территории Главного ботанического сада им. Н.В. Цицина РАН.'],
  ['Логистика по Ярославскому шоссе', 'Основная вылетная магистраль на северо-восток: для Северного и Южного Медведкова, Бабушкинского и Лианозова время подачи зависит от часа выезда.'],
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'География', item: 'https://moskran-servis.ru/#geo' },
    { '@type': 'ListItem', position: 3, name: 'СВАО', item: 'https://moskran-servis.ru/geo/svao/' },
  ],
};

const districts = [
  'Алексеевский', 'Алтуфьевский', 'Бабушкинский', 'Бибирево', 'Бутырский', 'Лианозово',
  'Лосиноостровский', 'Марфино', 'Марьина роща', 'Останкинский', 'Ростокино', 'Свиблово',
  'Северное Медведково', 'Южное Медведково', 'Ярославский',
];

const faqs = [
  { q: 'Работаете ли вы рядом с ВДНХ и Останкинской телебашней?', a: 'Да, но территории вблизи ВДНХ и Останкинского телецентра — зоны с повышенным вниманием к согласованию работ из-за статуса объектов и близости охраняемой инфраструктуры. Уточняем требования конкретной площадки заранее, а не полагаемся на общий порядок оформления.' },
  { q: 'Ярославское шоссе — насколько сложна логистика для этого направления?', a: 'Это одна из главных вылетных магистралей на северо-восток города с интенсивным трафиком, особенно в сторону области. Для объектов, расположенных ближе к МКАД по этому направлению, закладываем запас времени на подачу техники с учётом часа пик.' },
  { q: 'Работаете ли вы на территории парка «Лосиный остров»?', a: 'Территория национального парка имеет природоохранный статус — любые работы там требуют отдельного согласования, выходящего за рамки типового строительного разрешения. Для объектов на границе парковой зоны уточняем это на этапе приёма заявки.' },
];
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BaseLayout title={title} description={description} path="/geo/svao/" ldExtra={[breadcrumbLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/#geo">География</a><span>/</span><span>СВАО</span>
  </nav>
  <section class="section wrap" style="padding-top:8px">
    <div class="section-head">
      <span class="eyebrow">География: Северо-Восточный округ</span>
      <h1>Аренда автокрана в СВАО Москвы</h1>
      <p>В СВАО класс техники задаёт высота объекта: капремонт фасадов и кровель в Бибиреве, Отрадном и Марьиной роще закрывает обычный автокран, а у метро «Владыкино» построен ЖК «Сигнальный 16» — пять корпусов переменной этажности от 17 до 33 этажей, куда автокран уже не достаёт и нужен башенный. Отдельного согласования сверх обычного порядка требуют только две зоны округа — территория ВДНХ и Останкина и граница национального парка «Лосиный остров».</p>
      <p>Северо-Восточный округ известен прежде всего территорией ВДНХ и Останкино, а также соседством с национальным парком «Лосиный остров» — крупнейшей природоохранной зоной в границах города. Помимо этого — плотная жилая застройка вдоль Ярославского шоссе, от Свиблова до Лианозова.</p>
    </div>
    <div class="tools">
      <p class="tools__lead">Два инструмента, которые отвечают на разные вопросы по объекту в этом округе.</p>
      <p><a href="/proverka-dokumentov/">Проверка комплекта документов</a> — что из допуска уже есть, чего не хватает и сколько времени добавляет каждая недостающая позиция. Именно она чаще всего и определяет дату выезда.</p>
      <p><a href="/#zayavka">Ориентир по стоимости</a> — формула расчёта смены и коэффициент за пропускной режим, на главной странице, вместе с формой заявки.</p>
    </div>
  </section>
  <section class="section wrap prose" style="padding-top:0">
    <h2 style="margin-bottom:18px">Районы СВАО, где мы регулярно работаем</h2>
    <p>{districts.join(', ')} — округ вытянут с юга на север вдоль Ярославского направления, с заметно разной плотностью застройки на разных участках.</p>

    <ZoneTable
      caption="СВАО по зонам: что меняет заявку"
      columns={['Территория округа', 'Что определяет заявку']}
      rows={zoneRows}
    />

    <h2 style="margin:36px 0 18px">ВДНХ и Останкино — зона с особыми условиями</h2>
    <p>Территория ВДНХ с прилегающими выставочными павильонами и Останкинский телецентр — объекты федерального значения с собственными регламентами доступа техники. Работы здесь, даже вне основной выставочной территории (например, в прилегающей жилой застройке Останкинского района), иногда требуют дополнительного согласования из-за близости охраняемой инфраструктуры связи. Уточняем это индивидуально по каждому адресу в этой части округа. Порядок оформления пропуска для этой зоны — на <a href="/uslugi/kran-na-rezhimnyy-obekt/svao/">странице услуги «Кран на режимный объект в СВАО»</a>.</p>

    <h2 style="margin:36px 0 18px">Логистика по Ярославскому шоссе</h2>
    <p>Ярославское шоссе — основная вылетная магистраль округа на северо-восток, с интенсивным трафиком, особенно в направлении области. Для районов ближе к МКАД (Северное и Южное Медведково, Бабушкинский, Лианозово) время подачи техники ощутимо зависит от часа выезда — стараемся подавать кран до начала утреннего часа пик там, где это позволяет график объекта. Для тяжёлого класса техники вдоль этого направления — отдельная страница <a href="/uslugi/arenda-avtokrana-40-50-tonn/svao/">аренды автокрана 40–50 тонн в СВАО</a>.</p>

    <h2 style="margin:36px 0 18px">Соседство с «Лосиным островом»</h2>
    <p>Национальный парк «Лосиный остров» примыкает к восточной части округа (районы Ростокино, Свиблово, Северное Медведково) — территория имеет природоохранный статус, и работы на границе парковой зоны требуют отдельного согласования, не сводящегося к типовому строительному разрешению. Для объектов рядом с границей парка уточняем необходимость такого согласования на этапе приёма заявки, а не выясняем по факту выезда техники.</p>

    <h2 style="margin:36px 0 18px">Плотная жилая застройка: Бибирево, Отрадное (часть Бутырского), Марьина роща</h2>
    <p>Основной объём заявок здесь — типовые задачи спальных районов: капитальный ремонт фасадов и кровель, монтаж инженерного оборудования, подача материалов при реконструкции жилого фонда советской постройки. Марьина роща при этом ближе по плотности застройки к историческому центру, чем более поздние спальные районы округа — проезды здесь местами теснее.</p>

    <h2 style="margin:36px 0 18px">Отрадное: соседство с Ботаническим садом</h2>
    <p>У метро и МЦК «Владыкино» несколько лет строился ЖК «Сигнальный 16» — пять корпусов переменной этажности от 17 до 33 этажей вплотную к территории Главного ботанического сада им. Н.В. Цицина РАН. Для высотной застройки такого масштаба нужен не автокран, а башенный, и у этого соседства своя логика допуска — она разобрана на странице услуги <a href="/uslugi/bashennyy-kran/svao/">«Башенный кран у Ботанического сада в СВАО»</a>.</p>

    <h2 style="margin:36px 0 18px">Цена работы в СВАО</h2>
    <p>Базовая ставка — по грузоподъёмности крана (см. <a href="/#zayavka" style="color:var(--yellow)">ориентир по стоимости на главной</a>). Для объектов у ВДНХ/Останкино и на границе «Лосиного острова» закладываем время на специфичное согласование. Для удалённых от центра округа районов по Ярославскому шоссе — стоимость подачи техники обсуждается индивидуально.</p>
  </section>
  <section class="section wrap" id="faq-geo">
    <div class="section-head"><span class="eyebrow">Вопросы</span><h2>Частые вопросы про работу в СВАО</h2></div>
    <div class="faq">{faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}</div>
  </section>
  <section class="section wrap"><a class="btn" href="/#zayavka">Оставить заявку на объект в СВАО →</a></section>
</main>
<style>
  .tools { background: var(--bg-2); border-left: 3px solid transparent; background-image: var(--hazard-edge); background-repeat: no-repeat; background-size: 3px 100%; background-position: left top; background-origin: border-box; padding: 18px 20px; max-width: 560px; display: grid; gap: 10px; font-size: var(--t-md); }
  .tools__lead { color: var(--muted); font-size: var(--t-md); }
  .tools a { color: var(--yellow); font-weight: 700; text-decoration: none; }
  .tools a:hover { text-decoration: underline; }
</style>
</BaseLayout>
