---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ZoneTable from '../../../components/ZoneTable.astro';

const title = 'Аренда автокрана в ВАО Москвы — Сокольники, Измайлово';
const description = 'Автокран в ВАО Москвы: Сокольники, Измайловский парк, Шоссе Энтузиастов и Щёлковское шоссе. Работа рядом с парковыми зонами и промышленными территориями.';

// Волна 39: сводная таблица зон округа. Ни одного нового факта — это
// пересборка того, что ниже на этой же странице сказано прозой. У строки
// таблицы есть подпись столбца, поэтому значение достаётся без чтения
// всего абзаца — и человеком, и языковой моделью, которая цитирует
// страницу в ответе (критерий рубрикатора geo-table-present).
const zoneRows = [
  ['Сокольники и Измайлово', 'Крупные парковые массивы с историческим статусом; прилегающая жилая застройка — обычные городские объекты без специфических требований.'],
  ['Промышленные территории — Перово, Новогиреево, Ивановское', 'Сохранившиеся советские промышленные и складские территории: заявки чаще производственные и логистические и, как правило, требуют оформления пропуска.'],
  ['Типовая жилая застройка — Гольяново, Северное и Восточное Измайлово', 'Стандартные задачи спальных районов: капремонт фасадов и кровель, монтаж инженерного оборудования; проезды шире, чем в исторической застройке.'],
  ['Логистика по шоссе Энтузиастов и Щёлковскому шоссе', 'Основные вылетные направления на восток: для Новокосина и Косина-Ухтомского время подачи техники ощутимо зависит от часа выезда.'],
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'География', item: 'https://moskran-servis.ru/#geo' },
    { '@type': 'ListItem', position: 3, name: 'ВАО', item: 'https://moskran-servis.ru/geo/vao/' },
  ],
};

const districts = [
  'Восточный', 'Восточное Измайлово', 'Гольяново', 'Ивановское', 'Измайлово',
  'Косино-Ухтомский', 'Метрогородок', 'Новогиреево', 'Новокосино', 'Перово',
  'Преображенское', 'Северное Измайлово', 'Соколиная гора', 'Сокольники',
];

const faqs = [
  { q: 'Работаете ли вы рядом с парком «Сокольники» и Измайловским парком?', a: 'Прилегающая к паркам жилая застройка — обычные городские объекты без специфических ограничений, но работы непосредственно на территории парков (например, монтаж объектов инфраструктуры) требуют отдельного согласования с администрацией парка, отличного от типового строительного разрешения.' },
  { q: 'Шоссе Энтузиастов и Щёлковское шоссе — какая логистика?', a: 'Обе магистрали — основные вылетные направления округа на восток, с интенсивным трафиком. Для объектов ближе к МКАД по этим направлениям закладываем запас времени на подачу техники с учётом часа пик.' },
  { q: 'Есть ли в округе промышленные зоны, где нужен пропуск?', a: 'Да, в восточной части округа (районы Перово, Новогиреево, Ивановское) сохраняются промышленные и складские территории с контрольно-пропускным режимом — оформление пропуска на такие объекты закладываем в срок заранее.' },
];
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BaseLayout title={title} description={description} path="/geo/vao/" ldExtra={[breadcrumbLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/#geo">География</a><span>/</span><span>ВАО</span>
  </nav>
  <section class="section wrap" style="padding-top:8px">
    <div class="section-head">
      <span class="eyebrow">География: Восточный округ</span>
      <h1>Аренда автокрана в ВАО Москвы</h1>
      <p>ВАО делится на три разных по требованиям типа площадок: капремонт фасадов и кровель в Гольянове, Северном и Восточном Измайлове закрывает <a href="/uslugi/arenda-avtokrana-16-25-tonn/">автокран 16–25 тонн</a>, промзоны Перова, Новогиреева и Ивановского почти всегда идут с оформлением пропуска и <a href="/uslugi/arenda-avtokrana-40-50-tonn/vao/">тяжёлым классом 40–50 тонн</a>, а стройки реновации в Гольянове и Метрогородке добавляют согласование охранной зоны «Лосиного острова». Логистика в округе одна на все три случая — Шоссе Энтузиастов и Щёлковское шоссе, и для Новокосина с Косином-Ухтомским время подачи техники заметно зависит от часа выезда.</p>
      <p>Восточный округ известен парками Сокольники и Измайлово, крупными вылетными магистралями (Шоссе Энтузиастов, Щёлковское шоссе) и сохранившимися промышленными зонами в районах Перово и Новогиреево.</p>
    </div>
    <div class="tools">
      <p class="tools__lead">Два инструмента, которые отвечают на разные вопросы по объекту в этом округе.</p>
      <p><a href="/proverka-dokumentov/">Проверка комплекта документов</a> — что из допуска уже есть, чего не хватает и сколько времени добавляет каждая недостающая позиция. Именно она чаще всего и определяет дату выезда.</p>
      <p><a href="/#zayavka">Ориентир по стоимости</a> — формула расчёта смены и коэффициент за пропускной режим, на главной странице, вместе с формой заявки.</p>
    </div>
  </section>
  <section class="section wrap prose" style="padding-top:0">
    <h2 style="margin-bottom:18px">Районы ВАО, где мы регулярно работаем</h2>
    <p>{districts.join(', ')} — округ сочетает крупные парковые зоны, спальную застройку и остаточные промышленные территории.</p>

    <ZoneTable
      caption="ВАО по зонам: что меняет заявку"
      columns={['Территория округа', 'Что определяет заявку']}
      rows={zoneRows}
    />

    <h2 style="margin:36px 0 18px">Сокольники и Измайлово — парковые территории</h2>
    <p>Оба парка — крупные зелёные массивы с историческим статусом (Измайловский парк примыкает к территории бывшей царской усадьбы). Жилая застройка, прилегающая к паркам, — обычные городские объекты без специфических требований, но работы на самой территории парков (монтаж элементов инфраструктуры, обслуживание объектов) требуют отдельного согласования с администрацией парковой зоны.</p>

    <h2 style="margin:36px 0 18px">Промышленные территории: Перово, Новогиреево, Ивановское</h2>
    <p>Восточная часть округа сохраняет часть советских промышленных и складских территорий — заявки здесь чаще связаны с производственными или логистическими объектами, чем с жилой застройкой, и, как правило, требуют оформления пропуска на территорию предприятия. Подробности процедуры — на странице услуги «Кран на режимный объект». Для тяжёлого класса техники на этих площадках — отдельная страница <a href="/uslugi/arenda-avtokrana-40-50-tonn/vao/">аренды автокрана 40–50 тонн в ВАО</a>.</p>

    <h2 style="margin:36px 0 18px">Логистика по Шоссе Энтузиастов и Щёлковскому шоссе</h2>
    <p>Обе магистрали — основные вылетные направления округа на восток, с интенсивным трафиком, особенно на подъезде к МКАД. Для удалённых от центра округа районов (Новокосино, Косино-Ухтомский) время подачи техники ощутимо зависит от часа выезда.</p>

    <h2 style="margin:36px 0 18px">Типовая жилая застройка: Гольяново, Северное и Восточное Измайлово</h2>
    <p>Основной объём заявок здесь — стандартные задачи спальных районов: капитальный ремонт фасадов и кровель, монтаж инженерного оборудования при реконструкции жилого фонда. Проезды здесь, как правило, достаточно широкие по сравнению с исторической застройкой центра. Отдельный случай — стройки программы реновации в Гольянове и Метрогородке: они соседствуют не с обычным сквером, а с охранной зоной национального парка «Лосиный остров», и для башенного крана это добавляет отдельный этап согласования — разобрано на странице <a href="/uslugi/bashennyy-kran/vao/">башенного крана в ВАО</a>.</p>

    <h2 style="margin:36px 0 18px">Цена работы в ВАО</h2>
    <p>Базовая ставка — по грузоподъёмности крана (см. <a href="/#zayavka" style="color:var(--yellow)">ориентир по стоимости на главной</a>). Для промышленных объектов Перово и Новогиреево закладываем время на пропуск. Для удалённых районов (Новокосино, Косино) стоимость подачи обсуждается индивидуально.</p>
  </section>
  <section class="section wrap" id="faq-geo">
    <div class="section-head"><span class="eyebrow">Вопросы</span><h2>Частые вопросы про работу в ВАО</h2></div>
    <div class="faq">{faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}</div>
  </section>
  <section class="section wrap"><a class="btn" href="/#zayavka">Оставить заявку на объект в ВАО →</a></section>
</main>
<style>
  .tools { background: var(--bg-2); border-left: 3px solid transparent; background-image: var(--hazard-edge); background-repeat: no-repeat; background-size: 3px 100%; background-position: left top; background-origin: border-box; padding: 18px 20px; max-width: 560px; display: grid; gap: 10px; font-size: var(--t-md); }
  .tools__lead { color: var(--muted); font-size: var(--t-md); }
  .tools a { color: var(--yellow); font-weight: 700; text-decoration: none; }
  .tools a:hover { text-decoration: underline; }
</style>
</BaseLayout>
