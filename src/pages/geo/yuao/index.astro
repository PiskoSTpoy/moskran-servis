---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ZoneTable from '../../../components/ZoneTable.astro';

const title = 'Аренда автокрана в ЮАО Москвы — Царицыно, Коломенское';
const description = 'Автокран в ЮАО Москвы: Царицыно, Коломенское, территория бывшего завода ЗИЛ, Варшавское и Каширское шоссе. Работа на редевелопменте и в парковых зонах.';

// Волна 39: сводная таблица зон округа. Ни одного нового факта — это
// пересборка того, что ниже на этой же странице сказано прозой. У строки
// таблицы есть подпись столбца, поэтому значение достаётся без чтения
// всего абзаца — и человеком, и языковой моделью, которая цитирует
// страницу в ответе (критерий рубрикатора geo-table-present).
const zoneRows = [
  ['Редевелопмент территории ЗИЛ', 'Один из крупнейших проектов редевелопмента промышленной зоны в городе: жилой квартал «ЗИЛАРТ» и продолжающаяся застройка прилегающих участков.'],
  ['Царицыно и Коломенское', 'Музеи-заповедники с охранным статусом: работы у границ, включая прилегающую застройку Царицына и Нагатинского Затона, могут требовать дополнительных согласований.'],
  ['Реновация Нагатинского Затона', 'Под снос попадают 54 дома, больше всего адресов на Судостроительной и Затонной улицах; новое жильё уже строится на выделенных стартовых площадках.'],
  ['Типовая жилая застройка — Чертаново, Зябликово, Нагорный', 'Стандартные задачи: капремонт фасадов и кровель, монтаж инженерного оборудования, подача материалов; проезды шире, чем в исторической застройке.'],
  ['Логистика по Варшавскому и Каширскому шоссе', 'Главные вылетные направления на юг: для Бирюлёва, Орехова-Борисова и Братеева время подачи зависит от часа выезда.'],
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'География', item: 'https://moskran-servis.ru/#geo' },
    { '@type': 'ListItem', position: 3, name: 'ЮАО', item: 'https://moskran-servis.ru/geo/yuao/' },
  ],
};

const districts = [
  'Бирюлёво Восточное', 'Бирюлёво Западное', 'Братеево', 'Даниловский', 'Донской',
  'Зябликово', 'Нагатино-Садовники', 'Нагатинский затон', 'Нагорный',
  'Орехово-Борисово Северное', 'Орехово-Борисово Южное', 'Царицыно', 'Чертаново Северное', 'Чертаново Южное',
];

const faqs = [
  { q: 'Работаете ли вы на территории бывшего завода ЗИЛ?', a: 'Да, территория масштабного редевелопмента бывшего автозавода (жилой квартал «ЗИЛАРТ» и прилегающие объекты) — активная зона строительства с современной инфраструктурой подъезда, но на переходный период часто действует единый пропускной режим общей территории застройки.' },
  { q: 'Можно ли работать краном рядом с музеем-заповедником «Царицыно» или «Коломенское»?', a: 'Территории музеев-заповедников имеют охранный статус — работы в непосредственной близости от исторических объектов требуют согласования с администрацией заповедника, отдельного от стандартного строительного разрешения. Уточняем это по конкретному адресу до выезда техники.' },
  { q: 'Какая специфика логистики по Варшавскому и Каширскому шоссе?', a: 'Обе магистрали — основные вылетные направления округа на юг, с интенсивным трафиком. Для объектов ближе к МКАД по этим направлениям закладываем запас на подачу техники с учётом трафика, особенно в часы пик.' },
];
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<BaseLayout title={title} description={description} path="/geo/yuao/" ldExtra={[breadcrumbLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/#geo">География</a><span>/</span><span>ЮАО</span>
  </nav>
  <section class="section wrap" style="padding-top:8px">
    <div class="section-head">
      <span class="eyebrow">География: Южный округ</span>
      <h1>Аренда автокрана в ЮАО Москвы</h1>
      <p>В ЮАО три разных порядка допуска на один округ: единый КПП застройки на редевелопменте ЗИЛ, согласование с администрацией музея-заповедника у Царицына и Коломенского и обычный порядок в Чертанове, Зябликове и Нагорном. Отдельный фронт тяжёлых заявок — реновация Нагатинского Затона: под снос идут 54 дома, больше всего адресов на Судостроительной и Затонной улицах, а новые корпуса ставят впритык к ещё заселённой пятиэтажной застройке 1960-х годов.</p>
      <p>Южный округ сочетает масштабный редевелопмент территории бывшего автозавода ЗИЛ, музеи-заповедники Царицыно и Коломенское с охранным статусом территории, и плотную жилую застройку вдоль Варшавского и Каширского шоссе.</p>
    </div>
    <div class="tools">
      <p class="tools__lead">Два инструмента, которые отвечают на разные вопросы по объекту в этом округе.</p>
      <p><a href="/proverka-dokumentov/">Проверка комплекта документов</a> — что из допуска уже есть, чего не хватает и сколько времени добавляет каждая недостающая позиция. Именно она чаще всего и определяет дату выезда.</p>
      <p><a href="/#zayavka">Ориентир по стоимости</a> — формула расчёта смены и коэффициент за пропускной режим, на главной странице, вместе с формой заявки.</p>
    </div>
  </section>
  <section class="section wrap prose" style="padding-top:0">
    <h2 style="margin-bottom:18px">Районы ЮАО, где мы регулярно работаем</h2>
    <p>{districts.join(', ')} — округ неоднороден: от активной новой застройки на месте бывших промышленных территорий до типовых спальных районов дальше на юг.</p>

    <ZoneTable
      caption="ЮАО по зонам: что меняет заявку"
      columns={['Территория округа', 'Что определяет заявку']}
      rows={zoneRows}
    />

    <h2 style="margin:36px 0 18px">Редевелопмент территории завода ЗИЛ</h2>
    <p>Территория бывшего Завода имени Лихачёва — один из крупнейших проектов редевелопмента промышленной зоны в городе, с жилым кварталом «ЗИЛАРТ» и продолжающейся застройкой прилегающих участков. Для строительных объектов здесь, как правило, современная инфраструктура подъезда, но часто действует единый пропускной режим общей территории застройки на переходный период — уточняем это заранее по конкретному адресу. Для башенного крана на этой территории — отдельный разбор грунта и переноса между очередями на <a href="/uslugi/bashennyy-kran/yuao/">странице услуги «Башенный кран в ЮАО»</a>.</p>

    <h2 style="margin:36px 0 18px">Царицыно и Коломенское — охранные зоны музеев-заповедников</h2>
    <p>Оба музея-заповедника — крупные природно-исторические территории с охранным статусом. Работы в непосредственной близости от границ заповедников (включая прилегающую жилую застройку районов Царицыно и Нагатинский затон) могут требовать согласования с администрацией заповедника отдельно от стандартного строительного разрешения — уточняем необходимость такого согласования по конкретному адресу до выезда техники. Порядок оформления пропуска для этих зон — на <a href="/uslugi/kran-na-rezhimnyy-obekt/yuao/">странице услуги «Кран на режимный объект в ЮАО»</a>.</p>

    <h2 style="margin:36px 0 18px">Реновация Нагатинского Затона</h2>
    <p>В Нагатинском Затоне под снос по программе реновации попадают 54 дома — больше всего адресов на улице Судостроительной и Затонной улице, а новое жильё уже строится на нескольких выделенных стартовых площадках. В отличие от редевелопмента ЗИЛа, здесь новые дома возводятся впритык к ещё заселённой пятиэтажной застройке 1960-х годов — специфика подбора техники для таких площадок разобрана на <a href="/uslugi/arenda-avtokrana-40-50-tonn/yuao/">странице услуги «Автокран 40–50 тонн в ЮАО»</a>.</p>

    <h2 style="margin:36px 0 18px">Логистика по Варшавскому и Каширскому шоссе</h2>
    <p>Обе магистрали — главные вылетные направления округа на юг города, с интенсивным трафиком в часы пик. Для отдалённых от центра округа районов (Бирюлёво, Орехово-Борисово, Братеево) время подачи техники ощутимо зависит от часа выезда относительно трафика на этих направлениях.</p>

    <h2 style="margin:36px 0 18px">Типовая жилая застройка: Чертаново, Зябликово, Нагорный</h2>
    <p>Основной объём заявок здесь — стандартные задачи спальных районов: капитальный ремонт фасадов и кровель, монтаж инженерного оборудования, подача материалов при реконструкции. Проезды здесь, как правило, шире, чем в исторической застройке центра.</p>

    <h2 style="margin:36px 0 18px">Цена работы в ЮАО</h2>
    <p>Базовая ставка — по грузоподъёмности крана (см. <a href="/#zayavka" style="color:var(--yellow)">ориентир по стоимости на главной</a>). Для объектов рядом с музеями-заповедниками закладываем время на согласование с администрацией территории. Для удалённых районов по Варшавскому/Каширскому направлениям стоимость подачи обсуждается индивидуально.</p>
  </section>
  <section class="section wrap" id="faq-geo">
    <div class="section-head"><span class="eyebrow">Вопросы</span><h2>Частые вопросы про работу в ЮАО</h2></div>
    <div class="faq">{faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}</div>
  </section>
  <section class="section wrap"><a class="btn" href="/#zayavka">Оставить заявку на объект в ЮАО →</a></section>
</main>
<style>
  .tools { background: var(--bg-2); border-left: 3px solid transparent; background-image: var(--hazard-edge); background-repeat: no-repeat; background-size: 3px 100%; background-position: left top; background-origin: border-box; padding: 18px 20px; max-width: 560px; display: grid; gap: 10px; font-size: var(--t-md); }
  .tools__lead { color: var(--muted); font-size: var(--t-md); }
  .tools a { color: var(--yellow); font-weight: 700; text-decoration: none; }
  .tools a:hover { text-decoration: underline; }
</style>
</BaseLayout>
