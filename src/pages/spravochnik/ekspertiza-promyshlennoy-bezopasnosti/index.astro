---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';
import Sources from '../../../components/Sources.astro';

const title = 'Когда крану нужна экспертиза промышленной безопасности';
const description = 'ЭПБ vs техническое освидетельствование: экспертиза шире и включает оценку монтажа, ремонта и систем безопасности. Когда именно она нужна для крана.';

const CHECKED = '12.08.2026';

const faqs = [
  { q: 'ЭПБ заменяет техническое освидетельствование?', a: 'Нет, наоборот — техническое освидетельствование входит в состав экспертизы промышленной безопасности как одна из её частей. ЭПБ шире: дополнительно оценивает качество монтажа, ремонта, реконструкции и состояние систем управления и безопасности.' },
  { q: 'Кто проводит экспертизу промышленной безопасности?', a: 'Специализированная экспертная организация, аттестованная на проведение таких экспертиз — не сама эксплуатирующая организация и не привлечённый специалист по обычному освидетельствованию. Заключение экспертизы вносится в реестр Ростехнадзора.' },
  { q: 'Что делать, если экспертиза выявила несоответствие требованиям?', a: 'Дальнейшая эксплуатация крана до устранения выявленных нарушений не допускается — заключение экспертизы прямо определяет, можно ли продолжать использовать технику. Это не рекомендация, а заключение с юридической силой.' },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Экспертиза промышленной безопасности', item: 'https://moskran-servis.ru/spravochnik/ekspertiza-promyshlennoy-bezopasnosti/' },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@id': 'https://moskran-servis.ru/#organization' }, // ссылка на единственный узел организации (BaseLayout): отдельный узел с тем же @id, но другим name, был противоречием в графе
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: 'https://moskran-servis.ru/spravochnik/ekspertiza-promyshlennoy-bezopasnosti/',
  inLanguage: 'ru-RU',
  datePublished: '2026-08-12',
  dateModified: '2026-08-12',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<SpravochnikLayout title={title} description={description} path="/spravochnik/ekspertiza-promyshlennoy-bezopasnosti/" slug="ekspertiza-promyshlennoy-bezopasnosti" ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Экспертиза промышленной безопасности</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Разбор для заказчика</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Экспертиза промышленной безопасности крана — когда требуется и чем отличается от освидетельствования</h1>
    <p class="ref-byline">Инженерная служба МОСКРАН-СЕРВИС · обновлено в 2026 году</p>

    <p>В статье про техническое освидетельствование мы упомянули, что это не то же самое, что экспертиза промышленной безопасности (ЭПБ). Здесь разбираем ЭПБ подробно: что это, когда требуется и почему это более серьёзная процедура, чем регулярное освидетельствование.</p>

    <h2 style="margin:36px 0 16px">Что такое экспертиза промышленной безопасности</h2>
    <p>ЭПБ — комплекс мер по анализу соответствия подъёмного сооружения требованиям промышленной безопасности. В отличие от технического освидетельствования (регулярной плановой проверки на протяжении срока службы), экспертиза — более глубокая и разовая процедура на конкретных этапах жизненного цикла техники.</p>

    <h2 style="margin:36px 0 16px">Что входит в экспертизу — шире, чем освидетельствование</h2>
    <p>В ходе ЭПБ выполняется полное техническое освидетельствование как составная часть, но дополнительно оценивается качество проведённого монтажа, ремонта или реконструкции подъёмного сооружения, а также комплектность и работоспособность системы управления, указателей, регистраторов, ограничителей грузоподъёмности, болтовых и сварных соединений. То есть освидетельствование — это часть экспертизы, а не альтернатива ей.</p>

    <h2 style="margin:36px 0 16px">Когда именно требуется ЭПБ</h2>
    <p>В отличие от освидетельствования, которое проводится регулярно по календарному графику (не реже раза в год и раза в 3 года — см. отдельную статью), экспертиза назначается в конкретных случаях: истечение нормативного срока службы крана, после аварии или инцидента, при обнаружении серьёзных дефектов в ходе очередного освидетельствования, а также перед вводом в эксплуатацию техники, бывшей в употреблении, или после реконструкции.</p>

    <h2 style="margin:36px 0 16px">Что происходит по итогам</h2>
    <p>По результатам экспертизы составляется заключение, содержащее оценку технического состояния крана, степень износа и возможность дальнейшей эксплуатации — с прямым выводом о соответствии или несоответствии требованиям промышленной безопасности. Если заключение отрицательное, дальнейшая эксплуатация крана до устранения нарушений не допускается — это не рекомендация, а документ с юридической силой, вносимый в реестр Ростехнадзора.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: что запомнить</h2>
    <ul>
      <li>ЭПБ включает техническое освидетельствование как часть, но идёт значительно дальше — оценивает монтаж, ремонт, системы безопасности целиком.</li>
      <li>Освидетельствование — регулярная плановая проверка; ЭПБ — разовая процедура на конкретных этапах жизни техники (истечение срока службы, авария, серьёзные дефекты).</li>
      <li>Проводит ЭПБ специализированная аттестованная экспертная организация, не эксплуатирующая компания самостоятельно.</li>
      <li>Отрицательное заключение прямо запрещает дальнейшую эксплуатацию до устранения нарушений.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <Sources
      checked={CHECKED}
      items={[
        { text: 'peinvest.ru — экспертиза промышленной безопасности подъёмных сооружений', href: 'https://peinvest.ru/ekspertiza-promyshlennoi-bezopasnosti/ekspertiza-promyshlennoi-bezopasnosti-podieemnykh-sooruzhenii/' },
        { text: 'tke-moscow.ru — Ростехнадзор разъясняет: ЭПБ подъёмных сооружений', href: 'https://tke-moscow.ru/news/1724917335/' }
      ]}
    />
  </article>
  <section class="section wrap"><a class="btn" href="/spravochnik/tehnicheskoe-osvidetelstvovanie-krana/">Разница с техническим освидетельствованием →</a></section>
</main>
</SpravochnikLayout>
