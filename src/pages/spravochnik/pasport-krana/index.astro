---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';
import Sources from '../../../components/Sources.astro';

const title = 'Что входит в паспорт крана по ГОСТ 34022-2016';
const description = 'Паспорт крана содержит титульную часть, чертёж общего вида, общие сведения и данные о регистрации. Регулируется ГОСТ 34022-2016.';

const CHECKED = '12.08.2026';

const faqs = [
  { q: 'Паспорт крана — это то же самое, что документ о техническом освидетельствовании?', a: 'Нет. Паспорт — базовый документ на конкретную единицу техники, оформляемый изготовителем при выпуске (содержит характеристики, чертежи, общие сведения). Техническое освидетельствование (ЧТО/ПТО, о котором мы писали отдельно) — регулярная проверка состояния уже эксплуатируемого крана, результаты которой фиксируются отдельно, часто со ссылкой на данные паспорта.' },
  { q: 'На каком языке должен быть паспорт крана в России?', a: 'Паспорт заполняется на русском языке — это прямое требование, применимое и к отечественной, и к импортной технике, эксплуатируемой на территории России.' },
  { q: 'Можно ли запросить у подрядчика паспорт конкретной единицы техники?', a: 'Да, это законный запрос — паспорт содержит грузовысотную характеристику и другие параметры, которые мы используем при расчёте заявки. По запросу предоставляем эти данные вместе с остальным комплектом документов.' },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Паспорт крана', item: 'https://moskran-servis.ru/spravochnik/pasport-krana/' },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@id': 'https://moskran-servis.ru/#organization' }, // ссылка на единственный узел организации (BaseLayout): отдельный узел с тем же @id, но другим name, был противоречием в графе
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: 'https://moskran-servis.ru/spravochnik/pasport-krana/',
  inLanguage: 'ru-RU',
  datePublished: '2026-08-12',
  dateModified: '2026-08-12',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<SpravochnikLayout title={title} description={description} path="/spravochnik/pasport-krana/" slug="pasport-krana" ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Паспорт крана</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Разбор для заказчика</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Паспорт крана — что это за документ и что в нём содержится</h1>
    <p class="ref-byline">Инженерная служба МОСКРАН-СЕРВИС · обновлено в 2026 году</p>

    <p>Мы много ссылаемся на «паспортную грузоподъёмность» и «данные паспорта конкретной модели» в других статьях. Здесь разбираем, что это за документ на самом деле.</p>

    <h2 style="margin:36px 0 16px">Что такое паспорт крана</h2>
    <p>Паспорт грузоподъёмного крана — базовый эксплуатационный документ на конкретную единицу техники, оформляемый изготовителем. Структура и обязательные разделы регулируются ГОСТ 34022-2016 «Краны грузоподъёмные. Эксплуатационные документы».</p>

    <h2 style="margin:36px 0 16px">Из чего состоит паспорт</h2>
    <p>Документ включает: титульную часть (наименование изготовителя, наименование и тип устройства, идентификационное обозначение паспорта, данные регистрации в государственных органах надзора), указания, требующие внимания владельца оборудования, чертёж общего вида с основными размерами, и раздел «Общие сведения» — включающий, в частности, грузовысотную характеристику, о которой мы подробно писали отдельно.</p>

    <h2 style="margin:36px 0 16px">Требование к языку документа</h2>
    <p>Паспорт заполняется на русском языке — это относится и к импортной технике (мы указываем в разделе «Парк техники» модели XCMG, Zoomlion, Liebherr, Potain), для которой при вводе в эксплуатацию на территории России оформляется паспорт на русском языке, а не только оригинальная документация производителя.</p>

    <h2 style="margin:36px 0 16px">Чем паспорт отличается от документа освидетельствования</h2>
    <p>Паспорт — статичный базовый документ, оформляемый один раз при выпуске техники и содержащий её неизменные технические характеристики. Техническое освидетельствование (ЧТО/ПТО) — регулярная проверка текущего состояния уже эксплуатируемого крана, результаты которой фиксируются отдельными документами со ссылкой на данные паспорта, но не заменяют его.</p>

    <h2 style="margin:36px 0 16px">Что в паспорте появляется уже при эксплуатации</h2>
    <p>Утверждение «паспорт оформляется один раз и больше не меняется» верно только для технической части. Правила прямо предписывают записывать в паспорт результаты технического освидетельствования с указанием срока следующего — это пункт 189 федеральных норм и правил по подъёмным сооружениям. То есть страница с записями об освидетельствовании и есть тот единственный лист, по которому проверяется, действует ли допуск машины сегодня.</p>
    <p>Периодичность задана там же: частичное освидетельствование — не реже одного раза в 12 месяцев, полное — не реже одного раза в 3 года; для подъёмных сооружений, используемых редко, полное проводится раз в 5 лет. Проводит освидетельствование инженерно-технический работник, ответственный за осуществление производственного контроля, при участии ответственного за содержание подъёмного сооружения в работоспособном состоянии.</p>
    <p>Практический вывод для заказчика: просить «паспорт крана» целиком не нужно и обычно бессмысленно — это толстый документ с чертежами. Достаточно двух вещей: титульной части (какая именно машина, заводской номер) и страницы с последней записью об освидетельствовании. Если даты в записи нет или срок следующего уже прошёл — дальше можно не смотреть.</p>

    <h2 style="margin:36px 0 16px">Паспорт и декларация соответствия — разные документы</h2>
    <p>Подъёмное сооружение выпускается в обращение по техническому регламенту Таможенного союза «О безопасности машин и оборудования» (ТР ТС 010/2011): это подтверждение того, что машина как продукция соответствует требованиям безопасности. Паспорт — эксплуатационный документ конкретного экземпляра. Наличие декларации не заменяет записей в паспорте, и наоборот. Для импортной техники это различие важнее всего: <a href="/spravochnik/deklaraciya-tr-ts-010/" style="color:var(--yellow)">разбор декларации</a> у нас отдельный.</p>

    <h2 style="margin:36px 0 16px">Что из паспорта нужно до подписания заявки</h2>
    <p>Из всего документа для расчёта заявки используются три вещи: грузовая характеристика на нужном вылете, предельный уклон площадки и требования к установке на выносные опоры. Первое определяет, поднимет ли машина груз с той точки, куда она физически может встать; второе и третье — можно ли на эту точку встать вообще. Всё остальное в паспорте относится к содержанию машины, а не к вашей задаче.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: что запомнить</h2>
    <ul>
      <li>Паспорт крана — базовый документ изготовителя с характеристиками, чертежами и общими сведениями.</li>
      <li>Структура регулируется ГОСТ 34022-2016.</li>
      <li>Заполняется на русском языке, включая импортную технику.</li>
      <li>Результаты освидетельствования записываются в сам паспорт с указанием срока следующего (ФНП №461, п. 189) — это и есть страница, по которой проверяют допуск.</li>
      <li>Заказчику нужны две страницы: титульная и последняя запись об освидетельствовании, а не весь документ.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <Sources
      checked={CHECKED}
      items={[
        { text: 'Приказ Ростехнадзора от 26.11.2020 №461 (ред. от 16.04.2026): п. 165 — периодичность освидетельствования, п. 167 — кто проводит, п. 189 — запись результатов в паспорт', href: 'https://www.consultant.ru/document/cons_doc_LAW_373321/' },
        { text: 'ГОСТ 34022-2016 «Краны грузоподъёмные. Эксплуатационные документы» — состав и структура паспорта', href: 'https://docs.cntd.ru/document/1200144616' },
        { text: 'ТР ТС 010/2011 «О безопасности машин и оборудования» — подтверждение соответствия продукции' },
      ]}
      note="Требование к языку документа и состав разделов — по ГОСТ; периодичность и запись об освидетельствовании — по ФНП №461."
    />

  </article>
  <section class="section wrap"><a class="btn" href="/spravochnik/gruzovysotnaya-harakteristika/">Грузовысотная характеристика из паспорта →</a></section>
</main>
</SpravochnikLayout>
