---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = 'Нужен ли автокрану пропуск для въезда в Москву';
const description = 'Пропуск автокрана в Москву: порог 3,5 т внутри МКАД, дневные и ночные пропуска, РНИС, штраф 7 500 ₽. Чем пропуск отличается от спецразрешения.';

const CHECKED = '25.09.2026';
const PUBLISHED = '2026-09-25';
const SLUG = 'propusk-avtokrana-v-moskvu';
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: 'Нужен ли пропуск автокрану, чтобы доехать до площадки внутри МКАД?',
    a: 'Да. Грузовым автомобилям с разрешённой максимальной массой более 3,5 т движение по МКАД и внутри неё ограничено круглосуточно, а масса любого автокрана МОСКРАН-СЕРВИС — от 16-тонного «Ивановца» КС-35714 до 50-тонного «Галичанина» — заведомо выше этого порога. Без действующего пропуска в нужную зону автокран до площадки внутри МКАД не доедет.',
  },
  {
    q: 'Кто оформляет пропуск — заказчик или арендодатель крана?',
    a: 'Пропуск оформляется на конкретное транспортное средство, поэтому при аренде автокрана с экипажем его обеспечивает владелец машины, а не заказчик. В заявке в МОСКРАН-СЕРВИС достаточно указать точный адрес, дату и время работ — от этого зависит, какой пропуск нужен: дневной или ночной и в какую зону.',
  },
  {
    q: 'Сколько стоит пропуск на МКАД для грузовика?',
    a: 'По данным транспортного портала Москвы, пропуск для грузового транспорта выдаётся бесплатно. Для его оформления машина должна быть зарегистрирована в региональной навигационной системе РНИС. Коэффициент 1,12 в расчёте МОСКРАН-СЕРВИС относится к объектам с пропускным режимом на территорию, а не к городскому пропуску на въезд.',
  },
  {
    q: 'Какой штраф за проезд грузовика без пропуска в Москве?',
    a: 'В Москве и Санкт-Петербурге за нарушение знаков, запрещающих движение грузовых ТС, ч. 7 ст. 12.16 КоАП РФ предусматривает штраф 7 500 ₽. Повторное нарушение по ч. 8 той же статьи — 10 000 ₽. Нарушение фиксируют камеры, поэтому за одну поездку без пропуска машина может получить несколько постановлений.',
  },
  {
    q: 'Пропуск на МКАД и спецразрешение — это одно и то же?',
    a: 'Нет. Пропуск снимает городское ограничение движения грузового транспорта по зонам Москвы. Специальное разрешение по постановлению Правительства РФ №2060 нужно тяжеловесному или крупногабаритному ТС, превышающему допустимые нагрузки или габариты на дороге. Тяжёлым автокранам МОСКРАН-СЕРВИС может понадобиться и то и другое.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Пропуск автокрана в Москву', item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ['zony', 'Зоны ограничения в Москве'],
  ['vidy', 'Виды пропусков для грузового транспорта'],
  ['rnis', 'РНИС: без навигации пропуск не выдают'],
  ['tri-dokumenta', 'Пропуск, спецразрешение и пропуск на объект'],
  ['zayavka', 'Что указать в заявке'],
  ['faq', 'Частые вопросы'],
  ['istochniki', 'Источники'],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Пропуск автокрана в Москву</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Москва · Проезд техники</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Нужен ли автокрану пропуск для въезда в Москву?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>25.09.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>25.09.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>6 мин чтения</span>
    </div>

    <p>Да: грузовым автомобилям с разрешённой максимальной массой более 3,5 т движение по МКАД и внутри неё ограничено круглосуточно, а любой автокран тяжелее этого порога. Пропуск в Москве бывает дневным (7:00–23:00) и ночным (23:00–7:00), разовым до 10 суток или годовым, выдаётся бесплатно и только машине, зарегистрированной в РНИС. МОСКРАН-СЕРВИС учитывает зону и время пропуска при подборе крана под вашу заявку.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="zony" style="margin:36px 0 16px">Зоны ограничения в Москве</h2>
    <p>Ограничения движения грузового транспорта в Москве установлены постановлением Правительства Москвы от 22.08.2011 №379-ПП и делят город на зоны: МКАД, Третье транспортное кольцо и Садовое кольцо. Для машин с разрешённой максимальной массой более 3,5 т въезд на МКАД и внутрь неё закрыт без пропуска круглосуточно; отдельный порог 12 т относится к самым тяжёлым машинам. Автокраны МОСКРАН-СЕРВИС заведомо тяжелее 3,5 т, поэтому под ограничение попадает любая площадка внутри МКАД.</p>
    <p>Чем ближе к центру, тем строже условия: по данным транспортного портала Москвы, в зону внутри ТТК допускаются грузовики экологического класса не ниже Евро-3. Для заказчика вывод простой: адрес площадки определяет, какой пропуск нужен машине, и МОСКРАН-СЕРВИС проверяет это до подтверждения заявки. Для площадок за МКАД, в том числе в ТиНАО, зона ограничения важна, только если маршрут проходит по МКАД или через неё.</p>

    <h2 id="vidy" style="margin:36px 0 16px">Виды пропусков для грузового транспорта</h2>
    <p>Пропуска в Москве различаются по времени суток и сроку: дневной действует с 7:00 до 23:00, ночной — с 23:00 до 7:00; разовый выдаётся на срок до 10 суток, долгосрочный — до одного года. Пропуск бесплатный и оформляется через mos.ru на конкретное транспортное средство. Для МОСКРАН-СЕРВИС это означает, что на ночную работу подаётся машина с ночным пропуском в нужную зону, а не любая свободная.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Пропуск</th><th>Время действия</th><th>Срок</th></tr></thead>
        <tbody>
          <tr><td>Дневной</td><td>7:00–23:00</td><td>разовый или годовой</td></tr>
          <tr><td>Ночной</td><td>23:00–7:00</td><td>разовый или годовой</td></tr>
          <tr><td>Разовый</td><td>дневной или ночной</td><td>до 10 суток</td></tr>
          <tr><td>Долгосрочный</td><td>дневной или ночной</td><td>до 1 года</td></tr>
        </tbody>
      </table>
    </div>
    <p>Ночной пропуск решает только вопрос проезда, но не право шуметь: погрузочно-разгрузочные и строительные работы рядом с жильём ограничены законом Москвы о тишине с 23:00 до 7:00. Как эти два ограничения совмещает МОСКРАН-СЕРВИС на зимних сменах, разобрано в <a href="/spravochnik/rabota-krana-zimoy/" style="color:var(--yellow)">материале о работе крана зимой</a>.</p>

    <h2 id="rnis" style="margin:36px 0 16px">РНИС: без навигации пропуск не выдают</h2>
    <p>С 1 января 2022 года грузовик с разрешённой массой более 3,5 т получает пропуск в Москву только при регистрации в региональной навигационно-информационной системе города — РНИС. Навигационное оборудование передаёт данные о движении машины, и по ним проверяется соблюдение условий пропуска. Автокраны МОСКРАН-СЕРВИС, работающие внутри МКАД, должны быть зарегистрированы в РНИС так же, как любой грузовик.</p>
    <p>Нарушение ограничений фиксируют камеры, и штраф по ч. 7 ст. 12.16 КоАП РФ для Москвы составляет 7 500 ₽, а за повторное нарушение по ч. 8 — 10 000 ₽. Штраф получает владелец машины, но последствия ложатся и на заказчика: кран, остановленный по дороге, не приезжает к назначенному времени. Поэтому МОСКРАН-СЕРВИС сверяет маршрут с зоной и сроком пропуска до выезда техники.</p>

    <h2 id="tri-dokumenta" style="margin:36px 0 16px">Пропуск, спецразрешение и пропуск на объект</h2>
    <p>Автокрану в Москве могут понадобиться три разных документа, и путать их — частая причина сорванной подачи: городской пропуск, специальное разрешение на движение тяжеловесного ТС и пропуск на территорию объекта. Первые два оформляет владелец крана, третий — служба режимного объекта по данным, которые предоставляет МОСКРАН-СЕРВИС.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Документ</th><th>Когда нужен</th><th>Основание</th></tr></thead>
        <tbody>
          <tr><td>Пропуск в зону Москвы</td><td>въезд на МКАД и внутрь</td><td>ПП Москвы №379-ПП</td></tr>
          <tr><td>Спецразрешение</td><td>превышение нагрузок или габаритов</td><td>ПП РФ №2060</td></tr>
          <tr><td>Пропуск на объект</td><td>территория с пропускным режимом</td><td>правила объекта</td></tr>
        </tbody>
      </table>
    </div>
    <p>Спецразрешение нужно не всякому автокрану, а только тяжеловесному или крупногабаритному, — критерии разобраны в <a href="/spravochnik/spetsrazreshenie-na-dvizhenie-avtokrana/" style="color:var(--yellow)">материале о спецразрешении</a>. Пропуск на режимный объект МОСКРАН-СЕРВИС оформляет вместе с заказчиком, перечень данных на технику и бригаду — в <a href="/documents/propusk-na-obekt/" style="color:var(--yellow)">разделе документов</a>.</p>

    <h2 id="zayavka" style="margin:36px 0 16px">Что указать в заявке</h2>
    <p>Для проверки пропуска МОСКРАН-СЕРВИС нужны четыре сведения о работе, и все они обычно уже есть у прораба:</p>
    <ul>
      <li><strong>Точный адрес и въезд.</strong> Определяют зону: МКАД, ТТК или Садовое.</li>
      <li><strong>Дата и время подачи.</strong> Определяют дневной или ночной пропуск.</li>
      <li><strong>Длительность работ.</strong> Решает, хватит ли разового пропуска.</li>
      <li><strong>Режим объекта.</strong> Нужен ли пропуск на территорию.</li>
    </ul>
    <p>Полный перечень данных для подбора крана — масса груза, вылет, место установки, сети — приведён в <a href="/spravochnik/zayavka-na-avtokran/" style="color:var(--yellow)">материале о заявке на автокран</a>. Как пропускной режим объекта влияет на итоговую сумму аренды у МОСКРАН-СЕРВИС, разобрано в <a href="/spravochnik/stoimost-arendy-avtokrana/" style="color:var(--yellow)">материале о стоимости аренды автокрана</a>.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: пропуск для автокрана</h2>
    <ul>
      <li>Внутри МКАД — пропуск нужен круглосуточно.</li>
      <li>Дневной 7–23, ночной 23–7.</li>
      <li>Разовый до 10 суток, годовой до года.</li>
      <li>Бесплатно, только с регистрацией в РНИС.</li>
      <li>Штраф в Москве — 7 500 ₽, повторно 10 000 ₽.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://transport.mos.ru/gruzoviki/perevod_ckad" target="_blank" rel="noopener" style="color:var(--yellow)">Транспортный портал Москвы — пропуска для грузового транспорта</a>: пороги 3,5 и 12 т, дневные и ночные пропуска, сроки, РНИС, ПП Москвы №379-ПП.</li>
      <li><a href="https://www.mos.ru/otvet-transport/kak-oformit-propusk-dlya-gruzovogo-transporta/" target="_blank" rel="noopener" style="color:var(--yellow)">mos.ru — как оформить пропуск для грузового транспорта</a>.</li>
      <li><a href="https://www.zakonrf.info/koap/12.16/" target="_blank" rel="noopener" style="color:var(--yellow)">КоАП РФ, ст. 12.16, ч. 7 и 8</a> — штраф 7 500 ₽ в Москве и 10 000 ₽ за повторное нарушение.</li>
    </ul>
    <p class="srcs__note" style="color:var(--muted);font-size:var(--t-sm)">Сроки рассмотрения заявлений на пропуск и перечни улиц грузового каркаса МОСКРАН-СЕРВИС не приводит: они меняются актами Департамента транспорта — актуальные значения смотрите на mos.ru на дату работ.</p>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/kran-na-rezhimnyy-obekt/">Кран на режимный объект →</a></section>
</main>
</SpravochnikLayout>
