---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';
import Sources from '../../../components/Sources.astro';

const title = 'Как проходит аттестация крановщика в Ростехнадзоре';
const description = 'Требования к машинисту крана: допуск по электробезопасности, экзамен с участием инспектора Ростехнадзора, периодическая переаттестация.';

const CHECKED = '12.08.2026';

const faqs = [
  { q: 'Достаточно ли одного удостоверения на всю карьеру крановщика?', a: 'Нет, периодическая проверка знаний — обязательное требование, крановщик регулярно подтверждает квалификацию, а не полагается на однажды выданное удостоверение бессрочно.' },
  { q: 'Может ли крановщик с удостоверением на автокран управлять башенным краном?', a: 'Нет, это разные категории допуска — аттестация машиниста крана привязана к типу и, для части категорий, классу техники. Управление башенным краном требует отдельной аттестации, не совпадающей автоматически с допуском на автокран.' },
  { q: 'Что если у заказчика есть сомнения в квалификации присланного оператора?', a: 'Заказчик вправе попросить показать действующее удостоверение оператора на месте — это законное и разумное требование, добросовестный подрядчик предоставит документ без возражений.' },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Аттестация крановщика', item: 'https://moskran-servis.ru/spravochnik/attestaciya-kranovshchika/' },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@id': 'https://moskran-servis.ru/#organization' }, // ссылка на единственный узел организации (BaseLayout): отдельный узел с тем же @id, но другим name, был противоречием в графе
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: 'https://moskran-servis.ru/spravochnik/attestaciya-kranovshchika/',
  inLanguage: 'ru-RU',
  datePublished: '2026-08-12',
  dateModified: '2026-08-12',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<SpravochnikLayout title={title} description={description} path="/spravochnik/attestaciya-kranovshchika/" slug="attestaciya-kranovshchika" ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Аттестация крановщика</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Разбор для заказчика</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Аттестация крановщика — что должен знать и уметь оператор крана</h1>
    <p class="ref-byline">Инженерная служба МОСКРАН-СЕРВИС · обновлено в 2026 году</p>

    <p>На странице услуги «Автокраны 16–25 тонн» мы уже писали, что не подаём на объект технику без аттестованного оператора. Здесь разбираем подробно, что именно означает эта аттестация и почему это не формальный листок, а реальная проверка квалификации.</p>

    <h2 style="margin:36px 0 16px">Почему кран — не та техника, где хватает водительских прав</h2>
    <p>Грузоподъёмный кран — объект повышенной опасности, и управление им требует не только навыка вождения или базового технического образования, а специфических знаний: устройство и принцип действия приборов безопасности крана, основы промышленной, пожарной и энергетической безопасности, порядок действий при отказе оборудования. Обычные водительские права на управление краном не распространяются — нужна отдельная профессиональная аттестация.</p>

    <h2 style="margin:36px 0 16px">Требование по электробезопасности</h2>
    <p>Отдельное обязательное требование к машинисту крана — допуск не ниже III группы по электробезопасности при напряжении до 1000 В. Это отдельная категория подготовки, не совпадающая автоматически с аттестацией на управление краном, но обязательная в дополнение к ней — крановщик регулярно работает в условиях, где есть риск контакта стрелы или груза с воздушными линиями электропередач (подробнее об этом — в отдельной статье про охранные зоны ЛЭП).</p>

    <h2 style="margin:36px 0 16px">Как проходит итоговый экзамен</h2>
    <p>Итоговый экзамен на аттестацию машиниста крана проходит с участием инспектора Федеральной службы по экологическому, технологическому и атомному надзору (Ростехнадзор) — это не внутренняя проверка учебного центра, а процедура с участием независимого контролирующего органа. Успешно прошедшим обучение выдаётся удостоверение машиниста (крановщика) установленного образца вместе с дипломом о профессиональной подготовке.</p>

    <h2 style="margin:36px 0 16px">Периодическая переаттестация — почему это не разово</h2>
    <p>Полученное удостоверение не действует бессрочно без подтверждения: периодическая проверка знаний машиниста крана — обязательное требование охраны труда. Крановщик регулярно подтверждает квалификацию заново, а не полагается на однажды пройденный экзамен на всю карьеру. Это логично: нормативная база меняется (как показывает история перехода от ПБ 10-382-00 к ФНП №461), а навыки без практики со временем притупляются.</p>

    <h2 style="margin:36px 0 16px">Что это значит для заказчика</h2>
    <p>Заказчик вправе попросить показать действующее удостоверение присланного оператора на месте — это законное требование, а не проявление недоверия. Мы не подаём технику без аттестованного оператора с действующим удостоверением ни при каких обстоятельствах — это не предмет переговоров и не то, чем можно пожертвовать ради более быстрой подачи техники, о чём мы уже писали на странице услуги «Автокраны 16–25 тонн».</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: что запомнить</h2>
    <ul>
      <li>Управление краном требует отдельной профессиональной аттестации, не заменяемой водительскими правами.</li>
      <li>Обязателен допуск не ниже III группы по электробезопасности до 1000 В.</li>
      <li>Итоговый экзамен проходит с участием инспектора Ростехнадзора, а не только внутреннего преподавателя.</li>
      <li>Аттестация подтверждается периодически, не выдаётся один раз на всю карьеру.</li>
      <li>Заказчик вправе попросить показать действующее удостоверение оператора на объекте.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <Sources
      checked={CHECKED}
      items={[
        { text: 'stroy-technics.ru — обучение, аттестация и проверка знаний крановщиков', href: 'https://stroy-technics.ru/article/obuchenie-attestatsiya-i-povtornaya-proverka-znanii-kranovshchikov' },
        { text: 'krantest.ru — квалификационные требования к машинисту крана (разъяснение Минтруда)', href: 'https://krantest.ru/news/1743747092/' }
      ]}
    />
  </article>
  <section class="section wrap"><a class="btn" href="/documents/">Что ещё входит в комплект документов →</a></section>
</main>
</SpravochnikLayout>
