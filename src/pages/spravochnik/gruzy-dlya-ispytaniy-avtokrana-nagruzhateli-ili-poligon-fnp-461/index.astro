---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = "Чем нагружают автокран при испытаниях: грузы и полигон";
const description = "Для испытаний кранов организация обязана иметь грузы-нагружатели или полигон, аренда грузов допускается (п. 22 «о» ФНП №461); статика 125 %, динамика 110 %.";

const CHECKED = '30.10.2026';
const PUBLISHED = '2026-10-30';
const SLUG = "gruzy-dlya-ispytaniy-avtokrana-nagruzhateli-ili-poligon-fnp-461";
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    "q": "Какими грузами испытывают автокран?",
    "a": "Контрольными грузами или специальными нагружателями: эксплуатирующая организация обязана иметь их либо проводить испытания на специально оборудованном полигоне, а грузы допускается брать в аренду у других организаций (п. 22 «о» ФНП №461). Масса контрольных грузов не должна отличаться от нужной более чем на 3 % (п. 171)."
  },
  {
    "q": "Сколько процентов от грузоподъёмности берут при испытаниях автокрана?",
    "a": "Статические испытания проводят грузом в 125 % паспортной грузоподъёмности (для кранов-трубоукладчиков 140 %), динамические — грузом на 10 % выше паспортной (пп. 171, 179 ФНП №461). Для крана на 25 т это 31,25 т и 27,5 т соответственно — арифметика по этим пунктам."
  },
  {
    "q": "Можно ли испытать автокран грузом, взятым в аренду?",
    "a": "Да: п. 22 «о» ФНП №461 прямо разрешает применять для испытаний грузы, взятые в аренду в других организациях. Требования к массе те же: отклонение контрольного груза от необходимой массы не более 3 % (п. 171)."
  },
  {
    "q": "Чем проверяют ограничитель грузоподъёмности?",
    "a": "Грузами или аттестованным устройством нагружения иного типа с погрешностью не более 3 % (п. 262 ФНП №461). Проверку проводят работники, отвечающие требованиям п. 20, в присутствии инженерно-технического работника (п. 261)."
  },
  {
    "q": "Должен ли заказчик предоставлять груз для испытаний арендованного крана?",
    "a": "Нет: обязанность иметь нагружатели или полигон лежит на эксплуатирующей организации (п. 22 «о» ФНП №461). При аренде с экипажем это арендодатель, поэтому МОСКРАН-СЕРВИС не требует от заказчика ни грузов, ни площадки под испытания."
  }
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: "Грузы для испытаний автокрана", item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [["obyazannost", "Кто обязан обеспечить грузы для испытаний"], ["massy", "Какой массой нагружают кран"], ["ogranichitel", "Чем проверяют ограничитель грузоподъёмности"], ["primer", "Пример расчёта для крана на 25 тонн"], ["zakazchik", "Что это значит для заказчика"], ["faq", "Частые вопросы"], ["istochniki", "Источники"]];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Грузы для испытаний автокрана</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">ФНП №461 · Испытания</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Чем нагружают автокран при испытаниях: грузы или полигон?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>30.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>30.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>6 мин чтения</span>
    </div>

    <p>Эксплуатирующая организация обязана иметь грузы (специальные нагружатели) для испытаний крана либо проводить испытания на специально оборудованном полигоне, а грузы допускается брать в аренду у других организаций (п. 22 «о» ФНП №461). Статическое испытание идёт грузом в 125 % паспортной грузоподъёмности, динамическое — на 10 % выше паспортной (пп. 171, 179), поэтому для КС-55713 «Клинцы» на 25 т речь о 31,25 т и 27,5 т.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="obyazannost" style="margin:36px 0 16px">Кто обязан обеспечить грузы для испытаний</h2>
    <p>Подпункт «о» пункта 22 ФНП №461 возлагает на эксплуатирующую организацию выбор из двух вариантов: держать собственные контрольные грузы или нагружатели либо испытывать краны на специально оборудованном полигоне. Третий путь прописан в той же строке: для испытаний допускается применять грузы, взятые в аренду в других организациях.</p>
    <p>Для арендованного автокрана вывод простой: груз для освидетельствования готовит арендодатель, а не заказчик на своей площадке. Порядок самих испытаний описан в справках про <a href="/spravochnik/staticheskie-i-dinamicheskie-ispytaniya-avtokrana-fnp-461/" style="color:var(--yellow)">статические и динамические испытания автокрана</a> и про <a href="/spravochnik/tehnicheskoe-osvidetelstvovanie-krana/" style="color:var(--yellow)">техническое освидетельствование крана</a>.</p>

    <h2 id="massy" style="margin:36px 0 16px">Какой массой нагружают кран</h2>
    <p>Пункт 171 ФНП №461 задаёт статическую нагрузку в процентах от номинальной паспортной грузоподъёмности: 125 % для подъёмных сооружений всех типов, кроме подъёмников, и 140 % для кранов-трубоукладчиков. Масса контрольных грузов не должна отличаться от необходимой более чем на 3 %. Перед испытанием тормоза всех механизмов регулируют на тормозной момент из паспорта, а ограничитель грузоподъёмности отключают.</p>
    <p>Пункт 179 для динамических испытаний требует груз на 10 % тяжелее паспортной грузоподъёмности и не менее трёх подъёмов и опусканий. Таблица собирает числа, которые задают массу нагружателей для автокрана.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Вид проверки</th><th>Масса груза</th><th>Допуск и условия</th><th>Пункт ФНП №461</th></tr></thead>
        <tbody>
          <tr><td>Статические испытания автокрана</td><td>125 % паспортной грузоподъёмности</td><td>Масса груза ±3 %; ограничитель отключён</td><td>171</td></tr>
          <tr><td>Статические испытания крана-трубоукладчика</td><td>140 %</td><td>Масса груза ±3 %</td><td>171</td></tr>
          <tr><td>Динамические испытания</td><td>110 %</td><td>Не менее трёх подъёмов и опусканий</td><td>179</td></tr>
          <tr><td>Проверка ограничителя грузоподъёмности</td><td>Грузы или аттестованное устройство нагружения</td><td>Погрешность не более 3 %</td><td>262</td></tr>
        </tbody>
      </table>
    </div>

    <h2 id="ogranichitel" style="margin:36px 0 16px">Чем проверяют ограничитель грузоподъёмности</h2>
    <p>Пункт 262 ФНП №461 разрешает проверять ограничитель грузоподъёмности грузами или аттестованным устройством нагружения другого типа с погрешностью не более 3 %. По п. 261 проверку выполняют работники, отвечающие требованиям п. 20, в присутствии инженерно-технического работника. У КС-65713-1 «Галичанин» ограничитель — один из приборов безопасности, без которого эксплуатировать кран нельзя (п. 22 «г»).</p>
    <p>Практический разбор приведён в справках про <a href="/spravochnik/ogranichitel-gruzopodemnosti/" style="color:var(--yellow)">ограничитель грузоподъёмности</a> и про <a href="/spravochnik/remont-ogranichitelya-gruzopodemnosti-avtokrana-fnp-461/" style="color:var(--yellow)">ремонт ограничителя грузоподъёмности</a>.</p>

    <h2 id="primer" style="margin:36px 0 16px">Пример расчёта для крана на 25 тонн</h2>
    <p>Для автокрана с паспортной грузоподъёмностью 25 т статический контрольный груз составит 25 × 1,25 = 31,25 т, допуск по массе 3 % даёт примерно 0,94 т, то есть груз укладывается в диапазон около 30,3–32,2 т. Динамический груз равен 25 × 1,10 = 27,5 т. Расчёт — арифметика по пп. 171 и 179 ФНП №461; фактические нагрузки для конкретной машины задают её паспорт и руководство по эксплуатации.</p>
    <ol>
      <li>Найдите паспортную грузоподъёмность на <a href="/spravochnik/tablichki-na-avtokrane-fnp-461/" style="color:var(--yellow)">табличке крана</a>.</li>
      <li>Умножьте её на 1,25 для статики и на 1,10 для динамики.</li>
      <li>Проверьте, что допуск массы груза не превышает 3 %.</li>
    </ol>

    <h2 id="zakazchik" style="margin:36px 0 16px">Что это значит для заказчика</h2>
    <p>Заказчику не нужно предоставлять груз, площадку под полигон или людей для испытаний: по п. 22 «о» ФНП №461 это забота эксплуатирующей организации. МОСКРАН-СЕРВИС передаёт вместе с краном копию паспорта, где записаны даты освидетельствований, и заказчик сверяет, что срок следующего не прошёл. Как читать эти записи, объясняет справка про <a href="/spravochnik/zapis-v-pasporte-ob-osvidetelstvovanii-avtokrana-fnp-461/" style="color:var(--yellow)">запись в паспорте об освидетельствовании</a>.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: грузы для испытаний автокрана</h2>
    <ul>
      <li>Нагружатели или полигон обеспечивает эксплуатирующая организация, грузы можно арендовать (п. 22 «о» ФНП №461).</li>
      <li>Статика — 125 % паспортной грузоподъёмности, динамика — 110 %, допуск массы груза 3 % (пп. 171, 179).</li>
      <li>Ограничитель грузоподъёмности проверяют грузами или устройством нагружения с погрешностью до 3 % (п. 262).</li>
      <li>Заказчик груз для испытаний арендованного крана не предоставляет.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://www.consultant.ru/document/cons_doc_LAW_373321/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 (приказ Ростехнадзора от 26.11.2020 №461)</a> — п. 22 «о», пп. 171, 179, 261, 262 (грузы для испытаний, массы, допуск).</li>
      <li><a href="https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 на legalacts.ru</a> — текст пунктов сверен 30.10.2026.</li>
    </ul>
    <p class="small muted">Справка не заменяет паспорт и руководство по эксплуатации конкретного крана: нагрузки и порядок испытаний определяют они.</p>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-16-25-tonn/">Аренда автокрана 16–25 тонн →</a></section>
</main>
</SpravochnikLayout>
