---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = "Автокран с грейфером: где могут стоять люди";
const description = "В зоне перемещения грузов краном с грейфером или электромагнитом людей быть не должно; вход возможен в перерыв, когда грейфер лежит на земле (п. 130 ФНП №461).";

const CHECKED = '29.10.2026';
const PUBLISHED = '2026-10-29';
const SLUG = "avtokran-s-greyferom-ili-elektromagnitom-zona-lyudey-fnp-461";
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    "q": "Можно ли стоять рядом с автокраном, пока работает грейфер?",
    "a": "Нельзя, если вы находитесь в зоне перемещения грузов: п. 130 ФНП №461 запрещает нахождение людей и проведение работ в этой зоне. Границу зоны задаёт ППР для конкретного вылета и места отвалки. За её пределами находиться можно, если граница ограждена и обозначена."
  },
  {
    "q": "Когда персонал может зайти в зону грейфера?",
    "a": "Во время перерывов в работе крана и после того, как грейфер или электромагнит опущен на землю (п. 130 ФНП №461). Для электромагнита добавляется второе условие: напряжение должно быть снято. Пока оба условия не выполнены, вход остаётся запрещён."
  },
  {
    "q": "Нужен ли ППР, если есть руководство по эксплуатации грейфера?",
    "a": "Норма допускает любой из трёх документов: руководство по эксплуатации крана, руководство по эксплуатации грейфера или электромагнита, ППР эксплуатирующей либо специализированной организации. Достаточно, чтобы указания для такой работы в них были и выполнялись. На практике для сложной площадки ППР всё равно разрабатывают."
  },
  {
    "q": "Кто ограждает место работы грейфера?",
    "a": "Пункт 130 требует ограждения и предупредительных знаков, но не называет исполнителя. Распределение задач между эксплуатирующей организацией и заказчиком фиксируют в договоре и в ППР. МОСКРАН-СЕРВИС уточняет это при подтверждении заявки, чтобы граница зоны была обозначена до начала работ."
  },
  {
    "q": "Чем электромагнит отличается от грейфера по требованиям безопасности?",
    "a": "К общим требованиям п. 130 для электромагнита добавлено условие снятия напряжения: персонал может войти в зону только когда электромагнит лежит на земле и ток с него снят. Для грейфера достаточно, чтобы он был опущен на землю во время перерыва в работе."
  }
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: "Автокран с грейфером или электромагнитом", item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [["norma", "Что именно запрещает и разрешает п. 130 ФНП №461"], ["dopusk", "Чем определяется допуск крана с грейфером к работе"], ["zona", "Зона перемещения грузов: кто и когда может в неё войти"], ["ograzhdenie", "Ограждение и знаки: что требует норма и что остаётся на ППР"], ["zakazchik", "Что заказчику сделать до выезда автокрана с грейфером"], ["faq", "Частые вопросы"], ["istochniki", "Источники"]];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Автокран с грейфером или электромагнитом</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">ФНП №461 · Площадка</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Где можно находиться людям при работе автокрана с грейфером или электромагнитом?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>29.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>29.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>6 мин чтения</span>
    </div>

    <p>Нигде в зоне перемещения грузов: п. 130 ФНП №461 запрещает находиться людям и вести любые работы в зоне, где кран с грейфером или электромагнитом переносит груз. Войти можно только в перерыв, когда грейфер или электромагнит опущен на землю, а с электромагнита снято напряжение. МОСКРАН-СЕРВИС прописывает эту границу в задании на площадку до выезда КС-55713 «Клинцы» с грейфером, потому что на сыпучих грузах она решает, кто и когда работает рядом с краном.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="norma" style="margin:36px 0 16px">Что именно запрещает и разрешает п. 130 ФНП №461</h2>
    <p>Пункт 130 ФНП №461 делает три вещи одновременно: ограничивает допуск такого крана к работе, закрывает зону для людей и обязывает обозначить место работ. Подъёмное сооружение с грейфером, электромагнитом или управляемым (автоматическим, полуавтоматическим) захватом допускается к работе только при выполнении указаний, специально разработанных для этих случаев в руководстве по эксплуатации крана, в руководстве по эксплуатации грейфера, электромагнита или захвата либо в проекте производства работ.</p>
    <p>Второй абзац нормы запрещает нахождение людей и проведение любых работ в зоне перемещения грузов кранами с грейфером или электромагнитом. Третий требует ограждать места производства работ и обозначать их предупредительными знаками. Общее определение границ опасной зоны вокруг стрелового крана дано в справке про <a href="/spravochnik/opasnaya-zona-krana/" style="color:var(--yellow)">опасную зону крана</a>, а п. 130 добавляет к ней жёсткое правило для грейфера.</p>

    <h2 id="dopusk" style="margin:36px 0 16px">Чем определяется допуск крана с грейфером к работе</h2>
    <p>Допуск крана с грейфером опирается на документ, который предусматривает именно такую работу: ФНП №461 называет три возможных источника указаний, и достаточно, чтобы они были выполнены хотя бы в одном из них. Это руководство по эксплуатации крана, руководство по эксплуатации навесного оборудования или ППР, разработанный эксплуатирующей либо специализированной организацией.</p>
    <p>На практике МОСКРАН-СЕРВИС просит у заказчика сведения о грузе и месте отвалки до подбора машины: вид материала, объём смены, где расположена разгрузочная площадка. Это порядок службы подбора, а не требование нормы. О связке ППР и технологической карты при работе автокрана подробно сказано в справке про <a href="/spravochnik/ppr-ili-tehnologicheskaya-karta-avtokran-fnp-461/" style="color:var(--yellow)">ППР и ТК автокрана</a>.</p>

    <h2 id="zona" style="margin:36px 0 16px">Зона перемещения грузов: кто и когда может в неё войти</h2>
    <p>ФНП №461 не называет размер зоны в метрах: она определяется перемещением грейфера и груза при конкретном вылете, поэтому её границу задаёт ППР, а не справка. Норма различает работу крана и перерыв, и людям допускается входить только в одном из четырёх возможных состояний площадки.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Состояние площадки</th><th>Люди в зоне</th><th>Основание</th></tr></thead>
        <tbody>
          <tr><td>Кран работает, грейфер или электромагнит перемещается</td><td>Не допускаются, никакие работы не ведутся</td><td>п. 130, абз. 2</td></tr>
          <tr><td>Перерыв, грейфер или электромагнит на весу</td><td>Не допускаются: условие допуска не выполнено</td><td>п. 130, абз. 2</td></tr>
          <tr><td>Перерыв, электромагнит на земле, но под напряжением</td><td>Не допускаются: напряжение должно быть снято</td><td>п. 130, абз. 2</td></tr>
          <tr><td>Перерыв, грейфер или электромагнит на земле, напряжение снято</td><td>Допускаются для выполнения своих обязанностей</td><td>п. 130, абз. 2</td></tr>
        </tbody>
      </table>
    </div>
    <p>Таблица составлена из второго абзаца п. 130 и показывает, что допуск людей зависит от двух условий одновременно: рабочий орган лежит на земле и, для электромагнита, снят ток. Пример из практики: если оператору КС-55713 «Клинцы» нужно, чтобы рабочий подправил борт кузова, грейфер сначала ставят на землю, и только потом человек входит в зону.</p>

    <h2 id="ograzhdenie" style="margin:36px 0 16px">Ограждение и знаки: что требует норма и что остаётся на ППР</h2>
    <p>ФНП №461 требует ограждать и обозначать предупредительными знаками места производства работ кранами с грейфером или электромагнитом, но не уточняет высоту ограждения и вид знака. Эти детали определяет ППР и локальные требования площадки, поэтому МОСКРАН-СЕРВИС не называет в справке числовых размеров, которых нет в норме.</p>
    <p>Смежные запреты на площадке разобраны отдельно: нахождение людей под грузом описано в справке про <a href="/spravochnik/peremeshchenie-gruza-nad-lyudmi/" style="color:var(--yellow)">перемещение груза над людьми</a>, а полный перечень запрещённых операций автокрана — в справке про <a href="/spravochnik/zapreshchennye-operacii-avtokrana-fnp-461/" style="color:var(--yellow)">запрещённые операции</a>. Для грейфера эти запреты усилены тем, что даже работа рядом с грузом без перемещения над головой не допускается.</p>

    <h2 id="zakazchik" style="margin:36px 0 16px">Что заказчику сделать до выезда автокрана с грейфером</h2>
    <p>До выезда автокрана с грейфером заказчик закрывает четыре вопроса: кто допущен на площадку во время работы, где проходит граница зоны, кто подаёт команду о перерыве и как фиксируется, что грейфер опущен. Это практический порядок, он опирается на п. 130, но сам не является цитатой нормы. МОСКРАН-СЕРВИС передаёт его заказчику вместе с подтверждением заявки.</p>
    <ol>
      <li>Назначьте ответственного, который останавливает работы при появлении человека в зоне.</li>
      <li>Определите место, где персонал ждёт перерыва, за границей зоны перемещения грузов.</li>
      <li>Договоритесь о сигнале «грейфер на земле», после которого можно входить.</li>
      <li>Убедитесь, что в ППР указаны ограждение и знаки на местах производства работ.</li>
    </ol>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: автокран с грейфером или электромагнитом</h2>
    <ul>
      <li>В зоне перемещения грузов краном с грейфером или электромагнитом людей и каких-либо работ быть не должно (п. 130 ФНП №461).</li>
      <li>Персонал допускается только в перерыв, когда грейфер или электромагнит на земле, а напряжение с электромагнита снято.</li>
      <li>Допуск крана к такой работе требует специальных указаний в руководствах по эксплуатации или в ППР.</li>
      <li>Места работ ограждают и обозначают знаками; размеры ограждения определяются ППР, а не нормой.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://www.consultant.ru/document/cons_doc_LAW_373321/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 (приказ Ростехнадзора от 26.11.2020 №461)</a> — п. 130 (краны с грейфером, электромагнитом, управляемым захватом: допуск, зона людей, ограждение).</li>
      <li><a href="https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 на legalacts.ru</a> — текст пунктов сверен 29.10.2026.</li>
    </ul>
    <p class="small muted">Справка не заменяет ППР и руководство по эксплуатации конкретного автокрана и навесного оборудования: границы зоны и размеры ограждения задаются проектом производства работ.</p>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-16-25-tonn/">Аренда автокрана 16–25 тонн →</a></section>
</main>
</SpravochnikLayout>
