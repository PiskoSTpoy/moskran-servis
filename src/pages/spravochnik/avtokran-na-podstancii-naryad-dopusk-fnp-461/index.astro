---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = 'Автокран на подстанции: кто выдаёт наряд-допуск';
const description = 'Работа автокрана на подстанции или действующей ЛЭП: наряд-допуск от энергетиков (п. 113 ФНП №461) и расстояния до проводов по приложениям №1 и №2.';

const CHECKED = '15.10.2026';
const PUBLISHED = '2026-10-15';
const SLUG = 'avtokran-na-podstancii-naryad-dopusk-fnp-461';
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: 'Кто выдаёт наряд-допуск автокрану на территории подстанции?',
    a: 'Организация, эксплуатирующая подстанцию, электростанцию или линию электропередачи (п. 113 ФНП №461). Это отличается от работы у ЛЭП на чужой площадке, где наряд-допуск выдаёт эксплуатирующая кран организация с разрешения владельца линии (п. 112). МОСКРАН-СЕРВИС получает наряд-допуск у энергетиков до заезда.',
  },
  {
    q: 'Какое минимальное расстояние от стрелы до проводов под напряжением 110 кВ?',
    a: 'Не менее 3,0 м для линии свыше 35 до 110 кВ по таблице 3 приложения №1 к ФНП №461. Для линии свыше 110 до 220 кВ — 4,0 м. МОСКРАН-СЕРВИС считает расстояние от любой точки стрелы, крюка и груза, а не только от оголовка.',
  },
  {
    q: 'Чем отличаются таблицы приложения №1 и приложения №2?',
    a: 'Таблица 3 приложения №1 задаёт наименьшее расстояние от стрелы при работе до проводов под напряжением. Таблица 2 приложения №2 задаёт границы опасной зоны поражения током для машин, приспособлений и грузов. МОСКРАН-СЕРВИС проверяет обе, поскольку п. 113 ссылается на оба приложения.',
  },
  {
    q: 'Распространяется ли п. 113 на кран-манипулятор и автовышку?',
    a: 'Да: п. 113 ФНП №461 называет краны стрелового типа, краны-манипуляторы и подъёмники (вышки). Порядок с нарядом-допуском от энергетиков одинаков для всех трёх видов техники. МОСКРАН-СЕРВИС предупреждает об этом субподрядчиков с манипуляторами на том же объекте.',
  },
  {
    q: 'Нужно ли расстояние соблюдать при транспортном положении стрелы?',
    a: 'Да: таблица 2 приложения №2 к ФНП №461 даёт расстояния от механизмов и грузоподъёмных машин «в рабочем и транспортном положении». Проезд автокрана по территории подстанции тоже должен их соблюдать. МОСКРАН-СЕРВИС согласует маршрут проезда вместе с местом установки.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Автокран на подстанции: наряд-допуск по ФНП №461', item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ['kto', 'Кто выдаёт наряд-допуск: п. 113 против п. 112'],
  ['strela', 'Расстояние от стрелы до проводов'],
  ['zona', 'Опасная зона для машины и груза'],
  ['moskva', 'Подстанции Москвы и области: порядок заявки'],
  ['faq', 'Частые вопросы'],
  ['istochniki', 'Источники'],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Автокран на подстанции: наряд-допуск по ФНП №461</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">ФНП №461 · Сети и ЛЭП</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Кто выдаёт наряд-допуск автокрану на подстанции и действующей ЛЭП?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>15.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>15.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>6 мин чтения</span>
    </div>

    <p>Пункт 113 ФНП №461 переносит выдачу наряда-допуска для автокрана на действующей подстанции, электростанции или ЛЭП к организации, которая их эксплуатирует. Работа разрешена, только если стрела, крюк и груз в любом положении не ближе к проводам, чем указано в приложениях №1 и №2. МОСКРАН-СЕРВИС получает этот наряд-допуск у энергетиков до заезда машины.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="kto" style="margin:36px 0 16px">Кто выдаёт наряд-допуск: п. 113 против п. 112</h2>
    <p>Пункты 112 и 113 ФНП №461 описывают два разных случая работы автокрана у проводов под напряжением. По п. 112 кран на обычной стройке ближе 30 м к ЛЭП работает по наряду-допуску своей эксплуатирующей организации, а в охранной зоне — с разрешением владельца линии. По п. 113 на самой подстанции или линии наряд-допуск выдаёт эксплуатирующая их организация. МОСКРАН-СЕРВИС различает эти случаи при приёме заявки.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Параметр</th><th>Стройка у ЛЭП (п. 112)</th><th>Подстанция, электростанция, ЛЭП (п. 113)</th></tr></thead>
        <tbody>
          <tr><td>Кто выдаёт наряд-допуск</td><td>организация, эксплуатирующая кран</td><td>организация, эксплуатирующая объект энергетики</td></tr>
          <tr><td>Роль владельца линии</td><td>разрешение для работы в охранной зоне</td><td>сам выдаёт наряд-допуск</td></tr>
          <tr><td>Порог применения</td><td>ближе 30 м к проводу ВЛ свыше 50 В</td><td>работа на действующем объекте</td></tr>
          <tr><td>Расстояния до проводов</td><td>по наряду-допуску</td><td>не меньше приложений №1 и №2</td></tr>
        </tbody>
      </table>
    </div>
    <p>Порядок для стройки рядом с линией разобран в справке об <a href="/spravochnik/ohrannaya-zona-lep-i-30-metrov-fnp-461/" style="color:var(--yellow)">охранной зоне ЛЭП и 30 метрах</a>. МОСКРАН-СЕРВИС не переносит ту схему на подстанцию: там наряд-допуск собственной организации без наряда энергетиков не действует.</p>

    <h2 id="strela" style="margin:36px 0 16px">Расстояние от стрелы до проводов</h2>
    <p>Таблица 3 приложения №1 к ФНП №461 задаёт наименьшее расстояние от стрелы при работе до проводов под напряжением — от 1,5 м для линий до 1 кВ до 10 м для линий свыше 750 кВ. По п. 113 это расстояние держат стрела, крюк и груз в любом положении. МОСКРАН-СЕРВИС размечает это расстояние на схеме установки автокрана КС-55713 «Клинцы».</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Класс напряжения линии</th><th>Стрела, крюк и груз — не ближе, м</th></tr></thead>
        <tbody>
          <tr><td>0,4 кВ и ниже (до 1 кВ)</td><td>1,5</td></tr>
          <tr><td>6–35 кВ (более 1 кВ)</td><td>2,0</td></tr>
          <tr><td>110 кВ (более 35 кВ)</td><td>3,0</td></tr>
          <tr><td>220 кВ (более 110 кВ)</td><td>4,0</td></tr>
          <tr><td>330–400 кВ (более 220 кВ)</td><td>5,0</td></tr>
          <tr><td>500–750 кВ (более 400 кВ)</td><td>9,0</td></tr>
          <tr><td>более 750 кВ, до 1150 кВ</td><td>10,0</td></tr>
        </tbody>
      </table>
    </div>
    <p>Расстояние считается «по воздуху» и в любом положении, поэтому качание груза на стропах и поворот стрелы входят в запас. Для телескопической стрелы автокрана КС-65713-1 «Галичанин» опасна не только вершина, но и выдвижные секции при подъёме. МОСКРАН-СЕРВИС проверяет крайние положения стрелы на всём секторе поворота, а не одну рабочую точку.</p>

    <h2 id="zona" style="margin:36px 0 16px">Опасная зона для машины и груза</h2>
    <p>Таблица 2 приложения №2 к ФНП №461 задаёт границы опасной зоны поражения током отдельно для людей и для машин, приспособлений и грузов «в рабочем и транспортном положении». Для машин значения от 1,0 м при напряжении до 35 кВ до 6,0 м при 750 кВ. МОСКРАН-СЕРВИС применяет вторую колонку к проезду автокрана по территории подстанции.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Класс напряжения</th><th>Граница для автокрана, стропов и груза, м</th><th>Для сравнения: людям, м</th></tr></thead>
        <tbody>
          <tr><td>ВЛ до 1 кВ и 6–35 кВ</td><td>1,0</td><td>0,6</td></tr>
          <tr><td>110 кВ (и 60 кВ)</td><td>1,5</td><td>1,0</td></tr>
          <tr><td>150 кВ</td><td>2,0</td><td>1,5</td></tr>
          <tr><td>220 кВ</td><td>2,5</td><td>2,0</td></tr>
          <tr><td>330 кВ</td><td>3,5</td><td>2,5</td></tr>
          <tr><td>500 кВ (и 400 кВ)</td><td>4,5</td><td>3,5</td></tr>
          <tr><td>750 кВ</td><td>6,0</td><td>5,0</td></tr>
        </tbody>
      </table>
    </div>
    <p>Значения двух приложений не совпадают: для 110 кВ стрела при работе держит 3,0 м по приложению №1, а граница опасной зоны машины — 1,5 м по приложению №2. Норма в п. 113 требует «не менее указанного» в обоих, поэтому на практике действует большее значение. МОСКРАН-СЕРВИС закладывает в схему именно его; это прочтение службы, а не отдельная формула ФНП.</p>

    <h2 id="moskva" style="margin:36px 0 16px">Подстанции Москвы и области: порядок заявки</h2>
    <p>В Москве и Московской области распределительные сети и подстанции 35–220 кВ в основном эксплуатирует ПАО «Россети Московский регион» (бывшая МОЭСК), но на ряде объектов владелец — другая сетевая или генерирующая компания. Для п. 113 ФНП №461 важен именно эксплуатант конкретного объекта. МОСКРАН-СЕРВИС уточняет его у заказчика до расчёта стоимости.</p>
    <ul>
      <li>МОСКРАН-СЕРВИС запрашивает название организации, эксплуатирующей подстанцию или линию.</li>
      <li>МОСКРАН-СЕРВИС уточняет напряжение ближайших проводов и ошиновки.</li>
      <li>МОСКРАН-СЕРВИС согласует место установки опор и маршрут проезда по территории.</li>
      <li>МОСКРАН-СЕРВИС получает наряд-допуск энергетиков с датой и временем действия.</li>
    </ul>
    <p>Работа под непосредственным руководством ответственного и запись в вахтенном журнале для работ у ЛЭП описаны в п. 112, общие правила — в справке о <a href="/spravochnik/rabota-krana-ryadom-s-lep/" style="color:var(--yellow)">работе крана рядом с ЛЭП</a>. Остальные расстояния до препятствий собраны в материале о <a href="/spravochnik/minimalnye-rasstoyaniya-pri-rabote-avtokrana-fnp-461/" style="color:var(--yellow)">минимальных расстояниях при работе автокрана</a>. Перечень вопросов — практика МОСКРАН-СЕРВИС, а не норма.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: автокран на подстанции</h2>
    <ul>
      <li>МОСКРАН-СЕРВИС работает на подстанции только по наряду-допуску её эксплуатанта (п. 113 ФНП №461).</li>
      <li>Стрела, крюк и груз МОСКРАН-СЕРВИС держатся от проводов не ближе таблицы 3 приложения №1.</li>
      <li>Для 110 кВ МОСКРАН-СЕРВИС закладывает 3,0 м от стрелы, для 220 кВ — 4,0 м.</li>
      <li>МОСКРАН-СЕРВИС соблюдает опасную зону приложения №2 и при проезде по территории.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://www.consultant.ru/document/cons_doc_LAW_373321/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 (приказ Ростехнадзора от 26.11.2020 №461)</a> — п. 112 (работа у ЛЭП, 30 м), п. 113 (подстанции, электростанции, ЛЭП), приложение №1 табл. 3, приложение №2 табл. 2.</li>
      <li><a href="https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 на legalacts.ru</a> — редакция от 16.04.2026, текст пунктов 112–113 и таблиц приложений №1 и №2 сверен 15.10.2026.</li>
      <li><a href="https://rossetimr.ru/" target="_blank" rel="noopener" style="color:var(--yellow)">ПАО «Россети Московский регион»</a> — официальный сайт сетевой компании Москвы и Московской области.</li>
    </ul>
    <p class="small muted">Правило «брать большее из двух приложений» — прочтение МОСКРАН-СЕРВИС, а не формулировка ФНП. Число подстанций сетевой компании в справке не приводится: открытые данные не датированы.</p>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-16-25-tonn/">Аренда автокрана 16–25 тонн →</a></section>
</main>
</SpravochnikLayout>
