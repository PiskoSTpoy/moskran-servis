---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = "Проверка ОГП и указателей автокрана: пп. 261–269 ФНП 461";
const description = "ОГП автокрана проверяют грузом или устройством с погрешностью до 3 % минимум в трёх точках характеристики; отключение — до 10 % перегрузки (п. 262 ФНП №461).";

const CHECKED = '22.10.2026';
const PUBLISHED = '2026-10-22';
const SLUG = "proverka-priborov-bezopasnosti-avtokrana-fnp-461";
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: "Кто имеет право проверять ограничитель грузоподъёмности автокрана?",
    a: "Работники специализированной или эксплуатирующей организации с квалификацией по требованиям изготовителя прибора (п. 20 ФНП №461), в присутствии ИТР, ответственного за содержание ПС в работоспособном состоянии (п. 261). Крановщик сам такую проверку не оформляет.",
  },
  {
    q: "При какой перегрузке должен сработать ОГП автокрана?",
    a: "При перегрузке, указанной в паспорте крана, но не выше 10 % для стреловых кранов, подъёмников и кранов-манипуляторов (п. 262 «в» ФНП №461). Для башенных кранов с моментом до 20 т·м и портальных предел 15 %, для кранов мостового типа — 25 %.",
  },
  {
    q: "Сколько точек грузовой характеристики проверяют у автокрана?",
    a: "Не менее трёх, если грузоподъёмность меняется с вылетом (п. 262 ФНП №461). У автокрана КС-55713-1К «Клинцы» грузоподъёмность зависит от вылета и длины стрелы, поэтому одной точки недостаточно.",
  },
  {
    q: "Сколько витков каната должно остаться на барабане в нижнем положении крюка?",
    a: "Столько, сколько указано в эксплуатационной документации; если сведений нет — не менее полутора витков, не считая каната под зажимами (п. 264 ФНП №461).",
  },
  {
    q: "Как оформляют результат проверки приборов безопасности?",
    a: "Актом, который становится неотъемлемым приложением к паспорту ПС (п. 269 ФНП №461). МОСКРАН-СЕРВИС показывает заказчику последний такой акт вместе с паспортом автокрана.",
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: "Проверка приборов безопасности автокрана", item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ["kto", "Кто проверяет приборы по пп. 20 и 261"],
  ["ogp", "Ограничитель грузоподъёмности по п. 262"],
  ["kryuk", "Верхнее и нижнее положение крюка по пп. 263–264"],
  ["strela", "Стрела и крюковая подвеска по п. 265"],
  ["ukazateli", "ЛЭП, анемометр, креномер и регистратор по пп. 266–268"],
  ["akt", "Акт проверки по п. 269"],
  ["faq", "Частые вопросы"],
  ["istochniki", "Источники"],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Проверка приборов безопасности автокрана</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">ФНП №461 · Приборы безопасности</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Как проверяют ограничители и указатели автокрана по ФНП №461?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>22.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>22.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>5 мин чтения</span>
    </div>

    <p>Пункт 262 ФНП №461 требует проверять ограничитель грузоподъёмности автокрана грузами или аттестованным устройством нагружения с погрешностью не более 3 %, минимум в трёх точках грузовой характеристики. Механизмы должны отключиться не позднее 10 % перегрузки. Пункты 263–269 добавляют проверку концевых выключателей крюка, стрелы, указателей и регистратора, а результат оформляют актом к паспорту. МОСКРАН-СЕРВИС выпускает автокран на объект только с действующим актом.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="kto" style="margin:36px 0 16px">Кто проверяет приборы по пп. 20 и 261</h2>
    <p>Работы на регистраторах, ограничителях и указателях выполняют работники специализированных или эксплуатирующих организаций, чья квалификация соответствует требованиям изготовителя прибора (п. 20 ФНП №461). Проверку проводят в присутствии ИТР, ответственного за содержание ПС в работоспособном состоянии (п. 261). Крановщик автокрана КС-35714 «Ивановец» видит срабатывание прибора каждую смену, но акт проверки не подписывает как исполнитель. МОСКРАН-СЕРВИС привлекает для этих работ сервисную организацию с допуском от производителя прибора.</p>


    <h2 id="ogp" style="margin:36px 0 16px">Ограничитель грузоподъёмности по п. 262</h2>
    <p>Ограничитель грузоподъёмности (ОГП) автокрана проверяют не менее чем в трёх точках грузовой характеристики, потому что грузоподъёмность стрелового крана зависит от вылета (п. 262 ФНП №461). Если меняется конфигурация — схема запасовки или стреловое оборудование, — проверку повторяют. Для автокрана КС-55713-1К «Клинцы» это означает новую проверку после установки удлинителя стрелы. МОСКРАН-СЕРВИС фиксирует конфигурацию машины в заявке до выезда.</p>
    <p>Во время проверки ОГП контролируют автоматическое отключение всех механизмов, кроме опускания груза и уменьшения грузового момента (п. 262). После срабатывания включить механизмы, увеличивающие нагрузку, должно быть невозможно. Режим ОГП для большей грузоподъёмности, включённый ошибочно или принудительно при фактической конфигурации на меньшую, должен быть исключён. МОСКРАН-СЕРВИС считает такой «обход» ограничителя основанием снять машину с работы.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Тип подъёмного сооружения</th><th>Предельная перегрузка до отключения (п. 262)</th></tr></thead>
        <tbody>
          <tr><td>Башенные (грузовой момент до 20 т·м включительно) и портальные краны</td><td>не более 15 %</td></tr>
          <tr><td>Краны мостового типа</td><td>не более 25 %, без отрыва груза от земли</td></tr>
          <tr><td>Остальные краны: стреловые автомобильные, краны-трубоукладчики, подъёмники (вышки), краны-манипуляторы</td><td>не более 10 %</td></tr>
        </tbody>
      </table>
    </div>
    <p>Значение в паспорте конкретного автокрана может быть меньше предела из таблицы — тогда проверяют по паспорту (п. 262 ФНП №461). МОСКРАН-СЕРВИС сверяет цифру в акте с паспортом автокрана, а не с общим пределом 10 %. Назначение самого прибора разобрано в справке об <a href="/spravochnik/ogranichitel-gruzopodemnosti/" style="color:var(--yellow)">ограничителе грузоподъёмности</a>.</p>


    <h2 id="kryuk" style="margin:36px 0 16px">Верхнее и нижнее положение крюка по пп. 263–264</h2>
    <p>Ограничитель предельного верхнего положения крюка проверяют без груза: после остановки механизма замеряют расстояние от верхней точки крюковой подвески до упора или металлоконструкции (п. 263 ФНП №461). Нижнее положение проверяют по остановке механизма опускания после срабатывания концевого выключателя и по запасу каната на барабане (п. 264). Если эксплуатационная документация запас не задаёт, на барабане остаётся не менее полутора витков без учёта каната под зажимами. МОСКРАН-СЕРВИС особенно внимателен к этому при опускании груза в котлован ниже уровня стоянки автокрана.</p>


    <h2 id="strela" style="margin:36px 0 16px">Стрела и крюковая подвеска по п. 265</h2>
    <p>У стреловых кранов, где стрела при опускании или телескопическом выдвижении может наткнуться на крюковую подвеску, проверяют одновременное отключение механизма опускания или выдвижения стрелы и механизма подъёма (п. 265 ФНП №461). Телескопическая стрела автокрана КС-55713-1К «Клинцы» относится именно к этому случаю. МОСКРАН-СЕРВИС включает пункт 265 в перечень проверок вместе с ОГП, потому что столкновение стрелы с подвеской ограничитель грузоподъёмности не ловит.</p>


    <h2 id="ukazateli" style="margin:36px 0 16px">ЛЭП, анемометр, креномер и регистратор по пп. 266–268</h2>
    <p>Работоспособность ограничителя или указателя опасного приближения к ЛЭП оценивают по приложению №9 к ФНП №461 (п. 266). Анемометр и указатель угла наклона проверяют по руководствам по эксплуатации этих приборов (п. 267), регистратор параметров — по его руководству (п. 268). Отдельной цифры периодичности для них пункты 266–268 не задают — она приходит из эксплуатационной документации прибора. МОСКРАН-СЕРВИС хранит руководства на приборы автокрана рядом с паспортом, иначе проверку не с чем сверить. Об условиях работы у линий — в справке о <a href="/spravochnik/rabota-krana-ryadom-s-lep/" style="color:var(--yellow)">работе крана рядом с ЛЭП</a>.</p>


    <h2 id="akt" style="margin:36px 0 16px">Акт проверки по п. 269</h2>
    <p>Результаты проверки работоспособности ограничителей и указателей после всех видов испытаний оформляют актом, который является неотъемлемым приложением к паспорту ПС (п. 269 ФНП №461). Для заказчика аренды это документ, который можно запросить вместе с паспортом и записью о техническом освидетельствовании. МОСКРАН-СЕРВИС передаёт копию акта по запросу до подачи автокрана на московскую площадку.</p>


    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: проверка приборов безопасности автокрана</h2>
    <ul>
      <li>Проверяют квалифицированные работники по п. 20 в присутствии ИТР за содержание ПС (п. 261 ФНП №461).</li>
      <li>ОГП автокрана — грузом или устройством с погрешностью до 3 %, минимум в трёх точках, отключение не позднее 10 % перегрузки (п. 262).</li>
      <li>Нижнее положение крюка — запас не менее полутора витков, если документация не задаёт иное (п. 264).</li>
      <li>Результат — акт, приложенный к паспорту (п. 269); МОСКРАН-СЕРВИС показывает его заказчику.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://www.consultant.ru/document/cons_doc_LAW_373321/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 (приказ Ростехнадзора от 26.11.2020 №461)</a> — пп. 20, 261–269 (проверка ограничителей, указателей и регистратора).</li>
      <li><a href="https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 на legalacts.ru</a> — редакция от 16.04.2026, текст пунктов 20 и 261–269 сверен 22.10.2026.</li>
    </ul>
    <p class="small muted">Практика МОСКРАН-СЕРВИС описана отдельно от норм; периодичность проверки конкретного прибора задаёт его руководство по эксплуатации.</p>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-16-25-tonn/">Аренда автокрана 16–25 тонн →</a></section>
</main>
</SpravochnikLayout>
