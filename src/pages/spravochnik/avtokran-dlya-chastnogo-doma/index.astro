---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = 'Автокран на частный участок: как заказать и подготовить';
const description = 'Автокран на частный участок: смена от 17 600 ₽, провода ЛЭП ближе 30 м — наряд-допуск (п. 112 ФНП №461), площадка под опоры, оплата на объекте для физлиц.';

const CHECKED = '27.09.2026';
const PUBLISHED = '2026-09-27';
const SLUG = 'avtokran-dlya-chastnogo-doma';
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: 'Сколько стоит автокран на частный участок?',
    a: 'Минимальный заказ в МОСКРАН-СЕРВИС — смена 8 часов. Для автокрана класса 16–20 т это 2 200 ₽ × 8 = 17 600 ₽, для 25 т — 20 800 ₽. Если работа заняла два часа, оплачивается всё равно смена, поэтому на один выезд выгодно собрать все подъёмы сразу: плиты, бытовку, септик.',
  },
  {
    q: 'Нужно ли физлицу заключать договор на аренду крана?',
    a: 'Аренда автокрана с крановщиком — это аренда транспортного средства с экипажем по ст. 632 ГК РФ, и письменный договор защищает обе стороны. МОСКРАН-СЕРВИС оформляет договор и с физическими лицами; для них возможен расчёт на объекте после выполнения работ.',
  },
  {
    q: 'Вдоль участка идут провода. Кран сможет работать?',
    a: 'Сможет, но ближе 30 м от крайнего провода линии напряжением более 50 В кран работает только по наряду-допуску (п. 112 ФНП №461). Уличная линия 0,4 кВ почти всегда попадает в эти 30 м. МОСКРАН-СЕРВИС оформляет наряд-допуск; для работ в охранной зоне нужно разрешение владельца линии.',
  },
  {
    q: 'Можно ли поставить кран на свежую отсыпку у дома?',
    a: 'Нельзя: п. 108 ФНП №461 запрещает устанавливать кран стрелового типа на свеженасыпанный неутрамбованный грунт. Отсыпку щебнем или песком делают заранее и уплотняют. МОСКРАН-СЕРВИС возит инвентарные подкладки под опоры, но на рыхлом грунте они не заменяют подготовленную площадку.',
  },
  {
    q: 'Какой кран нужен, чтобы уложить плиты перекрытия?',
    a: 'Чаще всего хватает автокрана класса 16–25 т, но решают масса плиты и вылет от места установки крана до дальней точки укладки. Например, плита 2,5 т на вылете 12 м даёт 30 т·м, и это проходит у «Ивановца» КС-35714 с моментом 48 т·м. МОСКРАН-СЕРВИС проверяет подъём по грузовой таблице конкретной машины.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Автокран для частного дома', item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ['shagi', 'Пять шагов заказа: от замеров до оплаты'],
  ['lep', 'Провода у участка: 30 м и наряд-допуск'],
  ['ploshchadka', 'Место под кран: отсыпка, опоры, 1 м до стены'],
  ['vybor', 'Какой кран нужен: пример расчёта'],
  ['oplata', 'Сколько стоит и как платит физлицо'],
  ['faq', 'Частые вопросы'],
  ['istochniki', 'Источники'],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Автокран для частного дома</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Заказ техники · Частный заказчик</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Как заказать автокран для частного дома и подготовить участок?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>27.09.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>27.09.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>6 мин чтения</span>
    </div>

    <p>Автокран на частный участок заказывают по трём цифрам: масса самого тяжёлого груза, вылет от места установки крана и расстояние до ближайших проводов. Провода ближе 30 м означают наряд-допуск по п. 112 ФНП №461, свежая отсыпка под кран запрещена п. 108. Смена автокрана 16–20 т в МОСКРАН-СЕРВИС стоит 17 600 ₽, физлицо может рассчитаться на объекте.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="shagi" style="margin:36px 0 16px">Пять шагов заказа: от замеров до оплаты</h2>
    <p>Заказ автокрана в МОСКРАН-СЕРВИС для частного дома укладывается в пять шагов, и три из них делает сам заказчик до звонка. Чем точнее замеры, тем меньше риск, что приедет кран не того класса или не пройдёт к месту установки.</p>
    <ol>
      <li>Узнайте массу самого тяжёлого груза — по накладной поставщика или маркировке изделия.</li>
      <li>Измерьте вылет: от точки, где встанет кран, до дальней точки укладки груза.</li>
      <li>Сфотографируйте подъезд, ворота и провода вдоль участка, отметьте расстояние до них.</li>
      <li>Отправьте заявку: МОСКРАН-СЕРВИС подберёт класс крана и скажет, нужен ли наряд-допуск.</li>
      <li>В день работ подготовьте площадку и уберите людей из зоны подъёма.</li>
    </ol>
    <p>Подробный список данных для заявки МОСКРАН-СЕРВИС собрал в <a href="/spravochnik/zayavka-na-avtokran/" style="color:var(--yellow)">материале о заявке на автокран</a>. Видео подъезда с телефона часто экономит больше времени, чем любые описания.</p>

    <h2 id="lep" style="margin:36px 0 16px">Провода у участка: 30 м и наряд-допуск</h2>
    <p>Пункт 112 ФНП №461 разрешает устанавливать и работать краном ближе 30 м от крайнего провода воздушной линии напряжением более 50 В только по наряду-допуску. В посёлках и СНТ Подмосковья уличная линия 0,4 кВ обычно проходит вдоль забора, поэтому почти любой частный участок попадает в эти 30 м. МОСКРАН-СЕРВИС оформляет наряд-допуск до выезда, а не на месте.</p>
    <p>Для линии до 1 кВ охранная зона — 2 м по обе стороны от крайних проводов, так установлено постановлением Правительства РФ от 24.02.2009 №160. Если кран работает в охранной зоне, наряд-допуск по тому же п. 112 выдаётся только при разрешении организации, эксплуатирующей линию, а для линии из изолированного кабеля порядок определяет её владелец. Подробности МОСКРАН-СЕРВИС разобрал в <a href="/spravochnik/rabota-krana-ryadom-s-lep/" style="color:var(--yellow)">материале о работе крана рядом с ЛЭП</a>.</p>

    <h2 id="ploshchadka" style="margin:36px 0 16px">Место под кран: отсыпка, опоры, 1 м до стены</h2>
    <p>Пункт 108 ФНП №461 требует ставить кран стрелового типа на подготовленную площадку и запрещает свеженасыпанный неутрамбованный грунт и уклон больше паспортного. Для частного участка это значит: отсыпку щебнем делают заранее и уплотняют, а не в день приезда крана. МОСКРАН-СЕРВИС привозит инвентарные подкладки под опоры, но они не спасают рыхлый грунт.</p>
    <p>По п. 110 ФНП №461 кран устанавливается на выносные опоры по руководству по эксплуатации, а при отсутствии таких указаний — на все опоры. Опорный контур 25-тонных «Клинцов» КС-55713-1К — 4,9 × 6,1 м, поэтому место нужно шире самой машины. По п. 109 между поворотной частью крана и домом, забором или штабелем оставляют не менее 1 м; МОСКРАН-СЕРВИС проверяет это по фото и плану участка.</p>

    <h2 id="vybor" style="margin:36px 0 16px">Какой кран нужен: пример расчёта</h2>
    <p>Класс крана определяет грузовой момент: у «Ивановца» КС-35714 он 48 т·м, у «Клинцов» КС-55713-1К — 85 т·м. Например, плита 2,5 т, уложенная на вылете 12 м, даёт 2,5 × 12 = 30 т·м, и базовый «Ивановец» КС-35714 с моментом 48 т·м проходит по верхней границе с запасом. МОСКРАН-СЕРВИС затем сверяет подъём с грузовой таблицей конкретной машины: часть момента уходит на массу стрелы.</p>
    <p>Если кран не может встать близко и вылет вырастает до 16 м, та же плита даёт 40 т·м, и запас 16-тонного крана почти исчезает. Здесь МОСКРАН-СЕРВИС предложит 25 т, например «Клинцы» КС-55713-1К с моментом 85 т·м. Сравнение классов разобрано в <a href="/spravochnik/avtokran-16-ili-25-tonn/" style="color:var(--yellow)">материале о выборе между 16 и 25 т</a>.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Задача на участке</th><th>Что измерить</th><th>Что проверить</th></tr></thead>
        <tbody>
          <tr><td>Плиты перекрытия</td><td>Масса плиты, вылет до дальней плиты</td><td>Провода, место под опоры рядом с коробкой дома</td></tr>
          <tr><td>Бытовка, септик, кольца</td><td>Масса изделия, вылет до котлована</td><td>Расстояние опор от края котлована</td></tr>
          <tr><td>Разгрузка стройматериалов</td><td>Масса пачки или поддона</td><td>Где встанет машина поставщика</td></tr>
        </tbody>
      </table>
    </div>

    <h2 id="oplata" style="margin:36px 0 16px">Сколько стоит и как платит физлицо</h2>
    <p>Смена автокрана 16–20 т в МОСКРАН-СЕРВИС стоит 17 600 ₽ (2 200 ₽ в час × 8 часов), 25 т — 20 800 ₽; смена — минимальный заказ. Для физических лиц МОСКРАН-СЕРВИС допускает расчёт на объекте после выполнения работ. Выезд в Москву в пределах зоны пропускного режима учитывается надбавкой, как описано в <a href="/spravochnik/stoimost-arendy-avtokrana/" style="color:var(--yellow)">материале о стоимости аренды автокрана</a>.</p>
    <p>Аренда крана с крановщиком по ГК РФ — аренда транспортного средства с экипажем (ст. 632): управление и техническую эксплуатацию обеспечивает МОСКРАН-СЕРВИС своим экипажем. Если строповку выполняют рабочие заказчика, у них должна быть подготовка стропальщика; требования разобраны в <a href="/spravochnik/trebovaniya-k-stropalshchiku/" style="color:var(--yellow)">материале о стропальщике</a>.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: автокран на частный участок</h2>
    <ul>
      <li>Нужны 3 цифры: масса, вылет, расстояние до проводов.</li>
      <li>Провода ближе 30 м — наряд-допуск (п. 112).</li>
      <li>Свежая отсыпка под кран запрещена (п. 108).</li>
      <li>До дома и забора — не менее 1 м от поворотной части (п. 109).</li>
      <li>Смена от 17 600 ₽, физлицо платит на объекте.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://sudact.ru/law/prikaz-rostekhnadzora-ot-26112020-n-461-ob/federalnye-normy-i-pravila-v/vi/ustanovka-ps-i-proizvodstvo-rabot/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461, раздел VI (ред. от 16.04.2026)</a> — п. 108, 109, 110 (установка), п. 112 (30 м от ЛЭП, наряд-допуск).</li>
      <li><a href="https://base.garant.ru/12165555/" target="_blank" rel="noopener" style="color:var(--yellow)">Постановление Правительства РФ от 24.02.2009 №160</a> — охранные зоны объектов электросетевого хозяйства, для ВЛ до 1 кВ — 2 м.</li>
      <li><a href="https://www.consultant.ru/document/cons_doc_LAW_5142/" target="_blank" rel="noopener" style="color:var(--yellow)">Гражданский кодекс РФ, часть вторая</a> — ст. 632: аренда транспортного средства с экипажем.</li>
      <li><a href="/faq/" style="color:var(--yellow)">Частые вопросы МОСКРАН-СЕРВИС</a> и <a href="/" style="color:var(--yellow)">ставки на главной</a> — порядок оплаты для физлиц; ставки действуют до 17.02.2027.</li>
    </ul>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-16-25-tonn/">Подробнее об аренде автокрана 16–25 тонн →</a></section>
</main>
</SpravochnikLayout>
