---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = 'Подъём кирпича на поддонах автокраном: правила ФНП №461';
const description = 'Поддон кирпича без ограждения кран поднимает только с машины на землю (п. 114 ФНП №461). Поддон Braer 1 НФ весит 1100 кг; на этаж груз идёт в таре с бортами.';

const CHECKED = '10.10.2026';
const PUBLISHED = '2026-10-10';
const SLUG = 'podyom-kirpicha-na-poddonah-avtokranom';
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: 'Можно ли поднять поддон кирпича краном сразу на перекрытие второго этажа?',
    a: 'Только в таре с ограждением. Пункт 114 ФНП №461 разрешает перемещать кирпич на поддонах без ограждения лишь при разгрузке транспорта на землю и погрузке с земли. На перекрытие МОСКРАН-СЕРВИС подаёт поддон в контейнере или футляре с бортами, из которого штучный груз не выпадет при раскачивании.',
  },
  {
    q: 'Сколько весит поддон облицовочного кирпича?',
    a: 'Поддон кирпича Braer формата 1 НФ (250×120×65 мм) весит 1100 кг: 480 штук по 2,4 кг плюс сам поддон. Число указано в карточке изготовителя. Для другого завода и формата массу берут из его карточки или накладной: МОСКРАН-СЕРВИС по п. 114 не поднимает груз, масса которого неизвестна.',
  },
  {
    q: 'Какой кран нужен, чтобы подать поддон 1,1 т на 16 метров?',
    a: 'Крана класса 16 т достаточно. У КС-35714К-2 «Ивановец» грузовой момент 48 т·м, верхняя оценка на вылете 16 м — 3 т; поддон 1,1 т с тарой и стропами укладывается в неё с запасом. Смена 16–20 т у МОСКРАН-СЕРВИС стоит 17 600 ₽. Точное значение на вылете читают по таблице паспорта конкретной машины.',
  },
  {
    q: 'Можно ли подать кирпич через окно или на балкон?',
    a: 'Без приёмной площадки нельзя: п. 115 ФНП №461 запрещает подачу груза в оконные проёмы и на балконы без специальных приёмных площадок или приспособлений. МОСКРАН-СЕРВИС просит заказчика до выезда подготовить площадку приёма или зону на перекрытии, куда поддон опускают целиком.',
  },
  {
    q: 'Кто принимает поддон наверху и как его снять со стропов?',
    a: 'Стропальщик заказчика или бригады МОСКРАН-СЕРВИС, допущенный к работе. По п. 114 груз опускают на подкладки, чтобы вытащить стропы, а стропальщику разрешено находиться рядом с грузом, пока тот поднят не выше 1 м от площадки. Сигналы крановщику подаёт один назначенный человек.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Подъём кирпича на поддонах автокраном', item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ['ograzhdenie', 'Поддон без ограждения: только с машины на землю'],
  ['massa', 'Сколько весит поддон кирпича и газобетона'],
  ['tara', 'Тара для штучного груза и подача на этаж'],
  ['podbor', 'Какой кран нужен: расчёт по вылету'],
  ['poryadok', 'Порядок подъёма поддона по п. 114'],
  ['zayavka', 'Что передать при заказе'],
  ['faq', 'Частые вопросы'],
  ['istochniki', 'Источники'],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Подъём кирпича на поддонах автокраном</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">ФНП №461 · Штучные грузы</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Как поднять кирпич и газобетон на поддонах автокраном по ФНП №461?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>10.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>10.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>6 мин чтения</span>
    </div>

    <p>Пункт 114 ФНП №461 разрешает перемещать кирпич на поддонах без ограждения только при разгрузке транспорта на землю и погрузке с земли; на этаж или крышу поддон идёт в таре, из которой штучный груз не выпадет. Поддон облицовочного кирпича Braer 1 НФ весит 1100 кг (480 штук по 2,4 кг), поддон газобетона Bonolit D400 размером 600×375×250 мм содержит 32 блока. МОСКРАН-СЕРВИС подбирает кран по массе поддона и вылету до точки укладки, а не по тоннажу «с запасом».</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="ograzhdenie" style="margin:36px 0 16px">Поддон без ограждения: только с машины на землю</h2>
    <p>Пункт 114 ФНП №461 содержит прямую норму: перемещение кирпича на поддонах без ограждения разрешается только при разгрузке и погрузке транспортных средств на землю и с земли. Поддон с плёнкой и стяжками ограждением не считается: лента держит пакет при перевозке, а не при раскачивании на крюке. МОСКРАН-СЕРВИС применяет правило так: снять поддон с фуры и поставить рядом с машиной можно в заводской упаковке, а любой подъём выше уровня земли выполняется в таре с бортами.</p>
    <p>Та же норма п. 114 требует перемещать мелкоштучные грузы только в специально предназначенной таре, исключающей выпадение отдельных частей. Кирпич, блок и плитка — именно мелкоштучный груз. Для подачи на перекрытие или крышу МОСКРАН-СЕРВИС использует контейнер или футляр с ограждением, а порядок работы на высоте описан в материале о том, <a href="/spravochnik/podyom-gruza-na-kryshu-avtokranom/" style="color:var(--yellow)">как поднять груз на крышу автокраном</a>.</p>

    <h2 id="massa" style="margin:36px 0 16px">Сколько весит поддон кирпича и газобетона</h2>
    <p>Поддон облицовочного кирпича Braer 1 НФ весит 1100 кг по карточке завода. В карточке указаны размер 250×120×65 мм, марка М150–М200, масса изделия 2,4 кг и 480 штук на поддоне; одного поддона хватает на 9,41 м² кладки. Завод Bonolit публикует для газобетона число блоков на поддоне и в кубометре: D400 600×375×250 мм — 32 блока на поддоне при 17,8 блока в м³, то есть около 1,8 м³ на поддон. Массу поддона Bonolit не публикует, поэтому МОСКРАН-СЕРВИС просит её у поставщика по накладной.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Материал (изготовитель)</th><th>Размер, мм</th><th>Штук на поддоне</th><th>Масса / объём поддона</th></tr></thead>
        <tbody>
          <tr><td>Кирпич облицовочный 1 НФ (Braer)</td><td>250×120×65</td><td>480</td><td>1100 кг (карточка завода)</td></tr>
          <tr><td>Газобетон D400 (Bonolit)</td><td>600×375×250</td><td>32</td><td>≈1,8 м³; масса — по накладной</td></tr>
          <tr><td>Газобетон D400 (Bonolit)</td><td>600×300×250</td><td>40</td><td>≈1,8 м³; масса — по накладной</td></tr>
          <tr><td>Газобетон D500 (Bonolit)</td><td>600×250×250</td><td>48</td><td>≈1,8 м³; масса — по накладной</td></tr>
        </tbody>
      </table>
    </div>
    <p>Нижняя граница массы газобетонного поддона считается по марке: D400 означает среднюю плотность 400 кг/м³ в сухом состоянии, значит 1,8 м³ блоков весят не меньше 0,72 т, а с отпускной влажностью заметно больше. Эта цифра — инженерная оценка МОСКРАН-СЕРВИС для выбора класса крана, а не паспортное значение; в заявку идёт масса из накладной. Способы уточнить массу без документов описаны в материале о <a href="/spravochnik/massa-tary-vzveshivanie/" style="color:var(--yellow)">массе тары и взвешивании</a>.</p>

    <h2 id="tara" style="margin:36px 0 16px">Тара для штучного груза и подача на этаж</h2>
    <p>Контейнер для поддонов с глухими или сетчатыми бортами — единственный способ законно поднять кирпич выше земли по п. 114 ФНП №461. МОСКРАН-СЕРВИС ставит поддон в тару целиком, стропит тару за штатные петли и проверяет, что паспортная грузоподъёмность тары выше массы поддона. Подъём груза, масса которого неизвестна, п. 114 запрещает, поэтому накладная с массой поддона нужна до начала работы, а не после.</p>
    <p>Подача кирпича в оконный проём или на балкон без приёмной площадки запрещена п. 115 ФНП №461; детали этого запрета разобраны в материале о <a href="/spravochnik/peremeshchenie-gruza-nad-lyudmi/" style="color:var(--yellow)">перемещении груза над людьми</a>. МОСКРАН-СЕРВИС просит заказчика заранее определить на перекрытии место приёма с подкладками, куда тара опускается целиком. Схемы обвязки тары и поддонов описаны в материале о <a href="/spravochnik/shemy-stropovki-gruzov/" style="color:var(--yellow)">схемах строповки грузов</a>.</p>

    <h2 id="podbor" style="margin:36px 0 16px">Какой кран нужен: расчёт по вылету</h2>
    <p>Поддон Braer массой 1,1 т вместе с тарой и стропами редко превышает 1,5 т, поэтому класс крана МОСКРАН-СЕРВИС задаёт не по массе, а по вылету до точки укладки. У КС-35714К-2 «Ивановец» на шасси КамАЗ-43118 грузовой момент 48 т·м: верхняя оценка 48 ÷ 16 даёт 3 т на вылете 16 м, и груз 1,5 т укладывается с двукратным запасом. Сравнение версий этого крана дано в материале о <a href="/spravochnik/ks-35714-kamaz-ili-ural/" style="color:var(--yellow)">КС-35714 на КамАЗе и Урале</a>, а способ замерить вылет — в материале о том, <a href="/spravochnik/kak-opredelit-vylet-strely-avtokrana/" style="color:var(--yellow)">как определить вылет стрелы</a>.</p>
    <p>Пример расчёта МОСКРАН-СЕРВИС: дом 10×12 м, кран стоит у въезда, до дальнего угла перекрытия 18 м; на таком вылете класс 16 т даёт около 2,7 т по верхней оценке, а фактическое значение в паспорте ниже из-за массы стрелы и крюка. Если точка укладки дальше 18–20 м или кран нельзя подвинуть к дому, МОСКРАН-СЕРВИС выезжает краном 25 т со стрелой 21 м: смена 16–20 т стоит 17 600 ₽, 25 т — 20 800 ₽ (ставки 2 200 и 2 600 ₽/ч × 8 ч). Разница классов разобрана в материале <a href="/spravochnik/avtokran-16-ili-25-tonn/" style="color:var(--yellow)">автокран 16 или 25 тонн</a>.</p>

    <h2 id="poryadok" style="margin:36px 0 16px">Порядок подъёма поддона по п. 114</h2>
    <p>Пункт 114 ФНП №461 задаёт последовательность, которую МОСКРАН-СЕРВИС выполняет на каждом поддоне, а не только на первом:</p>
    <ol>
      <li>Подъём начинается с отрыва на 0,2–0,3 м и остановки: крановщик и стропальщик МОСКРАН-СЕРВИС проверяют строповку тары и тормоз.</li>
      <li>Стропальщик остаётся рядом с грузом только пока груз поднят не выше 1 м от площадки; людей под грузом не бывает.</li>
      <li>Горизонтальное перемещение крановщик МОСКРАН-СЕРВИС ведёт на 0,5 м выше всех предметов на пути: лесов, ограждений перекрытия, штабелей.</li>
      <li>Груз опускается только на подготовленное место, где исключено падение, опрокидывание и сползание; под тару стропальщик МОСКРАН-СЕРВИС кладёт подкладки, чтобы вынуть стропы.</li>
      <li>Штабель поддонов на перекрытии бригада МОСКРАН-СЕРВИС раскладывает равномерно, не загромождая проходы и не превышая габариты складирования из ППР.</li>
    </ol>
    <p>Сигналы между стропальщиком и крановщиком МОСКРАН-СЕРВИС стандартные; их перечень дан в материале о <a href="/spravochnik/signaly-stropalshchika/" style="color:var(--yellow)">сигналах стропальщика</a>. Нагрузку на перекрытие от штабеля поддонов определяет не кран, а проектировщик или ответственный за безопасное производство работ заказчика.</p>

    <h2 id="zayavka" style="margin:36px 0 16px">Что передать при заказе</h2>
    <p>Для подбора МОСКРАН-СЕРВИС нужны пять данных: масса одного поддона по накладной, число поддонов, высота перекрытия или крыши, расстояние от места стоянки крана до дальней точки укладки и наличие тары с ограждением у заказчика. Без собственной тары МОСКРАН-СЕРВИС привозит контейнер под поддоны по согласованию. Заявка оформляется по порядку из материала о <a href="/spravochnik/zayavka-na-avtokran/" style="color:var(--yellow)">заявке на автокран</a>; ставки смены: 16–20 т — 17 600 ₽, 25 т — 20 800 ₽, 32 т — 24 800 ₽.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: кирпич на поддонах и автокран</h2>
    <ul>
      <li>Поддон без ограждения МОСКРАН-СЕРВИС перемещает только с транспорта на землю и обратно (п. 114 ФНП №461).</li>
      <li>На этаж и крышу кирпич у МОСКРАН-СЕРВИС идёт в таре с бортами; штучный груз вне тары не перемещают (п. 114).</li>
      <li>Поддон Braer 1 НФ — 1100 кг, 480 штук; газобетон Bonolit D400 600×375×250 — 32 блока на поддоне.</li>
      <li>Груз неизвестной массы МОСКРАН-СЕРВИС не поднимает: масса — из карточки завода или накладной.</li>
      <li>Подача в окно или на балкон без приёмной площадки запрещена (п. 115).</li>
      <li>Вылет до 16–18 м у МОСКРАН-СЕРВИС закрывает класс 16 т (17 600 ₽ за смену), дальше — 25 т (20 800 ₽).</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://www.consultant.ru/document/cons_doc_LAW_373321/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 (приказ Ростехнадзора от 26.11.2020 №461)</a> — п. 114: пробный подъём 0,2–0,3 м, стропальщик у груза до 1 м, мелкоштучный груз в таре, кирпич на поддонах без ограждения только с транспорта на землю, запрет подъёма груза неизвестной массы, 0,5 м над препятствиями, подкладки; п. 115: подача в оконные проёмы и на балконы.</li>
      <li><a href="https://braer.ru/catalog/oblitsovochnyy-kirpich/bordo-forn-1-nf/" target="_blank" rel="noopener" style="color:var(--yellow)">Braer — карточка кирпича 1 НФ «Бордо, фьорн»</a> — масса изделия 2,4 кг, 480 штук на поддоне, масса поддона 1100 кг, 9,41 м² на поддон.</li>
      <li><a href="https://bonolit.ru/products/bonolit40/" target="_blank" rel="noopener" style="color:var(--yellow)">Bonolit — газобетонные блоки</a> — марки плотности D300–D600, число блоков на поддоне и в м³ по размерам (600×375×250 D400 — 32 шт и 17,8 шт/м³).</li>
    </ul>
    <p class="small muted">Текст п. 114–115 сверен с редакцией ФНП №461 на legalacts.ru 10.10.2026. Оценка 3 т на вылете 16 м — верхняя граница по грузовому моменту; рабочее значение берут из таблицы паспорта конкретного крана. Ставки — из калькулятора на главной странице.</p>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-16-25-tonn/">Аренда автокрана 16–25 тонн →</a></section>
</main>
</SpravochnikLayout>
