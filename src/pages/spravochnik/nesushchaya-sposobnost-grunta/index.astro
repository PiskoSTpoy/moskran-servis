---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';
import Sources from '../../../components/Sources.astro';

const title = 'Как считают несущую способность грунта под опорами крана';
const description = 'Порог 15,4 кгс/см², правило для грузов до 10 т без подкладок на бетонном покрытии от 20 кгс/см², измерение плотномером ДорНИИ. Разбор для заказчика.';

const CHECKED = '12.08.2026';

const faqs = [
  { q: 'Как узнать несущую способность грунта на моей площадке без спецоборудования?', a: 'Точное измерение делает ответственный за безопасное производство работ с помощью специального прибора (плотномера-ударника ДорНИИ) — на глаз определить несущую способность грунта нельзя. Если сомневаетесь, лучше заранее прислать фото или описание типа покрытия площадки — мы оценим необходимость дополнительной проверки.' },
  { q: 'Что делать, если грунт на площадке слабый?', a: 'Поверхность укрепляют подсыпкой песка, шлака или гравия, либо частично снимают исходный грунт и заменяют более прочным материалом. Также используются инвентарные подкладки под выносные опоры, распределяющие нагрузку на большую площадь.' },
  { q: 'Всегда ли нужны подкладки под опоры крана?', a: 'Нет — на бетонном или другом искусственном покрытии с удельным давлением не менее 20 кгс/см² работа с грузами до 10 т допускается без подкладок. На грунте с несущей способностью менее 15,4 кгс/см² уплотнение и подкладки обязательны.' },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Несущая способность грунта', item: 'https://moskran-servis.ru/spravochnik/nesushchaya-sposobnost-grunta/' },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@id': 'https://moskran-servis.ru/#organization' }, // ссылка на единственный узел организации (BaseLayout): отдельный узел с тем же @id, но другим name, был противоречием в графе
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: 'https://moskran-servis.ru/spravochnik/nesushchaya-sposobnost-grunta/',
  inLanguage: 'ru-RU',
  datePublished: '2026-08-12',
  dateModified: '2026-08-12',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<SpravochnikLayout title={title} description={description} path="/spravochnik/nesushchaya-sposobnost-grunta/" slug="nesushchaya-sposobnost-grunta" ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Несущая способность грунта</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Разбор для заказчика</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Несущая способность грунта под выносными опорами крана — как считается</h1>
    <p class="ref-byline">Инженерная служба МОСКРАН-СЕРВИС · обновлено в 2026 году</p>

    <p>На нескольких страницах услуг мы упоминаем требования к площадке под выносные опоры крана. Здесь разбираем, откуда берутся эти требования и что означает «твёрдое покрытие» с инженерной точки зрения, а не просто на глаз.</p>

    <h2 style="margin:36px 0 16px">Почему это критично для безопасности</h2>
    <p>Если давление от выносной опоры крана на грунт превышает несущую способность площадки, грунт проседает под нагрузкой — и кран, стоящий на просевшей опоре, теряет устойчивость вплоть до опрокидывания. Это не гипотетический риск, а прямое следствие физики: чем тяжелее груз и больше вылет стрелы, тем выше нагрузка на конкретную опору в момент подъёма.</p>

    <h2 style="margin:36px 0 16px">Конкретные пороговые значения</h2>
    <p>Существуют установленные ориентиры: если несущая способность грунта рабочей площадки менее 15,4 кгс/см², требуется уплотнение грунта и обязательное использование подкладок под опорами. Отдельное правило для грузов до 10 тонн: работа без установки подкладок под опоры допускается только на площадке с бетонным или другим искусственным покрытием, обеспечивающим удельное давление не менее 20 кгс/см² — то есть даже относительно небольшой груз не освобождает от требований к покрытию, если оно недостаточно прочное.</p>

    <h2 style="margin:36px 0 16px">Кто и как измеряет несущую способность</h2>
    <p>Несущую способность грунта определяет работник, ответственный за безопасное производство работ грузоподъёмными кранами — не сам крановщик на глаз, а квалифицированный специалист с использованием специального прибора, например плотномера-ударника ДорНИИ. Это отдельный шаг оценки площадки, который мы делаем до установки крана на выносные опоры, если тип покрытия вызывает сомнение.</p>

    <h2 style="margin:36px 0 16px">Что делать, если грунт слабый</h2>
    <p>Если несущая способность площадки не соответствует расчётным нагрузкам, есть два пути: укрепление поверхности (подсыпка песка, шлака или гравия, либо частичная замена исходного грунта более прочным материалом) или использование инвентарных подкладок увеличенной площади под опоры, распределяющих нагрузку. Мы возим стандартные инвентарные подкладки с собой — для большинства городских площадок этого достаточно; для действительно слабого или заболоченного грунта иногда требуется гусеничная техника вместо автокрана (см. пример в разделе «Примеры задач»).</p>

    <h2 style="margin:36px 0 16px">Как мы это учитываем при расчёте заявки</h2>
    <p>Если площадка не имеет капитального твёрдого покрытия (грунтовая, засыпная, с признаками переувлажнения), уточняем это на этапе приёма заявки и, при необходимости, направляем ответственного специалиста для замера несущей способности перед выездом основной техники — это экономит время больше, чем попытка установить кран «на удачу» и столкнуться с необходимостью подготовки площадки уже в день выезда.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: что запомнить</h2>
    <ul>
      <li>Превышение давления от опоры над несущей способностью грунта — прямой риск потери устойчивости крана.</li>
      <li>Порог 15,4 кгс/см² — ниже этого значения обязательны уплотнение и подкладки.</li>
      <li>Для грузов до 10 т без подкладок допустимо только бетонное покрытие с удельным давлением от 20 кгс/см².</li>
      <li>Несущую способность определяет ответственный специалист прибором, не крановщик на глаз.</li>
      <li>При слабом грунте — укрепление площадки, подкладки увеличенной площади или гусеничная техника вместо автокрана.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <Sources
      checked={CHECKED}
      items={[
        { text: 'os1.ru — правила установки мобильного стрелового крана на строительной площадке', href: 'https://os1.ru/article/28828-pravila-ustanovki-mobilnogo-strelovogo-krana-na-stroitelnoy-ploshchadke-dayte-mne-tochku-opory' },
        { text: 'gakz.ru — памятка крановщика КС-55713-1В', href: 'https://www.gakz.ru/upload/docs/2015_service_pdf/knijka_kranovschika_ks-55713-1v.pdf' }
      ]}
    />
  </article>
  <section class="section wrap"><a class="btn" href="/keysy/montazh-oborudovaniya-zavod/">Пример: монтаж на мягком грунте →</a></section>
</main>
</SpravochnikLayout>
