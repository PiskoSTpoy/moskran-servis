---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = 'Расчёт многоветвевого стропа по ФНП 461: 90° и 3 ветви';
const description = 'Расчёт стропа по п. 217 «е» ФНП №461: угол 90° между ветвями, не более трёх ветвей, запас 6, 4, 7. Пример для груза 10 т.';

const CHECKED = '16.10.2026';
const PUBLISHED = '2026-10-16';
const SLUG = 'raschet-mnogovetvevogo-stropa-avtokran-fnp-461';
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: 'Сколько ветвей четырёхветвевого стропа учитывают в расчёте?',
    a: 'Не более трёх: для стропа с числом ветвей больше трёх, воспринимающих расчётную нагрузку, п. 217 «е» ФНП №461 велит учитывать три ветви. Это правило расчёта, а не запрет четвёртой ветви. МОСКРАН-СЕРВИС при подборе стропа считает нагрузку именно так.',
  },
  {
    q: 'Какой угол между ветвями принимают в расчёте?',
    a: 'В общем случае 90° (п. 217 «е» ФНП №461). Для стропа под заранее известный груз берут фактические углы. МОСКРАН-СЕРВИС для универсальных стропов использует 90°, а для изделий с известной геометрией считает по фактическому углу.',
  },
  {
    q: 'Какие коэффициенты запаса нужны при замене ветви стропа?',
    a: 'Не менее 6 для ветви из стальных канатов, не менее 4 для стальных цепей, не менее 7 для лент или нитей (круглопрядных стропов) на полимерной основе (п. 217 «е» ФНП №461). Замену ветви МОСКРАН-СЕРВИС выполняет только с подтверждением этих значений.',
  },
  {
    q: 'Какой коэффициент запаса у одноразовых пакетирующих стропов?',
    a: 'Для ветвей специальных транспортирующих и пакетирующих стропов, которые используют не более 5 перегрузок пакетов в одном рабочем цикле от изготовителя до потребителя и затем утилизируют, коэффициент не менее 5 (п. 217 «е» ФНП №461). Повторно такие стропы МОСКРАН-СЕРВИС не использует.',
  },
  {
    q: 'Под каким углом испытывают многоветвевой строп?',
    a: 'Ветви при испытании располагают под углом 90° друг к другу по вертикали (п. 230 ФНП №461). Другой угол допускается с пересчётом испытательных нагрузок. МОСКРАН-СЕРВИС принимает стропы только с документами об испытаниях по паспорту изготовителя.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Расчёт многоветвевого стропа для автокрана по ФНП №461', item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ['pravilo', 'Что велит п. 217 «е» при расчёте стропа'],
  ['tri-vetvi', 'Почему в расчёте не более трёх ветвей'],
  ['primer', 'Пример: груз 10 т на двух- и четырёхветвевом стропе'],
  ['zapas', 'Коэффициенты запаса при замене ветвей'],
  ['ispytanie', 'Угол 90° при испытании стропа'],
  ['moskva', 'Что проверяет МОСКРАН-СЕРВИС перед строповкой'],
  ['faq', 'Частые вопросы'],
  ['istochniki', 'Источники'],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Расчёт многоветвевого стропа для автокрана по ФНП №461</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">ФНП №461 · Стропы</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Как считают многоветвевой строп для автокрана: какой угол, сколько ветвей и какой запас?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>16.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>16.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>6 мин чтения</span>
    </div>

    <p>Пункт 217 «е» ФНП №461 велит считать стропы из стальных канатов по числу ветвей и углу к вертикали: нагрузка делится поровну, угол между ветвями в общем случае 90°, в расчёте учитывают не более трёх ветвей. МОСКРАН-СЕРВИС проверяет этот расчёт до зацепки груза автокраном.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="pravilo" style="margin:36px 0 16px">Что велит п. 217 «е» при расчёте стропа</h2>
    <p>Подпункт «е» п. 217 ФНП №461 требует рассчитывать стропы из стальных канатов перед эксплуатацией с учётом числа ветвей и угла их наклона к вертикали. Расчётную нагрузку на отдельную ветвь определяют из условия равномерного натяжения каждой ветви и, в общем случае, расчётного угла 90° между ветвями. МОСКРАН-СЕРВИС принимает эти условия как базовые для любого универсального стропа.</p>
    <p>Для стропа, который делают под заранее известный груз, норма разрешает брать фактические углы между ветвями. Универсальный строп на 90° и «заказной» строп под конкретную деталь считаются разными расчётными случаями. МОСКРАН-СЕРВИС запрашивает у заказчика геометрию груза, если строп изготовлен под изделие.</p>

    <h2 id="tri-vetvi" style="margin:36px 0 16px">Почему в расчёте не более трёх ветвей</h2>
    <p>Для стропа с числом ветвей более трёх, воспринимающих расчётную нагрузку, в расчёте учитывают не более трёх ветвей (п. 217 «е» ФНП №461). Норма не объясняет причину, но смысл виден из практики: жёсткий груз опирается на три точки надёжно, а четвёртая ветвь натягивается неравномерно. МОСКРАН-СЕРВИС поэтому не считает четырёхветвевой строп вдвое прочнее двухветвевого.</p>
    <p>Практический вывод для заказчика: четырёхветвевой строп даёт устойчивость груза, но не четырёхкратный запас по нагрузке. Угол наклона ветвей и поправки на неравномерность разобраны в справке об <a href="/spravochnik/ugol-naklona-stropa/" style="color:var(--yellow)">угле наклона стропа</a>. МОСКРАН-СЕРВИС при выборе стропа ориентируется на маркировку нагрузки, а не на число крюков.</p>

    <h2 id="primer" style="margin:36px 0 16px">Пример: груз 10 т на двух- и четырёхветвевом стропе</h2>
    <p>Груз 10 т на двухветвевом стропе с углом 90° между ветвями даёт ≈ 7,07 т на ветвь: каждая ветвь отклонена на 45° от вертикали, 10 / (2 × cos 45°). На четырёхветвевом стропе с тем же углом учитывают три ветви: 10 / (3 × cos 45°) ≈ 4,71 т на ветвь. Расчёт — иллюстрация правила п. 217 «е», а не замена паспорта стропа; МОСКРАН-СЕРВИС берёт предельные значения только из маркировки.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Строп</th><th>Ветвей в расчёте</th><th>Нагрузка на ветвь при 10 т и 90°</th><th>Разрывное усилие ветви при запасе 6</th></tr></thead>
        <tbody>
          <tr><td>двухветвевой</td><td>2</td><td>≈ 7,07 т</td><td>≈ 42,4 т</td></tr>
          <tr><td>трёхветвевой</td><td>3</td><td>≈ 4,71 т</td><td>≈ 28,3 т</td></tr>
          <tr><td>четырёхветвевой</td><td>3 (не больше трёх)</td><td>≈ 4,71 т</td><td>≈ 28,3 т</td></tr>
        </tbody>
      </table>
    </div>
    <p>Последний столбец показывает смысл коэффициента 6 для канатной ветви: разрывное усилие должно быть в шесть раз выше рабочей нагрузки. Значение 6 норма задаёт для замены ветвей; для нового стропа запас определяет изготовитель, и МОСКРАН-СЕРВИС ориентируется на его паспорт. Если груз тяжелее, чем позволяет строп на 90°, выход один — траверса или строп другой грузоподъёмности, а не больший угол.</p>

    <h2 id="zapas" style="margin:36px 0 16px">Коэффициенты запаса при замене ветвей</h2>
    <p>При замене ветвей стропа п. 217 «е» ФНП №461 задаёт запас: канат не менее 6, цепь не менее 4, полимерные ленты и нити (круглопрядные стропы) не менее 7. МОСКРАН-СЕРВИС ставит на замену ветвь только с документом, где такой запас подтверждён.</p>
    <ul>
      <li>МОСКРАН-СЕРВИС для канатной ветви требует запас не менее 6.</li>
      <li>МОСКРАН-СЕРВИС для цепной ветви допускает запас не менее 4.</li>
      <li>МОСКРАН-СЕРВИС для круглопрядного полимерного стропа требует запас не менее 7.</li>
      <li>МОСКРАН-СЕРВИС для одноразовых пакетирующих ветвей (не более 5 перегрузок) принимает запас не менее 5.</li>
    </ul>
    <p>Разница между 4 для цепи и 7 для полимера отражает разную чувствительность материалов к износу и ударной нагрузке. Нормативная разница видна в п. 217 «е», причины в нём не названы, и МОСКРАН-СЕРВИС не домысливает их в документах. Как контролировать износ ветвей, написано в справке об <a href="/spravochnik/osmotr-stropov-i-traverc-fnp-461/" style="color:var(--yellow)">осмотре строп и траверс</a>.</p>

    <h2 id="ispytanie" style="margin:36px 0 16px">Угол 90° при испытании стропа</h2>
    <p>При испытаниях многоветвевых стропов их ветви располагают под углом 90° друг к другу по вертикали (п. 230 ФНП №461). Другой угол допустим, но испытательные нагрузки тогда пересчитывают. Угол 90° в расчёте и в испытании совпадает намеренно, поэтому паспортная грузоподъёмность стропа привязана к этому углу. МОСКРАН-СЕРВИС не использует строп с углом больше 90°, если его маркировка не допускает иного.</p>

    <h2 id="moskva" style="margin:36px 0 16px">Что проверяет МОСКРАН-СЕРВИС перед строповкой</h2>
    <p>Экипаж МОСКРАН-СЕРВИС на автокране КС-55713 «Клинцы» или КС-65713-1 «Галичанин» до зацепки сверяет четыре вещи: массу груза, число и тип ветвей, угол между ветвями и маркировку стропа. Если стропальщик заказчика привёз собственный строп, проверка выглядит так же. Порядок — практика МОСКРАН-СЕРВИС, ФНП его в такой форме не требует.</p>
    <ul>
      <li>МОСКРАН-СЕРВИС сверяет массу груза со списком грузов — см. <a href="/spravochnik/spisok-gruzov-s-massoy-v-zone-rabot-avtokrana-fnp-461/" style="color:var(--yellow)">список грузов с массой в зоне работ</a>.</li>
      <li>МОСКРАН-СЕРВИС проверяет, что строп имеет бирку с грузоподъёмностью и номером.</li>
      <li>МОСКРАН-СЕРВИС оценивает реальный угол между ветвями по высоте крюка над грузом.</li>
      <li>МОСКРАН-СЕРВИС при сомнении заменяет строп более длинным, чтобы снизить угол.</li>
    </ul>
    <p>Схемы обвязки и требования к стропальщику собраны в справках о <a href="/spravochnik/shemy-stropovki-gruzov/" style="color:var(--yellow)">схемах строповки</a> и <a href="/spravochnik/trebovaniya-k-stropalshchiku/" style="color:var(--yellow)">требованиях к стропальщику</a>.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: расчёт многоветвевого стропа</h2>
    <ul>
      <li>МОСКРАН-СЕРВИС считает нагрузку на ветвь из равномерного натяжения и угла 90° (п. 217 «е» ФНП №461).</li>
      <li>В расчёте МОСКРАН-СЕРВИС учитывает не более трёх ветвей даже у четырёхветвевого стропа.</li>
      <li>Запас при замене ветви для МОСКРАН-СЕРВИС: канат 6, цепь 4, полимер 7.</li>
      <li>Испытывают строп при 90° между ветвями (п. 230); МОСКРАН-СЕРВИС этот угол из паспорта не превышает.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://www.consultant.ru/document/cons_doc_LAW_373321/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 (приказ Ростехнадзора от 26.11.2020 №461)</a> — п. 217 «е» (расчёт стропов, угол 90°, три ветви, коэффициенты запаса), п. 230 (угол при испытании).</li>
      <li><a href="https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 на legalacts.ru</a> — редакция от 16.04.2026, текст пунктов 217 и 230 сверен 16.10.2026.</li>
    </ul>
    <p class="small muted">Числовой пример для груза 10 т — арифметика по формуле «масса / (число ветвей × cos угла к вертикали)», иллюстрация правила, а не расчёт конкретного стропа. Паспорт стропа приоритетнее. Порядок проверки перед строповкой — практика МОСКРАН-СЕРВИС.</p>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-16-25-tonn/">Аренда автокрана 16–25 тонн →</a></section>
</main>
</SpravochnikLayout>
