---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = 'Работа крана у железной дороги: 3100 мм по ГОСТ 9238';
const description = 'От оси пути до габарита приближения строений — 3100 мм по ГОСТ 9238-2022. Как это связано с опорами автокрана, чем отличается от ФНП №461 и кто согласует.';

const CHECKED = '06.10.2026';
const PUBLISHED = '2026-10-06';
const SLUG = 'rabota-krana-ryadom-s-zheleznoy-dorogoy';
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: 'На каком расстоянии от железной дороги можно ставить автокран?',
    a: 'ГОСТ 9238-2022 задаёт габарит приближения строений: 3100 мм от оси крайнего пути, в трудных условиях на существующих линиях — 2450 мм. Стандарт описывает строения, а не временные краны, поэтому МОСКРАН-СЕРВИС берёт эти числа как ориентир и запрашивает требования у владельца путей.',
  },
  {
    q: 'Какой ГОСТ действует на габариты приближения сейчас?',
    a: 'С 01.05.2024 действует ГОСТ 9238-2022, введённый приказом Росстандарта от 09.12.2022 №1461-ст взамен ГОСТ 9238-2013. Старый ГОСТ 9238-83 в проверенных справочных текстах ещё встречается, но числа из него (например, 2750 мм в трудных условиях) устарели. МОСКРАН-СЕРВИС работает по действующей редакции.',
  },
  {
    q: 'Можно ли находиться стропальщику между грузом и вагоном?',
    a: 'Нельзя: п. 129 ФНП №461 запрещает нахождение людей, в том числе стропальщика, между поднимаемым грузом и стеной, колонной, штабелем или железнодорожным вагоном. Требование действует при подъёме, опускании и перемещении. МОСКРАН-СЕРВИС ставит стропальщика так, чтобы путь отхода был свободен.',
  },
  {
    q: 'Нужно ли согласование владельца железной дороги?',
    a: 'Если стрела или груз могут войти в габарит приближения или работа идёт на территории путей, МОСКРАН-СЕРВИС просит у заказчика письменные условия владельца инфраструктуры до подачи техники. Конкретные сроки и форму согласования определяет сам владелец, обещать их заранее нельзя.',
  },
  {
    q: 'Что нужно сообщить при заказе автокрана рядом с путями?',
    a: 'Нужны расстояние от оси ближайшего пути до места стоянки, число путей, наличие контактной сети и вес груза. МОСКРАН-СЕРВИС по этим данным подбирает тоннаж и проверяет вылет, а смена 16–20-тонного автокрана стоит 17 600 ₽.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Работа крана рядом с железной дорогой', item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ['gost', 'Что задаёт ГОСТ 9238-2022'],
  ['starye', 'Почему в справочниках встречаются старые числа'],
  ['raschet', 'Пример расчёта по опорам КС-35714'],
  ['fnp', 'Что говорит ФНП №461'],
  ['soglasovanie', 'Согласование и что передать при заказе'],
  ['faq', 'Частые вопросы'],
  ['istochniki', 'Источники'],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Работа крана рядом с железной дорогой</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Практика · Подъём рядом с железной дорогой</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">На каком расстоянии от железной дороги можно ставить автокран?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>06.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>06.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>6 мин чтения</span>
    </div>

    <p>Габарит приближения строений по ГОСТ 9238-2022 начинается в 3100 мм от оси крайнего пути, а на существующих линиях в трудных условиях сокращается до 2450 мм. МОСКРАН-СЕРВИС разбирает, как эти числа соотносятся с опорами автокрана и стрелой. Стандарт описывает строения, а не краны, поэтому отдельного «разрешённого расстояния для крана» в нём нет.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="gost" style="margin:36px 0 16px">Что задаёт ГОСТ 9238-2022</h2>
    <p>ГОСТ 9238-2022 устанавливает исходные очертания габаритов железнодорожного подвижного состава и приближения строений для колеи 1520 и 1435 мм. Габарит С относится к путям общего пользования, Сп — к путям необщего пользования на предприятиях. Пункт 6.1.9 называет 3100 мм от оси пути до сооружений с внешней стороны крайних путей, пункт 6.1.10 допускает 2450 мм на существующих линиях в трудных условиях. МОСКРАН-СЕРВИС использует эти числа как отправную точку расчёта площадки.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Условие</th><th>Расстояние от оси пути</th><th>Пункт ГОСТ 9238-2022</th></tr></thead>
        <tbody>
          <tr><td>Сооружения у крайнего пути</td><td>3100 мм</td><td>6.1.9</td></tr>
          <tr><td>Существующие линии, трудные условия</td><td>2450 мм</td><td>6.1.10</td></tr>
          <tr><td>Действует с</td><td>01.05.2024</td><td>приказ №1461-ст от 09.12.2022</td></tr>
        </tbody>
      </table>
    </div>

    <h2 id="starye" style="margin:36px 0 16px">Почему в справочниках встречаются старые числа</h2>
    <p>ГОСТ 9238-2022 заменил ГОСТ 9238-2013, но в сети до сих пор цитируют ещё более ранний ГОСТ 9238-83. Этот стандарт даёт 3100 мм в основной части, но для трудных условий — 2750 мм (до опор контактной сети и мачт светофоров) и 2250 мм для габарита Сп, то есть числа отличаются от нынешних. МОСКРАН-СЕРВИС проверяет редакцию ГОСТ по приказу о введении и не берёт числа из текста без указанного года.</p>

    <h2 id="raschet" style="margin:36px 0 16px">Пример расчёта по опорам КС-35714</h2>
    <p>Опорный контур КС-35714К-2 равен 5200×4000 мм, значит поперечный вынос опор от оси крана составляет примерно 2 м в каждую сторону. Если опорные балки должны остаться за линией 3100 мм от оси пути, ось крана надо ставить не ближе 5,1 м от неё (3,1 + 2,0 м), без учёта ширины опорной плиты и подкладок. МОСКРАН-СЕРВИС называет эту цифру инженерной оценкой, а не нормой: фактический вынос берут из паспорта машины.</p>
    <p>Стрела и груз вдоль пути создают отдельную задачу, потому что их проекция может выходить в габарит. Поэтому расчёт опор не заменяет проверку вылета, которую МОСКРАН-СЕРВИС делает по <a href="/spravochnik/gruzovysotnaya-harakteristika/" style="color:var(--yellow)">грузовысотной характеристике</a>. Вопрос о размерах площадки разобран также в материале <a href="/spravochnik/rasstoyanie-ot-kotlovana/" style="color:var(--yellow)">«Расстояние от котлована»</a>.</p>

    <h2 id="fnp" style="margin:36px 0 16px">Что говорит ФНП №461</h2>
    <p>Пункт 129 ФНП №461 (редакция от 16.04.2026) запрещает находиться людям, включая стропальщика, между поднимаемым грузом и железнодорожным вагоном, стеной, колонной или штабелем. Требование действует при подъёме, опускании и перемещении груза. МОСКРАН-СЕРВИС расставляет людей так, чтобы пути отхода не пересекались с вагонами. Общая схема опасной зоны описана в материале об <a href="/spravochnik/opasnaya-zona-krana/" style="color:var(--yellow)">опасной зоне крана</a>.</p>
    <p>В проверенных текстах раздела VI ФНП №461 мы не нашли числа «минимальное расстояние от оси пути до крана», поэтому МОСКРАН-СЕРВИС не приводит такой цифры в качестве нормы. Расстояния до проводов и охранные зоны, если рядом идёт контактная сеть или ЛЭП, разобраны в материале об <a href="/spravochnik/ohrannaya-zona-lep-i-30-metrov-fnp-461/" style="color:var(--yellow)">охранных зонах ЛЭП</a>.</p>

    <h2 id="soglasovanie" style="margin:36px 0 16px">Согласование и что передать при заказе</h2>
    <p>Если стрела или груз могут войти в габарит приближения либо работа идёт на территории путей, МОСКРАН-СЕРВИС просит заказчика приложить письменные условия владельца инфраструктуры. Срок и форма согласования зависят от владельца, поэтому мы их не обещаем. Похожий порядок для подземных объектов описан в материале <a href="/spravochnik/rabota-krana-ryadom-s-metropolitenom/" style="color:var(--yellow)">«Работа крана рядом с метрополитеном»</a>.</p>
    <p>При заказе сообщите расстояние от оси ближайшего пути до места стоянки, число путей, наличие контактной сети и массу груза. МОСКРАН-СЕРВИС по этим данным подбирает тоннаж, а смена 16–20-тонного автокрана стоит 17 600 ₽ (2 200 ₽/ч × 8 ч). Заказ оформляют по <a href="/spravochnik/zayavka-na-avtokran/" style="color:var(--yellow)">заявке на автокран</a>.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: кран у железной дороги</h2>
    <ul>
      <li>ГОСТ 9238-2022: 3100 мм от оси крайнего пути, 2450 мм в трудных условиях.</li>
      <li>Действует с 01.05.2024 взамен ГОСТ 9238-2013; числа из ГОСТ 9238-83 устарели.</li>
      <li>Стандарт описывает строения, а не краны: «нормы для крана» в нём нет.</li>
      <li>П. 129 ФНП №461: между грузом и вагоном людей быть не должно.</li>
      <li>Условия владельца путей запрашиваются до подачи техники.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://meganorm.ru/mega_doc/norm/gost_gosudarstvennyj-standart/0/gost_9238-2022_mezhgosudarstvennyy_standart_gabarity.html" target="_blank" rel="noopener" style="color:var(--yellow)">ГОСТ 9238-2022 — meganorm.ru</a> — пункты 6.1.9 и 6.1.10, дата введения 01.05.2024, замена ГОСТ 9238-2013.</li>
      <li><a href="https://files.stroyinf.ru/Data2/1/4294853/4294853521.htm" target="_blank" rel="noopener" style="color:var(--yellow)">ГОСТ 9238-83 — stroyinf.ru</a> — прежняя редакция для сравнения (2750 и 2250 мм).</li>
      <li><a href="https://sudact.ru/law/prikaz-rostekhnadzora-ot-26112020-n-461-ob/federalnye-normy-i-pravila-v/vi/ustanovka-ps-i-proizvodstvo-rabot/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461, раздел VI «Установка ПС и производство работ»</a> — п. 129 о нахождении людей между грузом и вагоном.</li>
      <li><a href="https://kamaz.ru/production/special/avtokrany/avtomobilnyy-kran-ks-35714k-2/" target="_blank" rel="noopener" style="color:var(--yellow)">КС-35714К-2 — kamaz.ru</a> — опорный контур 5200×4000 мм.</li>
    </ul>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-16-25-tonn/">Аренда автокрана 16–25 тонн →</a></section>
</main>
</SpravochnikLayout>
