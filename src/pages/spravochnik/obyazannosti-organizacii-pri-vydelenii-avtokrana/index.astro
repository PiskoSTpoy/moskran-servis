---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = 'Обязанности организации при выделении автокрана: ФНП №461';
const description = 'Табличка с заводским номером, паспортной грузоподъёмностью и датами освидетельствований, ППР со схемами, испытанные стропы: п. 121–122 ФНП №461 и кто отвечает.';

const CHECKED = '09.10.2026';
const PUBLISHED = '2026-10-09';
const SLUG = 'obyazannosti-organizacii-pri-vydelenii-avtokrana';
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: 'Какие данные должны быть на табличке автокрана?',
    a: 'Пункт 121 ФНП №461 требует табличку с заводским номером подъёмного сооружения, паспортной грузоподъёмностью и датами следующего полного и частичного технических освидетельствований. МОСКРАН-СЕРВИС рекомендует заказчику сверить эти данные с паспортом при приёмке техники на объекте.',
  },
  {
    q: 'Кто отвечает за безопасность при работе крана, выделенного другой организацией?',
    a: 'По пункту 122 ФНП №461 ответственность за обеспечение требований промышленной безопасности при работе ПС несёт организация, выделившая его для работ. МОСКРАН-СЕРВИС как собственник и эксплуатирующая организация отвечает за состояние крана, а за площадку, допуск людей в зону и согласования отвечает заказчик по договору.',
  },
  {
    q: 'Кто должен выдать ППР и схемы погрузки на место работ?',
    a: 'Пункт 122 возлагает на эксплуатирующую организацию разработку и выдачу на место ведения работ ППР или технологической карты со схемами складирования грузов и схемами погрузки и разгрузки транспорта. МОСКРАН-СЕРВИС готовит их по исходным данным заказчика: плану площадки, массе и размерам груза.',
  },
  {
    q: 'Нужно ли знакомить стропальщиков с ППР под подпись?',
    a: 'Да. Пункт 122 требует ознакомить под подпись с ППР и ТК, среди прочих, ответственных специалистов, крановщиков и стропальщиков. Если стропальщиков предоставляет заказчик, подпись ставят именно его работники. МОСКРАН-СЕРВИС просит заранее передать список людей, которые будут работать у крана.',
  },
  {
    q: 'Как часто проверяют ограничитель грузоподъёмности и другие приборы?',
    a: 'Пункт 122 не называет единый срок: проверки работоспособности указателей, ограничителей и регистраторов проводят в сроки, установленные их руководствами по эксплуатации. МОСКРАН-СЕРВИС ведёт их по руководству конкретной машины и отмечает в документации крана.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Обязанности организации при выделении автокрана', item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ['tablichka', 'Табличка на кране'],
  ['otvetstvennost', 'Кто отвечает за выделенный кран'],
  ['ppr', 'ППР и схемы на месте работ'],
  ['oborudovanie', 'Стропы, тара и приборы безопасности'],
  ['nerabochee', 'Кран в нерабочем состоянии и аварийные действия'],
  ['chek-list', 'Что проверить заказчику при приёмке'],
  ['faq', 'Частые вопросы'],
  ['istochniki', 'Источники'],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Обязанности организации при выделении автокрана</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">ФНП №461 · Эксплуатирующая организация</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Что организация обязана обеспечить, когда выделяет автокран на объект заказчика?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>09.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>09.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>5 мин чтения</span>
    </div>

    <p>Пункты 121 и 122 ФНП №461 возлагают на организацию, выделившую автокран, ответственность за требования промышленной безопасности при его работе и перечисляют обязанности: табличка на кране, ППР со схемами, испытанные стропы, порядок сигналов. МОСКРАН-СЕРВИС проходит этот перечень перед каждым выездом, а заказчику он служит чек-листом при приёмке техники на площадке.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="tablichka" style="margin:36px 0 16px">Табличка на кране</h2>
    <p>Пункт 121 ФНП №461 требует, чтобы эксплуатируемое подъёмное сооружение имело таблички с тремя сведениями: заводским номером, паспортной грузоподъёмностью и датами следующего полного и частичного технических освидетельствований. МОСКРАН-СЕРВИС подтверждает эти данные паспортом машины. Если даты на табличке не совпадают с записями в паспорте, это основание не допускать кран к работе до выяснения.</p>
    <p>МОСКРАН-СЕРВИС ведёт освидетельствование по графику, который задаёт руководство по эксплуатации; порядок описан в материале о <a href="/spravochnik/tehnicheskoe-osvidetelstvovanie-krana/" style="color:var(--yellow)">техническом освидетельствовании крана</a>. Сам паспорт и его разделы разобраны в материале о <a href="/spravochnik/pasport-krana/" style="color:var(--yellow)">паспорте крана</a>.</p>

    <h2 id="otvetstvennost" style="margin:36px 0 16px">Кто отвечает за выделенный кран</h2>
    <p>В пункте 122 ФНП №461 закреплено правило: ответственность за обеспечение требований промышленной безопасности при работе подъёмного сооружения несёт организация, выделившая его для работ. МОСКРАН-СЕРВИС выделяет автокран по заявке и поэтому отвечает за состояние машины, документы, допущенного крановщика и приборы безопасности. За подготовку площадки, допуск людей в опасную зону и согласования стороны договариваются отдельно.</p>
    <p>МОСКРАН-СЕРВИС фиксирует распределение ответственности между собственником крана и заказчиком в договоре аренды; варианты описаны в материале об <a href="/spravochnik/arenda-s-ekipazhem-i-bez/" style="color:var(--yellow)">аренде с экипажем и без</a>. Ответственность за падение груза рассматривает материал об <a href="/spravochnik/otvetstvennost-za-padenie-gruza/" style="color:var(--yellow)">ответственности за падение груза</a>.</p>

    <h2 id="ppr" style="margin:36px 0 16px">ППР и схемы на месте работ</h2>
    <p>По пункту 122 эксплуатирующая организация разрабатывает и выдаёт на места ведения работ ППР или технологическую карту, а также схемы складирования грузов и схемы погрузки и разгрузки транспортных средств. МОСКРАН-СЕРВИС выпускает эти документы по исходным данным заказчика: плану площадки, массе и размерам грузов, точкам стоянки крана. Без таких данных документ получается формальным.</p>
    <p>Кроме выдачи, пункт 122 требует ознакомить под подпись с ППР и технологической картой ответственных за производственный контроль, за содержание ПС, за безопасное производство работ, крановщиков и стропальщиков. МОСКРАН-СЕРВИС собирает подписи до начала подъёмов. Содержание ППР раскрыто в материале о <a href="/spravochnik/ppr-dlya-krana/" style="color:var(--yellow)">ППР для крана</a>.</p>

    <h2 id="oborudovanie" style="margin:36px 0 16px">Стропы, тара и приборы безопасности</h2>
    <p>Пункт 122 обязывает обеспечить стропальщиков испытанными и маркированными грузозахватными приспособлениями и тарой, которые соответствуют массе и характеру груза. МОСКРАН-СЕРВИС везёт собственный комплект стропов и проверяет маркировку на бирках; стропы заказчика без маркировки к работе не допускаются. Критерии браковки стропов вынесены в отдельные материалы, например о <a href="/spravochnik/tekstilnye-stropy/" style="color:var(--yellow)">текстильных стропах</a>.</p>
    <p>МОСКРАН-СЕРВИС проверяет приборы безопасности по руководству машины: пункт 122 говорит о проверках работоспособности указателей, ограничителей и регистраторов в сроки, установленные руководствами. Работу ограничителя разбирает материал об <a href="/spravochnik/ogranichitel-gruzopodemnosti/" style="color:var(--yellow)">ограничителе грузоподъёмности</a>.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Обязанность организации</th><th>Что проверяет заказчик</th><th>Пункт</th></tr></thead>
        <tbody>
          <tr><td>Табличка на кране</td><td>заводской номер, грузоподъёмность, даты освидетельствований</td><td>121</td></tr>
          <tr><td>Выдача ППР или ТК на место работ</td><td>документ на площадке, схемы погрузки и складирования</td><td>122</td></tr>
          <tr><td>Ознакомление под подпись</td><td>листы с подписями ответственных, крановщика, стропальщиков</td><td>122</td></tr>
          <tr><td>Испытанные и маркированные стропы и тара</td><td>бирки на стропах, соответствие массе груза</td><td>122</td></tr>
          <tr><td>Проверка указателей, ограничителей, регистраторов</td><td>записи по руководству машины</td><td>122</td></tr>
          <tr><td>Порядок обмена сигналами</td><td>сигналы известны крановщику и стропальщикам</td><td>122</td></tr>
        </tbody>
      </table>
    </div>

    <h2 id="nerabochee" style="margin:36px 0 16px">Кран в нерабочем состоянии и аварийные действия</h2>
    <p>Для смонтированного подъёмного сооружения в нерабочем состоянии пункт 122 требует обесточить его и принять меры против угона ветром. Норма написана для смонтированных кранов, но МОСКРАН-СЕРВИС применяет её смысл к автокрану на стоянке: двигатель выключен, стрела не оставлена под ветровой нагрузкой выше паспортной. Предельную скорость ветра задаёт паспорт, см. материал о <a href="/spravochnik/rabota-krana-pri-silnom-vetre/" style="color:var(--yellow)">работе крана при сильном ветре</a>.</p>
    <p>МОСКРАН-СЕРВИС как эксплуатирующая организация устанавливает порядок приведения крана в безопасное положение и действия работников при аварии, включая покидание опасной зоны. Если происходит неисправность, действует порядок из материала о <a href="/spravochnik/neispravnost-krana-na-obekte/" style="color:var(--yellow)">неисправности крана на объекте</a>.</p>

    <h2 id="chek-list" style="margin:36px 0 16px">Что проверить заказчику при приёмке</h2>
    <p>При приёмке автокрана МОСКРАН-СЕРВИС рекомендует заказчику пройти пять пунктов: табличка читается и совпадает с паспортом, ППР лежит на площадке, есть подписи ознакомления, на стропах есть бирки, назначен ответственный за безопасное производство работ. Роль ответственного разобрана в материале об <a href="/spravochnik/otvetstvennyy-za-bezopasnoe-proizvodstvo/" style="color:var(--yellow)">ответственном за безопасное производство работ</a>. Заказ оформляется по порядку из материала о <a href="/spravochnik/zayavka-na-avtokran/" style="color:var(--yellow)">заявке на автокран</a>; ставки — в калькуляторе на главной странице.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: обязанности организации</h2>
    <ul>
      <li>На кране — табличка с заводским номером, паспортной грузоподъёмностью и датами освидетельствований (п. 121).</li>
      <li>Ответственность за требования промышленной безопасности несёт организация, выделившая кран (п. 122).</li>
      <li>ППР или ТК и схемы погрузки выдают на место работ; с ними знакомят под подпись, включая стропальщиков (п. 122).</li>
      <li>Стропы и тара — испытанные и маркированные, под массу груза (п. 122).</li>
      <li>Приборы безопасности проверяют в сроки, заданные руководством машины (п. 122).</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://www.consultant.ru/document/cons_doc_LAW_373321/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 (приказ Ростехнадзора от 26.11.2020 №461)</a> — п. 121: таблички на ПС; п. 122: обязанности эксплуатирующей организации, ответственность организации, выделившей ПС, ППР и ТК, ознакомление под подпись, стропы и тара, проверки приборов безопасности, нерабочее состояние и аварийные действия.</li>
    </ul>
    <p class="small muted">Текст пунктов сверен с редакцией ФНП №461 на legalacts.ru 09.10.2026. Распределение ответственности за площадку и согласования определяет договор; материал не заменяет консультацию юриста.</p>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-25-40-tonn/">Аренда автокрана 25–40 тонн →</a></section>
</main>
</SpravochnikLayout>
