---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = 'Монтаж блоков ФБС автокраном: масса и вылет';
const description = 'ФБС 24.6.6 весит 1,96 т, ФБС 12.6.6 — 0,96 т (ГОСТ 13579-2018). Как подобрать автокран под подвал: пример 145 т блоков, ставка 20 800 ₽ за смену.';

const CHECKED = '30.09.2026';
const PUBLISHED = '2026-09-30';
const SLUG = 'montazh-blokov-fbs-avtokranom';
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: 'Сколько весит блок ФБС 24.6.6?',
    a: 'По ГОСТ 13579-2018 блок ФБС 24.6.6 из тяжёлого бетона размером 2380 × 600 × 580 мм весит 1,96 т. Блок ФБС 12.6.6 длиной 1180 мм — 0,96 т, ФБС 9.6.6 длиной 880 мм — 0,70 т. МОСКРАН-СЕРВИС берёт массу из маркировки партии, потому что блок из лёгкого бетона легче.',
  },
  {
    q: 'Какой автокран нужен для монтажа фундаментных блоков?',
    a: 'Для типового подвала частного дома хватает автокрана на 25 т: блок 1,96 т при вылете 12–18 м даёт момент 23,5–35,3 т·м, а у КС-55713-1К «Клинцы» и «Ивановца» КС-45717К-1Р он 85 т·м. МОСКРАН-СЕРВИС ставит 50-тонный кран, только когда вылет до дальней точки не проходит по таблице паспорта.',
  },
  {
    q: 'Сколько стоит смена автокрана на монтаж ФБС?',
    a: 'Ставка МОСКРАН-СЕРВИС на кран 25 т — 2 600 ₽ в час, смена 8 часов стоит 20 800 ₽. Кран на 32 т обойдётся в 24 800 ₽ за смену, на 50 т — 31 200 ₽. Итог зависит от объёма блоков и вылета, окончательную сумму фиксирует калькулятор на странице заявки.',
  },
  {
    q: 'Можно ли ставить блоки, пока стропальщик стоит в траншее?',
    a: 'Нет: п. 114 ФНП №461 не допускает перемещать груз над людьми, а стропальщик подходит к грузу, опущенному не выше 1 м, и не находится под ним. МОСКРАН-СЕРВИС просит заказчика выставить стропальщика и сигнальщика, которые заранее знают порядок подачи блока в траншею.',
  },
  {
    q: 'По какому ГОСТу делают блоки ФБС?',
    a: 'Блоки ФБС изготавливают по ГОСТ 13579-2018, введённому с 01.05.2019 взамен ГОСТ 13579-78. Стандарт задаёт размеры и справочную массу каждой марки. МОСКРАН-СЕРВИС сверяет привезённые блоки с этой таблицей до начала работ, чтобы не подобрать кран по устаревшей массе.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Монтаж блоков ФБС', item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ['massy', 'Сколько весят блоки ФБС'],
  ['primer', 'Пример: подвал 10 × 12 м'],
  ['vylet', 'Вылет и грузовой момент'],
  ['norma', 'Что требует ФНП №461'],
  ['stoimost', 'Сколько стоит смена'],
  ['faq', 'Частые вопросы'],
  ['istochniki', 'Источники'],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Монтаж блоков ФБС</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Как заказать · Фундамент и подвал</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Какой автокран нужен для монтажа фундаментных блоков ФБС?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>30.09.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>30.09.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>6 мин чтения</span>
    </div>

    <p>Для подвала частного дома хватает автокрана на 25 т: самый тяжёлый ходовой блок ФБС 24.6.6 весит 1,96 т по ГОСТ 13579-2018, а на вылете 18 м это 35,3 т·м при грузовом моменте 85 т·м у КС-55713-1К «Клинцы». Смена такого крана в МОСКРАН-СЕРВИС стоит 20 800 ₽. Ниже — массы блоков, расчёт на примере и границы, за которыми нужен кран крупнее.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="massy" style="margin:36px 0 16px">Сколько весят блоки ФБС</h2>
    <p>ГОСТ 13579-2018 задаёт для блока ФБС из тяжёлого бетона справочную массу от 0,35 до 1,96 т в зависимости от длины и толщины. Стандарт введён с 01.05.2019 взамен ГОСТ 13579-78, и МОСКРАН-СЕРВИС подбирает кран именно по его таблице, а не по массам из старых прайс-листов. Высота всех блоков ряда одна — 580 мм, ширина стены 300–600 мм.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Блок</th><th>Длина × ширина × высота, мм</th><th>Масса, т</th></tr></thead>
        <tbody>
          <tr><td>ФБС 24.6.6-Т</td><td>2380 × 600 × 580</td><td>1,96</td></tr>
          <tr><td>ФБС 24.5.6-Т</td><td>2380 × 500 × 580</td><td>1,63</td></tr>
          <tr><td>ФБС 24.4.6-Т</td><td>2380 × 400 × 580</td><td>1,30</td></tr>
          <tr><td>ФБС 24.3.6-Т</td><td>2380 × 300 × 580</td><td>0,97</td></tr>
          <tr><td>ФБС 12.6.6-Т</td><td>1180 × 600 × 580</td><td>0,96</td></tr>
          <tr><td>ФБС 12.4.6-Т</td><td>1180 × 400 × 580</td><td>0,64</td></tr>
          <tr><td>ФБС 9.6.6-Т</td><td>880 × 600 × 580</td><td>0,70</td></tr>
          <tr><td>ФБС 9.3.6-Т</td><td>880 × 300 × 580</td><td>0,35</td></tr>
        </tbody>
      </table>
    </div>
    <p>Массы в таблице даны для тяжёлого бетона плотностью 2400 кг/м³ (индекс «Т»). Блок из лёгкого бетона легче, и МОСКРАН-СЕРВИС просит заказчика назвать марку из накладной поставщика, чтобы не считать вылет по завышенной или заниженной массе.</p>

    <h2 id="primer" style="margin:36px 0 16px">Пример: подвал дома 10 × 12 м</h2>
    <p>Периметр подвала 10 × 12 м — 44 м. Один ряд собирается из 18 блоков ФБС 24.6.6 и одного ФБС 12.6.6: 18 × 2,38 м + 1,18 м даёт 44,0 м без швов. Масса ряда — 18 × 1,96 т + 0,96 т = 36,24 т. Четыре ряда по 580 мм дают стену высотой около 2,3 м и 145 т блоков за монтаж; МОСКРАН-СЕРВИС считает такой объём как расчётный, реальный зависит от проекта заказчика.</p>
    <p>Самый тяжёлый подъём в примере — один блок 1,96 т. Кран на 25 т берёт его сотни раз подряд, поэтому решает не тоннаж, а вылет до дальней точки траншеи. Если кран стоит в 6 м от стены дома длиной 12 м, дальний угол лежит примерно в 18 м от оси вращения; МОСКРАН-СЕРВИС проверяет этот вылет по паспортной таблице выбранной машины.</p>

    <h2 id="vylet" style="margin:36px 0 16px">Вылет и грузовой момент</h2>
    <p>Грузовой момент блока — это его масса, умноженная на вылет: 1,96 т × 12 м = 23,5 т·м, а на вылете 18 м — 35,3 т·м. У КС-55713-1К «Клинцы» и «Ивановца» КС-45717К-1Р паспортный момент 85 т·м, то есть запас по моменту в 2,4 раза и больше. МОСКРАН-СЕРВИС при этом напоминает: момент — верхняя оценка, а допустимую массу на конкретном вылете называет только таблица паспорта.</p>
    <p>Кран на 50 т МОСКРАН-СЕРВИС предлагает в двух случаях: когда дальний блок лежит за пределами таблицы 25-тонной машины или когда ради вылета нельзя поставить кран на опоры ближе. Разница в цене велика — 31 200 ₽ за смену против 20 800 ₽, поэтому сначала проверяем возможность подъехать ближе. Как читать таблицу, показано в <a href="/spravochnik/gruzovysotnaya-harakteristika/" style="color:var(--yellow)">материале о грузовысотной характеристике</a>, а выбор между классами — в <a href="/spravochnik/avtokran-25-ili-50-tonn/" style="color:var(--yellow)">сравнении 25 и 50 тонн</a>.</p>

    <h2 id="norma" style="margin:36px 0 16px">Что требует ФНП №461</h2>
    <p>ФНП №461 в ред. от 16.04.2026 требует ставить стреловой кран на все выносные опоры на подготовленной площадке (п. 108–110) и не подходить к строению ближе 1 м поворотной частью. Для котлована это значит, что опоры не должны опираться на свежую засыпку и бровку траншеи. МОСКРАН-СЕРВИС до выезда просит фото площадки и проверяет, что основание выдержит нагрузку; расчёт основания разобран в <a href="/spravochnik/nesushchaya-sposobnost-grunta/" style="color:var(--yellow)">материале о несущей способности грунта</a> и в <a href="/spravochnik/rasstoyanie-ot-kotlovana/" style="color:var(--yellow)">материале о расстоянии от котлована</a>.</p>
    <p>Пункт 114 ФНП №461 запрещает перемещать груз над людьми и допускает стропальщику подходить к грузу, опущенному не выше 1 м; при перемещении груз проходит не ниже 0,5 м над встречающимися предметами. Для ФБС это порядок: стропальщик зацепляет блок на земле, отходит от траектории, крановщик подаёт блок в траншею над свободной зоной. Схемы строповки блоков МОСКРАН-СЕРВИС описывает в <a href="/spravochnik/shemy-stropovki-gruzov/" style="color:var(--yellow)">материале о схемах строповки</a>.</p>

    <h2 id="stoimost" style="margin:36px 0 16px">Сколько стоит смена</h2>
    <p>Смена крана на 25 т в МОСКРАН-СЕРВИС стоит 20 800 ₽ (2 600 ₽ в час, 8 часов). Кран на 32 т — 24 800 ₽ за смену, кран на 50 т — 31 200 ₽. Для подвала из примера смены 25-тонника обычно достаточно для монтажа нескольких рядов, точное число рядов за смену зависит от подготовки площадки и работы стропальщиков. МОСКРАН-СЕРВИС не обещает срок заранее и называет его после схемы объекта.</p>
    <p>Чтобы не платить за простой, заказчик заранее завозит блоки в зону досягаемости стрелы, выставляет стропальщиков и убирает препятствия с трассы подачи. Простой техники оплачивается по правилам договора, подробности — в <a href="/spravochnik/prostoy-tehniki-oplata/" style="color:var(--yellow)">материале об оплате простоя</a>; рассчитать стоимость можно в <a href="/uslugi/arenda-avtokrana-16-25-tonn/" style="color:var(--yellow)">разделе об аренде автокрана 16–25 тонн</a>.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: монтаж ФБС автокраном</h2>
    <ul>
      <li>ФБС 24.6.6 — 1,96 т, ФБС 12.6.6 — 0,96 т, ФБС 9.6.6 — 0,70 т (ГОСТ 13579-2018, тяжёлый бетон).</li>
      <li>Подвал 10 × 12 м: 18 ФБС 24.6.6 + 1 ФБС 12.6.6 в ряду, 36,24 т на ряд, около 145 т на 4 ряда.</li>
      <li>Момент блока 1,96 т на вылете 18 м — 35,3 т·м против 85 т·м у 25-тонника; решает таблица паспорта.</li>
      <li>Смена 25 т — 20 800 ₽, 32 т — 24 800 ₽, 50 т — 31 200 ₽ в МОСКРАН-СЕРВИС.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://meganorm.ru/Data2/1/4293734/4293734186.htm" target="_blank" rel="noopener" style="color:var(--yellow)">ГОСТ 13579-2018 «Блоки бетонные для стен подвалов. Технические условия»</a> — размеры и справочная масса блоков ФБС, введён с 01.05.2019 взамен ГОСТ 13579-78.</li>
      <li><a href="https://sudact.ru/law/prikaz-rostekhnadzora-ot-26112020-n-461-ob/federalnye-normy-i-pravila-v/vi/ustanovka-ps-i-proizvodstvo-rabot/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461, раздел VI «Установка ПС и производство работ» (ред. от 16.04.2026)</a> — п. 108–110, 114.</li>
      <li><a href="https://www.avtocrane.by/katalog-produkcii/avtokrany-klincy/25-tonn/ks-55713-1k-klincy" target="_blank" rel="noopener" style="color:var(--yellow)">КС-55713-1К «Клинцы» — карточка официального дилера</a> — грузовой момент 85 т·м.</li>
      <li><a href="https://avtokran.ru/catalog/avtomobilnye-krany/avtokran-ivanovets-ks-45717k-1r/" target="_blank" rel="noopener" style="color:var(--yellow)">«Ивановец» КС-45717К-1Р — Ивановский машиностроительный завод «Автокран»</a> — грузовой момент 85 т·м, максимальный вылет 26,0 м.</li>
    </ul>
  </article>
  <section class="section wrap"><a class="btn" href="/#zayavka">Рассчитать смену и оставить заявку →</a></section>
</main>
</SpravochnikLayout>
