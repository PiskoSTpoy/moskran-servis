---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = "Замена каната автокрана: расчёт запаса по ФНП 461";
const description = "Канат на замену сверяют с паспортом и проверяют расчётом: запас Fo/S не ниже Zp — от 3,15 до 9,00 для подвижных канатов (пп. 191–193 ФНП №461).";

const CHECKED = '23.10.2026';
const PUBLISHED = '2026-10-23';
const SLUG = "zamena-kanata-avtokrana-raschet-zapasa-prochnosti-fnp-461";
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  { q: "Можно ли заменить канат крестовой свивки на канат односторонней свивки?", a: "Нет. Пункт 191 ФНП №461 прямо запрещает заменять стальные канаты крестовой свивки на канаты односторонней свивки. Тип свивки проверяют по сертификату до закупки, потому что расчёт запаса прочности эту ошибку не компенсирует." },
  { q: "Что делать, если в паспорте автокрана не указана группа механизма?", a: "Группу классификации механизма определяют расчётом по приложению №4 к ФНП №461: по классу использования и режиму нагружения (п. 193). Полученную группу затем используют для выбора Zp в таблице 4 приложения №1." },
  { q: "Как получить Fo, если в сертификате указано суммарное усилие проволок?", a: "Суммарное разрывное усилие проволок умножают на 0,83 (п. 193 ФНП №461). Например, 110 000 Н даёт Fo = 91 300 Н. Если в сертификате дано усилие каната в целом, коэффициент 0,83 не применяют." },
  { q: "Что обязательно сделать после замены каната на автокране?", a: "Проверить запасовку и крепление концов, обтянуть канат грузом по паспортной номинальной грузоподъёмности и записать это в паспорт (п. 191). Запись делает инженерно-технический работник, ответственный за содержание ПС в работоспособном состоянии." },
  { q: "Годится ли импортный канат для замены?", a: "Да, если он подходит по назначению и технологии использования, диаметр равен диаметру заменяемого, а коэффициент использования по разрывному усилию не ниже нормативного для группы механизма (п. 191 ФНП №461). Сертификат нужен и на импортный канат." },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: "Замена каната автокрана: расчёт запаса прочности", item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ["trebovaniya", "Что должен подтвердить новый канат по п. 191"],
  ["raschet", "Расчёт запаса по п. 193"],
  ["tablitsa", "Значения Zp из таблицы 4 приложения №1"],
  ["posle", "Что делают после замены или перепасовки"],
  ["faq", "Частые вопросы"],
  ["istochniki", "Источники"],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Замена каната автокрана: расчёт запаса прочности</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">ФНП №461 · Канаты</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Как проверить канат автокрана при замене: расчёт запаса прочности?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>23.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>23.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>6 мин чтения</span>
    </div>

    <p>Канат, который ставят вместо изношенного, обязан совпасть с паспортом крана по назначению, длине и диаметру и иметь сертификат изготовителя (п. 191 ФНП №461). Запас прочности проверяют расчётом по п. 193: разрывное усилие Fo из сертификата сопоставляют с наибольшим натяжением ветви S из паспорта и минимальным коэффициентом Zp. МОСКРАН-СЕРВИС просит заказчика подтвердить эти три числа до выезда крана.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="trebovaniya" style="margin:36px 0 16px">Что должен подтвердить новый канат по п. 191</h2>
    <p>Новый канат сверяют с паспортом по трём параметрам — назначение, длина, диаметр, — а запас по разрывному усилию должен быть не ниже, чем положен группе режима механизма (п. 191 ФНП №461). Вторая безусловная часть требования — сертификат завода-изготовителя: канат без него на подъёмное сооружение не ставят. Для автокрана КС-55713 «Клинцы» паспорт и сертификат нужны оба: паспорт задаёт параметры, сертификат подтверждает прочность.</p>
    <p>Канат зарубежного производства разрешён, если он подходит по назначению и технологии использования ПС, диаметр равен диаметру заменяемого, а коэффициент использования по разрывному усилию не ниже нормативного для группы механизма. Заменять канат крестовой свивки на канат односторонней свивки запрещено. МОСКРАН-СЕРВИС проверяет тип свивки по сертификату раньше, чем сравнивает диаметры, потому что ошибка в свивке не исправляется расчётом. Браковку каната в работе разбирает справка о <a href="/spravochnik/brakovka-kanatov/" style="color:var(--yellow)">браковке канатов</a>.</p>

    <h2 id="raschet" style="margin:36px 0 16px">Расчёт запаса по п. 193</h2>
    <p>Соответствие коэффициента использования выбранного каната проверяют расчётом по формуле п. 193 ФНП №461, в которую входят три величины. Fo — разрывное усилие каната в целом в ньютонах по сертификату или свидетельству об испытании. Zp — минимальный коэффициент использования (запас прочности) из таблицы приложения №1 в зависимости от группы классификации механизма. S — наибольшее натяжение ветви каната в ньютонах, указанное в паспорте крана. Смысл проверки: отношение Fo к S не должно быть меньше Zp.</p>
    <p>Когда сертификат даёт только сумму разрывных усилий отдельных проволок, Fo получают умножением этой суммы на 0,83 (п. 193). МОСКРАН-СЕРВИС напоминает: коэффициент 0,83 применяют только к суммарному усилию проволок, а цифру «в целом» из сертификата умножать на него нельзя.</p>
    <p>Пример с условными числами (арифметика, а не данные конкретного крана). Пусть S по паспорту равно 20 000 Н, механизм подъёма относится к группе M5, канат подвижный: Zp равно 4,50, значит Fo должно быть не меньше 90 000 Н. Сертификат даёт суммарное усилие проволок 110 000 Н: 110 000 × 0,83 = 91 300 Н, канат проходит. Для группы M6 (Zp = 5,60) требовалось бы не менее 112 000 Н, и тот же канат не подошёл бы.</p>

    <h2 id="tablitsa" style="margin:36px 0 16px">Значения Zp из таблицы 4 приложения №1</h2>
    <p>Таблица 4 приложения №1 к ФНП №461 задаёт минимальные значения Zp отдельно для подвижных и неподвижных канатов в зависимости от группы классификации механизма M1–M8. Группу берут из паспорта ПС; если её там нет, определяют расчётом по приложению №4. МОСКРАН-СЕРВИС при подготовке замены каната на КС-65713-1 «Галичанин» первым делом выписывает группу механизма из паспорта.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Группа механизма</th><th>Zp, подвижные канаты</th><th>Zp, неподвижные канаты</th></tr></thead>
        <tbody>
          <tr><td>M1</td><td>3,15</td><td>2,50</td></tr>
          <tr><td>M2</td><td>3,35</td><td>2,50</td></tr>
          <tr><td>M3</td><td>3,55</td><td>3,00</td></tr>
          <tr><td>M4</td><td>4,00</td><td>3,50</td></tr>
          <tr><td>M5</td><td>4,50</td><td>4,00</td></tr>
          <tr><td>M6</td><td>5,60</td><td>4,50</td></tr>
          <tr><td>M7</td><td>7,10</td><td>5,00</td></tr>
          <tr><td>M8</td><td>9,00</td><td>5,00</td></tr>
        </tbody>
      </table>
    </div>
    <p>Разрыв между подвижными и неподвижными канатами растёт с группой: у M1 он равен 0,65, у M8 — 4,00. Ошибка в группе механизма поэтому сильнее всего бьёт по подвижным (грузовым) канатам. Связь группы и режима работы объясняет справка о <a href="/spravochnik/gruppa-rezhima-krana/" style="color:var(--yellow)">группе режима крана</a>.</p>

    <h2 id="posle" style="margin:36px 0 16px">Что делают после замены или перепасовки</h2>
    <p>Замена грузового, стрелового или любого другого каната и любая перепасовка заканчиваются двумя действиями (п. 191 ФНП №461). Сначала смотрят, верно ли канат заведён в полиспаст и надёжно ли закреплены концы. Затем его обтягивают грузом, равным номинальной грузоподъёмности по паспорту. Результат вносит в паспорт инженерно-технический работник, который отвечает за исправное состояние крана. МОСКРАН-СЕРВИС не выпускает автокран на объект, пока запись в <a href="/spravochnik/pasport-krana/" style="color:var(--yellow)">паспорте крана</a> не сделана.</p>
    <p>Крепление каната при замене должно соответствовать ранее принятой конструкции (п. 192 ФНП №461): другой тип заделки конца без согласованного решения недопустим. Цепи на ПС подчиняются тем же принципам (п. 195): сертификат, марка и разрывное усилие по паспорту, коэффициент запаса при замене пластинчатых цепей не менее 3 для групп M1–M2 и не менее 5 для остальных, сварных грузовых — не менее 3 для M1–M2, не менее 6 на гладком барабане и не менее 8 для калиброванных цепей на звёздочке.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: замена каната по пп. 191–193</h2>
    <ul>
      <li>Новый канат должен совпасть с паспортом по назначению, длине, диаметру и иметь сертификат изготовителя (п. 191 ФНП №461).</li>
      <li>Запас проверяют расчётом: Fo из сертификата, S из паспорта, Zp из таблицы 4 приложения №1; отношение Fo/S не ниже Zp (п. 193).</li>
      <li>Суммарное усилие проволок умножают на 0,83, чтобы получить Fo (п. 193).</li>
      <li>После замены — проверка запасовки, обтяжка паспортным грузом и запись ИТР в паспорте; МОСКРАН-СЕРВИС не выпускает кран без неё.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://www.consultant.ru/document/cons_doc_LAW_373321/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 (приказ Ростехнадзора от 26.11.2020 №461)</a> — пп. 191–193, 195 (замена канатов и цепей), приложение №1 (таблица 4, значения Zp), приложение №4.</li>
      <li><a href="https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 на legalacts.ru</a> — редакция от 16.04.2026, текст сверен 23.10.2026.</li>
    </ul>
    <p class="small muted">Пример с S = 20 000 Н и сертификатом 110 000 Н — арифметическая иллюстрация, а не данные конкретного крана; формула п. 193 в текстовой версии приведена картинкой, поэтому её смысл (Fo/S не ниже Zp) дан по определениям величин в самом пункте.</p>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-16-25-tonn/">Аренда автокрана 16–25 тонн →</a></section>
</main>
</SpravochnikLayout>
