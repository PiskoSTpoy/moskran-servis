---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = "Сигналы стропальщика и крановщика: пп. 248–250 ФНП 461";
const description = "Порядок сигналов стропальщика и крановщика устанавливает эксплуатирующая организация; при смене участка нужен инструктаж под подпись (пп. 248–249 ФНП №461).";

const CHECKED = '19.10.2026';
const PUBLISHED = '2026-10-19';
const SLUG = "znakovaya-signalizaciya-stropalshchik-kranovshchik-fnp-461";
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: "Кто определяет порядок сигналов между стропальщиком и крановщиком?",
    a: "Эксплуатирующая организация (п. 248 ФНП №461). Знаки и сигналы при радиосвязи записывают в производственные инструкции крановщика и стропальщика. МОСКРАН-СЕРВИС сверяет эти инструкции с заказчиком.",
  },
  {
    q: "Где приведена знаковая сигнализация для стропальщика?",
    a: "В приложении №7 к ФНП №461 (п. 248). МОСКРАН-СЕРВИС выдаёт стропальщику заказчика памятку по этому приложению.",
  },
  {
    q: "Нужно ли инструктировать стропальщика, если участок работ сменился?",
    a: "Да, крановщиков и стропальщиков инструктируют под подпись о сигнализации на новом участке (п. 249 ФНП №461). МОСКРАН-СЕРВИС оформляет подпись до первого подъёма.",
  },
  {
    q: "Чем связь при подъёме людей отличается от обычной сигнализации?",
    a: "При перемещении людей в люльке краном нужна постоянная двусторонняя радио- или телефонная связь (п. 241 «з» ФНП №461); одной знаковой сигнализации недостаточно. МОСКРАН-СЕРВИС этого требования не обходит.",
  },
  {
    q: "Правило п. 250 про 10 и 22 метра относится к автокрану?",
    a: "Нет, п. 250 говорит о работе подъёмника с люлькой: до 10 м голос, выше 10 м знаки, выше 22 м радио или телефон. Для крана с людьми действует п. 241 «з».",
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: "Знаковая сигнализация стропальщика и крановщика по ФНП №461", item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ["poryadok", "Порядок обмена сигналами по п. 248"],
  ["novyy", "Смена участка работы по п. 249"],
  ["lyudi", "Связь при подъёме людей: п. 241 и п. 250"],
  ["sravnenie", "Сравнение способов связи"],
  ["moskva", "Две бригады на одной площадке"],
  ["faq", "Частые вопросы"],
  ["istochniki", "Источники"],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Знаковая сигнализация стропальщика и крановщика по ФНП №461</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">ФНП №461 · Система сигнализации</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Кто устанавливает порядок сигналов между стропальщиком и крановщиком?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>19.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>19.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>5 мин чтения</span>
    </div>

    <p>П. 248 ФНП №461 возлагает на эксплуатирующую организацию установление порядка обмена сигналами между стропальщиками и крановщиками. Знаки и радиосигналы вносят в производственные инструкции обеих профессий, а при смене участка работы людей инструктируют под подпись (п. 249). МОСКРАН-СЕРВИС проводит такой инструктаж у каждого нового заказчика.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="poryadok" style="margin:36px 0 16px">Порядок обмена сигналами по п. 248</h2>
    <p>Эксплуатирующая организация обязана установить порядок обмена сигналами между стропальщиками и крановщиками (п. 248 ФНП №461). Знаковую сигнализацию и систему сигналов при радиопереговорной связи вносят в производственные инструкции крановщиков и стропальщиков. Знаки для обеих профессий приведены в приложении №7 к ФНП. МОСКРАН-СЕРВИС при аренде автокрана КС-55713 «Клинцы» сверяет, что у стропальщика заказчика та же система знаков, что у крановщика.</p>
    <p>Норма не оставляет выбор «как договоримся на месте»: порядок фиксируют документом организации. Распределение ролей между собственником крана и заказчиком разобрано в материале об <a href="/spravochnik/obyazannosti-organizacii-pri-vydelenii-avtokrana/" style="color:var(--yellow)">обязанностях организации при выделении автокрана</a>. МОСКРАН-СЕРВИС просит указать в заявке, чья инструкция по сигналам действует на площадке.</p>


    <h2 id="novyy" style="margin:36px 0 16px">Смена участка работы по п. 249</h2>
    <p>При смене участка работы крановщиков и стропальщиков инструктируют под подпись о знаковой сигнализации, применяемой на новом участке (п. 249 ФНП №461). Если на соседних площадках приняты разные сигналы, привычка с прошлого места становится источником ошибки. Подпись в листе инструктажа — документ, который фиксирует, что сигналы согласованы. МОСКРАН-СЕРВИС не начинает работу на новом участке без неё.</p>


    <h2 id="lyudi" style="margin:36px 0 16px">Связь при подъёме людей: п. 241 и п. 250</h2>
    <p>При перемещении людей в люльке краном между крановщиком и людьми должна быть обеспечена постоянная двусторонняя радио- или телефонная связь, а порядок обмена сигналами устанавливает распорядительный акт эксплуатирующей организации по приложению №6 (п. 241 «з» ФНП №461). Знаковой сигнализации для этого случая недостаточно. МОСКРАН-СЕРВИС проверяет рации до подъёма человека.</p>
    <p>Не путайте с п. 250: он относится к работе подъёмника с люлькой. Связь там непрерывная: до 10 м подъёма — голосом, свыше 10 м — знаковой сигнализацией, свыше 22 м — радио или телефоном. Автокран КС-55713 «Клинцы» подъёмником не является, поэтому для него действует п. 241 «з». Условия самой люльки — в справке о <a href="/spravochnik/lyulka-dlya-podema-lyudey-krana-stropy-i-usloviya-fnp-461/" style="color:var(--yellow)">люльке для подъёма людей</a>.</p>


    <h2 id="sravnenie" style="margin:36px 0 16px">Сравнение способов связи</h2>
    <p>Способ связи зависит от того, что поднимают и чем. Ниже — сводка пунктов ФНП №461, которую МОСКРАН-СЕРВИС использует при планировании работ.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Ситуация</th><th>Способ связи</th><th>Пункт</th></tr></thead>
        <tbody>
          <tr><td>Стропальщик и крановщик на площадке</td><td>порядок задаёт организация: знаки по приложению №7 или радиосигналы по инструкции</td><td>п. 248</td></tr>
          <tr><td>Новый участок работы</td><td>инструктаж под подпись о сигнализации участка</td><td>п. 249</td></tr>
          <tr><td>Кран поднимает людей в люльке</td><td>постоянная двусторонняя радио- или телефонная связь</td><td>п. 241 «з»</td></tr>
          <tr><td>Подъёмник с люлькой, высота до 10 м</td><td>голос</td><td>п. 250</td></tr>
          <tr><td>Подъёмник с люлькой, выше 10 м</td><td>знаковая сигнализация (приложение №6)</td><td>п. 250</td></tr>
          <tr><td>Подъёмник с люлькой, выше 22 м</td><td>радио- или телефонная связь</td><td>п. 250</td></tr>
        </tbody>
      </table>
    </div>
    <p>Сигнальщик, назначаемый при непросматриваемой зоне, — отдельный случай; его условия описаны в материале о <a href="/spravochnik/signalshchik-pri-rabote-avtokrana-fnp-461/" style="color:var(--yellow)">сигнальщике при работе автокрана</a>. МОСКРАН-СЕРВИС рассматривает сигнальщика и общий порядок сигналов как два разных документа.</p>


    <h2 id="moskva" style="margin:36px 0 16px">Две бригады на одной площадке</h2>
    <p>Практика МОСКРАН-СЕРВИС, а не отдельная норма: на московской стройке с несколькими подрядчиками стропальщики часто приходят от разных организаций. Перед подачей автокрана КС-55713 «Клинцы» мы просим выдать общий лист знаков по приложению №7 и собрать подписи всех стропальщиков смены. Это закрывает п. 249 и исключает ситуацию, в которой разные бригады подают разные жесты.</p>


    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: сигналы стропальщика и крановщика</h2>
    <ul>
      <li>МОСКРАН-СЕРВИС исходит из п. 248 ФНП №461: порядок сигналов устанавливает эксплуатирующая организация, знаки — по приложению №7.</li>
      <li>При смене участка крановщиков и стропальщиков инструктируют под подпись (п. 249).</li>
      <li>Подъём людей краном требует постоянной двусторонней радио- или телефонной связи (п. 241 «з»).</li>
      <li>Правило 10 и 22 метров из п. 250 относится к подъёмнику с люлькой, а не к автокрану.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://www.consultant.ru/document/cons_doc_LAW_373321/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 (приказ Ростехнадзора от 26.11.2020 №461)</a> — пп. 241, 248–250 и приложения №6–7 (система сигнализации, инструктаж при смене участка, связь при подъёме людей).</li>
      <li><a href="https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 на legalacts.ru</a> — редакция от 16.04.2026, текст пунктов 241 и 248–250 сверен 19.10.2026.</li>
    </ul>
    <p class="small muted">Описание подрядных бригад на московской площадке — практика МОСКРАН-СЕРВИС, а не пункт нормы; сами знаки приложения №7 в справке не воспроизводятся.</p>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-16-25-tonn/">Аренда автокрана 16–25 тонн →</a></section>
</main>
</SpravochnikLayout>
