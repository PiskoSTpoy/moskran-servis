---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = 'Когда автокран не допускают к работе: п. 251 ФНП №461';
const description = 'Пункт 251 ФНП №461 называет 13 оснований, при которых кран нельзя допускать в работу: от неаттестованного персонала до трещин металлоконструкций.';

const CHECKED = '11.10.2026';
const PUBLISHED = '2026-10-11';
const SLUG = 'kogda-avtokran-ne-dopuskayut-k-rabote-fnp-461';
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: 'В каких случаях автокран нельзя допускать к работе?',
    a: 'Пункт 251 ФНП №461 перечисляет 13 оснований, от «а» до «н»: неаттестованный персонал, не назначенные ответственные, не пройденное освидетельствование, невыполненные предписания, технические неисправности, отсутствие стропов и тары, ППР и наряда-допуска, паспорта, а также несоответствие технологии, среде и основанию. При любом из них МОСКРАН-СЕРВИС работу не начинает.',
  },
  {
    q: 'Кто решает, что кран нельзя допускать к работе?',
    a: 'Эксплуатирующая организация, то есть владелец крана. Пункт 251 ФНП №461 адресован ей: она «не должна допускать ПС в работу», если при проверке установлено любое из перечисленных нарушений. МОСКРАН-СЕРВИС останавливает подъём и сообщает причину заказчику в письменном виде.',
  },
  {
    q: 'Что считается технической неисправностью по п. 251?',
    a: 'Подпункт «д» называет трещины и остаточные деформации металлоконструкций сверх допустимых пределов, ослабление креплений, неработоспособные ограничители, регистраторы, блокировки и заземление, недопустимый износ крюков, канатов, цепей, механизмов и тормозов, а также неисправности системы управления и опорных элементов. Конкретные пределы берут из паспорта и руководства по эксплуатации крана.',
  },
  {
    q: 'Можно ли работать без ППР или наряда-допуска?',
    a: 'В случаях, где ФНП №461 их требует, нельзя. Подпункт «ж» п. 251 относит отсутствие ППР, технологических карт и нарядов-допусков к основаниям не допускать кран, а подпункт «з» — невыполнение мероприятий из них. МОСКРАН-СЕРВИС запрашивает ППР и наряд-допуск до выезда крана.',
  },
  {
    q: 'Что проверяют, если кран стоит над перекрытием или рядом с котлованом?',
    a: 'Подпункт «н» п. 251 относит к основаниям недопустимые дефекты зданий, сооружений и конструкций, воспринимающих нагрузку от крана: трещины, деформации, разрушения свыше допустимых величин из проекта. Если проекта нет, применяют нормы ФНП №461. МОСКРАН-СЕРВИС просит у заказчика сведения об основании под опорами.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Когда автокран не допускают к работе', item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ['gruppy', '13 оснований п. 251: пять групп'],
  ['personal', 'Персонал и ответственные: подпункты «а» и «б»'],
  ['dokumenty', 'Документы, предписания и ППР: «в», «г», «ж», «з», «и»'],
  ['neispravnosti', 'Неисправности крана и оснастки: «д» и «е»'],
  ['usloviya', 'Технология, среда и основание: «к», «л», «м», «н»'],
  ['do-vyezda', 'Что передать до выезда крана'],
  ['faq', 'Частые вопросы'],
  ['istochniki', 'Источники'],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Когда автокран не допускают к работе</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">ФНП №461 · Допуск крана в работу</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">В каких случаях автокран нельзя допускать к работе по ФНП №461?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>11.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>11.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>7 мин чтения</span>
    </div>

    <p>Пункт 251 ФНП №461 содержит 13 оснований (подпункты «а»–«н»), при которых эксплуатирующая организация не должна допускать подъёмное сооружение в работу: от неаттестованного персонала и отсутствия ППР до трещин в металлоконструкциях и дефектов основания. МОСКРАН-СЕРВИС использует этот список как контрольный: если хотя бы одно основание подтверждено, подъём не начинают, пока оно не устранено.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="gruppy" style="margin:36px 0 16px">13 оснований п. 251: пять групп</h2>
    <p>Подпункты п. 251 ФНП №461 удобно читать по группам: кто работает, какие документы есть, в каком состоянии кран и оснастка, соответствует ли кран работе и месту. МОСКРАН-СЕРВИС раскладывает все 13 оснований в такую таблицу, чтобы заказчик видел, что именно проверяют до выезда.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Группа</th><th>Подпункты</th><th>Суть</th></tr></thead>
        <tbody>
          <tr><td>Персонал</td><td>«а», «б»</td><td>аттестация, три ответственных ИТР</td></tr>
          <tr><td>Документы</td><td>«в», «г», «ж», «з», «и»</td><td>освидетельствование, предписания, ППР, паспорт</td></tr>
          <tr><td>Состояние</td><td>«д», «е»</td><td>неисправности, стропы и тара</td></tr>
          <tr><td>Работа и среда</td><td>«к», «л», «м»</td><td>нарушения, технология, регион</td></tr>
          <tr><td>Основание</td><td>«н»</td><td>дефекты зданий и конструкций</td></tr>
        </tbody>
      </table>
    </div>
    <p>Пункт 251 адресован эксплуатирующей организации, то есть владельцу крана, а не заказчику. Тем не менее половина оснований зависит от заказчика: ППР, наряд-допуск, состояние основания, стропы на площадке. Кто готовит ППР, фиксируется в договоре аренды; формы договора разобраны в материале об <a href="/spravochnik/arenda-s-ekipazhem-i-bez/" style="color:var(--yellow)">аренде с экипажем и без</a>.</p>

    <h2 id="personal" style="margin:36px 0 16px">Персонал и ответственные: подпункты «а» и «б»</h2>
    <p>Подпункт «а» п. 251 запрещает допускать кран, если им управляет неаттестованный персонал. Подпункт «б» добавляет требование: должен быть назначен каждый из трёх инженерно-технических работников — ответственный за производственный контроль, ответственный за содержание ПС в работоспособном состоянии и ответственный за безопасное производство работ. МОСКРАН-СЕРВИС проверяет назначение по приказу, а не по устному заверению.</p>
    <p>Аттестация крановщика и стропальщика подтверждается удостоверением и протоколом проверки знаний; порядок описан в материалах об <a href="/spravochnik/attestaciya-kranovshchika/" style="color:var(--yellow)">аттестации крановщика</a> и <a href="/spravochnik/otvetstvennyy-za-bezopasnoe-proizvodstvo/" style="color:var(--yellow)">ответственном за безопасное производство работ</a>. Если ответственный на площадке заказчика не назначен, МОСКРАН-СЕРВИС просит оформить приказ до выезда крана.</p>

    <h2 id="dokumenty" style="margin:36px 0 16px">Документы, предписания и ППР: «в», «г», «ж», «з», «и»</h2>
    <p>Пять подпунктов п. 251 ФНП №461 касаются бумаг и исполнения. Не проведено техническое освидетельствование или экспертиза промышленной безопасности — «в»; не выполнены предписания органов надзора — «г»; нет ППР, технологических карт и нарядов-допусков там, где они требуются, — «ж»; не выполнены мероприятия из них — «з»; нет паспорта или руководства по эксплуатации — «и». МОСКРАН-СЕРВИС возит копии паспорта и документов освидетельствования на каждый выезд.</p>
    <p>Подпункты «ж» и «з» различаются: «ж» про наличие документа, «з» про выполнение его требований на площадке. Кран с ППР в папке, но с нарушенной схемой стоянки не допускается по «з». Содержание ППР описано в материале о <a href="/spravochnik/ppr-dlya-krana/" style="color:var(--yellow)">ППР для крана</a>, а сроки освидетельствования — в материале о <a href="/spravochnik/tehnicheskoe-osvidetelstvovanie-krana/" style="color:var(--yellow)">техническом освидетельствовании</a>.</p>

    <h2 id="neispravnosti" style="margin:36px 0 16px">Неисправности крана и оснастки: «д» и «е»</h2>
    <p>Подпункт «д» п. 251 ФНП №461 содержит самый длинный перечень неисправностей. В нём трещины или остаточные деформации металлоконструкций выше допустимых, ослабление креплений в соединениях, неработоспособные заземление, гидро- и электрооборудование, указатели, ограничители, регистраторы, блокировки и защиты, а также недопустимый износ крюков, колёс, канатов, цепей, механизмов и тормозов. Отдельной строкой стоят система управления, противоугонные захваты, рельсовый путь и тупиковые упоры.</p>
    <p>Для автокрана МОСКРАН-СЕРВИС практически важны ограничитель грузоподъёмности, тормоза, канаты и крюк. Что делать, если неисправность выявлена на объекте, описано в материале о <a href="/spravochnik/neispravnost-krana-na-obekte/" style="color:var(--yellow)">неисправности крана на объекте</a>, а о приборе безопасности — в материале об <a href="/spravochnik/ogranichitel-gruzopodemnosti/" style="color:var(--yellow)">ограничителе грузоподъёмности</a>.</p>
    <p>Подпункт «е» относит к основаниям отсутствие или неработоспособность стропов и тары, соответствующих массе и виду груза. Сроки осмотра этой оснастки собраны в материале об <a href="/spravochnik/osmotr-stropov-i-traverc-fnp-461/" style="color:var(--yellow)">осмотре стропов и траверс</a>; МОСКРАН-СЕРВИС не начинает подъём, если стропа под массу груза нет в наличии.</p>

    <h2 id="usloviya" style="margin:36px 0 16px">Технология, среда и основание: «к», «л», «м», «н»</h2>
    <p>Четыре последних подпункта п. 251 ФНП №461 оценивают, подходит ли кран к работе и месту. «К» — работы ведутся с нарушениями ФНП, ППР, технологических карт и инструкций; «л» — кран не соответствует технологическому процессу; «м» — не соответствует параметрам среды и региона (температура, ветровой район, сейсмичность); «н» — здания и конструкции, воспринимающие нагрузку, имеют недопустимые дефекты. МОСКРАН-СЕРВИС сверяет эти пункты с ППР и состоянием площадки.</p>
    <p>Подпункт «н» чаще всего касается автокрана на перекрытии подвала, плите паркинга или у бровки котлована. Допустимые величины дефектов берут из проектной документации здания; если проекта нет, применяют нормы ФНП №461. Для грунта и котлована смотрите материалы о <a href="/spravochnik/nesushchaya-sposobnost-grunta/" style="color:var(--yellow)">несущей способности грунта</a> и <a href="/spravochnik/rasstoyanie-ot-kotlovana/" style="color:var(--yellow)">расстоянии от котлована</a>. Ветер как основание остановки разобран в материале <a href="/spravochnik/rabota-krana-pri-silnom-vetre/" style="color:var(--yellow)">о работе при сильном ветре</a>.</p>

    <h2 id="do-vyezda" style="margin:36px 0 16px">Что передать до выезда крана</h2>
    <p>Чтобы подъём не остановили по п. 251, МОСКРАН-СЕРВИС просит заказчика до выезда крана подтвердить шесть вещей:</p>
    <ol>
      <li>Приказ или копия приказа о назначении ответственного за безопасное производство работ на площадке МОСКРАН-СЕРВИС.</li>
      <li>ППР или технологическая карта со схемой стоянки крана и зоной работ, если они требуются по ФНП №461.</li>
      <li>Наряд-допуск на работы в охранной зоне ЛЭП, газопровода или иных сетей, если площадка в такой зоне.</li>
      <li>Сведения об основании под опорами: плита, перекрытие, грунт, наличие подземных коммуникаций и котлована.</li>
      <li>Массу груза по накладной и перечень стропов, которые подготовил заказчик, для проверки МОСКРАН-СЕРВИС.</li>
      <li>Контакт ответственного на площадке, который может остановить или возобновить работу по решению МОСКРАН-СЕРВИС.</li>
    </ol>
    <p>Перечень собран на основе подпунктов «б», «ж», «з», «н» и «е» п. 251; это практика МОСКРАН-СЕРВИС, а не форма из ФНП. Подача заявки описана в материале о <a href="/spravochnik/zayavka-na-avtokran/" style="color:var(--yellow)">заявке на автокран</a>.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: основания не допускать кран</h2>
    <ul>
      <li>Пункт 251 ФНП №461 содержит 13 оснований «а»–«н»; МОСКРАН-СЕРВИС не начинает подъём, пока выявленное основание не устранено.</li>
      <li>Неаттестованный персонал и не назначенный хотя бы один из трёх ответственных ИТР — основания «а» и «б».</li>
      <li>Нет ППР, нарядов-допусков или паспорта, либо не выполнены их требования, — основания «ж», «з», «и».</li>
      <li>Трещины, неработоспособные ограничители и тормоза, износ крюка и канатов — основание «д».</li>
      <li>Нет стропов и тары по массе груза — основание «е»; сроки осмотра оснастки указаны в п. 224.</li>
      <li>Дефекты основания под краном — подпункт «н»; нужны проект или нормы ФНП №461.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://www.consultant.ru/document/cons_doc_LAW_373321/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 (приказ Ростехнадзора от 26.11.2020 №461)</a> — п. 251: 13 оснований не допускать подъёмное сооружение в работу (подпункты «а»–«н»); п. 257 — экспертиза зданий и сооружений, на которые опирается кран.</li>
      <li><a href="https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 на legalacts.ru</a> — редакция от 16.04.2026, текст п. 251 сверен 11.10.2026.</li>
    </ul>
    <p class="small muted">Перечень «что передать до выезда» — практика МОСКРАН-СЕРВИС, построенная на подпунктах п. 251, а не форма из ФНП №461. Пределы неисправностей для конкретной машины определяет её паспорт и руководство по эксплуатации.</p>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-16-25-tonn/">Аренда автокрана 16–25 тонн →</a></section>
</main>
</SpravochnikLayout>
