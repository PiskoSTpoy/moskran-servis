const faqs = [
  {
    q: 'Автокран — это транспортное средство или самоходная машина? От этого зависит налог?',
    a: 'Для транспортного налога это не имеет значения: статья 358 НК РФ прямо включает в объект налогообложения не только автомобили, но и «другие самоходные машины и механизмы на пневматическом и гусеничном ходу», зарегистрированные в установленном порядке. Автокран подпадает под эту формулировку независимо от того, зарегистрирован ли он в ГИБДД как шасси или в Гостехнадзоре как самоходная машина — справочник писал об этой регистрации отдельно. Значение имеет мощность двигателя по паспорту, а не то, в каком реестре стоит машина.',
  },
  {
    q: 'Чем транспортный налог отличается от налогов, о которых справочник уже писал в статье про аренду с оператором?',
    a: 'Это разные налоги с разными объектами. Материал про налоги заказчика при аренде крана с оператором разбирал НДС и налог на прибыль — они считаются с выручки от договора аренды и платит их сторона, оказывающая услугу (или удерживающая НДС как налоговый агент, если применимо). Транспортный налог — региональный имущественный налог по главе 28 НК РФ, он не зависит от того, сдаётся кран в аренду или простаивает на базе: платит его тот, на кого кран зарегистрирован, просто по факту владения техникой.',
  },
  {
    q: 'Кто именно платит транспортный налог — владелец крана или арендатор?',
    a: 'Плательщик — то лицо, на которое кран зарегистрирован в реестре по состоянию на начало налогового периода, а не тот, кто фактически им пользуется в моменте. При стандартной аренде с экипажем, которую справочник тоже разбирал отдельно, кран числится за арендодателем-подрядчиком, и налог платит он. Переложить эту обязанность на заказчика договором нельзя — глава 28 НК РФ такого не допускает, а стороны вправе только договориться о компенсации расходов, что уже вопрос гражданско-правовых, а не налоговых отношений.',
  },
  {
    q: 'Что будет, если не заплатить транспортный налог за автокран вовремя?',
    a: 'За каждый день просрочки начисляются пени по статье 75 НК РФ, а за саму неуплату или неполную уплату — штраф по статье 122 НК РФ: 20% от неуплаченной суммы, а если налоговый орган докажет умысел — 40%. С 2021 года организации не подают декларации по транспортному налогу: инспекция сама считает сумму по данным о зарегистрированной технике и присылает организации сообщение об исчисленном налоге, но это не отменяет обязанности заплатить в срок и не спасает от пеней, если сумма в сообщении разошлась с тем, что организация ожидала.',
  },
];

