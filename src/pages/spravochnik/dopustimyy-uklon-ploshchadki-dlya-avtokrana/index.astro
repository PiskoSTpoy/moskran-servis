---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = 'Какой уклон площадки допустим для автокрана?';
const description = 'ФНП №461 (п. 111): уклон площадки не больше паспортного значения. В РЭ автокранов предел обычно 3°, около 5,2 %. Как измеряют и что делать при превышении.';

const CHECKED = '02.10.2026';
const PUBLISHED = '2026-10-02';
const SLUG = 'dopustimyy-uklon-ploshchadki-dlya-avtokrana';
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: 'Какой максимальный уклон площадки допустим для автокрана?',
    a: 'ФНП №461 в пункте 111 не называет единое число для всех кранов: установка запрещена на площадке с уклоном, превышающим значение из паспорта или руководства по эксплуатации конкретной машины. У большинства серийных автокранов, включая модели серии КС-55713 «Клинцы», этот предел в руководстве — 3°, то есть около 5,2 % уклона.',
  },
  {
    q: 'Чем измеряют уклон площадки перед установкой крана?',
    a: 'Крановщик МОСКРАН-СЕРВИС проверяет уклон кренометром, установленным на опорной раме автокрана, — маятниковым или электронным прибором с показанием в градусах. Измерение делают после того, как кран встал на колёса на предполагаемом месте, до выдвижения опор и подъёма груза.',
  },
  {
    q: 'Что будет, если поднимать груз на кране, стоящем с перекосом?',
    a: 'Уклон площадки в сторону груза добавляет опрокидывающий момент к ветровой нагрузке и инерционным силам, которые и так учитываются при расчёте устойчивости, — запас прочности сокращается быстрее, чем кажется по углу наклона. Как считается коэффициент устойчивости, разобрано в материале об устойчивости крана.',
  },
  {
    q: 'Можно ли выровнять площадку с уклоном подсыпкой?',
    a: 'Да: ФНП №461 (п. 108–110) допускает подготовку основания под опоры — срезку грунта или подсыпку с уплотнением до уклона в пределах паспортного значения. Отдельно под каждую опору на слабом грунте кладут подкладки; методика расчёта показана в материале о несущей способности грунта.',
  },
  {
    q: 'Предел уклона одинаковый у всех классов автокранов?',
    a: 'Нет — точное значение задаёт паспорт и руководство по эксплуатации конкретной модели, а не универсальная норма. МОСКРАН-СЕРВИС проверяет это значение по документам той машины, которая едет на объект, и не считает 3° гарантированным пределом для любого класса без сверки с РЭ.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Уклон площадки для автокрана', item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ['norma', 'Что требует ФНП №461'],
  ['predel', 'Предел 3 градуса в паспорте крана'],
  ['izmerenie', 'Как измеряют уклон'],
  ['posledstviya', 'Что будет при превышении'],
  ['vyravnivanie', 'Как выровнять площадку'],
  ['faq', 'Частые вопросы'],
  ['istochniki', 'Источники'],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Уклон площадки для автокрана</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Безопасность площадки · ФНП №461</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Какой уклон площадки допустим для автокрана?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>02.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>02.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>5 мин чтения</span>
    </div>

    <p>ФНП №461 в пункте 111 прямо запрещает ставить кран на площадке с уклоном больше значения из паспорта или руководства по эксплуатации машины. У серийных автокранов, включая модели серии «Клинцы», этот предел в документах — 3°, то есть около 5,2 % уклона. Превышение не видно на глаз: крановщик МОСКРАН-СЕРВИС измеряет уклон кренометром на опорной раме до выдвижения опор, а не определяет его по виду площадки.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="norma" style="margin:36px 0 16px">Что требует ФНП №461</h2>
    <p>МОСКРАН-СЕРВИС применяет запрет из пункта 111 ФНП №461 без исключений. Пункт прямо запрещает установку «на свеженасыпанном неутрамбованном грунте, а также на площадке с уклоном, превышающим указанный в паспорте и (или) руководстве по эксплуатации». Норма распространяется на краны стрелового типа, краны-манипуляторы и подъёмники одним пунктом — отдельного числа градусов правила не задают, ссылаясь на документацию конкретной машины.</p>
    <p>Пункт 111 ФНП №461 превращает предел уклона в техническую характеристику конкретной модели, а не в общее требование безопасности «на усмотрение крановщика»: завод рассчитывает его вместе с грузовой устойчивостью. МОСКРАН-СЕРВИС поэтому сверяет значение по паспорту машины, которая поедет на объект, а не применяет к любому крану одно и то же число.</p>

    <h2 id="predel" style="margin:36px 0 16px">Предел 3 градуса в паспорте крана</h2>
    <p>МОСКРАН-СЕРВИС сверяет по руководствам по эксплуатации серийных автокранов на шасси КАМАЗ, включая модели серии КС-55713 «Клинцы», предел установки 3° — около 5,2 % уклона по расчёту тангенса угла. Это значение повторяется в технических блогах крановых компаний как стандартное требование, измеряемое кренометром на опорной раме, а не рулеткой или уровнем на глаз.</p>
    <p>3° — предел для установки, а не целевой показатель: чем ближе фактический уклон к нулю, тем больше запас по устойчивости остаётся на ветровую нагрузку и инерционные силы при работе механизмов. МОСКРАН-СЕРВИС рассматривает площадку с уклоном 2,5–3° как пограничную и предпочитает выравнивание, а не работу на пределе паспортного значения.</p>

    <h2 id="izmerenie" style="margin:36px 0 16px">Как измеряют уклон</h2>
    <p>МОСКРАН-СЕРВИС измеряет уклон кренометром — маятниковым или электронным прибором на опорной раме, — ещё до выдвижения выносных опор, пока кран только встал на предполагаемое место своим ходом. Часть современных машин дублирует показание кренометра на экране в кабине оператора, и крановщик видит фактический уклон раньше, чем начинает выставление на опоры.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Параметр</th><th>Значение</th></tr></thead>
        <tbody>
          <tr><td>Норма</td><td>ФНП №461, п. 111</td></tr>
          <tr><td>Типовой предел по РЭ автокрана</td><td>3° (≈5,2 %)</td></tr>
          <tr><td>Прибор измерения</td><td>Кренометр на опорной раме</td></tr>
          <tr><td>Момент измерения</td><td>До выдвижения опор и подъёма груза</td></tr>
          <tr><td>При превышении предела</td><td>Выравнивание площадки или отказ от установки</td></tr>
        </tbody>
      </table>
    </div>

    <h2 id="posledstviya" style="margin:36px 0 16px">Что будет при превышении</h2>
    <p>МОСКРАН-СЕРВИС учитывает уклон площадки как отдельное слагаемое опрокидывающего момента — наравне с ветровой нагрузкой и инерционными силами при пуске и торможении механизмов, потому что именно по сумме этих нагрузок считается коэффициент грузовой устойчивости крана. Превышение паспортного предела уклона означает, что реальный запас устойчивости на площадке ниже того, что заложен в расчёт производителя для номинальных условий; подробный разбор коэффициента и сценария проверки — в <a href="/spravochnik/ustoychivost-krana/" style="color:var(--yellow)">материале об устойчивости крана</a>.</p>
    <p>3–4° уклона на глаз почти незаметны на утрамбованной грунтовой площадке, особенно если кран стоит колёсами вдоль склона, а не поперёк, — превышение предела не всегда выглядит как явный перекос. Поэтому МОСКРАН-СЕРВИС полагается на показание кренометра, а не на визуальный осмотр площадки перед выездом техники.</p>

    <h2 id="vyravnivanie" style="margin:36px 0 16px">Как выровнять площадку</h2>
    <p>МОСКРАН-СЕРВИС готовит основание по п. 108–110 ФНП №461. Срезка или подсыпка грунта с уплотнением убирает уклон до паспортного значения, а под каждую опору на слабом грунте добавляют стальные пятки из комплекта крана или деревянные брусья по расчёту несущей способности площадки — методика в <a href="/spravochnik/nesushchaya-sposobnost-grunta/" style="color:var(--yellow)">материале о несущей способности грунта</a>.</p>
    <p>МОСКРАН-СЕРВИС переносит точку стоянки крана или подбирает модель с другим пределом уклона по РЭ, если выровнять площадку целиком нельзя — например, участок стоит на склоне без возможности срезки грунта; установку на уклоне сверх паспортного значения с расчётом «на глаз» инженеры не допускают.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: уклон площадки для автокрана</h2>
    <ul>
      <li>ФНП №461, п. 111 — запрет уклона больше значения из паспорта или РЭ конкретной машины, единого числа правила не задают.</li>
      <li>В РЭ серийных автокранов типовой предел — 3° (≈5,2 % уклона).</li>
      <li>Измеряют кренометром на опорной раме до выдвижения опор, не на глаз.</li>
      <li>При превышении — срезка, подсыпка и уплотнение грунта по п. 108–110 ФНП №461 или перенос точки стоянки.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://www.consultant.ru/document/cons_doc_LAW_157709/06a90308711993d0f80887564a7029a4874304e1/" target="_blank" rel="noopener" style="color:var(--yellow)">КонсультантПлюс — ФНП №461, п. 111</a> — запрет установки на свеженасыпанном неутрамбованном грунте и на уклоне сверх паспортного значения.</li>
      <li><a href="https://dcs-rent.ru/wp-content/uploads/2017/01/manual-avtokran-galichanin-25-tonn.pdf" target="_blank" rel="noopener" style="color:var(--yellow)">Руководство по эксплуатации автокрана КС-55713 «Галичанин»</a> — требование к площадке установки и предел уклона 3°.</li>
      <li><a href="https://centr-teh.ru/blog/podemnye-krany/pravila-ustanovki-avtokrana" target="_blank" rel="noopener" style="color:var(--yellow)">Правила установки автокрана — технический блог ЦТО</a> — измерение уклона кренометром на опорной раме, предел 3°.</li>
      <li><a href="https://sudact.ru/law/prikaz-rostekhnadzora-ot-26112020-n-461-ob/federalnye-normy-i-pravila-v/vi/ustanovka-ps-i-proizvodstvo-rabot/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461, раздел VI «Установка ПС и производство работ» (ред. от 16.04.2026)</a> — п. 108–111.</li>
    </ul>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/lyubaya-podyomnaya-tehnika/">Подбор автокрана под площадку →</a></section>
</main>
</SpravochnikLayout>
