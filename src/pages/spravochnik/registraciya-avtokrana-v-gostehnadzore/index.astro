---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';
import Sources from '../../../components/Sources.astro';

const title = 'Регистрация автокрана в Гостехнадзоре: что изменилось с 1 сентября 2026 года';
const description = 'Автокран регистрируют не в ГИБДД, а в органах Гостехнадзора — как самоходную машину. С 1 сентября 2026 года это делают по новым правилам постановления №625, сменившего постановление №1507.';

const CHECKED = '16.09.2026';

const faqs = [
  {
    q: 'Автокран уже стоит в реестре опасных объектов Ростехнадзора — зачем ему ещё и регистрация в Гостехнадзоре?',
    a: 'Это два разных учёта про две разные роли одной машины. Реестр ОПО Ростехнадзора, о котором справочник писал в отдельном материале, — это учёт крана как подъёмного сооружения на опасном производственном объекте, по правилам ФНП №461. Регистрация в Гостехнадзоре — это учёт автокрана как самоходной машины, той же природы, что и регистрация автомобиля в ГИБДД, только для техники, которая не ездит по дорогам общего пользования как обычный легковой транспорт. Без одного учёта кран нельзя законно эксплуатировать как ОПО, без другого — нельзя законно поставить на баланс и допустить к работе как единицу техники вообще.',
  },
  {
    q: 'Почему автокран регистрируют в Гостехнадзоре, а не в ГИБДД, если он ездит по дорогам?',
    a: 'Разделение идёт по классификации техники, а не по факту движения по дороге. Автомобили категорий M и N регистрирует ГИБДД, а тракторы, дорожно-строительные и иные самоходные машины — в том числе автокраны на специальном шасси — относятся к компетенции органов гостехнадзора независимо от того, что часть пути они проходят своим ходом по дорогам общего пользования. Именно поэтому у автокрана нет обычного гибэдэдэшного свидетельства о регистрации ТС — вместо него оформляется паспорт самоходной машины и свидетельство о регистрации в Гостехнадзоре.',
  },
  {
    q: 'Что за новое постановление №625 и что оно меняет для владельца автокрана?',
    a: 'Постановление Правительства РФ от 29.05.2026 №625 «Об утверждении Правил государственной регистрации самоходных машин и других видов техники» действует с 1 сентября 2026 года по 1 сентября 2032 года и заменило собой постановление №1507 от 21.09.2020, срок действия которого истёк. Для владельца автокрана сама обязанность регистрировать машину и общий пакет документов принципиально не изменились — постановление в первую очередь наводит порядок в процедуре: органы гостехнадзора получили право самостоятельно определять серии регистрационных номеров, регистрацию стало можно признать недействительной при подделке документов или перебивке номера агрегата, а свидетельство о регистрации отнесено к бланкам строгой отчётности.',
  },
  {
    q: 'Что грозит, если возить груз автокраном, который не зарегистрирован в Гостехнадзоре?',
    a: 'Ответственность наступает по статье 19.22 КоАП РФ «Нарушение правил государственной регистрации транспортных средств всех видов, механизмов и установок»: для граждан штраф составляет от 1500 до 2000 рублей, для должностных лиц — от 2000 до 3500 рублей, для юридических лиц — от 5000 до 10000 рублей. Отдельно эксплуатация незарегистрированной машины на площадке или дороге — самостоятельный риск при любой проверке документов на объекте, поэтому это не тот штраф, который проще заплатить, чем устранить причину.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Регистрация автокрана в Гостехнадзоре', item: 'https://moskran-servis.ru/spravochnik/registraciya-avtokrana-v-gostehnadzore/' },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@id': 'https://moskran-servis.ru/#organization' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: 'https://moskran-servis.ru/spravochnik/registraciya-avtokrana-v-gostehnadzore/',
  inLanguage: 'ru-RU',
  datePublished: '2026-09-16',
  dateModified: '2026-09-16',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<SpravochnikLayout title={title} description={description} path="/spravochnik/registraciya-avtokrana-v-gostehnadzore/" slug="registraciya-avtokrana-v-gostehnadzore" ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Регистрация автокрана в Гостехнадзоре</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Разбор для заказчика</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Регистрация автокрана в Гостехнадзоре: что изменилось с 1 сентября 2026 года</h1>
    <p class="ref-byline">Инженерная служба МОСКРАН-СЕРВИС · обновлено 16.09.2026</p>

    <p>Справочник уже разбирал <a href="/spravochnik/registraciya-krana-rostehnadzor/" style="color:var(--yellow)">учёт крана в реестре опасных производственных объектов Ростехнадзора</a> — тот, что подтверждает право эксплуатировать кран как подъёмное сооружение. У автокрана есть и другой, более простой на первый взгляд учёт, который часто путают с первым: регистрация самой машины, той же природы, что и постановка автомобиля на учёт в ГИБДД, только по другим правилам и в другом ведомстве. С 1 сентября 2026 года эти правила обновились, и заказчику стоит понимать разницу.</p>

    <h2 style="margin:36px 0 16px">Почему Гостехнадзор, а не ГИБДД</h2>
    <p>Автомобили категорий M и N — легковые, автобусы, грузовики в обычном смысле слова — регистрирует Госавтоинспекция. Тракторы, самоходные дорожно-строительные, сельскохозяйственные и иные машины — отдельная категория техники, за учёт которой отвечают органы государственного надзора за техническим состоянием самоходных машин, то есть Гостехнадзор. Автокран на специальном шасси, даже если бо́льшую часть маршрута до объекта он идёт своим ходом по дорогам общего пользования, классифицируется именно как самоходная машина, а не как грузовой автомобиль в терминах регистрации. Поэтому у автокрана нет привычного гибэдэдэшного свидетельства о регистрации транспортного средства — вместо него оформляется паспорт самоходной машины (ПСМ или электронный ЭПСМ) и отдельное свидетельство о регистрации в Гостехнадзоре.</p>

    <h2 style="margin:36px 0 16px">Новые правила: постановление №625 вместо №1507</h2>
    <p>Порядок регистрации самоходных машин и другой техники, включая автокраны, устанавливало постановление Правительства РФ от 21.09.2020 №1507 — оно действовало до 1 сентября 2026 года. На смену ему пришло постановление Правительства РФ от 29.05.2026 №625 «Об утверждении Правил государственной регистрации самоходных машин и других видов техники», рассчитанное на период с 1 сентября 2026 года по 1 сентября 2032 года. Для владельца автокрана сама обязанность регистрировать машину и типовой пакет документов — паспорт самоходной машины, документ о праве собственности, копия полиса ОСАГО, если конструктивная скорость машины больше 20 км/ч (справочник разбирал этот порог отдельно применительно к автокрану) — принципиально не поменялись. Новое постановление в первую очередь наводит порядок в процедуре: органы гостехнадзора получили право самостоятельно определять серии регистрационных номеров вместо жёстко закреплённого за регионом списка, регистрацию можно признать недействительной при выявлении подделки документов или перебивки номера основного агрегата, а само свидетельство о регистрации отнесено к бланкам строгой отчётности.</p>

    <h2 style="margin:36px 0 16px">Сроки и цифровые сервисы</h2>
    <p>Владелец обязан поставить самоходную машину на учёт в течение 10 дней с момента возникновения права собственности — этот срок сохраняется и в новых правилах. Часть действий по регистрации, снятию с учёта и внесению изменений в данные — например, при смене адреса владельца или замене двигателя — можно провести удалённо через личный кабинет на портале госуслуг или на региональном портале, для Москвы это mos.ru: готовое свидетельство приходит в электронном виде, заверенное усиленной квалифицированной электронной подписью, а очное посещение инспекции нужно, только если владелец хочет получить ещё и бумажный дубликат документа.</p>

    <h2 style="margin:36px 0 16px">Что грозит за незарегистрированный автокран</h2>
    <p>Нарушение правил государственной регистрации самоходной техники — предмет статьи 19.22 КоАП РФ. Штраф для граждан составляет от 1500 до 2000 рублей, для должностных лиц — от 2000 до 3500 рублей, для юридических лиц — от 5000 до 10000 рублей. Для компании, у которой в парке несколько единиц техники, суммы штрафа на первый взгляд некритичны, но незарегистрированная машина — это ещё и формальное основание отказать в допуске на объект при проверке документов, а значит, риск сорвать согласованное время подачи крана.</p>

    <h2 style="margin:36px 0 16px">Что это значит для заказчика</h2>
    <p>Заказчику не нужно самому регистрировать арендованный автокран — это обязанность владельца техники, то есть подрядчика. Но свидетельство о регистрации в Гостехнадзоре и паспорт самоходной машины стоит держать в уме как часть того же пакета документов, что и полис ОСАГО, паспорт крана и полис страхования ответственности владельца ОПО: подрядчик, у которого этот комплект в порядке, реже сталкивается с задержками при допуске техники на площадку.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: что запомнить</h2>
    <ul>
      <li>Автокран как самоходную машину регистрируют не в ГИБДД, а в органах Гостехнадзора — это отдельный учёт, не заменяющий реестр ОПО Ростехнадзора.</li>
      <li>С 1 сентября 2026 года действует постановление Правительства РФ №625 от 29.05.2026, сменившее постановление №1507 от 21.09.2020; общий порядок и пакет документов для владельца принципиально не изменились.</li>
      <li>Срок регистрации — 10 дней с момента возникновения права собственности; часть операций можно провести через госуслуги или mos.ru.</li>
      <li>Нарушение правил регистрации — статья 19.22 КоАП РФ: от 1500 до 10000 рублей в зависимости от статуса нарушителя.</li>
      <li>Заказчику регистрировать технику не нужно, но стоит проверять её как часть стандартного пакета документов подрядчика.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <Sources
      checked={CHECKED}
      items={[
        { text: 'ГАРАНТ.РУ — постановление Правительства РФ от 29.05.2026 №625 «Об утверждении Правил государственной регистрации самоходных машин и других видов техники»', href: 'https://www.garant.ru/hotlaw/federal/2113104/' },
        { text: 'КонсультантПлюс — постановление Правительства РФ от 21.09.2020 №1507 (утратило силу с 01.09.2026)', href: 'https://www.consultant.ru/document/cons_doc_LAW_363244/' },
        { text: 'mos.ru — регистрация самоходной техники в Гостехнадзоре: порядок и сроки', href: 'https://www.mos.ru/otvet-transport/kak-zaregistrirovat-samohodnuyu-tehniku/' },
        { text: 'КонсультантПлюс — статья 19.22 КоАП РФ «Нарушение правил государственной регистрации транспортных средств всех видов, механизмов и установок»', href: 'https://www.zakonrf.info/koap/19.22/' },
      ]}
      note="Постановление №625 вступило в силу 1 сентября 2026 года; отдельные практические детали процедуры (например, точный состав пакета документов для конкретного региона) стоит уточнять по актуальной редакции правил и на портале госуслуг, так как ведомственные регламенты могут обновляться быстрее, чем справочные материалы."
    />
  </article>
  <section class="section wrap"><a class="btn" href="/spravochnik/osago-avtokrana/">ОСАГО для автокрана: нужен ли полис и чем он отличается от ОСОПО →</a></section>
</main>
</SpravochnikLayout>
