---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';
import Sources from '../../../components/Sources.astro';

const title = 'Предрейсовый медосмотр водителя автокрана: что проверить';
const description = 'Путевой лист без отметки о медосмотре недействителен. С 01.09.2023 порядок задаёт приказ Минздрава №266н — что это меняет для автокрана и заказчика.';

const CHECKED = '21.08.2026';

const faqs = [
  {
    q: 'Кто именно из бригады крана обязан проходить предрейсовый осмотр — крановщик, стропальщик или оба?',
    a: 'Требование привязано не к должности, а к факту управления транспортным средством в рейсе. У автокрана на грузовом шасси это обычно один и тот же человек: крановщик сам приводит машину на объект своим ходом. Именно он проходит осмотр перед выездом. Стропальщик, который не садится за руль и добирается до площадки отдельно, под это конкретное требование не подпадает — но может подпадать под другие обязательные осмотры по своей должности, если работодатель их назначил.',
  },
  {
    q: 'Чем предрейсовый осмотр отличается от ежегодной проверки знаний и от периодического медосмотра по вредным факторам?',
    a: 'Это три разных процедуры с разной периодичностью и разным предметом проверки. Периодическая проверка знаний по ФНП №461 (см. отдельный разбор справочника) подтверждает квалификацию — раз в год или чаще после инцидента. Периодический медосмотр по приказу Минздрава №29н проверяет общую пригодность к работе с вредными и опасными производственными факторами — с частотой, заданной этим приказом для конкретной профессии. Предрейсовый осмотр по приказу №266н — самый частый из трёх: сиюминутное состояние здоровья именно перед этим конкретным выездом, каждую рабочую смену. Прохождение одного не заменяет два других.',
  },
  {
    q: 'Можно ли пройти предрейсовый осмотр дистанционно, без личной явки к медработнику?',
    a: 'С 1 сентября 2023 года это разрешено — при условии использования медицинских изделий с автоматизированной дистанционной передачей данных. Но не для всех рейсов: ограничение действует для перевозки групп детей, опасных грузов и для маршрутов протяжённостью свыше 300 км между населёнными пунктами. Для автокрана, который выезжает по адресу в пределах Москвы, это редко становится проблемой; для машины, которая идёт из области на объект по трассе большим плечом, дистанционный формат стоит уточнять отдельно у подрядчика.',
  },
  {
    q: 'Что происходит, если водитель не прошёл осмотр в день выезда?',
    a: 'Медицинский работник ставит отметку «не допущен» с указанием выявленной причины, и с такой отметкой выезд на линию неправомерен — вне зависимости от того, свободна ли машина и есть ли на неё заявка. Для заказчика это тот же практический результат, что и поломка техники: подрядчик обязан либо заменить водителя на смену, либо перенести выезд, и сообщить об этом заранее, а не постфактум.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Предрейсовый медосмотр водителя', item: 'https://moskran-servis.ru/spravochnik/predreysovyy-medosmotr-voditelya/' },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@id': 'https://moskran-servis.ru/#organization' }, // ссылка на единственный узел организации (BaseLayout): отдельный узел с тем же @id, но другим name, был противоречием в графе
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: 'https://moskran-servis.ru/spravochnik/predreysovyy-medosmotr-voditelya/',
  inLanguage: 'ru-RU',
  datePublished: '2026-08-21',
  dateModified: '2026-08-21',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<SpravochnikLayout title={title} description={description} path="/spravochnik/predreysovyy-medosmotr-voditelya/" slug="predreysovyy-medosmotr-voditelya" ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Предрейсовый медосмотр водителя</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Разбор для заказчика</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Предрейсовый медосмотр водителя автокрана: что стоит за строчкой в путевом листе</h1>
    <p class="ref-byline">Инженерная служба МОСКРАН-СЕРВИС · обновлено 21.08.2026</p>

    <p>В разборе <a href="/documents/dokumenty-na-tehniku-i-operatora/" style="color:var(--yellow)">пакета документов на технику и оператора</a> путевой лист на день выезда назван одним из обязательных документов, которые едут с краном на объект. Но сам путевой лист — это результат, а не отдельная процедура: без отметки о допуске он не оформляется правомерно. Разбираем, что за этой отметкой стоит и почему заказчику крана стоит о ней знать, а не считать формальностью.</p>

    <h2 style="margin:36px 0 16px">Кто обязан проходить осмотр и перед чем именно</h2>
    <p>Автокран на грузовом шасси — транспортное средство, и человек, который управляет им в рейсе, подчиняется тем же требованиям безопасности дорожного движения, что и водитель любого грузовика. Федеральный закон от 10.12.1995 №196-ФЗ «О безопасности дорожного движения» относит предрейсовые и послерейсовые медицинские осмотры водителей к обязательным условиям обеспечения безопасности движения. У автокрана эта обязанность падает на того, кто фактически садится за руль перед выездом на маршрут — на большинстве машин это тот же человек, что и крановщик, управляющий подъёмным механизмом на площадке.</p>

    <h2 style="margin:36px 0 16px">Действующий порядок — приказ №266н, а не №835н</h2>
    <p>Порядок проведения предрейсовых осмотров долго регулировал приказ Минздрава России от 15.12.2014 №835н, но с 1 сентября 2023 года он признан утратившим силу и заменён приказом Минздрава России от 30.05.2023 №266н «Об утверждении Порядка проведения предсменных, предрейсовых и послесменных, послерейсовых медицинских осмотров». Если подрядчик или его медицинский работник ссылаются на старый номер приказа, это стоит уточнить отдельно — документ больше не действует, хотя сама обязанность прохождения осмотра, разумеется, никуда не делась.</p>
    <p>Осмотр включает сбор жалоб и визуальный осмотр, измерение температуры тела, контроль артериального давления и пульса, количественное определение алкоголя в выдыхаемом воздухе, а при наличии показаний — тестирование мочи на психоактивные вещества. По итогам медицинский работник выносит одно из двух заключений — «прошёл предрейсовый медицинский осмотр, к исполнению трудовых обязанностей допущен» или «не допущен» с указанием причины, и эта отметка переносится в путевой лист и журнал регистрации осмотров.</p>

    <h2 style="margin:36px 0 16px">Дистанционный формат — с ограничениями, а не для любого рейса</h2>
    <p>С 1 сентября 2023 года приказ №266н допускает проведение осмотра дистанционно — с использованием медицинских изделий, которые обеспечивают автоматизированную передачу данных медицинскому работнику без личного присутствия водителя в кабинете. Но ограничения реальные: дистанционный формат не применяется для водителей, перевозящих организованные группы детей, опасные грузы, а также для маршрутов протяжённостью свыше 300 км между населёнными пунктами; химико-токсикологические исследования при дистанционном формате всё равно проводятся очно не реже двух раз в год. Для автокрана, который выезжает по конкретному адресу в границах Москвы, эти ограничения обычно не задевают саму поездку — но если машина идёт из области большим плечом, стоит уточнить у подрядчика, каким именно способом организован осмотр в этот день.</p>

    <h2 style="margin:36px 0 16px">Это не то же самое, что периодическая проверка знаний или медосмотр по вредным факторам</h2>
    <p>У сайта уже есть отдельный разбор <a href="/spravochnik/ezhegodnaya-proverka-znaniy/" style="color:var(--yellow)">периодической проверки знаний</a> по ФНП №461 — это процедура про квалификацию, проводится не чаще раза в год, и логично идёт в паре с <a href="/spravochnik/attestaciya-kranovshchika/" style="color:var(--yellow)">аттестацией крановщика</a> при первичном допуске к профессии. Отдельно от неё существует обязательный периодический медицинский осмотр работников, занятых на работах с вредными и опасными производственными факторами, по приказу Минздрава России от 28.01.2021 №29н — он тоже не про сегодняшний рейс, а про общую пригодность к профессии на плановой основе. Предрейсовый осмотр по приказу №266н — самая частая из трёх процедур: она повторяется перед каждым выездом техники и не заменяет ни аттестацию, ни периодический медосмотр, как и они не заменяют её.</p>

    <h2 style="margin:36px 0 16px">Что это значит для заказчика крана</h2>
    <p>При проверке подрядчика есть смысл спрашивать не только про сам путевой лист, но и про то, каким приказом оформлен допуск водителя на день выезда — актуальный номер приказа косвенно показывает, насколько у компании налажен документооборот, а не разово подобран нужный бланк. Если водитель получает отметку «не допущен» в день выезда, для заказчика это по практическому эффекту равносильно неисправности техники — подрядчик обязан заменить водителя на смену или перенести выезд и сообщить об этом заранее, а не за час до расчётного времени подачи крана на площадку.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: что запомнить</h2>
    <ul>
      <li>Обязанность предрейсового осмотра — из ФЗ №196-ФЗ, а не отдельная инициатива перевозчика; она распространяется на водителя автокрана как на водителя транспортного средства.</li>
      <li>С 01.09.2023 порядок задаёт приказ Минздрава №266н, а не приказ №835н — тот признан утратившим силу.</li>
      <li>Осмотр включает жалобы, визуальный осмотр, температуру тела, давление и пульс, определение алкоголя, при показаниях — тест на психоактивные вещества; итог — «допущен»/«не допущен» в путевом листе.</li>
      <li>Дистанционный формат разрешён с 2023 года, но не для перевозки детских групп, опасных грузов и рейсов свыше 300 км.</li>
      <li>Это отдельная процедура от периодической проверки знаний (ФНП №461) и от периодического медосмотра по вредным факторам (приказ №29н) — они не взаимозаменяемы.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <Sources
      checked={CHECKED}
      items={[
        { text: 'КонсультантПлюс — Федеральный закон от 10.12.1995 №196-ФЗ «О безопасности дорожного движения»', href: 'https://www.consultant.ru/document/cons_doc_LAW_8585/' },
        { text: 'Контур.Норматив — приказ Минздрава России от 30.05.2023 №266н «Об утверждении Порядка проведения предсменных, предрейсовых и послесменных, послерейсовых медицинских осмотров»', href: 'https://normativ.kontur.ru/document?moduleId=1&documentId=449748' },
        { text: 'ГАРАНТ — приказ Минздрава России от 15.12.2014 №835н (статус: документ не действует)', href: 'https://base.garant.ru/70980038/' },
        { text: 'ГАРАНТ — приказ Минздрава России от 28.01.2021 №29н «Об утверждении Порядка проведения обязательных предварительных и периодических медицинских осмотров работников...», ч. 4 ст. 213 ТК РФ', href: 'https://base.garant.ru/400258713/' },
      ]}
      note="Точные реквизиты путевого листа задаёт приказ Минтранса России от 28.09.2022 №390 (по ч. 3 ст. 6 259-ФЗ) — этот документ не разбирается здесь отдельно, речь только о самой обязанности медицинского осмотра и действующем на неё приказе. Сроки действия приказа №266н (введён с переходным периодом до 2028–2029 годов по отдельным положениям) в источниках расходятся в деталях; на странице использован только тот факт, который подтверждён независимо в нескольких источниках, — сама дата вступления в силу 01.09.2023 и замена приказа №835н."
    />
  </article>
  <section class="section wrap"><a class="btn" href="/documents/dokumenty-na-tehniku-i-operatora/">Полный пакет документов на технику и оператора →</a></section>
</main>
</SpravochnikLayout>
