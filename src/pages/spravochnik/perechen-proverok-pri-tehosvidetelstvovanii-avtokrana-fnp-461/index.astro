---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = "Что проверяют при освидетельствовании автокрана: п. 170";
const description = "При техническом освидетельствовании осматривают механизмы и тормоза, проверяют металлоконструкции, крюк, канаты, противовес, оси, освещение (п. 170 ФНП №461).";

const CHECKED = '30.10.2026';
const PUBLISHED = '2026-10-30';
const SLUG = "perechen-proverok-pri-tehosvidetelstvovanii-avtokrana-fnp-461";
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    "q": "Что проверяют при техническом освидетельствовании автокрана?",
    "a": "Осматривают кран, механизмы, тормоза, гидро- и электрооборудование, указатели, ограничители и регистраторы проверяют в работе. Дополнительно проверяют металлоконструкции и соединения, крюк и блоки, массу противовеса и балласта, крепление осей и пальцев, канаты и их крепление, освещение и сигнализацию (п. 170 ФНП №461)."
  },
  {
    "q": "Кто проводит техническое освидетельствование автокрана?",
    "a": "Инженерно-технический работник, ответственный за производственный контроль при эксплуатации подъёмных сооружений, при участии работника, ответственного за содержание крана в работоспособном состоянии (п. 167 ФНП №461). Результат этот работник записывает в паспорт с указанием срока следующего освидетельствования (п. 189)."
  },
  {
    "q": "По каким нормам браковки проверяют канаты и узлы автокрана?",
    "a": "Нормы браковки сборочных единиц, механизмов и стальных канатов указывают в руководстве по эксплуатации крана (п. 170 ФНП №461). Для рельсовых путей при отсутствии норм в руководстве действует приложение №3 к ФНП; на автокран с пневмоколёсным шасси оно не распространяется."
  },
  {
    "q": "Проверяют ли при освидетельствовании ограничитель грузоподъёмности?",
    "a": "Да, но в работе: п. 170 ФНП №461 требует проверить в работе указатели, ограничители и регистраторы. Методика проверки грузом изложена в п. 262, а при статических испытаниях ограничитель, наоборот, отключают (п. 171)."
  },
  {
    "q": "Что получает заказчик по итогам освидетельствования арендованного крана?",
    "a": "Запись в паспорте крана о результате и сроке следующего освидетельствования (п. 189 ФНП №461). МОСКРАН-СЕРВИС передаёт копию паспорта вместе с краном, поэтому заказчик видит даты без запросов."
  }
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: "Перечень проверок при освидетельствовании автокрана", item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [["osmotr", "Осмотр и проверка в работе"], ["perechen", "Что дополнительно проверяют у крана"], ["tablica", "Какие пункты перечня относятся к автокрану"], ["kto", "Кто проводит освидетельствование"], ["chek", "Чек-лист для заказчика"], ["faq", "Частые вопросы"], ["istochniki", "Источники"]];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Перечень проверок при освидетельствовании автокрана</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">ФНП №461 · Освидетельствование</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Что проверяют при техническом освидетельствовании автокрана?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>30.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>30.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>6 мин чтения</span>
    </div>

    <p>При техническом освидетельствовании кран осматривают, а механизмы, тормоза, гидро- и электрооборудование, указатели, ограничители и регистраторы проверяют в работе (п. 170 ФНП №461). Затем сверяют металлоконструкции, крюк и блоки, массу противовеса и балласта, крепление осей и пальцев, канаты и освещение с руководством по эксплуатации. Для КС-55713 «Клинцы» и КС-65713-1 «Галичанин» результат проверки записывает в паспорт ответственный инженерно-технический работник (п. 189).</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="osmotr" style="margin:36px 0 16px">Осмотр и проверка в работе</h2>
    <p>Первая часть п. 170 ФНП №461 касается узлов, которые нельзя оценить только по документам: механизмы, тормоза, гидро- и электрооборудование осматривают, а указатели, ограничители и регистраторы проверяют в работе. Иначе говоря, прибор должен сработать, а не просто числиться в паспорте крана. Как эти приборы проверяют на практике, описано в справке про <a href="/spravochnik/proverka-priborov-bezopasnosti-avtokrana-fnp-461/" style="color:var(--yellow)">проверку приборов безопасности автокрана</a>.</p>

    <h2 id="perechen" style="margin:36px 0 16px">Что дополнительно проверяют у крана</h2>
    <p>Вторая часть п. 170 перечисляет проверки по подпунктам «а»–«и». Металлоконструкции и соединения смотрят на трещины, деформации и ослабление болтовых соединений, там же оценивают кабину, лестницы, площадки и ограждения. Крюк и блоки проверяют отдельно, а канаты и их крепление сверяют с руководством и требованиями ФНП; в справках про <a href="/spravochnik/brakovka-kryuka/" style="color:var(--yellow)">браковку крюка</a> и <a href="/spravochnik/brakovka-kanatov/" style="color:var(--yellow)">браковку канатов</a> приведены критерии.</p>
    <p>Кроме того, п. 170 требует сравнить с чертежом и паспортом фактическую массу противовеса и балласта, проверить крепление осей и пальцев, освещение и сигнализацию, а также фактическое расстояние между крюковой подвеской и упором при срабатывании концевого выключателя. Нормы браковки узлов, механизмов и канатов указывает руководство по эксплуатации крана.</p>

    <h2 id="tablica" style="margin:36px 0 16px">Какие пункты перечня относятся к автокрану</h2>
    <p>Перечень п. 170 общий для разных подъёмных сооружений, поэтому часть подпунктов к автокрану на пневмоколёсном шасси не применяется. Таблица показывает, какие проверки реально затрагивают КС-55713 «Клинцы» и КС-65713-1 «Галичанин»; столбец «Применимость» — вывод по тексту нормы, а не цитата.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Подпункт п. 170</th><th>Что проверяют</th><th>Применимость к автокрану</th></tr></thead>
        <tbody>
          <tr><td>«а»</td><td>Металлоконструкции, соединения, кабина, лестницы, площадки, ограждения</td><td>Да</td></tr>
          <tr><td>«б»</td><td>Крюк и блоки</td><td>Да</td></tr>
          <tr><td>«в»</td><td>Расстояние между крюковой подвеской и упором при срабатывании концевого выключателя</td><td>Да</td></tr>
          <tr><td>«г»</td><td>Изоляция и заземление электрического крана, их сопротивление</td><td>Нет: речь об электрических кранах</td></tr>
          <tr><td>«д»</td><td>Масса противовеса и балласта по чертежу и паспорту</td><td>Да</td></tr>
          <tr><td>«е»</td><td>Крепление осей и пальцев</td><td>Да</td></tr>
          <tr><td>«ж»</td><td>Рельсовый путь</td><td>Нет: автокран по рельсам не ходит</td></tr>
          <tr><td>«з»</td><td>Канаты и их крепление</td><td>Да</td></tr>
          <tr><td>«и»</td><td>Освещение и сигнализация</td><td>Да</td></tr>
        </tbody>
      </table>
    </div>

    <h2 id="kto" style="margin:36px 0 16px">Кто проводит освидетельствование</h2>
    <p>Пункт 167 ФНП №461 поручает освидетельствование инженерно-техническому работнику, ответственному за производственный контроль при эксплуатации подъёмных сооружений, с участием работника, ответственного за содержание крана в работоспособном состоянии. Результат записывают в паспорт со сроком следующего освидетельствования (п. 189). Запись у МОСКРАН-СЕРВИС попадает в копию паспорта, которая едет вместе с краном; формат записи объясняет справка про <a href="/spravochnik/zapis-v-pasporte-ob-osvidetelstvovanii-avtokrana-fnp-461/" style="color:var(--yellow)">запись в паспорте</a>.</p>

    <h2 id="chek" style="margin:36px 0 16px">Чек-лист для заказчика</h2>
    <p>Заказчику не нужно самому повторять проверки п. 170: достаточно убедиться, что освидетельствование проведено и записано. Коротко это выглядит так, а порядок частичного и полного освидетельствования разобран в справке про <a href="/spravochnik/tehnicheskoe-osvidetelstvovanie-krana/" style="color:var(--yellow)">техническое освидетельствование крана</a>.</p>
    <ol>
      <li>Попросите копию паспорта крана и найдите последнюю запись об освидетельствовании.</li>
      <li>Сверьте дату следующего освидетельствования с датой работ.</li>
      <li>Убедитесь, что на кране есть <a href="/spravochnik/tablichki-na-avtokrane-fnp-461/" style="color:var(--yellow)">табличка с датами</a> освидетельствований.</li>
      <li>Если кран был в ремонте стрелы или опор, запросите запись о <a href="/spravochnik/vneocherednoe-osvidetelstvovanie-avtokrana-fnp-461/" style="color:var(--yellow)">внеочередном освидетельствовании</a>.</li>
    </ol>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: проверки при освидетельствовании</h2>
    <ul>
      <li>Механизмы, тормоза, гидро- и электрооборудование осматривают, приборы безопасности проверяют в работе (п. 170 ФНП №461).</li>
      <li>Дополнительно: металлоконструкции, крюк и блоки, противовес и балласт, оси и пальцы, канаты, освещение.</li>
      <li>Проводит ответственный за производственный контроль, с участием ответственного за содержание крана (п. 167).</li>
      <li>Результат и срок следующего освидетельствования записывают в паспорт (п. 189).</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://www.consultant.ru/document/cons_doc_LAW_373321/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 (приказ Ростехнадзора от 26.11.2020 №461)</a> — пп. 167, 170, 171, 189 (освидетельствование, перечень проверок).</li>
      <li><a href="https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 на legalacts.ru</a> — текст пунктов сверен 30.10.2026.</li>
    </ul>
    <p class="small muted">Справка не заменяет руководство по эксплуатации и паспорт конкретного крана: объём проверок и нормы браковки определяют они.</p>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-16-25-tonn/">Аренда автокрана 16–25 тонн →</a></section>
</main>
</SpravochnikLayout>
