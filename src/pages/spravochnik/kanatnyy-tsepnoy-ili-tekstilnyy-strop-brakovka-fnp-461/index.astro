---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = "Канатный, цепной или текстильный строп: браковка по ФНП 461";
const description = "Канатный строп бракуют по обрывам проволок (4/6/16 на 3d/6d/30d), цепной — при удлинении звена >3 %, текстильный — при любом поперечном порезе (пп. 271–273).";

const CHECKED = '22.10.2026';
const PUBLISHED = '2026-10-22';
const SLUG = "kanatnyy-tsepnoy-ili-tekstilnyy-strop-brakovka-fnp-461";
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: "Сколько обрывов проволок допустимо у канатного стропа?",
    a: "Для стропов из канатов двойной свивки строп бракуют, если видимых обрывов наружных проволок больше 4 на длине 3d, 6 на длине 6d или 16 на длине 30d, где d — диаметр каната в мм (п. 271, таблица 3 ФНП №461).",
  },
  {
    q: "Когда бракуют цепной строп?",
    a: "При удлинении звена цепи более 3 % от первоначального размера или при уменьшении диаметра сечения звена от износа более 10 % (п. 272 ФНП №461). Диаметр измеряют в двух взаимно перпендикулярных направлениях.",
  },
  {
    q: "Можно ли работать текстильным стропом с маленьким поперечным надрезом?",
    a: "Нет. Поперечные порезы или разрывы ленты бракуют независимо от размера (п. 273 ФНП №461). МОСКРАН-СЕРВИС такой строп к подъёму на автокране не допускает.",
  },
  {
    q: "Что делать, если на текстильном стропе не читается бирка?",
    a: "Строп к работе не допускают: отсутствие клейма (бирки) или нечитаемые сведения об изготовителе и грузоподъёмности — первый признак браковки в п. 273 ФНП №461.",
  },
  {
    q: "Какие дефекты крюков и скоб стропа недопустимы?",
    a: "Трещины любых размеров, износ или вмятины с уменьшением сечения на 10 % и более, остаточные деформации с изменением размера более 3 %, повреждение резьбы и креплений (п. 274 ФНП №461).",
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: "Браковка канатных, цепных и текстильных строп", item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ["sravnenie", "Три типа стропа: сравнение браковки"],
  ["kanatnyy", "Канатный строп по п. 271"],
  ["tsepnoy", "Цепной строп по п. 272"],
  ["tekstilnyy", "Текстильный строп по п. 273"],
  ["metall", "Металлические элементы по п. 274"],
  ["vybor", "Какой строп берёт МОСКРАН-СЕРВИС под груз"],
  ["faq", "Частые вопросы"],
  ["istochniki", "Источники"],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Браковка канатных, цепных и текстильных строп</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">ФНП №461 · Стропы</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Чем отличается браковка канатного, цепного и текстильного стропа?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>22.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>22.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>5 мин чтения</span>
    </div>

    <p>ФНП №461 бракует три типа строп по разным физическим признакам: канатный — по числу обрывов проволок на длине 3d, 6d и 30d (п. 271), цепной — по удлинению звена более 3 % и износу сечения более 10 % (п. 272), текстильный — по порезам, расслоениям и бирке (п. 273). Металлические крюки и скобы у всех трёх оценивают по п. 274. МОСКРАН-СЕРВИС подбирает строп к грузу с учётом того, какой признак браковки на площадке проще проконтролировать.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="sravnenie" style="margin:36px 0 16px">Три типа стропа: сравнение браковки</h2>
    <p>Сводная таблица МОСКРАН-СЕРВИС собрана из пунктов 271–274 ФНП №461 и показывает, чем измеряют износ каждого типа стропа. У канатного стропа считают обрывы, у цепного — меряют звено штангенциркулем, у текстильного — ищут повреждения ленты и проверяют бирку. Сравнение по одной строке помогает стропальщику на площадке у автокрана КС-35714 «Ивановец» не путать критерии.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Параметр</th><th>Канатный (п. 271)</th><th>Цепной (п. 272)</th><th>Текстильный (п. 273)</th></tr></thead>
        <tbody>
          <tr><td>Главный признак</td><td>видимые обрывы наружных проволок</td><td>удлинение звена</td><td>порезы, разрывы, расслоения ленты</td></tr>
          <tr><td>Числовой порог</td><td>более 4 на 3d, 6 на 6d, 16 на 30d (двойная свивка)</td><td>удлинение более 3 %, износ диаметра более 10 %</td><td>продольные порезы суммарно более 10 % длины ветви или единичный более 50 мм</td></tr>
          <tr><td>Брак без измерений</td><td>—</td><td>—</td><td>любой поперечный порез, узел на ленте, нет бирки</td></tr>
          <tr><td>Загрязнение</td><td>не нормируется п. 271</td><td>не нормируется п. 272</td><td>нефтепродукты, смолы, краска, цемент, грунт более 50 % длины</td></tr>
          <tr><td>Металлические элементы</td><td colspan="3">по п. 274: трещины, износ сечения от 10 %, деформация более 3 %, повреждённая резьба</td></tr>
        </tbody>
      </table>
    </div>


    <h2 id="kanatnyy" style="margin:36px 0 16px">Канатный строп по п. 271</h2>
    <p>Канатный строп из стальных канатов двойной свивки бракуют, если видимых обрывов наружных проволок больше 4 на участке длиной 3d, больше 6 на 6d или больше 16 на 30d (п. 271, таблица 3 ФНП №461). Буква d — диаметр каната в миллиметрах, поэтому участок считают от диаметра конкретного стропа. Для каната диаметром 14 мм участок 3d равен 42 мм, а 30d — 420 мм; это арифметика, а не отдельная норма. МОСКРАН-СЕРВИС проверяет оба участка, потому что концентрация обрывов на коротком отрезке опаснее, чем их распределение. Нормы для канатов самого крана — в справке о <a href="/spravochnik/brakovka-kanatov/" style="color:var(--yellow)">браковке канатов</a>.</p>


    <h2 id="tsepnoy" style="margin:36px 0 16px">Цепной строп по п. 272</h2>
    <p>Цепной строп бракуют при удлинении звена более 3 % от первоначального размера или при уменьшении диаметра сечения звена из-за износа более 10 % (п. 272 ФНП №461). Диаметр измеряют в двух взаимно перпендикулярных направлениях, так что одно «удачное» измерение не спасает звено. Для звена с исходным шагом 56 мм (условный пример) порог удлинения — около 1,7 мм. МОСКРАН-СЕРВИС просит заказчика, работающего цепными стропами, хранить паспорт с исходными размерами звена: без него 3 % не от чего отсчитать.</p>


    <h2 id="tekstilnyy" style="margin:36px 0 16px">Текстильный строп по п. 273</h2>
    <p>Текстильный строп на полимерной основе не допускают к работе при отсутствии или нечитаемой бирке, узлах на несущих лентах и любых поперечных порезах или разрывах ленты (п. 273 ФНП №461). Продольные порезы допустимы, пока их сумма не превышает 10 % длины ветви и нет единичного пореза длиннее 50 мм. Отдельно бракуют загрязнение нефтепродуктами, смолами, красками, цементом или грунтом более чем на 50 % длины. МОСКРАН-СЕРВИС на московских стройплощадках чаще всего видит именно цементное загрязнение и порезы о кромки железобетона.</p>
    <p>Повреждения от острых кромок, химии и брызг металла п. 273 оценивает через долю ширины ленты: поверхностный обрыв нитей более 10 % ширины, сквозное отверстие диаметром более 10 % ширины, износ петли более 10 % ширины. Расслоение по шву вне заделки бракуют на суммарной длине более 0,5 м с разрывом трёх и более строчек, в месте заделки краёв — более 0,2 м. МОСКРАН-СЕРВИС подкладывает угловые защиты под текстильный строп при подъёме плит автокраном КС-55713-1К «Клинцы». Разница с канатным стропом по сфере применения — в справке о <a href="/spravochnik/tekstilnye-stropy/" style="color:var(--yellow)">текстильных стропах</a>.</p>


    <h2 id="metall" style="margin:36px 0 16px">Металлические элементы по п. 274</h2>
    <p>Металлические элементы любого стропа бракуют по п. 274 ФНП №461 — кольца, петли, скобы, подвески, обоймы, карабины и звенья. Эксплуатация запрещена при трещинах любого размера, износе или вмятинах с уменьшением сечения на 10 % и более, остаточной деформации более 3 % и повреждённых резьбовых соединениях. Порог 3 % деформации совпадает с порогом удлинения звена цепи из п. 272. МОСКРАН-СЕРВИС осматривает крюки стропа так же внимательно, как ветви: текстильная лента цела, а разогнутый крюк делает строп негодным.</p>


    <h2 id="vybor" style="margin:36px 0 16px">Какой строп берёт МОСКРАН-СЕРВИС под груз</h2>
    <p>Практика МОСКРАН-СЕРВИС, а не норма ФНП: для бетонных изделий с острыми кромками — канатный строп, для окрашенных металлоконструкций и стеклопакетов — текстильный с защитой, для горячих и абразивных грузов в цеху — цепной. Выбор опирается на тот признак браковки из пп. 271–273, который конкретный груз будет «ускорять». Сроки осмотра строп и порядок изъятия негодных разобраны в справке об <a href="/spravochnik/osmotr-stropov-i-traverc-fnp-461/" style="color:var(--yellow)">осмотре строп и траверс</a>.</p>


    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: браковка строп трёх типов</h2>
    <ul>
      <li>Канатный строп двойной свивки — брак при обрывах более 4 / 6 / 16 на 3d / 6d / 30d (п. 271 ФНП №461).</li>
      <li>Цепной — при удлинении звена более 3 % или износе диаметра более 10 % (п. 272).</li>
      <li>Текстильный — при любом поперечном порезе, узле, отсутствии бирки, загрязнении более 50 % длины (п. 273).</li>
      <li>Металлические элементы всех строп — по п. 274; МОСКРАН-СЕРВИС осматривает их наравне с ветвями.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://www.consultant.ru/document/cons_doc_LAW_373321/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 (приказ Ростехнадзора от 26.11.2020 №461)</a> — пп. 271–274 (браковка канатных, цепных и текстильных строп, металлических элементов).</li>
      <li><a href="https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 на legalacts.ru</a> — редакция от 16.04.2026, текст пунктов 271–274 и таблица 3 сверены 22.10.2026.</li>
    </ul>
    <p class="small muted">Примеры с канатом 14 мм и звеном 56 мм — арифметические иллюстрации; выбор стропа под груз — практика МОСКРАН-СЕРВИС, а не требование ФНП.</p>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-16-25-tonn/">Аренда автокрана 16–25 тонн →</a></section>
</main>
</SpravochnikLayout>
