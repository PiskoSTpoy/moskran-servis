const title = 'Режим труда и отдыха водителя автокрана: что меняет приказ №160';
const description = 'Приказ Минтранса №160 с 1 сентября 2026 меняет режим вождения и отдыха водителя автокрана. Разбираем лимиты и что это значит для сроков подачи техники.';

const CHECKED = '08.09.2026';

const faqs = [
  {
    q: 'Чем приказ №160 отличается от ФНП №461, про который справочник уже писал?',
    a: 'Это два документа разных ведомств про разные стороны одной поездки. ФНП №461 (Ростехнадзор) регулирует безопасную эксплуатацию самого подъёмного сооружения — исправность крана, освидетельствование, допуск персонала к крановым работам на площадке. Приказ Минтранса №160 регулирует другое: сколько часов человек вправе провести за рулём автомобиля и сколько ему положено отдыхать между рейсами. У автокрана это буквально два разных режима одного и того же человека — пока машина едет по дороге, действует приказ №160; когда кран установлен на выносные опоры и работает на объекте, вступает в силу ФНП №461.',
  },
  {
    q: 'Приказ №160 касается крановщика, когда он работает краном на площадке, а не едет по дороге?',
    a: 'Нет, в этой части — нет. Особенности режима труда и отдыха по приказу №160 относятся к времени управления автомобилем: пока автокран стоит на объекте на опорах и крановщик ведёт подъём груза, это не «управление автомобилем» в смысле документа. Требование применяется к тому же человеку в другой роли — когда он садится за руль, чтобы своим ходом привести машину на объект или увести её обратно на базу. У автокрана это обычно один и тот же работник, что мы уже отмечали в статье о предрейсовом медосмотре: крановщик на грузовом шасси чаще всего сам управляет машиной в рейсе.',
  },
  {
    q: 'С какого момента приказ №160 нужно применять — сразу с публикации?',
    a: 'Нет. Приказ подписан 14.04.2026 и зарегистрирован в Минюсте России 15.05.2026 под №86476, но вступает в силу с 1 сентября 2026 года — именно с этой даты прежний приказ Минтранса от 16.10.2020 №424 прекращает действовать. Документ рассчитан на срок до 1 сентября 2032 года.',
  },
  {
    q: 'Что грозит подрядчику, если водитель автокрана регулярно превышает лимиты вождения?',
    a: 'Формально это вопрос трудового законодательства и ответственности работодателя за организацию режима труда, а не вопрос, который заказчик крана может проконтролировать напрямую. Но для заказчика есть практическое следствие: подрядчик, который держит расписание техники в рамках легальных лимитов, — это подрядчик, у которого меньше поводов сорвать срок подачи крана из-за банальной усталости водителя на дальнем плече или из-за внепланового отдыха, который раньше не был заложен в график.',
  },
  {
    q: 'Нужно ли заказчику как-то менять договор аренды из-за этого приказа?',
    a: 'Нет, это не тот случай. Приказ №160 адресован работодателю водителя — то есть владельцу техники, а не заказчику услуги аренды. Заказчику стоит знать о нём ровно настолько, чтобы понимать: если подрядчик заранее предупреждает о необходимости смены водителя на длинном плече подачи техники или закладывает в график обязательный перерыв, это не прихоть, а исполнение федерального приказа, а не повод для скидки за «простой по вине подрядчика».',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
