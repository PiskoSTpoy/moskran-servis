---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = 'Автокран 25 или 50 тонн: какой класс выбрать под задачу';
const description = 'Автокран 25 или 50 т: КС-55713-1К «Клинцы» против КС-65713-1 «Галичанин» — грузовой момент, вылет, опорный контур и цена смены в МОСКРАН-СЕРВИС.';

const CHECKED = '25.09.2026';
const PUBLISHED = '2026-09-25';
const SLUG = 'avtokran-25-ili-50-tonn';
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: 'Поднимет ли автокран 25 тонн груз массой 10 тонн?',
    a: 'Зависит от вылета. У КС-55713-1К «Клинцы» грузовой момент 85 т·м, значит 10 т он в принципе может взять только на вылете до 8,5 м, а реальная цифра по грузовой таблице ещё ниже. МОСКРАН-СЕРВИС проверяет такой подъём по таблице конкретной машины; при вылете больше 6–7 м для 10 т обычно нужен класс 32–50 т.',
  },
  {
    q: 'Что такое грузовой момент крана простыми словами?',
    a: 'Грузовой момент — произведение массы груза на вылет, выраженное в тонно-метрах. У «Галичанина» КС-65713-1 это 175 т·м, у «Клинцов» КС-55713-1К — 85 т·м. По моменту можно быстро отсеять неподходящий кран: масса × вылет груза не должна превышать момент. Окончательное решение МОСКРАН-СЕРВИС принимает по грузовысотной характеристике машины.',
  },
  {
    q: 'Поместится ли 50-тонный кран во дворе жилого дома?',
    a: 'Нужно проверять площадку. Максимальный опорный контур КС-65713-1 «Галичанин» — 7,2 × 7,0 м против 4,9 × 6,1 м у КС-55713-1К, а к пятну опор добавляется место для поворота. Если во дворе нет места, МОСКРАН-СЕРВИС рассматривает кран с длинной стрелой, поставленный снаружи двора.',
  },
  {
    q: 'На сколько дороже смена 50-тонного крана?',
    a: 'По ставкам МОСКРАН-СЕРВИС смена автокрана 25 т стоит 20 800 ₽, 50 т — 31 200 ₽, разница 10 400 ₽. Промежуточный класс 32 т стоит 24 800 ₽ за смену. Поэтому если 25 т не хватает с небольшим запасом, сначала стоит проверить 32 т, а не сразу 50.',
  },
  {
    q: 'Какие краны 50 тонн есть в парке МОСКРАН-СЕРВИС?',
    a: 'В классе 50 т МОСКРАН-СЕРВИС подаёт «Галичанин» КС-65713-1 на шасси КАМАЗ-65201 и Liebherr LTM 1050 со стрелой 38 м. Ставка у обоих одинаковая, 3 900 ₽ в час; Liebherr выбирают, когда задача упирается в досягаемость — работу через здание или на кровлю.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Автокран 25 или 50 тонн', item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ['tonnazh', 'Что значит «25 тонн» и «50 тонн»'],
  ['sravnenie', 'КС-55713-1К и КС-65713-1: сравнение'],
  ['gruzovoy-moment', 'Как отсеять кран по грузовому моменту'],
  ['ploshchadka', 'Площадка и проезд для 50-тонного крана'],
  ['cena', 'Цена смены: 25, 32 и 50 т'],
  ['faq', 'Частые вопросы'],
  ['istochniki', 'Источники'],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Автокран 25 или 50 тонн</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Выбор техники · Сравнение классов</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Какой автокран выбрать: 25 или 50 тонн?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>25.09.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>25.09.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>7 мин чтения</span>
    </div>

    <p>Автокран 50 т нужен не тогда, когда груз тяжелее 25 т, а когда произведение массы груза на вылет превышает грузовой момент 25-тонной машины: у КС-55713-1К «Клинцы» это 85 т·м, у КС-65713-1 «Галичанин» — 175 т·м. Смена 50-тонного крана в МОСКРАН-СЕРВИС дороже на 10 400 ₽, а его опорный контур шире, поэтому класс выбирают по вылету и площадке, а не с запасом.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="tonnazh" style="margin:36px 0 16px">Что значит «25 тонн» и «50 тонн»</h2>
    <p>Тоннаж в названии автокрана — это максимальная грузоподъёмность на минимальном вылете, почти у самых выносных опор: у «Галичанина» КС-65713-1 50 т берутся на вылете 3,2 м. С ростом вылета грузоподъёмность падает, и на 10–15 м от оси вращения 50-тонный кран поднимает уже не 50 т, а в несколько раз меньше. МОСКРАН-СЕРВИС поэтому подбирает кран не по названию, а по строке грузовысотной характеристики на вашем вылете.</p>
    <p>Для заказчика это значит, что вопрос «25 или 50 тонн» решают три числа: масса самого тяжёлого груза вместе со стропами, расстояние от места установки крана до точки опускания и высота подъёма. Без этих чисел любой выбор класса — угадывание, и МОСКРАН-СЕРВИС в таком случае подбирает кран с запасом, за который платит заказчик. Как читать график самостоятельно, разобрано в <a href="/spravochnik/gruzovysotnaya-harakteristika/" style="color:var(--yellow)">материале о грузовысотной характеристике</a>.</p>

    <h2 id="sravnenie" style="margin:36px 0 16px">КС-55713-1К и КС-65713-1: сравнение</h2>
    <p>Две типовые машины классов 25 и 50 т различаются не только грузоподъёмностью: у 50-тонного «Галичанина» вдвое больше грузовой момент, на 13 м длиннее стрела и на 16 т больше масса. Данные ниже МОСКРАН-СЕРВИС привёл по материалам дилеров заводов-изготовителей; у разных исполнений одной модели цифры отличаются, и решает паспорт конкретной машины.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Параметр</th><th>КС-55713-1К «Клинцы», 25 т</th><th>КС-65713-1 «Галичанин», 50 т</th></tr></thead>
        <tbody>
          <tr><td>Грузовой момент</td><td>85 т·м</td><td>175 т·м</td></tr>
          <tr><td>Длина стрелы</td><td>21 м</td><td>11,5–34,1 м</td></tr>
          <tr><td>Максимальный вылет</td><td>19,5 м</td><td>32 м</td></tr>
          <tr><td>Опорный контур</td><td>4,9 × 6,1 м</td><td>до 7,2 × 7,0 м</td></tr>
          <tr><td>Масса крана</td><td>20,2 т</td><td>от 36,5 т</td></tr>
          <tr><td>Шасси</td><td>КАМАЗ-65115 (6×4)</td><td>КАМАЗ-65201 (8×4)</td></tr>
          <tr><td>Смена в МОСКРАН-СЕРВИС</td><td>20 800 ₽</td><td>31 200 ₽</td></tr>
        </tbody>
      </table>
    </div>

    <h2 id="gruzovoy-moment" style="margin:36px 0 16px">Как отсеять кран по грузовому моменту</h2>
    <p>Грузовой момент — произведение массы груза на вылет, поэтому на вылете 10 м КС-55713-1К с моментом 85 т·м поднимет не больше 8,5 тонны. У КС-65713-1 с моментом 175 т·м граница на том же вылете — 17,5 тонны. Это верхняя граница: реальная грузоподъёмность по таблице на том же вылете ниже, потому что часть момента уходит на собственную массу выдвинутой стрелы. Инженеры МОСКРАН-СЕРВИС используют такое деление, чтобы отсеять заведомо слабый кран до проверки по таблице.</p>
    <p>Пример: плиту перекрытия массой 6 т нужно опустить на вылете 12 м. Для «Клинцов» верхняя граница 85 / 12 ≈ 7,1 т — запас меньше 20 %, и с учётом массы стропов и реальной таблицы 25-тонный кран, скорее всего, не пройдёт. Для «Галичанина» граница 175 / 12 ≈ 14,6 т — подъём укладывается с большим запасом. Между ними есть класс 32 т, и в МОСКРАН-СЕРВИС именно его проверяют следующим, прежде чем переходить к 50 т.</p>

    <h2 id="ploshchadka" style="margin:36px 0 16px">Площадка и проезд для 50-тонного крана</h2>
    <p>Опорный контур 50-тонного «Галичанина» КС-65713-1 достигает 7,2 × 7,0 м, у 25-тонного КС-55713-1К — 4,9 × 6,1 м, и в тесном московском дворе эта разница решает всё. По пункту 108 ФНП №461 кран стрелового типа устанавливается на подготовленной площадке, а по пункту 109 между поворотной частью и строениями должно оставаться не менее 1 м. МОСКРАН-СЕРВИС проверяет оба условия по схеме площадки до выезда.</p>
    <p>Масса 50-тонного крана от 36,5 т означает и более высокое давление под опорами, поэтому для него чаще нужны подкладки и проверка основания — особенно над паркингом, коллектором или обратной засыпкой. Расчёт основания разобран в <a href="/spravochnik/nesushchaya-sposobnost-grunta/" style="color:var(--yellow)">материале о несущей способности грунта</a>. Проезд по Москве для обеих машин одинаково требует пропуска: разрешённая масса и 25-тонного, и 50-тонного автокрана выше 12 т; подробности — в <a href="/spravochnik/propusk-avtokrana-v-moskvu/" style="color:var(--yellow)">материале о пропуске автокрана в Москву</a>.</p>

    <h2 id="cena" style="margin:36px 0 16px">Цена смены: 25, 32 и 50 т</h2>
    <p>Смена крана 25 т в МОСКРАН-СЕРВИС стоит 20 800 ₽, 32 т — 24 800 ₽, 50 т — 31 200 ₽. Переход с 25 на 50 т добавляет к каждой смене 10 400 ₽, а на недельном объекте из пяти смен — 52 000 ₽. Класс 32 т закрывает многие задачи, для которых 25 т не хватает совсем немного, и стоит на 6 400 ₽ за смену меньше 50-тонного.</p>
    <p>В классе 50 т МОСКРАН-СЕРВИС подаёт «Галичанин» КС-65713-1 и Liebherr LTM 1050 по одной ставке 3 900 ₽ в час. Liebherr LTM 1050 со стрелой 38 м выбирают, когда задача упирается не в массу, а в досягаемость — работа через здание или подача на кровлю за парапет. Формула цены и то, что в ставку не входит, разобраны в <a href="/spravochnik/stoimost-arendy-avtokrana/" style="color:var(--yellow)">материале о стоимости аренды автокрана</a>.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: как выбрать класс</h2>
    <ul>
      <li>Название крана — тоннаж на минимальном вылете.</li>
      <li>Масса × вылет ≤ грузовой момент: 85 или 175 т·м.</li>
      <li>Не хватает 25 т — сначала проверить 32 т.</li>
      <li>50 т — шире опорный контур и тяжелее кран.</li>
      <li>Разница в цене — 10 400 ₽ за смену.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://www.avtocrane.by/katalog-produkcii/avtokrany-klincy/25-tonn/ks-55713-1k-klincy" target="_blank" rel="noopener" style="color:var(--yellow)">Технические данные КС-55713-1К «Клинцы»</a> — грузовой момент, стрела, опорный контур, масса.</li>
      <li><a href="https://kran-master74.ru/heavy/truck_cranes/galichanin/avtokran_galichanin_ks_65713_1_50_t/" target="_blank" rel="noopener" style="color:var(--yellow)">Технические данные КС-65713-1 «Галичанин»</a> — грузовой момент, стрела, опорный контур, масса.</li>
      <li><a href="https://www.consultant.ru/document/cons_doc_LAW_373321/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 (приказ Ростехнадзора от 26.11.2020 №461)</a> — п. 108, 109: установка кранов стрелового типа.</li>
      <li><a href="/" style="color:var(--yellow)">Ставки МОСКРАН-СЕРВИС</a> — главная страница сайта, действуют до 17.02.2027.</li>
    </ul>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-40-50-tonn/">Подробнее об аренде автокрана 40–50 тонн →</a></section>
</main>
</SpravochnikLayout>
