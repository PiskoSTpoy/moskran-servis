---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = 'Кантовка груза автокраном: правила п. 114 ФНП 461';
const description = 'Кантовку краном ведут на площадке или на весу по ППР; стропальщик стоит на высоту груза плюс 1 м сбоку; свыше 75% грузоподъёмности — под ИТР (п. 114 ФНП №461).';

const CHECKED = '16.10.2026';
const PUBLISHED = '2026-10-16';
const SLUG = 'kantovka-gruza-avtokranom-fnp-461';
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: 'Где разрешено кантовать груз краном?',
    a: 'Только на кантовальных площадках или на весу по заранее разработанным ППР либо технологической документации (п. 114 ФНП №461). Кантовать груз «как получится» на обычной площадке нельзя. МОСКРАН-СЕРВИС без ППР или техкарты кантовку не начинает.',
  },
  {
    q: 'На каком расстоянии от груза стоит стропальщик при кантовке?',
    a: 'Сбоку от кантуемого груза на расстоянии, равном высоте груза плюс 1 м, и не между грузом и стеной или другим препятствием (п. 114 ФНП №461). Для груза высотой 1,2 м это 2,2 м. МОСКРАН-СЕРВИС размечает эту зону на площадке до начала кантовки.',
  },
  {
    q: 'Когда кантовку нужно вести под руководством ИТР?',
    a: 'Для грузов массой более 75% паспортной грузоподъёмности ПС и для грузов со смещённым центром тяжести (п. 114 ФНП №461). Руководит инженерно-технический работник, ответственный за безопасное производство работ с ПС. МОСКРАН-СЕРВИС просит его присутствия на площадке заранее.',
  },
  {
    q: 'Нужен ли специальный кантователь?',
    a: 'Для деталей серийного и массового производства норма требует использовать специальные кантователи (п. 114 ФНП №461). Для единичных тяжёлых изделий кантовку выполняют краном по ППР. МОСКРАН-СЕРВИС спрашивает у заказчика, серийная ли деталь, ещё при заявке.',
  },
  {
    q: 'Может ли груз остаться на крюке при перерыве в кантовке?',
    a: 'Нет: при перерыве или по окончании работ на грузозахватном органе не должно быть подвешенного груза (п. 114 ФНП №461). Груз опускают на подготовленное место с подкладками. МОСКРАН-СЕРВИС не оставляет полуразвёрнутый груз на весу даже на обед.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Кантовка груза автокраном по ФНП №461', item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ['gde', 'Где разрешена кантовка'],
  ['stropalshchik', 'Где стоит стропальщик при кантовке'],
  ['ito', 'Когда нужен ИТР: 75% и смещённый центр тяжести'],
  ['perechen', 'Короткий перечень требований п. 114'],
  ['moskva', 'Кантовка на московских площадках'],
  ['faq', 'Частые вопросы'],
  ['istochniki', 'Источники'],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Кантовка груза автокраном по ФНП №461</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">ФНП №461 · Работа с грузом</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Как правильно кантовать груз автокраном и где при этом стоит стропальщик?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>16.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>16.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>5 мин чтения</span>
    </div>

    <p>Кантовку груза краном п. 114 ФНП №461 разрешает только на кантовальных площадках или на весу по ППР. Стропальщик стоит сбоку на расстоянии высоты груза плюс 1 м, а груз тяжелее 75% паспортной грузоподъёмности кантуют под руководством ИТР. МОСКРАН-СЕРВИС проверяет эти условия до подъёма.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="gde" style="margin:36px 0 16px">Где разрешена кантовка</h2>
    <p>Кантовку грузов с применением ПС п. 114 ФНП №461 разрешает вести только на кантовальных площадках или на весу, причём «на весу» — по заранее разработанным ППР или технологической документации. Третьего варианта в норме нет. МОСКРАН-СЕРВИС поэтому спрашивает у заказчика при заявке: есть ли кантовальная площадка и ППР на разворот изделия.</p>
    <p>Для монтажа, демонтажа и ремонта оборудования п. 98 дополнительно требует, чтобы ППР или техкарта указывали место стропальщиков и сигнальщиков при кантовке и перемещении узлов. Различие документов описано в справке о <a href="/spravochnik/ppr-ili-tehnologicheskaya-karta-avtokran-fnp-461/" style="color:var(--yellow)">ППР и технологической карте</a>. МОСКРАН-СЕРВИС сверяет расстановку людей с этой схемой, а не с привычкой бригады.</p>

    <h2 id="stropalshchik" style="margin:36px 0 16px">Где стоит стропальщик при кантовке</h2>
    <p>При кантовке стропальщику запрещено находиться между грузом и стеной или другим препятствием, а стоять он должен сбоку от груза на расстоянии, равном высоте груза плюс 1 м (п. 114 ФНП №461). Такой отступ оставляет место, если груз при переворачивании пойдёт в сторону. МОСКРАН-СЕРВИС размечает зону до начала подъёма.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Высота груза</th><th>Расстояние стропальщика сбоку (высота + 1 м)</th></tr></thead>
        <tbody>
          <tr><td>0,6 м</td><td>1,6 м</td></tr>
          <tr><td>1,2 м</td><td>2,2 м</td></tr>
          <tr><td>2,0 м</td><td>3,0 м</td></tr>
          <tr><td>3,0 м</td><td>4,0 м</td></tr>
        </tbody>
      </table>
    </div>
    <p>Значения в таблице — арифметика по формуле п. 114, а не отдельные нормативы. Высоту берут той, которую груз примет в наивысшей точке кантования, а не в исходном положении. Запрет находиться между грузом и стеной перекликается с п. 129, разобранным в материале о <a href="/spravochnik/rabota-krana-ryadom-s-zheleznoy-dorogoy/" style="color:var(--yellow)">работе крана рядом с железной дорогой</a>. МОСКРАН-СЕРВИС считает высоту по габаритам изделия из заявки.</p>

    <h2 id="ito" style="margin:36px 0 16px">Когда нужен ИТР: 75% и смещённый центр тяжести</h2>
    <p>Кантовку грузов массой более 75% от паспортной грузоподъёмности ПС и грузов со смещённым центром тяжести п. 114 ФНП №461 разрешает только под руководством инженерно-технического работника, ответственного за безопасное производство работ с применением ПС. Два условия независимы: достаточно любого. МОСКРАН-СЕРВИС при таком грузе не начинает работу без ответственного на площадке; его роль описана в материале об <a href="/spravochnik/otvetstvennyy-za-bezopasnoe-proizvodstvo/" style="color:var(--yellow)">ответственном за безопасное производство работ</a>.</p>
    <p>У автокрана грузоподъёмность зависит от вылета, а норма говорит о «паспортной грузоподъёмности ПС» и не уточняет, какую точку брать. Если на рабочем вылете кран поднимает 8 т, то порог в 75% составляет 6 т. Это иллюстрация, а не вывод ФНП: МОСКРАН-СЕРВИС для автокрана считает порог от грузоподъёмности на рабочем вылете, как более строгое прочтение. Подбор вылета описан в справке о <a href="/spravochnik/gruzovysotnaya-harakteristika/" style="color:var(--yellow)">грузовысотной характеристике</a>.</p>

    <h2 id="perechen" style="margin:36px 0 16px">Короткий перечень требований п. 114</h2>
    <p>Кантовка в п. 114 ФНП №461 стоит внутри общего перечня требований к перемещению груза, поэтому на неё распространяются и соседние пункты. МОСКРАН-СЕРВИС применяет их вместе, потому что опрокидывание груза случается на стыке нескольких нарушений, а не одного.</p>
    <ul>
      <li>МОСКРАН-СЕРВИС начинает подъём с отрыва груза на 0,2–0,3 м и остановки для проверки строповки и тормоза.</li>
      <li>МОСКРАН-СЕРВИС не перемещает груз, масса которого неизвестна (подробнее — в справке о <a href="/spravochnik/spisok-gruzov-s-massoy-v-zone-rabot-avtokrana-fnp-461/" style="color:var(--yellow)">списке грузов с массой</a>).</li>
      <li>МОСКРАН-СЕРВИС опускает груз только на место, где исключены падение, опрокидывание и сползание.</li>
      <li>МОСКРАН-СЕРВИС кладёт под груз подкладки достаточной прочности, чтобы вынуть стропы.</li>
      <li>МОСКРАН-СЕРВИС не оставляет подвешенный груз на крюке при перерыве и по окончании работ.</li>
      <li>МОСКРАН-СЕРВИС для деталей серийного производства требует специальных кантователей.</li>
    </ul>
    <p>Разворот груза руками допустим только до высоты 1 м, выше — оттяжки или багры (п. 116); запреты разобраны в материале о <a href="/spravochnik/zapreshchennye-operacii-avtokrana-fnp-461/" style="color:var(--yellow)">запрещённых операциях автокрана</a>. МОСКРАН-СЕРВИС не заменяет оттяжку рукой даже для короткого поворота.</p>

    <h2 id="moskva" style="margin:36px 0 16px">Кантовка на московских площадках</h2>
    <p>Кантовка автокраном КС-55713 «Клинцы» на московской стройке чаще всего возникает при подаче длинных и плоских изделий: панелей, плит, металлоконструкций, ящиков с оборудованием, привезённых «на боку». Двор с ограниченным пятном требует ППР заранее, потому что кантовальной площадки там обычно нет. МОСКРАН-СЕРВИС с автокраном КС-55713 «Клинцы» заранее уточняет у заказчика положение изделия при доставке и при монтаже.</p>
    <p>Если конструктивно можно подать груз без кантовки, МОСКРАН-СЕРВИС предлагает перевозку в рабочем положении. Это снижает число операций с грузом на весу и риск зажатия стропальщика. Перечень типичных изделий и совет подавать в рабочем положении — практика МОСКРАН-СЕРВИС, а не требование нормы; решение о способе принимает автор ППР.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: кантовка груза автокраном</h2>
    <ul>
      <li>МОСКРАН-СЕРВИС кантует груз на кантовальной площадке или на весу по ППР (п. 114 ФНП №461).</li>
      <li>Стропальщик МОСКРАН-СЕРВИС стоит сбоку на расстоянии высоты груза плюс 1 м и никогда между грузом и стеной.</li>
      <li>Груз тяжелее 75% грузоподъёмности и со смещённым центром тяжести МОСКРАН-СЕРВИС кантует только под руководством ИТР.</li>
      <li>При перерыве МОСКРАН-СЕРВИС опускает груз на подкладки и не оставляет его на крюке.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://www.consultant.ru/document/cons_doc_LAW_373321/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 (приказ Ростехнадзора от 26.11.2020 №461)</a> — п. 114 (кантовка, расстояние стропальщика, 75% и смещённый центр тяжести, подкладки, подвешенный груз), п. 98 (место стропальщиков в ППР), п. 116 (разворот руками).</li>
      <li><a href="https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 на legalacts.ru</a> — редакция от 16.04.2026, текст пунктов 98, 114 и 116 сверен 16.10.2026.</li>
    </ul>
    <p class="small muted">Таблица расстояний — расчёт по формуле п. 114, не отдельный норматив. Прочтение «паспортной грузоподъёмности» для автокрана на рабочем вылете и совет подавать груз без кантовки — практика МОСКРАН-СЕРВИС, а не пункты нормы.</p>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-16-25-tonn/">Аренда автокрана 16–25 тонн →</a></section>
</main>
</SpravochnikLayout>
