---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = 'Автокран 32 или 50 тонн: разница в 6 400 ₽ за смену';
const description = 'Класс 50 т: 175 т·м у КС-65713-1 против 102,4 т·м у КС-55729-1В-3. Смена 31 200 ₽ против 24 800 ₽ — когда нужен именно 50-тонный кран.';

const CHECKED = '02.10.2026';
const PUBLISHED = '2026-10-02';
const SLUG = 'avtokran-32-ili-50-tonn';
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: 'На сколько автокран 50 тонн дороже 32-тонного?',
    a: 'МОСКРАН-СЕРВИС берёт за класс 32 т 3 100 ₽ в час, за класс 50 т — 3 900 ₽. Смена 8 часов стоит 24 800 ₽ и 31 200 ₽, разница 6 400 ₽, или 26 %. Грузовой момент при этом растёт с 102,4 до 175 т·м, то есть на 71 %: по моменту доплата окупается с запасом.',
  },
  {
    q: 'Насколько выше поднимает кран 50 тонн, чем 32-тонный?',
    a: 'КС-65713-1 «Галичанин» класса 50 т основной стрелой 34,1 м поднимает крюк на 34,5 м, с гуськом 9,1 м — на 44,4 м, а со вставкой и гуськом — на 50,4 м. КС-55729-1В-3 класса 32 т со стрелой 31 м даёт 31,6 м без гуська и 40,4 м с гуськом. Разница по высоте с гуськом — 4 м.',
  },
  {
    q: 'Насколько шире опорный контур у 50-тонного крана?',
    a: 'Опорный контур КС-65713-1 «Галичанин» — 7,2 × 7,0 м против 5,45 × 6,1 м у КС-55729-1В-3. Разница больше полутора метров по длинной стороне, и на тесной площадке это может не позволить выставить именно 50-тонный кран, даже если по моменту он нужен.',
  },
  {
    q: 'Какой груз поднимет автокран 50 тонн на вылете 20 метров?',
    a: 'Деление момента 175 т·м на вылет 20 м даёт верхнюю границу около 8,75 т против 5,1 т у крана с моментом 102,4 т·м. Это только отсев заведомо слабого крана: точную массу на конкретном вылете МОСКРАН-СЕРВИС берёт из грузовой таблицы паспорта машины, которая поедет на объект.',
  },
  {
    q: 'Когда хватит класса 32 тонны вместо 50?',
    a: 'Класс 32 т за 24 800 ₽ закрывает подъёмы до 102,4 т·м — это груз 5 т на вылете до 20 м или 8 т на вылете до 12 м по верхней оценке. Класс 50 т МОСКРАН-СЕРВИС предлагает, когда момент выше этой границы либо нужна высота крюка больше 40 м.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Автокран 32 или 50 тонн', item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ['tablica', 'Два класса рядом'],
  ['moment', 'Грузовой момент и цена'],
  ['vysota', 'Стрела и высота крюка'],
  ['ploshadka', 'Опоры и площадка'],
  ['vybor', 'Когда хватит 32 тонн'],
  ['faq', 'Частые вопросы'],
  ['istochniki', 'Источники'],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Автокран 32 или 50 тонн</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Выбор техники · Класс 32–50 т</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Автокран 32 или 50 тонн: когда доплата 6 400 ₽ за смену оправдана?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>02.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>02.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>6 мин чтения</span>
    </div>

    <p>Автокран класса 50 т стоит в МОСКРАН-СЕРВИС 31 200 ₽ за смену против 24 800 ₽ у класса 32 т — на 6 400 ₽ дороже, или на 26 %. За эту доплату заказчик получает 175 т·м грузового момента против 102,4 т·м у 32-тонного крана — рост на 71 %. Стрела у 50-тонного КС-65713-1 длиннее на 3 м, а крюк с гуськом поднимается на 4 м выше. Доплата оправдана, когда 32-тонному крану не хватает именно грузового момента.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="tablica" style="margin:36px 0 16px">Два класса рядом</h2>
    <p>КС-55729-1В-3 «Галичанин» взят как типичный серийный кран класса 32 т, КС-65713-1 «Галичанин» — как типичный кран класса 50 т; МОСКРАН-СЕРВИС сверил карточки дилера «Кран-Мастер» 02.10.2026. Паспорт конкретной машины на объекте может отличаться комплектацией — окончательную грузовую таблицу МОСКРАН-СЕРВИС называет при подборе под заявку.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Параметр</th><th>Класс 32 т — КС-55729-1В-3</th><th>Класс 50 т — КС-65713-1</th></tr></thead>
        <tbody>
          <tr><td>Грузовой момент</td><td>102,4 т·м</td><td>175 т·м</td></tr>
          <tr><td>Основная стрела</td><td>9,7–31 м</td><td>11,5–34,1 м</td></tr>
          <tr><td>Высота крюка без гуська</td><td>31,6 м</td><td>34,5 м</td></tr>
          <tr><td>Высота крюка с гуськом</td><td>40,4 м (гусёк 9 м)</td><td>44,4 м (гусёк 9,1 м)</td></tr>
          <tr><td>Опорный контур</td><td>5,45 × 6,1 м</td><td>7,2 × 7,0 м</td></tr>
          <tr><td>Масса крана</td><td>21,65 т (минимальная комплектация)</td><td>36,5 т (минимальная комплектация)</td></tr>
          <tr><td>Шасси</td><td>КАМАЗ-65115, 6×4</td><td>КАМАЗ-65201, 8×4</td></tr>
          <tr><td>Ставка МОСКРАН-СЕРВИС</td><td>3 100 ₽/час</td><td>3 900 ₽/час</td></tr>
          <tr><td>Смена 8 часов</td><td>24 800 ₽</td><td>31 200 ₽</td></tr>
        </tbody>
      </table>
    </div>

    <h2 id="moment" style="margin:36px 0 16px">Грузовой момент и цена</h2>
    <p>Грузовой момент КС-65713-1 больше на 72,6 т·м, или на 71 %, а смена в МОСКРАН-СЕРВИС дороже только на 26 %: по соотношению момента к цене класс 50 т выгоднее, чем кажется на первый взгляд. Рубль за тонно-метр смены получается 242 ₽ у класса 32 т и 178 ₽ у класса 50 т — переплата «за тоннаж» в этой паре отсутствует, доплата нужна только когда момента 102,4 т·м объективно не хватает.</p>
    <p>Груз 5 т кран с моментом 102,4 т·м удерживает на вылете до 20,5 м по верхней оценке, кран с моментом 175 т·м — до 35 м. Для груза 8 т граница сдвигается с 12,8 до 21,9 м. МОСКРАН-СЕРВИС использует деление момента на массу только как предварительный отсев: окончательную допустимую массу на конкретном вылете даёт таблица паспорта той машины, которая поедет на объект — на длинной стреле она ниже расчётной верхней границы.</p>

    <h2 id="vysota" style="margin:36px 0 16px">Стрела и высота крюка</h2>
    <p>Стрела КС-65713-1 раздвигается до 34,1 м и без гуська поднимает крюк на 34,5 м — на 2,9 м выше, чем 31,6 м у КС-55729-1В-3. С гуськом 9,1 м высота растёт до 44,4 м, а с дополнительной вставкой (коленом) и тем же гуськом — до 50,4 м: для подъёма на высотное здание это уже другой диапазон этажности, не доступный 32-тонному крану даже с его гуськом 9 м и высотой 40,4 м.</p>
    <p>Высоту парапета или перекрытия МОСКРАН-СЕРВИС получает вычитанием запаса по п. 114 ФНП №461, высоты груза и длины строп из высоты подъёма крюка — методика разобрана в <a href="/spravochnik/podyom-gruza-na-kryshu-avtokranom/" style="color:var(--yellow)">материале о подъёме груза на крышу</a>. Для 50-тонного крана с гуськом и коленом запас по высоте даёт доступ к объектам, где 32-тонный класс не дотягивается даже с учётом гуська.</p>

    <h2 id="ploshadka" style="margin:36px 0 16px">Опоры и площадка</h2>
    <p>Опорный контур КС-65713-1 — 7,2 × 7,0 м против 5,45 × 6,1 м у КС-55729-1В-3: разница больше 1,7 м по длинной стороне. На площадке, зажатой между зданием и соседним участком, этот запас в ширину МОСКРАН-СЕРВИС проверяет до выезда техники — расчёт описан в <a href="/spravochnik/nesushchaya-sposobnost-grunta/" style="color:var(--yellow)">материале о несущей способности грунта</a>.</p>
    <p>Габариты КС-65713-1 в транспортном положении — 14,1 × 2,55 × 3,98 м на четырёхосном шасси КАМАЗ-65201 (8×4), у КС-55729-1В-3 — 11,8 × 2,55 × 3,97 м на трёхосном КАМАЗ-65115 (6×4). Четыре оси против трёх увеличивают нагрузку на проезжую часть и радиус разворота, что на дворовом проезде иногда важнее, чем сам опорный контур.</p>

    <h2 id="vybor" style="margin:36px 0 16px">Когда хватит 32 тонн</h2>
    <p>Класс 32 т за 24 800 ₽ закрывает подъёмы, пока момент 102,4 т·м не исчерпан. Это монтаж плит и блоков на вылете до 20 м или подъём на высоту до 31–40 м с гуськом. Класс 50 т за 31 200 ₽ МОСКРАН-СЕРВИС предлагает в трёх случаях: момента 32-тонного крана не хватает по таблице, крюк нужен выше 40 м, или площадка допускает только одну перестановку за смену.</p>
    <p>Если и 175 т·м недостаточно, следующий шаг — сравнение с более лёгкими классами по той же методике показано в материалах <a href="/spravochnik/avtokran-25-ili-32-tonny/" style="color:var(--yellow)">«Автокран 25 или 32 тонны»</a> и <a href="/spravochnik/avtokran-25-ili-50-tonn/" style="color:var(--yellow)">«Автокран 25 или 50 тонн»</a> — там же разобрано, когда выгоднее сразу взять более тяжёлый класс, а не переставлять кран.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: 32 или 50 тонн</h2>
    <ul>
      <li>Смена в МОСКРАН-СЕРВИС: 32 т — 24 800 ₽, 50 т — 31 200 ₽, разница 6 400 ₽ (26 %).</li>
      <li>Грузовой момент: 102,4 т·м у КС-55729-1В-3 против 175 т·м у КС-65713-1 (+71 %).</li>
      <li>Высота крюка с гуськом: 40,4 м против 44,4 м, с коленом у 50-тонного — до 50,4 м.</li>
      <li>Опорный контур класса 50 т шире на 1,7 м; шасси 8×4 вместо 6×4.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://kran-master74.ru/heavy/truck_cranes/galichanin/avtokran_galichanin_ks_55729_1v_3_/" target="_blank" rel="noopener" style="color:var(--yellow)">КС-55729-1В-3 «Галичанин», 32 т, шасси КАМАЗ-65115 — карточка дилера «Кран-Мастер»</a> — 102,4 т·м, стрела 9,7–31 м, крюк 31,6/40,4 м, опоры 5,45 × 6,1 м, 21,65 т.</li>
      <li><a href="https://kran-master74.ru/heavy/truck_cranes/galichanin/avtokran_galichanin_ks_65713_1_50_t/" target="_blank" rel="noopener" style="color:var(--yellow)">КС-65713-1 «Галичанин», 50 т, шасси КАМАЗ-65201 — карточка дилера «Кран-Мастер»</a> — 175 т·м, стрела 11,5–34,1 м, крюк 34,5/44,4/50,4 м, опоры 7,2 × 7,0 м, 36,5 т, габариты 14,1 × 2,55 × 3,98 м.</li>
      <li><a href="https://sudact.ru/law/prikaz-rostekhnadzora-ot-26112020-n-461-ob/federalnye-normy-i-pravila-v/vi/ustanovka-ps-i-proizvodstvo-rabot/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461, раздел VI «Установка ПС и производство работ» (ред. от 16.04.2026)</a> — п. 108–110, 114.</li>
    </ul>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-40-50-tonn/">Аренда автокрана 40–50 тонн →</a></section>
</main>
</SpravochnikLayout>
