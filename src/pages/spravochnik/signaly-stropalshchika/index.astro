---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';
import Sources from '../../../components/Sources.astro';

const title = 'Жестовые сигналы стропальщика крановщику';
const description = 'Знаковая сигнализация — жесты на расстоянии до 22 метров, сигнал «Стоп» — главный и первый, который выучивают. Как устроена коммуникация на площадке.';

const CHECKED = '12.08.2026';

const faqs = [
  { q: 'Почему используются жесты, а не рация?', a: 'Жестовая сигнализация — исторически сложившийся, надёжный и не зависящий от исправности оборудования способ коммуникации на расстоянии прямой видимости. Она дополняет, а не всегда заменяет голосовую связь или рацию, но остаётся основным стандартизированным способом именно потому, что не зависит от батареек или помех связи.' },
  { q: 'На каком расстоянии работает знаковая сигнализация?', a: 'Стропальщик показывает жесты крановщику на расстоянии до 22 метров — за пределами этой дистанции жесты становится сложно различить, и коммуникация обеспечивается другими средствами.' },
  { q: 'Что если крановщик не увидел сигнал «Стоп»?', a: 'Это критическая ситуация — сигнал «Стоп» применяется, когда что-то пошло не так с перемещением груза, и его невыполнение напрямую увеличивает риск аварии. Именно поэтому это первый и самый важный сигнал, который выучивают, а прямая видимость между стропальщиком и крановщиком — обязательное условие безопасной работы.' },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Сигналы стропальщика', item: 'https://moskran-servis.ru/spravochnik/signaly-stropalshchika/' },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@id': 'https://moskran-servis.ru/#organization' }, // ссылка на единственный узел организации (BaseLayout): отдельный узел с тем же @id, но другим name, был противоречием в графе
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: 'https://moskran-servis.ru/spravochnik/signaly-stropalshchika/',
  inLanguage: 'ru-RU',
  datePublished: '2026-08-12',
  dateModified: '2026-08-12',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<SpravochnikLayout title={title} description={description} path="/spravochnik/signaly-stropalshchika/" slug="signaly-stropalshchika" ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Сигналы стропальщика</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Разбор для заказчика</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Сигналы стропальщика крановщику — язык жестов на площадке</h1>
    <p class="ref-byline">Инженерная служба МОСКРАН-СЕРВИС · обновлено в 2026 году</p>

    <p>На площадке, где работает кран, стропальщик и крановщик физически разделены — один у груза, другой в кабине или на выносном пульте. Координация между ними — не устная договорённость, а стандартизированная система сигналов.</p>

    <h2 style="margin:36px 0 16px">Что такое знаковая сигнализация</h2>
    <p>Знаковая сигнализация — система передачи команд определённым набором жестов руками, которые стропальщик показывает крановщику на расстоянии до 22 метров. Может применяться с флажками или без них — флажки используются, когда стропальщику и крановщику важно улучшить взаимную видимость сигналов на расстоянии.</p>

    <h2 style="margin:36px 0 16px">Сигнал «Стоп» — главный и первый</h2>
    <p>Знак «Стоп» — частое движение рукой влево-вправо по горизонтали. Это первый сигнал, который необходимо выучить, потому что применяется он, когда что-то пошло не так при перемещении груза: груз оказался плохо закреплён или возникла угроза для человека. При действительно аварийной ситуации сигнал усиливается — размахивание обеими руками вправо-влево.</p>

    <h2 style="margin:36px 0 16px">Другие базовые сигналы</h2>
    <p>«Подъём» — сгибание и разгибание руки в локте, ладонь совершает прерывистые движения вверх. Горизонтальное перемещение груза — стропальщик показывает рукой направление, конечная точка жеста указывает позицию, куда нужно переместить стрелу крана. Каждый жест имеет чёткое, однозначно читаемое значение — двусмысленность в этой системе недопустима, потому что от точности передачи команды зависит безопасность подъёма.</p>

    <h2 style="margin:36px 0 16px">Почему это остаётся стандартом, а не заменено рацией</h2>
    <p>Жестовая сигнализация не зависит от исправности оборудования, заряда батареи или помех связи — это её ключевое преимущество перед рацией как основного, стандартизированного способа коммуникации в пределах прямой видимости. Голосовая связь или рация могут дополнять сигналы, но не заменяют требование к прямой видимости между стропальщиком и крановщиком как обязательное условие безопасной работы.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: что запомнить</h2>
    <ul>
      <li>Знаковая сигнализация работает жестами на расстоянии прямой видимости до 22 метров.</li>
      <li>Сигнал «Стоп» — первый и самый критичный, применяется при возникновении угрозы.</li>
      <li>Каждый жест имеет однозначное значение — двусмысленность недопустима.</li>
      <li>Прямая видимость между стропальщиком и крановщиком — обязательное условие работы.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <Sources
      checked={CHECKED}
      items={[
        { text: 'glavarendakran.com — сигналы стропальщика крановщику', href: 'https://www.glavarendakran.com/stati/signaly-stropalschika-kranovschiku/' },
        { text: 'mskran.ru — жесты стропальщика крановщику в картинках', href: 'https://mskran.ru/stropalchik/cat/?id=14' }
      ]}
    />
  </article>
  <section class="section wrap"><a class="btn" href="/spravochnik/trebovaniya-k-stropalshchiku/">Требования к стропальщику →</a></section>
</main>
</SpravochnikLayout>
