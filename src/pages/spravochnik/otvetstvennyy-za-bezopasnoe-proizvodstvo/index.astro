---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';
import Sources from '../../../components/Sources.astro';

const title = 'Ответственный за безопасное производство работ краном';
const description = 'Роль назначается внутренним актом эксплуатирующей организации по пункту 22 ФНП №461. Что он обязан не допустить и в каких операциях руководит подъёмом.';

const CHECKED = '12.08.2026';

/* --- Волна 17 (сплошная проверка нормативов) ---------------------------------
   Прежняя редакция называла основанием обязанностей Типовую инструкцию
   РД 10-34-93 (Госгортехнадзор, 1993). Эта инструкция писалась под ПБ 10-382-00,
   которые не применяются с 07.03.2014, и обязательным требованием сегодня не
   является: по подпункту «и» пункта 22 ФНП №461 инструкции с должностными
   обязанностями разрабатывает и утверждает своим внутренним распорядительным
   актом сама эксплуатирующая организация. Текст переписан на действующее
   основание; РД оставлен как исторический образец, а не как норма.
   Сверено по тексту ФНП №461 (ред. от 16.04.2026) 12.08.2026. */

const faqs = [
  { q: 'Это тот же человек, что и крановщик или стропальщик?', a: 'Нет, это отдельная роль — ответственный за безопасное производство работ следит за общей организацией процесса (правильность установки крана, отсутствие людей в опасной зоне, соответствие условий площадки), а не выполняет сам подъём или строповку.' },
  { q: 'Может ли работа крана идти без такого ответственного лица?', a: 'Нет. Поимённый перечень ответственных инженерно-технических работников, включая ответственного за безопасное производство работ с применением подъёмного сооружения, эксплуатирующая организация обязана утвердить внутренним распорядительным актом — это подпункт «и» пункта 22 ФНП №461. Отдельные операции те же ФНП разрешают вести только под его непосредственным руководством: работа вблизи воздушной линии электропередачи и кантовка груза свыше 75 процентов паспортной грузоподъёмности.' },
  { q: 'Кто назначает ответственного — заказчик или подрядчик по крану?', a: 'Ответственного назначает внутренним распорядительным актом эксплуатирующая кран организация — то есть мы. На объекте, где работает наш кран, эту роль обеспечиваем мы, а не заказчик услуги.' },
  { q: 'Нам прислали инструкцию со ссылкой на РД 10-34-93 — это нормально?', a: 'Как образец структуры — да, как основание обязанностей — нет. Типовая инструкция РД 10-34-93 издана Госгортехнадзором в 1993 году под Правила ПБ 10-382-00, которые не применяются с 7 марта 2014 года. Действующее требование стоит в пункте 22 ФНП №461 и адресовано эксплуатирующей организации: инструкцию она разрабатывает и утверждает сама. Ссылка на РД в присланном документе — повод проверить, когда этот документ вообще пересматривали.' },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Ответственный за безопасное производство', item: 'https://moskran-servis.ru/spravochnik/otvetstvennyy-za-bezopasnoe-proizvodstvo/' },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@id': 'https://moskran-servis.ru/#organization' }, // ссылка на единственный узел организации (BaseLayout): отдельный узел с тем же @id, но другим name, был противоречием в графе
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: 'https://moskran-servis.ru/spravochnik/otvetstvennyy-za-bezopasnoe-proizvodstvo/',
  inLanguage: 'ru-RU',
  datePublished: '2026-08-12',
  dateModified: '2026-08-12',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<SpravochnikLayout title={title} description={description} path="/spravochnik/otvetstvennyy-za-bezopasnoe-proizvodstvo/" slug="otvetstvennyy-za-bezopasnoe-proizvodstvo" ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Ответственный за безопасное производство</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Разбор для заказчика</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Ответственный за безопасное производство работ кранами — кто это и зачем нужен</h1>
    <p class="ref-byline">Инженерная служба МОСКРАН-СЕРВИС · обновлено в 2026 году</p>

    <p>Мы уже писали про роли крановщика и стропальщика. Есть ещё одна обязательная роль в цепочке безопасности, о которой реже говорят напрямую, — ответственный за безопасное производство работ грузоподъёмными кранами.</p>

    <h2 style="margin:36px 0 16px">Кто это и как назначается</h2>
    <p>Основание — подпункт «и» пункта 22 ФНП №461: эксплуатирующая организация обязана разработать и утвердить внутренним распорядительным актом инструкции с должностными обязанностями и поимённый перечень ответственных за промышленную безопасность из числа своих аттестованных инженерно-технических работников. Ролей в этом перечне три: ответственный за осуществление производственного контроля при эксплуатации ПС, ответственный за содержание ПС в работоспособном состоянии и ответственный за безопасное производство работ с применением ПС. Ни одна из них не совпадает с крановщиком или стропальщиком. Если работы ведутся на одном участке, ФНП разрешают совместить вторую и третью роль в одном человеке — но не отменить их.</p>
    <p>Важная деталь про источник обязанностей. По отраслевым сайтам и типовым папкам подрядчиков до сих пор ходит ссылка на Типовую инструкцию РД 10-34-93. Это документ Госгортехнадзора 1993 года, написанный под ПБ 10-382-00, — а те не применяются с 7 марта 2014 года. Сегодня должностную инструкцию для этой роли утверждает своим актом сама эксплуатирующая организация; РД 10-34-93 годится как образец структуры, но не как основание требования.</p>

    <h2 style="margin:36px 0 16px">Что входит в обязанности</h2>
    <p>Конкретный перечень задаёт та самая должностная инструкция, но её каркас — прямые запреты пункта 22 ФНП №461, адресованные эксплуатирующей организации: не эксплуатировать кран с нарушениями требований по его установке и не допускать работу на площадках, нагрузочные характеристики которых меньше нагрузок от крана с грузом (то, о чём мы писали в статье про несущую способность грунта). Плюс требование пункта 114 ФНП — не допускать нахождения людей там, где их может зажать между частями крана и грузом или конструкциями.</p>

    <h2 style="margin:36px 0 18px">Когда он руководит подъёмом лично</h2>
    <p>ФНП называют операции, где присутствия «где-то на объекте» недостаточно и требуется непосредственное руководство этого работника. Две из них встречаются в городской практике постоянно: работа крана вблизи воздушной линии электропередачи — он указывает крановщику место установки, обеспечивает условия наряда-допуска и делает запись в вахтенном журнале (пункт 112), и кантовка груза массой более 75 процентов от паспортной грузоподъёмности либо со смещённым центром тяжести (пункт 114).</p>
    <p>Это и есть практический смысл роли: не подпись в штатном расписании, а конкретный человек, который в конкретный момент отвечает за то, что кран стоит там, где можно, и поднимает то, что можно.</p>

    <h2 style="margin:36px 0 18px">Кто обеспечивает эту роль на объекте</h2>
    <p>Ответственного назначает приказом эксплуатирующая кран организация — то есть мы, а не заказчик услуги. Это часть стандартного пакета организационных мер, которые мы обеспечиваем на каждом объекте вместе с аттестованным оператором и правильно оформленными грузозахватными приспособлениями — заказчику не нужно отдельно искать или согласовывать эту роль.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: что запомнить</h2>
    <ul>
      <li>Ответственный за безопасное производство работ — отдельная роль от крановщика и стропальщика, назначается приказом.</li>
      <li>Основание — подпункт «и» пункта 22 ФНП №461, а не Типовая инструкция РД 10-34-93: та писалась под отменённые ПБ 10-382-00.</li>
      <li>Должностную инструкцию для роли утверждает внутренним актом сама эксплуатирующая организация.</li>
      <li>Следит за соответствием параметров площадки и за тем, чтобы людей не было там, где их может зажать грузом.</li>
      <li>При работе у воздушной линии (п. 112) и при кантовке тяжёлого груза (п. 114) руководит подъёмом непосредственно.</li>
      <li>Эту роль на наших объектах обеспечиваем мы, а не заказчик услуги.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <Sources
      checked={CHECKED}
      items={[
        { text: 'приказ Ростехнадзора от 26.11.2020 №461 (ред. от 16.04.2026) — п. 22 подпункт «и», п. 112, п. 114', href: 'https://www.consultant.ru/document/cons_doc_LAW_373321/' },
        { text: 'ГАРАНТ — ПБ 10-382-00 с отметкой «не применяется» (основание Типовой инструкции РД 10-34-93)', href: 'https://base.garant.ru/187859/' },
        { text: 'sab1.ru — зачем нужен ответственный за безопасное производство работ', href: 'https://sab1.ru/stati/otvetstvennyy-za-bezopasnoye-proizvodstvo-rabot' }
      ]}
    />
  </article>
  <section class="section wrap"><a class="btn" href="/spravochnik/trebovaniya-k-stropalshchiku/">Требования к стропальщику →</a></section>
</main>
</SpravochnikLayout>
