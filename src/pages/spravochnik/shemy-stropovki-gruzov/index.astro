const description = 'Схема строповки — обязательная часть ППР и технологической карты по ФНП №461. Разбираем, кто её разрабатывает, как она попадает к стропальщику и крановщику, зачем на площадке список грузов с массой и кто руководит подъёмом груза, для которого схемы нет.';

const CHECKED = '24.09.2026';

const faqs = [
  {
    q: 'Кто обязан разработать схемы строповки — подрядчик с краном или заказчик?',
    a: 'ФНП №461 возлагает это на эксплуатирующую организацию: по пункту 217 она разрабатывает ППР и технологические карты, содержащие схемы строповки, и обеспечивает ими персонал. На практике схемы для конкретных грузов объекта входят в ППР с применением подъёмных сооружений, который готовит генподрядчик или организация, ведущая работы. Если кран арендуется с экипажем на площадку заказчика, до подачи техники стоит договориться, чей ППР действует и в нём ли схемы на ваши грузы.',
  },
  {
    q: 'Можно ли поднимать груз, для которого нет схемы строповки?',
    a: 'Можно, но не силами одной бригады. Пункт 127 ФНП №461 прямо относит работу подъёмного сооружения при отсутствии маркировки веса груза и схем строповки к работам, которые производятся под непосредственным руководством инженерно-технического работника, ответственного за безопасное производство работ с применением ПС. То есть ответственный должен находиться на месте и руководить подъёмом лично, а не по телефону.',
  },
  {
    q: 'Где физически должны находиться схемы на площадке?',
    a: 'Схемы строповки — часть ППР и технологических карт, а те по пункту 157 ФНП №461 выдаются на участки, где используются подъёмные сооружения, до начала работ. Стропальщики и крановщики знакомятся с ними под подпись (пункт 158). Отдельно пункт 217 требует разместить в зоне работы крана список основных перемещаемых грузов с указанием массы, а крановщикам и стропальщикам стреловых кранов на строительно-монтажных работах — выдать такой список на руки.',
  },
  {
    q: 'Можно ли взять типовые схемы строповки из интернета?',
    a: 'Типовые графические изображения способов обвязки — хорошая основа, но схема должна соответствовать конкретному грузу: его массе, центру тяжести, местам строповки и применяемым на объекте грузозахватным приспособлениям. ППР, в который входят схемы, утверждает эксплуатирующая организация (пункт 157), поэтому картинка из сети без привязки к грузам объекта и перечню стропов требованиям не отвечает.',
  },
];

