---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';
import Sources from '../../../components/Sources.astro';

const title = 'Браковка грузового крюка крана: раскрытие зева на 10%';
const description = 'Крюк крана бракуется при раскрытии зева на 10% и более от первоначального размера, а также по трещинам и неисправности предохранительного замка — разбираем признаки и периодичность контроля.';

const CHECKED = '07.09.2026';

const faqs = [
  { q: 'На сколько может раскрыться зев крюка, прежде чем его нужно менять?', a: 'Предельная норма по ГОСТ 6627-74 — увеличение раскрытия зева (или износ вертикального сечения зева) на 10% и более от первоначального размера. Такой крюк подлежит немедленной замене независимо от остальных показателей — это самостоятельное и достаточное основание для браковки, а не рекомендация «понаблюдать ещё немного».' },
  { q: 'Кто и как часто осматривает крюк — только специалист или ещё и крановщик?', a: 'Оба, но с разной задачей. Крановщик выполняет визуальный осмотр перед каждой сменой — часть его обязанностей, о которых мы писали в отдельной статье про действия при обнаружении неисправности. Углублённая проверка, включая неразрушающий контроль сваркой и металлом крюка, входит в периодическое техническое диагностирование, которое проводит специализированная организация.' },
  { q: 'Чем трещина на крюке отличается от обычной забоины или задира?', a: 'Забоина или задир — механическое повреждение поверхности, которое в большинстве случаев можно зачистить и продолжить эксплуатацию после оценки специалистом. Трещина — это нарушение целостности металла, и она браковочный признак без вариантов: крюк с обнаруженной трещиной в любом месте немедленно выводится из эксплуатации, потому что трещина работает как концентратор напряжения и может привести к внезапному разрушению под нагрузкой.' },
  { q: 'Почему неисправность предохранительного замка — тоже повод остановить работу?', a: 'Замок (защёлка) крюка удерживает строп или петлю груза от самопроизвольного соскальзывания с зева при провисании стропа или развороте груза в воздухе. Неисправный или отсутствующий замок не мешает подъёму физически, поэтому его легко не заметить в спешке — но именно эта неисправность стоит за частью случаев падения груза с крюка, не связанных с обрывом каната или строп.' },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Браковка крюка', item: 'https://moskran-servis.ru/spravochnik/brakovka-kryuka/' },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@id': 'https://moskran-servis.ru/#organization' }, // ссылка на единственный узел организации (BaseLayout): отдельный узел с тем же @id, но другим name, был противоречием в графе
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: 'https://moskran-servis.ru/spravochnik/brakovka-kryuka/',
  inLanguage: 'ru-RU',
  datePublished: '2026-09-07',
  dateModified: '2026-09-07',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<SpravochnikLayout title={title} description={description} path="/spravochnik/brakovka-kryuka/" slug="brakovka-kryuka" ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Браковка крюка</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Разбор для заказчика</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Браковка грузового крюка крана — признаки износа и предельные нормы</h1>
    <p class="ref-byline">Инженерная служба МОСКРАН-СЕРВИС · обновлено 07.09.2026</p>

    <p>Мы уже разбирали браковку стальных канатов и периодичность испытаний траверс — двух других элементов, через которые кран держит груз в воздухе. Крюк — третий такой элемент, и в отличие от съёмных строп и траверс он несъёмная часть самого крана, но с собственными, отдельными нормами износа.</p>

    <h2 style="margin:36px 0 16px">Раскрытие зева — главный признак износа</h2>
    <p>Основной критерий браковки крюка — увеличение раскрытия зева, то есть износ вертикального сечения зева крюка, на 10% и более от первоначального размера, установленного при изготовлении по ГОСТ 6627-74 «Крюки однорогие. Заготовки. Типы. Конструкция и размеры». Зев крюка постепенно раскрывается под циклической нагрузкой и трением стропа — это нормальный процесс износа, но с чёткой границей: как только раскрытие достигает 10% от исходного размера, крюк подлежит немедленной замене независимо от того, как он выглядит визуально в остальном.</p>

    <h2 style="margin:36px 0 16px">Трещины и механические повреждения</h2>
    <p>Трещина на любом участке крюка — самостоятельный и безусловный браковочный признак, в отличие от раскрытия зева здесь нет процентной шкалы: обнаружили трещину — крюк из эксплуатации выводится сразу. Причина в самой природе дефекта: трещина концентрирует напряжение в металле и способна развиться до внезапного разрушения крюка под нагрузкой, без предварительных внешних признаков. Забоины, задиры и другие поверхностные повреждения оцениваются мягче — специалист решает, можно ли зачистить дефект без выхода за предельные размеры сечения, но и здесь решение принимает не крановщик на глаз, а ответственный за содержание крана по результатам осмотра.</p>

    <h2 style="margin:36px 0 16px">Предохранительный замок зева</h2>
    <p>Отдельная и часто недооценённая часть проверки — исправность предохранительного замка (защёлки), который перекрывает раскрытие зева и не даёт стропу или петле груза самопроизвольно соскользнуть с крюка при провисании грузового каната или развороте груза в воздухе. Замок не участвует в удержании основной нагрузки, поэтому его поломку легко пропустить, если осмотр крюка сводится к взгляду на сам металл. Неисправный или заклинивший замок — повод остановить работу этим крюком до ремонта или замены точно так же, как трещина или превышенное раскрытие зева.</p>

    <h2 style="margin:36px 0 16px">Кто и когда проверяет</h2>
    <p>Визуальный осмотр крюка — часть обязательной проверки грузозахватных органов крана, которую крановщик выполняет перед началом смены вместе с осмотром каната и приборов безопасности (мы писали об этом в статье про действия оператора при обнаружении неисправности). Более глубокая проверка — измерение раскрытия зева, поиск скрытых трещин методами неразрушающего контроля вроде магнитопорошковой или цветной дефектоскопии — проводится в рамках периодического технического диагностирования крана специализированной организацией, а не силами экипажа на площадке.</p>

    <h2 style="margin:36px 0 16px">Почему это не мелочь</h2>
    <p>Крюк — последнее звено в цепи «лебёдка — канат — крюк — строп — груз», и в отличие от каната или стропа его разрушение не всегда сопровождается предупреждающими признаками вроде видимых обрывов проволок. Раскрытие зева на глаз малозаметно, а трещина может скрываться под слоем смазки или ржавчины до планового диагностирования. Поэтому для нас проверка состояния крюков парка — такая же регулярная процедура учёта, как продление технического освидетельствования самого крана, а не разовая мера при жалобе или очевидном повреждении.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: что запомнить</h2>
    <ul>
      <li>Главный критерий браковки крюка — раскрытие зева на 10% и более от первоначального размера по ГОСТ 6627-74.</li>
      <li>Трещина в любом месте крюка — безусловное основание для немедленного вывода из эксплуатации, без процентной шкалы.</li>
      <li>Неисправный предохранительный замок зева — тоже повод остановить работу этим крюком, а не второстепенная деталь осмотра.</li>
      <li>Ежесменный визуальный осмотр — задача крановщика; измерение раскрытия зева и поиск скрытых трещин — задача периодического технического диагностирования.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <Sources
      checked={CHECKED}
      items={[
        { text: 'ГОСТ 6627-74 «Крюки однорогие. Заготовки. Типы. Конструкция и размеры» — полный текст стандарта', href: 'https://files.stroyinf.ru/Data2/1/4294847/4294847582.pdf' },
        { text: 'strop-nn.ru — при каком износе крюк подлежит браковке', href: 'https://strop-nn.ru/pri-kakom-iznose-kryuk-podlezhit-brakovke/' },
        { text: 'chemtech.ru — методы неразрушающего контроля грузозахватных крюков при техническом диагностировании подъёмных сооружений', href: 'https://chemtech.ru/metody-nerazrushajushhego-kontrolja-gruzozahvatnyh-krjukov-pri-tehnicheskom-diagnostirovanii-podemnyh-sooruzhenij/' },
      ]}
      note="Точный номер пункта ФНП №461, обязывающего к ежесменному осмотру крюка крановщиком, здесь не указан — сверен только сам факт требования и предельная норма ГОСТ 6627-74 по раскрытию зева; при подготовке документов по конкретной машине сверяйте формулировку с руководством по эксплуатации этой модели крана."
    />
  </article>
  <section class="section wrap"><a class="btn" href="/spravochnik/brakovka-kanatov/">Браковка стальных канатов крана →</a></section>
</main>
</SpravochnikLayout>
