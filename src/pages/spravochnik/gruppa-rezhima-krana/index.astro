---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';
import Sources from '../../../components/Sources.astro';

const title = 'Что означает группа режима крана А1–А8';
const description = 'Классификация кранов по ISO 4301 — группы А1–А8, определяемые классом использования и режимом нагружения. Зачем это заказчику при выборе техники.';

const CHECKED = '21.08.2026';

const faqs = [
  { q: 'Нужно ли заказчику разбираться в группе режима крана?', a: 'Для разового или периодического заказа — нет, это скорее параметр, который производитель и эксплуатирующая организация учитывают при проектировании и подборе техники под интенсивность использования. Заказчику важнее итоговая грузовысотная характеристика и класс грузоподъёмности, а не сама буквенно-цифровая маркировка группы режима.' },
  { q: 'Влияет ли группа режима на цену аренды?', a: 'Не напрямую — цена определяется классом грузоподъёмности и параметрами конкретной задачи (вылет, срок), а не группой режима самой машины. Группа режима — характеристика долговечности и интенсивности использования техники, а не тарифный параметр.' },
  { q: 'Почему тогда об этом вообще стоит знать?', a: 'Понимание, что за буквенно-цифровым обозначением стоит инженерная логика (интенсивность циклов + характер нагрузки), помогает не удивляться, встретив в паспорте техники обозначение вроде «А5» — это не опечатка и не код модели, а стандартизированная характеристика режима эксплуатации.' },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Группа режима крана', item: 'https://moskran-servis.ru/spravochnik/gruppa-rezhima-krana/' },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@id': 'https://moskran-servis.ru/#organization' }, // ссылка на единственный узел организации (BaseLayout): отдельный узел с тем же @id, но другим name, был противоречием в графе
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: 'https://moskran-servis.ru/spravochnik/gruppa-rezhima-krana/',
  inLanguage: 'ru-RU',
  datePublished: '2026-08-12',
  dateModified: '2026-08-21',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<SpravochnikLayout title={title} description={description} path="/spravochnik/gruppa-rezhima-krana/" slug="gruppa-rezhima-krana" ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Группа режима крана</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Разбор для заказчика</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Группа режима работы крана А1–А8 — что это значит при выборе техники</h1>
    <p class="ref-byline">Инженерная служба МОСКРАН-СЕРВИС · обновлено в 2026 году</p>

    <p>В паспорте любого крана можно встретить обозначение вида «группа режима А5» — это не код модели и не опечатка, а стандартизированная характеристика интенсивности эксплуатации техники. Разбираем, что она означает.</p>

    <h2 style="margin:36px 0 16px">Что определяет группу режима</h2>
    <p>Согласно стандарту ISO 4301, режим работы крана классифицируется одной из восьми групп — от А1 до А8. Группа определяется сочетанием двух параметров: класса использования (обозначается U0–U9, определяется числом рабочих циклов крана за нормативный срок службы) и режима нагружения (обозначается Q1–Q4, характеризует, насколько часто кран работает на пределе грузоподъёмности, а не с частичной загрузкой).</p>

    <h2 style="margin:36px 0 16px">Что такое рабочий цикл крана</h2>
    <p>Цикл работы крана — это последовательность: перемещение грузозахватного органа к грузу, подъём и перемещение груза, освобождение грузозахватного органа и возврат в исходное положение. Чем больше таких циклов кран выполняет за расчётный срок службы, тем выше класс использования — и тем интенсивнее должна быть рассчитана его конструкция, чтобы выдержать нагрузку.</p>

    <h2 style="margin:36px 0 18px">Зачем это знать, если вы просто заказываете кран на смену</h2>
    <p>Для разового заказчика группа режима не влияет напрямую на выбор — куда важнее итоговая грузовысотная характеристика конкретной модели (см. отдельную статью) и класс грузоподъёмности под задачу. Но эта характеристика объясняет, почему для одного и того же тоннажа существуют разные модели: техника, спроектированная для интенсивной ежедневной работы на производстве (высокая группа режима), и техника для более редкого использования — обе могут иметь одинаковую паспортную грузоподъёмность, но разную конструктивную интенсивность нагрузки, заложенную производителем.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: что запомнить</h2>
    <ul>
      <li>Группа режима А1–А8 по ISO 4301 — стандартизированная характеристика интенсивности эксплуатации крана.</li>
      <li>Определяется классом использования (число циклов) и режимом нагружения (насколько часто кран работает на пределе грузоподъёмности).</li>
      <li>Для разового заказа заказчику важнее грузовысотная характеристика, а не сама группа режима.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <Sources
      checked={CHECKED}
      items={[
        { text: 'uralkomplekt.su — подбор режима работы крана: группы А1–А8', href: 'https://uralkomplekt.su/spravochnik/podbor-rezhima-raboty-krana/' },
        { text: 'kran-mash.ru — группы классификации (режима) кранов', href: 'https://www.kran-mash.ru/poleznoe/27-gruppy-klassifikaczii-rezhima-kranov' }
      ]}
    />
  </article>
  <section class="section wrap"><a class="btn" href="/spravochnik/gruzovysotnaya-harakteristika/">Что важнее для вашей задачи — грузовысотная характеристика →</a></section>
</main>
</SpravochnikLayout>
