---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';
import Sources from '../../../components/Sources.astro';

const title = 'Как определить расстояние крана от котлована';
const description = 'Минимальное расстояние от откоса котлована до опор крана зависит от глубины выемки и типа грунта. При глубине более 5 м — расчёт индивидуально.';

const CHECKED = '12.08.2026';

const faqs = [
  { q: 'Почему нельзя установить кран вплотную к краю котлована?', a: 'Вес крана и груза создаёт дополнительную нагрузку на грунт, которая может спровоцировать обрушение откоса выемки — особенно если опора крана расположена слишком близко к краю. Это риск не только для техники, но и для людей, работающих в котловане.' },
  { q: 'Что делать, если по расчёту нужного расстояния не хватает на площадке?', a: 'Один из вариантов — укрепление откоса, если по-другому разместить кран невозможно. Также рассматривается изменение точки установки крана или использование техники с более длинной стрелой, позволяющей работать с большего расстояния от края выемки.' },
  { q: 'Учитывается ли тип грунта при расчёте расстояния?', a: 'Да, минимальное безопасное расстояние зависит и от глубины выемки, и от типа грунта — на слабых или насыпных грунтах требуется больший отступ, чем на плотном ненасыпном грунте той же глубины.' },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Расстояние от котлована', item: 'https://moskran-servis.ru/spravochnik/rasstoyanie-ot-kotlovana/' },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@id': 'https://moskran-servis.ru/#organization' }, // ссылка на единственный узел организации (BaseLayout): отдельный узел с тем же @id, но другим name, был противоречием в графе
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: 'https://moskran-servis.ru/spravochnik/rasstoyanie-ot-kotlovana/',
  inLanguage: 'ru-RU',
  datePublished: '2026-08-12',
  dateModified: '2026-08-12',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<SpravochnikLayout title={title} description={description} path="/spravochnik/rasstoyanie-ot-kotlovana/" slug="rasstoyanie-ot-kotlovana" ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Расстояние от котлована</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Разбор для заказчика</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Безопасное расстояние крана от котлована или траншеи</h1>
    <p class="ref-byline">Инженерная служба МОСКРАН-СЕРВИС · обновлено в 2026 году</p>

    <p>В статье про несущую способность грунта мы разбирали требования к площадке под выносные опоры. Отдельный, часто встречающийся на стройках случай — установка крана рядом с котлованом или траншеей, где действуют дополнительные требования по расстоянию.</p>

    <h2 style="margin:36px 0 16px">Почему это отдельное требование</h2>
    <p>Вес крана и поднимаемого груза создаёт дополнительную нагрузку на грунт рядом с точкой установки. Если опора крана расположена слишком близко к краю выемки, эта нагрузка может спровоцировать обрушение откоса — с риском не только для техники, но и для людей, работающих в котловане.</p>

    <h2 style="margin:36px 0 16px">От чего зависит минимальное расстояние</h2>
    <p>Минимальное безопасное расстояние от основания откоса котлована до ближайших опор стрелового крана зависит от глубины выемки и типа грунта. При глубине выемки более 5 метров расстояние от основания откоса до ближайших опор крана определяется индивидуальным расчётом, а не берётся по общей таблице — для более мелких выемок используются справочные минимальные значения по типу грунта.</p>
    <p>Поперечная привязка стреловых кранов у откоса котлована в общем виде рассчитывается по формуле, учитывающей габариты здания, безопасное расстояние от откоса до опоры крана и половину базы крана — это инженерный расчёт, а не произвольная оценка на глаз.</p>

    <h2 style="margin:36px 0 16px">Что делать, если расстояния не хватает</h2>
    <p>Если площадка не позволяет соблюсти расчётное безопасное расстояние (стеснённый объект, узкая полоса между зданием и котлованом), откос должен быть укреплён — либо рассматриваются альтернативы: другая точка установки крана или модель с более длинной стрелой, позволяющая работать с большего расстояния от края выемки.</p>

    <h2 style="margin:36px 0 16px">Как мы это учитываем при расчёте заявки</h2>
    <p>Если объект связан с земляными работами (котлован под фундамент, траншея под коммуникации), уточняем глубину выемки и тип грунта на этапе приёма заявки — это отдельный параметр расчёта площадки, помимо стандартной оценки твёрдого покрытия под опоры (см. статью про несущую способность грунта).</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: что запомнить</h2>
    <ul>
      <li>Установка крана слишком близко к краю выемки создаёт риск обрушения откоса под весом техники и груза.</li>
      <li>Минимальное расстояние зависит от глубины котлована и типа грунта.</li>
      <li>При глубине более 5 метров требуется индивидуальный расчёт.</li>
      <li>Если расстояния не хватает — укрепление откоса или другая точка установки/модель крана.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <Sources
      checked={CHECKED}
      items={[
        { text: 'allformgsu.ru — безопасность труда при установке кранов вблизи выемок', href: 'https://allformgsu.ru/publ/bezopasnost_zhiznedejatelnosti/obespechenie_bezopasnosti_truda_pri_ustanovke_kranov_vblizi_vyemok/17-1-0-86' },
        { text: 'web-mechanic.ru — установка кранов и опасные зоны', href: 'https://web-mechanic.ru/gruzopodemnye-mekhanizmy/ustanovka-kranov.html' }
      ]}
    />
  </article>
  <section class="section wrap"><a class="btn" href="/spravochnik/nesushchaya-sposobnost-grunta/">Требования к площадке под опоры →</a></section>
</main>
</SpravochnikLayout>
