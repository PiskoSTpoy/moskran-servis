---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = 'Как автокран монтирует плиты ленточного фундамента ФЛ?';
const description = 'Плита ФЛ16.24 весит 2,15 т, ФЛ32.12 — 3,23 т (ГОСТ 13580-2021). Кран стоит в стороне от траншеи — расчёт вылета, момента и класса техники от 17 600 ₽.';

const CHECKED = '03.10.2026';
const PUBLISHED = '2026-10-03';
const SLUG = 'montazh-fundamentnyh-plit-avtokranom';
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: 'Сколько весит плита фундамента ФЛ?',
    a: 'По каталогу завода ЖБИ масса плиты растёт с шириной: ФЛ6.24 — 0,93 т, ФЛ8.24 — 1,15 т, ФЛ16.24 — 2,15 т, ФЛ32.12 — 3,23 т. Для самых широких плит под тяжёлые здания масса доходит до 5,98 т. МОСКРАН-СЕРВИС берёт точную массу из проекта и паспорта завода, а не из названия серии.',
  },
  {
    q: 'Какой класс автокрана нужен для монтажа плит ФЛ?',
    a: 'Для плит до 2,15 т на типовом вылете 10–14 м МОСКРАН-СЕРВИС обычно подаёт класс 16–20 т (48 т·м, 17 600 ₽ за смену). Для более широких плит — ФЛ32.12 и тяжелее — или при большем вылете от края траншеи нужен класс 25 т (85 т·м, 20 800 ₽), иногда 32 т.',
  },
  {
    q: 'На каком расстоянии от траншеи должен стоять автокран?',
    a: 'Точное расстояние зависит от глубины выемки и типа грунта — универсального числа метров правила не задают, подробный расчёт в материале о расстоянии крана от котлована. На практике это означает больший вылет стрелы, чем хотелось бы: кран нельзя подвинуть к самому краю траншеи, чтобы сократить плечо подъёма.',
  },
  {
    q: 'Нужно ли поднимать плиту ФЛ только за монтажные петли?',
    a: 'Да. ГОСТ 13015-2012 требует поднимать железобетонные изделия за монтажные (грузоподъёмные) петли, рассчитанные заводом именно под строповку, а не за произвольный выступ арматуры. Крановщик МОСКРАН-СЕРВИС цепляет обе петли плиты одновременно стропами равной длины, чтобы она не перекосилась при опускании в траншею.',
  },
  {
    q: 'ГОСТ 13580-85 на плиты ФЛ ещё действует?',
    a: 'Нет. С 1 сентября 2022 года вместо ГОСТ 13580-85 действует ГОСТ 13580-2021 (с поправкой от 01.09.2023) — тот же набор типоразмеров и близкие массы, но обновлённый текст стандарта. МОСКРАН-СЕРВИС сверяет проекты по действующей редакции, а не по советскому номеру, который продолжают писать некоторые каталоги.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Монтаж плит ФЛ автокраном', item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ['massa', 'Масса плит ФЛ по ГОСТ 13580-2021'],
  ['transheya', 'Почему кран стоит в стороне от траншеи'],
  ['moment', 'Вылет и грузовой момент'],
  ['stropovka', 'Строповка за монтажные петли'],
  ['primer', 'Пример: лента дома 10×12 м'],
  ['stoimost', 'Сколько стоит смена'],
  ['faq', 'Частые вопросы'],
  ['istochniki', 'Источники'],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Монтаж плит ФЛ автокраном</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Монтаж ЖБИ · ГОСТ 13580-2021</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Как автокран монтирует плиты ленточного фундамента ФЛ?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>03.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>03.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>6 мин чтения</span>
    </div>

    <p>Плита ленточного фундамента ФЛ16.24 весит 2,15 т, а ФЛ32.12 — уже 3,23 т, поэтому МОСКРАН-СЕРВИС подбирает класс автокрана по марке конкретной плиты, а не по типу работы «фундамент» вообще. Плита опускается не на ровную площадку, а в открытую траншею или котлован — это главное отличие от монтажа блоков ФБС поверх готового основания, и оно напрямую увеличивает вылет стрелы: кран нельзя подвести к самому краю выемки.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="massa" style="margin:36px 0 16px">Масса плит ФЛ по ГОСТ 13580-2021</h2>
    <p>ГОСТ 13580-2021 действует с 1 сентября 2022 года вместо отменённого ГОСТ 13580-85, с поправкой от 01.09.2023. Завод изготавливает плиты ФЛ из тяжёлого бетона плотностью 2300–2500 кг/м³ по той же линейке типоразмеров, но по обновлённому тексту стандарта. МОСКРАН-СЕРВИС проверяет проект по действующей редакции 2021 года: часть каталогов в сети до сих пор ссылается на отменённый номер 1985 года.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Марка</th><th>Ширина</th><th>Масса</th></tr></thead>
        <tbody>
          <tr><td>ФЛ6.24</td><td>600 мм</td><td>0,93 т</td></tr>
          <tr><td>ФЛ8.24</td><td>800 мм</td><td>1,15 т</td></tr>
          <tr><td>ФЛ16.24</td><td>1 600 мм</td><td>2,15 т</td></tr>
          <tr><td>ФЛ32.12</td><td>3 200 мм</td><td>3,23 т</td></tr>
          <tr><td>ФЛ24.30 (максимум серии)</td><td>2 400 мм</td><td>5,98 т</td></tr>
        </tbody>
      </table>
    </div>
    <p>Длина плиты в серии фиксирована — 780, 1180, 2380 или 2980 мм, а растёт именно ширина подошвы под нагрузку здания. Для частного дома и большинства коммерческих объектов в Москве и области МОСКРАН-СЕРВИС чаще всего завозит плиты шириной 600–1600 мм; более широкие марки — под тяжёлые промышленные и многоэтажные ленты, где решает проект, а не стандартный подбор.</p>

    <h2 id="transheya" style="margin:36px 0 16px">Почему кран стоит в стороне от траншеи</h2>
    <p>МОСКРАН-СЕРВИС ставит кран не вплотную к траншее, а с отступом: плита ФЛ опускается на дно открытой выемки, а опоры крана стоят на поверхности земли рядом с ней, под собственным весом машины и груза. Минимальное расстояние от опор до основания откоса зависит от глубины выемки и типа грунта, а при глубине более 5 м рассчитывается индивидуально — подробная методика в <a href="/spravochnik/rasstoyanie-ot-kotlovana/" style="color:var(--yellow)">материале о расстоянии крана от котлована</a>.</p>
    <p>Отступ от края траншеи означает, что реальный вылет при монтаже ФЛ почти всегда больше, чем при работе с ФБС или плитами перекрытия на спланированной площадке: расстояние безопасности складывается с шириной самой траншеи до точки опускания плиты на дно. МОСКРАН-СЕРВИС считает вылет для ФЛ от этой увеличенной базы, а не по привычке «как для соседнего ФБС», иначе грузовой момент на бумаге занижается.</p>

    <h2 id="moment" style="margin:36px 0 16px">Вылет и грузовой момент</h2>
    <p>МОСКРАН-СЕРВИС проверяет момент на фактическом вылете, а не на удобном для расчёта. Плита ФЛ16.24 массой 2,15 т на вылете 12 м даёт 2,15 × 12 = 25,8 т·м — это укладывается даже в момент базового 16-тонного крана (48 т·м) с запасом почти вдвое. На увеличенном вылете 18 м, характерном для глубокой траншеи с отступом от края, та же плита даёт 38,7 т·м — всё ещё в пределах 48 т·м, но запас сокращается до 24 %.</p>
    <p>Для более тяжёлой ФЛ32.12 массой 3,23 т расчёт меняется: на вылете 18 м это 58,1 т·м — больше момента 16-тонного крана, нужен класс 25 т с моментом 85 т·м. МОСКРАН-СЕРВИС делит момент на массу как предварительный отсев класса техники, а окончательную грузоподъёмность на конкретном вылете берёт из таблицы паспорта машины, которая поедет на объект — методика подробнее разобрана в <a href="/spravochnik/gruzovysotnaya-harakteristika/" style="color:var(--yellow)">материале о грузовысотной характеристике</a>.</p>

    <h2 id="stropovka" style="margin:36px 0 16px">Строповка за монтажные петли</h2>
    <p>ГОСТ 13015-2012 требует поднимать железобетонные изделия, включая плиты ФЛ, за монтажные (грузоподъёмные) петли, которые завод закладывает и рассчитывает именно под строповку, а не за произвольную арматуру на поверхности. Крановщик МОСКРАН-СЕРВИС цепляет обе петли плиты одновременно стропами одинаковой длины и несущей способности — иначе плиту перекосит при опускании на дно траншеи, где поправить положение сложнее, чем на открытой площадке.</p>
    <p>Перед опусканием крановщик МОСКРАН-СЕРВИС проверяет дно траншеи на наличие людей и оборудования под грузом — по п. 114 ФНП №461 перемещать груз над людьми запрещено, а в траншее работающий персонал находится буквально под точкой опускания. Общий разбор этого требования — в <a href="/spravochnik/peremeshchenie-gruza-nad-lyudmi/" style="color:var(--yellow)">материале о перемещении груза над людьми</a>.</p>

    <h2 id="primer" style="margin:36px 0 16px">Пример: лента дома 10×12 м</h2>
    <p>Периметр ленточного фундамента дома 10 × 12 м — 44 м. При длине плиты 2,38 м это 44 / 2,38 ≈ 18,5, то есть 19 плит на весь контур. Для плиты ФЛ16.24 массой 2,15 т общий вес плит на объекте — 19 × 2,15 ≈ 40,9 т, но кран поднимает их по одной, а не все сразу: расчёт класса техники идёт по моменту одной плиты на рабочем вылете, а не по суммарной массе материала.</p>
    <p>Если траншея такого дома проходит на вылете 12–14 м от точки стоянки крана, одна плита ФЛ16.24 даёт 25,8–30,1 т·м — класс 16–20 т (17 600 ₽ за смену) закрывает задачу с запасом. Если же проект требует более широкую подошву — ФЛ24.30 (5,98 т на максимальной ширине серии) — на том же вылете момент достигает 71,8–83,7 т·м, и МОСКРАН-СЕРВИС подаёт класс 25 т (20 800 ₽) даже без увеличения вылета.</p>

    <h2 id="stoimost" style="margin:36px 0 16px">Сколько стоит смена</h2>
    <p>Смена класса 16–20 т в МОСКРАН-СЕРВИС стоит 17 600 ₽, класса 25 т — 20 800 ₽; при выезде в зону платного пропуска добавляется коэффициент 1,12, разобранный в <a href="/spravochnik/stoimost-arendy-avtokrana/" style="color:var(--yellow)">материале о стоимости аренды автокрана</a>. Монтаж ленты из 19 плит ФЛ16.24 крановщик с бригадой обычно укладывает в одну смену на доступном для техники грунте; на участке со сложным подъездом или глубокой траншеей время растягивается, и расчёт смен МОСКРАН-СЕРВИС уточняет после осмотра площадки.</p>
    <p>Переход с класса 16–20 т на 25 т при тяжёлых плитах стоит дополнительно 3 200 ₽ за смену — дешевле, чем повторный выезд техники, если на объекте окажется плита за пределами таблицы меньшего крана. Как читать таблицу и подавать заявку с нужными параметрами — в материале <a href="/spravochnik/zayavka-na-avtokran/" style="color:var(--yellow)">«Заявка на автокран»</a>.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: монтаж плит ФЛ автокраном</h2>
    <ul>
      <li>Масса по ГОСТ 13580-2021: ФЛ6.24 — 0,93 т, ФЛ16.24 — 2,15 т, ФЛ32.12 — 3,23 т, максимум серии — 5,98 т.</li>
      <li>ГОСТ 13580-85 отменён с 01.09.2022 — действует ГОСТ 13580-2021.</li>
      <li>Кран стоит в стороне от траншеи — вылет больше, чем при монтаже ФБС на спланированной площадке.</li>
      <li>Строповка — только за монтажные петли по ГОСТ 13015-2012, двумя стропами одновременно.</li>
      <li>Класс 16–20 т (17 600 ₽) закрывает большинство частных лент; широкие и глубокие — класс 25 т (20 800 ₽).</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://axelhouse.ru/plity-lentochnogo-fundamenta.html" target="_blank" rel="noopener" style="color:var(--yellow)">Размеры и вес плит ленточного фундамента ФЛ</a> — таблица марок и массы ФЛ6.24–ФЛ32.12.</li>
      <li><a href="https://gostassistent.ru/doc/fad2b111-dd88-45f0-b7ab-136108520574" target="_blank" rel="noopener" style="color:var(--yellow)">ГОСТ 13580-2021 (с поправкой ред. от 01.09.2023)</a> — действует с 01.09.2022 вместо ГОСТ 13580-85.</li>
      <li><a href="https://sudact.ru/law/prikaz-rostekhnadzora-ot-26112020-n-461-ob/federalnye-normy-i-pravila-v/vi/ustanovka-ps-i-proizvodstvo-rabot/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461, раздел VI «Установка ПС и производство работ» (ред. от 16.04.2026)</a> — п. 108–110, 114.</li>
      <li><a href="/" style="color:var(--yellow)">Ставки МОСКРАН-СЕРВИС</a> — главная страница сайта, действуют до 17.02.2027.</li>
    </ul>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-16-25-tonn/">Аренда автокрана 16–25 тонн →</a></section>
</main>
</SpravochnikLayout>
