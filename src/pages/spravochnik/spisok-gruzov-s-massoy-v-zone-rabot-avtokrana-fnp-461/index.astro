---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = 'Список грузов с массой для автокрана: п. 217 ФНП 461';
const description = 'Список грузов с массой в зоне работ автокрана выдают на руки крановщику и стропальщику (п. 217 «д» ФНП №461). Груз без маркировки веса — под ИТР (п. 127).';

const CHECKED = '16.10.2026';
const PUBLISHED = '2026-10-16';
const SLUG = 'spisok-gruzov-s-massoy-v-zone-rabot-avtokrana-fnp-461';
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: 'Обязан ли заказчик давать список грузов с массой при аренде автокрана?',
    a: 'Список размещает в зоне работ эксплуатирующая организация крана (п. 217 «д» ФНП №461). Для арендованного автокрана с экипажем это МОСКРАН-СЕРВИС, но исходные массы грузов называет заказчик в заявке. Без них список составить нельзя.',
  },
  {
    q: 'Кому список выдают на руки?',
    a: 'Крановщикам (операторам) и стропальщикам, которые обслуживают краны стрелового типа, краны-манипуляторы и краны-трубоукладчики при строительно-монтажных работах (п. 217 «д» ФНП №461). Автокран относится к стреловым самоходным кранам, поэтому МОСКРАН-СЕРВИС выдаёт список экипажу и стропальщикам.',
  },
  {
    q: 'Можно ли поднимать груз, если на нём нет маркировки веса?',
    a: 'Можно, но только под непосредственным руководством инженерно-технического работника, ответственного за безопасное производство работ с применением ПС (п. 127 ФНП №461). Крановщик в одиночку такое решение не принимает. МОСКРАН-СЕРВИС до этого момента подъём не начинает.',
  },
  {
    q: 'Что делать, если вес груза неизвестен совсем?',
    a: 'Поднимать нельзя: п. 114 ФНП №461 запрещает подъём груза, масса которого неизвестна. Способа определения массы норма не называет. Практика МОСКРАН-СЕРВИС: взвесить груз или взять массу из паспорта изделия, и только потом поднимать.',
  },
  {
    q: 'Должен ли список висеть на самом кране?',
    a: 'Норма требует разместить список в зоне производства работ, а не на кабине. Конкретное место МОСКРАН-СЕРВИС выбирает так, чтобы стропальщик видел список до зацепки: у поста стропальщиков или у входа на площадку.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Список грузов с массой в зоне работ автокрана по ФНП №461', item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ['spisok', 'Что требует п. 217 «д» и кому выдают список'],
  ['bez-vesa', 'Груз без маркировки веса: п. 127'],
  ['sostav', 'Что включить в список грузов'],
  ['zayavka', 'Какие данные заказчик даёт в заявке'],
  ['moskva', 'Как это выглядит на московской площадке'],
  ['faq', 'Частые вопросы'],
  ['istochniki', 'Источники'],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Список грузов с массой в зоне работ автокрана по ФНП №461</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">ФНП №461 · Грузы и документы</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Нужен ли список грузов с массой на площадке автокрана и что делать с грузом без маркировки веса?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>16.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>16.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>5 мин чтения</span>
    </div>

    <p>Пункт 217 «д» ФНП №461 требует разместить в зоне работ крана список основных перемещаемых грузов с массой и выдать его на руки крановщику и стропальщикам. Груз без маркировки веса поднимают только под руководством ответственного ИТР (п. 127). МОСКРАН-СЕРВИС просит массы грузов у заказчика до выезда автокрана.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="spisok" style="margin:36px 0 16px">Что требует п. 217 «д» и кому выдают список</h2>
    <p>Подпункт «д» п. 217 ФНП №461 относит размещение списка к функциям эксплуатирующей организации: в зоне производства работ должен быть список основных перемещаемых краном грузов с указанием массы. Для самоходного автокрана эксплуатирующая организация — владелец крана, то есть МОСКРАН-СЕРВИС при аренде с экипажем. Список составляется на основе данных заказчика о грузах.</p>
    <p>Для кранов стрелового типа, кранов-манипуляторов и кранов-трубоукладчиков при строительно-монтажных работах норма добавляет: список выдаётся на руки крановщикам (операторам) и стропальщикам. Автокран КС-55713 «Клинцы» — кран стрелового типа, поэтому МОСКРАН-СЕРВИС передаёт список крановщику и стропальщику лично, а не оставляет в общей папке на столе прораба.</p>

    <h2 id="bez-vesa" style="margin:36px 0 16px">Груз без маркировки веса: п. 127</h2>
    <p>Работа ПС при отсутствии маркировки веса груза и схем строповки допускается только под непосредственным руководством инженерно-технического работника, ответственного за безопасное производство работ с применением ПС (п. 127 ФНП №461). Тот же абзац ставит под такое руководство подъём несколькими кранами и погрузку полувагонов. МОСКРАН-СЕРВИС не поднимает немаркированный груз, пока ответственный не стоит на площадке.</p>
    <p>Отсутствие маркировки и неизвестная масса — разные ситуации. Если масса груза неизвестна вовсе, п. 114 ФНП №461 запрещает подъём; если масса установлена, но маркировки на грузе нет, действует п. 127 с руководством ИТР. МОСКРАН-СЕРВИС сначала выясняет массу, а уже потом решает, нужен ли ИТР на площадке.</p>
    <p>Норма не называет способ определения массы, поэтому «на глаз» — не метод. Как узнать вес, решает ППР или техкарта; о схемах строповки читайте в справке о <a href="/spravochnik/shemy-stropovki-gruzov/" style="color:var(--yellow)">схемах строповки грузов</a>, о взвешивании — в материале о <a href="/spravochnik/massa-tary-vzveshivanie/" style="color:var(--yellow)">массе тары и взвешивании</a>. МОСКРАН-СЕРВИС при сомнении принимает наибольшую из возможных масс и сверяет её с грузовой характеристикой крана.</p>

    <h2 id="sostav" style="margin:36px 0 16px">Что включить в список грузов</h2>
    <p>Пункт 217 «д» ФНП №461 требует «основные» грузы и их массу, но не задаёт форму списка. Практичный список МОСКРАН-СЕРВИС строится по принципу «одна строка — один тип груза», чтобы стропальщик нашёл нужную позицию за несколько секунд. Форма ниже — рабочая практика, а не требование ФНП.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Графа списка</th><th>Зачем нужна</th><th>Откуда данные</th></tr></thead>
        <tbody>
          <tr><td>Наименование груза</td><td>стропальщик узнаёт позицию на месте</td><td>заявка заказчика</td></tr>
          <tr><td>Масса одного места, кг</td><td>выбор крана и вылета по грузовой характеристике</td><td>паспорт изделия, маркировка, взвешивание</td></tr>
          <tr><td>Масса с оснасткой</td><td>строп, траверса и тара входят в нагрузку на крюк</td><td>паспорта грузозахватных приспособлений</td></tr>
          <tr><td>Схема строповки</td><td>показывает, как стропить без перекоса</td><td>ППР, техкарта, документы на изделие</td></tr>
        </tbody>
      </table>
    </div>
    <p>Масса оснастки в норме отдельно не названа, но п. 217 «г» требует маркированные приспособления, соответствующие массе груза. Поэтому МОСКРАН-СЕРВИС при проверке нагрузки на крюк складывает вес груза и вес приспособлений, а выбор вылета делает по <a href="/spravochnik/gruzovysotnaya-harakteristika/" style="color:var(--yellow)">грузовой характеристике</a> конкретной машины.</p>

    <h2 id="zayavka" style="margin:36px 0 16px">Какие данные заказчик даёт в заявке</h2>
    <p>Список по п. 217 «д» ФНП №461 нельзя составить без данных заказчика: массы, габариты и количество мест известны ему, а не владельцу крана. Поэтому в заявку на автокран МОСКРАН-СЕРВИС просит указать перечень грузов с массой каждого места. Подробности по самой заявке собраны в справке о <a href="/spravochnik/zayavka-na-avtokran/" style="color:var(--yellow)">заявке на автокран</a>.</p>
    <ul>
      <li>МОСКРАН-СЕРВИС просит наименование и массу каждого типа груза, а не только самого тяжёлого.</li>
      <li>МОСКРАН-СЕРВИС уточняет, есть ли у груза заводская маркировка веса и схема строповки.</li>
      <li>МОСКРАН-СЕРВИС спрашивает, кто на стороне заказчика отвечает за безопасное производство работ, — см. <a href="/spravochnik/otvetstvennyy-za-bezopasnoe-proizvodstvo/" style="color:var(--yellow)">ответственного за безопасное производство работ</a>.</li>
      <li>МОСКРАН-СЕРВИС просит заранее сообщить, если масса определена расчётом, а не взвешиванием.</li>
    </ul>

    <h2 id="moskva" style="margin:36px 0 16px">Как это выглядит на московской площадке</h2>
    <p>На московской стройплощадке с автокраном КС-65713-1 «Галичанин» список грузов обычно умещается на один лист: бытовки, металлоконструкции, плиты, ящики с оборудованием. Один лист у стропальщика надёжнее, чем десять паспортов в офисе. МОСКРАН-СЕРВИС печатает его до смены и сверяет с накладными, которые привозит транспорт с грузом.</p>
    <p>Если на площадку внезапно приехал груз, которого нет в списке, МОСКРАН-СЕРВИС не добавляет строку «на словах». Масса вносится в список письменно с подписью ответственного, и только после этого стропальщик зацепляет груз. Этот порядок — практика МОСКРАН-СЕРВИС для соблюдения п. 217 «д», в норме он так не расписан.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: список грузов и масса</h2>
    <ul>
      <li>МОСКРАН-СЕРВИС размещает в зоне работ список основных грузов с массой (п. 217 «д» ФНП №461).</li>
      <li>Крановщику и стропальщикам автокрана МОСКРАН-СЕРВИС выдаёт список на руки.</li>
      <li>Груз без маркировки веса МОСКРАН-СЕРВИС поднимает только под руководством ответственного ИТР (п. 127).</li>
      <li>Массы грузов МОСКРАН-СЕРВИС запрашивает у заказчика в заявке, а не оценивает на глаз.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://www.consultant.ru/document/cons_doc_LAW_373321/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 (приказ Ростехнадзора от 26.11.2020 №461)</a> — п. 114 (запрет подъёма груза неизвестной массы), п. 127 (подъём без маркировки веса и схем строповки), п. 217 «г» и «д» (приспособления по массе груза, список грузов).</li>
      <li><a href="https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 на legalacts.ru</a> — редакция от 16.04.2026, текст пунктов 114, 127 и 217 сверен 16.10.2026.</li>
    </ul>
    <p class="small muted">Форма списка, порядок письменного добавления груза и сверка с накладными — практика МОСКРАН-СЕРВИС, а не пункты нормы.</p>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-16-25-tonn/">Аренда автокрана 16–25 тонн →</a></section>
</main>
</SpravochnikLayout>
