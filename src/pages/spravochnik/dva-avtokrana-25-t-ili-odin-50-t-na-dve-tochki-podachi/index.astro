---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = "Два автокрана 25 т или один 50 т: что дешевле на две точки";
const description = "Смена крана 50 т стоит 31 200 ₽, двух кранов по 25 т — 41 600 ₽ (ставки МОСКРАН-СЕРВИС на 26.10.2026); выбор зависит от числа смен и нормы 5 м между кранами.";

const CHECKED = '26.10.2026';
const PUBLISHED = '2026-10-26';
const SLUG = "dva-avtokrana-25-t-ili-odin-50-t-na-dve-tochki-podachi";
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    "q": "Что дешевле: два автокрана по 25 тонн или один на 50 тонн?",
    "a": "Если работа укладывается в одну смену, один кран 50 т дешевле: 3 900 × 8 = 31 200 ₽ против 2 600 × 8 × 2 = 41 600 ₽ за пару по 25 т (ставки МОСКРАН-СЕРВИС на 26.10.2026, без дополнительных услуг). Если для 50-тонного крана нужны две смены, пара по 25 т дешевле: 62 400 ₽ против 41 600 ₽."
  },
  {
    "q": "Хватит ли одного крана 25 т на две точки, если растянуть работу на две смены?",
    "a": "По стоимости да: две смены крана 25 т — 2 600 × 8 × 2 = 41 600 ₽, столько же, сколько два крана за одну смену. Подходит, если груз и вылет укладываются в грузовысотную характеристику 25-тонного крана и срок работ не критичен."
  },
  {
    "q": "Можно ли ставить два автокрана рядом на одной площадке?",
    "a": "Можно, если соблюдается п. 160 ФНП №461: расстояние по горизонтали между кранами, их стрелами, стрелой одного крана и грузом на стреле другого, а также между грузами — не менее 5 м. На стеснённой площадке при ограничении зоны работы кранов нужен ППР (п. 98)."
  },
  {
    "q": "Могут ли два автокрана по 25 тонн поднять груз вместе?",
    "a": "Только по ППР или технологической карте, и нагрузка на каждый кран не должна превышать его грузоподъёмность (п. 127 ФНП №461). Работу ведёт под непосредственным руководством инженерно-технический работник, ответственный за безопасное производство работ. Это отдельная задача, не равная разной подаче на две точки."
  },
  {
    "q": "Входят ли в ставку подача крана и выходные?",
    "a": "Нет. По справке МОСКРАН-СЕРВИС о стоимости в часовую ставку не входят подача техники (зависит от удалённости площадки от базы), выходные и праздники (отдельный тариф) и простой по вине заказчика. Оплата экипажа уже внутри ставки, а на режимном объекте применяется коэффициент 1,12."
  }
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: "Два автокрана 25 т или один 50 т", item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [["formula", "Из чего складывается разница в цене"], ["sravnenie", "Сравнение вариантов на две точки подачи"], ["pravilo", "Правило выбора по числу смен"], ["norma", "Что говорит ФНП №461 про два крана на площадке"], ["harakteristika", "Когда 25 тонн не хватает по вылету"], ["rezhim", "Как меняется расчёт на режимном объекте"], ["faq", "Частые вопросы"], ["istochniki", "Источники"]];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Два автокрана 25 т или один 50 т</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Выбор тоннажа · Стоимость</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Два автокрана по 25 тонн или один на 50 тонн: что дешевле на две точки подачи?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>26.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>26.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>7 мин чтения</span>
    </div>

    <p>Одна смена автокрана 50 т в МОСКРАН-СЕРВИС стоит 31 200 ₽, а два крана по 25 т за ту же смену — 41 600 ₽: пара дороже на 10 400 ₽. Картина меняется, когда один 50-тонный кран нужен на две смены (62 400 ₽): тогда пара по 25 т выигрывает на 20 800 ₽. Решает число смен и вес самого тяжёлого груза, а не тоннаж «на всякий случай». Расчёт ниже — арифметика по опубликованным ставкам, без подачи, выходных и простоя.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="formula" style="margin:36px 0 16px">Из чего складывается разница в цене</h2>
    <p>Стоимость аренды в МОСКРАН-СЕРВИС считается как ставка за час × 8 часов × число смен; на режимном объекте с пропуском ставка умножается на 1,12. Ставки на 26.10.2026 взяты с главной страницы сайта: 25 т — 2 600 ₽/час, 50 т — 3 900 ₽/час. Полную схему расчёта и список того, что не входит в ставку, даёт справка о <a href="/spravochnik/stoimost-arendy-avtokrana/" style="color:var(--yellow)">стоимости аренды автокрана</a>.</p>
    <p>Из ставок видно, что кран 50 т в 1,5 раза дороже крана 25 т за час (3 900 / 2 600), а два крана 25 т дороже одного 50 т в 1,33 раза (5 200 / 3 900). Поэтому пара по 25 т выгодна только там, где она экономит смену.</p>

    <h2 id="sravnenie" style="margin:36px 0 16px">Сравнение вариантов на две точки подачи</h2>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Вариант</th><th>Смен</th><th>Расчёт</th><th>Итого, ₽</th></tr></thead>
        <tbody>
          <tr><td>1 кран 25 т</td><td>1</td><td>2 600 × 8 × 1</td><td>20 800</td></tr>
          <tr><td>1 кран 25 т</td><td>2</td><td>2 600 × 8 × 2</td><td>41 600</td></tr>
          <tr><td>2 крана 25 т</td><td>1</td><td>2 600 × 8 × 2 крана</td><td>41 600</td></tr>
          <tr><td>1 кран 50 т</td><td>1</td><td>3 900 × 8 × 1</td><td>31 200</td></tr>
          <tr><td>1 кран 50 т</td><td>2</td><td>3 900 × 8 × 2</td><td>62 400</td></tr>
        </tbody>
      </table>
    </div>
    <p>Строки 2 и 3 таблицы совпадают: один 25-тонный кран за две смены стоит ровно столько же, сколько два таких крана за одну. Разницу даёт срок и совместимость с графиком: пара закрывает обе точки за один день, а один кран растягивает работу на два.</p>

    <h2 id="pravilo" style="margin:36px 0 16px">Правило выбора по числу смен</h2>
    <p>Сравнение сводится к трём вопросам. Первый: самый тяжёлый груз и вылет укладываются в грузовысотную характеристику крана 25 т? Если нет, вопрос закрыт — нужен 50 т. Второй: обе точки можно обслужить одним краном за одну смену с переездом? Тогда 50 т дешевле пары (31 200 против 41 600 ₽), а при подходящем 25 т выгоднее всего одиночный 25 т (20 800 ₽). Третий: работа не укладывается в одну смену на 50 т? Тогда пара по 25 т дешевле двух смен 50 т (41 600 против 62 400 ₽).</p>
    <p>Три порога МОСКРАН-СЕРВИС проверяет на этапе заявки, до подачи крана. Если заказчик называет только общий тоннаж, диспетчер спрашивает массу самого тяжёлого груза и расстояние между точками.</p>

    <h2 id="norma" style="margin:36px 0 16px">Что говорит ФНП №461 про два крана на площадке</h2>
    <p>Два автокрана на одной площадке допустимы при соблюдении п. 160 ФНП №461: между кранами, их стрелами, стрелой одного и грузом на стреле другого, а также между перемещаемыми грузами должно быть не менее 5 м по горизонтали. Это же расстояние действует для кранов разных типов на одной стройплощадке. Для двора с ограниченной зоной перемещения кранов и грузов нужен ППР (п. 98), о котором написано в справке про <a href="/spravochnik/ppr-ili-tehnologicheskaya-karta-avtokran-fnp-461/" style="color:var(--yellow)">ППР и технологическую карту</a>.</p>
    <p>Подъём одного груза двумя кранами — отдельный случай. Он допускается только по ППР или технологической карте, нагрузка на каждый кран не должна превышать его грузоподъёмность, а работу ведёт инженерно-технический работник, ответственный за безопасное производство работ (п. 127). Схема тандемного подъёма описана в справке о <a href="/spravochnik/podyom-gruza-dvumya-kranami/" style="color:var(--yellow)">подъёме груза двумя кранами</a>, и к сравнению цен на две точки подачи она не относится.</p>

    <h2 id="harakteristika" style="margin:36px 0 16px">Когда 25 тонн не хватает по вылету</h2>
    <p>Тоннаж в названии крана — максимальная грузоподъёмность на минимальном вылете, а реальную нагрузку на нужном вылете задаёт грузовысотная характеристика. Для двух точек подачи это важно: ближняя точка может укладываться в 25 т, а дальняя на большом вылете — нет. Тогда пара «25 + 25» не подходит, и МОСКРАН-СЕРВИС предлагает 50 т на обе точки или 25 т и 50 т по отдельности. Как читать таблицу вылетов, показано в справке про <a href="/spravochnik/gruzovysotnaya-harakteristika/" style="color:var(--yellow)">грузовысотную характеристику</a>.</p>

    <h2 id="rezhim" style="margin:36px 0 16px">Как меняется расчёт на режимном объекте</h2>
    <p>На режимном объекте с пропуском МОСКРАН-СЕРВИС умножает ставку на 1,12: один кран 50 т за смену — 31 200 × 1,12 = 34 944 ₽, два крана 25 т за смену — 41 600 × 1,12 = 46 592 ₽. Разница между вариантами растёт с 10 400 до 11 648 ₽, но порядок вариантов не меняется. Коэффициент покрывает оформление пропуска на технику и бригаду; сколько машин пропустит объект, диспетчер уточняет до подтверждения заявки.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: два крана 25 т или один 50 т</h2>
    <ul>
      <li>Одна смена: 50 т — 31 200 ₽, два по 25 т — 41 600 ₽ (ставки МОСКРАН-СЕРВИС на 26.10.2026).</li>
      <li>Две смены 50 т (62 400 ₽) дороже пары по 25 т за одну смену (41 600 ₽).</li>
      <li>Один кран 25 т за две смены стоит как два крана за одну — 41 600 ₽.</li>
      <li>Два крана на площадке: не менее 5 м между кранами, стрелами и грузами (п. 160 ФНП №461).</li>
      <li>Первое условие выбора — грузовысотная характеристика, а не цена.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://moskran-servis.ru/" style="color:var(--yellow)">Главная страница МОСКРАН-СЕРВИС</a> — часовые ставки 25 т и 50 т, смена 8 часов, коэффициент 1,12 для режимного объекта (на 26.10.2026).</li>
      <li><a href="https://www.consultant.ru/document/cons_doc_LAW_373321/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 (приказ Ростехнадзора от 26.11.2020 №461)</a> — пп. 98, 127, 160 (ППР в стеснённых условиях, подъём несколькими кранами, 5 м между кранами).</li>
      <li><a href="https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 на legalacts.ru</a> — текст пунктов сверен 26.10.2026.</li>
    </ul>
    <p class="small muted">Расчёты — арифметика по опубликованным ставкам; итоговую цену фиксирует диспетчер МОСКРАН-СЕРВИС при подтверждении заявки.</p>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-25-40-tonn/">Аренда автокрана 25–40 тонн →</a></section>
</main>
</SpravochnikLayout>
