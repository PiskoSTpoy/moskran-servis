    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Подъём людей краном', item: 'https://moskran-servis.ru/spravochnik/podyom-lyudey-kranom/' },
  ],
};
