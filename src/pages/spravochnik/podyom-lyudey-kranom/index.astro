---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';
import Sources from '../../../components/Sources.astro';

const title = 'Подъём людей краном: когда это разрешено по ФНП №461';
const description = 'В паспорте автокрана обычно нет разрешения возить людей — но ФНП №461 всё равно допускает подъём в люльке как исключение: при монтаже и строительстве, если другого способа добраться до места работ нет. Разбираем условия, скорость, связь и кто принимает решение.';

const CHECKED = '10.09.2026';

const faqs = [
  {
    q: 'В паспорте нашего крана нет разрешения на подъём людей — значит, это в принципе запрещено?',
    a: 'Не значит. Отдельное разрешение в паспорте нужно для штатной, повторяющейся операции — когда кран изначально проектировался и испытывался для транспортировки людей. ФНП №461 отдельно допускает и другой случай: подъём и перемещение людей краном, в паспорте которого такого разрешения нет, — но только как исключение, при монтажных, строительных и подобных работах, когда никаким другим способом доставить рабочих в зону выполнения работ нельзя. Это разовое, обоснованное решение под конкретную задачу, а не постоянный режим эксплуатации машины.',
  },
  {
    q: 'Кто решает, что люльку можно вводить в работу — крановщик на месте или кто-то ещё?',
    a: 'Крановщик такое решение принимать не вправе. Ввод в работу специальной съёмной кабины или люльки, подвешиваемой на грузозахватном органе крана для подъёма людей, оформляется инженерно-техническим работником, ответственным за производственный контроль при эксплуатации подъёмных сооружений, — и только по результатам успешных статических испытаний самой люльки. Это письменное решение конкретного ответственного лица под конкретную операцию, а не разовая договорённость на площадке.',
  },
  {
    q: 'Какая скорость подъёма и запас грузоподъёмности допустимы при подъёме людей?',
    a: 'Скорость вертикального перемещения кабины или люльки с людьми не должна превышать 20 метров в минуту — заметно медленнее, чем обычный подъём груза. Отдельно нормируется запас грузоподъёмности: кран должен иметь не менее чем двукратный запас по сравнению с суммой массы самой люльки, массы подвешивающего её устройства и номинальной грузоподъёмности люльки. Оба требования снижают динамические нагрузки и запас на случай нештатной ситуации — здесь техника сознательно работает в режиме ниже своего предела, а не на границе паспортных характеристик.',
  },
  {
    q: 'Как крановщик поддерживает связь с людьми в люльке во время подъёма?',
    a: 'Требование зависит от высоты подъёма. До 10 метров связь может поддерживаться голосом. Свыше 10 метров голос уже ненадёжен — используется знаковая сигнализация по установленной таблице сигналов. Свыше 22 метров сигналы тоже перестают быть надёжным способом связи, и требуется радио- или телефонная связь между крановщиком и людьми в кабине. Ступенчатая система рассчитана на то, что с ростом высоты дальше растут и ветер, и расстояние, и цена ошибки в передаче сигнала.',
  },
  {
    q: 'Можно ли одновременно поднимать людей в люльке и груз на другом крюке того же крана?',
    a: 'Нет. Одновременный подъём и перемещение краном груза и людей не допускается — как и подъём людей, находящихся на весах или ином вспомогательном приспособлении, не предназначенном именно для транспортировки людей. Пока в люльке находятся люди, кран занят только этой операцией — второй, параллельной задачи в это время у машины быть не может.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
