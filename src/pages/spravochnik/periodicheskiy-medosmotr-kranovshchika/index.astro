---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';
import Sources from '../../../components/Sources.astro';

const title = 'Периодический медицинский осмотр крановщика: чем отличается от предрейсового';
const description = 'Кроме ежедневного предрейсового осмотра водителя автокрана, крановщик обязан раз в год проходить периодический медицинский осмотр по приказу Минздрава №29н — из-за вибрации и шума на рабочем месте.';

const CHECKED = '17.09.2026';

const faqs = [
  {
    q: 'Чем периодический медицинский осмотр крановщика отличается от предрейсового?',
    a: 'Это разные процедуры с разной периодичностью и разной нормативной базой. Предрейсовый осмотр, о котором справочник писал в отдельной статье, — короткая ежедневная проверка водителя перед выездом по приказу Минздрава №266н: давление, пульс, признаки алкогольного опьянения. Периодический медицинский осмотр по приказу Минздрава №29н — это, как правило, ежегодная комиссия врачей нескольких специальностей с лабораторными и функциональными исследованиями, задача которой — выявить профессиональные заболевания и противопоказания к работе с конкретными вредными факторами, которые действуют на крановщика постоянно, а не в моменте перед одной сменой.',
  },
  {
    q: 'Почему крановщик обязан проходить периодический медосмотр — он же не работает в цехе с вредным производством?',
    a: 'Обязанность не связана с понятием «цех» или «вредное производство» в бытовом смысле — она привязана к конкретным вредным и опасным производственным факторам из перечня, утверждённого приказом Минтруда России №988н, который применяется вместе с приказом Минздрава №29н. У крановщика (машиниста крана автомобильного) в этот перечень обычно попадает общая вибрация от работы механизмов и шасси и производственный шум от двигателя и лебёдки — этого достаточно, чтобы должность попала в список работ с обязательным периодическим осмотром, независимо от того, где физически находится рабочее место — в цехе или на открытой площадке.',
  },
  {
    q: 'Кто направляет крановщика на периодический медосмотр и за чей счёт он проводится?',
    a: 'Список сотрудников, подлежащих периодическому осмотру (контингент), формирует работодатель на основании результатов специальной оценки условий труда — о которой справочник писал отдельно — и перечня вредных факторов по приказу №988н. Направление на осмотр выдаёт тоже работодатель, а расходы по статье 213 Трудового кодекса РФ несёт он же: удерживать стоимость осмотра из зарплаты крановщика или требовать оплаты вперёд работодатель не вправе.',
  },
  {
    q: 'Что грозит, если допустить крановщика к работе без действующего периодического медосмотра?',
    a: 'Часть 3 статьи 5.27.1 КоАП РФ — «Допуск работника к исполнению им трудовых обязанностей без прохождения в установленном порядке обязательных периодических медицинских осмотров»: штраф от 15 000 до 25 000 рублей для должностных лиц и индивидуальных предпринимателей, от 110 000 до 130 000 рублей для юридических лиц. Дополнительный риск для эксплуатирующей организации — при несчастном случае с крановщиком без действующего медосмотра расследование почти неизбежно фиксирует это как отягчающее нарушение, а не формальную недоработку кадровой службы.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Периодический медосмотр крановщика', item: 'https://moskran-servis.ru/spravochnik/periodicheskiy-medosmotr-kranovshchika/' },
  ],
};
