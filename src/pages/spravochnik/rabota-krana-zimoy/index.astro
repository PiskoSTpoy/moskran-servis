---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';
import Sources from '../../../components/Sources.astro';

const title = 'Зимняя смена крана в Москве: световой день и гололёд';
const description = '22 декабря в Москве светло 6 часов 59 минут. Разбираем, как это ломает смену, какие нормы освещённости действуют и что реагенты делают с площадкой.';

const CHECKED = '12.08.2026';

/* --- Волна 14 (дедупликация сети) -------------------------------------------
   Прежняя версия статьи разбирала работоспособность техники до −40°C, холодное
   исполнение до −60°C и ГОСТ 15150 — то есть тему климатического исполнения,
   которая закреплена за северным сайтом сети и к московской зиме отношения
   почти не имеет: в Москве такие морозы не рабочий сценарий. Статья сужена до
   того, что действительно ограничивает зимнюю смену в Москве и чего нет ни у
   одного другого региона сети в таком виде: длина светового дня по московской
   широте, нормированное освещение площадки, городская обработка дворов
   противогололёдными материалами и уплотнённая наледь под выносными опорами.
   Факты проверены 12.08.2026, реквизиты — в блоке «Источники». */

const faqs = [
  { q: 'Сколько часов светло в Москве в декабре?', a: 'В день зимнего солнцестояния, 22 декабря, солнце в Москве всходит в 8:58 и заходит в 15:58 — светлое время суток длится 6 часов 59 минут. Восьмичасовая смена в этот интервал не помещается, поэтому зимой либо часть работ идёт при искусственном освещении по нормам, либо смена планируется короче.' },
  { q: 'Какая освещённость нужна, чтобы работать краном в темноте?', a: 'По ГОСТ 12.1.046-2014 при погрузке и установке оборудования грузоподъёмными кранами нормируется 50 лк на горизонтальной плоскости площадки приёма материалов и 20 лк на вертикальной плоскости на крюке крана; при монтаже строительных конструкций — 30 лк по всей высоте сборки. Освещение площадки — обычно зона ответственности генподрядчика или заказчика объекта, а не подрядчика по крану.' },
  { q: 'Почему нельзя ставить выносную опору прямо на укатанный снег?', a: 'Потому что под ним неизвестно что: наледь, обработанная реагентом талая каша или пустота от растаявшего снега у бордюра. Опора, установленная на такой слой, может просесть или сдвинуться уже под нагрузкой, когда груз висит. Пятно под каждой опорой расчищается до твёрдого основания, и только после этого выкладываются подкладки.' },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Кран зимой в Москве', item: 'https://moskran-servis.ru/spravochnik/rabota-krana-zimoy/' },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@id': 'https://moskran-servis.ru/#organization' }, // ссылка на единственный узел организации (BaseLayout): отдельный узел с тем же @id, но другим name, был противоречием в графе
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: 'https://moskran-servis.ru/spravochnik/rabota-krana-zimoy/',
  inLanguage: 'ru-RU',
  datePublished: '2026-08-12',
  dateModified: '2026-08-12',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<SpravochnikLayout title={title} description={description} path="/spravochnik/rabota-krana-zimoy/" slug="rabota-krana-zimoy" ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Кран зимой в Москве</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Разбор для заказчика</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Кран зимой в Москве: световой день, гололёд и реальное окно смены</h1>
    <p class="ref-byline">Инженерная служба МОСКРАН-СЕРВИС · обновлено 12.08.2026</p>

    <p>Зимнюю заявку в Москве обычно срывает не мороз. Морозы, при которых встаёт техника обычного исполнения, для московской широты не рабочий сценарий, и обсуждать их здесь смысла нет — климатическое исполнение крана это тема северных регионов, а не Садового кольца. Ломается зимняя смена в городе по трём другим причинам: света мало, под ногами не то, что кажется, и вечернюю границу двигать некуда.</p>

    <h2 style="margin:36px 0 16px">Главный зимний ограничитель — не градусник, а закат</h2>
    <p>В день зимнего солнцестояния, 22 декабря, в Москве солнце всходит в 8:58 и заходит в 15:58. Светлое время суток — 6 часов 59 минут. Это меньше стандартной восьмичасовой смены, и разница не косметическая: если бригада заехала в 9:00 и полчаса ушло на расстановку и ограждение опасной зоны, к 15:00 уже нужно думать не о последнем подъёме, а о сворачивании.</p>
    <p>Отсюда практическое следствие, которое стоит закладывать в график объекта: зимняя смена в Москве — это либо усечённая по времени работа целиком при дневном свете, либо работа с нормативным искусственным освещением. Третьего варианта — «доработаем в сумерках, там немного осталось» — не существует, и это не наша осторожность, а нормируемая величина.</p>

    <h2 style="margin:36px 0 16px">Сколько света нужно по норме</h2>
    <p>Освещённость на строительной площадке нормирована ГОСТ 12.1.046-2014. Для крановых операций значения такие:</p>
    <table class="ttx">
      <tbody>
        <tr><td>Погрузка и установка оборудования грузоподъёмными кранами — площадка приёма материалов</td><td>50 лк, горизонтальная плоскость</td></tr>
        <tr><td>То же, на крюке крана</td><td>20 лк, вертикальная плоскость</td></tr>
        <tr><td>Монтаж строительных конструкций (стальных, железобетонных, деревянных)</td><td>30 лк, вертикальная плоскость по всей высоте сборки</td></tr>
        <tr><td>Немеханизированная разгрузка и погрузка конструкций</td><td>20 лк, горизонтальная плоскость</td></tr>
        <tr><td>Автомобильные дороги на площадке</td><td>10 лк, горизонтальная плоскость</td></tr>
      </tbody>
    </table>
    <p>Обратите внимание на строку «20 лк на крюке»: нормируется не только пятно под краном, но и вертикальная плоскость по траектории груза. Прожектор, поставленный на землю и светящий вниз, эту норму не закрывает — а именно так чаще всего выглядит «освещение» на зимнем городском объекте. Подробнее про категории освещения и охранное освещение площадки — в <a href="/spravochnik/osveshchenie-ploshchadki/" style="color:var(--yellow)">отдельной статье</a>.</p>
    <p>Ответственность за освещение площадки в общем случае лежит на генподрядчике или заказчике объекта, а не на подрядчике по крану. Поэтому в зимние месяцы мы задаём вопрос про освещение на этапе расчёта заявки: выяснять его в 16:10, когда бригада уже стоит во дворе в темноте, поздно и дорого.</p>

    <h2 style="margin:36px 0 16px">Вечерняя граница: 23:00, и подвинуть её нельзя</h2>
    <p>Даже если освещение на объекте есть и норму закрывает, у московской вечерней смены есть жёсткий предел. Закон города Москвы от 12.07.2002 №42 относит к ночному времени промежуток с 23:00 до 07:00 и запрещает в это время строительные и погрузочно-разгрузочные работы, сопровождающиеся шумом, на защищаемых территориях — жилой дом и прилегающая к нему территория к ним относятся. Ответственность по статье 3.13 Кодекса города Москвы об административных правонарушениях для юридического лица — от 40 000 до 80 000 рублей.</p>
    <p>То есть зимой городская смена зажата с двух сторон: рассвет в 8:58 — снизу, 23:00 — сверху, и между ними участок, который нужно закрывать светом по норме. Планировать «на всякий случай до упора» здесь не получится.</p>

    <h2 style="margin:36px 0 16px">Что под выносной опорой на самом деле</h2>
    <p>Второй зимний фактор — основание. В Москве дворовые территории и объекты дорожного хозяйства зимой обрабатываются противогололёдными материалами по городскому регламенту: сейчас это постановление Правительства Москвы от 25.08.2025 №2050-ПП о применении противогололедных материалов для зимней уборки объектов дорожного хозяйства и дворовых территорий. Для пешехода это плюс, для выносной опоры — минус: обработанный участок это не сухой лёд и не чистый асфальт, а слой талой каши поверх твёрдого основания, толщину и однородность которого на глаз не определить.</p>
    <p>Отсюда наше зимнее правило: пятно под каждой опорой расчищается до твёрдого основания, и только потом выкладываются подкладки. Опора, поставленная на укатанный снег или на подтаявшую наледь у бордюра, может просесть или сместиться уже под нагрузкой — то есть в момент, когда груз висит и исправлять что-либо поздно. После выдвижения опор фиксация проверяется отдельно, это добавочный шаг к обычной оценке площадки, о которой мы писали в статье про <a href="/spravochnik/nesushchaya-sposobnost-grunta/" style="color:var(--yellow)">несущую способность грунта</a>.</p>
    <p>Отдельная московская мелочь, которая регулярно стоит времени: зимой во дворе сужается проезд. Снег, сдвинутый к краям, и сугробы на местах, где летом можно было встать, физически уменьшают ширину проезда и площадь под аутригеры. Летняя фотография двора зимой не годится — мы просим свежую.</p>

    <h2 style="margin:36px 0 16px">Как это выглядит в заявке</h2>
    <p>Практически зимняя заявка отличается от летней тремя вопросами, которые мы задаём дополнительно: во сколько объект реально открывается утром, есть ли на площадке освещение и кто его включает, и убирается ли двор или площадка от снега к моменту приезда техники. Ответы на эти три вопроса определяют, поместится ли работа в смену, точнее, чем марка крана.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: что запомнить</h2>
    <ul>
      <li>22 декабря в Москве светло 6 часов 59 минут (8:58–15:58) — восьмичасовая смена в светлое время не помещается.</li>
      <li>Норма по ГОСТ 12.1.046-2014: 50 лк на площадке приёма материалов, 20 лк на крюке крана, 30 лк при монтаже конструкций.</li>
      <li>Вечерняя граница жёсткая: с 23:00 шумные работы на защищаемых территориях запрещены, штраф юрлицу — от 40 000 до 80 000 рублей.</li>
      <li>Под опору идёт расчищенное до твёрдого основания пятно, а не укатанный снег и не обработанная реагентом наледь.</li>
      <li>Фото двора для зимней заявки нужно свежее: снежные отвалы съедают и проезд, и место под аутригеры.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <Sources
      checked={CHECKED}
      items={[
        { text: 'календарь восхода и захода солнца в Москве', href: 'https://pogoda.turtella.ru/russia/moscow/sun' },
        { text: 'ГОСТ 12.1.046-2014 «Строительство. Нормы освещения строительных площадок»', href: 'https://base.garant.ru/71102670/' },
        { text: 'Закон г. Москвы от 12.07.2002 №42 «О соблюдении покоя граждан и тишины в городе Москве»', href: 'https://base.garant.ru/378789/' },
        { text: 'ст. 3.13 Кодекса города Москвы об административных правонарушениях', href: 'https://moskva-pravo.ru/zakon/2007-11-21-n-45/st-3.13.html' },
        { text: 'Постановление Правительства Москвы от 25.08.2025 №2050-ПП о применении противогололедных материалов', href: 'https://www.garant.ru/hotlaw/moscow/1859248/' }
      ]}
    />
  </article>
  <section class="section wrap"><a class="btn" href="/spravochnik/osveshchenie-ploshchadki/">Нормы освещённости площадки подробно →</a></section>
</main>
<style>
  .ttx { width: 100%; border-collapse: collapse; margin: 20px 0; font-size: var(--t-md); }
  .ttx td { padding: 10px 14px; border-bottom: 1px solid var(--line); }
  .ttx td:first-child { color: var(--muted); width: 62%; }
