---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = 'Автокран рядом с деревьями в Москве: 743-ПП и ст. 4.18 КоАП';
const description = 'Кран ставят вне насаждений, технику — не ближе 2,5 м от дерева (п. 9.8 Правил 743-ПП). Повреждение дерева техникой — штраф 300 000 ₽ юрлицу (ст. 4.18 КоАП).';

const CHECKED = '10.10.2026';
const PUBLISHED = '2026-10-10';
const SLUG = 'rabota-avtokrana-ryadom-s-derevyami-v-moskve';
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: 'На каком расстоянии от дерева можно поставить автокран в Москве?',
    a: 'Пункт 9.8 Правил 743-ПП требует располагать места для установки подъёмных кранов вне насаждений и не нарушать ограждения деревьев, а стоянки машин — не ближе 2,5 м от дерева и 1,5 м от кустарника. МОСКРАН-СЕРВИС отмеряет 2,5 м от ствола до ближайшей выносной опоры и до колеса крана.',
  },
  {
    q: 'Можно ли спилить ветку, которая мешает стреле?',
    a: 'Крановщик — нет. По п. 4.1.4.18 Правил 743-ПП омолаживающая обрезка и вырубка боковых стволов требуют порубочного билета, остальные виды обрезки билета не требуют, но выполняет их правообладатель территории или его подрядчик по озеленению. МОСКРАН-СЕРВИС меняет точку стоянки или вылет, а ветки не пилит.',
  },
  {
    q: 'Какой штраф за повреждённое краном дерево?',
    a: 'По ч. 2 ст. 4.18 КоАП Москвы повреждение зелёных насаждений с применением техники наказывается штрафом 4 000–4 500 ₽ для граждан, 50 000 ₽ для должностных лиц и 300 000 ₽ для юридических лиц. Без техники (ч. 1) — 3 500–4 000 ₽ гражданам при тех же суммах для должностных и юридических лиц.',
  },
  {
    q: 'Нужен ли порубочный билет, если дерево стоит прямо на месте будущего крана?',
    a: 'На объекте строительства, реконструкции и капремонта — да: по п. 8.1.2 Правил 743-ПП уничтожение и пересадка насаждений в зоне работ идут по заключению и порубочному билету Департамента природопользования. На участке, отведённом под строительство по разрешению Мосгосстройнадзора, п. 8.1.3 допускает работы по проектной документации без билета. МОСКРАН-СЕРВИС билет не оформляет — это обязанность заказчика.',
  },
  {
    q: 'Кого нужно предупредить перед работой крана рядом с деревьями?',
    a: 'Правообладателя земельного участка территории зелёного фонда. Пункт 9.8 Правил 743-ПП обязывает согласовать с ним начало работ в зоне насаждений и уведомить об окончании не позднее чем за два дня. МОСКРАН-СЕРВИС просит заказчика приложить такое согласование к заявке на кран во дворе или сквере.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Автокран рядом с деревьями в Москве', item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ['mesto', 'Где ставить кран: п. 9.8 Правил 743-ПП'],
  ['krona', 'Стрела и крона: кто и когда режет ветки'],
  ['opory', 'Опоры, плиты и корни'],
  ['bilet', 'Порубочный билет: когда дерево мешает крану'],
  ['shtraf', 'Штраф по ст. 4.18 КоАП Москвы'],
  ['zayavka', 'Что передать при заказе'],
  ['faq', 'Частые вопросы'],
  ['istochniki', 'Источники'],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Автокран рядом с деревьями в Москве</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Московские акты · Зелёные насаждения</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Можно ли ставить автокран рядом с деревьями в Москве и чем грозит повреждение?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>10.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>10.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>6 мин чтения</span>
    </div>

    <p>Пункт 9.8 Правил, утверждённых постановлением Правительства Москвы №743-ПП, требует располагать места для установки подъёмных кранов вне зелёных насаждений, а стоянки машин и склады материалов — не ближе 2,5 м от дерева и 1,5 м от кустарника. Повреждение дерева с применением техники наказывается по ч. 2 ст. 4.18 КоАП Москвы штрафом 300 000 ₽ для юридического лица и 50 000 ₽ для должностного. МОСКРАН-СЕРВИС проверяет расстояние от опор и зоны поворота стрелы до крон на этапе заявки, а не на объекте.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="mesto" style="margin:36px 0 16px">Где ставить кран: п. 9.8 Правил 743-ПП</h2>
    <p>Пункт 9.8 Правил 743-ПП прямо называет подъёмные краны: подъездные пути и места для установки кранов располагают вне насаждений, не нарушая ограждения деревьев. Правила создания, содержания и охраны зелёных насаждений Москвы утверждены постановлением №743-ПП как приложение 1. Тот же пункт запрещает устраивать стоянки машин и складировать материалы на газонах, а также ближе 2,5 м от дерева и 1,5 м от кустарника; горючие материалы — не ближе 10 м. МОСКРАН-СЕРВИС читает норму буквально: ни колесо, ни выносная опора, ни плита под опорой не заходят в 2,5-метровую зону вокруг ствола.</p>
    <p>Практический вывод для двора: кран класса 25 т с контуром опор 5,6×4,95 м (КС-45717К-3 «Ивановец») между двумя деревьями требует коридора шириной около 10 м — 4,95 м контура плюс по 2,5 м до каждого ствола. Это инженерная оценка МОСКРАН-СЕРВИС по п. 9.8, а не норма: Правила задают только расстояние 2,5 м. Где кран ставят, когда коридор уже, и как считают отстой техники на газоне, описано в материале об <a href="/spravochnik/avtokran-na-gazone-v-moskve/" style="color:var(--yellow)">автокране на газоне в Москве</a>.</p>

    <h2 id="krona" style="margin:36px 0 16px">Стрела и крона: кто и когда режет ветки</h2>
    <p>Пункт 4.1.4.18 Правил 743-ПП разрешает без порубочного билета все виды обрезки, кроме омолаживающей и вырубки боковых стволов у многоствольных деревьев. Выполняет обрезку правообладатель территории или подрядчик по озеленению, а не крановая бригада. Крановщик МОСКРАН-СЕРВИС ветки не пилит: мешающая крона означает смену точки стоянки, другой вылет или подачу груза через гусёк над кроной. Задача заказчика — заказать обрезку заранее у балансодержателя двора или сквера.</p>
    <p>Пункт 9.8 добавляет процедуру: начало строительных работ в зоне зелёных насаждений согласовывают с правообладателем земельного участка территории зелёного фонда, об окончании уведомляют не позднее чем за два дня. Для разовой подачи бытовки во двор МОСКРАН-СЕРВИС просит заказчика приложить к заявке письмо управляющей организации или балансодержателя, чтобы на объекте не спорить с жителями и инспектором. Как поднимают контейнеры во дворе, описано в материале о <a href="/spravochnik/podyom-bytovki-blok-konteynera-avtokranom/" style="color:var(--yellow)">подъёме бытовки автокраном</a>.</p>

    <h2 id="opory" style="margin:36px 0 16px">Опоры, плиты и корни</h2>
    <p>Пункт 9.8 Правил 743-ПП запрещает менять вертикальные отметки грунта у существующих насаждений более чем на 5 см при понижении или повышении. Работы в зоне корневой системы тот же пункт ведёт ниже основных скелетных корней — не менее 1,5 м от поверхности. Для крана это означает запрет срезать бугор под опору и подсыпать площадку у ствола: МОСКРАН-СЕРВИС выравнивает опоры плитами и подкладками, а не грунтом. Выкопку траншей тот же пункт допускает не ближе 2 м от ствола толщиной до 15 см, 3 м — при стволе толще 15 см и 1,5 м от кустарника.</p>
    <p>Ограждение деревьев на стройплощадке — щиты высотой 2 м треугольником не ближе 0,5 м от ствола с настилом радиусом 0,5 м — предписано п. 4.1.3.8 и п. 9.8; эти щиты кран МОСКРАН-СЕРВИС обязан обходить, а не переставлять. Несущая способность грунта под плитой считается отдельно; порядок дан в материале о <a href="/spravochnik/nesushchaya-sposobnost-grunta/" style="color:var(--yellow)">несущей способности грунта</a>, а допустимый перепад площадки — в материале о <a href="/spravochnik/dopustimyy-uklon-ploshchadki-dlya-avtokrana/" style="color:var(--yellow)">допустимом уклоне площадки</a>.</p>

    <h2 id="bilet" style="margin:36px 0 16px">Порубочный билет: когда дерево мешает крану</h2>
    <p>Пункт 8.1.2 Правил 743-ПП допускает уничтожение и пересадку зелёных насаждений, попадающих в зону работ, только при наличии заключения и порубочного билета на объектах строительства, реконструкции и капитального ремонта либо разрешения на пересадку. Выдаёт их Департамент природопользования и охраны окружающей среды Москвы по административному регламенту (п. 8.1.1). Дерево на месте единственно возможной стоянки крана — повод для заказчика открыть эту процедуру, а не для бригады МОСКРАН-СЕРВИС «аккуратно отодвинуть» ствол опорой.</p>
    <p>Пункт 8.1.3 выделяет исключение: на участке, предоставленном под строительство или реконструкцию капитального объекта, насаждения убирают по проектной документации на основании разрешения на строительство, выданного Мосгосстройнадзором, без отдельного порубочного билета — при положительном заключении государственной экспертизы проекта. Во всех остальных случаях действует п. 8.1.2. МОСКРАН-СЕРВИС до выезда спрашивает, есть ли на объекте дендроплан или порубочный билет, если по схеме кран стоит ближе 2,5 м к дереву.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Ситуация у дерева</th><th>Требование Правил 743-ПП</th><th>Пункт</th></tr></thead>
        <tbody>
          <tr><td>Место установки крана и подъезд</td><td>вне насаждений, без нарушения ограждений деревьев</td><td>9.8</td></tr>
          <tr><td>Стоянка техники и склад материалов</td><td>не ближе 2,5 м от дерева, 1,5 м от кустарника; горючее — 10 м</td><td>9.8</td></tr>
          <tr><td>Ограждение дерева на стройке</td><td>щиты 2 м треугольником, ≥0,5 м от ствола, настил R 0,5 м</td><td>4.1.3.8, 9.8</td></tr>
          <tr><td>Подсыпка или срезка грунта у дерева</td><td>изменение отметок не более 5 см</td><td>9.8</td></tr>
          <tr><td>Траншея у ствола</td><td>≥2 м при стволе до 15 см, ≥3 м при стволе толще 15 см</td><td>9.8</td></tr>
          <tr><td>Обрезка веток</td><td>без билета, кроме омолаживающей и вырубки боковых стволов</td><td>4.1.4.18</td></tr>
          <tr><td>Снос или пересадка дерева в зоне работ</td><td>заключение и порубочный билет ДПиООС</td><td>8.1.2</td></tr>
        </tbody>
      </table>
    </div>

    <h2 id="shtraf" style="margin:36px 0 16px">Штраф по ст. 4.18 КоАП Москвы</h2>
    <p>Статья 4.18 Кодекса города Москвы об административных правонарушениях (закон от 21.11.2007 №45) наказывает повреждение зелёных насаждений: по ч. 1 штраф для граждан 3 500–4 000 ₽, для должностных лиц 50 000 ₽, для юридических лиц 300 000 ₽. Часть 2 — те же действия с применением механизмов, автомототранспорта, самоходных машин и другой техники — поднимает штраф гражданам до 4 000–4 500 ₽, а для должностных и юридических лиц оставляет 50 000 и 300 000 ₽. Автокран, сломавший ветку стрелой или содравший кору опорой, попадает именно под ч. 2 — поэтому МОСКРАН-СЕРВИС считает 2,5 м от ствола обязательным минимумом.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Ст. 4.18 КоАП Москвы</th><th>Граждане</th><th>Должностные лица</th><th>Юридические лица</th></tr></thead>
        <tbody>
          <tr><td>Ч. 1 — повреждение насаждений</td><td>3 500–4 000 ₽</td><td>50 000 ₽</td><td>300 000 ₽</td></tr>
          <tr><td>Ч. 2 — то же с применением техники</td><td>4 000–4 500 ₽</td><td>50 000 ₽</td><td>300 000 ₽</td></tr>
        </tbody>
      </table>
    </div>
    <p>Штраф 300 000 ₽ по ч. 2 ст. 4.18 равен двенадцати сменам крана МОСКРАН-СЕРВИС класса 32 т по 24 800 ₽, поэтому перестановка крана на 3 м от ствола дешевле любого спора с инспектором. Отдельно от штрафа закон Москвы от 05.05.1999 №17 «О защите зелёных насаждений» вводит компенсационную стоимость за уничтоженные и повреждённые насаждения — её взыскивают сверх административного наказания. Кто получает постановление при аренде крана с экипажем, разобрано в материале об <a href="/spravochnik/avtokran-na-gazone-v-moskve/#kto-platit" style="color:var(--yellow)">автокране на газоне</a>, а распределение ответственности за ущерб — в материале об <a href="/spravochnik/otvetstvennost-za-padenie-gruza/" style="color:var(--yellow)">ответственности за падение груза</a>.</p>

    <h2 id="zayavka" style="margin:36px 0 16px">Что передать при заказе</h2>
    <p>Для двора или сквера МОСКРАН-СЕРВИС просит схему с деревьями и расстояниями от стволов до предполагаемой стоянки крана и высоту крон на пути стрелы. К схеме прикладывают письмо правообладателя территории о согласовании работ и, если кран стоит ближе 2,5 м к стволу, сведения о порубочном билете или дендроплане. По схеме диспетчер подбирает класс: смена 16–20 т стоит 17 600 ₽, 25 т — 20 800 ₽, 32 т — 24 800 ₽, 50 т — 31 200 ₽; более длинная стрела даёт поставить кран дальше от деревьев. Порядок подачи заявки — в материале о <a href="/spravochnik/zayavka-na-avtokran/" style="color:var(--yellow)">заявке на автокран</a>, въезд в центр — в материале о <a href="/spravochnik/propusk-avtokrana-v-moskvu/" style="color:var(--yellow)">пропуске автокрана в Москву</a>.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: автокран и деревья в Москве</h2>
    <ul>
      <li>Места установки кранов — вне насаждений; технику МОСКРАН-СЕРВИС ставит не ближе 2,5 м от дерева и 1,5 м от кустарника (п. 9.8 Правил 743-ПП).</li>
      <li>Начало работ у насаждений согласуют с правообладателем участка, об окончании уведомляют за два дня (п. 9.8).</li>
      <li>Грунт у дерева не срезают и не подсыпают более чем на 5 см; опоры МОСКРАН-СЕРВИС выравнивает плитами (п. 9.8).</li>
      <li>Ветки режет правообладатель, а не бригада МОСКРАН-СЕРВИС; омолаживающая обрезка и вырубка боковых стволов — по порубочному билету (п. 4.1.4.18).</li>
      <li>Снос или пересадка дерева в зоне работ — по заключению и порубочному билету ДПиООС (п. 8.1.2).</li>
      <li>Повреждение дерева техникой — штраф 300 000 ₽ юрлицу, 50 000 ₽ должностному лицу (ч. 2 ст. 4.18 КоАП Москвы); МОСКРАН-СЕРВИС закладывает дистанцию в схему до выезда.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
