---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = 'Монтаж лестничных маршей автокраном: масса и строповка';
const description = 'Марш 1ЛМ 17.12.9-4 весит 930 кг, МЛ 37.12.18-5д — 2,75 т. Монтажные петли из стали А240 по ГОСТ 13015-2012, выбор класса автокрана от 17 600 ₽.';

const CHECKED = '02.10.2026';
const PUBLISHED = '2026-10-02';
const SLUG = 'montazh-lestnichnyh-marshey-avtokranom';
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: 'Сколько весит железобетонный лестничный марш?',
    a: 'По каталогам заводов ЖБИ марш 1ЛМ 17.12.9-4 на 9 ступеней весит 930 кг, 1ЛМ 20.12.10-4 на 10 ступеней — 1,12 т, 1ЛМ 27.12.14-4 на 14 ступеней — 1,52 т, 1ЛМ 30.12.15-4 на 15 ступеней — 1,7 т, а МЛ 37.12.18-5д на 18 ступеней — 2,75 т. МОСКРАН-СЕРВИС просит в заявке марку марша: точная масса партии указана в паспорте изделия.',
  },
  {
    q: 'Какой автокран нужен для монтажа лестничных маршей?',
    a: 'Для маршей массой до 1,7 т на вылете 10–12 м хватает автокрана класса 16–20 т с моментом 48 т·м у базового «Ивановца» КС-35714: 1,7 × 12 = 20,4 т·м, запас больше половины. Смена такого класса в МОСКРАН-СЕРВИС стоит 17 600 ₽. Для марша МЛ 37.12.18-5д массой 2,75 т на том же вылете момент 33 т·м — всё ещё в пределах 48 т·м, но МОСКРАН-СЕРВИС проверяет подъём по грузовой таблице, а не по верхней оценке.',
  },
  {
    q: 'За что стропят лестничный марш при подъёме краном?',
    a: 'ГОСТ 13015-2012 требует монтажные (грузоподъёмные) петли из гладкой горячекатаной арматуры класса А240 марок Ст3сп или Ст3пс, причём сталь Ст3пс запрещена для петель при температуре монтажа ниже −40°C. Крановщик МОСКРАН-СЕРВИС стропит марш за обе петли одновременно стропами одинаковой длины, чтобы ступени не перекосило при подъёме.',
  },
  {
    q: 'Как узнать место строповки на марше, если петли не видны сразу?',
    a: 'ГОСТ 13015-2012 требует наносить на изделие монтажные знаки: место строповки, положение центра тяжести, верх марша и место опирания. Знаки наносят краской на торце или боковой грани. МОСКРАН-СЕРВИС сверяет схему строповки по этим знакам, а не на глаз по форме марша.',
  },
  {
    q: 'Можно ли поднимать лестничный марш за одну петлю?',
    a: 'Нет: при подъёме за одну петлю марш переходит в наклонное или вертикальное положение и создаёт рывок в момент отрыва от опоры. МОСКРАН-СЕРВИС поднимает марш только двумя стропами за обе монтажные петли, выравнивая длину стропов по готовому углу наклона марша — расчёт угла строповки показан в материале об угле наклона стропа.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Монтаж лестничных маршей', item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ['massa', 'Масса маршей по типоразмерам'],
  ['stropovka', 'Монтажные петли по ГОСТ 13015-2012'],
  ['vylet', 'Вылет и грузовой момент'],
  ['ploshadka', 'Площадка у строящегося дома'],
  ['stoimost', 'Сколько стоит смена'],
  ['faq', 'Частые вопросы'],
  ['istochniki', 'Источники'],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Монтаж лестничных маршей</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Монтаж ЖБИ · Лестничные марши</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Какой автокран нужен для монтажа лестничных маршей?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>02.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>02.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>6 мин чтения</span>
    </div>

    <p>Лестничный марш 1ЛМ 17.12.9-4 на 9 ступеней весит 930 кг, а МЛ 37.12.18-5д на 18 ступеней — уже 2,75 т, поэтому класс автокрана МОСКРАН-СЕРВИС подбирает по конкретной марке изделия, а не по типу «лестничный марш» вообще. ГОСТ 13015-2012 требует поднимать марш за монтажные петли из стали класса А240 — выступ арматуры, рассчитанный заводом именно под строповку. Для большинства маршей массой до 1,7 т на вылете 10–12 м хватает класса 16–20 т за 17 600 ₽ за смену.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="massa" style="margin:36px 0 16px">Масса маршей по типоразмерам</h2>
    <p>Маркировка марша кодирует его размеры: у 1ЛМ 27.12.14-4 первое число после «ЛМ» — длина в дециметрах (2720 мм), второе — ширина (1200 мм), третье — число подступенков (14). Масса растёт вместе с числом ступеней почти линейно — от 930 кг у девятиступенчатого марша до 2,75 т у восемнадцатиступенчатого. МОСКРАН-СЕРВИС сверил каталоги заводов ЖБИ 02.10.2026.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Марка</th><th>Длина</th><th>Ширина</th><th>Ступеней</th><th>Масса</th></tr></thead>
        <tbody>
          <tr><td>1ЛМ 17.12.9-4</td><td>1690 мм</td><td>1200 мм</td><td>9</td><td>930 кг</td></tr>
          <tr><td>1ЛМ 20.12.10-4</td><td>2270 мм</td><td>1200 мм</td><td>10</td><td>1,12 т</td></tr>
          <tr><td>1ЛМ 27.12.14-4</td><td>2720 мм</td><td>1200 мм</td><td>14</td><td>1,52 т</td></tr>
          <tr><td>1ЛМ 30.12.15-4</td><td>3030 мм</td><td>1200 мм</td><td>15</td><td>1,7 т</td></tr>
          <tr><td>МЛ 37.12.18-5д</td><td>3660 мм</td><td>1200 мм</td><td>18</td><td>2,75 т</td></tr>
        </tbody>
      </table>
    </div>
    <p>На пятиэтажный подъезд уходит восемь-десять маршей на два марша на этаж, и общая масса подъёма превышает 10 т, но кран поднимает их по одному. МОСКРАН-СЕРВИС считает класс техники по самому тяжёлому маршу в комплекте и по вылету до дальней точки здания, а не по сумме массы всех маршей объекта.</p>

    <h2 id="stropovka" style="margin:36px 0 16px">Монтажные петли по ГОСТ 13015-2012</h2>
    <p>ГОСТ 13015-2012 требует делать монтажные (грузоподъёмные) петли маршей из гладкой горячекатаной арматурной стали класса А240 марок Ст3сп или Ст3пс. Для петель, которые будут работать при температуре монтажа ниже −40°C, сталь Ст3пс применять нельзя — только Ст3сп. Открытые поверхности петель и мест строповки завод обязан очистить от наплывов бетонного раствора ещё на складе, чтобы строп не соскальзывал при подъёме.</p>
    <p>Тот же ГОСТ требует наносить на изделие монтажные знаки: место строповки, положение центра тяжести, верх марша и точку опирания. Крановщик МОСКРАН-СЕРВИС находит петли по этим знакам и цепляет обе петли одновременно — двумя стропами одинаковой несущей способности, подобранными под угол наклона готового марша. Общие правила выбора угла и длины стропов разобраны в <a href="/spravochnik/ugol-naklona-stropa/" style="color:var(--yellow)">материале об угле наклона стропа</a>.</p>

    <h2 id="vylet" style="margin:36px 0 16px">Вылет и грузовой момент</h2>
    <p>Марш 1ЛМ 30.12.15-4 массой 1,7 т на вылете 12 м создаёт момент 20,4 т·м. Запас против 48 т·м у базового «Ивановца» КС-35714 класса 16–20 т остаётся больше половины. У самого тяжёлого марша линейки, МЛ 37.12.18-5д массой 2,75 т, момент на том же вылете растёт до 33 т·м. Крановщик проверяет такой подъём по грузовой таблице конкретной машины, а не делением момента на вылет.</p>
    <p>Если кран стоит у дороги за пределами стройплощадки, вылет до дальнего угла здания часто превышает 15 м: 2,75 т на 16 м — это уже 44 т·м, запас у 48-тонного момента сокращается до нескольких тонно-метров. В таком случае МОСКРАН-СЕРВИС предлагает класс 25 т с моментом 85 т·м; порядок чтения грузовой таблицы показан в <a href="/spravochnik/gruzovysotnaya-harakteristika/" style="color:var(--yellow)">материале о грузовысотной характеристике</a>.</p>

    <h2 id="ploshadka" style="margin:36px 0 16px">Площадка у строящегося дома</h2>
    <p>ФНП №461 (п. 108–110) требует устанавливать автокран на все выносные опоры на подготовленном основании — грунт после обратной засыпки траншей и котлована под этот критерий не подходит без уплотнения. МОСКРАН-СЕРВИС проверяет несущую способность площадки до выезда техники; методика расчёта и пороговые значения разобраны в <a href="/spravochnik/nesushchaya-sposobnost-grunta/" style="color:var(--yellow)">материале о несущей способности грунта</a>.</p>
    <p>На этажах выше первого марши заводят в проём лестничной клетки с руки монтажников, а кран держит груз на весу до момента опирания нижнего торца марша на готовую площадку. ФНП №461 требует при этом держать людей вне зоны под поднятым грузом; опасная зона и её границы разобраны в <a href="/spravochnik/opasnaya-zona-krana/" style="color:var(--yellow)">материале об опасной зоне крана</a>.</p>

    <h2 id="stoimost" style="margin:36px 0 16px">Сколько стоит смена</h2>
    <p>Смена 8 часов автокрана класса 16–20 т в МОСКРАН-СЕРВИС стоит 17 600 ₽ — этого хватает на марши до 1,7–2 т на вылете 12–14 м. Ставка 2 200 ₽ в час действует для всего класса. Класс 25 т за 20 800 ₽ нужен, когда вылет до дальней точки здания превышает 15 м или на объекте марши тяжелее 2,5 т при том же вылете.</p>
    <p>На объекте из нескольких подъездов МОСКРАН-СЕРВИС обычно поднимает все марши этажа за один заход стрелы, чтобы не переставлять кран между корпусами; расчёт числа перестановок и их стоимость показаны в <a href="/spravochnik/avtokran-16-ili-25-tonn/" style="color:var(--yellow)">сравнении классов 16 и 25 тонн</a>.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: монтаж лестничных маршей</h2>
    <ul>
      <li>Масса маршей растёт с числом ступеней: 930 кг (9 ступеней) — 1,12 т (10) — 1,52 т (14) — 1,7 т (15) — 2,75 т (18).</li>
      <li>Монтажные петли — сталь А240 марок Ст3сп/Ст3пс по ГОСТ 13015-2012; Ст3пс запрещена при монтаже ниже −40°C.</li>
      <li>Строповка — только за обе петли одновременно, по монтажным знакам на изделии.</li>
      <li>Класс 16–20 т (17 600 ₽/смена) закрывает марши до 1,7–2 т на вылете 12–14 м; тяжелее или дальше — класс 25 т (20 800 ₽).</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://docs.cntd.ru/document/1200101281" target="_blank" rel="noopener" style="color:var(--yellow)">ГОСТ 13015-2012 «Изделия бетонные и железобетонные для строительства. Общие технические требования»</a> — требования к монтажным петлям, сталь класса А240, маркировка мест строповки.</li>
      <li><a href="https://okgbi.ru/enterprises/articles/lestnichnyj-marsh/" target="_blank" rel="noopener" style="color:var(--yellow)">Лестничный марш: устройство и типоразмеры — обзор завода ЖБИ</a> — таблица длины, ширины, числа ступеней и массы по маркам.</li>
      <li><a href="https://mgbi-17.ru/lestnichnye-marshi/1-lm-27-12-14-4.htm" target="_blank" rel="noopener" style="color:var(--yellow)">1ЛМ 27.12.14-4 — карточка завода ЖБИ</a> — масса 1,52 т, размеры 2720 × 1200 × 1400 мм.</li>
      <li><a href="https://kran-master74.ru/info/avtomobilnye-krany/obzor-harakteristik-avtokrana-ks-35714/" target="_blank" rel="noopener" style="color:var(--yellow)">Обзор исполнений КС-35714 «Ивановец»</a> — базовый грузовой момент 48 т·м при стреле 18 м.</li>
      <li><a href="https://sudact.ru/law/prikaz-rostekhnadzora-ot-26112020-n-461-ob/federalnye-normy-i-pravila-v/vi/ustanovka-ps-i-proizvodstvo-rabot/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461, раздел VI «Установка ПС и производство работ» (ред. от 16.04.2026)</a> — п. 108–110.</li>
    </ul>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-16-25-tonn/">Аренда автокрана 16–25 тонн →</a></section>
</main>
</SpravochnikLayout>
