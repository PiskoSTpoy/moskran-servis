const description = 'Сравниваем автокран и кран-манипулятор (КМУ) для заказчика: как указывается грузоподъёмность, когда выгодно «привёз и выгрузил» одной машиной, где нужен вылет и высота автокрана и какие требования ФНП №461 одинаковы для обоих.';

const CHECKED = '24.09.2026';

const faqs = [
  {
    q: 'Распространяются ли на кран-манипулятор те же правила, что на автокран?',
    a: 'В основном да. Пункт 2 ФНП №461 прямо включает краны-манипуляторы в область применения правил, а требования к установке — подготовленная площадка, расстояние от поворотной части до строений, работа у откоса котлована и вблизи ЛЭП — в пунктах 108–112 сформулированы одновременно для кранов стрелового типа и кранов-манипуляторов. Исключение — самые лёгкие установки: по подпункту «у» пункта 3 ФНП не распространяются на краны-манипуляторы, установленные на фундаменте, и на краны-манипуляторы грузоподъёмностью до 1 т или с грузовым моментом до 4 т·м включительно.',
  },
  {
    q: 'Почему у манипулятора грузоподъёмность пишут в тонно-метрах?',
    a: 'Грузовой момент — это произведение массы груза на вылет. Он показывает главное ограничение стреловой установки: чем дальше груз от оси, тем меньше масса, которую можно поднять. Максимальная грузоподъёмность КМУ достигается на минимальном вылете, поэтому для подбора нужна таблица грузоподъёмности по вылетам из паспорта установки, а не одна цифра из объявления. Тот же принцип действует и для автокрана — там его показывает грузовысотная характеристика.',
  },
  {
    q: 'Нужен ли стропальщик, если работает манипулятор?',
    a: 'Требования ФНП №461 к строповке, схемам строповки и допуску персонала относятся к работам с кранами-манипуляторами так же, как к автокранам. Кто на конкретной площадке выполняет строповку и какой у него допуск, определяет эксплуатирующая организация в ППР или технологической карте. Этот вопрос стоит решить до заказа, а не у груза.',
  },
  {
    q: 'Нужно ли ставить кран-манипулятор на учёт в Ростехнадзоре?',
    a: 'Разъяснения Ростехнадзора со ссылкой на пункт 147 ФНП №461 говорят, что перед пуском в работу краны-манипуляторы подлежат учёту в органах Ростехнадзора, за исключением установок, прямо перечисленных в ФНП (на фундаменте, а также до 1 т или до 4 т·м включительно). Для заказчика вывод простой: у арендуемого КМУ, как и у автокрана, стоит спросить учётный номер и паспорт.',
  },
];

