---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = "Люлька для людей на кране: стропы и условия п. 239–241 ФНП";
const description = "Люльку вешают на стропы с запасом 8 (цепь) или 10 (канат), текстиль запрещён; ветер выше 10 м/с и плохая видимость — запрет (пп. 239, 241 ФНП №461).";

const CHECKED = '18.10.2026';
const PUBLISHED = '2026-10-18';
const SLUG = "lyulka-dlya-podema-lyudey-krana-stropy-i-usloviya-fnp-461";
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: "Какой запас прочности у строп для подвеса люльки?",
    a: "Не менее 8 для цепных и не менее 10 для канатных стропов, для коушей и скоб не менее 10 (п. 239 ФНП №461). МОСКРАН-СЕРВИС сверяет значения с маркировкой.",
  },
  {
    q: "Можно ли подвесить люльку на текстильных стропах?",
    a: "Нет, применение текстильных стропов для подвеса люльки не допускается (п. 239 ФНП №461). МОСКРАН-СЕРВИС использует только цепные или канатные.",
  },
  {
    q: "При каком ветре запрещён подъём людей?",
    a: "При ветре выше 10 м/с, а также при дожде, снеге, тумане и обледенении (п. 241 ФНП №461). МОСКРАН-СЕРВИС откладывает работу заранее.",
  },
  {
    q: "Какая скорость подъёма люльки допустима?",
    a: "Скорость по вертикали не более 20 м в минуту (п. 237 ФНП №461). МОСКРАН-СЕРВИС проверяет это по паспорту крана.",
  },
  {
    q: "Нужна ли связь с людьми в люльке?",
    a: "Да, между крановщиком и людьми обеспечивают постоянную двустороннюю радио- или телефонную связь, а совмещать движения крана запрещено (п. 241 ФНП №461). МОСКРАН-СЕРВИС проверяет связь до подъёма.",
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: "Люлька для подъёма людей краном: стропы и условия по ФНП №461", item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ["kran", "Какой кран и какая люлька допустимы"],
  ["stropy", "Стропы подвеса: запас и запреты"],
  ["usloviya", "Условия подъёма по п. 241"],
  ["lyudi", "Что обязаны выполнить люди в люльке"],
  ["moskva", "Люлька на КС-55713 «Клинцы» в Москве"],
  ["faq", "Частые вопросы"],
  ["istochniki", "Источники"],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Люлька для подъёма людей краном: стропы и условия по ФНП №461</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">ФНП №461 · Подъём людей</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Какие стропы и условия нужны, чтобы поднять людей краном в люльке?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>18.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>18.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>5 мин чтения</span>
    </div>

    <p>Подвес люльки на стропах по п. 239 ФНП №461 требует запаса прочности не менее 8 для цепи и 10 для каната, текстильные стропы запрещены, а работа в ветер выше 10 м/с недопустима (п. 241). МОСКРАН-СЕРВИС не поднимает людей без ППР и ИТР на площадке.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="kran" style="margin:36px 0 16px">Какой кран и какая люлька допустимы</h2>
    <p>Подъём людей краном без разрешения в паспорте ПС п. 235 ФНП №461 допускает только в перечисленных случаях, например при монтаже, когда иначе рабочих в зону не доставить, или при аварийной транспортировке людей, которые сами не двигаются. Для таких случаев нужен ППР, согласованный территориальным органом Ростехнадзора, кроме аварийной эвакуации. МОСКРАН-СЕРВИС без такого ППР люльку на крюк не вешает.</p>
    <p>ПС для этой работы по п. 237 должно иметь плавный пуск и остановку механизмов, не менее чем двукратный запас по грузоподъёмности относительно суммы массы люльки, подвесного устройства и номинальной грузоподъёмности люльки, а скорость по вертикали — не более 20 м в минуту. Люлька, по п. 236 и 238, предназначена только для людей, минимальная высота от пола до препятствия — 2 м, перила — не ниже 1100 мм, до высоты 0,5 м сплошные, двери не открываются наружу и имеют автоматический замок. МОСКРАН-СЕРВИС сверяет эти числа с паспортом люльки.</p>

    <h2 id="stropy" style="margin:36px 0 16px">Стропы подвеса: запас и запреты</h2>
    <p>Стропы подвеса люльки на однорогий или двурогий крюк нельзя использовать для других целей, а запас прочности отдельной ветви должен быть не менее 8 у цепных и не менее 10 у канатных стропов (п. 239 ФНП №461). Для коушей, скоб и колец запас не менее 10. МОСКРАН-СЕРВИС держит для подвеса люльки отдельный маркированный комплект.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Элемент подвеса</th><th>Минимальный запас прочности</th><th>Пункт</th></tr></thead>
        <tbody>
          <tr><td>Цепной строп, ветвь</td><td>8</td><td>п. 239</td></tr>
          <tr><td>Канатный строп, ветвь</td><td>10</td><td>п. 239</td></tr>
          <tr><td>Коуши, скобы, кольца подвеса</td><td>10</td><td>п. 239</td></tr>
        </tbody>
      </table>
    </div>
    <p>Концы канатных стропов крепят заплетёнными коушами или коушами с зажимами, обжимные втулки не допускаются, а текстильные стропы для подвеса люльки запрещены. Длину стропов задаёт схема строповки в ППР; при сварке из люльки обеспечивают независимое заземление или изоляцию люльки от ПС. Для подъёма и перемещения п. 240 разрешает только автоматические спредеры с блокировкой замков. Коэффициенты для обычных строп описаны в материале о <a href="/spravochnik/raschet-mnogovetvevogo-stropa-avtokran-fnp-461/" style="color:var(--yellow)">расчёте многоветвевого стропа</a>. МОСКРАН-СЕРВИС не использует обжимные втулки на подвесе люльки.</p>

    <h2 id="usloviya" style="margin:36px 0 16px">Условия подъёма по п. 241</h2>
    <p>П. 241 ФНП №461 запрещает использовать люльку при ветре выше 10 м/с, плохой видимости (дождь, снег, туман), обледенении и в других условиях, угрожающих людям. Подъём и перемещение ведутся под непосредственным руководством ИТР, ответственного за безопасное производство работ с ПС. МОСКРАН-СЕРВИС отменяет подъём по любому из трёх факторов, не дожидаясь порыва.</p>
    <p>Крановщик должен видеть люльку с людьми и зоны начала подъёма и опускания на протяжении всей операции, ему запрещено совмещать движения крана, а между ним и людьми обеспечивают постоянную двустороннюю радио- или телефонную связь. Если возможны раскачивание или поворот, их гасят оттяжными канатами. Роль руководителя описана в справке об <a href="/spravochnik/otvetstvennyy-za-bezopasnoe-proizvodstvo/" style="color:var(--yellow)">ответственном за безопасное производство работ</a>, а связь — в материале о <a href="/spravochnik/signalshchik-pri-rabote-avtokrana-fnp-461/" style="color:var(--yellow)">сигнальщике</a>. МОСКРАН-СЕРВИС проверяет связь до отрыва люльки.</p>

    <h2 id="lyudi" style="margin:36px 0 16px">Что обязаны выполнить люди в люльке</h2>
    <p>Люди в люльке получают инструкцию под подпись о том, где стоять, за что держаться, как пользоваться страховочными привязями и как покинуть люльку (п. 241 «л»). Привязи постоянно закреплены за точки крепления, длина фала не выводит человека за пределы люльки. МОСКРАН-СЕРВИС просит эту подпись до подъёма.</p>
    <ul>
      <li>МОСКРАН-СЕРВИС не допускает вставать на поручни и ставить подставки в люльке (п. 241 «о»).</li>
      <li>МОСКРАН-СЕРВИС требует закрепить инструмент и материалы на время перемещения (п. 241 «п»).</li>
      <li>МОСКРАН-СЕРВИС проверяет люльку, стропы, крюки и защёлки перед каждым использованием (п. 241 «д»).</li>
      <li>Травмированного перевозят лёжа на жёстких носилках с двумя сопровождающими (п. 241 «н»).</li>
    </ul>


    <h2 id="moskva" style="margin:36px 0 16px">Люлька на КС-55713 «Клинцы» в Москве</h2>
    <p>В Москве подъём людей краном встречается при ремонте фасадов и металлоконструкций, где подъёмник не достаёт или не проходит по двору. Автокран КС-55713 «Клинцы» с люлькой возможен только при выполнении перечисленного выше, а чаще МОСКРАН-СЕРВИС предлагает подъёмник или вышку: сравнение вариантов — в материале <a href="/spravochnik/avtokran-ili-avtovyshka/" style="color:var(--yellow)">автокран или автовышка</a>. Предпочтение вышки — практика МОСКРАН-СЕРВИС, а не требование ФНП.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: люлька для подъёма людей</h2>
    <ul>
      <li>МОСКРАН-СЕРВИС вешает люльку на стропы с запасом 8 (цепь) и 10 (канат), текстильные не использует (п. 239 ФНП №461).</li>
      <li>При ветре выше 10 м/с, дожде, снеге, тумане и обледенении МОСКРАН-СЕРВИС люльку не поднимает (п. 241).</li>
      <li>МОСКРАН-СЕРВИС держит двустороннюю связь с людьми в люльке и не совмещает движения крана.</li>
      <li>Без ППР и ИТР на площадке МОСКРАН-СЕРВИС людей краном не поднимает.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://www.consultant.ru/document/cons_doc_LAW_373321/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 (приказ Ростехнадзора от 26.11.2020 №461)</a> — пп. 235–241 (случаи подъёма людей, требования к ПС, люльке, стропам подвеса, спредерам и условиям работы).</li>
      <li><a href="https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 на legalacts.ru</a> — редакция от 16.04.2026, текст пунктов 235–241 сверен 18.10.2026.</li>
    </ul>
    <p class="small muted">Предпочтение подъёмника или вышки — практика МОСКРАН-СЕРВИС, а не пункт нормы.</p>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-16-25-tonn/">Аренда автокрана 16–25 тонн →</a></section>
</main>
</SpravochnikLayout>
