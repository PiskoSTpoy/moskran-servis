---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = 'Груз краном над людьми и кабиной машины: что запрещает ФНП';
const description = 'ФНП №461 запрещает перемещать груз над людьми (п. 114), над кабиной и кузовом с людьми (п. 125) и над перекрытиями с людьми (п. 128). Разбор для Москвы.';

const CHECKED = '27.09.2026';
const PUBLISHED = '2026-09-27';
const SLUG = 'peremeshchenie-gruza-nad-lyudmi';
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: 'Может ли водитель фуры оставаться в кабине при разгрузке краном?',
    a: 'Нет. По п. 125 ФНП №461 не разрешается опускать груз на автомашину и поднимать его с неё, если в кабине или кузове этой машины находятся люди. Крановщик МОСКРАН-СЕРВИС начинает подъём только после того, как водитель вышел из кабины и отошёл за пределы опасной зоны.',
  },
  {
    q: 'Можно ли пронести груз краном над тротуаром в Москве?',
    a: 'Только когда под грузом нет людей: п. 114 ФНП №461 прямо запрещает перемещать груз при нахождении под ним людей. На московской улице это означает временное ограждение тротуара и регулировщика на время подъёма. МОСКРАН-СЕРВИС закладывает схему ограждения в заявку заранее; занятие проезжей части согласуется отдельно.',
  },
  {
    q: 'Может ли стропальщик стоять рядом с поднятым грузом?',
    a: 'Может, но только пока груз поднят не выше 1 м от уровня площадки — такое исключение даёт п. 114 ФНП №461. Выше этой отметки стропальщик МОСКРАН-СЕРВИС отходит от груза, а разворачивает длинномер оттяжками, которые п. 115 разрешает именно для разворота.',
  },
  {
    q: 'Можно ли подать груз краном прямо на балкон?',
    a: 'Без специальной приёмной площадки или приспособления нельзя: п. 115 ФНП №461 запрещает подачу груза в оконные проёмы, на балконы и лоджии без них. МОСКРАН-СЕРВИС уточняет на заявке, есть ли выносная площадка; если её нет, груз опускают на кровлю или землю в разрешённом месте.',
  },
  {
    q: 'Кто отвечает, если груз пронесли над людьми?',
    a: 'Порядок работ на площадке определяет ответственный за безопасное производство работ с применением подъёмных сооружений, а крановщик обязан остановить подъём, если в зоне под грузом появились люди. МОСКРАН-СЕРВИС разбирает распределение ответственности в материале об ответственности за падение груза.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Груз над людьми и машиной', item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ['zaprety', 'Четыре запрета ФНП №461: таблица'],
  ['nad-lyudmi', 'Груз над людьми: п. 114'],
  ['kabina', 'Кабина и кузов автомашины: п. 125'],
  ['perekrytiya', 'Над перекрытиями и балконами: п. 128 и п. 115'],
  ['moskva', 'Разгрузка на московской улице: как это выглядит'],
  ['faq', 'Частые вопросы'],
  ['istochniki', 'Источники'],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Груз над людьми и машиной</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Безопасность работ · ФНП №461</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Можно ли переносить груз краном над людьми и кабиной машины?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>27.09.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>27.09.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>5 мин чтения</span>
    </div>

    <p>Нельзя: п. 114 ФНП №461 запрещает перемещать груз при нахождении под ним людей, а п. 125 — опускать груз на автомашину или поднимать с неё, пока в кабине или кузове кто-то есть. Над перекрытиями, под которыми могут быть люди, груз тоже не носят (п. 128). МОСКРАН-СЕРВИС поэтому планирует траекторию груза и ограждение ещё на этапе заявки.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="zaprety" style="margin:36px 0 16px">Четыре запрета ФНП №461: таблица</h2>
    <p>Запреты на траекторию груза собраны в четырёх пунктах ФНП №461 — 114, 115, 125 и 128 — формулировки сверены по действующей редакции от 16.04.2026. МОСКРАН-СЕРВИС свёл их в таблицу вместе с исключениями, которые сами правила допускают.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Пункт ФНП №461</th><th>Что запрещено</th><th>Что допускается</th></tr></thead>
        <tbody>
          <tr><td>п. 114</td><td>Перемещать груз, когда под ним люди; поднимать груз неизвестной массы</td><td>Стропальщик у груза, поднятого не выше 1 м</td></tr>
          <tr><td>п. 115</td><td>Людям находиться под стрелой при подъёме, опускании, телескопировании; подавать груз на балкон без приёмной площадки</td><td>Оттяжки — для разворота длинномерных и крупногабаритных грузов</td></tr>
          <tr><td>п. 125</td><td>Опускать груз на автомашину и поднимать с неё при людях в кузове или кабине</td><td>Погрузка и разгрузка после выхода людей из машины</td></tr>
          <tr><td>п. 128</td><td>Перемещать груз над перекрытиями, под которыми производственные, жилые или служебные помещения с людьми</td><td>—</td></tr>
        </tbody>
      </table>
    </div>

    <h2 id="nad-lyudmi" style="margin:36px 0 16px">Груз над людьми: п. 114</h2>
    <p>Пункт 114 ФНП №461 требует сначала поднять груз на 0,2–0,3 м и остановиться для проверки строповки и тормоза, а затем прямо запрещает перемещать его при нахождении под ним людей. Горизонтально груз ведут на 0,5 м выше встречных предметов. Крановщик МОСКРАН-СЕРВИС на каждом подъёме проходит эту последовательность, а не только на первом.</p>
    <p>Единственное исключение п. 114 касается стропальщика: ему можно находиться возле груза, пока груз поднят не выше 1 м от уровня площадки. Выше этой отметки стропальщик МОСКРАН-СЕРВИС отходит, а выравнивать груз руками запрещает уже п. 115. Для разворота длинных пачек арматуры или ферм применяют оттяжки — их п. 115 допускает именно для разворота, а не для подтягивания груза.</p>

    <h2 id="kabina" style="margin:36px 0 16px">Кабина и кузов автомашины: п. 125</h2>
    <p>Пункт 125 ФНП №461 не разрешает опускать груз на автомашину, а также поднимать его, если в кузове или кабине этой машины находятся люди. На практике водитель фуры выходит из кабины до начала разгрузки и не возвращается, пока кран не закончил. МОСКРАН-СЕРВИС предупреждает об этом заказчика заранее, потому что водители поставщика часто хотят остаться в кабине.</p>
    <p>Правило касается и стропальщика в кузове: цеплять груз он может, но на время подъёма обязан спуститься. Для мест постоянной погрузки п. 124 ФНП №461 требует стационарных эстакад или навесных площадок для стропальщиков, а на разовом объекте МОСКРАН-СЕРВИС строит работу так, чтобы строповка шла с земли или с борта до подъёма груза.</p>

    <h2 id="perekrytiya" style="margin:36px 0 16px">Над перекрытиями и балконами: п. 128 и п. 115</h2>
    <p>Пункт 128 ФНП №461 запрещает перемещать грузы при строительно-монтажных и погрузочно-разгрузочных работах над перекрытиями, под которыми размещены производственные, жилые или служебные помещения, где могут находиться люди. Для подачи материалов на кровлю жилого дома это означает: траектория груза не проходит над обитаемыми помещениями, либо люди из них на время работ выведены. МОСКРАН-СЕРВИС уточняет это до выезда, а не на месте.</p>
    <p>Подача груза в оконные проёмы, на балконы и лоджии без специальных приёмных площадок или приспособлений запрещена п. 115 ФНП №461. Если заказчик хочет поднять стеклопакет или мебель на балкон, МОСКРАН-СЕРВИС спрашивает о выносной приёмной площадке; без неё груз опускают на землю или кровлю в разрешённом месте.</p>

    <h2 id="moskva" style="margin:36px 0 16px">Разгрузка на московской улице: как это выглядит</h2>
    <p>На узкой московской улице автокран КС-55713-1К «Клинцы» обычно стоит у тротуара, фура — рядом, а груз идёт над пешеходной зоной к воротам объекта. По п. 114 под грузом не должно быть людей, поэтому в схему работ МОСКРАН-СЕРВИС на время подъёма закладывает ограждение участка тротуара и сигнальщика, который останавливает прохожих. Граница ограждения считается по правилам опасной зоны, разобранным в <a href="/spravochnik/opasnaya-zona-krana/" style="color:var(--yellow)">материале об опасной зоне крана</a>.</p>
    <p>Если кран или фура занимает полосу проезда, нужен отдельный ордер или согласование — порядок описан в <a href="/spravochnik/soglasovanie-perekrytiya-proezda/" style="color:var(--yellow)">материале о перекрытии проезда</a>. МОСКРАН-СЕРВИС не обещает сроки таких согласований, потому что их устанавливает орган власти. Выезд самого крана в зону МКАД требует пропуска, как в <a href="/spravochnik/propusk-avtokrana-v-moskvu/" style="color:var(--yellow)">материале о пропуске автокрана в Москву</a>.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: где груз проносить нельзя</h2>
    <ul>
      <li>Над людьми — никогда (п. 114).</li>
      <li>Стропальщик МОСКРАН-СЕРВИС у груза — только до высоты 1 м.</li>
      <li>При людях в кабине или кузове машины — нельзя (п. 125).</li>
      <li>Над перекрытиями с людьми под ними — нельзя (п. 128).</li>
      <li>На балкон МОСКРАН-СЕРВИС подаёт груз только через приёмную площадку (п. 115).</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://sudact.ru/law/prikaz-rostekhnadzora-ot-26112020-n-461-ob/federalnye-normy-i-pravila-v/vi/ustanovka-ps-i-proizvodstvo-rabot/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461, раздел VI «Установка ПС и производство работ» (ред. от 16.04.2026)</a> — п. 114, 115, 124, 125, 128; сверено по тексту документа.</li>
      <li><a href="https://www.consultant.ru/document/cons_doc_LAW_373321/" target="_blank" rel="noopener" style="color:var(--yellow)">Приказ Ростехнадзора от 26.11.2020 №461 на consultant.ru</a> — действующая редакция, срок действия до 01.09.2032.</li>
    </ul>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-16-25-tonn/">Подробнее об аренде автокрана 16–25 тонн →</a></section>
</main>
</SpravochnikLayout>
