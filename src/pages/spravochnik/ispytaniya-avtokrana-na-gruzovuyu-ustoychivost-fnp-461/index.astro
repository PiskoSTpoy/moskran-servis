---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = 'Испытания автокрана на грузовую устойчивость: п. 186';
const description = 'Испытания автокрана на грузовую устойчивость проводят при первичном освидетельствовании без записи в паспорте и после ремонта стрелы, опор (п. 186 ФНП №461).';

const CHECKED = '14.10.2026';
const PUBLISHED = '2026-10-14';
const SLUG = 'ispytaniya-avtokrana-na-gruzovuyu-ustoychivost-fnp-461';
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: 'Когда автокран испытывают на грузовую устойчивость?',
    a: 'При первичном техническом освидетельствовании, если в паспорте нет ссылок на ранее проведённые такие испытания, и после ремонта стрелы, гуська, аутригеров или опорно-поворотного устройства с заменой элементов, сваркой или изменением геометрии (п. 186 ФНП №461). МОСКРАН-СЕРВИС ищет эти записи в паспорте машины.',
  },
  {
    q: 'Проводят ли испытания устойчивости при повторном освидетельствовании?',
    a: 'Для кранов стрелового типа не проводят, если иное не указано в руководстве по эксплуатации (п. 187 ФНП №461). Повторное освидетельствование автокрана через три года поэтому обычно обходится без этих испытаний. МОСКРАН-СЕРВИС сверяет исключение с руководством конкретной модели.',
  },
  {
    q: 'В каком положении крана проводят испытание на устойчивость?',
    a: 'В положениях и вариантах исполнения, при которых устойчивость в пределах рабочей зоны минимальна (п. 188 ФНП №461). Если для разных положений заданы разные нагрузки, испытания проводят для выбора этих условий. Конкретные вылеты и нагрузки берут из грузовых характеристик в паспорте.',
  },
  {
    q: 'Что записывают в паспорте по итогам испытаний устойчивости?',
    a: 'Результат полного освидетельствования, включая испытания, вносят в паспорт с указанием срока следующего (п. 189 ФНП №461). Запись делает инженерно-технический работник, проводивший освидетельствование. МОСКРАН-СЕРВИС показывает такую страницу паспорта заказчику по запросу до подписания заявки.',
  },
  {
    q: 'Должен ли заказчик организовывать такие испытания для арендованного автокрана?',
    a: 'Нет. Освидетельствование и испытания — обязанность эксплуатирующей организации, то есть собственника машины (п. 167, 183 ФНП №461). Заказчик проверяет только наличие записи. МОСКРАН-СЕРВИС не передаёт на объект кран, у которого после ремонта стрелы нет записи об испытаниях.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Испытания автокрана на грузовую устойчивость по ФНП №461', item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ['norma', 'Что требует п. 186 ФНП №461'],
  ['ostalnoe', 'Когда испытания не проводят: п. 187'],
  ['polozhenie', 'В каком положении испытывают: п. 188'],
  ['remont', 'Ремонт стрелы и опор как повод'],
  ['pasport', 'Как это видно в паспорте'],
  ['zakazchik', 'Что это значит для заказчика'],
  ['faq', 'Частые вопросы'],
  ['istochniki', 'Источники'],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Испытания автокрана на грузовую устойчивость по ФНП №461</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">ФНП №461 · Испытания</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Когда автокран испытывают на грузовую устойчивость?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>14.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>14.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>6 мин чтения</span>
    </div>

    <p>Испытания на грузовую устойчивость проводят при первичном освидетельствовании стрелового самоходного крана, если в паспорте нет ссылок на такие испытания, и после ремонта стрелы, опор или поворотного устройства с заменой элементов либо сваркой (п. 186 ФНП №461). МОСКРАН-СЕРВИС ищет эти записи в паспорте автокрана до подачи на объект.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="norma" style="margin:36px 0 16px">Что требует п. 186 ФНП №461</h2>
    <p>Пункт 186 ФНП №461 называет два случая проведения испытаний на грузовую устойчивость. Первый — первичное освидетельствование стрелового самоходного крана, когда в паспорте нет ссылок на ранее проведённые такие испытания. Второй — ремонт расчётных элементов стрелы, гуська, аутригеров или опорно-поворотного устройства с заменой или сваркой либо изменение первоначальных размеров. МОСКРАН-СЕРВИС читает оба случая как независимые.</p>
    <p>Слово «грузовая» принципиально: испытывают не опрокидывание от ветра и не опоры на грунт, а запас устойчивости крана с грузом на крюке. Расчётную сторону — коэффициент грузовой устойчивости и его составляющие — МОСКРАН-СЕРВИС разобрал в справке об <a href="/spravochnik/ustoychivost-krana/" style="color:var(--yellow)">устойчивости крана</a>.</p>

    <h2 id="ostalnoe" style="margin:36px 0 16px">Когда испытания не проводят: п. 187</h2>
    <p>Пункт 187 ФНП №461 снимает испытания на устойчивость при повторных освидетельствованиях для кранов стрелового типа, если иное не указано в руководстве по эксплуатации. Для автокрана это значит: плановое освидетельствование раз в три года обычно идёт без таких испытаний. МОСКРАН-СЕРВИС сверяет исключение с руководством каждой модели, прежде чем делать вывод.</p>
    <p>Подпункт «г» п. 169 вводит ещё одну оговорку: испытания на устойчивость предписаны ПС, у которых в паспорте есть характеристики устойчивости, кроме ПС, не требующих дополнительного монтажа на месте эксплуатации. Автокран выезжает на объект собранным, поэтому буквальное прочтение даёт ему второй выход из требования. МОСКРАН-СЕРВИС не строит на этом выводов и опирается на запись в паспорте.</p>

    <h2 id="polozhenie" style="margin:36px 0 16px">В каком положении испытывают: п. 188</h2>
    <p>Пункт 188 ФНП №461 требует испытывать кран в положениях и вариантах исполнения, при которых его устойчивость в пределах рабочей зоны минимальна. Если для разных положений или рабочих зон заданы разные нагрузки, испытания проводят для выбора этих условий. МОСКРАН-СЕРВИС напоминает: у автокрана «худшее» положение определяют вылет, угол стрелы и сектор над опорами.</p>
    <p>На практике это самое неудобное сочетание: максимальный вылет, короткие или частично выдвинутые опоры, работа через борт шасси. Такая точка на грузовой характеристике обычно даёт наименьшую грузоподъёмность. Как читать эту характеристику, объяснено в справке о <a href="/spravochnik/gruzovysotnaya-harakteristika/" style="color:var(--yellow)">грузовысотной характеристике</a>.</p>

    <h2 id="remont" style="margin:36px 0 16px">Ремонт стрелы и опор как повод</h2>
    <p>Второй случай п. 186 ФНП №461 — самый частый на практике: ремонт с заменой элементов или сваркой в металлоконструкциях стрелы, гуська, аутригеров либо опорно-поворотного устройства. МОСКРАН-СЕРВИС относит сюда ремонт после аварии, установку новых секций стрелы и ремонт балок опор. Любое изменение первоначальных геометрических размеров — тот же повод.</p>
    <p>Для заказчика важна связка с внеочередным освидетельствованием: ремонт с заменой или сваркой даёт повод и для п. 166, и для испытаний по п. 186. Эту связку описывает материал о <a href="/spravochnik/vneocherednoe-osvidetelstvovanie-avtokrana-fnp-461/" style="color:var(--yellow)">внеочередном освидетельствовании</a>, допуск после аварийного ремонта — материал о <a href="/spravochnik/remont-strely-posle-avarii-dopusk/" style="color:var(--yellow)">допуске после ремонта стрелы</a>.</p>

    <h2 id="pasport" style="margin:36px 0 16px">Как это видно в паспорте</h2>
    <p>Результат освидетельствования, включая испытания на устойчивость, вносят в паспорт крана с указанием срока следующего (п. 189 ФНП №461). Запись делает инженерно-технический работник, проводивший освидетельствование. МОСКРАН-СЕРВИС просит именно эту страницу, когда машина проходила ремонт стрелы или опор.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Ситуация</th><th>Основание</th><th>Испытания устойчивости</th></tr></thead>
        <tbody>
          <tr><td>Первичное, нет записи в паспорте</td><td>п. 186</td><td>проводят</td></tr>
          <tr><td>Ремонт стрелы, опор с заменой, сваркой</td><td>п. 186</td><td>проводят</td></tr>
          <tr><td>Повторное освидетельствование</td><td>п. 187</td><td>не проводят, если иное не в руководстве</td></tr>
          <tr><td>Частичное освидетельствование</td><td>п. 169</td><td>не проводят</td></tr>
        </tbody>
      </table>
    </div>

    <h2 id="zakazchik" style="margin:36px 0 16px">Что это значит для заказчика</h2>
    <p>Заказчик арендованного автокрана испытания не организует и не оплачивает: освидетельствование — обязанность эксплуатирующей организации, а комплект испытательных грузов с фактической массой обеспечивает она же (п. 167, 183 ФНП №461). Для заказчика остаётся проверка записи. МОСКРАН-СЕРВИС ведёт её по короткому перечню; перечень — практика службы.</p>
    <ul>
      <li>МОСКРАН-СЕРВИС отвечает, проводились ли испытания устойчивости на автокране после ремонта стрелы или опор.</li>
      <li>МОСКРАН-СЕРВИС показывает страницу паспорта с записью и сроком следующего освидетельствования.</li>
      <li>Если запись отсутствует, МОСКРАН-СЕРВИС подбирает другой автокран той же грузоподъёмности.</li>
    </ul>
    <p>Остальные документы на машину проверяют по перечню из материала <a href="/proverka-dokumentov/" style="color:var(--yellow)">о проверке документов</a>; состав сведений, которые нужны для подбора крана, — в материале о <a href="/spravochnik/zayavka-na-avtokran/" style="color:var(--yellow)">заявке на автокран</a>.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: испытания автокрана на грузовую устойчивость</h2>
    <ul>
      <li>МОСКРАН-СЕРВИС ищет в паспорте автокрана запись об испытаниях устойчивости (п. 186 ФНП №461).</li>
      <li>Ремонт стрелы, гуська, опор или поворотного устройства в МОСКРАН-СЕРВИС оформляется испытаниями устойчивости (п. 186).</li>
      <li>Повторное освидетельствование автокрана МОСКРАН-СЕРВИС проводит без этих испытаний, если руководство не требует иного (п. 187).</li>
      <li>Положение для испытаний МОСКРАН-СЕРВИС берёт по минимальной устойчивости в рабочей зоне (п. 188).</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://www.consultant.ru/document/cons_doc_LAW_373321/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 (приказ Ростехнадзора от 26.11.2020 №461)</a> — п. 169 (состав полного освидетельствования), п. 186–188 (испытания на устойчивость), п. 189 (запись в паспорте).</li>
      <li><a href="https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 на legalacts.ru</a> — редакция от 16.04.2026, текст пунктов 169, 186–188 сверен 14.10.2026.</li>
    </ul>
    <p class="small muted">Нормы испытательной нагрузки и методика испытаний в этом материале не приводятся: их задаёт руководство по эксплуатации конкретной машины. Прочтение п. 169 «г» применительно к автокрану и перечень вопросов заказчика — оценка МОСКРАН-СЕРВИС, а не пункт нормы.</p>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-16-25-tonn/">Аренда автокрана 16–25 тонн →</a></section>
</main>
</SpravochnikLayout>
