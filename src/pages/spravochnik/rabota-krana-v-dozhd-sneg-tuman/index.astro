---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = 'Работа автокрана в дождь, снег и туман по ФНП №461';
const description = 'П. 132 ФНП №461 прекращает работу крана при снегопаде, дожде и тумане, если крановщик плохо различает сигналы или груз. Кто решает и как оформить простой.';

const CHECKED = '04.10.2026';
const PUBLISHED = '2026-10-04';
const SLUG = 'rabota-krana-v-dozhd-sneg-tuman';
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: 'Можно ли работать автокраном в дождь?',
    a: 'Можно, пока крановщик хорошо различает сигналы стропальщика и перемещаемый груз. П. 132 ФНП №461 требует прекращать работу при дожде, снегопаде и тумане именно в случае плохой различимости. Цифрового порога по дальности видимости в пункте нет, поэтому МОСКРАН-СЕРВИС оставляет решение за крановщиком.',
  },
  {
    q: 'Какая видимость считается достаточной для работы крана?',
    a: 'Единого числа в метрах ФНП №461 не называет: критерий функциональный — крановщик должен различать сигналы стропальщика и груз. МОСКРАН-СЕРВИС рекомендует закрепить в заявке и ППР конкретный способ связи, например радио, чтобы туман не останавливал работу сразу.',
  },
  {
    q: 'Кто принимает решение остановить кран из-за погоды?',
    a: 'Критерий п. 132 — что видит машинист: только он знает из кабины, различает ли сигналы и груз. МОСКРАН-СЕРВИС не продолжает подъём, если крановщик заявил, что не различает сигналы стропальщика.',
  },
  {
    q: 'Платит ли заказчик за простой крана из-за дождя или тумана?',
    a: 'Условие нужно прописать в договоре заранее: ФНП №461 о деньгах молчит. МОСКРАН-СЕРВИС рекомендует до заказа зафиксировать, считается ли метеопростой оплачиваемым временем и как фиксируется остановка — подробный разбор оплаты простоя дан в отдельном материале справочника.',
  },
  {
    q: 'Что ещё из паспорта крана ограничивает работу в непогоду?',
    a: 'П. 132 ФНП №461 называет ещё два параметра из паспорта ПС: предельную скорость ветра и предельную температуру окружающей среды. Конкретные значения у каждого крана свои, МОСКРАН-СЕРВИС сверяет их с паспортом машины, которая приедет на объект.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Работа автокрана в дождь, снегопад и туман', item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ['norma', 'Что требует пункт 132'],
  ['kriteriy', 'Критерий — различимость, а не миллиметры осадков'],
  ['kto', 'Кто решает остановить кран'],
  ['svyaz', 'Как сохранить работу в плохую видимость'],
  ['dogovor', 'Простой по погоде и договор'],
  ['faq', 'Частые вопросы'],
  ['istochniki', 'Источники'],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Работа автокрана в дождь, снегопад и туман</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">ФНП №461 · Погодные ограничения</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Можно ли работать автокраном в дождь, снегопад и туман?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>04.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>04.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>5 мин чтения</span>
    </div>

    <p>Пункт 132 ФНП №461 требует прекращать работу крана на открытом воздухе при снегопаде, дожде и тумане, но только когда крановщик плохо различает сигналы стропальщика или перемещаемый груз. Цифр по осадкам и дальности видимости норма не задаёт. МОСКРАН-СЕРВИС разбирает, как этот критерий работает на практике и кто решает.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="norma" style="margin:36px 0 16px">Что требует пункт 132</h2>
    <p>П. 132 ФНП №461 перечисляет три условия остановки подъёмного сооружения на открытом воздухе: ветер выше предельной скорости из паспорта, температура ниже предельной из паспорта и осадки с туманом при плохой различимости. Текст сверен по разделу VI «Установка ПС и производство работ» на sudact.ru 04.10.2026. МОСКРАН-СЕРВИС выделяет в норме различие: ветер и мороз привязаны к цифрам паспорта, а дождь, снегопад и туман — только к тому, что видит машинист.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Условие</th><th>Порог остановки</th><th>Где взять число</th></tr></thead>
        <tbody>
          <tr><td>Ветер</td><td>Выше предельной скорости</td><td>Паспорт ПС</td></tr>
          <tr><td>Низкая температура</td><td>Ниже предельной температуры</td><td>Паспорт ПС</td></tr>
          <tr><td>Снегопад, дождь, туман</td><td>Крановщик плохо различает сигналы стропальщика или груз</td><td>Числа нет — оценка машиниста</td></tr>
        </tbody>
      </table>
    </div>

    <h2 id="kriteriy" style="margin:36px 0 16px">Критерий — различимость, а не миллиметры осадков</h2>
    <p>Норма не привязывает остановку к интенсивности дождя или метрам видимости, поэтому ливень не обязан останавливать КС-55713 «Клинцы», пока машинист видит стропальщика и груз. И наоборот: лёгкий туман на площадке с плохим освещением может остановить работу раньше. МОСКРАН-СЕРВИС напоминает, что освещённость площадки заказчик обеспечивает отдельно — требования разобраны в <a href="/spravochnik/osveshchenie-ploshchadki/" style="color:var(--yellow)">материале об освещении площадки</a>.</p>
    <p>Для высоты подъёма это критично, и МОСКРАН-СЕРВИС учитывает её при подборе машины. Крюк «Галичанина» КС-65713-1 уходит на 34,5 м (44,4 м с гуськом), и на такой высоте груз виден машинисту хуже, чем сигнальщик у земли. Если стропальщик и груз находятся в разных зонах видимости, нужен промежуточный сигнальщик — ссылки на правила сигналов даны в <a href="/spravochnik/signaly-stropalshchika/" style="color:var(--yellow)">справочнике сигналов стропальщика</a>.</p>

    <h2 id="kto" style="margin:36px 0 16px">Кто решает остановить кран</h2>
    <p>Критерий п. 132 привязан к восприятию крановщика, поэтому на месте решает машинист. МОСКРАН-СЕРВИС не продолжает подъём, если крановщик КС-55713 «Клинцы» или другого автокрана заявил о плохой видимости. О последствиях падения груза читайте в <a href="/spravochnik/otvetstvennost-za-padenie-gruza/" style="color:var(--yellow)">материале об ответственности за падение груза</a>.</p>
    <p>МОСКРАН-СЕРВИС относит остановку по погоде к штатным ситуациям, но она требует безопасного завершения операции. По п. 114 ФНП №461 по окончании работ на грузозахватном органе не должно оставаться подвешенного груза, поэтому при ухудшении видимости машинист опускает груз на основание, а не ждёт у крюка улучшения погоды.</p>

    <h2 id="svyaz" style="margin:36px 0 16px">Как сохранить работу в плохую видимость</h2>
    <p>П. 132 ФНП №461 говорит о различении сигналов, а не о запрете работы в плохую погоду как таковую. Если стропальщик и машинист связаны радиостанцией, а груз виден на малой высоте, работа может идти и в моросящий дождь. МОСКРАН-СЕРВИС рекомендует вписать способ связи и освещение в ППР — <a href="/spravochnik/ppr-dlya-krana/" style="color:var(--yellow)">разбор ППР для крана</a> показывает, какие разделы отвечают за это.</p>
    <p>Скорость ветра идёт отдельным критерием по паспорту «Клинцов» или «Галичанина», и в дождь она часто растёт одновременно с ухудшением видимости. Конкретные ограничения по ветру приведены в материале <a href="/spravochnik/rabota-krana-pri-silnom-vetre/" style="color:var(--yellow)">«Работа крана при сильном ветре»</a>, а зимний комплекс условий — в <a href="/spravochnik/rabota-krana-zimoy/" style="color:var(--yellow)">справочнике по зимней работе крана</a>.</p>

    <h2 id="dogovor" style="margin:36px 0 16px">Простой по погоде и договор</h2>
    <p>ФНП №461 регулирует безопасность, но не оплату: сколько платить за час простоя из-за тумана, определяет договор аренды. МОСКРАН-СЕРВИС рекомендует до заказа согласовать три вещи: считается ли метеопростой оплачиваемым временем, кто и как фиксирует остановку (запись в вахтенном журнале, фото, акт) и можно ли перенести смену без штрафа.</p>
    <p>МОСКРАН-СЕРВИС ведёт запись остановок по каждой смене. Общий порядок оплаты простоя и документы, подтверждающие вину стороны, разобраны в материале <a href="/spravochnik/prostoy-tehniki-oplata/" style="color:var(--yellow)">«Простой техники: кто платит»</a>. Запись об остановке машинист вносит в <a href="/spravochnik/vahtennyy-zhurnal-krana/" style="color:var(--yellow)">вахтенный журнал крана</a> — она служит основанием для акта простоя.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: дождь, снег и туман</h2>
    <ul>
      <li>П. 132 ФНП №461: остановка при снегопаде, дожде, тумане, если крановщик плохо различает сигналы или груз.</li>
      <li>Порога в мм осадков или метрах видимости нет — оценка машиниста.</li>
      <li>Ветер и мороз ограничены цифрами паспорта ПС.</li>
      <li>Критерий остановки — различимость сигналов и груза для машиниста.</li>
      <li>Оплату простоя по погоде нужно прописать в договоре заранее.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://sudact.ru/law/prikaz-rostekhnadzora-ot-26112020-n-461-ob/federalnye-normy-i-pravila-v/vi/ustanovka-ps-i-proizvodstvo-rabot/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461, раздел VI «Установка ПС и производство работ» (ред. от 16.04.2026)</a> — п. 114, п. 132.</li>
      <li><a href="https://kran-master74.ru/heavy/truck_cranes/galichanin/avtokran_galichanin_ks_65713_1_50_t/" target="_blank" rel="noopener" style="color:var(--yellow)">КС-65713-1 «Галичанин», 50 т — карточка дилера «Кран-Мастер»</a> — высота подъёма крюка КС-65713-1 с гуськом 44,4 м.</li>
      <li><a href="/spravochnik/prostoy-tehniki-oplata/" style="color:var(--yellow)">Простой техники — справочник МОСКРАН-СЕРВИС</a> — порядок оплаты и фиксации.</li>
    </ul>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-25-40-tonn/">Аренда автокрана 25–40 тонн →</a></section>
</main>
</SpravochnikLayout>
