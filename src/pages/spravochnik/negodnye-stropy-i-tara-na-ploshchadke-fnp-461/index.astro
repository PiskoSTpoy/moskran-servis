---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = "Негодные стропы и тара на площадке: п. 218–219 ФНП 461";
const description = "Негодные стропы, тара без маркировки и с истёкшим сроком службы не должны находиться на площадке; осмотр перед применением обязателен (пп. 218–219 ФНП №461).";

const CHECKED = '18.10.2026';
const PUBLISHED = '2026-10-18';
const SLUG = "negodnye-stropy-i-tara-na-ploshchadke-fnp-461";
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: "Можно ли хранить негодные стропы на площадке?",
    a: "Нет, п. 218 ФНП №461 не допускает нахождения негодных приспособлений и тары в местах работ с ПС. МОСКРАН-СЕРВИС вывозит их или убирает из зоны.",
  },
  {
    q: "Годен ли строп без бирки?",
    a: "Отсутствие необходимой маркировки — основание признать приспособление негодным (п. 218 ФНП №461). МОСКРАН-СЕРВИС такой строп не использует.",
  },
  {
    q: "Кто осматривает стропы перед работой?",
    a: "Стропальщики и крановщики (операторы) перед применением (п. 219 ФНП №461). МОСКРАН-СЕРВИС ведёт осмотр при каждой подаче.",
  },
  {
    q: "Что такое браковочные показатели?",
    a: "Показатели из руководства (инструкции) по эксплуатации приспособления, по которым его признают негодным (п. 219 ФНП №461). МОСКРАН-СЕРВИС держит эти документы на площадке.",
  },
  {
    q: "Нужен ли проект для ремонта стропа?",
    a: "Нет, ремонт стропа выполняют заменой изношенных элементов на новые без проекта (п. 221 ФНП №461). Для иных приспособлений проект нужен. МОСКРАН-СЕРВИС оформляет акт после ремонта.",
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: "Негодные стропы и тара на площадке по ФНП №461", item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ["zapret", "Что запрещает п. 218"],
  ["osmotr", "Осмотр перед применением по п. 219"],
  ["remont", "Ремонт и проверка после него"],
  ["kto", "Кто имеет право строповать"],
  ["moskva", "КС-55713 «Клинцы» на московской площадке"],
  ["faq", "Частые вопросы"],
  ["istochniki", "Источники"],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Негодные стропы и тара на площадке по ФНП №461</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">ФНП №461 · Грузозахватные приспособления</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Что делать со стропами и тарой без маркировки или с истёкшим сроком службы?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>18.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>18.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>5 мин чтения</span>
    </div>

    <p>П. 218 ФНП №461 запрещает держать в местах работ с ПС негодные съёмные грузозахватные приспособления и тару, в том числе без маркировки и с истёкшим сроком службы. Стропальщик и крановщик по п. 219 осматривают приспособление перед каждым применением. МОСКРАН-СЕРВИС убирает такие стропы с площадки до подъёма.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="zapret" style="margin:36px 0 16px">Что запрещает п. 218</h2>
    <p>Съёмные грузозахватные приспособления и тара, признанные негодными, в том числе из-за отсутствия необходимой маркировки, а также приспособления с истёкшим сроком безопасной эксплуатации не должны находиться в местах производства работ с ПС (п. 218 ФНП №461). Норма запрещает не только применять, но и хранить такие стропы на площадке. МОСКРАН-СЕРВИС убирает их из зоны работ или помечает и увозит.</p>
    <p>Три признака негодности в п. 218 независимы: заключение о негодности, отсутствие маркировки, истёкший срок службы. Достаточно любого. Строп без бирки с грузоподъёмностью, лежащий у крана, нарушает п. 218 даже при целых прядях. МОСКРАН-СЕРВИС при приёмке площадки осматривает кучу стропов в поисках безымянных.</p>

    <h2 id="osmotr" style="margin:36px 0 16px">Осмотр перед применением по п. 219</h2>
    <p>Стропальщики и крановщики перед применением осматривают грузозахватные приспособления и используют браковочные показатели из их руководства (инструкции) по эксплуатации (п. 219 ФНП №461). Осмотр ведут при каждом применении, а не раз в десять дней. МОСКРАН-СЕРВИС берёт показатели из паспорта конкретного стропа, а не «из головы».</p>
    <p>Периодичность осмотров п. 224 — траверсы, захваты и тара ежемесячно, стропы каждые 10 дней, редко используемые перед работой — относится к плановым осмотрам и описана в материале об <a href="/spravochnik/osmotr-stropov-i-traverc-fnp-461/" style="color:var(--yellow)">осмотре строп и траверс</a>. Осмотр перед применением и плановый осмотр — два разных слоя контроля. МОСКРАН-СЕРВИС ведёт оба.</p>

    <h2 id="remont" style="margin:36px 0 16px">Ремонт и проверка после него</h2>
    <p>Ремонт и реконструкцию съёмных грузозахватных приспособлений ведут по проекту изготовителя или специализированной организации, а ремонт стропов выполняют заменой изношенных элементов на новые без разработки проекта (п. 221 ФНП №461). После ремонта обязательны проверка качества и статические испытания (п. 222). Порядок испытаний описан в справке о <a href="/spravochnik/staticheskoe-ispytanie-gruzozahvatnyh-prisposoblenij-fnp-461/" style="color:var(--yellow)">статическом испытании приспособлений</a>. МОСКРАН-СЕРВИС возвращает отремонтированный строп в комплект только с актом.</p>
    <p>П. 220 ФНП добавляет ежегодный осмотр клещей, траверс и захватов с разборкой тех узлов, состояние которых нельзя оценить в собранном виде, по графику; срок целесообразно совместить с техническим освидетельствованием ПС или текущим ремонтом. МОСКРАН-СЕРВИС ставит эти сроки в общий график крана.</p>

    <h2 id="kto" style="margin:36px 0 16px">Кто имеет право строповать</h2>
    <p>Персонал, назначаемый для строповки, включая навешивание на крюк, зацепку и обвязку грузов, должен иметь квалификацию «стропальщик» (п. 216 ФНП №461). Без неё осмотр по п. 219 бессмысленен: человек не знает браковочных показателей. Требования к человеку расписаны в материале о <a href="/spravochnik/trebovaniya-k-stropalshchiku/" style="color:var(--yellow)">стропальщике</a>. МОСКРАН-СЕРВИС просит удостоверение стропальщика до начала смены.</p>

    <h2 id="moskva" style="margin:36px 0 16px">КС-55713 «Клинцы» на московской площадке</h2>
    <p>На московской стройке негодные стропы чаще всего остаются после смены подрядчиков: старые цепи в углу, бирки стёрты, тара из-под кирпича. Автокран КС-55713 «Клинцы» подходит к такой площадке с комплектом МОСКРАН-СЕРВИС, а чужие стропы проверяются по п. 218 до подъёма. Это практика проверки, а не отдельное требование нормы.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: негодные стропы и тара на площадке</h2>
    <ul>
      <li>МОСКРАН-СЕРВИС не допускает на площадку стропы и тару без маркировки или с истёкшим сроком службы (п. 218 ФНП №461).</li>
      <li>Стропальщик и крановщик осматривают приспособление перед каждым применением по браковочным показателям из паспорта (п. 219).</li>
      <li>После ремонта строп возвращают в работу только после проверки и испытаний (п. 222).</li>
      <li>Строповать допускается персонал с квалификацией «стропальщик» (п. 216).</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://www.consultant.ru/document/cons_doc_LAW_373321/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 (приказ Ростехнадзора от 26.11.2020 №461)</a> — пп. 216, 218–222 (квалификация стропальщика, негодные приспособления и тара, осмотр перед применением, ремонт и испытания после него), п. 224.</li>
      <li><a href="https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 на legalacts.ru</a> — редакция от 16.04.2026, текст пунктов 216–222 сверен 18.10.2026.</li>
    </ul>
    <p class="small muted">Описание московской площадки — практика МОСКРАН-СЕРВИС, а не пункт нормы.</p>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-16-25-tonn/">Аренда автокрана 16–25 тонн →</a></section>
</main>
</SpravochnikLayout>
