---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = "Кто отвечает за техсостояние арендованного автокрана";
const description = "Содержание крана в работоспособном состоянии и остановку при дефектах обеспечивает эксплуатирующая организация (пп. 147, 154 ФНП №461).";

const CHECKED = '29.10.2026';
const PUBLISHED = '2026-10-29';
const SLUG = "kto-otvechaet-za-tehsostoyanie-arendovannogo-avtokrana-fnp-461";
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    "q": "Кто отвечает за поломку арендованного автокрана на объекте?",
    "a": "За работоспособное состояние отвечает эксплуатирующая организация: она обязана организовать осмотры, обслуживание и ремонт и своевременно устранять выявленные дефекты (пп. 147, 154 ФНП №461). При аренде с экипажем это арендодатель. Условия замены крана и оплаты простоя определяются договором."
  },
  {
    "q": "Кто отвечает за безопасность при работе арендованного крана?",
    "a": "Организация, выделившая подъёмное сооружение для работ (п. 122 ФНП №461). Заказчик отвечает за те условия, которые остаются на его стороне: подготовленную площадку, согласования, ограничение доступа людей. Распределение задач закрепляют в договоре и ППР."
  },
  {
    "q": "Должен ли заказчик проверять техсостояние арендованного крана?",
    "a": "Обязанности следить за техсостоянием у заказчика по ФНП №461 нет: её несёт эксплуатирующая организация. Но запросить копию паспорта и убедиться, что даты освидетельствований не прошли, заказчику имеет смысл: так видно, что кран допущен к работе."
  },
  {
    "q": "Что делать, если кран остановили из-за неисправности?",
    "a": "Зафиксировать причину в вахтенном журнале, уточнить срок устранения или замены машины и сверить условия простоя с договором. Остановка при неустранимом несоответствии технологическому процессу — обязанность эксплуатирующей организации по п. 154 ФНП №461."
  },
  {
    "q": "Меняется ли ответственность, если арендовать кран без экипажа?",
    "a": "Меняется: управление и техническая эксплуатация переходят к арендатору, и он становится эксплуатирующей организацией со всеми обязанностями п. 147 ФНП №461. МОСКРАН-СЕРВИС предоставляет технику только с экипажем, поэтому таких обязанностей у заказчика не возникает."
  }
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: "Кто отвечает за техсостояние арендованного крана", item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [["norma", "Что ФНП №461 возлагает на эксплуатирующую организацию"], ["defekty", "Дефекты и остановка эксплуатации по п. 154"], ["razdelenie", "Кто за что отвечает: аренда с экипажем"], ["zakazchik", "Что делать заказчику, если кран остановили на объекте"], ["dokumenty", "Какие документы показывают, что кран содержится в порядке"], ["faq", "Частые вопросы"], ["istochniki", "Источники"]];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Кто отвечает за техсостояние арендованного крана</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">ФНП №461 · Аренда</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Кто отвечает за техническое состояние арендованного автокрана?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>29.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>29.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>6 мин чтения</span>
    </div>

    <p>За работоспособное состояние крана отвечает эксплуатирующая организация: ФНП №461 обязывает её организовать надзор, обслуживание, освидетельствование и ремонт (п. 147) и устранять выявленные дефекты, а при невозможности привести кран в соответствие с технологическим процессом остановить эксплуатацию (п. 154). При аренде автокрана с экипажем арендодатель оказывает услуги по управлению и технической эксплуатации (ст. 632 ГК РФ), поэтому МОСКРАН-СЕРВИС держит эти обязанности на себе, а заказчик отвечает за площадку и допуск людей.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="norma" style="margin:36px 0 16px">Что ФНП №461 возлагает на эксплуатирующую организацию</h2>
    <p>Пункт 147 ФНП №461 обязывает эксплуатирующую организацию содержать подъёмные сооружения в работоспособном состоянии и обеспечивать безопасные условия работы через надзор, обслуживание, техническое освидетельствование и ремонт. Для этого она устанавливает порядок периодических осмотров, технических обслуживаний и ремонтов крана, грузозахватных органов, приспособлений и тары, порядок проверки знаний и допуска персонала, а также утверждает журналы, графики планово-предупредительных ремонтов, ППР, технологические карты и схемы строповки.</p>
    <p>Отдельно п. 122 закрепляет, что ответственность за выполнение требований промышленной безопасности при работе подъёмного сооружения несёт организация, которая это сооружение выделила для работ. Общий перечень её обязанностей дан в справке про <a href="/spravochnik/obyazannosti-organizacii-pri-vydelenii-avtokrana/" style="color:var(--yellow)">обязанности организации при выделении автокрана</a>.</p>

    <h2 id="defekty" style="margin:36px 0 16px">Дефекты и остановка эксплуатации по п. 154</h2>
    <p>Пункт 154 ФНП №461 требует от эксплуатирующей организации своевременно устранять выявленные неисправности, дефекты и повреждения, а также обеспечивать соответствие крана технологическому процессу. Если привести кран в соответствие с требованиями промышленной безопасности технологического процесса невозможно, его эксплуатацию останавливают.</p>
    <p>Для заказчика это значит, что остановка крана при неустранимом несоответствии — не каприз арендодателя, а прямая обязанность по норме. Что делает оператор в момент, когда дефект обнаружен, описано в справке про <a href="/spravochnik/neispravnost-krana-na-obekte/" style="color:var(--yellow)">неисправность крана на объекте</a>, а основания для недопуска крана к работе — в справке про <a href="/spravochnik/kogda-avtokran-ne-dopuskayut-k-rabote-fnp-461/" style="color:var(--yellow)">недопуск автокрана к работе</a>.</p>

    <h2 id="razdelenie" style="margin:36px 0 16px">Кто за что отвечает: аренда с экипажем</h2>
    <p>При аренде с экипажем часть обязанностей, которые норма возлагает на эксплуатирующую организацию, исполняет арендодатель, потому что по ст. 632 ГК РФ именно он оказывает услуги по управлению транспортным средством и его технической эксплуатации. Разграничение зон ответственности между сторонами фиксируют договором; таблица ниже показывает, как обязанности, названные в ФНП №461, ложатся на аренду с экипажем у МОСКРАН-СЕРВИС.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Задача</th><th>Кто исполняет при аренде с экипажем</th><th>Основание</th></tr></thead>
        <tbody>
          <tr><td>Осмотры, обслуживание, ремонт крана и грузозахватных органов</td><td>Арендодатель как эксплуатирующая организация</td><td>п. 147 «а»</td></tr>
          <tr><td>Проверки указателей, ограничителей, регистраторов в сроки по руководству</td><td>Арендодатель</td><td>п. 122</td></tr>
          <tr><td>Испытанные и маркированные грузозахватные приспособления и тара</td><td>Организация, выделившая кран</td><td>п. 122</td></tr>
          <tr><td>Устранение дефектов, остановка при несоответствии технологическому процессу</td><td>Арендодатель, при участии заказчика в части условий площадки</td><td>п. 154</td></tr>
          <tr><td>Подготовленная площадка, согласования, допуск людей на площадку</td><td>Заказчик (по договору и ППР)</td><td>практика, пп. 155–156</td></tr>
        </tbody>
      </table>
    </div>
    <p>Первые четыре строки прямо следуют из норм; последняя строка — практика распределения между сторонами, и в конкретном договоре она может быть другой. Формат аренды без экипажа устроен иначе и разобран в справке про <a href="/spravochnik/arenda-s-ekipazhem-i-bez/" style="color:var(--yellow)">аренду с экипажем и без</a>.</p>

    <h2 id="zakazchik" style="margin:36px 0 16px">Что делать заказчику, если кран остановили на объекте</h2>
    <p>Остановка автокрана из-за дефекта требует от заказчика трёх действий: зафиксировать причину, узнать срок устранения или замены и сверить это с условиями простоя в договоре. Порядок описан как практика, поскольку условия оплаты простоя и срок замены техники определяются договором, а не ФНП. МОСКРАН-СЕРВИС записывает причину остановки в вахтенный журнал крана и называет срок замены КС-55713 «Клинцы» или КС-65713-1 «Галичанин».</p>
    <ol>
      <li>Попросите оператора записать причину остановки в <a href="/spravochnik/vahtennyy-zhurnal-krana/" style="color:var(--yellow)">вахтенный журнал крана</a>.</li>
      <li>Уточните, устранима ли неисправность на месте или нужна замена машины.</li>
      <li>Сверьте с договором порядок оплаты и учёта времени, см. справку про <a href="/spravochnik/prostoy-tehniki-oplata/" style="color:var(--yellow)">простой техники и оплату</a>.</li>
      <li>Сохраните копии паспорта и записей об освидетельствовании замещающего крана.</li>
    </ol>

    <h2 id="dokumenty" style="margin:36px 0 16px">Какие документы показывают, что кран содержится в порядке</h2>
    <p>Состояние крана подтверждают паспорт с записями об освидетельствованиях и ремонтах, вахтенный журнал и акты проверок приборов безопасности. Заказчику достаточно запросить копию паспорта и убедиться, что даты следующих освидетельствований не прошли. Порядок работы с ограничителем грузоподъёмности и другими приборами описан в справке про <a href="/spravochnik/proverka-priborov-bezopasnosti-avtokrana-fnp-461/" style="color:var(--yellow)">проверку приборов безопасности автокрана</a>.</p>
    <p>Подробнее о закрывающих документах после аренды сказано в справке про <a href="/spravochnik/zakryvayushchie-dokumenty-arenda-krana/" style="color:var(--yellow)">закрывающие документы по аренде крана</a>. МОСКРАН-СЕРВИС передаёт копию паспорта вместе с краном, чтобы проверка занимала минуты.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: техсостояние арендованного автокрана</h2>
    <ul>
      <li>Содержание крана в работоспособном состоянии, осмотры, ТО и ремонт обеспечивает эксплуатирующая организация (п. 147 ФНП №461).</li>
      <li>Дефекты устраняют своевременно; если кран нельзя привести в соответствие технологическому процессу, эксплуатацию останавливают (п. 154).</li>
      <li>Ответственность за промышленную безопасность при работе крана несёт организация, выделившая его для работ (п. 122).</li>
      <li>При аренде с экипажем управление и техническую эксплуатацию обеспечивает арендодатель (ст. 632 ГК РФ); границы зон фиксирует договор.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://www.consultant.ru/document/cons_doc_LAW_373321/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 (приказ Ростехнадзора от 26.11.2020 №461)</a> — пп. 122, 147, 154 (обязанности эксплуатирующей организации, дефекты, остановка эксплуатации).</li>
      <li><a href="https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 на legalacts.ru</a> — текст пунктов сверен 29.10.2026.</li>
      <li><a href="https://www.consultant.ru/document/cons_doc_LAW_9027/1ffe0cb622bfbe86c61d7d6df4c8c6011dfb45fe/" target="_blank" rel="noopener" style="color:var(--yellow)">ГК РФ, ст. 632</a> — аренда транспортного средства с экипажем.</li>
    </ul>
    <p class="small muted">Справка не заменяет договор аренды: границы ответственности сторон, условия простоя и замены техники определяются договором.</p>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-16-25-tonn/">Аренда автокрана 16–25 тонн →</a></section>
</main>
</SpravochnikLayout>
