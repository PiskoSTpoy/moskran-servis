---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = 'Челябинец КС-55732 или Ивановец КС-45717К-3: 25 тонн';
const description = 'КС-55732: 90 т·м, стрела 24,5 м, контур 5,75×6,3 м. КС-45717К-3: 80 т·м, стрела до 21 м, контур 5,6×4,95 м. Смена обоих — 20 800 ₽.';

const CHECKED = '07.10.2026';
const PUBLISHED = '2026-10-07';
const SLUG = 'chelyabinets-ili-ivanovets-25-tonn';
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: 'Чем отличается Челябинец КС-55732 от Ивановца КС-45717К-3?',
    a: 'У КС-55732 грузовой момент 90 т·м и основная стрела 24,5 м, у КС-45717К-3 — 80 т·м и стрела 9–21 м. Челябинец выигрывает в досягаемости и моменте, Ивановец — в компактности: опорный контур 5,6×4,95 м против 5,75×6,3 м. МОСКРАН-СЕРВИС выбирает по вылету и ширине площадки.',
  },
  {
    q: 'Какой из двух кранов лучше для узкого двора?',
    a: 'Для узкого двора подходит КС-45717К-3: его опорный контур 5,6×4,95 м по короткой стороне уже, чем у КС-55732 (5,75×6,3 м). Разница по короткой стороне — 1,35 м. МОСКРАН-СЕРВИС перед подачей просит замер двора и сверяет его с контуром конкретной машины.',
  },
  {
    q: 'Сколько стоит смена 25-тонного автокрана в МОСКРАН-СЕРВИС?',
    a: 'Ставка 25-тонного автокрана — 2 600 ₽ в час, смена 8 часов обходится в 20 800 ₽. Цена не зависит от того, подойдёт ли Челябинец или Ивановец: класс один. Выбор модели влияет на число выездов и время монтажа, а не на ставку.',
  },
  {
    q: 'Можно ли по «25 тоннам» поднять 25 тонн на любом вылете?',
    a: 'Нельзя: 25 т — максимум на минимальном вылете. С ростом вылета допустимая масса падает по таблице грузовой характеристики конкретной машины. МОСКРАН-СЕРВИС считает вылет по плану площадки и сверяет с таблицей из паспорта, а не с заголовком каталога.',
  },
  {
    q: 'Почему в каталогах у КС-45717 разные длины стрелы?',
    a: 'Под обозначением КС-45717 выпускают несколько модификаций с разными стрелами и шасси. Данные для КС-45717К-3 на КамАЗ-43118 — стрела 9–21 м, гусёк 9 м; в других версиях стрела длиннее. МОСКРАН-СЕРВИС уточняет модификацию и шасси до выезда, потому что характеристики берут из паспорта машины.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Челябинец или Ивановец 25 тонн', item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ['tablica', 'Две машины в одной таблице'],
  ['moment', 'Момент и досягаемость'],
  ['kontur', 'Опорный контур и узкая площадка'],
  ['stoimost', 'Цена смены и цена момента'],
  ['vybor', 'Как выбрать под задачу'],
  ['faq', 'Частые вопросы'],
  ['istochniki', 'Источники'],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Челябинец или Ивановец 25 тонн</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Выбор техники · 25 тонн</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Какой автокран 25 тонн выбрать: Челябинец КС-55732 или Ивановец КС-45717К-3?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>07.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>07.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>6 мин чтения</span>
    </div>

    <p>У Челябинца КС-55732 грузовой момент 90 т·м и стрела 24,5 м, у Ивановца КС-45717К-3 — 80 т·м и стрела до 21 м, поэтому первый берут для дальнего вылета, второй — для тесной площадки. МОСКРАН-СЕРВИС сравнивает обе машины по паспортным данным заводов, а не по заголовку «25 тонн». Ставка у обоих одна: смена 8 часов — 20 800 ₽.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="tablica" style="margin:36px 0 16px">Две машины в одной таблице</h2>
    <p>Числа для сравнения МОСКРАН-СЕРВИС берёт из каталога Челябинского механического завода (КС-55732) и каталога avtokran.ru (КС-45717К-3). Обе модели относятся к классу 25 т, но различаются по моменту, стреле и опорному контуру. Таблица показывает только то, что подтверждено этими двумя страницами.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Параметр</th><th>Челябинец КС-55732</th><th>Ивановец КС-45717К-3</th></tr></thead>
        <tbody>
          <tr><td>Грузоподъёмность</td><td>25 т</td><td>25 т</td></tr>
          <tr><td>Грузовой момент</td><td>90 т·м</td><td>80 т·м</td></tr>
          <tr><td>Основная стрела</td><td>24,5 м</td><td>9,0–21,0 м</td></tr>
          <tr><td>Гусёк</td><td>7 / 9 / 10 м</td><td>9 м</td></tr>
          <tr><td>Высота подъёма основной стрелой</td><td>до 25,2 м</td><td>21,4 м</td></tr>
          <tr><td>Высота с гуськом</td><td>до 34,7 м (гусёк 7 м)</td><td>29,9 м</td></tr>
          <tr><td>Опорный контур</td><td>5,75×6,3 м</td><td>5,6×4,95 м</td></tr>
          <tr><td>Шасси</td><td>Урал NEXT 6×6, КамАЗ-43118 6×6, КамАЗ-65115 6×4 и др.</td><td>КамАЗ-43118 6×6</td></tr>
          <tr><td>Масса с гуськом</td><td>в проверенном источнике не указана</td><td>21,02 т</td></tr>
        </tbody>
      </table>
    </div>

    <h2 id="moment" style="margin:36px 0 16px">Момент и досягаемость</h2>
    <p>Грузовой момент КС-55732 выше на 10 т·м, то есть на 12,5 % относительно 80 т·м у КС-45717К-3. Для МОСКРАН-СЕРВИС это означает запас на вылете 10–12 м, где грузоподъёмность определяется не заголовком 25 т, а произведением массы на вылет. Точная масса на заданном вылете берётся из таблицы паспорта, потому что реальная кривая ниже теоретической (момент / вылет).</p>
    <p>Стрела КС-55732, которую МОСКРАН-СЕРВИС сравнивает с Ивановцем, длиннее на 3,5 м (24,5 против 21 м), а высота подъёма основной стрелой на 3,8 м больше (25,2 против 21,4 м). Для подачи материалов на кровлю пятиэтажного дома разница заметна: крюк достаёт выше без гуська. Подробнее о том, как вылет влияет на допустимую массу, написано в материале о <a href="/spravochnik/gruzovysotnaya-harakteristika/" style="color:var(--yellow)">грузовысотной характеристике</a>.</p>

    <h2 id="kontur" style="margin:36px 0 16px">Опорный контур и узкая площадка</h2>
    <p>Опорный контур КС-45717К-3 равен 5,6×4,95 м, у КС-55732 — 5,75×6,3 м, поэтому Ивановец занимает на плане примерно на 24 % меньше площади (27,7 против 36,2 м²). МОСКРАН-СЕРВИС считает площадь как произведение сторон контура и понимает, что это только размер между опорами, без плит и подкладок. По короткой стороне разница 1,35 м, и именно она решает, встанет ли кран во двор между заборами.</p>
    <p>Узкий проезд — не единственное ограничение для МОСКРАН-СЕРВИС: под опоры нужна несущая поверхность. Как проверять пятно под плиты, описано в материалах о <a href="/spravochnik/nesushchaya-sposobnost-grunta/" style="color:var(--yellow)">несущей способности грунта</a> и об <a href="/spravochnik/ustoychivost-krana/" style="color:var(--yellow)">устойчивости крана</a>. Работа на части опор допускается только если паспорт предусматривает такой режим.</p>

    <h2 id="stoimost" style="margin:36px 0 16px">Цена смены и цена момента</h2>
    <p>Ставка МОСКРАН-СЕРВИС для 25-тонного автокрана — 2 600 ₽ в час, смена 8 часов стоит 20 800 ₽ независимо от модели. В пересчёте на паспортный момент выходит около 231 ₽ за т·м у КС-55732 и 260 ₽ за т·м у КС-45717К-3. Показатель условный: он не учитывает реальную кривую грузовой характеристики, зато наглядно показывает, что за те же деньги Челябинец даёт больший запас по моменту.</p>
    <p>Если площадка позволяет любую из машин, прибавка момента у Челябинца достаётся заказчику МОСКРАН-СЕРВИС бесплатно. Если площадка позволяет только компактную, экономия на контуре перевешивает: лишний выезд на перестановку обойдётся дороже разницы в 10 т·м. Общую стоимость аренды и состав ставки разбирает материал о <a href="/spravochnik/stoimost-arendy-avtokrana/" style="color:var(--yellow)">стоимости аренды автокрана</a>.</p>

    <h2 id="vybor" style="margin:36px 0 16px">Как выбрать под задачу</h2>
    <p>Челябинец КС-55732 подходит, когда нужен вылет 10 м и больше, подъём на кровлю или установка груза за препятствием. Ивановец КС-45717К-3 подходит для двора шириной в одну полосу, где важен короткий контур, и для грузов, которые ставят близко к машине. МОСКРАН-СЕРВИС предлагает опираться на три числа: масса груза, вылет по плану, ширина свободной площадки.</p>
    <p>Для заявки в МОСКРАН-СЕРВИС пригодятся замер двора, высота и расстояние установки груза. Заказ оформляют по <a href="/spravochnik/zayavka-na-avtokran/" style="color:var(--yellow)">заявке на автокран</a>, а сравнение с другими 25-тонниками смотрите в материалах <a href="/spravochnik/chelyabinets-ili-klintsy-25-tonn/" style="color:var(--yellow)">«Челябинец или Клинцы»</a> и <a href="/spravochnik/ivanovets-ili-klintsy-25-tonn/" style="color:var(--yellow)">«Ивановец или Клинцы»</a>.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: Челябинец или Ивановец</h2>
    <ul>
      <li>КС-55732: 90 т·м, стрела 24,5 м, контур 5,75×6,3 м.</li>
      <li>КС-45717К-3: 80 т·м, стрела 9–21 м, контур 5,6×4,95 м.</li>
      <li>Челябинец — для вылета и высоты, Ивановец — для тесной площадки (контур на 24 % меньше по площади).</li>
      <li>Смена 25 т в МОСКРАН-СЕРВИС — 20 800 ₽ для обеих моделей.</li>
      <li>Допустимую массу на вылете определяет таблица паспорта, а не «25 т».</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://www.cmz.ru/en/catalogue/mobile/ks-55732-25-24_ural-4320/" target="_blank" rel="noopener" style="color:var(--yellow)">КС-55732 — cmz.ru (Челябинский механический завод)</a> — 25 т, 90 т·м, стрела 24,5 м, гусёк 7/9/10 м, контур 5,75×6,3 м, высота подъёма.</li>
      <li><a href="https://en.avtokran.ru/catalog/avtomobilnye-krany/avtokran-ivanovets-ks-45717k-3/" target="_blank" rel="noopener" style="color:var(--yellow)">Ивановец КС-45717К-3 — avtokran.ru</a> — 80 т·м, стрела 9–21 м, гусёк 9 м, контур 5,6×4,95 м, масса 21,02 т, шасси КамАЗ-43118.</li>
    </ul>
    <p class="small muted">Данные каталогов могут отличаться у разных модификаций; решает паспорт конкретной машины.</p>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-25-40-tonn/">Аренда автокрана 25–40 тонн →</a></section>
</main>
</SpravochnikLayout>
