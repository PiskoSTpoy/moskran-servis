---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';
import Sources from '../../../components/Sources.astro';

const title = 'Что делать при повреждении кабеля на объекте с краном';
const description = 'При повреждении подземного кабеля работы немедленно прекращаются, сообщается руководителю и в аварийную службу. Персонал должен знать порядок действий.';

const CHECKED = '21.08.2026';

const faqs = [
  { q: 'Кто обязан сообщить о повреждении кабеля — оператор крана или другой персонал?', a: 'Любой, кто обнаружил повреждение — не только оператор крана. Производитель работ на объекте обязан немедленно прекратить работы, принять меры для безопасности работников и сообщить руководителю и в аварийную службу соответствующей организации, вне зависимости от того, кто именно заметил повреждение.' },
  { q: 'Можно ли продолжать работу крана в другой части площадки, пока решается вопрос с повреждённым кабелем?', a: 'Зависит от того, насколько удалена зона работы крана от места повреждения и связанной с ним опасной зоны. Решение принимается ответственным за безопасное производство работ с учётом конкретной ситуации — универсального правила «можно всегда» или «нельзя никогда» здесь нет.' },
  { q: 'Что персонал должен знать заранее, до начала работ рядом с ЛЭП?', a: 'Расстояния до высоковольтной линии электропередачи (см. отдельную статью про охранные зоны ЛЭП), порядок действий в случае повреждения линии, а также применение изолирующих материалов и инструментов — это часть подготовки бригады перед выездом на объект с таким риском, а не импровизация по факту.' },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Повреждение кабеля на объекте', item: 'https://moskran-servis.ru/spravochnik/povrezhdenie-kabelya-na-obekte/' },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@id': 'https://moskran-servis.ru/#organization' }, // ссылка на единственный узел организации (BaseLayout): отдельный узел с тем же @id, но другим name, был противоречием в графе
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: 'https://moskran-servis.ru/spravochnik/povrezhdenie-kabelya-na-obekte/',
  inLanguage: 'ru-RU',
  datePublished: '2026-08-12',
  dateModified: '2026-08-21',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<SpravochnikLayout title={title} description={description} path="/spravochnik/povrezhdenie-kabelya-na-obekte/" slug="povrezhdenie-kabelya-na-obekte" ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Повреждение кабеля на объекте</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Разбор для заказчика</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Обнаружено повреждение кабеля на объекте — что делать до и во время работы крана</h1>
    <p class="ref-byline">Инженерная служба МОСКРАН-СЕРВИС · обновлено в 2026 году</p>

    <p>В статье про охранные зоны ЛЭП мы разбирали расстояния и наряд-допуск для плановой работы рядом с воздушными линиями. Здесь — отдельный случай: что делать, если кабель (в том числе подземный) оказался повреждён уже в процессе работ на объекте.</p>

    <h2 style="margin:36px 0 16px">Первоочередные действия</h2>
    <p>При случайном повреждении подземного сооружения (кабельной линии в том числе) производитель работ обязан немедленно прекратить работы, принять меры, обеспечивающие безопасность работников, и сообщить о случившемся своему руководителю и в аварийную службу соответствующей организации. Это первый и обязательный шаг — до любых дальнейших действий на площадке.</p>

    <h2 style="margin:36px 0 16px">Порядок снятия напряжения</h2>
    <p>Для снятия напряжения на повреждённой линии кабельную линию отключают на распределительном щите, разряжают кабель на землю и заземляют его. Перед разрезанием кабеля или вскрытием соединительной муфты (если это требуется для устранения повреждения) обязательно проверяется отсутствие напряжения специальным приспособлением — изолирующей штангой со стальной иглой или режущим наконечником. Это работа специализированного персонала сетевой или обслуживающей организации, а не бригады крана.</p>

    <h2 style="margin:36px 0 16px">Что должен знать персонал заранее</h2>
    <p>Персонал, работающий на объекте с потенциальным риском повреждения кабельных линий, должен знать расстояния до высоковольтных линий электропередачи, порядок монтажа и демонтажа крана рядом с такими объектами, применение изолирующих материалов и инструментов, а также порядок действий в случае повреждения линии. Это не импровизация по факту происшествия, а часть подготовки бригады до выезда на объект с подобным риском.</p>

    <h2 style="margin:36px 0 16px">Как это соотносится с работой крана</h2>
    <p>Если повреждение произошло рядом с зоной работы крана, решение о том, можно ли продолжать работы в других частях площадки, принимает ответственный за безопасное производство работ (см. отдельную статью) — исходя из конкретной удалённости от опасной зоны и характера повреждения. Универсального правила здесь нет — каждая ситуация оценивается по факту.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: что запомнить</h2>
    <ul>
      <li>При обнаружении повреждения кабеля — немедленная остановка работ, обеспечение безопасности людей, сообщение руководителю и в аварийную службу.</li>
      <li>Снятие напряжения и работа с повреждённым кабелем — задача специализированного персонала сетевой организации.</li>
      <li>Персонал бригады крана должен знать порядок действий заранее, а не разбираться на месте.</li>
      <li>Решение о продолжении работ крана в других частях площадки — за ответственным за безопасное производство работ.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <Sources
      checked={CHECKED}
      items={[
        { text: 'umitz46.ru — охрана труда при работах на кабельных линиях', href: 'https://umitz46.ru/prikazN328n/prikazN328n-37' },
        { text: 'centr-teh.ru — работа крана вблизи ЛЭП: правила и документация', href: 'https://centr-teh.ru/blog/podemnye-krany/rabota-krana-vblizi-lep' }
      ]}
    />
  </article>
  <section class="section wrap"><a class="btn" href="/spravochnik/rabota-krana-ryadom-s-lep/">Охранные зоны ЛЭП — плановая работа →</a></section>
</main>
</SpravochnikLayout>
