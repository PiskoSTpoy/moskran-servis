---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = 'КС-35714 на КамАЗе или на Урале: 48 или 73 т·м';
const description = 'Две версии «Ивановца» 16 т: КС-35714К-2 на КамАЗ-43118 (48 т·м) и КС-35714-10 на Урале-5557 (73 т·м). Таблица различий и как выбрать под задачу.';

const CHECKED = '06.10.2026';
const PUBLISHED = '2026-10-06';
const SLUG = 'ks-35714-kamaz-ili-ural';
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: 'Чем отличаются КС-35714К-2 и КС-35714-10?',
    a: 'КС-35714К-2 стоит на шасси КамАЗ-43118 и даёт момент 48 т·м при стреле 8–18 м, а КС-35714-10 — на Урале-5557 с моментом 73 т·м и стрелой 9–23 м. Обе машины называют 16-тонными, но возможности на вылете у них разные. МОСКРАН-СЕРВИС сверяет модификацию по паспорту конкретного крана.',
  },
  {
    q: 'Почему у «Ивановца» 16 т разный грузовой момент?',
    a: 'Грузоподъёмность 16 т относится к минимальному вылету (1,9 м у КС-35714К-2), а момент определяет, сколько кран поднимет на рабочем вылете. У версии на Урале стрела длиннее и конструкция другая, поэтому момент выше. МОСКРАН-СЕРВИС оценивает задачу по грузовысотной характеристике, а не по цифре 16 т.',
  },
  {
    q: 'Какая версия «Ивановца» лучше для стройки в Москве?',
    a: 'Для плотной застройки важнее компактный опорный контур: у КС-35714К-2 он 5,2×4,0 м, у версии на Урале — 5,6×4,942 м. Для вылета дальше 12–14 м выигрывает вариант с большим моментом. МОСКРАН-СЕРВИС рекомендует решать по площадке, а не по шасси.',
  },
  {
    q: 'Выпускается ли КС-35714-10 на Урале?',
    a: 'На странице Уральского завода спецтехники КС-35714-10 помечен как снятый с производства, данные приведены справочно. Машины этой версии остаются в эксплуатации. МОСКРАН-СЕРВИС не обещает конкретную модификацию без подтверждения паспорта при заказе.',
  },
  {
    q: 'Сколько стоит смена 16-тонного автокрана?',
    a: 'Смена 16–20-тонного автокрана в МОСКРАН-СЕРВИС стоит 17 600 ₽ (2 200 ₽/ч × 8 ч). Ставка не зависит от того, на каком шасси смонтирован «Ивановец»: решает класс машины и условия объекта.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'КС-35714 на КамАЗе или на Урале', item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ['raznica', 'Две версии под одним названием'],
  ['tablica', 'Сравнение по параметрам'],
  ['moment', 'Что даёт разница в моменте'],
  ['ploshchadka', 'Площадка и опорный контур'],
  ['vybor', 'Как выбрать под задачу'],
  ['faq', 'Частые вопросы'],
  ['istochniki', 'Источники'],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>КС-35714 на КамАЗе или на Урале</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Сравнение · Автокраны 16 т</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">КС-35714 на КамАЗе или на Урале: в чём разница?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>06.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>06.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>5 мин чтения</span>
    </div>

    <p>«Ивановец» 16 т выпускается в версиях с моментом 48 т·м на КамАЗ-43118 и 73 т·м на Урале-5557, то есть разница достигает 52 %. МОСКРАН-СЕРВИС сравнивает КС-35714К-2 и КС-35714-10 по данным производителей: стрела, опорный контур, масса и ограничения площадки у них разные. Название «16 тонн» обеих машин не говорит о том, что они одинаково работают на вылете.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="raznica" style="margin:36px 0 16px">Две версии под одним названием</h2>
    <p>КС-35714К-2 на шасси КамАЗ-43118 (6×6, Евро 5) развивает момент 48 т·м при трёхсекционной стреле 8–18 м. КС-35714-10 на шасси Урал-5557-1152-72Е5 (6×6) даёт 73 т·м при стреле 9–23 м и вылете с гуськом до 30 м. МОСКРАН-СЕРВИС напоминает: в других материалах справочника для КС-35714 приведён момент 48 т·м, и он относится именно к версии на КамАЗе.</p>
    <p>Уральский завод спецтехники сообщает, что КС-35714-10 снят с производства, а страница оставлена справочной. Следовательно, машины с такой комплектацией работают на рынке аренды как вторичная техника. МОСКРАН-СЕРВИС подтверждает модификацию по паспорту при подтверждении заказа и не называет её заранее без документа.</p>

    <h2 id="tablica" style="margin:36px 0 16px">Сравнение по параметрам</h2>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Параметр</th><th>КС-35714К-2</th><th>КС-35714-10</th></tr></thead>
        <tbody>
          <tr><td>Шасси</td><td>КамАЗ-43118 (6×6)</td><td>Урал-5557-1152-72Е5 (6×6)</td></tr>
          <tr><td>Грузовой момент</td><td>48 т·м</td><td>73 т·м</td></tr>
          <tr><td>Стрела</td><td>8–18 м</td><td>9–23 м</td></tr>
          <tr><td>Опорный контур</td><td>5,2 × 4,0 м</td><td>5,6 × 4,942 м</td></tr>
          <tr><td>Полная масса</td><td>19,125 т</td><td>20,210 т</td></tr>
          <tr><td>Двигатель</td><td>221 кВт (300 л.с.)</td><td>ЯМЗ-53623-10, 275 л.с.</td></tr>
          <tr><td>Статус</td><td>серийная модель</td><td>снят с производства</td></tr>
        </tbody>
      </table>
    </div>

    <h2 id="moment" style="margin:36px 0 16px">Что даёт разница в моменте</h2>
    <p>Момент 73 т·м против 48 т·м означает, что при одинаковом вылете версия на Урале поднимет груз примерно в 1,5 раза тяжелее. Если груз 2 т нужно подать на вылет 12 м (24 т·м), обе машины справятся по моменту, но запас у КС-35714К-2 составляет 24 т·м, а у КС-35714-10 — 49 т·м. МОСКРАН-СЕРВИС напоминает, что реальный предел задаёт таблица на конкретном вылете и длине стрелы, поэтому момент служит только первой оценкой. Подробнее об этом — в материале о <a href="/spravochnik/gruzovysotnaya-harakteristika/" style="color:var(--yellow)">грузовысотной характеристике</a>.</p>

    <h2 id="ploshchadka" style="margin:36px 0 16px">Площадка и опорный контур</h2>
    <p>Контур опор КС-35714-10 больше на 0,4 м по длине и на 0,942 м по ширине. Масса крана выше на 1,085 т. Для узкого проезда во дворе или траншеи рядом с кранами эти сантиметры означают разницу между «встанет» и «нет». МОСКРАН-СЕРВИС просит заказчика сообщить размеры площадки и расстояние до котлована, а правила отступа разобраны в материале <a href="/spravochnik/rasstoyanie-ot-kotlovana/" style="color:var(--yellow)">«Расстояние от котлована»</a>.</p>
    <p>Более тяжёлая машина давит на грунт сильнее, поэтому для неё чаще нужны подкладки под опоры. Несущую способность грунта МОСКРАН-СЕРВИС проверяет по материалу о <a href="/spravochnik/nesushchaya-sposobnost-grunta/" style="color:var(--yellow)">несущей способности грунта</a>, а устойчивость машины — по справочнику об <a href="/spravochnik/ustoychivost-krana/" style="color:var(--yellow)">устойчивости крана</a>.</p>

    <h2 id="vybor" style="margin:36px 0 16px">Как выбрать под задачу</h2>
    <p>КС-35714К-2 подходит для коротких вылетов и стеснённых площадок. Он компактнее, и для грузов до 3–4 т его хватает. Версия с моментом 73 т·м нужна, когда работа идёт на вылете свыше 12–14 м, но при такой задаче МОСКРАН-СЕРВИС сравнивает её с 25-тонным краном по материалу <a href="/spravochnik/avtokran-16-ili-25-tonn/" style="color:var(--yellow)">«Автокран 16 или 25 тонн»</a> и <a href="/spravochnik/ivanovets-ili-klintsy-25-tonn/" style="color:var(--yellow)">«Ивановец или Клинцы 25 т»</a>.</p>
    <p>Смена 16–20-тонного автокрана в МОСКРАН-СЕРВИС стоит 17 600 ₽ (2 200 ₽/ч × 8 ч). Паспорт крана подтверждает модификацию и допустимые вылеты: как его читать, описано в материале <a href="/spravochnik/pasport-krana/" style="color:var(--yellow)">«Паспорт крана»</a>.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: КС-35714 на КамАЗе или Урале</h2>
    <ul>
      <li>КС-35714К-2 (КамАЗ-43118): 48 т·м, стрела 8–18 м, контур 5,2×4,0 м, 19,125 т.</li>
      <li>КС-35714-10 (Урал-5557): 73 т·м, стрела 9–23 м, контур 5,6×4,942 м, 20,21 т.</li>
      <li>Версия на Урале снята с производства по данным завода.</li>
      <li>Момент выше в 1,5 раза, но площадка требует большего места.</li>
      <li>Решает паспорт машины и таблица на нужном вылете, а не название «16 т».</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://kamaz.ru/production/special/avtokrany/avtomobilnyy-kran-ks-35714k-2/" target="_blank" rel="noopener" style="color:var(--yellow)">КС-35714К-2 — kamaz.ru</a> — шасси КамАЗ-43118, 48 т·м, стрела 8–18 м, контур 5200×4000 мм, масса 19,125 т.</li>
      <li><a href="https://uzst.ru/tech/avtokrany-i-specztexnika-s-kmu/avtokrany-ural/avtokrany-ivanovec/ural-ks-35714-10-ivanovecz-16-t" target="_blank" rel="noopener" style="color:var(--yellow)">КС-35714-10 — Уральский завод спецтехники</a> — шасси Урал-5557, 73 т·м, стрела 9–23 м, масса 20 210 кг, статус «снят с производства».</li>
      <li><a href="/spravochnik/avtokran-16-ili-25-tonn/" style="color:var(--yellow)">Автокран 16 или 25 т — справочник МОСКРАН-СЕРВИС</a> — сравнение классов и цена смены.</li>
    </ul>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-16-25-tonn/">Аренда автокрана 16–25 тонн →</a></section>
</main>
</SpravochnikLayout>
