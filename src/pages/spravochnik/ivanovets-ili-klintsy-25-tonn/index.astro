---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = 'Ивановец или Клинцы: какой автокран 25 тонн взять';
const description = 'КС-45717К-1Р «Ивановец»: стрела 30,7 м, крюк 30,6 м, 85 т·м. КС-55713-1К «Клинцы»: 21 м и тот же момент, опоры уже. Смена обоих — 20 800 ₽.';

const CHECKED = '30.09.2026';
const PUBLISHED = '2026-09-30';
const SLUG = 'ivanovets-ili-klintsy-25-tonn';
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: 'Какой автокран 25 тонн выше поднимает: Ивановец или Клинцы?',
    a: 'КС-45717К-1Р «Ивановец» поднимает крюк на 30,6 м основной стрелой 30,7 м и на 39,3 м с гуськом 9 м. КС-55713-1К «Клинцы» — на 21,6 м и 29,3 м. Разница без гуська — 9 м. МОСКРАН-СЕРВИС предлагает «Ивановец», когда высота крюка нужна больше 22 м.',
  },
  {
    q: 'У кого больше грузоподъёмность на вылете?',
    a: 'Паспортный грузовой момент у обоих кранов одинаков — 85 т·м, поэтому на близком вылете они равны. Разница в геометрии: у «Ивановца» вылет основной стрелой до 26,0 м. Допустимую массу на каждом вылете называет таблица паспорта конкретной машины, МОСКРАН-СЕРВИС сверяет её до выезда.',
  },
  {
    q: 'Какой кран лучше для тесного двора?',
    a: 'Для тесного двора лучше КС-55713-1К «Клинцы»: опорный контур 4,9 × 6,1 м против 5,43 × 6,00 м у «Ивановца». Разница 0,53 м по ширине иногда решает, встанут ли опоры на асфальт. МОСКРАН-СЕРВИС определяет модель по схеме проезда из заявки.',
  },
  {
    q: 'Отличается ли цена смены Ивановца и Клинцов?',
    a: 'Нет: МОСКРАН-СЕРВИС берёт за оба крана класса 25 т одну ставку 2 600 ₽ в час, смена 8 часов стоит 20 800 ₽. Модель выбирают по высоте подъёма, вылету и месту установки, а не по цене.',
  },
  {
    q: 'На каком шасси делают Ивановец КС-45717К-1Р?',
    a: 'Завод «Автокран» выпускает КС-45717К-1Р на шасси КАМАЗ-65115 с колёсной формулой 6×4 и двигателем КАМАЗ 667.511-300. Скорость передвижения до 60 км/ч, длина 12 000 мм, ширина 2 550 мм. У версии КС-45717-1Р шасси Урал-4320 с формулой 6×6, МОСКРАН-СЕРВИС уточняет исполнение при подборе.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Ивановец или Клинцы', item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ['tablica', 'Характеристики рядом'],
  ['vysota', 'Высота подъёма'],
  ['opory', 'Опоры и двор'],
  ['shassi', 'Шасси и масса'],
  ['vybor', 'Как выбрать'],
  ['faq', 'Частые вопросы'],
  ['istochniki', 'Источники'],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Ивановец или Клинцы</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Выбор техники · Класс 25 т</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Ивановец КС-45717 или Клинцы КС-55713: какой автокран на 25 тонн выбрать?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>30.09.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>30.09.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>6 мин чтения</span>
    </div>

    <p>У КС-45717К-1Р «Ивановец» и КС-55713-1К «Клинцы» одинаковый грузовой момент — 85 т·м, поэтому выбирают их по геометрии. «Ивановец» с основной стрелой 30,7 м поднимает крюк на 30,6 м, «Клинцы» со стрелой 21 м — на 21,6 м. Зато опорный контур «Клинцов» уже: 4,9 × 6,1 м против 5,43 × 6,00 м. МОСКРАН-СЕРВИС берёт за оба крана 20 800 ₽ за смену.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="tablica" style="margin:36px 0 16px">Характеристики рядом</h2>
    <p>Сравнение построено по данным изготовителя «Ивановца» и официального дилера «Клинцов»; МОСКРАН-СЕРВИС сверил обе карточки 30.09.2026. Числа нужны для предварительного выбора, а допустимая масса на вылете определяется таблицей паспорта конкретной машины.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Параметр</th><th>«Ивановец» КС-45717К-1Р</th><th>«Клинцы» КС-55713-1К</th></tr></thead>
        <tbody>
          <tr><td>Грузоподъёмность / грузовой момент</td><td>25 т / 85 т·м</td><td>25 т / 85 т·м</td></tr>
          <tr><td>Основная стрела</td><td>9,9–30,7 м</td><td>до 21 м</td></tr>
          <tr><td>Высота крюка без гуська</td><td>30,6 м</td><td>21,6 м</td></tr>
          <tr><td>Гусёк / высота с гуськом</td><td>9,0 м / 39,3 м</td><td>7,5 м / 29,3 м</td></tr>
          <tr><td>Вылет основной стрелой</td><td>1,9–26,0 м</td><td>по паспорту исполнения</td></tr>
          <tr><td>Опорный контур</td><td>5,43 × 6,00 м</td><td>4,9 × 6,1 м</td></tr>
          <tr><td>Масса крана</td><td>21,63 т (с гуськом)</td><td>20,2 т</td></tr>
          <tr><td>Шасси</td><td>КАМАЗ-65115, 6×4</td><td>КАМАЗ-65115, 6×4</td></tr>
          <tr><td>Смена в МОСКРАН-СЕРВИС</td><td>20 800 ₽</td><td>20 800 ₽</td></tr>
        </tbody>
      </table>
    </div>

    <h2 id="vysota" style="margin:36px 0 16px">Высота подъёма</h2>
    <p>Основная стрела «Ивановца» КС-45717К-1Р длиннее на 9,7 м, и крюк поднимается на 30,6 м вместо 21,6 м у КС-55713-1К «Клинцы» — разница ровно 9 м. Чтобы прикинуть парапет, вычтите из высоты крюка 0,5 м запаса по п. 114 ФНП №461, высоту груза и длину строп: для поддона 1,2 м на стропах 2 м «Клинцы» без гуська достанут до парапета около 17,9 м, «Ивановец» — около 26,9 м.</p>
    <p>Расчёт даёт верхнюю оценку, потому что на предельной длине стрелы допустимая масса груза заметно ниже номинала. МОСКРАН-СЕРВИС поэтому смотрит строку грузовысотной характеристики для нужных высоты и вылета; методика показана в <a href="/spravochnik/podyom-gruza-na-kryshu-avtokranom/" style="color:var(--yellow)">материале о подъёме груза на крышу</a> и в <a href="/spravochnik/gruzovysotnaya-harakteristika/" style="color:var(--yellow)">материале о грузовысотной характеристике</a>.</p>

    <h2 id="opory" style="margin:36px 0 16px">Опоры и двор</h2>
    <p>«Клинцы» КС-55713-1К разворачивают опоры на 4,9 × 6,1 м, «Ивановец» КС-45717К-1Р — на 5,43 × 6,00 м, то есть на 0,53 м шире поперёк. В московском дворе между бордюром и стеной дома эти полметра иногда решают, помещается ли кран на асфальт, а не на газон. МОСКРАН-СЕРВИС проверяет это по схеме проезда, прежде чем назначить машину.</p>
    <p>ФНП №461 (п. 108–110) требует ставить стреловой кран на все выносные опоры на подготовленной площадке и не ближе 1 м к строению поворотной частью. На газон опоры ставить нельзя: в Москве это штраф по ст. 8.25 КоАП города. Правила разобраны в <a href="/spravochnik/avtokran-na-gazone-v-moskve/" style="color:var(--yellow)">материале об автокране на газоне</a>; про давление под опорой — в <a href="/spravochnik/nesushchaya-sposobnost-grunta/" style="color:var(--yellow)">материале о несущей способности грунта</a>.</p>

    <h2 id="shassi" style="margin:36px 0 16px">Шасси и масса</h2>
    <p>Оба крана в этих исполнениях стоят на КАМАЗ-65115 с формулой 6×4, а «Ивановец» КС-45717К-1Р ещё и на двигателе КАМАЗ 667.511-300 со скоростью до 60 км/ч. Масса «Ивановца» с гуськом — 21,63 т, «Клинцов» — 20,2 т по карточке дилера; карточки составлены по-разному, и МОСКРАН-СЕРВИС не делает вывод о разнице 1,4 т без паспорта. Для въезда на слабый грунт значение имеет реальная масса конкретной машины.</p>
    <p>Полноприводный «Ивановец» КС-45717-1Р на шасси Урал-4320 с формулой 6×6 — другое исполнение, которое подходит для грунтового подъезда к коттеджу. МОСКРАН-СЕРВИС уточняет у заказчика, по какому покрытию машина подъедет к площадке; карточка модели в парке — <a href="/park/ivanovets-ks-45717/" style="color:var(--yellow)">«Ивановец» КС-45717</a>, и <a href="/park/klintsy-ks-55713/" style="color:var(--yellow)">«Клинцы» КС-55713</a>.</p>

    <h2 id="vybor" style="margin:36px 0 16px">Как выбрать</h2>
    <p>«Ивановец» КС-45717К-1Р выбирают, когда крюк нужен выше 22 м, вылет до 26 м или нужен гусёк 9 м для высоты до 39,3 м. «Клинцы» КС-55713-1К выбирают для разгрузки у склада, монтажа на один-два этажа и тесных дворов, где опорный контур 4,9 м вписывается, а 5,43 м — нет. Смена одинаковая — 20 800 ₽, и МОСКРАН-СЕРВИС назначает модель по схеме объекта.</p>
    <p>Если не хватает и «Ивановца», следующий шаг — другой класс: 50-тонный кран за 31 200 ₽ в смену. Сравнение с ещё одной парой 25-тонников — в материале <a href="/spravochnik/chelyabinets-ili-klintsy-25-tonn/" style="color:var(--yellow)">«Челябинец или Клинцы»</a>, а сравнение «Клинцов» с XCMG — в <a href="/spravochnik/klintsy-ili-xcmg-25-tonn/" style="color:var(--yellow)">материале о «Клинцах» и XCMG</a>.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: Ивановец или Клинцы</h2>
    <ul>
      <li>Грузовой момент у обоих — 85 т·м, разница только в геометрии.</li>
      <li>«Ивановец» КС-45717К-1Р: стрела 30,7 м, крюк 30,6 / 39,3 м, опоры 5,43 × 6,00 м.</li>
      <li>«Клинцы» КС-55713-1К: стрела 21 м, крюк 21,6 / 29,3 м, опоры 4,9 × 6,1 м.</li>
      <li>Смена в МОСКРАН-СЕРВИС одинаковая — 20 800 ₽; допустимую массу на вылете задаёт паспорт.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://avtokran.ru/catalog/avtomobilnye-krany/avtokran-ivanovets-ks-45717k-1r/" target="_blank" rel="noopener" style="color:var(--yellow)">«Ивановец» КС-45717К-1Р на шасси КАМАЗ-65115 — Ивановский машиностроительный завод «Автокран»</a> — 85 т·м, стрела 9,9–30,7 м, гусёк 9,0 м, высота 30,6 / 39,3 м, вылет 1,9–26,0 м, опоры 5,43 × 6,00 м, 21,63 т.</li>
      <li><a href="https://www.avtocrane.by/katalog-produkcii/avtokrany-klincy/25-tonn/ks-55713-1k-klincy" target="_blank" rel="noopener" style="color:var(--yellow)">КС-55713-1К «Клинцы» — карточка официального дилера</a> — 85 т·м, стрела 21 м, крюк 21,6 / 29,3 м, опоры 4,9 × 6,1 м, 20,2 т.</li>
      <li><a href="https://avtokran.ru/catalog/avtomobilnye-krany/avtokran-ivanovets-ks-45717-1r/" target="_blank" rel="noopener" style="color:var(--yellow)">«Ивановец» КС-45717-1Р на шасси Урал-4320 — завод «Автокран»</a> — исполнение 6×6.</li>
      <li><a href="https://sudact.ru/law/prikaz-rostekhnadzora-ot-26112020-n-461-ob/federalnye-normy-i-pravila-v/vi/ustanovka-ps-i-proizvodstvo-rabot/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461, раздел VI «Установка ПС и производство работ» (ред. от 16.04.2026)</a> — п. 108–110, 114.</li>
    </ul>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-16-25-tonn/">Аренда автокрана 16–25 тонн →</a></section>
</main>
</SpravochnikLayout>
