const title = 'Грязные колёса автокрана на выезде: что требует норма и чем грозит в Москве';
const description = 'СП 48.13330.2019 обязывает оборудовать выезд стройплощадки пунктом очистки колёс. Разбираем, кто за это отвечает и какой штраф грозит по Кодексу города Москвы.';

const CHECKED = '05.09.2026';

const faqs = [
  { q: 'Кто обязан ставить пункт очистки колёс — заказчик крана или мы?', a: 'По пункту 7.13 СП 48.13330.2019 «Организация строительства» это обязанность лица, осуществляющего строительство, то есть застройщика или генподрядчика площадки, а не владельца привлечённой техники. Автокран — временный участник объекта: он заезжает по вызову и подчиняется тому пропускному режиму, который уже действует на площадке.' },
  { q: 'Если на площадке нет пункта мойки, кран всё равно может попасть под штраф?', a: 'Формально ответственность по статье 8.8 Кодекса города Москвы об административных правонарушениях наступает за сам факт загрязнения территории транспортным средством, а не за отсутствие оборудования у чужой площадки — то есть в зоне риска в первую очередь автомобиль, который оставил грязь на проезжей части, кем бы он ни был привлечён. Поэтому при отсутствии пункта очистки мы стараемся минимизировать выезд по грязи своими силами — например, выбором маршрута выезда по наиболее сухому участку площадки.' },
  { q: 'Это тот же штраф, что и за нарушение тишины на площадке зимой?', a: 'Нет, это другая статья того же Кодекса города Москвы об административных правонарушениях. За ночной шум предусмотрена статья 3.13, о которой мы писали в статье про зимнюю смену, а за загрязнение территории транспортным средством — отдельная статья 8.8, с собственными, более низкими суммами для граждан и другой логикой состава правонарушения.' },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Мойка колёс на выезде со стройплощадки', item: 'https://moskran-servis.ru/spravochnik/moika-koles-so-stroyploshadki/' },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@id': 'https://moskran-servis.ru/#organization' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: 'https://moskran-servis.ru/spravochnik/moika-koles-so-stroyploshadki/',
  inLanguage: 'ru-RU',
  datePublished: '2026-09-05',
  dateModified: '2026-09-05',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<SpravochnikLayout title={title} description={description} path="/spravochnik/moika-koles-so-stroyploshadki/" slug="moika-koles-so-stroyploshadki" ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Мойка колёс на выезде</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Разбор для заказчика</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Грязные колёса автокрана на выезде: что требует норма и чем грозит в Москве</h1>
    <p class="ref-byline">Инженерная служба МОСКРАН-СЕРВИС · обновлено 05.09.2026</p>

    <p>Автокран большую часть смены проводит не на асфальте, а на грунте или щебёночной подсыпке рядом с котлованом или фундаментом — там, где стоит сама площадка. Когда смена заканчивается и машина выезжает обратно на городскую улицу, следом за ней часто едет часть этого грунта — на протекторе задних колёс. Разбираем, кто по норме обязан с этим справляться и что грозит, если этого не сделать в границах Москвы.</p>

    <h2 style="margin:36px 0 16px">Требование СП 48.13330.2019</h2>
    <p>Пункт 7.13 свода правил СП 48.13330.2019 «Организация строительства», утверждённого Минстроем России, прямо обязывает: лицо, осуществляющее строительство, должно оборудовать строительную площадку, выходящую на городскую территорию, пунктами очистки или мойки колёс транспортных средств на выездах, а также устройствами или бункерами для сбора мусора. Формулировка адресована не отдельным машинам, а самой площадке как объекту организации строительства — то есть это элемент стройгенплана, который готовится заранее, до начала работ, а не решение, принимаемое по факту, когда первая машина уже испачкала асфальт за воротами.</p>

    <h2 style="margin:36px 0 16px">Кто отвечает — застройщик площадки, а не владелец крана</h2>
    <p>Ключевое здесь то, что обязанность прямо адресована лицу, осуществляющему строительство, — застройщику или генеральному подрядчику объекта, который отвечает за организацию площадки в целом. Автокран на этой площадке — временный, привлечённый по заявке участник: он заезжает под конкретную операцию и подчиняется уже действующему на объекте пропускному режиму, включая расположение и работу пункта очистки колёс, если он предусмотрен. Мы не обустраиваем моечные посты на чужих площадках — это не наша зона ответственности по норме, — но нам важно понимать, что этот пункт вообще есть и работает, потому что от этого зависит, во сколько машина реально сможет выехать в сухом виде, а не будет стоять в очереди перед единственным работающим постом.</p>

    <h2 style="margin:36px 0 16px">Ответственность в Москве — статья 8.8 Кодекса города Москвы об АП</h2>
    <p>Загрязнение территории города, связанное с эксплуатацией транспортных средств, — отдельный состав административного правонарушения по Закону города Москвы от 21.11.2007 №45 «Кодекс города Москвы об административных правонарушениях». Статья 8.8 этого кодекса устанавливает ответственность за загрязнение территории, связанное с эксплуатацией и ремонтом транспортных средств, включая мойку машин вне специально отведённых мест. Штраф составляет: для граждан — от 1 000 до 3 000 рублей, для должностных лиц — от 5 000 до 10 000 рублей, для юридических лиц — от 10 000 до 20 000 рублей. Формально состав правонарушения привязан к самому факту загрязнения территории конкретным транспортным средством, а не к тому, есть ли на площадке, с которой оно выехало, оборудованный пункт очистки, — поэтому в зоне риска в первую очередь тот, кто оставил след на проезжей части, вне зависимости от того, чья это площадка.</p>

    <h2 style="margin:36px 0 16px">Как мы это учитываем на практике</h2>
    <p>При приёме заявки мы уточняем у заказчика, оборудован ли выезд площадки пунктом очистки или мойки колёс, — особенно если работы идут на грунтовом основании или сразу после земляных работ, когда грунт наиболее подвижен. Если пункт не предусмотрен или временно не работает, экипаж по возможности выбирает маршрут выезда по наиболее сухому участку площадки и снижает скорость на подъезде к воротам, чтобы уменьшить объём переносимого грунта, — это не заменяет обязанности застройщика, но снижает практический риск для конкретного рейса.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: что запомнить</h2>
    <ul>
      <li>Пункт 7.13 СП 48.13330.2019 обязывает застройщика или генподрядчика оборудовать выезд площадки, выходящий на городскую территорию, пунктом очистки или мойки колёс.</li>
      <li>Это обязанность лица, осуществляющего строительство, а не владельца привлечённого автокрана — техника подчиняется уже действующему на объекте пропускному режиму.</li>
      <li>В Москве загрязнение территории транспортным средством — отдельный состав по статье 8.8 Кодекса города Москвы от 21.11.2007 №45: штраф для граждан 1 000–3 000 руб., для должностных лиц 5 000–10 000 руб., для юрлиц 10 000–20 000 руб.</li>
      <li>Ответственность привязана к факту загрязнения конкретным транспортным средством, а не к тому, была ли площадка оборудована пунктом очистки.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <Sources
      checked={CHECKED}
      items={[
        { text: 'СП 48.13330.2019 «Организация строительства» (СНиП 12-01-2004), пункт 7.13', href: 'https://tk-expert.ru/lib/721/' },
        { text: 'Закон г. Москвы от 21.11.2007 №45 «Кодекс города Москвы об административных правонарушениях», статья 8.8', href: 'https://base.garant.ru/388521/150f03b869850cca4c5c233ccce3ab78/' },
      ]}
      note="Размер штрафов по статье 8.8 приведён по действующей редакции Кодекса города Москвы на дату проверки; при последующих изменениях кодекса суммы стоит сверять отдельно."
    />
  </article>
  <section class="section wrap"><a class="btn" href="/spravochnik/rabota-krana-zimoy/">Работа крана зимой: гололёд и короткий световой день →</a></section>
</main>
</SpravochnikLayout>
