---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = 'Чем охранная зона ЛЭП отличается от 30 метров по ФНП №461?';
const description = 'Наряд-допуск по ФНП №461 — ближе 30 м от провода. Охранная зона по ПП №160 для линии 10 кВ в Москве — всего 5 м, для 220 кВ — уже 25 м.';

const CHECKED = '03.10.2026';
const PUBLISHED = '2026-10-03';
const SLUG = 'ohrannaya-zona-lep-i-30-metrov-fnp-461';
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: 'В чём разница между 30 метрами по ФНП №461 и охранной зоной ЛЭП?',
    a: '30 метров из п. 112 ФНП №461 — это порог, при котором работа крана ближе к проводу требует наряда-допуска от эксплуатирующей организации, безопасный режим для самого крана. Охранная зона из постановления Правительства РФ №160 — другое по природе требование: ширина земельного участка вокруг линии, где ряд действий, включая строительство, запрещён без письменного согласия сетевой организации — владельца линии, а не работодателя крановщика.',
  },
  {
    q: 'Какая охранная зона у линии 10 кВ в Москве?',
    a: 'Для линий 1–20 кВ правило даёт 10 м вне населённых пунктов и 5 м в их границах. Москва — населённый пункт целиком, поэтому для типовой городской распределительной линии 6–10 кВ охранная зона — 5 м от крайнего провода, в шесть раз меньше, чем 30-метровый порог наряда-допуска по ФНП №461.',
  },
  {
    q: 'Нужно ли согласование сетевой организации, если кран просто проезжает под проводами?',
    a: 'Да, если высота крана с грузом или без груза от поверхности дороги больше 4,5 м — подп. «е» п. 10 правил прямо запрещает такой проезд в охранной зоне воздушной линии без письменного решения о согласовании. Для автокрана в транспортном положении со сложенной стрелой это редкий случай, но его нужно проверять отдельно от наряда-допуска на сами подъёмные работы.',
  },
  {
    q: 'Сколько сетевая организация рассматривает заявление на согласование работ в охранной зоне?',
    a: 'По п. 12 правил сетевая организация обязана рассмотреть заявление и принять решение о согласовании или об отказе в течение 2 дней с даты поступления. Отказ должен быть обоснован со ссылкой на норму; МОСКРАН-СЕРВИС подаёт такие заявления заранее, а не рассчитывает на согласование в день выезда.',
  },
  {
    q: 'Распространяется ли охранная зона на подземный кабель?',
    a: 'Да, но по другим цифрам: для подземных кабельных линий охранная зона — 1 м с каждой стороны от крайних кабелей, а для кабеля напряжением до 1 кВ в границах населённых пунктов — 0,6 м до зданий. Это отдельная категория от воздушных линий; для работы рядом с подземными кабелями на площадке проверяют прежде всего схему сетей, а не только расстояние по прямой.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Охранная зона ЛЭП и 30 метров ФНП №461', item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ['razlichie', 'Два разных требования, а не одно'],
  ['tablica', 'Размеры охранной зоны по напряжению'],
  ['gorod', 'Почему в Москве зона у городских линий меньше'],
  ['soglasovanie', 'Когда нужно письменное согласование'],
  ['primer', 'Пример: линия 10 кВ и линия 220 кВ'],
  ['faq', 'Частые вопросы'],
  ['istochniki', 'Источники'],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Охранная зона ЛЭП и 30 метров ФНП №461</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Сети и ЛЭП · ФНП №461 и ПП №160</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Чем охранная зона ЛЭП отличается от 30 метров по ФНП №461?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>03.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>03.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>6 мин чтения</span>
    </div>

    <p>Наряд-допуск по п. 112 ФНП №461 нужен автокрану ближе 30 м от крайнего провода любой линии напряжением выше 50 В — порог одинаковый для всех линий. Охранная зона по постановлению Правительства РФ №160 — другое требование с другой шириной: для линии 1–20 кВ в границах Москвы это всего 5 м, а для линии 330 кВ и выше — уже 30–55 м, то есть шире 30-метрового порога наряда-допуска. МОСКРАН-СЕРВИС проверяет оба требования отдельно, а не считает, что одно заменяет другое.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="razlichie" style="margin:36px 0 16px">Два разных требования, а не одно</h2>
    <p>ФНП №461 — норма промышленной безопасности для самого подъёмного сооружения: п. 112 требует наряд-допуск, если кран устанавливается или работает ближе 30 м от крайнего провода воздушной линии электропередачи или воздушной электрической сети напряжением более 50 В. Наряд-допуск выдаёт эксплуатирующая организация крана МОСКРАН-СЕРВИС, условия согласуются с владельцем линии, а порог 30 м одинаков независимо от класса напряжения.</p>
    <p>Охранная зона из правил, утверждённых постановлением Правительства РФ от 24.02.2009 №160, — требование земельного и электросетевого законодательства. Это полоса вдоль линии, где ряд действий юридических и физических лиц запрещён без письменного решения о согласовании сетевой организации — собственника линии, а не работодателя крановщика. МОСКРАН-СЕРВИС учитывает, что ширина этой полосы зависит от класса напряжения и может быть и меньше, и больше 30-метрового порога ФНП №461 — две нормы не совпадают по смыслу и по цифрам, и выполнение одной не освобождает от другой.</p>

    <h2 id="tablica" style="margin:36px 0 16px">Размеры охранной зоны по напряжению</h2>
    <p>Приложение к правилам, утверждённым постановлением №160, задаёт ширину охранной зоны воздушной линии от крайних проводов отдельно для каждого класса напряжения. МОСКРАН-СЕРВИС сверяет расстояние по этой таблице, а не по общему правилу 30 м из ФНП №461.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Напряжение линии</th><th>Охранная зона</th></tr></thead>
        <tbody>
          <tr><td>до 1 кВ</td><td>2 м</td></tr>
          <tr><td>1–20 кВ</td><td>10 м (5 м в границах населённых пунктов)</td></tr>
          <tr><td>35 кВ</td><td>15 м</td></tr>
          <tr><td>110 кВ</td><td>20 м</td></tr>
          <tr><td>150–220 кВ</td><td>25 м</td></tr>
          <tr><td>300–500 кВ</td><td>30 м</td></tr>
          <tr><td>750 кВ</td><td>40 м</td></tr>
          <tr><td>1150 кВ</td><td>55 м</td></tr>
        </tbody>
      </table>
    </div>
    <p>Для подземных кабельных линий правило устроено иначе: охранная зона — 1 м по обе стороны от крайних кабелей, а для кабеля до 1 кВ в границах населённых пунктов — 0,6 м до зданий. В плотной застройке Москвы кабельные линии встречаются не реже воздушных, и перед земляными работами или установкой опор крана МОСКРАН-СЕРВИС запрашивает схему сетей, а не ограничивается расчётом расстояния по прямой от видимых проводов.</p>

    <h2 id="gorod" style="margin:36px 0 16px">Почему в Москве зона у городских линий меньше</h2>
    <p>Большинство распределительных линий внутри застроенной части Москвы — класса 6–10 кВ, и правило №160 для диапазона 1–20 кВ прямо уменьшает охранную зону с 10 до 5 м именно в границах населённых пунктов. Москва целиком подпадает под этот случай, поэтому для типовой городской линии такого класса охранная зона — 5 м, в шесть раз меньше 30-метрового порога наряда-допуска по ФНП №461.</p>
    <p>МОСКРАН-СЕРВИС делает из этого практический вывод: для большинства городских работ рядом с линией 6–10 кВ наряд-допуск по ФНП №461 остаётся обязательным на всём участке от 0 до 30 м, а письменное согласование сетевой организации по правилам №160 требуется только если кран или техника заходят именно в пятиметровую полосу вдоль провода — то есть не на весь 30-метровый периметр, а на заметно более узкую его часть.</p>

    <h2 id="soglasovanie" style="margin:36px 0 16px">Когда нужно письменное согласование</h2>
    <p>Пункт 10 правил №160 перечисляет действия, запрещённые в охранной зоне без письменного решения о согласовании сетевой организации. Для автокрана на стройплощадке актуальны два пункта: подпункт «а» — строительство, капитальный ремонт, реконструкция или снос зданий и сооружений, и подпункт «е» — проезд машин и механизмов общей высотой с грузом или без груза от поверхности дороги более 4,5 м в охранной зоне воздушной линии. Монтажные работы самим краном в границах зоны МОСКРАН-СЕРВИС относит к первому случаю, а проезд техники со сложенной стрелой выше 4,5 м — ко второму.</p>
    <p>По п. 12 правил сетевая организация обязана рассмотреть заявление и вынести решение о согласовании или обоснованном отказе в течение 2 дней с даты поступления. Этот срок короче типичного согласования допуска на объект с пропускным режимом, но МОСКРАН-СЕРВИС всё равно подаёт заявление заранее — задержка на 2 дня перед самим выездом технику не выручает.</p>

    <h2 id="primer" style="margin:36px 0 16px">Пример: линия 10 кВ и линия 220 кВ</h2>
    <p>Кран МОСКРАН-СЕРВИС работает на вылете 15 м от городской линии 10 кВ. Это ближе 30-метрового порога ФНП №461 — нужен наряд-допуск. При этом 15 м — втрое больше пятиметровой охранной зоны этой линии, значит письменное согласование сетевой организации по правилам №160 в этой точке не требуется: кран не входит в полосу, где действует запрет из п. 10.</p>
    <p>Тот же вылет 15 м у линии 220 кВ даёт другую картину: охранная зона такой линии — 25 м, то есть точка работы крана внутри зоны. Здесь одновременно нужны оба документа — наряд-допуск от эксплуатирующей организации крана по ФНП №461 и письменное решение о согласовании от сетевой организации, владеющей линией, по правилам №160. Класс напряжения линии МОСКРАН-СЕРВИС уточняет на этапе приёма заявки именно для того, чтобы не упустить второе требование там, где оно реально применимо.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: охранная зона ЛЭП и 30 метров ФНП №461</h2>
    <ul>
      <li>30 м по п. 112 ФНП №461 — порог наряда-допуска, одинаковый для всех линий выше 50 В.</li>
      <li>Охранная зона по ПП №160 — отдельное требование, ширина 2–55 м зависит от класса напряжения.</li>
      <li>Линия 1–20 кВ в Москве — зона 5 м (не 10 м, как вне населённых пунктов).</li>
      <li>Линии 330 кВ и выше — зона 30–55 м, шире порога наряда-допуска.</li>
      <li>Строительные работы и проезд техники выше 4,5 м в зоне — только с письменным согласованием сетевой организации (2 дня на рассмотрение по п. 12).</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://files.stroyinf.ru/Data2/1/4293831/4293831050.htm" target="_blank" rel="noopener" style="color:var(--yellow)">Правила установления охранных зон объектов электросетевого хозяйства (ПП РФ от 24.02.2009 №160)</a> — приложение с размерами зон по напряжению, п. 10 (запреты без согласования), п. 12 (срок рассмотрения 2 дня).</li>
      <li><a href="https://meganorm.ru/Data2/1/4293831/4293831050.htm" target="_blank" rel="noopener" style="color:var(--yellow)">Правила установления охранных зон (ПП №160) — текст подпунктов п. 10</a> — подп. «а» строительство/реконструкция, подп. «е» проезд техники выше 4,5 м.</li>
      <li><a href="https://sudact.ru/law/prikaz-rostekhnadzora-ot-26112020-n-461-ob/federalnye-normy-i-pravila-v/vi/ustanovka-ps-i-proizvodstvo-rabot/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461, раздел VI «Установка ПС и производство работ» (ред. от 16.04.2026)</a> — п. 112: 30 м и наряд-допуск.</li>
    </ul>
  </article>
  <section class="section wrap"><a class="btn" href="/spravochnik/rabota-krana-ryadom-s-lep/">Наряд-допуск у ЛЭП: подробный разбор →</a></section>
</main>
</SpravochnikLayout>
