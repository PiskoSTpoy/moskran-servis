---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = 'ППР или технологическая карта для автокрана';
const description = 'Когда для работы автокрана нужен ППР, а когда хватит технологической карты: п. 98, 99, 155–159 ФНП №461. Кто утверждает и что заказать.';

const CHECKED = '15.10.2026';
const PUBLISHED = '2026-10-15';
const SLUG = 'ppr-ili-tehnologicheskaya-karta-avtokran-fnp-461';
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: 'Когда для автокрана обязателен именно ППР?',
    a: 'Когда работы идут над действующими коммуникациями, над проезжей частью улиц или в стеснённых условиях, где нужно ограничивать зону перемещения крана и грузов (п. 98 ФНП №461). Технологической карты в этих случаях недостаточно. МОСКРАН-СЕРВИС определяет случай по схеме площадки.',
  },
  {
    q: 'Когда достаточно технологической карты?',
    a: 'Для погрузочно-разгрузочных работ и складирования на базах, складах и открытых площадках, если нет условий п. 98 (п. 99 ФНП №461). Для монтажа, демонтажа и ремонта оборудования допускается ППР и (или) ТК. МОСКРАН-СЕРВИС уточняет вид работ в заявке.',
  },
  {
    q: 'Кто утверждает ППР и ТК?',
    a: 'Организация, эксплуатирующая подъёмное сооружение (п. 98 и п. 157 ФНП №461). Разработать ППР может она же или специализированная организация. МОСКРАН-СЕРВИС как владелец автокрана утверждает ТК на свои погрузочно-разгрузочные работы.',
  },
  {
    q: 'Можно ли работать с отступлением от ППР?',
    a: 'Нет: эксплуатация подъёмного сооружения с отступлениями от ППР и ТК не допускается, а изменения вносит только разработчик документа (п. 98 ФНП №461). Если площадка отличается от схемы, МОСКРАН-СЕРВИС останавливает работы до корректировки.',
  },
  {
    q: 'Что должно быть в ППР с краном в первую очередь?',
    a: 'Соответствие крана работам по грузоподъёмности, высоте и вылету, безопасные расстояния до сетей и ЛЭП, схемы строповки, места складирования и опасные зоны (п. 156 «а»–«ж» ФНП №461). МОСКРАН-СЕРВИС сверяет модель крана в ППР с машиной, которую отправляет.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'ППР или технологическая карта для автокрана по ФНП №461', item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ['sravnenie', 'ППР и ТК: сравнение по ФНП'],
  ['ppr', 'Когда без ППР нельзя'],
  ['tk', 'Когда хватит технологической карты'],
  ['utverzhdenie', 'Кто разрабатывает, утверждает и меняет'],
  ['zakazchik', 'Что заказать до выезда автокрана'],
  ['faq', 'Частые вопросы'],
  ['istochniki', 'Источники'],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>ППР или технологическая карта для автокрана по ФНП №461</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">ФНП №461 · ППР и ТК</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">ППР или технологическая карта: что нужно для работы автокрана?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>15.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>15.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>6 мин чтения</span>
    </div>

    <p>Пункт 98 ФНП №461 требует ППР для работ крана над коммуникациями, проезжей частью и в стеснённых условиях, а п. 99 разрешает вести обычную разгрузку на складах и площадках по технологической карте. Оба документа утверждает организация, эксплуатирующая кран. МОСКРАН-СЕРВИС определяет нужный документ по схеме площадки при приёме заявки.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="sravnenie" style="margin:36px 0 16px">ППР и ТК: сравнение по ФНП</h2>
    <p>Различие между ППР и технологической картой в ФНП №461 задаётся видом работ и условиями площадки, а не массой груза или тоннажем крана. Один и тот же автокран КС-55713 «Клинцы» может работать по ТК на складе и по ППР у дороги. МОСКРАН-СЕРВИС сводит различия в таблицу для заказчика.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Параметр</th><th>ППР</th><th>Технологическая карта (ТК)</th></tr></thead>
        <tbody>
          <tr><td>Когда обязателен</td><td>над коммуникациями, проезжей частью, в стеснённых условиях (п. 98)</td><td>погрузка, разгрузка, складирование на базах, складах, площадках (п. 99)</td></tr>
          <tr><td>Монтаж и ремонт оборудования</td><td>ППР и (или) ТК (п. 98)</td><td>ППР и (или) ТК (п. 98)</td></tr>
          <tr><td>Требования к содержанию</td><td>п. 156 «а»–«ж», раздел по п. 159</td><td>п. 155–163, раздел по п. 159</td></tr>
          <tr><td>Кто утверждает</td><td>эксплуатирующая кран организация (п. 98)</td><td>эксплуатирующая кран организация (п. 157)</td></tr>
          <tr><td>Ознакомление</td><td>под подпись до начала работ (п. 158)</td><td>под подпись до начала работ (п. 158)</td></tr>
        </tbody>
      </table>
    </div>

    <h2 id="ppr" style="margin:36px 0 16px">Когда без ППР нельзя</h2>
    <p>ППР обязателен по п. 98 ФНП №461 в трёх ситуациях: работы над действующими коммуникациями, над проезжей частью улиц и в стеснённых условиях, где требуется ограничение зоны перемещения крана и грузов. Разработать такой ППР может эксплуатирующая или специализированная организация. МОСКРАН-СЕРВИС в Москве чаще всего встречает третий случай — двор жилого дома.</p>
    <p>По п. 156 ФНП №461 ППР с краном содержит соответствие крана работам по грузоподъёмности, высоте и вылету, безопасные расстояния до сетей и ЛЭП, условия у откосов котлованов, схемы строповки, места складирования и опасные зоны. Размеры опасных зон берут из приложения №2. МОСКРАН-СЕРВИС проверяет, что грузовая характеристика в ППР совпадает с машиной, а не с «автокраном 25 т вообще». Общие требования к ППР собраны в справке о <a href="/spravochnik/ppr-dlya-krana/" style="color:var(--yellow)">ППР для крана</a>.</p>
    <p>Работа в стеснённых условиях связана ещё и с координатной защитой: п. 133 ФНП №461 не допускает там кран на автошасси без неё, а п. 159 «б» требует описать её применение в ППР. МОСКРАН-СЕРВИС подбирает машину с учётом этого требования; подробности — в справке о <a href="/spravochnik/koordinatnaya-zashchita-avtokrana-fnp-461/" style="color:var(--yellow)">координатной защите автокрана</a>.</p>

    <h2 id="tk" style="margin:36px 0 16px">Когда хватит технологической карты</h2>
    <p>Погрузочно-разгрузочные работы и складирование на базах, складах и открытых площадках п. 99 ФНП №461 разрешает вести по ТК, если нет условий п. 98. Типичный пример — разгрузка фуры с металлопрокатом на складской площадке за городом. МОСКРАН-СЕРВИС для таких заявок использует утверждённые ТК на типовые грузы.</p>
    <p>Требования к содержанию ТК те же пункты 155–163, что и для ППР, включая раздел об организации безопасного производства работ по п. 159: ветер из паспорта крана, радиосвязь, работу с тарой, опасную зону у проходов. ТК короче ППР, но не пустая бумага. МОСКРАН-СЕРВИС включает в ТК схемы строповки конкретных грузов — пакетов труб, плит, поддонов.</p>
    <p>Для монтажа, демонтажа и ремонта оборудования п. 98 допускает ППР и (или) ТК, но требует в них схемы строповки, способы кантовки и места стропальщиков и сигнальщиков. МОСКРАН-СЕРВИС при монтаже оборудования краном КС-65713-1 «Галичанин» запрашивает документ с этими тремя разделами. Место сигнальщика разобрано в справке о <a href="/spravochnik/signalshchik-pri-rabote-avtokrana-fnp-461/" style="color:var(--yellow)">сигнальщике при работе автокрана</a>.</p>

    <h2 id="utverzhdenie" style="margin:36px 0 16px">Кто разрабатывает, утверждает и меняет</h2>
    <p>Утверждает ППР и ТК организация, эксплуатирующая подъёмное сооружение (п. 98 ФНП №461), а ТК на погрузочно-разгрузочные работы выдаётся на участок до начала работ (п. 157). Изменения в документ вносит только его разработчик. МОСКРАН-СЕРВИС не правит чужой ППР на площадке, а возвращает его разработчику.</p>
    <p>Работа с отступлениями от ППР и ТК п. 98 ФНП №461 запрещает прямо. На практике это значит: если машина приехала, а место установки опор занято или над ним провода, кран не ставят «чуть левее». МОСКРАН-СЕРВИС в таком случае фиксирует расхождение и ждёт корректировки; оплата ожидания описана в справке о <a href="/spravochnik/prostoy-tehniki-oplata/" style="color:var(--yellow)">простое техники</a>.</p>

    <h2 id="zakazchik" style="margin:36px 0 16px">Что заказать до выезда автокрана</h2>
    <p>Заказчику проще всего определить нужный документ по трём вопросам о площадке, а не по тексту ФНП №461. МОСКРАН-СЕРВИС задаёт их при приёме заявки и по ответам говорит, нужен ли ППР. Вопросы — практика службы, составленная по п. 98 и п. 99.</p>
    <ul>
      <li>МОСКРАН-СЕРВИС спрашивает, проходит ли груз над дорогой, тротуаром или подземными сетями.</li>
      <li>МОСКРАН-СЕРВИС уточняет, нужно ли ограничивать поворот стрелы из-за зданий или проводов.</li>
      <li>МОСКРАН-СЕРВИС выясняет вид работ: разгрузка и складирование или монтаж оборудования.</li>
    </ul>
    <p>Если на все вопросы ответ «нет» и это разгрузка на площадке, достаточно ТК. Прочие сведения для подбора машины собраны в материале о <a href="/spravochnik/zayavka-na-avtokran/" style="color:var(--yellow)">заявке на автокран</a>. МОСКРАН-СЕРВИС присылает ТК заказчику до выезда.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: ППР или ТК для автокрана</h2>
    <ul>
      <li>МОСКРАН-СЕРВИС требует ППР над сетями, дорогой и в стеснённых условиях (п. 98 ФНП №461).</li>
      <li>Разгрузку на складах и площадках МОСКРАН-СЕРВИС ведёт по технологической карте (п. 99).</li>
      <li>ППР и ТК в МОСКРАН-СЕРВИС утверждает эксплуатирующая кран организация, изменения — разработчик.</li>
      <li>МОСКРАН-СЕРВИС не работает с отступлениями от ППР и ТК: это прямо запрещено п. 98.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://www.consultant.ru/document/cons_doc_LAW_373321/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 (приказ Ростехнадзора от 26.11.2020 №461)</a> — п. 98 (когда ППР, кто утверждает, запрет отступлений), п. 99 (ТК на ПРР), п. 133, п. 155–159.</li>
      <li><a href="https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 на legalacts.ru</a> — редакция от 16.04.2026, текст пунктов 98–99, 155–159 сверен 15.10.2026.</li>
    </ul>
    <p class="small muted">Три вопроса для выбора документа и примеры площадок — практика МОСКРАН-СЕРВИС, а не пункты нормы. Стоимость разработки ППР в справке не приводится: она зависит от объекта.</p>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-16-25-tonn/">Аренда автокрана 16–25 тонн →</a></section>
</main>
</SpravochnikLayout>
