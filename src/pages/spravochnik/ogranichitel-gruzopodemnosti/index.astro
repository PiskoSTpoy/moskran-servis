---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';
import Sources from '../../../components/Sources.astro';

const title = 'Как работает ограничитель грузоподъёмности крана';
const description = 'ОГП автоматически отключает подъём при превышении грузоподъёмности на 10% для стреловых и башенных кранов. Обязателен по ГОСТ 33712-2015.';

const CHECKED = '12.08.2026';

const faqs = [
  { q: 'ОГП полностью исключает риск перегрузки крана?', a: 'ОГП — важный, но не единственный барьер безопасности. Он срабатывает при превышении паспортной грузоподъёмности на определённый процент, но не заменяет правильный расчёт веса груза и вылета заранее (см. статью про грузовысотную характеристику) — это последний технический рубеж, а не основной метод предотвращения перегрузки.' },
  { q: 'На всех ли кранах обязателен ОГП?', a: 'Установка ОГП обязательна на стреловых, башенных и портальных кранах — то есть на всех типах техники, представленных в нашем парке.' },
  { q: 'Что если ОГП сработал во время подъёма?', a: 'Автоматическое отключение механизма подъёма — сигнал, что вес груза на данном вылете превышает допустимый предел. Это повод пересчитать задачу (проверить фактический вес, рассмотреть более тяжёлый класс техники), а не пытаться обойти срабатывание прибора.' },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Ограничитель грузоподъёмности', item: 'https://moskran-servis.ru/spravochnik/ogranichitel-gruzopodemnosti/' },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@id': 'https://moskran-servis.ru/#organization' }, // ссылка на единственный узел организации (BaseLayout): отдельный узел с тем же @id, но другим name, был противоречием в графе
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: 'https://moskran-servis.ru/spravochnik/ogranichitel-gruzopodemnosti/',
  inLanguage: 'ru-RU',
  datePublished: '2026-08-12',
  dateModified: '2026-08-12',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<SpravochnikLayout title={title} description={description} path="/spravochnik/ogranichitel-gruzopodemnosti/" slug="ogranichitel-gruzopodemnosti" ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Ограничитель грузоподъёмности</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Разбор для заказчика</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Ограничитель грузоподъёмности (ОГП) — зачем нужен и как работает</h1>
    <p class="ref-byline">Инженерная служба МОСКРАН-СЕРВИС · обновлено в 2026 году</p>

    <p>Мы много писали про грузовысотную характеристику и правильный расчёт веса груза до подъёма. Есть и техническое устройство, которое служит последним барьером на случай, если что-то пойдёт не так с расчётом, — ограничитель грузоподъёмности.</p>

    <h2 style="margin:36px 0 16px">Что делает ОГП</h2>
    <p>Ограничитель грузоподъёмности предназначен для автоматического отключения механизма подъёма и/или механизма изменения вылета стрелы, если масса груза превышает заявленную производителем грузоподъёмность крана. Это предотвращает как перегрузку самого крана, так и риск аварий, связанных с превышением расчётной нагрузки на механизмы.</p>

    <h2 style="margin:36px 0 16px">При каком превышении срабатывает</h2>
    <p>ОГП отключает механизмы при превышении грузоподъёмности крана на 10% для стреловых и башенных кранов, на 15% для портальных кранов, на 25% для мостовых кранов. Отключение прочих механизмов крана (например, поворота) не является обязательным требованием.</p>

    <h2 style="margin:36px 0 16px">На каких кранах обязателен</h2>
    <p>Установка прибора ОГП обязательна на стреловых, башенных и портальных кранах — требования установлены ГОСТ 33712-2015 «Краны грузоподъёмные. Ограничители грузоподъёмности. Общие требования». Это касается всех классов техники, о которых мы пишем на этом сайте — от 16-тонных автокранов до башенных кранов.</p>

    <h2 style="margin:36px 0 16px">Почему это не замена правильному расчёту</h2>
    <p>ОГП — важный технический барьер, но не основной метод предотвращения перегрузки. Правильный расчёт веса груза и вылета до начала подъёма (см. статью про грузовысотную характеристику) остаётся первичным способом избежать превышения — ОГП срабатывает уже в момент, когда что-то пошло не так с исходным расчётом, и его задача — не допустить дальнейшего развития опасной ситуации, а не заменить планирование.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: что запомнить</h2>
    <ul>
      <li>ОГП автоматически отключает подъём при превышении грузоподъёмности сверх установленного процента.</li>
      <li>Порог срабатывания: 10% для стреловых/башенных, 15% для портальных, 25% для мостовых кранов.</li>
      <li>Обязателен по ГОСТ 33712-2015 на всех этих типах техники.</li>
      <li>Не заменяет правильный расчёт веса и вылета заранее — это последний технический барьер.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <Sources
      checked={CHECKED}
      items={[
        { text: 'kranbalki.ru — зачем нужны ограничители грузоподъёмности', href: 'https://kranbalki.ru/stati/161-dlja-chego-nuzhny-ogranichiteli-gruzopodemnosti.html' },
        { text: 'stroy-technics.ru — ограничители грузоподъёмности кранов', href: 'https://stroy-technics.ru/article/ogranichiteli-gruzopodemnosti-kranov' }
      ]}
    />
  </article>
  <section class="section wrap"><a class="btn" href="/spravochnik/gruzovysotnaya-harakteristika/">Грузовысотная характеристика крана →</a></section>
</main>
</SpravochnikLayout>
