---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';
import Sources from '../../../components/Sources.astro';

const title = 'Страхование ОПО при аренде крана: зачем оно нужно';
const description = 'Обязательное страхование по 225-ФЗ: кран как опасный объект, что покрывает полис, зачем это заказчику. С 2023 года страховые суммы выросли в 1,5 раза.';

const CHECKED = '12.08.2026';

const faqs = [
  { q: 'Кто обязан застраховать ответственность — мы или заказчик аренды?', a: 'Обязанность лежит на владельце опасного объекта, то есть на эксплуатирующей организации (нас) — заказчик аренды крана не должен оформлять отдельный полис для этого.' },
  { q: 'Что конкретно покрывает такой полис?', a: 'Возмещение вреда третьим лицам и их имуществу в результате аварии на опасном объекте — например, при повреждении конструкций или причинении вреда людям в ходе эксплуатации крана. Это не страхование самой техники от поломки, а ответственность перед пострадавшими.' },
  { q: 'Как заказчику проверить, что у подрядчика есть действующий полис?', a: 'Попросите предоставить копию полиса вместе с комплектом документов на технику — это законный вопрос, аналогичный запросу документа об освидетельствовании или регистрации в реестре ОПО.' },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Страхование ответственности ОПО', item: 'https://moskran-servis.ru/spravochnik/strahovanie-otvetstvennosti-opo/' },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@id': 'https://moskran-servis.ru/#organization' }, // ссылка на единственный узел организации (BaseLayout): отдельный узел с тем же @id, но другим name, был противоречием в графе
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: 'https://moskran-servis.ru/spravochnik/strahovanie-otvetstvennosti-opo/',
  inLanguage: 'ru-RU',
  datePublished: '2026-08-12',
  dateModified: '2026-08-12',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<SpravochnikLayout title={title} description={description} path="/spravochnik/strahovanie-otvetstvennosti-opo/" slug="strahovanie-otvetstvennosti-opo" ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Страхование ответственности ОПО</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Разбор для заказчика</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Страхование ответственности владельца опасного объекта — зачем это нужно при аренде крана</h1>
    <p class="ref-byline">Инженерная служба МОСКРАН-СЕРВИС · обновлено в 2026 году</p>

    <p>Кран, как мы уже писали в других статьях, — опасный производственный объект, требующий регистрации, регулярного освидетельствования и аттестации персонала. Есть ещё одно обязательное требование, о котором реже говорят: страхование гражданской ответственности владельца опасного объекта.</p>

    <h2 style="margin:36px 0 16px">Что это за закон</h2>
    <p>Требование установлено Федеральным законом от 27.07.2010 №225-ФЗ «Об обязательном страховании гражданской ответственности владельца опасного объекта за причинение вреда в результате аварии на опасном объекте», действующим с 1 января 2012 года. Владелец опасного объекта — в данном случае эксплуатирующая кран организация — обязан застраховать свою ответственность за вред, который может быть причинён третьим лицам в результате аварии на объекте.</p>

    <h2 style="margin:36px 0 16px">Что покрывает полис</h2>
    <p>Объект страхования — имущественные интересы владельца опасного объекта, связанные с его обязанностью возместить вред потерпевшим. Авария на опасном объекте в контексте закона включает повреждение или разрушение конструкций и технических устройств, применяемых на объекте, и иные подобные события, произошедшие при эксплуатации и причинившие вред пострадавшим. Применительно к крану это, по сути, страхование ответственности перед третьими лицами на случай аварийной ситуации при работе техники.</p>

    <h2 style="margin:36px 0 16px">Изменения в суммах покрытия</h2>
    <p>С 30 марта 2023 года страховые суммы по договорам обязательного страхования ответственности владельца опасного объекта были увеличены — в полтора раза и более по сравнению с предыдущими значениями. Это отражает общий тренд на повышение финансовой защиты пострадавших в подобных случаях.</p>

    <h2 style="margin:36px 0 16px">Что это значит для заказчика</h2>
    <p>Как и с другими обязательными документами (регистрация в реестре ОПО, техническое освидетельствование, аттестация оператора), наличие полиса — не забота заказчика напрямую, но законный предмет проверки при выборе подрядчика. Компания, у которой в порядке весь пакет обязательных документов, с большей вероятностью ответственно относится и к остальным аспектам безопасности работы.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: что запомнить</h2>
    <ul>
      <li>Страхование ответственности владельца ОПО обязательно по 225-ФЗ с 2012 года.</li>
      <li>Полис покрывает вред третьим лицам при аварии на опасном объекте, а не поломку самой техники.</li>
      <li>С марта 2023 года страховые суммы выросли в 1,5 раза и более.</li>
      <li>Обязанность лежит на эксплуатирующей организации, но заказчик вправе запросить копию полиса.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <Sources
      checked={CHECKED}
      items={[
        { text: 'consultant.ru — Федеральный закон №225-ФЗ', href: 'https://www.consultant.ru/document/cons_doc_LAW_103102/' },
        { text: 'nsso.ru — изменения в законодательстве об обязательном страховании ОПО', href: 'https://nsso.ru/press-center/news/8418/' }
      ]}
    />
  </article>
  <section class="section wrap"><a class="btn" href="/documents/">Что ещё входит в комплект документов →</a></section>
</main>
</SpravochnikLayout>
