---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';
import Sources from '../../../components/Sources.astro';

const title = 'Правило 30 метров при работе крана у ЛЭП';
const description = 'Действующая норма: ФНП №461, пункт 112 — менее 30 м до крайнего провода ЛЭП напряжением более 50 В только по наряду-допуску.';

const CHECKED = '12.08.2026';

/* --- Волна 16 (исправление источника) ---------------------------------------
   Прежняя редакция опиралась на ПОТ РМ-007-98 (приложение 16, таблица 1, п. 12)
   и приводила порог «42 В и выше». Проверка 12.08.2026 показала: документ помечен
   как прекративший действие, а действующее требование к КРАНУ стоит в ФНП №461,
   пункт 112, и порог там другой — «более 50 В». Это не косметика: это граница
   применения правила, и она названа неверно на большинстве отраслевых сайтов.
   Статья переписана по действующей норме; ошибочная цифра разобрана отдельно,
   чтобы читатель понимал, откуда она взялась и почему её больше нельзя цитировать.
   Таблица допустимых расстояний до токоведущих частей — из Правил по охране труда
   при эксплуатации электроустановок (приказ Минтруда России от 15.12.2020 №903н),
   она не менялась. */

const faqs = [
  { q: 'Правило 30 метров действует для любых ЛЭП?', a: 'Действующая формулировка такая: установка и работа кранов стрелового типа, кранов-манипуляторов, подъёмников (вышек) на расстоянии менее 30 м от крайнего провода воздушной линии электропередачи или воздушной электрической сети напряжением более 50 В осуществляется только по наряду-допуску. Это пункт 112 федеральных норм и правил по подъёмным сооружениям. Конкретные минимальные расстояния до токоведущих частей зависят от класса напряжения и заданы отдельной таблицей Правил по охране труда при эксплуатации электроустановок.' },
  { q: 'Кто оформляет наряд-допуск на работу рядом с ЛЭП — мы или заказчик?', a: 'Наряд-допуск оформляет организация, эксплуатирующая кран (то есть мы), но требует согласования с сетевой организацией, обслуживающей конкретную линию — это может занять дополнительное время, которое мы закладываем в срок подготовки заявки, если площадка расположена рядом с ЛЭП.' },
  { q: 'А трамвайная контактная сеть считается?', a: 'Да. Пункт 112 говорит не только про воздушную линию электропередачи, но и про воздушную электрическую сеть напряжением более 50 В — контактная сеть городского транспорта попадает под это определение целиком. Отдельной цифры «1000 мм», которая ходит по отраслевым статьям, в действующей норме нет: она происходит из ПОТ РМ-007-98, прекративших действие. Минимальное расстояние до токоведущих частей берётся из таблицы Правил по охране труда при эксплуатации электроустановок по классу напряжения сети.' },
  { q: 'Что будет, если проигнорировать охранную зону ЛЭП?', a: 'Это прямой риск поражения электрическим током при приближении стрелы или груза к токоведущим частям на недопустимое расстояние — угроза жизни оператора и бригады, а не формальное нарушение. Расстояния в нормативной таблице рассчитаны с учётом возможного пробоя воздушного промежутка, не произвольно.' },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Работа рядом с ЛЭП', item: 'https://moskran-servis.ru/spravochnik/rabota-krana-ryadom-s-lep/' },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@id': 'https://moskran-servis.ru/#organization' }, // ссылка на единственный узел организации (BaseLayout): отдельный узел с тем же @id, но другим name, был противоречием в графе
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: 'https://moskran-servis.ru/spravochnik/rabota-krana-ryadom-s-lep/',
  inLanguage: 'ru-RU',
  datePublished: '2026-08-12',
  dateModified: '2026-08-12',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<SpravochnikLayout title={title} description={description} path="/spravochnik/rabota-krana-ryadom-s-lep/" slug="rabota-krana-ryadom-s-lep" ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Работа рядом с ЛЭП</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Разбор для заказчика</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Работа крана рядом с ЛЭП — правило 30 метров и наряд-допуск</h1>
    <p class="ref-byline">Инженерная служба МОСКРАН-СЕРВИС · обновлено 12.08.2026</p>

    <p>На нескольких страницах услуг мы упоминаем воздушные линии электропередач как фактор, который проверяем при расчёте заявки. Здесь — подробный разбор: какие расстояния допустимы, откуда взяты цифры и когда требуется отдельное согласование с сетевой организацией.</p>

    <h2 style="margin:36px 0 16px">Правило 30 метров: действующая формулировка</h2>
    <p>Норма закреплена в федеральных нормах и правилах промышленной безопасности «Правила безопасности опасных производственных объектов, на которых используются подъёмные сооружения» (приказ Ростехнадзора от 26.11.2020 №461), пункт 112. Дословно: установка и работа кранов стрелового типа, кранов-манипуляторов, подъёмников (вышек) на расстоянии менее 30 м от крайнего провода воздушной линии электропередачи или воздушной электрической сети напряжением более 50 В осуществляется только по наряду-допуску.</p>
    <p>Считается это расстояние не от кабины и не от опор: в расчёт берётся выдвижная часть машины в любом её положении и груз на стреле — до вертикальной плоскости, образуемой проекцией ближайшего провода на землю. Практический вывод для планирования тот же, что и был: если площадка попадает в радиус 30 метров, время на согласование закладывается заранее, а не выясняется в день выезда техники.</p>

    <h2 style="margin:36px 0 16px">Откуда взялась цифра «42 В» и почему её больше нельзя приводить</h2>
    <p>Формулировка «напряжением 42 В и выше» встречается в отраслевых статьях, во внутренних инструкциях и — до этой правки — на нашем собственном сайте. Её источник — Межотраслевые правила по охране труда при погрузочно-разгрузочных работах и размещении грузов (ПОТ РМ-007-98), приложение 16. Документ помечен как прекративший действие: правила по охране труда при погрузочно-разгрузочных работах сегодня утверждены приказом Минтруда России от 28.10.2020 №753н.</p>
    <p>Практическая разница между «42 В и выше» и «более 50 В» для реальной линии почти нулевая — обе формулировки накрывают любую силовую сеть, с которой кран может встретиться на площадке. Но ссылка на отменённый документ в инструкции или в наряде — это дефект самого документа, а не оттенок смысла. Если в бумаге, которую вам показывают, стоит ПОТ РМ-007-98, значит, документ не пересматривали как минимум с 2020 года, и проверять в нём стоит не только этот пункт.</p>

    <h2 style="margin:36px 0 16px">Контактная сеть городского транспорта</h2>
    <p>Пункт 112 говорит не только о воздушной линии электропередачи, но и о воздушной электрической сети — трамвайная и троллейбусная контактная сеть под это определение попадает. Для Москвы это не экзотика, а обычная городская геометрия: контактная сеть идёт над проезжей частью на тех же улицах, где стоят объекты, и 30 метров от стрелы до провода набираются быстрее, чем кажется с земли. Отдельного норматива «не менее 1000 мм», который кочует по статьям, в действующих правилах нет — он тоже из ПОТ РМ-007-98. Минимальное расстояние берётся по классу напряжения из таблицы ниже.</p>

    <h2 style="margin:36px 0 16px">Допустимые расстояния по классам напряжения</h2>
    <p>Отдельно от правила 30 метров действует таблица «Допустимые расстояния до токоведущих частей электроустановок, находящихся под напряжением» из Правил по охране труда при эксплуатации электроустановок (действующая редакция утверждена приказом Минтруда России от 15.12.2020 №903н). Столбец для механизмов и грузоподъёмных машин, стропов и грузов:</p>
    <table class="ttx">
      <tbody>
        <tr><td>ВЛ до 1 кВ и остальные электроустановки до 1 кВ</td><td>не менее 1,0 м</td></tr>
        <tr><td>1–35 кВ</td><td>не менее 1,0 м</td></tr>
        <tr><td>60 кВ (постоянный ток) и 110 кВ</td><td>не менее 1,5 м</td></tr>
        <tr><td>150 кВ</td><td>не менее 2,0 м</td></tr>
        <tr><td>220 кВ</td><td>не менее 2,5 м</td></tr>
        <tr><td>330 кВ</td><td>не менее 3,5 м</td></tr>
        <tr><td>400–500 кВ (постоянный ток)</td><td>не менее 4,5 м</td></tr>
        <tr><td>750 кВ</td><td>не менее 6,0 м</td></tr>
        <tr><td>1150 кВ</td><td>не менее 10,0 м</td></tr>
      </tbody>
    </table>
    <p>Эти расстояния — не запас «на всякий случай», а расчётная величина, учитывающая риск электрического пробоя воздушного промежутка при высоком напряжении: чем выше класс напряжения линии, тем больше требуемое расстояние. Перед применением сверяйте значения с действующей редакцией правил: сами Правила по охране труда при эксплуатации электроустановок имеют ограниченный срок действия — до 1 сентября 2031 года.</p>

    <h2 style="margin:36px 0 16px">Кто оформляет наряд-допуск</h2>
    <p>Наряд-допуск на работы в охранной зоне ЛЭП оформляет эксплуатирующая кран организация (мы), но процедура требует согласования с сетевой организацией, обслуживающей конкретную линию, — это отдельный внешний участник процесса, не зависящий от нас напрямую. Соответственно, срок оформления зависит не только от нашей скорости реакции, но и от регламента конкретной сетевой компании — мы уточняем это заранее, если площадка расположена рядом с воздушной линией, и закладываем реалистичный запас времени в график заявки.</p>

    <h2 style="margin:36px 0 16px">Как мы это учитываем при расчёте заявки</h2>
    <p>При приёме заявки на площадку, где есть воздушные линии электропередач поблизости, мы уточняем примерное расстояние от предполагаемой точки работы крана до ближайшего провода и класс напряжения линии, если эта информация доступна заказчику. Если расстояние потенциально попадает в зону, требующую согласования, сообщаем об этом сразу — вместе с ориентировочным сроком на оформление наряда-допуска, а не оставляем этот вопрос на день выезда техники.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: что запомнить</h2>
    <ul>
      <li>Работа стрелового крана ближе 30 метров к крайнему проводу воздушной линии или воздушной электрической сети напряжением более 50 В ведётся только по наряду-допуску — пункт 112 ФНП №461.</li>
      <li>Контактная сеть городского транспорта подпадает под тот же пункт как «воздушная электрическая сеть»; цифра «1000 мм» пришла из отменённых ПОТ РМ-007-98 и нормой больше не является.</li>
      <li>Минимальные расстояния до токоведущих частей заданы таблицей Правил по охране труда при эксплуатации электроустановок, а не ПУЭ, и зависят от класса напряжения.</li>
      <li>Наряд-допуск оформляет эксплуатирующая кран организация, но согласование зависит от внешней сетевой компании — закладывайте на это время.</li>
      <li>Расстояния рассчитаны исходя из риска электрического пробоя — это вопрос безопасности, не формальность.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <Sources
      checked={CHECKED}
      items={[
        { text: 'ФНП №461, раздел «Установка ПС и производство работ», пункт 112', href: 'https://www.consultant.ru/document/cons_doc_LAW_373321/f7815d9c6eac8483e35e0b74950da570d45ad998/' },
        { text: 'ПОТ РМ-007-98 — отметка «прекратили действие»', href: 'https://base.garant.ru/12126870/' },
        { text: 'приказ Минтруда России от 28.10.2020 №753н — действующие правила по охране труда при погрузочно-разгрузочных работах', href: 'https://normativ.kontur.ru/document?moduleId=1&documentId=501427' },
        { text: 'Правила по охране труда при эксплуатации электроустановок (приказ Минтруда России от 15.12.2020 №903н)', href: 'https://www.consultant.ru/document/cons_doc_LAW_372952/' }
      ]}
    />
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-40-50-tonn/">Расчёт для тяжёлых монтажей рядом с ЛЭП →</a></section>
</main>
