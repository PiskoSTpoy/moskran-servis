---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';
import Sources from '../../../components/Sources.astro';

const title = 'Техосмотр автокрана и диагностическая карта: чем отличается от технического освидетельствования';
const description = 'Диагностическая карта техосмотра — про шасси автокрана как транспортное средство, а не про грузоподъёмный механизм. Кто обязан её оформлять, с какой периодичностью и что грозит за выпуск машины на линию без неё.';

const CHECKED = '06.09.2026';

const faqs = [
  {
    q: 'Чем диагностическая карта техосмотра отличается от акта технического освидетельствования крана?',
    a: 'Это документы про разные объекты. Техническое освидетельствование по ФНП №461 (о котором мы писали в отдельной статье) подтверждает исправность самого подъёмного сооружения — крановой установки как механизма. Диагностическая карта по Федеральному закону №170-ФЗ подтверждает исправность шасси как транспортного средства для движения по дорогам общего пользования: тормоза, рулевое управление, шины, световые приборы. Один автокран проходит обе процедуры независимо друг от друга, и одна не заменяет вторую.',
  },
  {
    q: 'С какой периодичностью автокран должен проходить техосмотр?',
    a: 'Шасси автокрана относится к грузовым транспортным средствам категорий N2 (массой от 3,5 до 12 т) или N3 (свыше 12 т) — для них периодичность техосмотра установлена в один раз в год, независимо от возраста машины. Это отличается от легковых автомобилей, где периодичность растёт с возрастом ТС.',
  },
  {
    q: 'Зачем вообще нужна диагностическая карта, если не собираешься её показывать инспектору?',
    a: 'Прежде всего для полиса ОСАГО: страховая компания не оформит или не продлит полис на транспортное средство, обязанное проходить техосмотр, без действующей диагностической карты. Для организации, эксплуатирующей автокраны, это следующий по важности документ учёта после самого полиса и паспорта ПС.',
  },
  {
    q: 'Что грозит, если автокран выехал на объект без диагностической карты?',
    a: 'Водителю — часть 1.1 статьи 12.5 КоАП РФ, штраф 2 000 руб. за управление транспортным средством без оформленной в установленном порядке диагностической карты. Организации и должностному лицу, ответственному за выпуск техники на линию, — статья 12.31 КоАП РФ: 500 руб. для должностного лица и 50 000 руб. для юридического лица за выпуск на линию транспортного средства, не прошедшего технический осмотр.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Техосмотр автокрана', item: 'https://moskran-servis.ru/spravochnik/tehosmotr-avtokrana/' },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@id': 'https://moskran-servis.ru/#organization' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: 'https://moskran-servis.ru/spravochnik/tehosmotr-avtokrana/',
  inLanguage: 'ru-RU',
  datePublished: '2026-09-06',
  dateModified: '2026-09-06',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<SpravochnikLayout title={title} description={description} path="/spravochnik/tehosmotr-avtokrana/" slug="tehosmotr-avtokrana" ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Техосмотр автокрана</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Разбор для заказчика</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Техосмотр автокрана и диагностическая карта: чем отличается от технического освидетельствования</h1>
    <p class="ref-byline">Инженерная служба МОСКРАН-СЕРВИС · обновлено 06.09.2026</p>

    <p>Мы уже разбирали техническое освидетельствование крана — процедуру, которая подтверждает исправность самого подъёмного сооружения по ФНП №461. У автокрана есть вторая, независимая от первой процедура — техосмотр шасси как транспортного средства, дающий диагностическую карту. Заказчики нередко путают эти два документа, хотя они регулируются разными законами, выдаются разными организациями и отвечают на разные вопросы: один — можно ли поднимать груз этим краном, второй — можно ли этому крану вообще выехать на дорогу общего пользования.</p>

    <h2 style="margin:36px 0 16px">Какой закон это регулирует</h2>
    <p>Порядок и периодичность техосмотра транспортных средств в эксплуатации устанавливает Федеральный закон от 01.07.2011 №170-ФЗ «О техническом осмотре транспортных средств и о внесении изменений в отдельные законодательные акты Российской Федерации». Закон определяет не только периодичность проверки, но и порядок аккредитации операторов техосмотра — организаций и предпринимателей, которые вправе выдавать диагностические карты. Это отдельный контур регулирования от норм промышленной безопасности, по которым освидетельствуется грузоподъёмный механизм крана.</p>

    <h2 style="margin:36px 0 16px">Периодичность для автокрана</h2>
    <p>Шасси автокрана — грузовое транспортное средство категории N2 (полной массой от 3,5 до 12 т) или N3 (свыше 12 т), в зависимости от грузоподъёмности модели. Для этих категорий периодичность техосмотра — один раз в год, независимо от возраста конкретной машины. Это отличается от порядка для легковых автомобилей, где периодичность меняется по мере старения транспортного средства: у грузовой техники возрастной группировки нет, интервал фиксированный.</p>

    <h2 style="margin:36px 0 16px">Кто выдаёт диагностическую карту</h2>
    <p>Осмотр проводит аккредитованный оператор технического осмотра — пункт технического осмотра (ПТО), прошедший аккредитацию в установленном законом №170-ФЗ порядке. По итогам проверки сведения о состоянии транспортного средства вносятся в единую автоматизированную информационную систему технического осмотра (ЕАИСТО), которую ведёт Госавтоинспекция, — не позднее суток с момента оказания услуги. Диагностическую карту при необходимости можно проверить по государственному регистрационному знаку или VIN прямо в этой системе, не дожидаясь бумажного экземпляра от подрядчика.</p>

    <h2 style="margin:36px 0 16px">Зачем диагностическая карта нужна на практике</h2>
    <p>Главное практическое следствие — полис ОСАГО. Страховая компания не оформит и не продлит полис обязательного страхования на транспортное средство, для которого предусмотрен техосмотр, если действующей диагностической карты нет. Для организации, которая эксплуатирует парк автокранов, это делает диагностическую карту документом первого порядка учёта — рядом с самим полисом ОСАГО и паспортом подъёмного сооружения, а не второстепенной бумагой на всякий случай.</p>

    <h2 style="margin:36px 0 16px">Ответственность за отсутствие</h2>
    <p>Часть 1.1 статьи 12.5 КоАП РФ устанавливает штраф 2 000 руб. для водителя за управление транспортным средством, в отношении которого не оформлена в установленном порядке диагностическая карта. Это ответственность водителя за конкретный выезд. Отдельно статья 12.31 КоАП РФ наказывает за выпуск на линию транспортного средства, не прошедшего технический осмотр, — штраф 500 руб. для должностного лица, ответственного за техническое состояние и эксплуатацию транспортных средств, и 50 000 руб. для юридического лица. Это уже ответственность организации, а не отдельного водителя, и она заметно выше — санкция рассчитана на компанию, системно выпускающую технику без контроля документов, а не на разовую невнимательность.</p>

    <h2 style="margin:36px 0 16px">Как мы это учитываем</h2>
    <p>Диагностическая карта на каждый автокран парка обновляется у нас заранее, до истечения годового срока, синхронно с продлением полиса ОСАГО, — а не по факту приближающейся проверки на дороге. Копию действующей карты вместе с путевым листом и паспортом ПС экипаж возит на объект, чтобы у представителя заказчика и у проверяющих не возникало вопросов на площадке.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: что запомнить</h2>
    <ul>
      <li>Диагностическая карта техосмотра — про шасси автокрана как транспортное средство; техническое освидетельствование по ФНП №461 — про кран как грузоподъёмный механизм. Это разные документы, ни один не заменяет другой.</li>
      <li>Периодичность техосмотра для шасси автокрана (категории N2/N3) — один раз в год, независимо от возраста машины.</li>
      <li>Карту выдаёт аккредитованный оператор техосмотра (ПТО), сведения вносятся в ЕАИСТО не позднее суток; без действующей карты страховая не оформит ОСАГО.</li>
      <li>Штраф водителю за отсутствие карты — 2 000 руб. по ч. 1.1 ст. 12.5 КоАП РФ; за выпуск на линию непрошедшего техосмотр ТС — 500 руб. должностному лицу и 50 000 руб. юрлицу по ст. 12.31 КоАП РФ.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <Sources
      checked={CHECKED}
      items={[
        { text: 'ГАРАНТ — Федеральный закон от 01.07.2011 №170-ФЗ «О техническом осмотре транспортных средств и о внесении изменений в отдельные законодательные акты Российской Федерации»', href: 'https://base.garant.ru/12187349/' },
        { text: 'КонсультантПлюс — статья 12.5 КоАП РФ «Управление транспортным средством при наличии неисправностей или условий, при которых эксплуатация транспортных средств запрещена»', href: 'https://www.consultant.ru/document/cons_doc_LAW_34661/98e1b268896ae1d97a72043bfc196ba5df4e8de0/' },
        { text: 'КонсультантПлюс — статья 12.31 КоАП РФ «Выпуск на линию транспортного средства, не зарегистрированного в установленном порядке, не прошедшего технического осмотра...»', href: 'https://www.consultant.ru/document/cons_doc_LAW_34661/9ea898782c9b757a988def614fa84e1493938591/' },
        { text: 'Банки.ру — проверка диагностической карты и техосмотра по базе ЕАИСТО и РСА', href: 'https://www.banki.ru/news/daytheme/?id=11024130' },
      ]}
      note="Периодичность техосмотра приведена для базовой категории грузовых ТС (N2/N3), к которой относится шасси большинства автокранов; для машин на спецшасси или с иной регистрацией периодичность стоит уточнять по паспорту транспортного средства конкретной модели."
    />
  </article>
  <section class="section wrap"><a class="btn" href="/spravochnik/putevoy-list-avtokrana/">Путевой лист автокрана: зачем нужен и кто оформляет →</a></section>
</main>
</SpravochnikLayout>
