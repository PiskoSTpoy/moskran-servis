---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = 'Гусеничный кран или автокран: что выбрать';
const description = 'Автокран едет сам и стоит от 31 200 ₽ за смену, гусеничный нужен на слабом грунте, но едет на трале. Давление на грунт, скорость, цена и логистика.';

const CHECKED = '05.10.2026';
const PUBLISHED = '2026-10-05';
const SLUG = 'gusenichnyy-kran-ili-avtokran';
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: 'Когда гусеничный кран лучше автокрана?',
    a: 'Гусеничный кран выигрывает на слабом, неровном или не обустроенном грунте и там, где нет места под выносные опоры. МОСКРАН-СЕРВИС выбирает его, когда подготовка площадки под опоры автокрана дороже доставки гусеничной машины на трале.',
  },
  {
    q: 'Может ли гусеничный кран ехать по дороге сам?',
    a: 'Нет, по дорогам общего пользования гусеничный кран не едет: его возят на трале грузоподъёмностью около 40 т. Собственный ход — порядка 1 км/ч, и он нужен только внутри площадки. МОСКРАН-СЕРВИС закладывает перевозку отдельной строкой в срок и бюджет заказа.',
  },
  {
    q: 'Сколько стоит аренда гусеничного крана в Москве?',
    a: 'Для гусеничного крана 50 т МОСКРАН-СЕРВИС ориентируется на рыночные от 50 000 ₽ за смену, а смена у такой техники обычно длиннее восьмичасовой. 50-тонный автокран КС-65713-1 «Галичанин» стоит 31 200 ₽ за смену. Доставка на трале и сборка стрелы в цену смены не входят.',
  },
  {
    q: 'Нужны ли гусеничному крану выносные опоры?',
    a: 'Выносных опор у гусеничного крана нет: он опирается на гусеничный ход целиком, а нагрузка распределяется по площади гусениц. Это не отменяет требований к площадке по ФНП №461: установка на свеженасыпанном неутрамбованном грунте остаётся запрещённой. МОСКРАН-СЕРВИС проверяет основание независимо от типа машины.',
  },
  {
    q: 'Какой кран быстрее приедет на объект?',
    a: 'Автокран приезжает своим ходом в день заявки, а гусеничному нужны трал, согласование маршрута и сборка стрелы на месте. МОСКРАН-СЕРВИС для срочных подъёмов предлагает автокран, а гусеничный планирует заранее, под график работ.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Гусеничный кран или автокран', item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ['sravnenie', 'Сравнение в цифрах'],
  ['grunt', 'Грунт и опоры'],
  ['logistika', 'Логистика и срок'],
  ['cena', 'Цена'],
  ['vybor', 'Как выбрать'],
  ['faq', 'Частые вопросы'],
  ['istochniki', 'Источники'],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Гусеничный кран или автокран</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Сравнение · Тип техники</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Гусеничный кран или автокран: что выбрать для площадки?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>05.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>05.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>6 мин чтения</span>
    </div>

    <p>Автокран едет на объект сам и стоит от 31 200 ₽ за смену, а гусеничный кран приезжает на трале, зато работает на слабом грунте без выносных опор. Выбор определяют площадка, срок и график, а не только грузоподъёмность. МОСКРАН-СЕРВИС сравнивает оба типа на цифрах из паспортных данных и собственного парка.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="sravnenie" style="margin:36px 0 16px">Сравнение в цифрах</h2>
    <p>Гусеничный МКГ-25.БР тянет на 38,9 т при грузоподъёмности 25 т и ползёт со скоростью около 0,85 км/ч. Для примера МОСКРАН-СЕРВИС берёт 25-тонный МКГ-25.БР (119 т·м, масса около 38,9 т, давление на грунт 0,061–0,063 МПа) и 50-тонный автокран КС-65713-1 «Галичанин» (175 т·м, масса 36,5 т, опорный контур 7,2×7,0 м). Масса сопоставима, а грузоподъёмность у гусеничного вдвое ниже.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Параметр</th><th>МКГ-25.БР, гусеничный</th><th>РДК-25, гусеничный</th><th>КС-65713-1, автокран</th></tr></thead>
        <tbody>
          <tr><td>Грузоподъёмность</td><td>25 т</td><td>25 т</td><td>50 т</td></tr>
          <tr><td>Момент</td><td>119 т·м</td><td>119 т·м</td><td>175 т·м</td></tr>
          <tr><td>Масса</td><td>около 38,9 т</td><td>45,2 т</td><td>36,5 т</td></tr>
          <tr><td>Давление на грунт</td><td>0,061–0,063 МПа</td><td>0,0919–0,097 МПа</td><td>через опоры, пятно 7,2×7,0 м</td></tr>
          <tr><td>Скорость хода</td><td>около 0,85 км/ч</td><td>около 1 км/ч</td><td>по дорогам, своим ходом</td></tr>
          <tr><td>Доставка</td><td>трал 40 т</td><td>трал 40–45 т</td><td>сам</td></tr>
        </tbody>
      </table>
    </div>

    <h2 id="grunt" style="margin:36px 0 16px">Грунт и опоры</h2>
    <p>Давление гусеничного хода МКГ-25.БР составляет около 0,06 МПа, и нагрузка распределена по двум лентам, а не по четырём точкам опор. Автокран передаёт вес через опоры точечно, поэтому под них нужны инвентарные подкладки. МОСКРАН-СЕРВИС оценивает основание по материалу <a href="/spravochnik/nesushchaya-sposobnost-grunta/" style="color:var(--yellow)">о несущей способности грунта</a> и сопоставляет с картой пятна опор.</p>
    <p>Отсутствие опор не снимает требований ФНП №461 к площадке: установка на свеженасыпанном неутрамбованном грунте запрещена и для гусеничных машин. Если участок — газон или засыпанная траншея, уточните условия по материалу <a href="/spravochnik/avtokran-na-gazone-v-moskve/" style="color:var(--yellow)">об автокране на газоне в Москве</a>. У гусеничного крана модели XCMG QUY50 из парка МОСКРАН-СЕРВИС карточка описана на <a href="/park/xcmg-quy50/" style="color:var(--yellow)">странице техники</a>.</p>

    <h2 id="logistika" style="margin:36px 0 16px">Логистика и срок</h2>
    <p>Гусеничный кран не ездит по дорогам общего пользования: его возят на трале грузоподъёмностью около 40 т, а собственный ход ограничен примерно 1 км/ч. К работе добавляются согласование маршрута перевозки и сборка стрелы на площадке. МОСКРАН-СЕРВИС ставит эти этапы в график до начала смены, как показано в <a href="/keysy/rabota-na-stesnennoy-ploshchadke-gusenichnyy/" style="color:var(--yellow)">примере стеснённой площадки</a>.</p>
    <p>Автокран с разрешённой массой выше 3,5 т въезжает в Москву по пропуску, но доезжает сам. Правила въезда собраны в материале <a href="/spravochnik/propusk-avtokrana-v-moskvu/" style="color:var(--yellow)">«Пропуск автокрана в Москву»</a>. Для срочного подъёма МОСКРАН-СЕРВИС предлагает именно автокран.</p>

    <h2 id="cena" style="margin:36px 0 16px">Цена</h2>
    <p>Смена 50-тонного автокрана КС-65713-1 «Галичанин» у МОСКРАН-СЕРВИС — 31 200 ₽, а для гусеничного крана 50 т рыночный ориентир — от 50 000 ₽ за смену. У гусеничных машин смена обычно длиннее восьмичасовой, поэтому прямое сравнение по ставке некорректно. Доставку на трале и сборку стрелы МОСКРАН-СЕРВИС считает отдельной позицией.</p>
    <p>Базовые тарифы по классам автокранов сведены в <a href="/spravochnik/stoimost-arendy-avtokrana/" style="color:var(--yellow)">справочнике о стоимости аренды</a>. Сравнение 25- и 50-тонного автокрана по цене момента дано в <a href="/spravochnik/avtokran-25-ili-50-tonn/" style="color:var(--yellow)">отдельном материале</a>.</p>

    <h2 id="vybor" style="margin:36px 0 16px">Как выбрать</h2>
    <p>Выбор между двумя типами занимает 5 проверок: основание, место под опоры, срок, вылет и цена перевозки. МОСКРАН-СЕРВИС берёт автокран при твёрдом основании, разовых подъёмах и срочном выезде, а гусеничный кран — при слабом грунте, длительной работе на одной площадке или нехватке места под опоры.</p>
    <p>Если ответ неочевиден, МОСКРАН-СЕРВИС рассматривает оба варианта в одной заявке и считает полную стоимость вместе с доставкой. Заявку удобно подавать по <a href="/spravochnik/zayavka-na-avtokran/" style="color:var(--yellow)">шаблону заявки на автокран</a>.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: гусеничный или автокран</h2>
    <ul>
      <li>Автокран едет сам; гусеничный — на трале около 40 т, ход на площадке порядка 1 км/ч.</li>
      <li>Давление МКГ-25.БР на грунт — 0,061–0,063 МПа, опор нет.</li>
      <li>Смена автокрана 50 т — 31 200 ₽; гусеничного 50 т — от 50 000 ₽ и дольше по времени.</li>
      <li>Запрет на свеженасыпанный грунт по ФНП №461 действует для обоих типов.</li>
      <li>Для срочных подъёмов — автокран, для слабого грунта — гусеничный.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://kran-dek.ru/kran_mkg-25-br.html" target="_blank" rel="noopener" style="color:var(--yellow)">Гусеничный кран МКГ-25.БР — kran-dek.ru</a> — масса, давление на грунт, скорость, трал 40 т.</li>
      <li><a href="https://kran-dek.ru/kran_rdk-250.html" target="_blank" rel="noopener" style="color:var(--yellow)">Гусеничный кран РДК-250/РДК-25 — kran-dek.ru</a> — масса 45,2 т, давление 0,0919–0,097 МПа, скорость 16,6 м/мин.</li>
      <li><a href="https://kran-master74.ru/heavy/truck_cranes/galichanin/avtokran_galichanin_ks_65713_1_50_t/" target="_blank" rel="noopener" style="color:var(--yellow)">КС-65713-1 «Галичанин», 50 т — карточка дилера «Кран-Мастер»</a> — момент 175 т·м, масса 36,5 т.</li>
      <li><a href="/park/xcmg-quy50/" style="color:var(--yellow)">XCMG QUY50 — парк МОСКРАН-СЕРВИС</a> — рыночный ориентир от 50 000 ₽ за смену.</li>
    </ul>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-40-50-tonn/">Аренда автокрана 40–50 тонн →</a></section>
</main>
</SpravochnikLayout>
