---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = "Подходит ли автокран под условия объекта: ФНП 461";
const description = "Кран, не соответствующий температуре, ветровому региону или сейсмичности, к работе не допускают (п. 251 «м» ФНП №461). Что сверить в паспорте до заказа.";

const CHECKED = '28.10.2026';
const PUBLISHED = '2026-10-28';
const SLUG = "avtokran-pod-usloviya-obekta-klimat-veter-fnp-461";
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    "q": "Что ФНП 461 говорит о соответствии автокрана региону работы?",
    "a": "Пункт 251 «м» ФНП №461 запрещает допускать подъёмное сооружение в работу, если оно не соответствует параметрам окружающей среды и региона: температурному диапазону, ветровому региону и сейсмичности района. Это одно из оснований, по которым эксплуатирующая организация обязана остановить работу."
  },
  {
    "q": "Кто проверяет соответствие крана ветровой нагрузке района?",
    "a": "Соответствие ветровой нагрузке и сейсмичности района установки закладывает проект организации строительства (п. 155) или, если в ПОС этого нет, проект производства работ (п. 156 «а»). Заказчик получает эти документы от проектировщика и подрядчика; сверку с паспортом крана выполняет ответственный за безопасное производство работ."
  },
  {
    "q": "Где в паспорте автокрана искать допустимый температурный диапазон?",
    "a": "Раздел паспорта и руководства по эксплуатации, где указаны климатическое исполнение и условия применения. ФНП №461 не называет конкретный раздел, поэтому точное место зависит от документации изготовителя. Если значения нет в паспорте, вопрос задают изготовителю или экспертной организации до заказа техники."
  },
  {
    "q": "Что делать, если ветер на площадке выше паспортного значения?",
    "a": "Работу останавливают: ФНП №461 требует прекращать работы при скорости ветра выше установленной паспортом (п. 132), а ППР подъёмников прямо запрещает работу на высоте при ветре выше паспортных значений. Решение о возобновлении принимает ответственный за безопасное производство работ после снижения ветра."
  },
  {
    "q": "Можно ли заменить кран другой модели, если исходный не подходит по условиям?",
    "a": "Можно, но только с проверкой нового крана по тем же пунктам: грузовая характеристика, высота подъёма, вылет, ветровая нагрузка. Если замена меняет схему установки или опасные зоны, ППР корректируют до начала работ. Подбор тоннажа и модели — отдельная услуга: МОСКРАН-СЕРВИС подбирает кран под вылет и массу груза."
  }
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: "Автокран под условия объекта", item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [["norma", "Что запрещает п. 251 ФНП №461"], ["proekt", "Где условия района закладывают в проект"], ["tablica", "Пять условий объекта и что сверить в паспорте"], ["zima-veter", "Зимняя температура и ветер: два самых частых расхождения"], ["zayavka", "Что указать в заявке, чтобы кран подошёл"], ["faq", "Частые вопросы"], ["istochniki", "Источники"]];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Автокран под условия объекта</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">ФНП №461 · Выбор техники</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Как проверить, что автокран подходит под условия вашего объекта?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>28.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>28.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>7 мин чтения</span>
    </div>

    <p>Автокран, который не соответствует температурному диапазону, ветровому региону или сейсмичности района работ, к эксплуатации не допускают (п. 251 «м» ФНП №461). Проверка делается до заказа техники и сводится к сверке пяти параметров объекта с паспортом: грузовой характеристики, высоты подъёма, вылета, ветровой нагрузки и климатического исполнения. МОСКРАН-СЕРВИС просит у заказчика эти данные в заявке, чтобы подобрать КС-55713 «Клинцы» или КС-65713-1 «Галичанин» без замены на площадке.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="norma" style="margin:36px 0 16px">Что запрещает п. 251 ФНП №461</h2>
    <p>Пункт 251 ФНП №461 перечисляет случаи, когда эксплуатирующая организация не должна допускать подъёмное сооружение в работу, и два из них касаются условий объекта. Подпункт «м» — кран не соответствует параметрам окружающей среды и региона: температурному диапазону, ветровому региону, сейсмичности района. Подпункт «л» — кран не соответствует технологическому процессу, в котором задействован.</p>
    <p>Оба подпункта работают как стоп-условия: достаточно одного несоответствия, чтобы работу остановили. Рядом стоят другие основания того же пункта — нет паспорта и руководства по эксплуатации (подпункт «и»), нет ППР или технологической карты там, где они обязательны (подпункт «ж»). О полном перечне запретов — справка про <a href="/spravochnik/kogda-avtokran-ne-dopuskayut-k-rabote-fnp-461/" style="color:var(--yellow)">допуск автокрана к работе</a>.</p>

    <h2 id="proekt" style="margin:36px 0 16px">Где условия района закладывают в проект</h2>
    <p>Соответствие крана условиям района закладывают в проект организации строительства, а если там этого нет — в проект производства работ (пп. 155–156 ФНП №461). В обоих документах должны быть предусмотрены соответствие устанавливаемого крана условиям работ по грузоподъёмности, высоте подъёма, вылету и грузовой характеристике, а также ветровой нагрузке и сейсмичности района установки.</p>
    <p>Для заказчика это означает, что проверка делается не на глаз: проектировщик или подрядчик уже должен был сопоставить кран с условиями. Если вы выбираете кран сами, сверка по пяти пунктам ниже повторяет логику пп. 155–156. Как работает связка ППР и технологической карты, разобрано в справке про <a href="/spravochnik/ppr-ili-tehnologicheskaya-karta-avtokran-fnp-461/" style="color:var(--yellow)">ППР и ТК при работе автокрана</a>.</p>

    <h2 id="tablica" style="margin:36px 0 16px">Пять условий объекта и что сверить в паспорте</h2>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Условие объекта</th><th>Что сверить</th><th>Основание</th></tr></thead>
        <tbody>
          <tr><td>Масса и вылет самого тяжёлого подъёма</td><td>Грузовая характеристика: допустимая масса на нужном вылете и с нужной длиной стрелы</td><td>п. 155, п. 156 «а»</td></tr>
          <tr><td>Высота подъёма</td><td>Высота подъёма крюка при выбранной стреле и вылете, с запасом на длину стропов</td><td>п. 155, п. 156 «к»</td></tr>
          <tr><td>Ветер</td><td>Паспортное значение предельной скорости ветра и ветровой регион, на который рассчитан кран</td><td>п. 251 «м», п. 132</td></tr>
          <tr><td>Температура</td><td>Климатическое исполнение и допустимый температурный диапазон работы</td><td>п. 251 «м», п. 132</td></tr>
          <tr><td>Технологический процесс</td><td>Разрешена ли операция в руководстве по эксплуатации: подъём людей, совместная работа с другим краном, работа с грейфером</td><td>п. 251 «л», п. 127</td></tr>
        </tbody>
      </table>
    </div>
    <p>Таблица собрана по пунктам ФНП №461 и показывает, что каждое условие объекта имеет свой параметр в документах крана. В ФНП нет числовых значений для московского региона: ветровой район и расчётные температуры определяются другими нормативами и проектом, поэтому в справке они не приводятся и не заменяют значения из проекта конкретного объекта.</p>

    <h2 id="zima-veter" style="margin:36px 0 16px">Зимняя температура и ветер: два самых частых расхождения</h2>
    <p>Чаще всего несоответствие всплывает зимой и при подъёме на высоту, потому что именно там ограничения паспорта сжимаются. Работы на открытом воздухе прекращают при температуре ниже предельно допустимой, указанной в паспорте (п. 132 ФНП №461), поэтому зимой сверяют нижнюю границу температурного диапазона крана с прогнозом на дату подъёма. Практику такой работы МОСКРАН-СЕРВИС описал в справке про <a href="/spravochnik/rabota-krana-zimoy/" style="color:var(--yellow)">работу крана зимой</a>.</p>
    <p>Ветер ограничивает подъёмы раньше, чем любой другой фактор: работы подъёмных сооружений на открытом воздухе прекращают при скорости ветра выше предельно допустимой по паспорту (п. 132 ФНП №461). Для груза с большой парусностью — витражей, стеновых панелей, перегородок — ветровую нагрузку нужно оценивать отдельно: такие работы относят к местам действия опасных факторов и ведут по ППР (п. 163), см. справку про <a href="/spravochnik/rabota-krana-pri-silnom-vetre/" style="color:var(--yellow)">работу крана при сильном ветре</a>.</p>

    <h2 id="zayavka" style="margin:36px 0 16px">Что указать в заявке, чтобы кран подошёл</h2>
    <p>В заявке на аренду автокрана у МОСКРАН-СЕРВИС достаточно пяти строк: масса и габариты самого тяжёлого груза, вылет и высота подъёма, период работ с датами, адрес и условия подъезда, особые условия (подъём у стены, под линией электропередачи). Этот перечень — практика службы подбора, а не требование нормы, но он закрывает все пять параметров таблицы выше.</p>
    <ol>
      <li>Опишите самый тяжёлый и самый дальний подъём: масса, вылет, высота.</li>
      <li>Укажите даты работ, чтобы сопоставить их с зимним и ветровым ограничением.</li>
      <li>Сообщите, есть ли ППР или технологическая карта и кто за них отвечает.</li>
      <li>Попросите копию паспорта выбранного крана и проверьте в ней климатическое исполнение и предельный ветер.</li>
    </ol>
    <p>Минимальные расстояния до зданий, кромки котлована и линий электропередачи — отдельный вопрос; они собраны в справке про <a href="/spravochnik/minimalnye-rasstoyaniya-pri-rabote-avtokrana-fnp-461/" style="color:var(--yellow)">минимальные расстояния при работе автокрана</a>.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: автокран под условия объекта</h2>
    <ul>
      <li>Кран, не соответствующий температуре, ветровому региону или сейсмичности района, не допускают к работе (п. 251 «м» ФНП №461).</li>
      <li>Соответствие грузоподъёмности, высоте, вылету и ветровой нагрузке закладывают в ПОС или ППР (пп. 155–156).</li>
      <li>Работы на открытом воздухе прекращают при ветре выше паспортного значения (п. 132).</li>
      <li>Числа для конкретного объекта берут из паспорта крана и проекта, а не из справки.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://www.consultant.ru/document/cons_doc_LAW_373321/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 (приказ Ростехнадзора от 26.11.2020 №461)</a> — пп. 127, 132, 155, 156, 163, 251.</li>
      <li><a href="https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 на legalacts.ru</a> — текст пунктов сверен 28.10.2026.</li>
    </ul>
    <p class="small muted">Справка не заменяет паспорт и руководство по эксплуатации конкретного автокрана и проект производства работ на объекте.</p>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-25-40-tonn/">Аренда автокрана 25–40 тонн →</a></section>
</main>
</SpravochnikLayout>
