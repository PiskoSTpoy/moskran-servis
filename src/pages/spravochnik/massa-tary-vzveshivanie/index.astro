---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';
import Sources from '../../../components/Sources.astro';

const title = 'Зачем взвешивают груз и тару перед подъёмом краном';
const description = 'Груз неизвестной массы поднимать нельзя — фактическая масса определяется взвешиванием. Разница массы брутто и нетто и почему это важно для крана.';

const CHECKED = '12.08.2026';

const faqs = [
  { q: 'Почему нельзя просто оценить вес груза на глаз?', a: 'Занижение фактического веса — частая причина, по которой кран на объекте оказывается недостаточным по грузоподъёмности уже по факту подъёма (мы упоминали это и в статье про грузовысотную характеристику). Перемещение грузов неизвестной массы должно производиться только после определения их фактической массы, а не приблизительной оценки.' },
  { q: 'Что такое масса брутто и нетто применительно к подъёму краном?', a: 'Масса брутто — это вес груза вместе с тарой (упаковкой, поддоном, контейнером), масса нетто — вес самого груза без тары. Для расчёта грузоподъёмности крана важна масса брутто — именно её реально поднимает крюк, включая вес упаковки.' },
  { q: 'Что делать, если груз состоит из нескольких видов тары?', a: 'При наличии нескольких видов упаковки нужно указывать вес каждой единицы тары отдельно — суммарный вес партии складывается из всех компонентов, а не оценивается по одному образцу.' },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Масса тары и взвешивание', item: 'https://moskran-servis.ru/spravochnik/massa-tary-vzveshivanie/' },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@id': 'https://moskran-servis.ru/#organization' }, // ссылка на единственный узел организации (BaseLayout): отдельный узел с тем же @id, но другим name, был противоречием в графе
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: 'https://moskran-servis.ru/spravochnik/massa-tary-vzveshivanie/',
  inLanguage: 'ru-RU',
  datePublished: '2026-08-12',
  dateModified: '2026-08-12',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<SpravochnikLayout title={title} description={description} path="/spravochnik/massa-tary-vzveshivanie/" slug="massa-tary-vzveshivanie" ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Масса тары и взвешивание</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Разбор для заказчика</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Масса тары и взвешивание груза перед подъёмом краном</h1>
    <p class="ref-byline">Инженерная служба МОСКРАН-СЕРВИС · обновлено в 2026 году</p>

    <p>На нескольких страницах сайта мы просим заказчиков указывать точный вес груза по накладной или паспорту изделия, а не «на глаз». Здесь разбираем, почему это принципиально и что означает масса тары в этом контексте.</p>

    <h2 style="margin:36px 0 16px">Груз неизвестной массы поднимать нельзя</h2>
    <p>Перемещение грузов неизвестной массы должно производиться только после определения их фактической массы — это не рекомендация, а требование безопасности. Запрещается поднимать груз, масса которого превышает грузоподъёмность крана или грузозахватного приспособления на данном вылете — а чтобы это проверить, нужно знать точный вес, а не приблизительную оценку.</p>

    <h2 style="margin:36px 0 16px">Масса брутто и нетто — в чём разница</h2>
    <p>Масса нетто — вес самого груза без упаковки. Масса брутто — вес груза вместе с тарой: поддоном, упаковкой, контейнером. Для расчёта грузоподъёмности крана важна именно масса брутто — крюк поднимает груз вместе со всей тарой, а не только «полезное содержимое». Ошибка, если заказчик называет вес нетто, думая, что это полный вес груза, — частая причина занижения фактической массы при заявке.</p>

    <h2 style="margin:36px 0 16px">Контрольное взвешивание</h2>
    <p>Перед выдачей груза перевозчику (в нашем случае — перед подъёмом краном) проводится контрольное взвешивание каждой партии или выборочно, в зависимости от типа груза, и оформляется акт взвешивания с подписью ответственного лица — это стандартная практика для грузов, вес которых не подтверждён однозначно паспортом изделия или накладной.</p>

    <h2 style="margin:36px 0 16px">Что делать при нескольких видах тары</h2>
    <p>Если партия состоит из разных видов упаковки, нужно указывать вес каждой единицы тары отдельно, а не оценивать суммарный вес по одному образцу — это особенно актуально для сборных грузов с разнородной упаковкой.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: что запомнить</h2>
    <ul>
      <li>Груз неизвестной массы поднимать нельзя — фактическая масса определяется до подъёма.</li>
      <li>Для расчёта грузоподъёмности крана важна масса брутто, а не нетто.</li>
      <li>При сомнении в весе — контрольное взвешивание с оформлением акта.</li>
      <li>При разных видах тары в одной партии — вес каждой единицы указывается отдельно.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <Sources
      checked={CHECKED}
      items={[
        { text: 'wwlogist.com — масса и вес брутто и нетто', href: 'https://wwlogist.com/chto-takoe-massa-i-ves-brutto-i-netto-polnyj-razbor.html' },
        { text: 'Правила по охране труда при погрузочно-разгрузочных работах и размещении грузов (приказ Минтруда России от 28.10.2020 №753н, ред. от 29.04.2025)', href: 'https://normativ.kontur.ru/document?moduleId=1&documentId=501427' }
      ]}
      note="Прежняя редакция этой страницы ссылалась на ПОТ РМ-007-98 — документ прекратил действие; статус разобран на странице /spravochnik/pot-rm-007-98/."
    />
  </article>
  <section class="section wrap"><a class="btn" href="/spravochnik/gruzovysotnaya-harakteristika/">Как это связано с грузовысотной характеристикой →</a></section>
</main>
</SpravochnikLayout>
