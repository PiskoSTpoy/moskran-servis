---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';
import Sources from '../../../components/Sources.astro';

const title = 'Налоги заказчика при аренде крана с оператором';
const description = 'Если крановщик оформлен как самозанятый, заказчик не выступает налоговым агентом и не удерживает НДФЛ. Разбираем разницу с наймом штатного крановщика.';

const CHECKED = '12.08.2026';

const faqs = [
  { q: 'Нужно ли заказчику удерживать НДФЛ при оплате аренды крана с самозанятым оператором?', a: 'Нет. Если крановщик зарегистрирован как плательщик налога на профессиональный доход (НПД), он платит налог самостоятельно по ставке 6% при получении дохода от юридических лиц, а заказывающая организация не выступает налоговым агентом и не удерживает и не перечисляет НДФЛ с этой оплаты.' },
  { q: 'Чем это отличается от найма крановщика в штат?', a: 'При штатном найме организация выступает налоговым агентом: удерживает НДФЛ с зарплаты и уплачивает страховые взносы, что увеличивает фактическую стоимость персонала сверх суммы, которую получает на руки сам крановщик. Аренда техники с самозанятым оператором переносит эти обязательства на самого исполнителя.' },
  { q: 'Какой документ подтверждает статус самозанятого оператора для заказчика?', a: 'Актуальный статус плательщика НПД можно проверить через сервис ФНС «Мой налог» или запросить у арендодателя чек, сформированный в приложении «Мой налог» — этот чек одновременно служит подтверждением уплаты налога исполнителем и основанием для учёта расходов у заказчика.' },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Аренда крана с оператором: налоги', item: 'https://moskran-servis.ru/spravochnik/arenda-s-operatorom-nalogi/' },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@id': 'https://moskran-servis.ru/#organization' }, // ссылка на единственный узел организации (BaseLayout): отдельный узел с тем же @id, но другим name, был противоречием в графе
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: 'https://moskran-servis.ru/spravochnik/arenda-s-operatorom-nalogi/',
  inLanguage: 'ru-RU',
  datePublished: '2026-08-12',
  dateModified: '2026-08-12',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<SpravochnikLayout title={title} description={description} path="/spravochnik/arenda-s-operatorom-nalogi/" slug="arenda-s-operatorom-nalogi" ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Аренда крана с оператором: налоги</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Разбор для заказчика</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Аренда крана с оператором: что с налогами у заказчика</h1>
    <p class="ref-byline">Инженерная служба МОСКРАН-СЕРВИС · обновлено в 2026 году</p>

    <p>Финансовая служба заказчика при работе с арендой спецтехники нередко задаёт один и тот же вопрос: нужно ли удерживать НДФЛ с оплаты, если техника арендуется вместе с оператором? Ответ зависит от того, как оформлен сам оператор.</p>

    <h2 style="margin:36px 0 16px">Оператор — самозанятый (плательщик НПД)</h2>
    <p>Если крановщик, предоставляемый вместе с техникой, зарегистрирован как плательщик налога на профессиональный доход, он самостоятельно платит налог по ставке 6% при получении оплаты от юридических лиц и индивидуальных предпринимателей. В этом случае заказывающая организация НЕ выступает налоговым агентом: не удерживает НДФЛ, не начисляет страховые взносы на эту часть оплаты — вся сумма договора идёт исполнителю, а налоговые обязательства лежат на нём.</p>
    <p>Подтверждением статуса и факта уплаты налога служит чек, сформированный в приложении «Мой налог» — этот же чек заказчик использует как основание для учёта расходов в своей отчётности.</p>

    <h2 style="margin:36px 0 16px">Оператор — штатный сотрудник арендодателя</h2>
    <p>Если техника предоставляется вместе со штатным крановщиком арендодателя, налоговые обязательства (НДФЛ, страховые взносы) лежат на работодателе крановщика — то есть на арендодателе техники, а не на заказчике, поскольку трудовые отношения существуют между крановщиком и арендодателем, а не между крановщиком и заказчиком услуги. Заказчик в этой схеме оплачивает услугу аренды техники с экипажем целиком, без разделения на «аренду техники» и «оплату труда оператора» в своём налоговом учёте.</p>

    <h2 style="margin:36px 0 16px">Что важно проверить заказчику перед оплатой</h2>
    <p>Практический совет: перед заключением договора уточните, как оформлен предоставляемый оператор, и запросите подтверждающий документ (чек НПД или данные о трудоустройстве у арендодателя) — это снимает вопросы при последующей налоговой проверке расходов на аренду спецтехники.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: что запомнить</h2>
    <ul>
      <li>Оператор-самозанятый платит НПД 6% сам, заказчик не удерживает НДФЛ и не является налоговым агентом.</li>
      <li>Оператор — штатный сотрудник арендодателя: НДФЛ и взносы платит арендодатель как работодатель.</li>
      <li>Подтверждение по самозанятому оператору — чек из приложения «Мой налог».</li>
      <li>Статус оператора стоит проверять и фиксировать документально до начала работ.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <Sources
      checked={CHECKED}
      items={[
        { text: 'npd.nalog.ru — специальный налоговый режим для самозанятых (ФНС России)', href: 'https://npd.nalog.ru/' },
        { text: 'e-kontur.ru — как самозанятому платить налог с аренды', href: 'https://e-kontur.ru/enquiry/1956/samozanyatym-kak-platit-nalog-s-arendy' }
      ]}
    />
  </article>
  <section class="section wrap"><a class="btn" href="/spravochnik/markirovka-negabarita-pri-transportirovke/">Маркировка при негабаритной перевозке крана →</a></section>
</main>
</SpravochnikLayout>
