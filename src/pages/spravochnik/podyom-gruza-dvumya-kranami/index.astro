---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = 'Подъём груза двумя кранами: что требует ФНП №461';
const description = 'Подъём груза двумя автокранами по п. 127 ФНП №461: ППР или ТК, руководство ответственного, расчёт долей нагрузки и цена в МОСКРАН-СЕРВИС.';

const CHECKED = '26.09.2026';
const PUBLISHED = '2026-09-26';
const SLUG = 'podyom-gruza-dvumya-kranami';
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: 'Можно ли поднять груз двумя кранами без ППР?',
    a: 'Нельзя. Пункт 127 ФНП №461 разрешает подъём и перемещение груза несколькими подъёмными сооружениями только по проекту производства работ или технологической карте. МОСКРАН-СЕРВИС не выводит два крана на совместный подъём, пока на площадке нет утверждённого ППР или ТК с этой операцией.',
  },
  {
    q: 'Кто руководит подъёмом груза двумя кранами?',
    a: 'По п. 127 ФНП №461 такой работой непосредственно руководит инженерно-технический работник, ответственный за безопасное производство работ с применением подъёмных сооружений. Крановщики МОСКРАН-СЕРВИС выполняют команды этого специалиста, а не стропальщика или прораба смежной бригады.',
  },
  {
    q: 'Как распределяется масса груза между двумя кранами?',
    a: 'Масса делится обратно пропорционально расстояниям от центра тяжести до точек строповки: чем ближе кран к центру тяжести, тем больше он несёт. Балка 12 т длиной 10 м с центром тяжести в 4 м от одного конца нагрузит ближний кран на 7,2 т, дальний на 4,8 т. МОСКРАН-СЕРВИС сверяет каждую долю с таблицей своего крана.',
  },
  {
    q: 'Что дешевле: два крана по 25 т или один на 50 т?',
    a: 'По ставкам МОСКРАН-СЕРВИС две смены кранов 25 т стоят 41 600 ₽, одна смена крана 50 т — 31 200 ₽. Один более мощный кран обычно дешевле и не требует отдельной схемы в ППР. Тандем оправдан, когда одному крану не хватает места, досягаемости или грузоподъёмности.',
  },
  {
    q: 'Нужен ли наряд-допуск на подъём двумя кранами?',
    a: 'Пункт 127 ФНП №461 требует для такой работы ППР или ТК и руководство ответственного специалиста, но наряд-допуск в нём не упомянут. Наряд-допуск обязателен в других случаях, например при работе ближе 30 м от ЛЭП по п. 112. Если объект вводит наряд-допуск своим порядком, МОСКРАН-СЕРВИС работает по нему.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Подъём груза двумя кранами', item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ['norma', 'Что говорит п. 127 ФНП №461'],
  ['nagruzka', 'Как распределяется нагрузка между кранами'],
  ['ppr', 'Что должно быть в ППР на тандемный подъём'],
  ['moskva', 'Два крана на московской площадке'],
  ['cena', 'Два крана или один покрупнее: цена'],
  ['faq', 'Частые вопросы'],
  ['istochniki', 'Источники'],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Подъём груза двумя кранами</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">ФНП №461 · Организация работ</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Можно ли поднимать груз двумя кранами и что для этого нужно?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>26.09.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>26.09.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>7 мин чтения</span>
    </div>

    <p>Подъём груза двумя кранами разрешён пунктом 127 ФНП №461 при трёх условиях: работа идёт только по ППР или технологической карте, нагрузка на каждый кран не превышает его грузоподъёмность, а руководит подъёмом ответственный за безопасное производство работ. МОСКРАН-СЕРВИС выводит два автокрана на совместный подъём только при выполнении всех трёх условий.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="norma" style="margin:36px 0 16px">Что говорит п. 127 ФНП №461</h2>
    <p>Пункт 127 ФНП №461 содержит два положения о подъёме несколькими кранами: такая работа разрешается только по ППР или ТК, а нагрузка на каждый кран не должна превышать его грузоподъёмность. Тот же пункт относит перемещение груза несколькими подъёмными сооружениями к работам под непосредственным руководством инженерно-технического работника, ответственного за безопасное производство работ. МОСКРАН-СЕРВИС считает эти требования обязательным минимумом для любого тандема.</p>
    <p>В одном ряду с тандемом п. 127 ФНП №461 называет ещё две работы с тем же руководством: погрузку и разгрузку полувагонов и подъём груза без маркировки массы или без схемы строповки. Общий признак у них один — повышенная неопределённость нагрузки. Кто такой ответственный за безопасное производство работ и чем он отличается от прораба, МОСКРАН-СЕРВИС разобрал в <a href="/spravochnik/otvetstvennyy-za-bezopasnoe-proizvodstvo/" style="color:var(--yellow)">отдельном материале</a>.</p>

    <h2 id="nagruzka" style="margin:36px 0 16px">Как распределяется нагрузка между кранами</h2>
    <p>Балка 12 т с центром тяжести в 4 м от одного конца нагрузит ближний кран на 7,2 тонны, а дальний — на 4,8 тонны. Масса делится обратно пропорционально расстояниям до точек строповки, как на рычаге. При длине балки 10 м и центре тяжести в 4 м от конца А расчёт такой: кран у конца А несёт 12 × 6 / 10 = 7,2 т, кран у конца Б — 12 × 4 / 10 = 4,8 т. Инженеры МОСКРАН-СЕРВИС сверяют каждую долю с грузовой таблицей своего крана на его вылете.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Положение центра тяжести (балка 12 т, 10 м)</th><th>Кран у конца А</th><th>Кран у конца Б</th></tr></thead>
        <tbody>
          <tr><td>Посередине, 5 м от каждого конца</td><td>6,0 т</td><td>6,0 т</td></tr>
          <tr><td>4 м от конца А</td><td>7,2 т</td><td>4,8 т</td></tr>
          <tr><td>3 м от конца А</td><td>8,4 т</td><td>3,6 т</td></tr>
        </tbody>
      </table>
    </div>
    <p>Расчёт по рычагу верен, пока груз висит горизонтально и оба крана поднимают синхронно. Если один крановщик поднимет свой конец раньше, груз наклонится и доли сместятся, поэтому в ППР задают последовательность команд и скорость подъёма. К доле каждого крана МОСКРАН-СЕРВИС прибавляет массу стропов и траверсы на этом крюке — она тоже входит в нагрузку по п. 127 ФНП №461.</p>

    <h2 id="ppr" style="margin:36px 0 16px">Что должно быть в ППР на тандемный подъём</h2>
    <p>ППР на подъём двумя кранами — это проект, по которому п. 127 ФНП №461 вообще допускает такую работу, и без него МОСКРАН-СЕРВИС совместный подъём не начинает. Кроме общего содержания ППР по п. 156 ФНП №461, для тандема в проекте нужны места установки обоих кранов, их вылеты, доли нагрузки с учётом стропов и схема строповки. По п. 155 ФНП №461 ППР должен обеспечивать безопасность нескольких кранов, одновременно работающих на площадке.</p>
    <p>На практике МОСКРАН-СЕРВИС просит в ППР или ТК ещё три вещи: кто подаёт команды обоим крановщикам, в каком порядке краны поднимают и поворачивают груз и где стоят стропальщики. ППР обычно готовит сторона, организующая работы на объекте, или её проектировщик; МОСКРАН-СЕРВИС передаёт для него паспортные грузовые характеристики машин. Общие требования к проекту описаны в <a href="/spravochnik/ppr-dlya-krana/" style="color:var(--yellow)">материале о ППР для крана</a>.</p>

    <h2 id="moskva" style="margin:36px 0 16px">Два крана на московской площадке</h2>
    <p>Два автокрана на одной московской площадке требуют двух подготовленных мест установки по п. 108 ФНП №461. По п. 109 между поворотной частью каждого крана и строениями оставляют не менее 1 м. Во дворе или на узкой улице центра Москвы это часто главный ограничитель тандема. МОСКРАН-СЕРВИС проверяет схему площадки для обоих кранов до выезда.</p>
    <p>Каждому из двух кранов МОСКРАН-СЕРВИС нужен собственный пропуск для въезда в зону МКАД, а если опоры встают на проезжую часть — согласование перекрытия. Порядок разобран в материалах <a href="/spravochnik/propusk-avtokrana-v-moskvu/" style="color:var(--yellow)">о пропуске автокрана в Москву</a> и <a href="/spravochnik/soglasovanie-perekrytiya-proezda/" style="color:var(--yellow)">о согласовании перекрытия проезда</a>. Сроки выдачи таких документов зависят от органа власти, поэтому дату тандемного подъёма планируют с запасом.</p>

    <h2 id="cena" style="margin:36px 0 16px">Два крана или один покрупнее: цена</h2>
    <p>Смена двух автокранов 25 т в МОСКРАН-СЕРВИС стоит 2 × 20 800 = 41 600 ₽, а смена одного крана 50 т — 31 200 ₽, на 10 400 ₽ меньше. Один кран к тому же не требует расчёта долей нагрузки и отдельной схемы совместной работы в ППР. Поэтому МОСКРАН-СЕРВИС сначала проверяет, закрывает ли задачу один кран большего класса.</p>
    <p>Тандем оправдан в трёх случаях: длинный груз нужно развернуть или кантовать в воздухе, одному крану не хватает досягаемости через препятствие, или для крана нужного класса нет места на площадке. В МОСКРАН-СЕРВИС для таких задач подбирают пару машин из парка с запасом по таблице у каждой. Сравнение одиночных кранов разных классов — в <a href="/spravochnik/avtokran-25-ili-50-tonn/" style="color:var(--yellow)">материале «Автокран 25 или 50 тонн»</a>.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: подъём двумя кранами</h2>
    <ul>
      <li>Только по ППР или ТК — п. 127 ФНП №461.</li>
      <li>Доля каждого крана — не больше его грузоподъёмности.</li>
      <li>Руководит ответственный за безопасное производство работ.</li>
      <li>Доли считают по рычагу, плюс стропы и траверса.</li>
      <li>Один кран 50 т дешевле двух по 25 т на 10 400 ₽.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://www.consultant.ru/document/cons_doc_LAW_373321/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 (приказ Ростехнадзора от 26.11.2020 №461)</a> — п. 127: подъём груза несколькими ПС; п. 108, 109: установка крана; п. 112: наряд-допуск у ЛЭП.</li>
      <li><a href="https://www.consultant.ru/document/cons_doc_LAW_373321/b02d4af13572b56144dfdaeb1a0c6abd29bfbe5e/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461, требования к ППР и ТК с применением ПС</a> — п. 155, 156.</li>
      <li><a href="/" style="color:var(--yellow)">Ставки МОСКРАН-СЕРВИС</a> — главная страница сайта, действуют до 17.02.2027.</li>
    </ul>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-40-50-tonn/">Подробнее об аренде автокрана 40–50 тонн →</a></section>
</main>
</SpravochnikLayout>
