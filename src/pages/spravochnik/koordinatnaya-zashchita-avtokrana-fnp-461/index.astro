---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = 'Координатная защита автокрана: п. 133 ФНП №461';
const description = 'Автокран без координатной защиты нельзя применять в стеснённых условиях (п. 133 ФНП №461); защиту настраивают по ППР или ТК. Что проверить до выезда.';

const CHECKED = '12.10.2026';
const PUBLISHED = '2026-10-12';
const SLUG = 'koordinatnaya-zashchita-avtokrana-fnp-461';
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: 'Что такое стеснённые условия по ФНП №461?',
    a: 'Пункт 98 ФНП №461 описывает их как условия, при которых требуется ограничение зоны перемещения подъёмного сооружения и грузов: работы над действующими коммуникациями, над проезжей частью улиц и подобные. Метров или процентов норма не задаёт, поэтому граница определяется в ППР конкретного объекта. МОСКРАН-СЕРВИС просит заказчика назвать эти условия в заявке.',
  },
  {
    q: 'Обязана ли у любого автокрана быть координатная защита?',
    a: 'Нет. Пункт 133 ФНП №461 запрещает применять в стеснённых условиях только краны на автомобильных шасси, не оборудованные координатной защитой. Для работы на открытой площадке без ограничения зоны норма наличия защиты не требует. Оснащение конкретной машины видно по паспорту и руководству по эксплуатации.',
  },
  {
    q: 'Кто настраивает координатную защиту?',
    a: 'Настройку ведут по ППР или ТК: п. 133 ФНП №461 прямо требует, чтобы защита соответствовала проекту производства работ. Границы зоны берутся из схемы в ППР, а не со слов заказчика на площадке. МОСКРАН-СЕРВИС просит ППР до выезда крана и ставит границы по нему.',
  },
  {
    q: 'Заменяет ли ограничитель грузоподъёмности координатную защиту?',
    a: 'Нет. Ограничитель грузоподъёмности защищает от перегруза, а координатная защита — от выхода стрелы или груза за границы зоны. В перечне п. 259 ФНП №461 это отдельные позиции: «б» и «ж». Наличие одного прибора не отменяет требования ко второму.',
  },
  {
    q: 'Можно ли использовать приборы безопасности для взвешивания груза?',
    a: 'Нет. Пункт 134 ФНП №461 запрещает использовать ограничители, указатели и регистраторы для учёта веса перемещаемых грузов. Показание прибора служит защитой крана, а не весами, поэтому МОСКРАН-СЕРВИС просит у заказчика массу груза из документов, а не «по прибору».',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Координатная защита автокрана по ФНП №461', item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ['norma', 'Что требует п. 133 ФНП №461'],
  ['stesnennye', 'Что норма считает стеснёнными условиями'],
  ['ppr', 'Где координатная защита записана в ППР'],
  ['ne-zamenyaet', 'Что координатная защита не заменяет'],
  ['proverka', 'Как проверяют работоспособность защиты'],
  ['moskva', 'Московская площадка: что сообщить до выезда'],
  ['faq', 'Частые вопросы'],
  ['istochniki', 'Источники'],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Координатная защита автокрана по ФНП №461</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">ФНП №461 · Приборы безопасности</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Нужна ли автокрану координатная защита в стеснённых условиях?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>12.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>12.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>6 мин чтения</span>
    </div>

    <p>Да: пункт 133 ФНП №461 запрещает применять краны на автомобильных шасси без координатной защиты там, где работа идёт в стеснённых условиях, а саму защиту требует настраивать по ППР или технологической карте. МОСКРАН-СЕРВИС до выезда сверяет по паспорту машины, есть ли такая защита, и просит у заказчика ППР с границами зоны.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="norma" style="margin:36px 0 16px">Что требует п. 133 ФНП №461</h2>
    <p>Пункт 133 ФНП №461 адресован башенным кранам, кранам на автомобильных и специальных шасси автомобильного типа, а также кранам на пневмоколёсном и гусеничном ходу. Если у такого крана нет координатной защиты, применять его для работы в стеснённых условиях запрещено, а имеющаяся защита должна быть настроена в соответствии с ППР или ТК. МОСКРАН-СЕРВИС читает пункт как два условия: прибор есть и его границы заданы проектом.</p>
    <p>Само определение координатной защиты ФНП №461 не даёт; по смыслу пунктов 133 и 159 это прибор, который ограничивает зону перемещения подъёмного сооружения и груза границами, заданными при настройке. Для автокрана на шасси КамАЗ или Урал, например КС-55713 «Клинцы» или КС-35714 «Ивановец», наличие такой защиты определяет комплектация конкретной машины, а не класс тоннажа.</p>

    <h2 id="stesnennye" style="margin:36px 0 16px">Что норма считает стеснёнными условиями</h2>
    <p>Пункт 98 ФНП №461 называет стеснёнными такие условия, при которых требуется ограничение зоны перемещения подъёмного сооружения и грузов, и ставит рядом работы над действующими коммуникациями и над проезжей частью улиц. Такие работы должны вестись по ППР, разработанному по пунктам 155–163. Числового критерия — «не ближе стольких метров» — в пункте нет, и МОСКРАН-СЕРВИС его не придумывает.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Условие на площадке</th><th>Что требует норма</th><th>Пункт</th></tr></thead>
        <tbody>
          <tr><td>Работа над проезжей частью</td><td>ППР по п. 155–163</td><td>98</td></tr>
          <tr><td>Работа над действующими коммуникациями</td><td>ППР по п. 155–163</td><td>98</td></tr>
          <tr><td>Нужно ограничить зону груза</td><td>ППР и координатная защита</td><td>98, 133</td></tr>
          <tr><td>Кран на автошасси без защиты</td><td>применять запрещено</td><td>133</td></tr>
        </tbody>
      </table>
    </div>
    <p>Практическое различие простое: двор с открытой стороной — обычная площадка, а подъём над улицей или рядом с действующей трассой коммуникаций — стеснённые условия. Согласование перекрытия проезда для опор разобрано в материале о <a href="/spravochnik/soglasovanie-perekrytiya-proezda/" style="color:var(--yellow)">согласовании перекрытия проезда</a>, а работа возле сетей — в материалах о <a href="/spravochnik/rabota-krana-ryadom-s-gazoprovodom/" style="color:var(--yellow)">газопроводе</a> и <a href="/spravochnik/rabota-krana-ryadom-s-teplotrassoy/" style="color:var(--yellow)">теплотрассе</a>.</p>

    <h2 id="ppr" style="margin:36px 0 16px">Где координатная защита записана в ППР</h2>
    <p>Пункт 159 ФНП №461 требует включить в ППР и ТК раздел об организации безопасного производства работ, где подпункт «б» описывает условия применения координатной защиты работы подъёмного сооружения при её наличии на машине. Рядом в том же разделе стоят условия совместной работы двух и более кранов и условия совместного подъёма. МОСКРАН-СЕРВИС считает отсутствие этого подпункта в ППР основанием запросить правку до выезда.</p>
    <p>Ознакомление с ППР — отдельная обязанность: пункт 158 требует, чтобы ответственные инженерно-технические работники, крановщики и стропальщики были ознакомлены с проектом под подпись до начала работ. Крановщик МОСКРАН-СЕРВИС, не видевший схемы с границами зоны, к подъёму не приступает. Что должно быть в самом проекте, разобрано в материале о <a href="/spravochnik/ppr-dlya-krana/" style="color:var(--yellow)">ППР для крана</a>.</p>

    <h2 id="ne-zamenyaet" style="margin:36px 0 16px">Что координатная защита не заменяет</h2>
    <p>Координатная защита не заменяет ограничитель грузоподъёмности: в перечне пункта 259 ФНП №461 это разные позиции — «б» для ограничителя грузоподъёмности и грузового момента и «ж» для координатной защиты. Первый не даёт поднять груз тяжелее допустимого на данном вылете, вторая не даёт вывести груз или стрелу за заданную границу. МОСКРАН-СЕРВИС проверяет оба прибора независимо друг от друга.</p>
    <p>Приборы нельзя использовать и как весы: пункт 134 запрещает применять ограничители, указатели и регистраторы для учёта веса перемещаемых грузов. Показание прибора — не документ на груз, а сигнал защиты крана. Массу груза МОСКРАН-СЕРВИС берёт из накладной, паспорта изделия или маркировки; как это делают на практике, описано в материале о <a href="/spravochnik/massa-tary-vzveshivanie/" style="color:var(--yellow)">массе тары и взвешивании</a>, а принцип работы ограничителя — в материале об <a href="/spravochnik/ogranichitel-gruzopodemnosti/" style="color:var(--yellow)">ограничителе грузоподъёмности</a>.</p>

    <h2 id="proverka" style="margin:36px 0 16px">Как проверяют работоспособность защиты</h2>
    <p>Пункт 259 ФНП №461 включает координатную защиту в список приборов, работоспособность и соответствие документации изготовителя которых проверяют при техническом диагностировании подъёмного сооружения, — подпункт «ж». Значит, прибор не «декоративный»: его состояние отражается в заключении по диагностированию. МОСКРАН-СЕРВИС ориентируется на запись в паспорте и руководство по эксплуатации конкретной машины.</p>
    <p>Для заказчика полезны три вопроса к исполнителю до выезда: есть ли координатная защита на этой машине, указана ли она в паспорте или руководстве и кто настроит границы по вашему ППР. Если машина без защиты, а площадка стеснённая, пункт 133 прямо запрещает такую работу. Порядок освидетельствования и диагностирования описан в материале о <a href="/spravochnik/tehnicheskoe-diagnostirovanie/" style="color:var(--yellow)">техническом диагностировании крана</a>.</p>

    <h2 id="moskva" style="margin:36px 0 16px">Московская площадка: что сообщить до выезда</h2>
    <p>Для Москвы стеснённые условия — не исключение, а обычная ситуация: узкие дворы, подъём над тротуаром, соседство коммуникаций и действующей трассы. МОСКРАН-СЕРВИС просит в заявке четыре сведения: где стрела пойдёт над проезжей частью или сетями, есть ли утверждённый ППР, какая граница зоны задана и кто ответственный за безопасное производство работ. Эти сведения определяют, нужна ли машина с защитой.</p>
    <p>Если ППР ещё нет, заявка не откладывается автоматически: МОСКРАН-СЕРВИС передаёт паспортные характеристики машин проектировщику, а подъём начинается после утверждения проекта. Состав сведений для заявки приведён в материале о <a href="/spravochnik/zayavka-na-avtokran/" style="color:var(--yellow)">заявке на автокран</a>, а ответственность за площадку — в материале об <a href="/spravochnik/otvetstvennyy-za-bezopasnoe-proizvodstvo/" style="color:var(--yellow)">ответственном за безопасное производство работ</a>.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: координатная защита автокрана</h2>
    <ul>
      <li>Автокран без координатной защиты МОСКРАН-СЕРВИС не ставит в стеснённые условия (п. 133 ФНП №461).</li>
      <li>Границы зоны защиты МОСКРАН-СЕРВИС берёт из ППР или ТК, а не со слов на площадке (п. 133, 159 «б»).</li>
      <li>Стеснённые условия по п. 98 — работа над проезжей частью, над действующими коммуникациями.</li>
      <li>Ограничитель грузоподъёмности и координатная защита — разные приборы, п. 259 «б» и «ж».</li>
      <li>Прибор безопасности МОСКРАН-СЕРВИС не использует как весы для груза (п. 134).</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://www.consultant.ru/document/cons_doc_LAW_373321/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 (приказ Ростехнадзора от 26.11.2020 №461)</a> — п. 98 (стеснённые условия, ППР), п. 133 (координатная защита), п. 134 (приборы и учёт веса), п. 158 (ознакомление с ППР), п. 159 «б» (условия применения координатной защиты), п. 259 «б» и «ж» (проверка приборов при диагностировании).</li>
      <li><a href="https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 на legalacts.ru</a> — редакция от 16.04.2026, текст пунктов 98, 133, 134, 158, 159 и 259 сверен 12.10.2026.</li>
    </ul>
    <p class="small muted">Определение координатной защиты и перечень машин парка с этим прибором в тексте нормы отсутствуют: наличие и настройку защиты определяют паспорт и руководство по эксплуатации конкретной машины. Перечень сведений для заявки — практика МОСКРАН-СЕРВИС.</p>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-16-25-tonn/">Аренда автокрана 16–25 тонн →</a></section>
</main>
</SpravochnikLayout>
