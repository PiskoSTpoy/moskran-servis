---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';
import Sources from '../../../components/Sources.astro';

const title = 'Виды технического освидетельствования крана';
const description = 'ЧТО раз в год, ПТО раз в 3 года: что проверяют при техническом освидетельствовании крана по ФНП №461 и зачем заказчику знать об этом при выборе подрядчика.';

const CHECKED = '12.08.2026';

const faqs = [
  { q: 'Чем частичное освидетельствование отличается от полного?', a: 'Частичное (ЧТО) — это визуальный осмотр без нагрузочных испытаний, проводится не реже раза в 12 месяцев. Полное (ПТО) включает визуальный осмотр плюс статические и динамические испытания грузоподъёмных механизмов под нагрузкой, проводится не реже раза в 3 года.' },
  { q: 'Как узнать, что кран, который мне предлагают, прошёл освидетельствование вовремя?', a: 'Попросите у подрядчика документ о последнем освидетельствовании конкретной единицы техники — дата и тип (ЧТО или ПТО) должны быть указаны прямо. Если подрядчик не может предоставить этот документ по первому запросу — это повод насторожиться.' },
  { q: 'Что будет, если кран работает с просроченным освидетельствованием?', a: 'Эксплуатация технически неосвидетельствованного вовремя крана — прямое нарушение требований промышленной безопасности с риском для оператора, бригады и окружающих: освидетельствование не формальность, а проверка того, что кран физически безопасен для работы под нагрузкой.' },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Техническое освидетельствование', item: 'https://moskran-servis.ru/spravochnik/tehnicheskoe-osvidetelstvovanie-krana/' },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@id': 'https://moskran-servis.ru/#organization' }, // ссылка на единственный узел организации (BaseLayout): отдельный узел с тем же @id, но другим name, был противоречием в графе
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: 'https://moskran-servis.ru/spravochnik/tehnicheskoe-osvidetelstvovanie-krana/',
  inLanguage: 'ru-RU',
  datePublished: '2026-08-12',
  dateModified: '2026-08-12',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<SpravochnikLayout title={title} description={description} path="/spravochnik/tehnicheskoe-osvidetelstvovanie-krana/" slug="tehnicheskoe-osvidetelstvovanie-krana" ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Техническое освидетельствование</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Разбор для заказчика</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Техническое освидетельствование крана: частичное и полное — в чём разница</h1>
    <p class="ref-byline">Инженерная служба МОСКРАН-СЕРВИС · обновлено в 2026 году</p>

    <p>Мы уже упоминали на других страницах сайта, что предоставляем документ о техническом освидетельствовании техники вместе с договором. Здесь разбираем подробно, что это за процедура и почему её периодичность — не формальность, а прямая гарантия того, что кран физически безопасен для работы под нагрузкой.</p>

    <h2 style="margin:36px 0 16px">Что такое техническое освидетельствование</h2>
    <p>Техническое освидетельствование — регулярная проверка грузоподъёмного крана как опасного производственного объекта, требование Федеральных норм и правил промышленной безопасности (ФНП №461, ранее аналогичные требования были в ФНП №533). Проверка проводится специалистом эксплуатирующей организации или привлечённым экспертом и фиксируется документально — это не разовая процедура при покупке техники, а регулярный цикл на весь срок эксплуатации крана.</p>

    <h2 style="margin:36px 0 16px">Частичное освидетельствование (ЧТО) — не реже раза в год</h2>
    <p>Частичное техническое освидетельствование включает визуальный осмотр металлоконструкции, механизмов, приборов безопасности и текущей документации крана — без нагрузочных испытаний. Проводится не реже одного раза в 12 месяцев. Цель — выявить видимые дефекты (трещины, деформации, износ узлов), не дожидаясь более серьёзной проверки.</p>

    <h2 style="margin:36px 0 16px">Полное освидетельствование (ПТО) — не реже раза в 3 года</h2>
    <p>Полное техническое освидетельствование включает всё то же, что и частичное, плюс статические испытания (нагрузка, превышающая паспортную грузоподъёмность на фиксированный процент, для проверки прочности конструкции без разрушения) и динамические испытания механизмов (проверка работы под нагрузкой в движении). Проводится не реже одного раза в 3 года — реже, чем частичное, но с существенно более глубокой проверкой.</p>

    <h2 style="margin:36px 0 16px">Почему это важно для заказчика, а не только для владельца техники</h2>
    <p>Формально ответственность за своевременное освидетельствование лежит на эксплуатирующей организации — то есть на нас, а не на заказчике аренды крана. Но для заказчика это прямой индикатор добросовестности подрядчика: если компания не может по первому запросу предоставить документ о последнем освидетельствовании конкретной единицы техники с указанием даты и типа проверки — это повод усомниться в порядке дел с остальной документацией тоже.</p>

    <h2 style="margin:36px 0 16px">Как это соотносится с экспертизой промышленной безопасности</h2>
    <p>Техническое освидетельствование — не то же самое, что экспертиза промышленной безопасности (ЭПБ), которая проводится реже и в других случаях (истечение нормативного срока службы крана, после аварии, при обнаружении серьёзных дефектов) специализированной экспертной организацией с получением заключения, вносимого в реестр Ростехнадзора. Освидетельствование — регулярная плановая проверка на протяжении всего срока службы; ЭПБ — более редкая и глубокая процедура на конкретных этапах жизненного цикла техники.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: что запомнить</h2>
    <ul>
      <li>ЧТО (частичное) — визуальный осмотр, не реже раза в 12 месяцев.</li>
      <li>ПТО (полное) — осмотр плюс статические и динамические испытания под нагрузкой, не реже раза в 3 года.</li>
      <li>Требование установлено ФНП №461 — тем же документом, который заменил отменённые ПБ 10-382-00 (см. отдельный разбор справочника).</li>
      <li>Документ о последнем освидетельствовании — то, что добросовестный подрядчик предоставляет по первому запросу заказчика.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <Sources
      checked={CHECKED}
      items={[
        { text: 'ntcexpert.ru — техническое освидетельствование кранов', href: 'https://ntcexpert.ru/services/tekhnicheskoe_osvidetelstvovanie/tekhnicheskoe_osvidetelstvovanie_kranov/' },
        { text: 'vsetrts.ru — порядок технического освидетельствования крана', href: 'https://vsetrts.ru/article/tehnicheskoe-osvidetelstvovanie-krana' }
      ]}
    />
  </article>
  <section class="section wrap"><a class="btn" href="/documents/">Что ещё входит в комплект документов →</a></section>
</main>
</SpravochnikLayout>
