---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';
import Sources from '../../../components/Sources.astro';

const title = 'Нормы освещённости площадки для работы крана в темноте';
const description = 'Основные рабочие зоны — от 50 люкс, зоны повышенной опасности — от 75 люкс, подъездные пути — 10–20 люкс. Требования к освещению для работы крана.';

const CHECKED = '21.08.2026';

const faqs = [
  { q: 'Можно ли работать краном в темноте без дополнительного освещения?', a: 'Нет, работа в условиях недостаточной освещённости — прямое нарушение требований безопасности: оператор должен видеть точку подъёма, зону перемещения груза и людей вокруг. Без соответствия нормам освещённости работы в тёмное время суток не проводятся.' },
  { q: 'Кто обеспечивает освещение площадки — мы или заказчик?', a: 'Как правило, освещение строительной площадки в целом — зона ответственности генподрядчика или заказчика объекта, а не подрядчика по крану. Мы уточняем на этапе заявки, если работы планируются в тёмное время суток или с коротким световым днём (актуально для зимнего периода), чтобы убедиться, что освещение объекта соответствует нормам.' },
  { q: 'Почему для зон повышенной опасности требования выше?', a: 'Потому что там выше цена ошибки при недостаточной видимости — например, зона перемещения груза краном или места с риском падения с высоты требуют освещённости не менее 75 люкс, тогда как для дорог и подъездных путей достаточно 10–20 люкс.' },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Освещённость площадки', item: 'https://moskran-servis.ru/spravochnik/osveshchenie-ploshchadki/' },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@id': 'https://moskran-servis.ru/#organization' }, // ссылка на единственный узел организации (BaseLayout): отдельный узел с тем же @id, но другим name, был противоречием в графе
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: 'https://moskran-servis.ru/spravochnik/osveshchenie-ploshchadki/',
  inLanguage: 'ru-RU',
  datePublished: '2026-08-12',
  dateModified: '2026-08-21',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<SpravochnikLayout title={title} description={description} path="/spravochnik/osveshchenie-ploshchadki/" slug="osveshchenie-ploshchadki" ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Освещённость площадки</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Разбор для заказчика</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Освещённость площадки для работы крана в тёмное время суток — нормы</h1>
    <p class="ref-byline">Инженерная служба МОСКРАН-СЕРВИС · обновлено в 2026 году</p>

    <p>В статье про зимнюю работу крана мы упоминали короткий световой день как фактор, ограничивающий реальное окно для работ на открытых площадках. Здесь разбираем конкретные нормы освещённости, которые должны соблюдаться для безопасной работы в тёмное время суток.</p>

    <h2 style="margin:36px 0 16px">Базовые нормы освещённости</h2>
    <p>Для основных рабочих зон предусматривается освещённость от 50 люкс. Для складов и складских навесов — от 20 люкс. Для дорог и подъездных путей — 10–20 люкс. Для зон повышенной опасности — не менее 75 люкс. Разброс значений объясняется разной ценой ошибки при недостаточной видимости в каждой зоне: там, где идёт перемещение груза краном или есть риск падения с высоты, требования строже, чем на обычном подъездном пути.</p>

    <h2 style="margin:36px 0 16px">Что говорит сам стандарт</h2>
    <p>Общие «зоны» удобны для прикидки, но нормируются не зоны, а виды работ — таблицей ГОСТ 12.1.046-2014 «Строительство. Нормы освещения строительных площадок». Для крановых операций из неё берутся четыре строки:</p>
    <ul>
      <li>погрузка и установка оборудования грузоподъёмными кранами, площадка приёма материалов — 50 лк на горизонтальной плоскости;</li>
      <li>то же, на крюке крана — 20 лк на вертикальной плоскости;</li>
      <li>монтаж строительных конструкций (стальных, железобетонных, деревянных) — 30 лк на вертикальной плоскости по всей высоте сборки;</li>
      <li>немеханизированная разгрузка и погрузка конструкций — 20 лк на горизонтальной плоскости.</li>
    </ul>
    <p>Ключевая деталь — плоскость нормирования. Две из четырёх строк требуют освещённости на вертикальной плоскости, то есть по траектории груза и на крюке, а не под ногами. Прожектор, направленный вниз на пятно установки, эту часть нормы не закрывает, хотя субъективно площадка выглядит хорошо освещённой.</p>

    <h2 style="margin:36px 0 16px">Охранное освещение — отдельная категория</h2>
    <p>Охранное освещение предусматривается, когда в тёмное время суток требуется охрана строительной площадки или участка производства работ — оно должно обеспечивать на границах площадки горизонтальную освещённость 0,5 лк на уровне земли или вертикальную на плоскости ограждения. Это отдельное требование от рабочего освещения, которое обеспечивает видимость непосредственно на месте выполнения работ.</p>

    <h2 style="margin:36px 0 16px">Почему это важно для работы крана</h2>
    <p>Работа крана в условиях недостаточной освещённости — прямое нарушение требований безопасности: оператор должен ясно видеть точку подъёма, зону перемещения груза и людей вокруг площадки. Мы не проводим работы, если освещённость объекта не соответствует нормам для конкретной зоны — это касается и вечерних смен, и зимнего периода с коротким световым днём.</p>

    <h2 style="margin:36px 0 16px">Кто отвечает за освещение</h2>
    <p>Освещение строительной площадки в целом — как правило, зона ответственности генподрядчика или заказчика объекта, а не подрядчика по крану. Если работы планируются в тёмное время суток или на зимний период с ранними сумерками, мы уточняем это на этапе заявки, чтобы убедиться, что освещение объекта соответствует нормам для планируемой зоны работ.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: что запомнить</h2>
    <ul>
      <li>Основные рабочие зоны — от 50 люкс, зоны повышенной опасности — от 75 люкс, подъездные пути — 10–20 люкс.</li>
      <li>Охранное освещение (0,5 лк на границе площадки) — отдельное требование от рабочего освещения.</li>
      <li>Работа крана без соответствия нормам освещённости не проводится.</li>
      <li>Освещение объекта — зона ответственности генподрядчика/заказчика, мы уточняем это заранее для вечерних и зимних смен.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <Sources
      checked={CHECKED}
      items={[
        { text: 'ГОСТ 12.1.046-2014 «Строительство. Нормы освещения строительных площадок»', href: 'https://base.garant.ru/71102670/' },
        { text: 'master-led.ru — освещение стройплощадок: виды, стандарты и требования', href: 'https://master-led.ru/osveshhenie-stroitelnyix-ploshhadok-vidyi-i-standartyi' },
        { text: 'terra-led.ru — освещение строительной площадки: нормы, требования', href: 'https://terra-led.ru/reviews/detail/osveshchenie-stroitelnyh-ploshchadok/' }
      ]}
    />
  </article>
  <section class="section wrap"><a class="btn" href="/spravochnik/rabota-krana-zimoy/">Работа крана зимой →</a></section>
</main>
</SpravochnikLayout>
