---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = 'Можно ли работать автокраном ночью в Москве';
const description = 'Ночь по закону Москвы №42 — с 23:00 до 7:00; за нарушение тишины ст. 3.13 КоАП Москвы грозит юрлицу 40–80 тыс. ₽. Что можно и что нет.';

const CHECKED = '30.09.2026';
const PUBLISHED = '2026-09-30';
const SLUG = 'nochnye-raboty-avtokrana-v-moskve';
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: 'Во сколько заканчивается ночное время в Москве?',
    a: 'Закон Москвы от 12.07.2002 №42 определяет ночное время как период с 23:00 до 07:00. В эти часы запрещены строительные и погрузочно-разгрузочные работы, если они нарушают покой граждан. МОСКРАН-СЕРВИС планирует подачу автокрана так, чтобы шумная работа стрелы и двигателя укладывалась в дневное время.',
  },
  {
    q: 'Можно ли работать автокраном ночью, если он не шумит?',
    a: 'Закон запрещает ремонтные, строительные и погрузочно-разгрузочные работы, «повлекшие нарушение покоя граждан и тишины в ночное время». Кран с работающим дизелем и сигналами при подъёме над жилым кварталом шумит заведомо. МОСКРАН-СЕРВИС не берётся за ночные заявки в жилой застройке без письменного основания.',
  },
  {
    q: 'Есть ли исключения для срочных работ?',
    a: 'Да: закон не распространяется на действия, направленные на предотвращение правонарушений, ликвидацию последствий аварий, стихийных бедствий и иных чрезвычайных ситуаций, а также на проведение неотложных работ. МОСКРАН-СЕРВИС подаёт кран по аварийной заявке, если заказчик подтверждает такой характер работ документами.',
  },
  {
    q: 'Какой штраф за ночной шум на стройке в Москве?',
    a: 'По данным КонсультантПлюс, ст. 3.13 КоАП города Москвы предусматривает для юридических лиц штраф 40 000–80 000 ₽, для должностных лиц — 4 000–8 000 ₽. Точный размер и часть статьи зависят от редакции, поэтому МОСКРАН-СЕРВИС советует сверять норму перед оформлением ночной смены.',
  },
  {
    q: 'Кто отвечает за ночной шум — владелец крана или заказчик?',
    a: 'Ответственность по КоАП Москвы наступает для лица, чьи действия нарушили тишину; при аренде крана с экипажем работы организует заказчик, а кран эксплуатирует арендодатель. Распределение рисков лучше закрепить в договоре аренды. МОСКРАН-СЕРВИС разбирает этот вопрос при согласовании заявки.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Ночные работы автокрана', item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ['zakon', 'Что говорит закон Москвы №42'],
  ['shtraf', 'Штраф по КоАП Москвы'],
  ['isklyucheniya', 'Когда ночная работа допустима'],
  ['plan', 'Как планировать смену'],
  ['faq', 'Частые вопросы'],
  ['istochniki', 'Источники'],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Ночные работы автокрана</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Москва · Нормы и режим работы</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Можно ли работать автокраном ночью в Москве?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>30.09.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>30.09.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>5 мин чтения</span>
    </div>

    <p>Ночью автокран в Москве работает ограниченно: закон города от 12.07.2002 №42 считает ночью период с 23:00 до 7:00 и запрещает в это время строительные и погрузочно-разгрузочные работы, если они нарушают покой граждан. Для юридического лица штраф по ст. 3.13 КоАП города Москвы — 40 000–80 000 ₽. МОСКРАН-СЕРВИС поэтому подаёт кран днём, а ночные смены берёт только по аварийным и неотложным работам.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="zakon" style="margin:36px 0 16px">Что говорит закон Москвы №42</h2>
    <p>Статья 1 закона Москвы №42 определяет ночное время как период с 23 до 7 часов. В перечне действий, нарушающих покой, закон называет производство ремонтных, строительных и погрузочно-разгрузочных работ, повлекшее нарушение покоя граждан и тишины в ночное время. Работа автокрана — это и подъём, и разгрузка, поэтому МОСКРАН-СЕРВИС относит ночную подачу крана в жилой квартал к запрещённым действиям.</p>
    <p>Слова «повлекшее нарушение покоя» важны: запрет сформулирован через последствия. Автокран с дизельным двигателем, гидравликой и звуковым сигналом при движении стрелы создаёт шум, который слышен в соседних домах. МОСКРАН-СЕРВИС не строит расчёт на том, что кран «тихий», и не ссылается на отсутствие жалоб как на основание работать ночью.</p>

    <h2 id="shtraf" style="margin:36px 0 16px">Штраф по КоАП Москвы</h2>
    <p>Ст. 3.13 КоАП города Москвы карает за ночной шум. КонсультантПлюс называет для юрлиц штраф 40 000–80 000 ₽, для должностных лиц — 4 000–8 000 ₽, для граждан — предупреждение либо 1 000–2 000 ₽. Статья охватывает нарушения покоя с 23:00 до 7:00 в защищаемых помещениях и на территориях, определённых законом Москвы. МОСКРАН-СЕРВИС сверял суммы 30.09.2026; размеры меняются с редакциями, поэтому перед ночной сменой их нужно перепроверить.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Кто нарушил</th><th>Штраф (по данным КонсультантПлюс)</th></tr></thead>
        <tbody>
          <tr><td>Юридическое лицо</td><td>40 000–80 000 ₽</td></tr>
          <tr><td>Должностное лицо</td><td>4 000–8 000 ₽</td></tr>
          <tr><td>Гражданин</td><td>предупреждение или 1 000–2 000 ₽</td></tr>
        </tbody>
      </table>
    </div>
    <p>Для застройщика и арендатора крана значима первая строка: организация платит сумму, сопоставимую с двумя–четырьмя сменами крана класса 25 т по ставке МОСКРАН-СЕРВИС 20 800 ₽. Экономия от ночной работы без основания оказывается меньше штрафа.</p>

    <h2 id="isklyucheniya" style="margin:36px 0 16px">Когда ночная работа допустима</h2>
    <p>Закон Москвы №42 не применяется к действиям, направленным на предотвращение правонарушений, предотвращение и ликвидацию последствий аварий, стихийных бедствий и иных чрезвычайных ситуаций, а также на проведение неотложных работ. Автокран нужен в таких случаях для подъёма упавшего элемента, разбора завала, замены оборудования на аварийной сети. МОСКРАН-СЕРВИС принимает такую заявку ночью, если заказчик называет причину и готов подтвердить её документами.</p>
    <p>Плановый монтаж, разгрузка фур и подача материалов к «неотложным» работам не относятся, даже если график стройки горит. Для подстраховки МОСКРАН-СЕРВИС просит в заявке письменное указание, что работы аварийные, и контакты ответственного за безопасное производство работ. Требования к освещению площадки при любой смене собраны в <a href="/spravochnik/osveshchenie-ploshchadki/" style="color:var(--yellow)">материале об освещении площадки</a>.</p>

    <h2 id="plan" style="margin:36px 0 16px">Как планировать смену</h2>
    <p>Смена автокрана в МОСКРАН-СЕРВИС длится 8 часов, и подача к 7:00 позволяет начинать работу сразу после окончания ночного времени. Прогрев двигателя, развёртывание опор и пробный подъём лучше начинать не раньше 7:00 в жилой застройке. Тарифы для 25 т — 20 800 ₽, для 50 т — 31 200 ₽ за смену; надбавок за ночь МОСКРАН-СЕРВИС в открытых расценках не публикует, стоимость аварийной ночной подачи уточняется по заявке.</p>
    <p>Если работа обязана идти ночью из-за перекрытия дороги или окна на объекте, заказчик получает основания в организациях, которые ограничивают движение и работы; порядок перекрытий разобран в <a href="/spravochnik/soglasovanie-perekrytiya-proezda/" style="color:var(--yellow)">материале о согласовании перекрытия проезда</a>, а въезд тяжёлой техники — в <a href="/spravochnik/propusk-avtokrana-v-moskvu/" style="color:var(--yellow)">материале о пропуске автокрана в Москву</a>. Сроки этих согласований зависят от органа власти, и МОСКРАН-СЕРВИС их не обещает.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: ночные работы автокрана</h2>
    <ul>
      <li>Ночное время в Москве — с 23:00 до 7:00 (ст. 1 закона Москвы №42).</li>
      <li>Строительные и погрузочно-разгрузочные работы, нарушающие покой, в это время запрещены.</li>
      <li>Юрлицо платит по ст. 3.13 КоАП Москвы 40 000–80 000 ₽ (КонсультантПлюс).</li>
      <li>Исключение — аварийные и неотложные работы; МОСКРАН-СЕРВИС просит подтверждение в заявке.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://www.kontur-extern.ru/info/normativ/document/3/90684-zakon-g-moskvy-ot-12-07-2002-n-42" target="_blank" rel="noopener" style="color:var(--yellow)">Закон города Москвы от 12.07.2002 №42 о соблюдении покоя граждан и тишины</a> — ст. 1 (ночное время с 23 до 7 часов), перечень действий, нарушающих покой, исключения для аварийных и неотложных работ.</li>
      <li><a href="https://www.consultant.ru/law/podborki/nakazanie_predusmotreno_za_narushenie_tishiny_v_nochnoe_vremya_v_g._moskve/" target="_blank" rel="noopener" style="color:var(--yellow)">КонсультантПлюс, подборка «Наказание за нарушение тишины в ночное время в г. Москве»</a> — размеры штрафов по ст. 3.13 КоАП Москвы.</li>
      <li><a href="https://base.garant.ru/388521/835c429f8eb833c6068cade6eb727751/" target="_blank" rel="noopener" style="color:var(--yellow)">Статья 3.13 «Нарушение тишины и покоя граждан», Закон Москвы от 21.11.2007 №45 (КоАП города Москвы)</a> — ГАРАНТ.</li>
    </ul>
  </article>
  <section class="section wrap"><a class="btn" href="/#zayavka">Оставить заявку на автокран →</a></section>
</main>
</SpravochnikLayout>
