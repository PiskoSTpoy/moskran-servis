---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';
import Sources from '../../../components/Sources.astro';

const title = 'Кто платит за простой крана по вине заказчика';
const description = 'Если площадка не готова к приезду крана, простой техники оплачивается отдельно. Что входит в компенсацию и как это фиксируется договором.';

const CHECKED = '12.08.2026';

const faqs = [
  { q: 'Что именно считается простоем по вине заказчика?', a: 'Ситуация, когда подрядчик не может исполнять свои обязательства, потому что заказчик не предоставил необходимые условия — например, площадка не расчищена, подъезд перекрыт чужим транспортом, груз не подготовлен к подъёму в согласованное время.' },
  { q: 'Простой всегда оплачивается по одному и тому же тарифу?', a: 'Нет, порядок оплаты стороны согласовывают заранее — например, как процент от стоимости смены или как стоимость бригадо-часа по двустороннему акту. Точные условия фиксируются в договоре до выезда техники, а не определяются постфактум по факту простоя.' },
  { q: 'Можно ли избежать оплаты простоя, если он произошёл не по вине заказчика?', a: 'Да, если простой вызван объективными обстоятельствами со стороны подрядчика (поломка техники, задержка не по вине заказчика), это не тарифицируется заказчику как его простой — мы разделяем эти ситуации именно потому, что причина простоя определяет, кто несёт расходы.' },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Простой техники', item: 'https://moskran-servis.ru/spravochnik/prostoy-tehniki-oplata/' },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@id': 'https://moskran-servis.ru/#organization' }, // ссылка на единственный узел организации (BaseLayout): отдельный узел с тем же @id, но другим name, был противоречием в графе
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: 'https://moskran-servis.ru/spravochnik/prostoy-tehniki-oplata/',
  inLanguage: 'ru-RU',
  datePublished: '2026-08-12',
  dateModified: '2026-08-12',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<SpravochnikLayout title={title} description={description} path="/spravochnik/prostoy-tehniki-oplata/" slug="prostoy-tehniki-oplata" ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Простой техники</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Разбор для заказчика</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Простой техники по вине заказчика — кто оплачивает и почему</h1>
    <p class="ref-byline">Инженерная служба МОСКРАН-СЕРВИС · обновлено в 2026 году</p>

    <p>На странице услуги «Автокраны 16–25 тонн» мы упоминаем простой по вине заказчика как отдельную позицию расчёта. Здесь разбираем, что это означает на практике и почему это справедливое требование, а не способ заработать на неудобствах заказчика.</p>

    <h2 style="margin:36px 0 16px">Что такое простой по вине заказчика</h2>
    <p>Простой по вине заказчика — это время, в течение которого подрядчик не может выполнять свои обязанности по договору, потому что заказчик не предоставил необходимых условий: площадка не готова к приезду крана, подъезд занят посторонним транспортом, груз к согласованному времени не подготовлен к подъёму.</p>

    <h2 style="margin:36px 0 16px">Почему это оплачивается отдельно</h2>
    <p>Пока кран простаивает по причинам на стороне заказчика, подрядчик всё равно несёт текущие расходы — заработную плату оператора, амортизацию техники, упущенную возможность выполнить другую заявку в это время. Плата за простой компенсирует именно эти расходы, а не является штрафом «на всякий случай».</p>

    <h2 style="margin:36px 0 18px">Как рассчитывается плата</h2>
    <p>Конкретный порядок стороны согласовывают заранее в договоре — например, стоимость одного дня или часа простоя как процент от стоимости обычной смены, либо как отдельная фиксированная ставка бригадо-часа, подтверждаемая двусторонним актом на месте. Мы фиксируем это условие до выезда техники на объект, а не определяем задним числом по факту простоя.</p>

    <h2 style="margin:36px 0 18px">Когда простой НЕ считается виной заказчика</h2>
    <p>Если задержка вызвана обстоятельствами на стороне подрядчика (поломка техники, опоздание не по вине заказчика), это не тарифицируется заказчику как простой по его вине — важно различать причину, а не автоматически применять оплату простоя к любой задержке на площадке.</p>

    <h2 style="margin:36px 0 18px">Как избежать простоя</h2>
    <p>Проще всего — заранее подготовить площадку по требованиям, которые мы называем на этапе расчёта заявки (см. статьи про несущую способность грунта и требования к площадке на страницах услуг), и убедиться, что груз готов к подъёму к согласованному времени. Мы также предупреждаем заранее, если видим риск задержки с нашей стороны — чтобы обе стороны понимали реальную картину, а не выясняли отношения по факту простоя.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: что запомнить</h2>
    <ul>
      <li>Простой по вине заказчика — время, потерянное из-за неготовности условий на его стороне.</li>
      <li>Оплата компенсирует реальные текущие расходы подрядчика, а не штрафует произвольно.</li>
      <li>Порядок расчёта (процент от смены или ставка за час) фиксируется в договоре заранее.</li>
      <li>Простой не по вине заказчика оплате заказчиком не подлежит.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <Sources
      checked={CHECKED}
      items={[
        { text: 'vc.ru — простой по вине заказчика: практические рекомендации', href: 'https://vc.ru/u/1324456-konstantin-lushnikov/521724-prostoy-po-vine-zakazchika-chto-uchest-podryadchiku-pri-formulirovanii-dogovornyh-usloviy-prakticheskie-rekomendacii' },
        { text: 'ppt.ru — как действовать при простое по вине заказчика', href: 'https://ppt.ru/art/buh-budget/instruktsiya-kak-deystvovat-pri-prostoe-po-vine-zakazchika' }
      ]}
    />
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-16-25-tonn/">Как формируется цена аренды →</a></section>
</main>
</SpravochnikLayout>
