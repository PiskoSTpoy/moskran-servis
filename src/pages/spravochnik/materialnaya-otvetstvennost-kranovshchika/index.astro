---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';
import Sources from '../../../components/Sources.astro';

const title = 'Материальная ответственность крановщика: сколько он лично платит за ущерб';
const description = 'По статье 241 ТК РФ крановщик отвечает перед работодателем в пределах среднего месячного заработка — полная ответственность возможна только в случаях из статьи 243. Разбираем разницу и порядок взыскания.';

const CHECKED = '14.09.2026';

const faqs = [
  { q: 'Работодатель может просто удержать сумму ущерба из зарплаты крановщика?', a: 'Только при соблюдении порядка из статьи 248 ТК РФ. Если сумма ущерба не превышает средний месячный заработок работника, работодатель вправе взыскать её своим распоряжением — но не позднее одного месяца со дня, когда размер ущерба был окончательно установлен. Если этот срок пропущен, или сумма ущерба больше среднего заработка, а работник не согласен возместить её добровольно, взыскание возможно только через суд — удержать деньги из зарплаты в одностороннем порядке в этом случае работодатель уже не вправе.' },
  { q: 'Если крановщик повредил груз заказчика, а не сам кран, — правило то же самое?', a: 'Правило о пределах материальной ответственности из статьи 241 ТК РФ регулирует отношения работника и его работодателя, а не работодателя и заказчика. Перед заказчиком за повреждённый груз отвечает организация, предоставившая кран, — по условиям договора аренды или подряда и нормам ГК РФ. А вот уже требовать возмещения с самого крановщика внутри компании работодатель может лишь в пределах, которые устанавливает статья 241 ТК РФ, даже если сумма, которую пришлось заплатить заказчику, оказалась выше.' },
  { q: 'Можно ли просто прописать в трудовом договоре крановщика полную материальную ответственность?', a: 'Само по себе условие в трудовом договоре не расширяет ответственность сверх того, что разрешает закон. Полная материальная ответственность возлагается на работника только в случаях, прямо предусмотренных ТК РФ или другими федеральными законами (статья 242 ТК РФ), а письменный договор о полной ответственности заключается лишь с работниками, чья должность и работа входят в специальный перечень, утверждаемый в порядке, установленном Правительством РФ (статья 244 ТК РФ) — произвольно расширить этот перечень условием трудового договора нельзя.' },
  { q: 'А если крановщик уронил груз просто по неопытности, без умысла?', a: 'Это тот случай, для которого и существует ограниченная ответственность по статье 241 ТК РФ. Ошибка, ставшая причиной ущерба, но не связанная с умыслом, опьянением или другими основаниями полной ответственности из статьи 243 ТК РФ, не выводит работника за пределы среднего месячного заработка — даже если фактический ущерб от повреждённого груза или простоя объекта оказался значительно больше.' },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Материальная ответственность крановщика', item: 'https://moskran-servis.ru/spravochnik/materialnaya-otvetstvennost-kranovshchika/' },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@id': 'https://moskran-servis.ru/#organization' }, // ссылка на единственный узел организации (BaseLayout): отдельный узел с тем же @id, но другим name, был противоречием в графе
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: 'https://moskran-servis.ru/spravochnik/materialnaya-otvetstvennost-kranovshchika/',
  inLanguage: 'ru-RU',
  datePublished: '2026-09-14',
  dateModified: '2026-09-14',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<SpravochnikLayout title={title} description={description} path="/spravochnik/materialnaya-otvetstvennost-kranovshchika/" slug="materialnaya-otvetstvennost-kranovshchika" ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Материальная ответственность крановщика</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Разбор для заказчика</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Материальная ответственность крановщика: сколько он лично платит за ущерб</h1>
    <p class="ref-byline">Инженерная служба МОСКРАН-СЕРВИС · обновлено 14.09.2026</p>

    <p>Справочник уже разбирал, как между стропальщиком, крановщиком и заказчиком распределяется ответственность за сам инцидент на площадке — кто виноват в падении груза с точки зрения ГК РФ. Отдельный и часто менее очевидный вопрос — сколько из суммы этого ущерба работодатель вправе взыскать с самого крановщика как со своего работника. Здесь действует не гражданское, а трудовое право, и оно устроено гораздо строже к работодателю, чем принято думать: полностью переложить ущерб на оператора крана можно далеко не всегда.</p>

    <h2 style="margin:36px 0 16px">Общее правило — средний месячный заработок, а не полная сумма ущерба</h2>
    <p>Базовая норма закреплена в статье 241 Трудового кодекса РФ: за причинённый ущерб работник несёт материальную ответственность в пределах своего среднего месячного заработка, если иное не предусмотрено самим Кодексом или другими федеральными законами. Это правило действует по умолчанию для любого работника, включая крановщика, и именно оно, а не гипотетическая полная стоимость гружённого автокрана, определяет реальный предел взыскания в большинстве случаев на практике. Если, например, ремонт повреждённой стрелы обошёлся в сумму, кратно превышающую месячный оклад оператора, разница сверх среднего заработка ложится на работодателя, а не автоматически на работника.</p>

    <h2 style="margin:36px 0 16px">Когда включается полная ответственность</h2>
    <p>Статья 242 ТК РФ прямо ограничивает случаи, когда с работника можно требовать больше среднего заработка: полная материальная ответственность возлагается на него только тогда, когда это прямо предусмотрено Кодексом или иным федеральным законом. Конкретный перечень таких случаев даёт статья 243 ТК РФ, и для крановщика на практике значимы прежде всего несколько из них: умышленное причинение ущерба, причинение ущерба в состоянии алкогольного, наркотического или иного токсического опьянения, ущерб, ставший результатом административного правонарушения, установленного соответствующим государственным органом, и ущерб, причинённый не при исполнении трудовых обязанностей — например, если работник использовал служебный автокран в личных целях без ведома работодателя. Обычная эксплуатационная ошибка, не подпадающая ни под один из этих пунктов, под полную ответственность не подпадает, какой бы дорогой ни оказалась её цена.</p>

    <h2 style="margin:36px 0 16px">Письменный договор о полной ответственности — не универсальный инструмент</h2>
    <p>Работодатели иногда пытаются решить вопрос заранее — прописать полную материальную ответственность прямо в трудовом договоре с крановщиком. Закон это не допускает произвольно: статья 244 ТК РФ разрешает заключать письменные договоры о полной индивидуальной или коллективной материальной ответственности только с работниками, достигшими 18 лет и непосредственно обслуживающими или использующими ценности, — и только по должностям и работам, которые входят в специальный перечень, утверждаемый в порядке, установленном Правительством РФ. Просто вписать нужную формулировку в трудовой договор конкретного оператора крана и тем самым расширить его ответственность сверх статьи 241 ТК РФ нельзя — договор о полной ответственности либо в принципе применим к должности, либо нет, а не составляется индивидуально под каждого сотрудника по желанию работодателя.</p>

    <h2 style="margin:36px 0 16px">Порядок взыскания — распоряжение работодателя действует не всегда</h2>
    <p>Даже когда ответственность крановщика ограничена средним месячным заработком, работодатель не может просто удержать деньги из ближайшей зарплаты. Статья 248 ТК РФ устанавливает: взыскание суммы ущерба, не превышающей средний месячный заработок, производится по распоряжению работодателя, но оно должно быть сделано не позднее одного месяца со дня, когда работодатель окончательно установил размер причинённого ущерба. Если этот месячный срок пропущен, либо сумма ущерба превышает средний заработок работника, а сам он не согласен возместить её добровольно, взыскать ущерб можно только через суд — одностороннее удержание из зарплаты в этих случаях уже незаконно, и работник вправе обжаловать его.</p>

    <h2 style="margin:36px 0 16px">Что это значит на практике</h2>
    <p>Для компании, которая держит в штате крановщиков, а не только привлекает их по договору, это означает, что дисциплина оформления инцидента важна не меньше, чем сама страховка техники. Акт о повреждении, фиксация обстоятельств, срок для распоряжения о взыскании — всё это определяет, останется ли вопрос внутри компании или уйдёт в суд. Для заказчика, который арендует кран с экипажем, это скорее фоновое знание: перед ним за ущерб всё равно отвечает организация-владелец техники по условиям договора, а то, как эта организация потом строит расчёты со своим сотрудником, — её внутренний трудовой вопрос, ограниченный рамками ТК РФ, а не предмет переговоров с заказчиком.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: что запомнить</h2>
    <ul>
      <li>По умолчанию крановщик отвечает перед работодателем в пределах среднего месячного заработка (ст. 241 ТК РФ) — а не в размере полной стоимости ущерба.</li>
      <li>Полная материальная ответственность возможна только в случаях из статьи 243 ТК РФ: умысел, опьянение, административное правонарушение, ущерб не при исполнении трудовых обязанностей и другие прямо перечисленные основания.</li>
      <li>Расширить ответственность сверх закона одним пунктом трудового договора нельзя — письменный договор о полной ответственности применим только к должностям из специального перечня (ст. 244 ТК РФ).</li>
      <li>Взыскание в пределах среднего заработка — распоряжением работодателя не позднее одного месяца со дня установления размера ущерба; всё, что позже или сверх этой суммы без согласия работника, — только через суд (ст. 248 ТК РФ).</li>
      <li>Ответственность крановщика перед работодателем по ТК РФ — отдельный вопрос от ответственности компании перед заказчиком за сам груз или инцидент, которая регулируется договором и нормами ГК РФ.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <Sources
      checked={CHECKED}
      items={[
        { text: 'КонсультантПлюс — Трудовой кодекс РФ, статья 241 «Пределы материальной ответственности работника»', href: 'https://www.consultant.ru/document/cons_doc_LAW_34683/490396c999c8678eae3e64c3b6987c972864218f/' },
        { text: 'legalacts.ru — Трудовой кодекс РФ, статья 242 «Полная материальная ответственность работника»', href: 'https://legalacts.ru/kodeks/TK-RF/chast-iii/razdel-xi/glava-39/statja-242/' },
        { text: 'КонсультантПлюс — Трудовой кодекс РФ, статья 243 «Случаи полной материальной ответственности»', href: 'https://www.consultant.ru/document/cons_doc_LAW_34683/38bd50c03ced250bd211bc750ed3575f901fc66c/' },
        { text: 'КонсультантПлюс — Трудовой кодекс РФ, статья 248 «Порядок взыскания ущерба»', href: 'https://www.consultant.ru/document/cons_doc_LAW_34683/5187208d14c5473391f5ccba9be4b0ce893d6179/' },
      ]}
      note="Прямого доступа к полному тексту ТК РФ в системе КонсультантПлюс при подготовке материала не было; формулировки статей 241, 242, 243 (в части оснований полной ответственности, значимых для крановщика) и 248 сверены по нескольким независимым пересказам норм, включая прямые цитаты КонсультантПлюс в результатах поиска, и совпадают между источниками. Статья 244 ТК РФ и упомянутый в ней специальный перечень должностей приведены только в части общего принципа (перечень утверждается в порядке, установленном Правительством РФ) — конкретный действующий перечень в материале не называется и не проверялся."
    />
  </article>
  <section class="section wrap"><a class="btn" href="/spravochnik/otvetstvennost-za-padenie-gruza/">Ответственность за падение груза: кто виноват — стропальщик, крановщик или заказчик →</a></section>
</main>
</SpravochnikLayout>
