---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = 'Автокран и закон о тишине в Подмосковье: часы работы';
const description = 'Закон МО №16/2014-ОЗ: тишина в будни с 21:00 до 8:00, в выходные с 22:00 до 10:00. Штраф юрлицу по ст. 3.1 КоАП МО — 20 000–50 000 ₽. Как ставить смену.';

const CHECKED = '01.10.2026';
const PUBLISHED = '2026-10-01';
const SLUG = 'zakon-o-tishine-v-podmoskove-avtokran';
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: 'Со скольки можно работать автокраном в Подмосковье?',
    a: 'Закон Московской области №16/2014-ОЗ разрешает шумные работы в будни с 8:00 до 21:00, в субботу, воскресенье и нерабочие праздничные дни — с 10:00 до 22:00. МОСКРАН-СЕРВИС ставит начало смены в области не раньше этих границ, если площадка рядом с жильём или садовым товариществом.',
  },
  {
    q: 'Какой штраф за работу крана ночью в Московской области?',
    a: 'Статья 3.1 КоАП Московской области назначает юридическому лицу штраф 20 000–50 000 ₽, должностному лицу — 5 000–10 000 ₽, гражданину — предупреждение или 1 000–3 000 ₽. Третье нарушение за год обходится организации в 100 000–150 000 ₽. МОСКРАН-СЕРВИС сверял суммы 01.10.2026.',
  },
  {
    q: 'Чем подмосковный закон о тишине отличается от московского?',
    a: 'Закон Москвы №42 считает ночью время с 23:00 до 7:00, а закон Московской области №16/2014-ОЗ — с 21:00 до 8:00 в будни и с 22:00 до 10:00 в выходные. Рабочее окно в области короче на три часа в будни. МОСКРАН-СЕРВИС уточняет адрес, чтобы применить нужный закон.',
  },
  {
    q: 'Действует ли закон о тишине на даче и в СНТ?',
    a: 'Да: закон Московской области №16/2014-ОЗ относит к защищаемым объектам территории садоводческих и огороднических объединений наравне с квартирами и придомовыми территориями. Автокран МОСКРАН-СЕРВИС на дачном участке в субботу начинает подъём не раньше 10:00.',
  },
  {
    q: 'Можно ли вызвать автокран ночью при аварии?',
    a: 'Закон Московской области №16/2014-ОЗ не распространяется на действия по предотвращению и ликвидации последствий аварий, стихийных бедствий и иных чрезвычайных ситуаций. МОСКРАН-СЕРВИС принимает ночную заявку в область, когда заказчик называет аварийную причину и готов подтвердить её документально.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Тишина в Подмосковье', item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ['chasy', 'Часы тишины в области'],
  ['sravnenie', 'Москва и область: разница'],
  ['obekty', 'Где закон действует'],
  ['shtraf', 'Штрафы по КоАП МО'],
  ['smena', 'Как поставить смену'],
  ['faq', 'Частые вопросы'],
  ['istochniki', 'Источники'],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Тишина в Подмосковье</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Московская область · Режим работы</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">В какое время можно работать автокраном в Подмосковье по закону о тишине?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>01.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>01.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>5 мин чтения</span>
    </div>

    <p>Автокран в Московской области работает рядом с жильём в будни с 8:00 до 21:00, в выходные и праздники — с 10:00 до 22:00: остальное время закон области от 07.03.2014 №16/2014-ОЗ отводит под тишину. Строительные и разгрузочно-погрузочные работы прямо названы в перечне нарушений. Юридическому лицу статья 3.1 КоАП Московской области назначает 20 000–50 000 ₽. МОСКРАН-СЕРВИС планирует смену в области по этим часам, а не по московским.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="chasy" style="margin:36px 0 16px">Часы тишины в области</h2>
    <p>Статья 2 закона Московской области №16/2014-ОЗ запрещает нарушать тишину с 21:00 до 8:00 с понедельника по пятницу и с 22:00 до 10:00 в субботу, воскресенье и нерабочие праздничные дни. Статья 4 включает в перечень нарушений проведение земляных, ремонтных, строительных, разгрузочно-погрузочных и иных видов работ. Подъём и разгрузка автокраном попадают в этот пункт целиком, и МОСКРАН-СЕРВИС не делит работу крана на «шумную» и «тихую».</p>
    <p>Дневной перерыв с 13:00 до 15:00 закон №16/2014-ОЗ связывает со звуковоспроизводящими устройствами и ремонтом в квартирах; для строительных и разгрузочных работ на улице обзор «ЖКХ Ньюс» от 02.01.2026 называет только ночные периоды. МОСКРАН-СЕРВИС всё равно предупреждает заказчика о дневных часах, если кран стоит под окнами: редакцию закона стоит перечитать перед сменой.</p>

    <h2 id="sravnenie" style="margin:36px 0 16px">Москва и область: разница</h2>
    <p>Закон Москвы от 12.07.2002 №42 считает ночью период с 23:00 до 7:00, а закон Московской области №16/2014-ОЗ начинает тишину на два часа раньше и заканчивает на час позже. В будни московское рабочее окно длится 16 часов, подмосковное — 13. МОСКРАН-СЕРВИС свёл обе нормы в таблицу, потому что адрес в Химках и адрес в соседнем Куркине живут по разным законам.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Параметр</th><th>Москва (закон №42)</th><th>Московская область (№16/2014-ОЗ)</th></tr></thead>
        <tbody>
          <tr><td>Тишина в будни</td><td>23:00–7:00</td><td>21:00–8:00</td></tr>
          <tr><td>Тишина в выходные и праздники</td><td>23:00–7:00</td><td>22:00–10:00</td></tr>
          <tr><td>Рабочее окно в будни</td><td>16 часов</td><td>13 часов</td></tr>
          <tr><td>Рабочее окно в выходные</td><td>16 часов</td><td>12 часов</td></tr>
          <tr><td>Штраф юрлицу, первое нарушение</td><td>40 000–80 000 ₽ (ст. 3.13 КоАП Москвы)</td><td>20 000–50 000 ₽ (ст. 3.1 КоАП МО)</td></tr>
          <tr><td>Аварийные работы</td><td>закон не применяется</td><td>закон не применяется</td></tr>
        </tbody>
      </table>
    </div>
    <p>Московские правила подробно разобраны в <a href="/spravochnik/nochnye-raboty-avtokrana-v-moskve/" style="color:var(--yellow)">материале о ночных работах автокрана в Москве</a>. Для заказчика из области главное отличие — утро выходного дня: в субботу кран МОСКРАН-СЕРВИС в Москве может работать с 7:00, а в Подмосковье — только с 10:00.</p>

    <h2 id="obekty" style="margin:36px 0 16px">Где закон действует</h2>
    <p>Статья 3 закона Московской области №16/2014-ОЗ защищает квартиры и помещения общего пользования в многоквартирных домах, придомовые территории, образовательные, медицинские и социальные организации, а также территории садоводческих объединений. Дачный посёлок и СНТ поэтому приравнены к жилому кварталу. Автокран МОСКРАН-СЕРВИС, который ставит бытовку или кольца септика на садовом участке, подчиняется тем же часам, что и кран во дворе многоэтажки.</p>
    <p>Промышленная площадка и склад вдали от жилья в перечень статьи 3 закона №16/2014-ОЗ не входят, но шум дизеля ночью разносится далеко. МОСКРАН-СЕРВИС просит заказчика указать в заявке, что находится в радиусе слышимости: жилые дома, школа, больница или садовое товарищество. Про выбор техники для участка — в <a href="/spravochnik/avtokran-dlya-chastnogo-doma/" style="color:var(--yellow)">материале об автокране для частного дома</a>.</p>

    <h2 id="shtraf" style="margin:36px 0 16px">Штрафы по КоАП МО</h2>
    <p>Статья 3.1 КоАП Московской области (закон от 04.05.2016 №37/2016-ОЗ) за первое нарушение тишины назначает юридическому лицу 20 000–50 000 ₽. Должностное лицо платит 5 000–10 000 ₽, гражданин получает предупреждение или штраф 1 000–3 000 ₽. Повторное нарушение за год, по обзору «ЖКХ Ньюс», стоит организации 60 000–80 000 ₽, третье и последующие — 100 000–150 000 ₽. МОСКРАН-СЕРВИС сверял суммы 01.10.2026.</p>
    <p>Верхняя граница третьего штрафа по статье 3.1 КоАП МО — 150 000 ₽ — равна примерно семи сменам автокрана класса 25 т по ставке МОСКРАН-СЕРВИС 20 800 ₽. На стройке с ежедневными ранними разгрузками три протокола за год набираются быстро. Размеры штрафов меняются с редакциями кодекса, и перед ночной или ранней сменой их нужно перепроверить по действующему тексту.</p>

    <h2 id="smena" style="margin:36px 0 16px">Как поставить смену</h2>
    <p>Смена автокрана в МОСКРАН-СЕРВИС длится 8 часов, и в будни в области она помещается в окно 8:00–21:00 с запасом в пять часов. В выходные окно 10:00–22:00 оставляет четыре часа запаса, поэтому подачу лучше назначать на 10:00, а не на вторую половину дня. Развёртывание опор и пробный подъём тоже считаются работой крана и начинаются после границы тишины.</p>
    <p>Ставки МОСКРАН-СЕРВИС одинаковы для Москвы и области: 20 800 ₽ за смену класса 25 т и 31 200 ₽ за смену класса 50 т, надбавок за ночь в открытых расценках нет. Ночная подача возможна по аварийной заявке, потому что закон №16/2014-ОЗ не применяется к ликвидации последствий аварий и чрезвычайных ситуаций. Что указать в заявке, перечислено в <a href="/spravochnik/zayavka-na-avtokran/" style="color:var(--yellow)">материале о заявке на автокран</a>.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: тишина в Подмосковье и автокран</h2>
    <ul>
      <li>Тишина по закону МО №16/2014-ОЗ: будни 21:00–8:00, выходные и праздники 22:00–10:00.</li>
      <li>Строительные и разгрузочно-погрузочные работы названы в статье 4 закона.</li>
      <li>СНТ и придомовые территории — защищаемые объекты.</li>
      <li>Штраф юрлицу по ст. 3.1 КоАП МО — 20 000–50 000 ₽, третий раз за год — до 150 000 ₽.</li>
      <li>МОСКРАН-СЕРВИС подаёт кран в область к 8:00 в будни и к 10:00 в выходные.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://rg.ru/documents/2014/03/13/mosobl-zakon16-2014-reg-dok.html" target="_blank" rel="noopener" style="color:var(--yellow)">Закон Московской области от 07.03.2014 №16/2014-ОЗ «Об обеспечении тишины и покоя граждан на территории Московской области» — «Российская газета»</a> — ст. 2 (периоды), ст. 3 (защищаемые объекты), ст. 4 (перечень действий и исключения).</li>
      <li><a href="https://base.garant.ru/43135806/802464714d4d10a819efb803557e9689/" target="_blank" rel="noopener" style="color:var(--yellow)">Статья 3.1 «Нарушение тишины и покоя граждан», закон Московской области от 04.05.2016 №37/2016-ОЗ (КоАП Московской области)</a> — ГАРАНТ.</li>
      <li><a href="https://gkhnews.ru/1484495-tishina-v-mnogokvartirnom-dome-vremya-tishiny-i-shtrafy-za-narusheniya-po-zakonu-moskovskoj-oblasti/" target="_blank" rel="noopener" style="color:var(--yellow)">«ЖКХ Ньюс»: время тишины и штрафы по закону Московской области (обновлено 02.01.2026)</a> — действующие периоды, штрафы за повторное и третье нарушение.</li>
      <li><a href="https://www.kontur-extern.ru/info/normativ/document/3/90684-zakon-g-moskvy-ot-12-07-2002-n-42" target="_blank" rel="noopener" style="color:var(--yellow)">Закон города Москвы от 12.07.2002 №42 о соблюдении покоя граждан и тишины</a> — ночное время с 23 до 7 часов, для сравнения.</li>
    </ul>
  </article>
  <section class="section wrap"><a class="btn" href="/#zayavka">Оставить заявку на автокран →</a></section>
</main>
</SpravochnikLayout>
