---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';
import Sources from '../../../components/Sources.astro';

const title = 'Автокран или автовышка: как выбрать технику';
const description = 'Автокран поднимает и перемещает груз, автовышка поднимает людей с инструментом на высоту. Разбор частой путаницы при заказе техники.';

const CHECKED = '12.08.2026';

const faqs = [
  { q: 'Может ли автокран заменить автовышку для работы с людьми на высоте?', a: 'Нет — подъём людей краном в люльке, не предназначенной для этого штатно, запрещён требованиями промышленной безопасности за редкими регламентированными исключениями. Для работы человека на высоте нужна именно автовышка с сертифицированной люлькой.' },
  { q: 'Может ли автовышка поднять тяжёлый строительный груз вместо крана?', a: 'Нет, грузоподъёмность люльки автовышки (обычно до 500–1000 кг) рассчитана на людей и ручной инструмент, а не на строительные материалы или конструкции — для этого автовышка физически не предназначена и не имеет грузового крюка.' },
  { q: 'Что выбрать для монтажа лёгкого фасадного элемента на высоте — кран или вышку?', a: 'Зависит от задачи: если элемент нужно поднять и точно установить (монтаж), обычно нужен кран; если рабочим нужно просто подняться и что-то сделать руками на месте (осмотр, покраска, мелкий ремонт), это задача для автовышки. Иногда для одной задачи используют обе единицы техники параллельно.' },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Автокран или автовышка', item: 'https://moskran-servis.ru/spravochnik/avtokran-ili-avtovyshka/' },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@id': 'https://moskran-servis.ru/#organization' }, // ссылка на единственный узел организации (BaseLayout): отдельный узел с тем же @id, но другим name, был противоречием в графе
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: 'https://moskran-servis.ru/spravochnik/avtokran-ili-avtovyshka/',
  inLanguage: 'ru-RU',
  datePublished: '2026-08-12',
  dateModified: '2026-08-12',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<SpravochnikLayout title={title} description={description} path="/spravochnik/avtokran-ili-avtovyshka/" slug="avtokran-ili-avtovyshka" ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Автокран или автовышка</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Разбор для заказчика</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Автокран или автовышка — в чём разница и что заказывать</h1>
    <p class="ref-byline">Инженерная служба МОСКРАН-СЕРВИС · обновлено в 2026 году</p>

    <p>Частый вопрос при первом обращении: «нужен кран, чтобы поднять человека и покрасить фасад» — это на самом деле задача для автовышки, а не для крана. Разбираем разницу, чтобы заявка сразу уходила на нужный тип техники.</p>

    <h2 style="margin:36px 0 16px">Разное назначение</h2>
    <p>Автокран предназначен для подъёма и перемещения грузов — строительных материалов, ЖБИ, инженерного оборудования — при помощи крюка и грузозахватных приспособлений. Автовышка (автогидроподъёмник, АГП) предназначена для безопасного подъёма людей с инструментом и материалами на нужную высоту — её главный рабочий орган не крюк, а люлька, рассчитанная на определённый вес, обычно до 500–1000 кг.</p>

    <h2 style="margin:36px 0 16px">Разная конструкция стрелы</h2>
    <p>В зависимости от конструкции различают телескопические, коленчатые (локтевые) и коленчато-телескопические автовышки — коленчатая конструкция позволяет обходить препятствия (например, козырёк здания или ветки деревьев) на пути к точке работы, чего не может обеспечить прямая телескопическая стрела автокрана.</p>

    <h2 style="margin:36px 0 16px">Почему нельзя просто поднять человека краном</h2>
    <p>Подъём людей в люльке, подвешенной к крюку автокрана, не предназначенному штатно для этой функции, запрещён требованиями промышленной безопасности за редкими регламентированными исключениями с использованием специально сертифицированной люльки для конкретной модели крана. Обычная практика «встал в бочку, кран поднял» — прямое нарушение, а не экономичная альтернатива аренде вышки.</p>

    <h2 style="margin:36px 0 16px">Когда что заказывать — практические примеры</h2>
    <p>Работа с электрооборудованием, обрезка деревьев, мойка окон, осмотр или мелкий ремонт фасада, монтаж вывески силами человека на месте — задачи для автовышки. Подъём и точная установка тяжёлого груза (плиты, оборудование, конструкции), разгрузка транспорта, монтаж крупных элементов — задачи для автокрана. Если задача сочетает оба элемента (например, монтаж крупной конструкции, где монтажнику всё равно нужно быть рядом на высоте) — иногда целесообразно заказать обе единицы техники параллельно, а не пытаться закрыть всё одним краном.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: что запомнить</h2>
    <ul>
      <li>Кран поднимает и перемещает грузы; автовышка поднимает людей с инструментом на высоту.</li>
      <li>Люлька автовышки рассчитана на 500–1000 кг — не заменяет грузовой крюк крана.</li>
      <li>Подъём людей краном без специально сертифицированной люльки запрещён.</li>
      <li>Для задач, требующих и груз, и человека на высоте одновременно, иногда нужны обе единицы техники.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <Sources
      checked={CHECKED}
      items={[
        { text: 'skylift.ru — автокран и вышка: главные отличия перед арендой', href: 'https://skylift.ru/article/avtokran-i-vyshka-glavnye-otlichiya-kotorye-nuzhno-znat-pered-arendoy/' },
        { text: 'vseagp.ru — чем отличается автокран от автовышки', href: 'https://vseagp.ru/faq/chem-otlichaetsya-avtokran-ot-avtovyshki/' }
      ]}
    />
  </article>
  <section class="section wrap"><a class="btn" href="/#zayavka">Уточнить, какая техника нужна под вашу задачу →</a></section>
</main>
</SpravochnikLayout>
