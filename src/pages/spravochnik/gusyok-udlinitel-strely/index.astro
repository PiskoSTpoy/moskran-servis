---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';
import Sources from '../../../components/Sources.astro';

const title = 'Гусёк на автокране: высота против грузоподъёмности';
const description = 'Гусёк увеличивает высоту подъёма и досягаемость крана, но снижает грузоподъёмность на этом участке. Когда его использование оправдано.';

const CHECKED = '12.08.2026';

const faqs = [
  { q: 'Гусёк всегда установлен на кране или его добавляют по запросу?', a: 'Зависит от модели: у части техники гусёк — опциональное навесное оборудование, устанавливаемое под конкретную задачу, у других он предусмотрен в базовой комплектации. Мы уточняем применимость гуська под вашу задачу при расчёте заявки, а не устанавливаем его по умолчанию, если это не нужно.' },
  { q: 'Можно ли поднимать гуськом такой же груз, как основной стрелой?', a: 'Нет — грузоподъёмность на гуське заметно ниже, чем на основной стреле того же вылета. Гусёк предназначен для более лёгких грузов на увеличенной высоте или вылете, а не для замены основной стрелы по грузоподъёмности.' },
  { q: 'Как понять, нужен ли гусёк под мою задачу?', a: 'Если вес груза небольшой (обычно до 2-3 тонн для типового автокрана), а высота подъёма или вылет превышают возможности основной стрелы — гусёк может быть решением. Если груз тяжёлый, гусёк не подойдёт вне зависимости от высоты — потребуется либо основная стрела большей длины, либо более тяжёлый класс техники.' },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Гусёк на автокране', item: 'https://moskran-servis.ru/spravochnik/gusyok-udlinitel-strely/' },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@id': 'https://moskran-servis.ru/#organization' }, // ссылка на единственный узел организации (BaseLayout): отдельный узел с тем же @id, но другим name, был противоречием в графе
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: 'https://moskran-servis.ru/spravochnik/gusyok-udlinitel-strely/',
  inLanguage: 'ru-RU',
  datePublished: '2026-08-12',
  dateModified: '2026-08-12',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<SpravochnikLayout title={title} description={description} path="/spravochnik/gusyok-udlinitel-strely/" slug="gusyok-udlinitel-strely" ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Гусёк на автокране</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Разбор для заказчика</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Гусёк на автокране — когда нужен и как влияет на грузоподъёмность</h1>
    <p class="ref-byline">Инженерная служба МОСКРАН-СЕРВИС · обновлено в 2026 году</p>

    <p>На карточках парка техники мы указываем длину гуська для моделей, где он предусмотрен. Здесь разбираем, что это за элемент и когда его использование действительно оправдано.</p>

    <h2 style="margin:36px 0 16px">Что такое гусёк</h2>
    <p>Гусёк — дополнительный удлинитель, устанавливаемый на конце основной стрелы крана для увеличения высоты подъёма и вылета. У разных моделей длина гуська отличается — например, у Ивановца КС-45717 это 7 метров, у Liebherr LTM 1050-3.1 — 16 метров (подробности на страницах соответствующих моделей в разделе «Парк техники»).</p>

    <h2 style="margin:36px 0 16px">Главный компромисс: высота в обмен на грузоподъёмность</h2>
    <p>Гусёк даёт дополнительную высоту и вылет, но ценой заметного снижения грузоподъёмности на этом участке по сравнению с основной стрелой того же вылета. Это логика, аналогичная общему принципу грузовысотной характеристики (см. отдельную статью): чем дальше и выше точка подъёма от оси крана, тем меньше доступный вес. Гусёк доводит эту логику до крайней точки — на нём можно поднимать относительно лёгкие грузы, но на увеличенной высоте, недостижимой одной основной стрелой.</p>

    <h2 style="margin:36px 0 16px">Типичные задачи для гуська</h2>
    <p>Монтаж лёгких элементов на большой высоте — например, фасадных панелей, антенн, элементов кровельного ограждения на высотных зданиях (см. пример в разделе «Примеры задач» — монтаж фасада на высотном доме). Работы, где точка подъёма находится за пределами досягаемости основной стрелы, но вес груза при этом небольшой — типичный сценарий для гуська, а не для более тяжёлого класса техники.</p>

    <h2 style="margin:36px 0 16px">Когда гусёк не поможет</h2>
    <p>Если груз тяжёлый (условно, больше 2-3 тонн для типового автокрана), гусёк не решает задачу вне зависимости от требуемой высоты — грузоподъёмность на нём слишком мала для такого веса. В этом случае нужна либо более длинная основная стрела (см. модели вроде XCMG QY25K5-I с увеличенной длиной стрелы), либо переход на более тяжёлый класс техники.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: что запомнить</h2>
    <ul>
      <li>Гусёк увеличивает высоту подъёма и вылет за счёт заметного снижения грузоподъёмности на этом участке.</li>
      <li>Подходит для лёгких грузов на большой высоте, не для тяжёлых грузов.</li>
      <li>Длина гуська различается по моделям — от 7 до 16+ метров в парке нашей техники.</li>
      <li>Применимость гуська под конкретную задачу считаем на этапе расчёта заявки.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>
      <Sources
      checked={CHECKED}
      items={[
        { text: 'Руководство (инструкция) по эксплуатации конкретной машины — состав сменного оборудования, углы установки гуська и грузовые характеристики с ним' },
        { text: 'Приказ Ростехнадзора от 26.11.2020 №461 (ред. от 16.04.2026), п. 110 — установка на выносные опоры по требованиям руководства по эксплуатации', href: 'https://www.consultant.ru/document/cons_doc_LAW_373321/' },
        { text: 'Длины гуськов конкретных моделей приведены на страницах парка по данным производителей', href: '/park/' },
      ]}
    />
</article>
  <section class="section wrap"><a class="btn" href="/keysy/fasad-vysotnogo-doma/">Пример задачи с увеличенной высотой подъёма →</a></section>
</main>
</SpravochnikLayout>
