---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = "Контроль сварных швов при ремонте стрелы автокрана: ФНП 461";
const description = "При ремонте стрелы контролируют не менее 50 % длины стыка растянутого пояса и 25 % остальных стыков; высокопрочные стали — 100 % (п. 78 ФНП №461).";

const CHECKED = '25.10.2026';
const PUBLISHED = '2026-10-25';
const SLUG = "kontrol-svarnyh-shvov-pri-remonte-strely-avtokrana-fnp-461";
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    "q": "Сколько процентов сварного шва нужно проверять при ремонте стрелы?",
    "a": "Не менее 50 % длины каждого стыка растянутого пояса коробчатой или ферменной конструкции и не менее 25 % длины для остальных стыковых соединений (п. 78 ФНП №461). Для высокопрочных сталей объём составляет 100 %."
  },
  {
    "q": "Какой метод контроля обязателен для начала и конца шва?",
    "a": "Для начала и окончания швов стыковых соединений поясов и стенок коробчатых балок, колонн и стрел обязателен радиографический или ультразвуковой контроль (п. 77 ФНП №461)."
  },
  {
    "q": "Сколько раз можно переваривать один и тот же шов?",
    "a": "Повторение ремонтных сварных швов на одном и том же участке более двух раз запрещено (п. 80 ФНП №461). Способ действий после второй неудачной попытки норма не уточняет: решение принимает специализированная организация в проекте ремонта."
  },
  {
    "q": "Что проверяют до ультразвука и радиографии?",
    "a": "Визуальный и измерительный контроль стыковых соединений расчётных элементов выполняют по всей протяжённости соединения; поверхностные дефекты исправляют до других методов контроля (п. 76 ФНП №461)."
  },
  {
    "q": "Кто устанавливает объём контроля в конкретном ремонте?",
    "a": "Суммарную длину контролируемых участков устанавливает специализированная организация в проекте ремонта, реконструкции или модернизации; она не может быть меньше значений п. 78 ФНП №461."
  }
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: "Контроль сварных швов при ремонте стрелы автокрана", item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [["obyomy", "Объёмы контроля по типам соединений"], ["primer", "Пример расчёта минимальной длины контроля"], ["vizual", "Визуальный и измерительный контроль идёт первым"], ["defekt", "Что делать при недопустимых дефектах"], ["kto", "Кто определяет объём и принимает работу"], ["faq", "Частые вопросы"], ["istochniki", "Источники"]];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Контроль сварных швов при ремонте стрелы автокрана</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">ФНП №461 · Ремонт металлоконструкций</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Какой объём контроля сварных швов нужен при ремонте стрелы автокрана?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>25.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>25.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>7 мин чтения</span>
    </div>

    <p>При ремонте стрелы автокрана неразрушающему контролю подвергают не менее 50 % длины стыка растянутого пояса коробчатой или ферменной конструкции и не менее 25 % длины остальных стыковых соединений; швы из высокопрочных сталей проверяют на 100 % (п. 78 ФНП №461). Начало и конец швов поясов и стенок коробчатых стрел контролируют радиографией или ультразвуком обязательно. МОСКРАН-СЕРВИС запрашивает у исполнителя эти объёмы до допуска стрелы в работу.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="obyomy" style="margin:36px 0 16px">Объёмы контроля по типам соединений</h2>
    <p>Пункт 78 ФНП №461, на который опирается МОСКРАН-СЕРВИС при приёмке ремонта стрелы, задаёт минимальную суммарную длину контролируемых участков в проекте ремонта, реконструкции или модернизации, а пункт 77 добавляет обязательные участки независимо от процента. Для стрелы автокрана это три разных правила, и каждое относится к своему типу шва.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Соединение</th><th>Минимальный объём неразрушающего контроля</th><th>Пункт</th></tr></thead>
        <tbody>
          <tr><td>Стык растянутого пояса коробчатой или ферменной конструкции</td><td>не менее 50 % длины каждого стыка</td><td>п. 78</td></tr>
          <tr><td>Все остальные стыковые соединения</td><td>не менее 25 % длины стыка</td><td>п. 78</td></tr>
          <tr><td>Ремонтные швы из высокопрочных сталей</td><td>100 % ультразвуковой и магнитопорошковой контроль; магнитопорошковый допускается заменить капиллярным</td><td>п. 78</td></tr>
          <tr><td>Начало и окончание швов стыков поясов и стенок коробчатых балок, колонн и стрел</td><td>обязательный радиографический или ультразвуковой контроль</td><td>п. 77</td></tr>
        </tbody>
      </table>
    </div>
    <p>Сумма из таблицы — нижняя граница: объём контроля обязан обеспечивать качество выполненных сварочных работ (п. 76), а проект ремонта может его увеличить. Конкретные цифры в проекте ремонта стрелы КС-65713-1 «Галичанин» или КС-55713 «Клинцы» устанавливает специализированная организация, а МОСКРАН-СЕРВИС сверяет их с минимумом нормы.</p>
    <h2 id="primer" style="margin:36px 0 16px">Пример расчёта минимальной длины контроля</h2>
    <p>Пример (арифметика по п. 78, а не данные конкретной стрелы). Стык растянутого пояса длиной 1200 мм требует контроля не менее 50 %, то есть 1200 × 0,5 = 600 мм. Остальной стыковой шов длиной 800 мм требует не менее 25 %: 800 × 0,25 = 200 мм. Сварное соединение из высокопрочной стали той же длины 800 мм контролируют целиком — все 800 мм.</p>
    <p>МОСКРАН-СЕРВИС обращает внимание: разница между строками таблицы показывает, зачем в проекте ремонта сначала определяют, какие стыки лежат в растянутом поясе: именно на них приходится наибольший объём проверки. Расчёт ФНП №461 не отменяет обязательного контроля начала и окончания швов (п. 77).</p>
    <h2 id="vizual" style="margin:36px 0 16px">Визуальный и измерительный контроль идёт первым</h2>
    <p>Визуальный контроль и измерение стыковых сварных соединений расчётных элементов выполняют по всей протяжённости соединения; если внутренняя поверхность недоступна, осматривают только наружную (п. 76 ФНП №461). Поверхностные дефекты, найденные при таком контроле, исправляют до проведения других методов неразрушающего контроля. Порядок ФНП №461 защищает от ситуации, когда ультразвук ищет трещину, которую видно невооружённым глазом.</p>
    <h2 id="defekt" style="margin:36px 0 16px">Что делать при недопустимых дефектах</h2>
    <p>Качество ремонтного шва стрелы автокрана КС-65713-1 «Галичанин» или любой другой модели считается неудовлетворительным, если любой вид контроля нашёл дефекты, выходящие за нормы эксплуатационной документации или проекта ремонта (п. 79 ФНП №461). При выявлении недопустимых дефектов неразрушающему контролю подвергают всё соединение, а дефектные участки исправляют и подтверждают качество повторно (п. 80). Повторять ремонтный шов на одном и том же участке более двух раз запрещено — после этого участок меняют, а не заваривают снова.</p>
    <h2 id="kto" style="margin:36px 0 16px">Кто определяет объём и принимает работу</h2>
    <p>Если при ремонте автокрана применяется сварка, проект ремонта разрабатывается с учётом пп. 66–80 и содержит применяемые металлы и сварочные материалы, способы контроля, нормы браковки и порядок приёмки узлов (п. 93 ФНП №461). Соблюдение проекта контролирует служба технического контроля специализированной организации (п. 95). После ремонта запись в паспорт делает исполнитель (п. 97); о порядке допуска в работу читайте в справке о <a href="/spravochnik/remont-strely-posle-avarii-dopusk/" style="color:var(--yellow)">ремонте стрелы после аварии</a>, о разнице видов ремонта — в справке <a href="/spravochnik/ppr-vs-kapremont-krana/" style="color:var(--yellow)">ППР и капитальный ремонт</a>.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: контроль сварных швов стрелы</h2>
    <ul>
      <li>Стык растянутого пояса — не менее 50 % длины, остальные стыки — не менее 25 %, высокопрочные стали — 100 % (п. 78 ФНП №461).</li>
      <li>Начало и окончание швов поясов и стенок коробчатых стрел — обязательно радиография или ультразвук (п. 77).</li>
      <li>Сначала визуальный и измерительный контроль по всей длине стыка, потом остальные методы (п. 76).</li>
      <li>При недопустимых дефектах контролируют всё соединение; повтор шва на одном участке более двух раз запрещён (пп. 79–80).</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://www.consultant.ru/document/cons_doc_LAW_373321/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 (приказ Ростехнадзора от 26.11.2020 №461)</a> — пп. 66–67, 76–80, 93, 95, 97 (сварка при ремонте, объёмы и методы неразрушающего контроля, дефекты, повтор швов, проект ремонта).</li>
      <li><a href="https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 на legalacts.ru</a> — текст пунктов сверен 25.10.2026.</li>
    </ul>
    <p class="small muted">Пример с длинами 1200 и 800 мм — арифметическая иллюстрация; реальные объёмы для стрелы определяет проект ремонта специализированной организации.</p>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-16-25-tonn/">Аренда автокрана 16–25 тонн →</a></section>
</main>
</SpravochnikLayout>
