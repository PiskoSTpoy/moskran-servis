---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = 'Вахтенный журнал крановщика: что требует ФНП №461';
const description = 'ФНП №461 упоминает вахтенный журнал ПС в п. 112, форму утверждает сама организация (п. 147). Какие записи делают на арендованном автокране и кто.';

const CHECKED = '29.09.2026';
const PUBLISHED = '2026-09-29';
const SLUG = 'vahtennyy-zhurnal-krana';
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: 'Обязателен ли вахтенный журнал на автокране?',
    a: 'ФНП №461 прямо ссылается на вахтенный журнал ПС в п. 112: туда ИТР вносит разрешение на работу у ЛЭП по наряду-допуску. Без журнала такую запись сделать негде, поэтому на кране МОСКРАН-СЕРВИС журнал лежит в кабине на каждой смене вместе с паспортом и удостоверением крановщика.',
  },
  {
    q: 'Есть ли утверждённая форма вахтенного журнала крановщика?',
    a: 'Единой обязательной формы в ФНП №461 нет: п. 147 поручает эксплуатирующей организации самой разработать и утвердить журналы. Ростехнадзор в разъяснениях допускал брать за основу формы из прежних правил и руководящих документов, например РД 10-93-95. МОСКРАН-СЕРВИС ведёт журнал по форме, утверждённой в организации.',
  },
  {
    q: 'Кто заполняет вахтенный журнал на арендованном кране?',
    a: 'Основные записи о приёме смены и состоянии крана делает крановщик арендодателя, потому что при аренде с экипажем по ст. 632 ГК РФ эксплуатация остаётся за ним. Запись о разрешении работы у ЛЭП по п. 112 ФНП №461 вносит ИТР, ответственный за безопасное производство работ, — на объекте МОСКРАН-СЕРВИС это обычно специалист заказчика.',
  },
  {
    q: 'Можно ли работать, если журнал забыли на базе?',
    a: 'Работу у ЛЭП по наряду-допуску начинать нельзя: п. 112 ФНП №461 требует записи о разрешении именно в вахтенном журнале ПС. Для обычной смены отсутствие журнала — нарушение порядка, утверждённого организацией, и повод для замечания при проверке. МОСКРАН-СЕРВИС проверяет комплект документов в кабине до выезда машины.',
  },
  {
    q: 'Может ли заказчик попросить показать вахтенный журнал?',
    a: 'Да, ответственный за безопасное производство работ на объекте вправе проверить документы крана перед допуском к работе, включая записи о неисправностях за прошлые смены. Крановщик МОСКРАН-СЕРВИС показывает журнал вместе с паспортом крана и удостоверением; перечень документов для такой проверки собран в чек-листе допуска на сайте.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Вахтенный журнал крана', item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ['norma', 'Где журнал упомянут в ФНП №461'],
  ['forma', 'Кто утверждает форму журнала'],
  ['zapisi', 'Какие записи делают и кто'],
  ['arenda', 'Журнал при аренде крана с экипажем'],
  ['proverka', 'Что проверить заказчику'],
  ['faq', 'Частые вопросы'],
  ['istochniki', 'Источники'],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Вахтенный журнал крана</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">ФНП №461 · Документы на кране</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Нужен ли вахтенный журнал крановщика и что в него записывают?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>29.09.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>29.09.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>5 мин чтения</span>
    </div>

    <p>Вахтенный журнал ПС нужен: п. 112 ФНП №461 требует, чтобы ИТР записал в него разрешение на работу крана у линии электропередачи по наряду-допуску. Единой формы журнала правила не дают — п. 147 поручает эксплуатирующей организации самой разработать и утвердить журналы. МОСКРАН-СЕРВИС держит вахтенный журнал в кабине каждого автокрана вместе с паспортом и удостоверением крановщика.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="norma" style="margin:36px 0 16px">Где журнал упомянут в ФНП №461</h2>
    <p>Слово «вахтенный» встречается в разделе VI ФНП №461 один раз — в п. 112 о работе вблизи воздушных линий электропередачи. Пункт требует выдать крановщику наряд-допуск до начала работы, занести его в журнал выдачи нарядов-допусков, а ИТР — указать место установки крана и сделать запись в вахтенном журнале ПС о разрешении работы. МОСКРАН-СЕРВИС сверил формулировку по тексту раздела VI в редакции от 16.04.2026.</p>
    <p>Общая обязанность вести журналы вытекает из п. 147 ФНП №461: эксплуатирующая организация должна разработать и утвердить журналы, программы, графики планово-предупредительных ремонтов и производственные инструкции для персонала. Пункт 152 обязывает персонал руководствоваться этими инструкциями. МОСКРАН-СЕРВИС читает связку так: п. 147 создаёт журнал как документ организации, а п. 112 делает его обязательным местом записи у ЛЭП.</p>

    <h2 id="forma" style="margin:36px 0 16px">Кто утверждает форму журнала</h2>
    <p>Форму вахтенного журнала утверждает сама эксплуатирующая организация, потому что ФНП №461 не содержит приложения с его образцом. Специалисты Ростехнадзора в разъяснениях 2015 и 2016 годов допускали брать за основу формы журналов из ранее действовавших правил ПБ и руководящих документов РД. Самый известный образец — приложение 3 к РД 10-93-95, типовой инструкции для крановщиков башенных кранов; по его графам приёма смены и осмотра МОСКРАН-СЕРВИС советует сверять любой журнал, который показывают на объекте.</p>
    <p>Утверждённая форма и порядок ведения обычно закрепляются приказом по организации и производственной инструкцией крановщика. Проверяющий Ростехнадзора оценивает не соответствие журнала старому РД, а то, что журнал есть, утверждён и заполняется так, как требует документ самой организации. МОСКРАН-СЕРВИС поэтому советует при сомнении спрашивать у владельца крана не «правильный образец», а приказ об утверждении формы.</p>

    <h2 id="zapisi" style="margin:36px 0 16px">Какие записи делают и кто</h2>
    <p>Единственная запись, содержание и автор которой прямо заданы ФНП №461, — разрешение на работу у ЛЭП, которое вносит ИТР по п. 112. Остальное содержание определяет форма организации; по образцу РД 10-93-95 это приём и сдача смены, результат осмотра крана и выявленные неисправности. МОСКРАН-СЕРВИС разделяет в журнале записи крановщика и записи специалистов, чтобы было видно, кто за что расписался.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Запись</th><th>Кто вносит</th><th>Основание</th></tr></thead>
        <tbody>
          <tr><td>Разрешение на работу у ЛЭП по наряду-допуску</td><td>ИТР, ответственный за безопасное производство работ</td><td>ФНП №461, п. 112</td></tr>
          <tr><td>Приём и сдача смены, результат осмотра крана</td><td>Крановщик</td><td>Форма и инструкция организации (п. 147, 152)</td></tr>
          <tr><td>Выявленные неисправности и их устранение</td><td>Крановщик; отметка специалиста по содержанию ПС</td><td>Форма организации</td></tr>
          <tr><td>Проверка ведения журнала</td><td>Специалист, ответственный за содержание ПС</td><td>Порядок, утверждённый организацией</td></tr>
        </tbody>
      </table>
    </div>

    <h2 id="arenda" style="margin:36px 0 16px">Журнал при аренде крана с экипажем</h2>
    <p>При аренде по ст. 632 ГК РФ кран приезжает с экипажем, и вахтенный журнал принадлежит арендодателю вместе с машиной. Крановщик МОСКРАН-СЕРВИС ведёт в нём записи о приёме смены и состоянии крана по форме нашей организации, а журнал уезжает с краном после работы. Заказчик журнал не заводит и не хранит, но может его проверить.</p>
    <p>Запись по п. 112 ФНП №461 на объекте обычно делает специалист заказчика, ответственный за безопасное производство работ, потому что наряд-допуск у ЛЭП выдаёт организация, ведущая работы. МОСКРАН-СЕРВИС заранее уточняет в заявке, есть ли рядом линия электропередачи, чтобы наряд-допуск и ИТР были готовы к приезду крана. Порядок у ЛЭП описан в <a href="/spravochnik/rabota-krana-ryadom-s-lep/" style="color:var(--yellow)">материале о работе крана рядом с ЛЭП</a>.</p>

    <h2 id="proverka" style="margin:36px 0 16px">Что проверить заказчику</h2>
    <p>Перед допуском автокрана по ФНП №461 ответственный на объекте смотрит 3 документа в кабине: паспорт крана с отметкой об освидетельствовании, удостоверение крановщика и вахтенный журнал. В журнале полезно проверить записи последних смен: отмеченная и не устранённая неисправность прибора безопасности — повод не начинать работу. МОСКРАН-СЕРВИС не выпускает кран на объект, пока такая запись не закрыта отметкой об устранении.</p>
    <p>Роли на площадке и их обязанности МОСКРАН-СЕРВИС разбирает в <a href="/spravochnik/otvetstvennyy-za-bezopasnoe-proizvodstvo/" style="color:var(--yellow)">материале об ответственном за безопасное производство работ</a>. Полный перечень документов для допуска крана собран в <a href="/proverka-dokumentov/" style="color:var(--yellow)">чек-листе проверки документов</a>, а паспорт крана описан в <a href="/spravochnik/pasport-krana/" style="color:var(--yellow)">материале о паспорте подъёмного сооружения</a>.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: вахтенный журнал крана</h2>
    <ul>
      <li>ФНП №461, п. 112: ИТР записывает в вахтенный журнал разрешение на работу у ЛЭП.</li>
      <li>Единой формы нет — журнал утверждает эксплуатирующая организация (п. 147).</li>
      <li>Образец для формы — приложение 3 к РД 10-93-95, по разъяснению Ростехнадзора.</li>
      <li>При аренде с экипажем журнал ведёт крановщик МОСКРАН-СЕРВИС.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://sudact.ru/law/prikaz-rostekhnadzora-ot-26112020-n-461-ob/federalnye-normy-i-pravila-v/vi/ustanovka-ps-i-proizvodstvo-rabot/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461, раздел VI «Установка ПС и производство работ» (ред. от 16.04.2026)</a> — п. 112, запись в вахтенном журнале ПС.</li>
      <li><a href="https://sudact.ru/law/prikaz-rostekhnadzora-ot-26112020-n-461-ob/federalnye-normy-i-pravila-v/vi/organizatsiia-bezopasnoi-ekspluatatsii-ps-v/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461, раздел VI «Организация безопасной эксплуатации ПС»</a> — п. 147 (журналы и производственные инструкции), п. 152.</li>
      <li><a href="https://www.consultant.ru/law/podborki/vahtennyj_zhurnal_ps/" target="_blank" rel="noopener" style="color:var(--yellow)">КонсультантПлюс, подборка «Вахтенный журнал ПС»</a> — упоминание журнала в приказе Ростехнадзора №461.</li>
      <li><a href="https://krantest.ru/news/1444565447" target="_blank" rel="noopener" style="color:var(--yellow)">«Ростехнадзор разъясняет: формы документов из старых правил», krantest.ru</a> — пересказ ответов специалистов Ростехнадзора 2015–2016 гг.</li>
      <li><a href="https://meganorm.ru/Data2/1/4294853/4294853657.htm" target="_blank" rel="noopener" style="color:var(--yellow)">РД 10-93-95 «Типовая инструкция для крановщиков (машинистов) по безопасной эксплуатации башенных кранов»</a> — приложение 3, образец вахтенного журнала.</li>
      <li><a href="https://www.consultant.ru/document/cons_doc_LAW_9027/" target="_blank" rel="noopener" style="color:var(--yellow)">ГК РФ, часть вторая, ст. 632</a> — аренда транспортного средства с экипажем.</li>
    </ul>
  </article>
  <section class="section wrap"><a class="btn" href="/proverka-dokumentov/">Чек-лист документов для допуска крана →</a></section>
</main>
</SpravochnikLayout>
