---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = 'Какой автокран нужен для монтажа плит перекрытия';
const description = 'Масса плит ПК от 1,08 до 4,4 тонны, расчёт по вылету до дальней плиты, выбор между 25 и 50 тоннами, строповка и требования ФНП №461 при монтаже перекрытия.';

const CHECKED = '29.09.2026';
const PUBLISHED = '2026-09-29';
const SLUG = 'montazh-plit-perekrytiya-avtokranom';
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: 'Сколько весит плита перекрытия ПК 60-12?',
    a: 'Пустотная плита ПК 60-12-8 размером 5980 × 1190 × 220 мм весит около 2,1 тонны по таблице производителя; у разных заводов масса отличается на несколько процентов. Точную цифру МОСКРАН-СЕРВИС берёт из паспорта изделия или накладной, которые приходят вместе с плитами на объект.',
  },
  {
    q: 'Хватит ли 25-тонного автокрана для плит перекрытия частного дома?',
    a: 'Для плит длиной 6 м на вылете до 18 м 25-тонного класса обычно хватает: ПК 60-15-8 массой 2,8 тонны даёт около 50 т·м, а грузовой момент КС-55713-1К «Клинцы» — 85 т·м. Окончательно МОСКРАН-СЕРВИС подтверждает выбор по грузовысотной характеристике из паспорта крана.',
  },
  {
    q: 'Когда для плит нужен кран на 50 тонн?',
    a: 'Кран 50-тонного класса нужен, когда тяжёлая плита уходит на большой вылет: ПК 90-15-8 массой 4,4 тонны на 18 м даёт 79 т·м, что вплотную к пределу 25-тонников. КС-65713-1 «Галичанин» с грузовым моментом 175 т·м закрывает такой монтаж с запасом; смена в МОСКРАН-СЕРВИС стоит 31 200 ₽.',
  },
  {
    q: 'Нужен ли ППР на монтаж плит перекрытия автокраном?',
    a: 'ФНП №461 требует выполнять работы краном по проекту производства работ или технологической карте, где указаны схема строповки, место установки крана и опасная зона. На частном объекте МОСКРАН-СЕРВИС согласует с заказчиком упрощённую схему расстановки, но правила строповки и установки крана от этого не меняются.',
  },
  {
    q: 'Можно ли разворачивать плиту руками при подаче?',
    a: 'Руками плиту в воздухе не разворачивают: п. 115 ФНП №461 разрешает только оттяжки для разворота длинномерных грузов. По п. 114 ФНП №461 стропальщик может находиться у груза, только когда тот поднят не выше 1 м. Крановщик МОСКРАН-СЕРВИС ведёт груз по сигналам одного назначенного стропальщика.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Монтаж плит перекрытия', item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ['massa', 'Масса пустотных плит ПК'],
  ['vylet', 'Вылет до дальней плиты'],
  ['raschet', 'Пример расчёта: 25 или 50 тонн'],
  ['stropovka', 'Строповка и подача плиты'],
  ['ploshadka', 'Где поставить кран'],
  ['faq', 'Частые вопросы'],
  ['istochniki', 'Источники'],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Монтаж плит перекрытия</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Как сделать · Монтаж ЖБИ</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Какой автокран нужен для монтажа плит перекрытия?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>29.09.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>29.09.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>6 мин чтения</span>
    </div>

    <p>Для типовых пустотных плит длиной 6 м хватает автокрана 25-тонного класса: плита ПК 60-12-8 весит около 2,1 тонны, а решает не грузоподъёмность, а масса плиты на вылете до самой дальней точки укладки. МОСКРАН-СЕРВИС подбирает кран по трём цифрам: масса самой тяжёлой плиты, вылет до дальнего угла перекрытия и высота монтажного горизонта.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="massa" style="margin:36px 0 16px">Масса пустотных плит ПК</h2>
    <p>Масса пустотной плиты ПК толщиной 220 мм растёт почти линейно с площадью: от 1,08 тонны у ПК 30-12-8 до 4,4 тонны у ПК 90-15-8. С 01.01.2026 такие плиты выпускают по ГОСТ 9561-2025, который заменил ГОСТ 9561-2016; маркировка «длина-ширина-нагрузка» в дециметрах сохранилась. МОСКРАН-СЕРВИС считает кран по самой тяжёлой плите в спецификации, а не по средней, потому что ограничение крана действует на каждый подъём.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Марка плиты</th><th>Размер, мм</th><th>Масса, т</th><th>Момент на вылете 18 м, т·м</th></tr></thead>
        <tbody>
          <tr><td>ПК 30-12-8</td><td>2980 × 1190 × 220</td><td>1,08</td><td>19,4</td></tr>
          <tr><td>ПК 42-12-8</td><td>4180 × 1190 × 220</td><td>1,49</td><td>26,8</td></tr>
          <tr><td>ПК 60-12-8</td><td>5980 × 1190 × 220</td><td>2,10</td><td>37,8</td></tr>
          <tr><td>ПК 60-15-8</td><td>5980 × 1490 × 220</td><td>2,80</td><td>50,4</td></tr>
          <tr><td>ПК 72-15-8</td><td>7180 × 1490 × 220</td><td>3,20</td><td>57,6</td></tr>
          <tr><td>ПК 90-15-8</td><td>8980 × 1490 × 220</td><td>4,40</td><td>79,2</td></tr>
        </tbody>
      </table>
    </div>
    <p>Массы в таблице МОСКРАН-СЕРВИС взяла из справочной таблицы завода ЖБИ; у разных производителей одна марка отличается на несколько процентов в зависимости от класса бетона и армирования. Колонка момента — масса плиты, умноженная на 18 м, без учёта стропа; для заявки полезнее цифра из накладной на конкретную партию.</p>

    <h2 id="vylet" style="margin:36px 0 16px">Вылет до дальней плиты</h2>
    <p>Вылет считают по горизонтали от оси вращения крана до центра самой дальней плиты: при доме шириной 12 м и кране в 6 м от стены это около 18 м. Именно вылет сильнее всего снижает допустимый груз. Кран стоит у одной стороны дома, поэтому плиты у противоположной стены уходят на вылет, равный расстоянию до стены плюс ширина коробки здания. МОСКРАН-СЕРВИС просит в заявке схему участка с размерами дома и местом, где может встать кран, — по ней инженер считает вылет до выезда.</p>
    <p>Высота здесь вторична, пока монтаж идёт на первом-втором этаже: крюк должен пройти над стеной с запасом 0,5 м по п. 114 ФНП №461, плюс высота стропа. Для многоэтажной коробки высоту крюка считают так же, как при подаче груза на кровлю, — порядок описан в <a href="/spravochnik/podyom-gruza-na-kryshu-avtokranom/" style="color:var(--yellow)">материале о подъёме груза на крышу</a>. Грузовысотную характеристику МОСКРАН-СЕРВИС разбирает отдельно в <a href="/spravochnik/gruzovysotnaya-harakteristika/" style="color:var(--yellow)">материале о грузовысотной характеристике</a>.</p>

    <h2 id="raschet" style="margin:36px 0 16px">Пример расчёта: 25 или 50 тонн</h2>
    <p>Дом 10 × 12 м, кран встаёт в 6 м от стены, значит дальние плиты окажутся примерно на вылете 18 м. Плита ПК 60-15-8 массой 2,8 тонны на этом вылете даёт 50,4 т·м — меньше грузового момента КС-55713-1К «Клинцы» (85 т·м) и Челябинца КС-55732 (90 т·м). МОСКРАН-СЕРВИС в таком случае предлагает 25-тонный кран за 20 800 ₽ в смену и проверяет конкретную точку по таблице паспорта.</p>
    <p>Грузовой момент — верхняя оценка: реальная грузоподъёмность на большом вылете у автокрана ниже, чем «момент, делённый на вылет», из-за массы самой стрелы. Если в проекте ПК 90-15-8 массой 4,4 тонны, момент на 18 м вырастает до 79,2 т·м и подходит к пределу 25-тонников. МОСКРАН-СЕРВИС тогда предлагает КС-65713-1 «Галичанин» с моментом 175 т·м за 31 200 ₽ в смену — дешевле, чем простой бригады из-за недобора крана.</p>

    <h2 id="stropovka" style="margin:36px 0 16px">Строповка и подача плиты</h2>
    <p>Пустотную плиту стропят за все монтажные петли четырёхветвевым стропом или траверсой по схеме строповки из ППР или технологической карты. ФНП №461 требует, чтобы подъём выполнялся по проекту производства работ, а п. 114 — чтобы груз проходил на 0,5 м выше встречных предметов и стен. МОСКРАН-СЕРВИС привозит стропы с биркой и проверяет их перед первым подъёмом; массу стропа добавляют к массе плиты при расчёте.</p>
    <p>Пункт 115 ФНП №461 разрешает разворачивать длинномерный груз только оттяжками, поэтому шестиметровую плиту не ловят руками в воздухе. Монтажники принимают плиту над местом укладки, а п. 128 запрещает перемещать груз над перекрытием, под которым находятся люди. Схемы и углы ветвей МОСКРАН-СЕРВИС показывает в <a href="/spravochnik/shemy-stropovki-gruzov/" style="color:var(--yellow)">материале о схемах строповки</a> и в <a href="/spravochnik/ugol-naklona-stropa/" style="color:var(--yellow)">материале об угле наклона стропа</a>.</p>

    <h2 id="ploshadka" style="margin:36px 0 16px">Где поставить кран</h2>
    <p>Кран ставят на выносные опоры на подготовленном основании не ближе 1 м от строения по требованиям ФНП №461 (п. 108–110), а у края котлована — за пределами призмы обрушения. Для частного дома это обычно въезд или подготовленная щебнем площадка у фундамента, а не свежая обратная засыпка пазух. МОСКРАН-СЕРВИС выбирает точку установки так, чтобы вылет до дальних плит был минимальным, а грунт под опорами не был насыпным.</p>
    <p>Плиты удобнее всего снимать прямо с машины и сразу укладывать: так кран работает с одной точки, а площадка не загромождается штабелем. Если штабель всё же нужен, его размещают в зоне действия крана, чтобы не переставлять машину. Правила о котловане и откосе МОСКРАН-СЕРВИС разбирает в <a href="/spravochnik/rasstoyanie-ot-kotlovana/" style="color:var(--yellow)">материале о расстоянии от котлована</a>, а подготовку основания — в <a href="/spravochnik/nesushchaya-sposobnost-grunta/" style="color:var(--yellow)">материале о несущей способности грунта</a>.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: кран для плит перекрытия</h2>
    <ul>
      <li>ПК 60-12-8 — около 2,1 тонны, ПК 90-15-8 — около 4,4 тонны.</li>
      <li>Считать по самой тяжёлой плите на вылете до дальнего угла.</li>
      <li>Плиты 6 м на вылете до 18 м — обычно 25-тонный кран, 20 800 ₽ за смену.</li>
      <li>Плиты 9 м на большом вылете — 50-тонный кран, 31 200 ₽ за смену.</li>
      <li>МОСКРАН-СЕРВИС подтверждает выбор по таблице паспорта крана.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://bzsk.ru/stati/tablica-razmerov-pustotnyh-plit.html" target="_blank" rel="noopener" style="color:var(--yellow)">Таблица размеров и масс пустотных плит ПК, завод ЖБИ</a> — массы ПК 30-12-8 … ПК 90-15-8.</li>
      <li><a href="https://docs.cntd.ru/document/1314034711" target="_blank" rel="noopener" style="color:var(--yellow)">ГОСТ 9561-2025 «Плиты перекрытий железобетонные многопустотные»</a> — введён приказом Росстандарта от 16.09.2025 №1058-ст, заменил ГОСТ 9561-2016 с 01.01.2026.</li>
      <li><a href="https://sudact.ru/law/prikaz-rostekhnadzora-ot-26112020-n-461-ob/federalnye-normy-i-pravila-v/vi/ustanovka-ps-i-proizvodstvo-rabot/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461, раздел VI (ред. от 16.04.2026)</a> — п. 108–110, 114, 115, 128.</li>
      <li><a href="https://www.avtocrane.by/katalog-produkcii/avtokrany-klincy/25-tonn/ks-55713-1k-klincy" target="_blank" rel="noopener" style="color:var(--yellow)">КС-55713-1К «Клинцы», карточка дилера</a> — грузовой момент 85 т·м.</li>
      <li><a href="https://www.cmz.ru/catalogue/avtokrany/ks-55732-25-24_kamaz-65115/" target="_blank" rel="noopener" style="color:var(--yellow)">КС-55732 «Челябинец», сайт завода-изготовителя</a> — грузовой момент 90 т·м.</li>
      <li><a href="https://kran-master74.ru/heavy/truck_cranes/galichanin/avtokran_galichanin_ks_65713_1_50_t/" target="_blank" rel="noopener" style="color:var(--yellow)">КС-65713-1 «Галичанин», характеристики у дилера</a> — грузовой момент 175 т·м.</li>
    </ul>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-16-25-tonn/">Подробнее об аренде автокрана 16–25 тонн →</a></section>
</main>
</SpravochnikLayout>
