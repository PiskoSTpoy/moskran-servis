---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';
import Sources from '../../../components/Sources.astro';

const title = 'Какие СИЗ обязательны для стропальщика и крановщика';
const description = 'Сигнальный жилет, каска, защитные очки, перчатки — обязательный минимум для стропальщика и крановщика по ГОСТ 12.4.281-2021.';

const CHECKED = '12.08.2026';

const faqs = [
  { q: 'Почему у стропальщика и крановщика разные требования к обуви?', a: 'Стропальщик работает непосредственно с грузом и на площадке — ему нужна защитная обувь с защитным подноском от механических воздействий. Крановщик работает в кабине с электрооборудованием — рекомендуется диэлектрическая обувь (галоши, резиновые сапоги) для защиты от поражения электрическим током.' },
  { q: 'Обязателен ли сигнальный жилет определённого цвета?', a: 'Конкретный цвет жилета обязательным требованием не является. Жёлтый жилет, голубая рубашка и красная нарукавная повязка — это рекомендуемая форма стропальщика из Типовой инструкции РД 10-107-96 (Госгортехнадзор, 1996), написанной под Правила ПБ 10-382-00, которые не применяются с 7 марта 2014 года. Обязательное сегодня — сам факт выдачи сигнальной одежды повышенной видимости по Единым типовым нормам (приказ Минтруда России от 29.10.2021 №767н, действуют с 01.09.2023) и её соответствие ГОСТ 12.4.281-2021 по классу защиты и видимости.' },
  { q: 'Кто следит за тем, что персонал использует СИЗ на объекте?', a: 'Это часть общей организации безопасного производства работ — ответственный за безопасное производство работ (о котором мы писали в отдельной статье) следит в том числе за соблюдением требований к средствам индивидуальной защиты персонала на площадке.' },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'СИЗ стропальщика и крановщика', item: 'https://moskran-servis.ru/spravochnik/siz-stropalshchika-kranovshchika/' },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@id': 'https://moskran-servis.ru/#organization' }, // ссылка на единственный узел организации (BaseLayout): отдельный узел с тем же @id, но другим name, был противоречием в графе
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: 'https://moskran-servis.ru/spravochnik/siz-stropalshchika-kranovshchika/',
  inLanguage: 'ru-RU',
  datePublished: '2026-08-12',
  dateModified: '2026-08-12',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<SpravochnikLayout title={title} description={description} path="/spravochnik/siz-stropalshchika-kranovshchika/" slug="siz-stropalshchika-kranovshchika" ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>СИЗ стропальщика и крановщика</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Разбор для заказчика</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">СИЗ стропальщика и крановщика — обязательный комплект защиты</h1>
    <p class="ref-byline">Инженерная служба МОСКРАН-СЕРВИС · обновлено в 2026 году</p>

    <p>Мы писали про требования к квалификации стропальщика и крановщика. Отдельная, физически заметная на любом объекте часть требований — средства индивидуальной защиты (СИЗ), которые обязан использовать персонал.</p>

    <h2 style="margin:36px 0 16px">Комплект стропальщика</h2>
    <p>В обязательный комплект входят: защитная каска (шлем), сигнальный жилет 2 класса защиты, перчатки разных типов под конкретную задачу, щиток или защитные очки, при необходимости — респиратор, а также спецобувь с защитным подноском и костюм, защищающий от производственных загрязнений и механических воздействий. Состав и периодичность выдачи задают Единые типовые нормы выдачи СИЗ (приказ Минтруда России от 29.10.2021 №767н, обязательны с 1 сентября 2023 года) плюс результаты оценки рисков у конкретного работодателя.</p>
    <p>Отдельно про «форму стропальщика». Жёлтый жилет, голубая рубашка и красная нарукавная повязка, которые описывают многие отраслевые статьи, — это рекомендуемая форма из Типовой инструкции РД 10-107-96, изданной Госгортехнадзором в 1996 году под Правила ПБ 10-382-00. Правила не применяются с 7 марта 2014 года, и обязательным требованием цвет повязки сегодня не является. Практический смысл у этой традиции остался: узнаваемая по цвету фигура на площадке — это тот, кому крановщик обязан подчиняться по знаковой сигнализации, и путать его с другими рабочими опасно.</p>

    <h2 style="margin:36px 0 16px">Комплект крановщика (машиниста крана)</h2>
    <p>В обязательный комплект входят защитные очки, лицевой щиток, перчатки разных видов, каска, сигнальный жилет. Рекомендуемая спецодежда — рабочий костюм из смесовой ткани. Отдельно для обуви — диэлектрические галоши и резиновые сапоги, поскольку крановщик работает в кабине с электрооборудованием, где важна защита от поражения электрическим током. Дополнительно, в зависимости от условий, — противошумные наушники или беруши.</p>

    <h2 style="margin:36px 0 16px">Требования к сигнальному жилету</h2>
    <p>Сигнальный жилет должен соответствовать требованиям ГОСТ 12.4.281-2021 и обеспечивать видимость человека в различных условиях освещённости — это особенно важно на площадках с ограниченной видимостью или в тёмное время суток (см. отдельную статью про требования к освещённости площадки).</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: что запомнить</h2>
    <ul>
      <li>Стропальщик: каска, сигнальный жилет, перчатки, защитные очки/щиток, спецобувь с защитным подноском.</li>
      <li>Крановщик: защитные очки, каска, сигнальный жилет, диэлектрическая обувь — из-за работы с электрооборудованием кабины.</li>
      <li>Сигнальный жилет должен соответствовать ГОСТ 12.4.281-2021 по видимости.</li>
      <li>Соблюдение требований к СИЗ контролирует ответственный за безопасное производство работ.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <Sources
      checked={CHECKED}
      items={[
        { text: 'приказ Минтруда России от 29.10.2021 №767н — Единые типовые нормы выдачи СИЗ, обязательны с 01.09.2023', href: 'https://www.consultant.ru/law/hotdocs/72812.html' },
        { text: 'ГАРАНТ — ПБ 10-382-00 с отметкой «не применяется» (основание Типовой инструкции РД 10-107-96)', href: 'https://base.garant.ru/187859/' },
        { text: 'siz.trudohrana.ru — СИЗ для стропальщика', href: 'https://siz.trudohrana.ru/print/?jobId=15629' },
        { text: 'trakt.ru — СИЗ для машиниста крана', href: 'https://www.trakt.ru/profession/mashinist-krana-kranovshchik/' }
      ]}
    />
  </article>
  <section class="section wrap"><a class="btn" href="/spravochnik/trebovaniya-k-stropalshchiku/">Требования к квалификации стропальщика →</a></section>
</main>
</SpravochnikLayout>
