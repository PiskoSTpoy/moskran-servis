---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = 'Можно ли ставить автокран на газон в Москве';
const description = 'Ст. 8.25 КоАП Москвы: штраф 5 000 ₽ для граждан и 300 000 ₽ для юрлиц за технику на газоне. Что требует 743-ПП на стройплощадке и где ставить кран.';

const CHECKED = '28.09.2026';
const PUBLISHED = '2026-09-28';
const SLUG = 'avtokran-na-gazone-v-moskve';
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: 'Какой штраф за автокран на газоне в Москве?',
    a: 'Статья 8.25 Кодекса города Москвы об административных правонарушениях устанавливает штраф 5 000 ₽ для граждан, 30 000 ₽ для должностных лиц и 300 000 ₽ для юридических лиц. Автокран обычно принадлежит организации, поэтому риск считается по верхней границе. МОСКРАН-СЕРВИС по этой причине не ставит кран на озеленённую территорию.',
  },
  {
    q: 'Кто платит штраф, если кран поставили на газон по просьбе заказчика?',
    a: 'При фиксации камерой постановление получает собственник транспортного средства — так работает ст. 2.6.1 КоАП РФ. Просьба прораба или заказчика на это не влияет. МОСКРАН-СЕРВИС выбирает место установки на твёрдом покрытии и указывает его в заявке заранее, чтобы спор не возник на площадке.',
  },
  {
    q: 'Можно ли поставить выносные опоры на газон, а шасси оставить на асфальте?',
    a: 'Статья 8.25 КоАП Москвы говорит о размещении транспортного средства на газоне, и опоры крана — часть машины. Кроме штрафа, газон — слабое основание под опору: ФНП №461 требует устанавливать кран на подготовленной площадке. МОСКРАН-СЕРВИС ищет схему, при которой опоры тоже стоят на твёрдом покрытии.',
  },
  {
    q: 'Что делать, если во дворе нет места для крана вне газона?',
    a: 'Первый вариант — поставить кран на проезжей части и увеличить вылет: XCMG QY25K5-I со стрелой 38,5 м достаёт дальше, чем КС-55713-1К. Второй — оформить занятие проезда. МОСКРАН-СЕРВИС подбирает кран с запасом по вылету, чтобы не заезжать на озеленённую территорию.',
  },
  {
    q: 'Должен ли подрядчик восстановить газон после стройки?',
    a: 'Да. Пункт 3.2.1 Правил, утверждённых постановлением Правительства Москвы №743-ПП, обязывает строительные организации восстановить зелёные насаждения, нарушенные при строительстве, сразу после окончания работ. МОСКРАН-СЕРВИС не повреждает газон при работе, поэтому вопрос восстановления после крана не возникает.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Автокран на газоне', item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ['shtraf', 'Штраф по ст. 8.25 КоАП Москвы'],
  ['kto-platit', 'Кто получает постановление'],
  ['743-pp', 'Что требует 743-ПП на стройплощадке'],
  ['grunt', 'Газон как основание под опоры'],
  ['gde-stavit', 'Где поставить кран, если двор узкий'],
  ['faq', 'Частые вопросы'],
  ['istochniki', 'Источники'],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Автокран на газоне</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Москва · Площадка и благоустройство</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Можно ли ставить автокран на газон в Москве?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>28.09.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>28.09.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>5 мин чтения</span>
    </div>

    <p>Нельзя: ст. 8.25 Кодекса города Москвы об административных правонарушениях наказывает размещение транспортного средства на газоне или территории с зелёными насаждениями штрафом до 300 000 ₽ для юридического лица. Постановление Правительства Москвы №743-ПП отдельно требует держать строительную технику на твёрдом покрытии. МОСКРАН-СЕРВИС поэтому выбирает место установки крана вне газона ещё на этапе заявки.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="shtraf" style="margin:36px 0 16px">Штраф по ст. 8.25 КоАП Москвы</h2>
    <p>Статья 8.25 Закона города Москвы от 21.11.2007 №45 введена в 2015 году и устанавливает три размера штрафа в зависимости от того, кто нарушитель. Для автокрана, который почти всегда числится за организацией, действует верхняя строка таблицы — 300 000 ₽, что больше стоимости четырнадцати смен 25-тонного крана в МОСКРАН-СЕРВИС. Верховный суд РФ в определении от 18.10.2017 №5-АПГ17-87 оставил норму в силе, отклонив довод, что Москва вышла за свои полномочия.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Кто нарушитель</th><th>Штраф по ст. 8.25 КоАП Москвы</th><th>Сравнение со сменой крана 25 т (20 800 ₽)</th></tr></thead>
        <tbody>
          <tr><td>Гражданин</td><td>5 000 ₽</td><td>≈ 0,24 смены</td></tr>
          <tr><td>Должностное лицо</td><td>30 000 ₽</td><td>≈ 1,4 смены</td></tr>
          <tr><td>Юридическое лицо</td><td>300 000 ₽</td><td>≈ 14,4 смены</td></tr>
        </tbody>
      </table>
    </div>

    <h2 id="kto-platit" style="margin:36px 0 16px">Кто получает постановление</h2>
    <p>Нарушения по ст. 8.25 КоАП Москвы массово фиксируют камеры, и тогда ответственность несёт собственник транспортного средства по ст. 2.6.1 КоАП РФ, а не водитель и не заказчик работ. Устное разрешение прораба «вставай на траву» от штрафа не защищает. МОСКРАН-СЕРВИС исходит из того, что постановление придёт на организацию-владельца крана, и не соглашается на такую установку.</p>
    <p>Спор о том, кто виноват, заказчик и арендодатель решают уже по договору, а не в постановлении о штрафе. Договор аренды крана с экипажем по ст. 632 ГК РФ оставляет управление и эксплуатацию за арендодателем, поэтому место установки — зона ответственности МОСКРАН-СЕРВИС и крановщика. Распределение ответственности разобрано в <a href="/spravochnik/arenda-s-ekipazhem-i-bez/" style="color:var(--yellow)">материале об аренде с экипажем и без</a>.</p>

    <h2 id="743-pp" style="margin:36px 0 16px">Что требует 743-ПП на стройплощадке</h2>
    <p>Правила создания, содержания и охраны зелёных насаждений Москвы (постановление №743-ПП, ред. от 05.06.2024) прямо регулируют технику на стройке. Пункт 3.1.5 требует организовать отстой строительной техники на участке с твёрдым покрытием, вне участков с травостоем и сохраняемыми насаждениями. Пункт 3.8.1 не допускает движение транспортных средств и строительных машин по плодородному почвенному слою. МОСКРАН-СЕРВИС читает эти пункты как запрет и на стоянку, и на проезд крана по газону.</p>
    <p>Деревья у места работ по п. 4.1.3.8 Правил №743-ПП ограждают сплошными щитами высотой 2 м на расстоянии не менее 0,5 м от ствола, с деревянным настилом радиусом 0,5 м вокруг. Для автокрана это значит, что поворотная часть и груз не должны задевать ограждение, а опоры не ставят в его пределах. Пункт 3.2.1 обязывает строительную организацию восстановить нарушенные насаждения сразу после окончания работ; МОСКРАН-СЕРВИС учитывает ограждённые деревья при выборе точки установки.</p>

    <h2 id="grunt" style="margin:36px 0 16px">Газон как основание под опоры</h2>
    <p>Газон плох для автокрана не только из-за штрафа: ФНП №461 (п. 108–110) требует устанавливать кран на подготовленной площадке, а растительный слой с корнями и дренажем такой площадкой не является. Через выносные опоры КС-55713-1К «Клинцы» на грунт передаётся вес крана вместе с грузом, и мягкий растительный слой даёт осадку под опорой. МОСКРАН-СЕРВИС не ставит опоры на неподготовленное основание независимо от того, есть ли камера во дворе.</p>
    <p>Подкладки под опоры распределяют нагрузку, но не превращают газон в подготовленную площадку по ФНП №461 и не отменяют ст. 8.25 КоАП Москвы. Расчёт основания под опоры и признаки слабого грунта МОСКРАН-СЕРВИС разбирает в <a href="/spravochnik/nesushchaya-sposobnost-grunta/" style="color:var(--yellow)">материале о несущей способности грунта</a> и в <a href="/spravochnik/ustoychivost-krana/" style="color:var(--yellow)">материале об устойчивости крана</a>.</p>

    <h2 id="gde-stavit" style="margin:36px 0 16px">Где поставить кран, если двор узкий</h2>
    <p>Кран на асфальте проезда с длинной стрелой — самое частое решение для узкого московского двора: XCMG QY25K5-I со стрелой до 38,5 м достаёт через газон, не заезжая на него. Такой XCMG стоит в МОСКРАН-СЕРВИС столько же, сколько КС-55713-1К «Клинцы» со стрелой 21 м, — 20 800 ₽ за смену, и часто позволяет обойти газон, не переходя в класс 50 т. Длину стрелы под конкретный вылет помогает оценить <a href="/spravochnik/podyom-gruza-na-kryshu-avtokranom/" style="color:var(--yellow)">материал о подъёме груза на крышу</a>.</p>
    <p>Если кран перекрывает проезд, нужен ордер или согласование занятия проезжей части — порядок описан в <a href="/spravochnik/soglasovanie-perekrytiya-proezda/" style="color:var(--yellow)">материале о перекрытии проезда</a>. Сроки таких согласований устанавливает орган власти, и МОСКРАН-СЕРВИС их не обещает. В заявке полезно сразу отметить на схеме газоны, деревья с ограждением и люки, чтобы инженер выбрал точку установки до выезда.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: газон и автокран в Москве</h2>
    <ul>
      <li>Ст. 8.25 КоАП Москвы: 5 000 / 30 000 / 300 000 ₽.</li>
      <li>При фиксации камерой платит собственник крана (ст. 2.6.1 КоАП РФ).</li>
      <li>Правила №743-ПП: техника — только на твёрдом покрытии (п. 3.1.5).</li>
      <li>Газон — не подготовленная площадка по ФНП №461.</li>
      <li>МОСКРАН-СЕРВИС решает задачу вылетом с асфальта, а не заездом на траву.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://base.garant.ru/388521/b7b26dc50e48e368caa133acc2564b4f/" target="_blank" rel="noopener" style="color:var(--yellow)">Закон г. Москвы от 21.11.2007 №45, ст. 8.25 «Размещение транспортных средств на территории, занятой зелёными насаждениями»</a> — штрафы 5 000 / 30 000 / 300 000 ₽; статья введена Законом г. Москвы от 13.05.2015 №26.</li>
      <li><a href="https://legalacts.ru/sud/apelliatsionnoe-opredelenie-verkhovnogo-suda-rf-ot-18102017-n-5-apg17-87/" target="_blank" rel="noopener" style="color:var(--yellow)">Апелляционное определение ВС РФ от 18.10.2017 №5-АПГ17-87</a> — ст. 8.25 признана соответствующей федеральному закону.</li>
      <li><a href="https://www.mos.ru/upload/content/files/b6ff961d1920565da90cf369c30014d1/743-PP.pdf" target="_blank" rel="noopener" style="color:var(--yellow)">Постановление Правительства Москвы от 10.09.2002 №743-ПП (ред. от 05.06.2024), mos.ru</a> — п. 3.1.5, 3.2.1, 3.8.1, 4.1.3.8; сверено по тексту документа.</li>
      <li><a href="https://sudact.ru/law/prikaz-rostekhnadzora-ot-26112020-n-461-ob/federalnye-normy-i-pravila-v/vi/ustanovka-ps-i-proizvodstvo-rabot/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461, раздел VI (ред. от 16.04.2026)</a> — п. 108–110, установка крана на подготовленной площадке.</li>
      <li><a href="https://www.consultant.ru/document/cons_doc_LAW_34661/" target="_blank" rel="noopener" style="color:var(--yellow)">КоАП РФ, ст. 2.6.1</a> — ответственность собственника при автоматической фиксации.</li>
      <li><a href="https://www.consultant.ru/document/cons_doc_LAW_9027/" target="_blank" rel="noopener" style="color:var(--yellow)">ГК РФ, часть вторая, ст. 632</a> — аренда транспортного средства с экипажем.</li>
    </ul>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-16-25-tonn/">Подробнее об аренде автокрана 16–25 тонн →</a></section>
</main>
</SpravochnikLayout>
