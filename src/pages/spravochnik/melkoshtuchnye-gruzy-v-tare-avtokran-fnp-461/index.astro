---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = "Мелкоштучные грузы и кирпич на поддонах: п. 228 ФНП 461";
const description = "Мелкоштучные грузы перемещают только в специальной таре; кирпич на поддоне без ограждения допустим лишь при разгрузке и погрузке на землю (п. 228 ФНП №461).";

const CHECKED = '19.10.2026';
const PUBLISHED = '2026-10-19';
const SLUG = "melkoshtuchnye-gruzy-v-tare-avtokran-fnp-461";
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: "В чём можно перемещать мелкоштучные грузы краном?",
    a: "Только в специальной предназначенной для этого таре, исключающей выпадение отдельных частей груза (п. 228 ФНП №461). МОСКРАН-СЕРВИС проверяет тару до строповки.",
  },
  {
    q: "Можно ли разгружать кирпич с фуры на землю без ограждения?",
    a: "Да, перемещение кирпича на поддонах без ограждения допустимо при разгрузке и погрузке транспорта на землю, если иное не указано в руководстве по эксплуатации тары или в ППР (п. 228 ФНП №461).",
  },
  {
    q: "Можно ли поднять кирпич на поддоне на этаж?",
    a: "Только в таре, исключающей падение кирпича и камней. Подъём пакетов на поддонах без ограждающих устройств к рабочему месту каменщика запрещён (п. 228 ФНП №461). МОСКРАН-СЕРВИС такой подъём не выполняет.",
  },
  {
    q: "Кто может разрешить иной порядок?",
    a: "Иное может быть указано в руководстве (инструкции) по эксплуатации тары, в иных эксплуатационных документах на неё или в ППР (п. 228 ФНП №461). Устное согласие прораба документом не является.",
  },
  {
    q: "Относится ли п. 228 к керамическим камням?",
    a: "Да, в абзаце о подъёме к рабочему месту каменщика п. 228 называет и кирпич, и керамические камни. МОСКРАН-СЕРВИС применяет норму к обоим.",
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: "Мелкоштучные грузы в таре при работе автокрана по ФНП №461", item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ["tara", "Тара для мелкоштучных грузов"],
  ["poddon", "Кирпич на поддоне без ограждения"],
  ["kamenshchik", "Подъём к рабочему месту каменщика"],
  ["sravnenie", "Что допустимо, а что нет"],
  ["moskva", "Фура с кирпичом на московской площадке"],
  ["faq", "Частые вопросы"],
  ["istochniki", "Источники"],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Мелкоштучные грузы в таре при работе автокрана по ФНП №461</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">ФНП №461 · Тара и мелкоштучные грузы</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Можно ли поднимать мелкоштучные грузы и кирпич краном без тары?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>19.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>19.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>5 мин чтения</span>
    </div>

    <p>П. 228 ФНП №461 разрешает перемещать мелкоштучные грузы только в специальной таре, исключающей выпадение частей груза. Кирпич на поддоне без ограждения допустим лишь при разгрузке и погрузке транспорта на землю; подъём таких пакетов к рабочему месту каменщика запрещён. МОСКРАН-СЕРВИС не стропует пакет без тары выше уровня земли.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="tara" style="margin:36px 0 16px">Тара для мелкоштучных грузов</h2>
    <p>Мелкоштучные грузы разрешается перемещать только в специальной предназначенной для этого таре, чтобы исключить возможность выпадения отдельных частей груза (п. 228 ФНП №461). Норма не перечисляет материалы, поэтому под неё попадает всё, что состоит из россыпи единиц: кирпич, блоки, плитка, метизы. Строп, обхватывающий россыпь, тарой не считается. МОСКРАН-СЕРВИС при заявке спрашивает, в какой таре придёт груз.</p>


    <h2 id="poddon" style="margin:36px 0 16px">Кирпич на поддоне без ограждения</h2>
    <p>Перемещение кирпича на поддонах без ограждения допускается только при разгрузке (погрузке) транспортных средств на землю (и с земли), если иное не указано в руководстве (инструкции) по эксплуатации или иных эксплуатационных документах на тару либо в ППР (п. 228 ФНП №461). Условие узкое: груз идёт между кузовом и землёй. МОСКРАН-СЕРВИС для такой операции подаёт автокран КС-55713 «Клинцы» без дополнительных согласований, если ППР не требует иного.</p>


    <h2 id="kamenshchik" style="margin:36px 0 16px">Подъём к рабочему месту каменщика</h2>
    <p>Подъём поддонов с пакетами кирпича или керамических камней к рабочему месту каменщика должен осуществляться в таре, исключающей падение кирпича и камней; подъём пакетов на поддонах без ограждающих устройств запрещается (п. 228 ФНП №461). Запрет прямой, без исключений для малой высоты. Смежное требование п. 114 о мелкоштучных грузах разобрано в материале о <a href="/spravochnik/podyom-kirpicha-na-poddonah-avtokranom/" style="color:var(--yellow)">подъёме кирпича на поддонах</a>. МОСКРАН-СЕРВИС отказывает в подъёме пакета без ограждения и предлагает заказчику контейнер или тару с бортами.</p>


    <h2 id="sravnenie" style="margin:36px 0 16px">Что допустимо, а что нет</h2>
    <p>Операции с кирпичом на поддоне различаются по тому, где груз оказывается в конце. Сводка п. 228 ФНП №461, которой пользуется МОСКРАН-СЕРВИС при согласовании работ:</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Операция</th><th>Поддон без ограждения</th><th>Условие</th></tr></thead>
        <tbody>
          <tr><td>Разгрузка транспорта на землю</td><td>допустимо</td><td>если иное не указано в РЭ тары или в ППР</td></tr>
          <tr><td>Погрузка с земли на транспорт</td><td>допустимо</td><td>то же условие</td></tr>
          <tr><td>Подъём к рабочему месту каменщика</td><td>запрещено</td><td>нужна тара, исключающая падение кирпича и камней</td></tr>
          <tr><td>Мелкоштучные грузы в целом</td><td>тара обязательна</td><td>специальная тара без выпадения частей груза</td></tr>
        </tbody>
      </table>
    </div>
    <p>Таблица отражает текст пункта; чтение «земля» как уровень площадки, а не междуэтажное перекрытие, — практика проверки МОСКРАН-СЕРВИС. Требования к списку грузов и маркировке массы — в справке о <a href="/spravochnik/spisok-gruzov-s-massoy-v-zone-rabot-avtokrana-fnp-461/" style="color:var(--yellow)">списке грузов в зоне работ</a>.</p>


    <h2 id="moskva" style="margin:36px 0 16px">Фура с кирпичом на московской площадке</h2>
    <p>Практика МОСКРАН-СЕРВИС, а не отдельная норма: на московской стройке кирпич обычно приходит на поддонах с плёнкой, и заказчик просит «поднять на этаж одним махом». Разгрузка фуры на землю автокраном КС-55713 «Клинцы» укладывается в п. 228. Подъём на этаж требует тары с бортами или контейнера, которых на площадке часто нет. МОСКРАН-СЕРВИС просит заказчика определить тару заранее, чтобы не срывать смену.</p>


    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: мелкоштучные грузы и кирпич</h2>
    <ul>
      <li>МОСКРАН-СЕРВИС исходит из п. 228 ФНП №461: мелкоштучные грузы перемещают только в специальной таре.</li>
      <li>Кирпич на поддоне без ограждения допустим только при разгрузке и погрузке транспорта на землю, если иное не указано в РЭ тары или в ППР.</li>
      <li>Подъём пакетов к рабочему месту каменщика без ограждающих устройств запрещён.</li>
      <li>Иной порядок возможен лишь по документу: руководство по эксплуатации тары или ППР.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://www.consultant.ru/document/cons_doc_LAW_373321/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 (приказ Ростехнадзора от 26.11.2020 №461)</a> — п. 228 (мелкоштучные грузы, тара, кирпич на поддонах), п. 114 (смежное требование).</li>
      <li><a href="https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 на legalacts.ru</a> — редакция от 16.04.2026, текст п. 228 сверен 19.10.2026.</li>
    </ul>
    <p class="small muted">Описание московской площадки и чтение слова «земля» — практика МОСКРАН-СЕРВИС, а не пункт нормы.</p>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-16-25-tonn/">Аренда автокрана 16–25 тонн →</a></section>
</main>
</SpravochnikLayout>
