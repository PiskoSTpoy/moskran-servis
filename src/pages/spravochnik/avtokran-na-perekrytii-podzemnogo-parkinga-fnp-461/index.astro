---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = "Автокран на перекрытии паркинга: что требует ФНП 461";
const description = "ФНП №461 не называет допустимую нагрузку на перекрытие: её задаёт проект здания, а дефекты конструкции — основание не допускать кран к работе (п. 251 «н»).";

const CHECKED = '28.10.2026';
const PUBLISHED = '2026-10-28';
const SLUG = "avtokran-na-perekrytii-podzemnogo-parkinga-fnp-461";
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    "q": "Можно ли поставить автокран на перекрытие подземного паркинга?",
    "a": "ФНП №461 прямого запрета не содержит, но и допустимую нагрузку не называет. Решает проект здания: если в нём не заложена нагрузка от опор крана, ставить кран нельзя. При дефектах конструкции, превышающих допустимые по проекту, кран к работе не допускают (п. 251 «н»). Без проектных данных заказчик обязан остановиться."
  },
  {
    "q": "Кто определяет, выдержит ли перекрытие нагрузку от опор крана?",
    "a": "Проектная организация или специалист, имеющий доступ к проектной документации здания; ФНП №461 это не регламентирует. Заказчик передаёт подрядчику допустимую нагрузку на перекрытие, а подрядчик сопоставляет её с опорными реакциями из руководства по эксплуатации крана и фиксирует решение в ППР."
  },
  {
    "q": "Нужна ли экспертиза промышленной безопасности перекрытия?",
    "a": "Пункт 257 ФНП №461 требует экспертизу зданий и сооружений на опасном производственном объекте, где установлены подъёмные сооружения. Относится ли конкретный паркинг к такому объекту, определяется регистрацией ОПО. Для обычной стройплощадки ответ даёт заказчик с проектной организацией, а не подрядчик на месте."
  },
  {
    "q": "Что делать, если выносные опоры нельзя поставить на перекрытие целиком?",
    "a": "Установка на все выносные опоры — норма по умолчанию (п. 110 ФНП №461), если руководство не допускает иного. Частичный вынос или иная схема допустимы только при разрешении в руководстве по эксплуатации. Сомневаться в схеме на месте нельзя: выбирают другую площадку или меняют схему подъёма в ППР."
  },
  {
    "q": "Есть ли дополнительные требования к перемещению груза над паркингом?",
    "a": "Да: перемещение груза над перекрытиями, под которыми находятся помещения с людьми, не допускается (п. 128 ФНП №461). Для подземного паркинга с людьми или автомобилями под перекрытием маршрут и зону подъёма согласуют в ППР отдельно. Нижний край груза ведут не менее чем на 0,5 м выше препятствий (п. 102)."
  }
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: "Автокран на перекрытии паркинга", item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [["otvet", "Что ФНП №461 говорит о перекрытии и чего не говорит"], ["opory", "Выносные опоры: нагрузка идёт в плиту точками"], ["dokumenty", "Какие документы отвечают на вопрос о нагрузке"], ["tablica", "Проверка перед установкой: кто, что и по какой норме"], ["nad-lyudmi", "Груз над паркингом: ограничения п. 128 и п. 102"], ["faq", "Частые вопросы"], ["istochniki", "Источники"]];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Автокран на перекрытии паркинга</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">ФНП №461 · Площадка</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Можно ли ставить автокран на перекрытие подземного паркинга?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>28.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>28.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>7 мин чтения</span>
    </div>

    <p>ФНП №461 не называет допустимую нагрузку на перекрытие подземного паркинга: её задаёт проект здания, а ФНП лишь запрещает допускать автокран в работу, если конструкции, воспринимающие его нагрузку, имеют недопустимые дефекты (п. 251 «н»). МОСКРАН-СЕРВИС ставит КС-55713 «Клинцы» или КС-65713-1 «Галичанин» на плиту над парковкой только после того, как заказчик передал допустимую нагрузку из проекта и она сопоставлена с опорными реакциями крана.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="otvet" style="margin:36px 0 16px">Что ФНП №461 говорит о перекрытии и чего не говорит</h2>
    <p>ФНП №461 содержит одно прямое условие, относящееся к основанию под краном: эксплуатирующая организация не допускает подъёмное сооружение в работу, если здания, сооружения и конструкции, воспринимающие нагрузки от него, имеют недопустимые дефекты — трещины, деформации, разрушения, превышающие допустимые величины из проекта (п. 251 «н»). При отсутствии проектных требований применяются нормы ФНП.</p>
    <p>Допустимая нагрузка на перекрытие в ФНП №461 отсутствует: ни килограммов на квадратный метр, ни давления под опорой норма не называет. Значит, ответ на вопрос «выдержит ли плита» ищут в проекте здания, а не в справочнике, и справка МОСКРАН-СЕРВИС не заменяет этот расчёт.</p>

    <h2 id="opory" style="margin:36px 0 16px">Выносные опоры: нагрузка идёт в плиту точками</h2>
    <p>Автокран на выносных опорах передаёт массу машины и груза на основание через опорные плиты выносных опор, а не равномерно по длине базы. Установка на выносные опоры выполняется по руководству по эксплуатации крана, а если руководство не содержит требований, кран устанавливают на все выносные опоры (п. 110 ФНП №461). Для перекрытия это означает точечные нагрузки, которые плита должна воспринять в местах, где опорные плиты встанут.</p>
    <p>Опорные реакции зависят от модели и положения стрелы, поэтому их берут из руководства по эксплуатации конкретной машины. Общий порядок подготовки основания описан в справке про <a href="/spravochnik/ustanovka-opor-sv-95-avtokranom/" style="color:var(--yellow)">установку опор автокрана</a>, а несущую способность грунта — в справке про <a href="/spravochnik/nesushchaya-sposobnost-grunta/" style="color:var(--yellow)">несущую способность грунта</a>. Над парковкой роль грунта играет железобетонная плита, и проверять её надо так же строго.</p>

    <h2 id="dokumenty" style="margin:36px 0 16px">Какие документы отвечают на вопрос о нагрузке</h2>
    <p>Условия установки крана закладывают в проект организации строительства или в проект производства работ: в них прописывают соответствие крана условиям работ и безопасные расстояния до строений (пп. 155–156 ФНП №461). Допустимую нагрузку на конструкцию здания даёт проектная документация этого здания; МОСКРАН-СЕРВИС как арендодатель в её состав не входит и запрашивает данные у заказчика.</p>
    <p>Практический набор документов, который МОСКРАН-СЕРВИС просит до выезда, состоит из трёх пунктов. Это допустимая нагрузка на плиту из проекта здания, ППР с отметкой схемы установки крана и подпись ответственного ИТР о разрешении работать на этом основании. Набор составлен службой подбора как практика и не является перечнем из нормы.</p>

    <h2 id="tablica" style="margin:36px 0 16px">Проверка перед установкой: кто, что и по какой норме</h2>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Вопрос</th><th>Кто отвечает</th><th>Документ</th><th>Основание</th></tr></thead>
        <tbody>
          <tr><td>Какую нагрузку выдерживает плита над паркингом</td><td>Проектная организация / собственник здания</td><td>Проектная документация здания</td><td>п. 251 «н»</td></tr>
          <tr><td>Какие реакции передаёт кран на плиту</td><td>Изготовитель крана</td><td>Руководство по эксплуатации, паспорт</td><td>п. 110</td></tr>
          <tr><td>Есть ли дефекты плиты (трещины, деформации)</td><td>Заказчик с проектной организацией; ответственный ИТР при приёмке площадки</td><td>Акт осмотра, заключение</td><td>п. 251 «н»</td></tr>
          <tr><td>Нужна ли экспертиза здания</td><td>Владелец ОПО</td><td>Заключение ЭПБ</td><td>п. 257</td></tr>
          <tr><td>Как установить кран и вести груз</td><td>Подрядчик, ответственный за безопасное производство работ</td><td>ППР</td><td>пп. 155–156</td></tr>
        </tbody>
      </table>
    </div>
    <p>Таблица показывает, что ответственность разделена: МОСКРАН-СЕРВИС отвечает за кран и его опорные данные, а за плиту отвечает владелец здания. Ни одна из сторон не должна принимать решение вместо другой, и именно это защищает от ошибки на площадке.</p>

    <h2 id="nad-lyudmi" style="margin:36px 0 16px">Груз над паркингом: ограничения п. 128 и п. 102</h2>
    <p>Перемещение груза над перекрытиями, под которыми размещены производственные, жилые или служебные помещения с людьми, не допускается (п. 128 ФНП №461). Если под плитой паркинга находятся люди или рабочие места, маршрут груза над ней исключают или согласуют в ППР как отдельное решение. Подробнее — в справке про <a href="/spravochnik/peremeshchenie-gruza-nad-lyudmi/" style="color:var(--yellow)">перемещение груза над людьми</a>.</p>
    <p>Высота прохода груза отдельно нормируется: стрелу и поднятый груз проводят выше встречающихся конструкций, оборудования и штабелей не менее чем на 0,5 м (п. 102), а поворотная часть крана не должна подходить к строениям ближе 1 м при любом положении (п. 109). На плите над паркингом такие препятствия — вентиляционные шахты, парапеты, ограждения въезда — часто и определяют схему установки.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: автокран на перекрытии паркинга</h2>
    <ul>
      <li>Допустимую нагрузку на плиту ФНП №461 не называет — её задаёт проект здания.</li>
      <li>Дефекты конструкции, воспринимающей нагрузку крана, — основание не допускать кран к работе (п. 251 «н»).</li>
      <li>Без указаний руководства кран ставят на все выносные опоры (п. 110); нагрузка идёт точками.</li>
      <li>Груз над помещениями с людьми не перемещают (п. 128); проход выше препятствий — не менее 0,5 м (п. 102).</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://www.consultant.ru/document/cons_doc_LAW_373321/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 (приказ Ростехнадзора от 26.11.2020 №461)</a> — пп. 102, 109, 110, 128, 155, 156, 251, 257.</li>
      <li><a href="https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 на legalacts.ru</a> — текст пунктов сверен 28.10.2026.</li>
    </ul>
    <p class="small muted">Справка не заменяет проект здания, паспорт и руководство по эксплуатации конкретного автокрана: допустимую нагрузку на конструкцию определяет проектная организация.</p>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-25-40-tonn/">Аренда автокрана 25–40 тонн →</a></section>
</main>
</SpravochnikLayout>
