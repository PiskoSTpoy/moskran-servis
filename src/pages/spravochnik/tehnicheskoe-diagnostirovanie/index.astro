---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';
import Sources from '../../../components/Sources.astro';

const title = 'Диагностирование крана: отличие от освидетельствования';
const description = 'Диагностирование — часть экспертизы промышленной безопасности для кранов, отработавших нормативный срок службы, с оценкой остаточного ресурса.';

const CHECKED = '12.08.2026';

const faqs = [
  { q: 'Диагностирование проводится вместо освидетельствования?', a: 'Нет — это разные процедуры для разных ситуаций. Освидетельствование (ЧТО/ПТО) — регулярная плановая проверка на протяжении всего срока службы крана. Диагностирование — часть экспертизы промышленной безопасности, проводится в первую очередь для кранов, отработавших нормативный срок службы.' },
  { q: 'Что такое оценка остаточного ресурса?', a: 'Это часть диагностирования — определение того, сколько ещё технический ресурс крана позволит эксплуатировать его безопасно сверх нормативного срока службы. Не все элементы крана изнашиваются одинаково, и оценка остаточного ресурса даёт объективную картину, а не формальный отказ от эксплуатации по одной лишь дате.' },
  { q: 'Как это связано со статьёй про срок службы крана?', a: 'Напрямую: диагностирование — тот самый механизм, который позволяет продолжать эксплуатацию крана после истечения нормативного срока, если техническое состояние это подтверждает (см. отдельную статью про срок службы крана).' },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Техническое диагностирование', item: 'https://moskran-servis.ru/spravochnik/tehnicheskoe-diagnostirovanie/' },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@id': 'https://moskran-servis.ru/#organization' }, // ссылка на единственный узел организации (BaseLayout): отдельный узел с тем же @id, но другим name, был противоречием в графе
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: 'https://moskran-servis.ru/spravochnik/tehnicheskoe-diagnostirovanie/',
  inLanguage: 'ru-RU',
  datePublished: '2026-08-12',
  dateModified: '2026-08-12',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<SpravochnikLayout title={title} description={description} path="/spravochnik/tehnicheskoe-diagnostirovanie/" slug="tehnicheskoe-diagnostirovanie" ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Техническое диагностирование</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Разбор для заказчика</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Техническое диагностирование крана — чем отличается от освидетельствования</h1>
    <p class="ref-byline">Инженерная служба МОСКРАН-СЕРВИС · обновлено в 2026 году</p>

    <p>Мы уже разбирали техническое освидетельствование (ЧТО/ПТО) и экспертизу промышленной безопасности как отдельные, но связанные процедуры. Диагностирование — ещё один термин из этой цепочки, который стоит прояснить отдельно.</p>

    <h2 style="margin:36px 0 16px">Когда проводится диагностирование</h2>
    <p>Краны, отработавшие нормативный (назначенный) срок службы, подлежат экспертизе промышленной безопасности, в которую входят техническое диагностирование и, при необходимости, оценка остаточного ресурса. То есть диагностирование — не самостоятельная отдельная процедура, а составная часть более широкой экспертизы, применяемая в первую очередь к технике, приближающейся к концу или уже прошедшей нормативный срок службы.</p>

    <h2 style="margin:36px 0 16px">Чем это отличается от регулярного освидетельствования</h2>
    <p>Техническое освидетельствование — комплекс периодических работ по определению текущего состояния крана и соответствия нормам промышленной безопасности, проводится регулярно на протяжении всего срока службы: частичное не реже раза в год (без нагрузочных испытаний), полное не реже раза в три года (со статическими и динамическими испытаниями), а также после монтажа на новом месте, ремонта несущих металлоконструкций, замены канатов, крюка или механизмов подъёма. Диагностирование — более узкая, специализированная процедура именно для оценки остаточного ресурса возрастной техники.</p>

    <h2 style="margin:36px 0 16px">Оценка остаточного ресурса</h2>
    <p>Оценка остаточного ресурса определяет, сколько ещё технический ресурс конкретной единицы техники позволит безопасно эксплуатировать её сверх формального нормативного срока. Это не формальный запрет по дате, а объективная инженерная оценка фактического состояния — тот же принцип, что мы описывали в статье про срок службы крана: добросовестно обслуживаемая техника может оставаться безопасной и после истечения номинального срока.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: что запомнить</h2>
    <ul>
      <li>Диагностирование — часть экспертизы промышленной безопасности, применяется к кранам, отработавшим нормативный срок службы.</li>
      <li>Отличается от регулярного технического освидетельствования (ЧТО/ПТО), которое проводится на протяжении всего срока службы.</li>
      <li>Включает оценку остаточного ресурса — объективный расчёт, сколько ещё можно эксплуатировать технику.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <Sources
      checked={CHECKED}
      items={[
        { text: 'kontexgroup.ru — частичное и полное освидетельствование крана', href: 'https://kontexgroup.ru/promyshlennaya-bezopasnost/chastichnoe-i-polnoe-osvidetelstvovanie-krana.html' },
        { text: 'ros-kran.com — техническое освидетельствование грузоподъёмных кранов', href: 'https://ros-kran.com/tehnicheskoe-osvidetelstvovanie-gruzopodemnyh-kranov/' }
      ]}
    />
  </article>
  <section class="section wrap"><a class="btn" href="/spravochnik/srok-sluzhby-krana/">Срок службы крана — что происходит дальше →</a></section>
</main>
</SpravochnikLayout>
