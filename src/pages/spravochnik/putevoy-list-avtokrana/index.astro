---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';
import Sources from '../../../components/Sources.astro';

const title = 'Путевой лист автокрана: зачем нужен, кто оформляет и при чём тут ЭСМ-2';
const description = 'Путевой лист автокрана — не формальность для ГИБДД, а главный документ учёта отработанных машино-часов. Кто его выписывает при аренде с экипажем и что проверить заказчику перед подписью.';

const CHECKED = '03.09.2026';

const faqs = [
  {
    q: 'Путевой лист автокрана обязателен по закону или это внутренний документ подрядчика?',
    a: 'Обязателен. Часть 3 статьи 6 закона №259-ФЗ «Устав автомобильного транспорта...» требует путевой лист для транспортного средства при движении по дорогам, а состав обязательных сведений и порядок оформления установлены приказом Минтранса России от 28.09.2022 №390 (действует с 01.03.2023, заменил приказ №368 от 11.09.2020). Форма может быть своей — но набор реквизитов из приказа №390 в ней обязателен.',
  },
  {
    q: 'Обязательно ли использовать именно форму ЭСМ-2?',
    a: 'Нет, с 2013 года применение унифицированных форм первичной документации необязательно — организация вправе разработать собственный бланк. Но ЭСМ-2 (постановление Госкомстата РФ от 28.11.1997 №78) осталась отраслевым стандартом для стройтехники на автомобильном ходу именно потому, что она изначально рассчитана на почасовую оплату — на то, ради чего заказчик и запрашивает путевой лист.',
  },
  {
    q: 'Кто должен оформлять путевой лист — арендодатель техники или заказчик?',
    a: 'При аренде автокрана с экипажем — арендодатель, то есть владелец техники: путевой лист выписывает диспетчер или другое уполномоченное лицо его организации, а не заказчик. Это прямое следствие того, что при аренде с экипажем управление и эксплуатацию машины ведёт персонал владельца, а не заказчика — мы разбирали эту границу в статье про аренду с экипажем и без.',
  },
  {
    q: 'Что грозит, если у водителя автокрана на объекте не окажется путевого листа?',
    a: 'По части 2 статьи 12.3 КоАП РФ — предупреждение или штраф 500 рублей для водителя, если путевой лист требуется по закону, а при себе его нет. Штраф небольшой, но проверка на объекте с остановкой техники до предъявления документа — уже само по себе задержка работ, за которую в итоге отвечает подрядчик, а не заказчик.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Путевой лист автокрана', item: 'https://moskran-servis.ru/spravochnik/putevoy-list-avtokrana/' },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@id': 'https://moskran-servis.ru/#organization' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: 'https://moskran-servis.ru/spravochnik/putevoy-list-avtokrana/',
  inLanguage: 'ru-RU',
  datePublished: '2026-09-03',
  dateModified: '2026-09-03',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<SpravochnikLayout title={title} description={description} path="/spravochnik/putevoy-list-avtokrana/" slug="putevoy-list-avtokrana" ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Путевой лист автокрана</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Разбор для заказчика</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Путевой лист автокрана: зачем нужен, кто оформляет и при чём тут форма ЭСМ-2</h1>
    <p class="ref-byline">Инженерная служба МОСКРАН-СЕРВИС · обновлено 03.09.2026</p>

    <p>Мы уже разбирали, чем аренда автокрана с экипажем отличается от аренды без экипажа, и как считается оплата простоя техники. Путевой лист — документ, который стоит на стыке обеих тем: он подтверждает и факт выезда крана на линию, и количество отработанных машино-часов, из которых потом складывается счёт. Для заказчика это не бюрократическая формальность подрядчика, а бумага, которую стоит понимать — хотя бы для того, чтобы правильно расписаться в ней в конце смены.</p>

    <h2 style="margin:36px 0 16px">Два разных требования к одному документу</h2>
    <p>Путевой лист регулируется на двух уровнях, и их легко перепутать. Первый — общий для любого коммерческого транспортного средства: часть 3 статьи 6 Федерального закона от 08.11.2007 №259-ФЗ «Устав автомобильного транспорта и городского наземного электрического транспорта» требует путевой лист при движении транспортного средства по дорогам, а состав обязательных сведений и порядок оформления устанавливает приказ Минтранса России от 28.09.2022 №390 (в редакции приказа от 05.05.2023 №159) — он действует с 1 марта 2023 года и заменил прежний приказ Минтранса от 11.09.2020 №368, действовавший до этой даты. Второй уровень — отраслевой и специфичный именно для строительной техники на автомобильном ходу, к которой относится и автокран: форма №ЭСМ-2 «Путевой лист строительной машины», утверждённая постановлением Госкомстата России от 28.11.1997 №78. Она рассчитана на почасовую оплату работы машины — ровно тот случай, который типичен для аренды автокрана.</p>

    <h2 style="margin:36px 0 16px">Обязательна ли именно форма ЭСМ-2</h2>
    <p>С 1 января 2013 года применение унифицированных форм первичной учётной документации перестало быть обязательным: организация вправе разработать собственный бланк путевого листа. Юридически обязателен не сам бланк ЭСМ-2, а набор реквизитов из приказа №390. Но на практике бланк, скроенный по логике ЭСМ-2 — с красной полосой или красным шрифтом, по которому такой путевой лист легко узнать среди прочих документов на объекте, — остаётся отраслевым стандартом именно потому, что был изначально рассчитан на учёт машино-часов стройтехники, а не на километраж перевозки груза, как большинство типовых бланков для обычных грузовиков.</p>

    <h2 style="margin:36px 0 16px">Кто оформляет — подрядчик, а не заказчик</h2>
    <p>Путевой лист выписывает диспетчер или другое уполномоченное лицо организации, которой принадлежит техника, — как правило, на одну смену, день или декаду. При аренде автокрана с экипажем это прямое следствие того, кто на самом деле управляет машиной: экипаж — крановщик, а часто и стропальщик — остаётся персоналом арендодателя, и именно его диспетчерская служба ведёт учёт выхода техники на линию. Заказчик в этот процесс включён иначе: на практике путевой лист ежедневно подписывается или заверяется печатью представителя заказчика на объекте — этой подписью заказчик подтверждает фактически отработанные машино-часы. Для заказчика это и есть первичный документ, на который можно сослаться, если по итогам месяца возникнет спор о количестве смен или о том, был ли простой по вине подрядчика или по вине площадки.</p>

    <h2 style="margin:36px 0 16px">Путевой лист — не наряд-допуск</h2>
    <p>Важно не путать путевой лист с документами безопасного производства работ. Путевой лист — учётный документ: он фиксирует время работы техники и расход топлива, а не порядок действий на опасной площадке. Наряд-допуск, проект производства работ и назначение ответственного за безопасное производство работ — отдельный контур документов, который путевой лист не заменяет и не дублирует.</p>

    <h2 style="margin:36px 0 16px">Ответственность за отсутствие</h2>
    <p>Если путевой лист требуется по закону, а у водителя его при себе не оказалось, часть 2 статьи 12.3 КоАП РФ предусматривает предупреждение или штраф 500 рублей — санкция для водителя, а не для организации. Сумма штрафа некритична, но остановка автокрана на дороге до предъявления документа — это уже задержка выезда на объект, а с ней и потенциальный сдвиг графика работ.</p>

    <h2 style="margin:36px 0 16px">Как мы это учитываем</h2>
    <p>На каждую смену наш диспетчер выписывает путевой лист по форме, включающей все обязательные реквизиты из приказа №390, и передаёт его экипажу вместе с прочими документами на кран. Представителю заказчика на площадке мы предлагаем расписываться в путевом листе ежедневно, а не только в конце месяца по акту, — это упрощает разбор любых вопросов по факту отработанных часов, если они возникнут позже.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: что запомнить</h2>
    <ul>
      <li>Путевой лист автокрана обязателен по ст. 6 закона №259-ФЗ; обязательные реквизиты и порядок оформления — по приказу Минтранса России №390 от 28.09.2022 (действует с 01.03.2023, заменил приказ №368 от 2020 года).</li>
      <li>Форма ЭСМ-2 (постановление Госкомстата №78) — отраслевой стандарт для стройтехники на почасовой оплате, но с 2013 года необязательна: важен набор реквизитов, а не конкретный бланк.</li>
      <li>Оформляет путевой лист владелец техники — диспетчер арендодателя, а не заказчик; заказчик расписывается в нём ежедневно, подтверждая отработанные машино-часы.</li>
      <li>Путевой лист — учётный документ о времени и топливе, а не документ безопасности; наряд-допуск и ППР он не заменяет.</li>
      <li>За отсутствие путевого листа у водителя — предупреждение или штраф 500 руб. по ч. 2 ст. 12.3 КоАП РФ, но реальная цена вопроса — простой техники до устранения нарушения.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <Sources
      checked={CHECKED}
      items={[
        { text: 'КонсультантПлюс — статья 6 Федерального закона от 08.11.2007 №259-ФЗ «Устав автомобильного транспорта и городского наземного электрического транспорта»', href: 'https://www.consultant.ru/document/cons_doc_LAW_72388/04f8b9f0e06fa00056c90aad6ad8302d464ca2b2/' },
        { text: 'КонсультантПлюс — приказ Минтранса России от 28.09.2022 №390 «Об утверждении состава сведений... и порядка оформления... путевого листа»', href: 'https://www.consultant.ru/document/cons_doc_LAW_432726/' },
        { text: 'ГАРАНТ — приказ Минтранса России от 11.09.2020 №368 (документ не действует, заменён приказом №390)', href: 'https://base.garant.ru/74840851/' },
        { text: 'КонсультантПлюс — постановление Госкомстата России от 28.11.1997 №78, форма №ЭСМ-2 «Путевой лист строительной машины»', href: 'https://www.consultant.ru/document/cons_doc_LAW_23913/' },
        { text: 'КонсультантПлюс — статья 12.3 КоАП РФ «Управление транспортным средством водителем, не имеющим при себе документов, предусмотренных Правилами дорожного движения»', href: 'https://www.consultant.ru/document/cons_doc_LAW_34661/0486252c9b58867b61fbeadf42daad5e67b324f1/' },
      ]}
      note="Практика ежедневной подписи заказчиком путевого листа на площадке — сложившийся обычай делового оборота в аренде спецтехники, а не отдельно прописанная в приказе №390 или в постановлении №78 обязанность."
    />
  </article>
  <section class="section wrap"><a class="btn" href="/spravochnik/arenda-s-ekipazhem-i-bez/">Аренда автокрана с экипажем и без: в чём разница →</a></section>
