---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = 'Подача груза в проём перекрытия: п. 162 ФНП №461';
const description = 'Груз в проём перекрытия подают по отдельному ППР, на минимальной скорости, с зазором от края не менее 0,5 м и световой сигнализацией (п. 162 ФНП №461).';

const CHECKED = '13.10.2026';
const PUBLISHED = '2026-10-13';
const SLUG = 'podacha-gruza-v-proyom-perekrytiya-avtokranom-fnp-461';
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: 'Нужен ли отдельный ППР для подачи груза в проём перекрытия?',
    a: 'Да. Пункт 162 ФНП №461 требует производить подачу грузов в проёмы (люки) перекрытий и покрытий по специально разработанному ППР. Общего проекта на монтаж здания для этого недостаточно, если подача проёма в нём не описана. МОСКРАН-СЕРВИС просит этот раздел до выезда автокрана.',
  },
  {
    q: 'Какой зазор должен быть между грузом и краем проёма?',
    a: 'Не менее 0,5 м между краем проёма и грузом либо крюковой обоймой, если она опускается в проём. Зазор должен также обеспечивать свободное перемещение груза через проём (п. 162 ФНП №461). Если габарит груза этого не даёт, проём расширяют или груз подают иначе.',
  },
  {
    q: 'На какой высоте стропальщику можно подходить к грузу?',
    a: 'Стропальщик может подойти к грузу или отойти от него, когда груз опущен или поднят на высоту не более 1 м от поверхности, где он стоит (п. 162 ФНП №461). Выше этой отметки подходить к грузу нельзя. МОСКРАН-СЕРВИС включает эту отметку в инструктаж стропальщика перед подачей.',
  },
  {
    q: 'Что такое световая сигнализация у проёма и зачем она нужна?',
    a: 'Это сигнализация, которая предупреждает о нахождении груза над проёмом и об опускании груза через него. Пункт 162 ФНП №461 требует её у места приёма или отправки груза и у самого проёма, вместе с надписями и знаками, запрещающими стоять под грузом. Размещать её нужно так, чтобы груз или стропы не могли её повредить.',
  },
  {
    q: 'Можно ли обойтись без радиосвязи, если крановщик не видит стропальщика?',
    a: 'Можно, если выставлены сигнальщики из числа стропальщиков. Пункт 162 ФНП №461 допускает либо двустороннюю радио- или телефонную связь, либо сигнальщиков; команды сигнальщика должны быть видны крановщику и стропальщику. Перечень команд при радиосвязи утверждается внутренним актом эксплуатирующей организации.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Подача груза в проём перекрытия автокраном по ФНП №461', item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ['ppr', 'Почему нужен отдельный ППР'],
  ['zazor', 'Зазор до края проёма и скорость'],
  ['stropy', 'Подъём стропа через проём'],
  ['signalizaciya', 'Световая сигнализация и знаки'],
  ['svyaz', 'Связь между крановщиком и стропальщиком'],
  ['tablica', 'Сводка требований п. 162'],
  ['moskva', 'Что уточнить у заказчика в Москве'],
  ['faq', 'Частые вопросы'],
  ['istochniki', 'Источники'],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Подача груза в проём перекрытия автокраном по ФНП №461</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">ФНП №461 · Проёмы и люки</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Как автокраном подают груз в проём перекрытия?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>13.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>13.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>7 мин чтения</span>
    </div>

    <p>Груз в проём перекрытия подают по специально разработанному ППР: на минимальной скорости, с зазором от края проёма не менее 0,5 м и со световой сигнализацией у проёма — так требует пункт 162 ФНП №461. МОСКРАН-СЕРВИС не начинает такую подачу без ППР, где проём описан, и без назначенного сигнальщика либо радиосвязи.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="ppr" style="margin:36px 0 16px">Почему нужен отдельный ППР</h2>
    <p>Первое требование п. 162 ФНП №461 — подача грузов в проёмы и люки перекрытий и покрытий выполняется по специально разработанному ППР. Слово «специально» значит, что раздел о проёме должен быть в проекте, а не подразумеваться из общей схемы монтажа. МОСКРАН-СЕРВИС при подготовке заявки смотрит, названы ли в ППР проём, его размеры и порядок подачи.</p>
    <p>Для автокрана КС-55713 «Клинцы» или КС-65713-1 «Галичанин» проект обычно решает, с какой стороны здания стоит машина и как стрела проходит над парапетом или оконным проёмом. Состав проекта разобран в материале о <a href="/spravochnik/ppr-dlya-krana/" style="color:var(--yellow)">ППР для крана</a>, а общий порядок подъёма на перекрытие — в материале о <a href="/spravochnik/montazh-plit-perekrytiya-avtokranom/" style="color:var(--yellow)">монтаже плит перекрытия автокраном</a>.</p>

    <h2 id="zazor" style="margin:36px 0 16px">Зазор до края проёма и скорость</h2>
    <p>Расстояние между краем проёма и грузом, а при опускании крюковой обоймы в проём — между краем и обоймой, пункт 162 ФНП №461 устанавливает не менее 0,5 м. Зазор должен также обеспечивать свободное перемещение груза через проём. МОСКРАН-СЕРВИС сверяет габарит груза с размером проёма до подъёма: 0,5 м нужны с каждой стороны, где груз проходит рядом с краем.</p>
    <p>Скорость — второе условие этого же пункта: груз опускают, а крюк со стропами поднимают на минимальной скорости, не допуская раскачивания. Крановщик МОСКРАН-СЕРВИС ведёт груз короткими включениями и проверяет раскачку до входа в проём. Минимальная скорость не заменяет зазор: узкий проём не становится проходимым оттого, что кран движется медленно.</p>

    <h2 id="stropy" style="margin:36px 0 16px">Подъём стропа через проём</h2>
    <p>Для подъёма стропа через проём (люк) пункт 162 ФНП №461 требует навесить крюки стропов на разъёмное звено, а сам строп направлять снизу с помощью пенькового каната. Канат отцепляют после того, как строп выведен из проёма. МОСКРАН-СЕРВИС переносит эту операцию в инструктаж стропальщика: без разъёмного звена и каната подъём стропа через люк не начинают.</p>
    <p>Работа у проёма опасна самим положением человека: стропальщик стоит у края и руками направляет строп. Поэтому норма ограничивает подход к грузу высотой в 1 м: подойти к грузу или отойти от него разрешено, когда груз опущен или поднят на высоту не более 1 м от поверхности, где стоит стропальщик. Требования к стропальщику собраны в материале о <a href="/spravochnik/trebovaniya-k-stropalshchiku/" style="color:var(--yellow)">требованиях к стропальщику</a>.</p>

    <h2 id="signalizaciya" style="margin:36px 0 16px">Световая сигнализация и знаки</h2>
    <p>У места приёма или отправки груза и у самого проёма оборудуют световую сигнализацию: она предупреждает о нахождении груза над проёмом и об опускании груза через него (п. 162 ФНП №461). Рядом ставят надписи и знаки, запрещающие нахождение людей под перемещаемым грузом. МОСКРАН-СЕРВИС просит заказчика показать сигнализацию на площадке до начала подачи и проверяет, что она включена.</p>
    <p>Положение сигнализации тоже нормируется: её размещают так, чтобы груз или грузозахватные приспособления не могли её повредить. Подвесить лампу под перекрытием в траектории груза — нарушение условия, даже если лампа работает. Правила нахождения людей под грузом подробнее описаны в материале о <a href="/spravochnik/peremeshchenie-gruza-nad-lyudmi/" style="color:var(--yellow)">перемещении груза над людьми</a>.</p>

    <h2 id="svyaz" style="margin:36px 0 16px">Связь между крановщиком и стропальщиком</h2>
    <p>Между крановщиком и стропальщиком, находящимся вне видимости крановщика, пункт 162 ФНП №461 требует двустороннюю радио- или телефонную связь либо сигнальщиков из числа стропальщиков. Команды сигнальщика должны быть видны и крановщику, и стропальщику. МОСКРАН-СЕРВИС выбирает вариант по месту: в подвале — радиосвязь, на открытом проёме — сигнальщик в поле зрения.</p>
    <p>При радиосвязи перечень и обозначение подаваемых команд утверждаются внутренним распорядительным актом эксплуатирующей организации. Если команды не утверждены, радиосвязь не заменяет сигнальщика. Условные жесты и голосовые команды приведены в материале о <a href="/spravochnik/signaly-stropalshchika/" style="color:var(--yellow)">сигналах стропальщика</a>.</p>

    <h2 id="tablica" style="margin:36px 0 16px">Сводка требований п. 162</h2>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Элемент подачи</th><th>Требование</th><th>Значение</th></tr></thead>
        <tbody>
          <tr><td>Документ</td><td>специальный ППР</td><td>обязателен</td></tr>
          <tr><td>Скорость опускания</td><td>минимальная</td><td>без раскачки</td></tr>
          <tr><td>Зазор до края проёма</td><td>не менее</td><td>0,5 м</td></tr>
          <tr><td>Подход стропальщика</td><td>груз не выше</td><td>1 м от площадки</td></tr>
          <tr><td>Подъём стропа</td><td>разъёмное звено</td><td>пеньковый канат</td></tr>
          <tr><td>Сигнализация</td><td>световая у проёма</td><td>плюс знаки</td></tr>
          <tr><td>Связь</td><td>радио или сигнальщик</td><td>команды видны</td></tr>
          <tr><td>Проём в ферме</td><td>стены гладкие</td><td>без застреваний</td></tr>
        </tbody>
      </table>
    </div>
    <p>Последняя строка таблицы относится к проёмам в межферменном пространстве: пункт 162 ФНП №461 требует ровных, гладких стен, чтобы груз не застрял. МОСКРАН-СЕРВИС учитывает это при подаче длинномерных конструкций в ангар или цех с фермами. Что делать, если груз застрял или кран отказал, описано в материале о <a href="/spravochnik/neispravnost-krana-na-obekte/" style="color:var(--yellow)">неисправности крана на объекте</a>.</p>

    <h2 id="moskva" style="margin:36px 0 16px">Что уточнить у заказчика в Москве</h2>
    <p>В Москве подачу в проём чаще заказывают при реконструкции: вертикальный подъём оборудования в подвал, на этаж или в мансарду через монтажный проём. МОСКРАН-СЕРВИС просит четыре сведения: размер проёма в плане, массу и габарит груза, наличие ППР с разделом о проёме и кто ответственный за безопасное производство работ. Перечень составлен службой как практика, а не взят из нормы.</p>
    <p>Если проём окажется уже груза плюс зазоры, норма даёт два выхода: расширять проём либо менять способ подачи. Перечень обязанностей заказчика при выделении техники описан в материале об <a href="/spravochnik/obyazannosti-organizacii-pri-vydelenii-avtokrana/" style="color:var(--yellow)">обязанностях организации при выделении автокрана</a>.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: подача груза в проём</h2>
    <ul>
      <li>МОСКРАН-СЕРВИС подаёт груз в проём только по специальному ППР (п. 162 ФНП №461).</li>
      <li>Зазор между краем проёма и грузом МОСКРАН-СЕРВИС выдерживает не менее 0,5 м.</li>
      <li>Опускание груза и подъём крюка со стропами МОСКРАН-СЕРВИС ведёт на минимальной скорости.</li>
      <li>Стропальщик МОСКРАН-СЕРВИС подходит к грузу, когда тот не выше 1 м от его площадки.</li>
      <li>Световая сигнализация у проёма и знаки у места приёма груза обязательны по п. 162 ФНП №461.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://www.consultant.ru/document/cons_doc_LAW_373321/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 (приказ Ростехнадзора от 26.11.2020 №461)</a> — п. 162 (подача грузов в проёмы и люки перекрытий и покрытий).</li>
      <li><a href="https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 на legalacts.ru</a> — редакция от 16.04.2026, текст пункта 162 сверен 13.10.2026.</li>
    </ul>
    <p class="small muted">Минимальные размеры проёма, кроме зазора 0,5 м, в тексте нормы отсутствуют: их определяет ППР. Перечень сведений для заявки и выбор способа подачи — практика МОСКРАН-СЕРВИС.</p>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-16-25-tonn/">Аренда автокрана 16–25 тонн →</a></section>
</main>
</SpravochnikLayout>
