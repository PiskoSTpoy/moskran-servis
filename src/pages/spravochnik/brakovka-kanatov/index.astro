---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';
import Sources from '../../../components/Sources.astro';

const title = 'Браковка каната крана: уменьшение диаметра на 7%';
const description = 'Канат бракуется при уменьшении диаметра на 7% и более от номинала или по числу обрывов проволок на определённом участке — даже без видимых повреждений.';

const CHECKED = '12.08.2026';

const faqs = [
  { q: 'Можно ли определить износ каната на глаз, без замеров?', a: 'Обрывы проволок видны визуально, но уменьшение диаметра из-за поверхностного износа или коррозии на 7% и более — уже требует точного замера, а не только осмотра. Визуальный осмотр по всей длине — основной метод, но для точных данных о диаметре нужен инструментальный контроль.' },
  { q: 'Почему для канатов, работающих с опасными грузами, норма браковки строже?', a: 'Канаты кранов, предназначенных для перемещения расплавленного или раскалённого металла, огнеопасных и ядовитых веществ, бракуются при вдвое меньшем числе обрывов проволок — цена ошибки при обрыве такого каната значительно выше из-за характера груза.' },
  { q: 'Кто проверяет состояние каната — оператор или отдельный специалист?', a: 'Регулярный осмотр — часть обязанностей оператора и специалиста, ответственного за содержание крана в исправном состоянии. Это связано с обязанностями крановщика при обнаружении опасных факторов, о которых мы писали в отдельной статье — повреждение каната прямо упоминается как повод остановить работу.' },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Браковка канатов', item: 'https://moskran-servis.ru/spravochnik/brakovka-kanatov/' },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@id': 'https://moskran-servis.ru/#organization' }, // ссылка на единственный узел организации (BaseLayout): отдельный узел с тем же @id, но другим name, был противоречием в графе
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: 'https://moskran-servis.ru/spravochnik/brakovka-kanatov/',
  inLanguage: 'ru-RU',
  datePublished: '2026-08-12',
  dateModified: '2026-08-12',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<SpravochnikLayout title={title} description={description} path="/spravochnik/brakovka-kanatov/" slug="brakovka-kanatov" ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Браковка канатов</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Разбор для заказчика</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Браковка стальных канатов крана — нормы и признаки износа</h1>
    <p class="ref-byline">Инженерная служба МОСКРАН-СЕРВИС · обновлено в 2026 году</p>

    <p>Канат крана — критический элемент, напрямую удерживающий груз в воздухе. В статье про требования к стропальщику мы разбирали браковку строп; здесь — отдельная тема: браковка самого грузового каната крана.</p>

    <h2 style="margin:36px 0 16px">Браковка по числу обрывов проволок</h2>
    <p>Канаты бракуются по числу обрывов проволок, подсчитываемых на отрезке определённой длины — 6 или 30 диаметров каната, в зависимости от конкретного критерия. Для каждого каната устанавливается максимально допустимое количество обрывов на этом участке; превышение — прямое основание для замены.</p>

    <h2 style="margin:36px 0 16px">Более строгая норма для опасных грузов</h2>
    <p>Канаты кранов, предназначенных для перемещения расплавленного или раскалённого металла, огнеопасных и ядовитых веществ, бракуются при вдвое меньшем числе обрывов проволок по сравнению со стандартной нормой — цена ошибки при работе с такими грузами значительно выше.</p>

    <h2 style="margin:36px 0 16px">Браковка по уменьшению диаметра</h2>
    <p>Даже без видимых обрывов проволок канат подлежит браковке, если его диаметр уменьшился в результате поверхностного износа или коррозии на 7% и более от номинального значения. Отдельная норма — для повреждения сердечника каната (внутренний износ, обмятие, разрыв): браковка при уменьшении диаметра на 3% у некрутящихся канатов и на 10% у остальных типов.</p>

    <h2 style="margin:36px 0 16px">Как проводится контроль</h2>
    <p>Визуальный осмотр остаётся основным методом оценки состояния каната — специалист проверяет поверхность по всей длине, обращая внимание на обрывы проволок, коррозионные повреждения, деформации и износ. Для точного определения уменьшения диаметра требуется инструментальный замер, а не только визуальная оценка.</p>

    <h2 style="margin:36px 0 16px">Связь с обязанностями оператора</h2>
    <p>Повреждение каната — один из опасных факторов, при обнаружении которых оператор обязан опустить груз и остановить работу (см. отдельную статью про неисправность крана на объекте). Регулярный осмотр каната — часть стандартной практики перед началом смены, а не разовая процедура при подозрении на проблему.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: что запомнить</h2>
    <ul>
      <li>Браковка по обрывам проволок — на определённом участке длины каната, с более строгой нормой для опасных грузов.</li>
      <li>Уменьшение диаметра на 7% и более (поверхностный износ) — основание для замены даже без видимых обрывов.</li>
      <li>Повреждение сердечника — отдельная норма (3% для некрутящихся канатов, 10% для остальных).</li>
      <li>Регулярный осмотр каната — часть обязательной проверки перед сменой.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <Sources
      checked={CHECKED}
      items={[
        { text: 'ropesystems.ru — нормы браковки стальных канатов', href: 'https://ropesystems.ru/articles/id-normy-brakovki-stalnyh-kanatov' },
        { text: 'kran-mash.ru — нормы браковки канатов грузоподъёмных кранов', href: 'https://www.kran-mash.ru/poleznoe/18-normy-brakovki-kanatov-gruzopodemnyx-kranov' }
      ]}
    />
  </article>
  <section class="section wrap"><a class="btn" href="/spravochnik/neispravnost-krana-na-obekte/">Обязанности оператора при неисправности →</a></section>
</main>
</SpravochnikLayout>
