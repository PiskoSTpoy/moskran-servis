---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';
import Sources from '../../../components/Sources.astro';

const title = 'Как ограждают опасную зону работы крана';
const description = 'Граница опасной зоны — 5 м от подвижных частей крана. Знаки — по ГОСТ 12.4.026-2015, ограждение — по ГОСТ Р 58967-2020.';

const CHECKED = '21.08.2026';

/* --- Волна 17 (сплошная проверка нормативов) ---------------------------------
   Страница ссылалась на два стандарта, которые больше не действуют:
   • ГОСТ Р 12.4.026-2001 отменён с 01.03.2017 — вместо него действует
     межгосударственный ГОСТ 12.4.026-2015 (тот же предмет: сигнальные цвета,
     знаки безопасности и разметка);
   • ГОСТ 23407-78 помечен «Утратил силу в РФ» с 01.01.2021 — на смену пришёл
     ГОСТ Р 58967-2020 (приказ Росстандарта от 18.08.2020 № 504-ст).
   Статусы сверены по каталогу ФГБУ «Институт стандартизации» и docs.cntd.ru
   12.08.2026. Содержание требований при замене не изменилось — изменились
   реквизиты, на которые ссылаются в ППР и в актах на площадке. */

const faqs = [
  { q: 'Кто устанавливает ограждение опасной зоны — заказчик или подрядчик по крану?', a: 'Организация ограждения площадки в целом — обычно зона ответственности генподрядчика объекта. Мы, как подрядчик по крану, обеспечиваем корректный расчёт границы опасной зоны для конкретной работы и координируем с ответственным на площадке, чтобы ограждение соответствовало реальной зоне действия стрелы.' },
  { q: 'Что происходит, если человек оказывается в опасной зоне во время подъёма?', a: 'Крановщик обязан снизить скорость перемещения груза до минимальной за 1 метр до предупреждающего знака и далее двигаться короткими повторными включениями — а при необходимости остановить работу до освобождения зоны. Нахождение людей под стрелой крана — прямое нарушение, которое обязан не допускать ответственный за безопасное производство работ.' },
  { q: 'Нужно ли согласование, если опасная зона выходит за забор стройплощадки?', a: 'Да, при выходе опасной зоны работы крана за периметр площадки требуется дополнительное сигнальное ограждение и согласование с уполномоченными организациями — ГИБДД, архитектурой, пожарной службой, в зависимости от конкретной ситуации.' },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Опасная зона крана', item: 'https://moskran-servis.ru/spravochnik/opasnaya-zona-krana/' },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@id': 'https://moskran-servis.ru/#organization' }, // ссылка на единственный узел организации (BaseLayout): отдельный узел с тем же @id, но другим name, был противоречием в графе
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: 'https://moskran-servis.ru/spravochnik/opasnaya-zona-krana/',
  inLanguage: 'ru-RU',
  datePublished: '2026-08-12',
  dateModified: '2026-08-21',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<SpravochnikLayout title={title} description={description} path="/spravochnik/opasnaya-zona-krana/" slug="opasnaya-zona-krana" ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Опасная зона крана</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Разбор для заказчика</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Опасная зона крана — ограждение и предупреждающие знаки</h1>
    <p class="ref-byline">Инженерная служба МОСКРАН-СЕРВИС · обновлено в 2026 году</p>

    <p>На объекте, где работает кран, физическая зона возможного перемещения груза — не абстракция, а чётко обозначенное и огороженное пространство. Разбираем требования к этой зоне.</p>

    <h2 style="margin:36px 0 16px">Размер опасной зоны</h2>
    <p>На объекте строительства от задействованных машин и механизмов выделяется граница опасной зоны, равная 5 метрам от подвижных рабочих органов оборудования — применительно к крану это зона вокруг стрелы и груза при перемещении с учётом возможного отклонения.</p>

    <h2 style="margin:36px 0 16px">Требования к ограждению и знакам</h2>
    <p>Границу опасной зоны обозначают предупреждающими знаками в соответствии с ГОСТ 12.4.026-2015 «ССБТ. Цвета сигнальные, знаки безопасности и разметка сигнальная». Знаки устанавливаются из расчёта видимости границы зоны, а в тёмное время суток должны быть освещены — это отдельное требование, пересекающееся с общими нормами освещённости площадки, о которых мы писали в отдельной статье.</p>
    <p>Если опасная зона выходит за периметр (забор) стройплощадки, требуется дополнительное сигнальное ограждение — технические условия на инвентарные ограждения задаёт ГОСТ Р 58967-2020. Вынос ограждения за периметр требует согласования с уполномоченными организациями: ГИБДД, архитектурой, пожарной службой, в зависимости от конкретной ситуации на объекте.</p>
    <p><b>Проверьте реквизиты в чужом ППР.</b> Оба стандарта на этой странице сменились недавно, и старые номера продолжают ходить по типовым проектам производства работ. ГОСТ Р 12.4.026-2001 отменён с 1 марта 2017 года, ГОСТ 23407-78 помечен утратившим силу в России с 1 января 2021 года. Требования по существу при замене не изменились, но ссылка на отменённый стандарт в ППР — тот же индикатор невычитанного шаблона, что и ссылка на ПБ 10-382-00 в договоре.</p>

    <h2 style="margin:36px 0 16px">Обязанность крановщика при приближении к границе</h2>
    <p>Крановщик обязан не менее чем за 1 метр до предупреждающего знака снизить скорость перемещения груза до минимальной и далее перемещать груз короткими повторными включениями — это не рекомендация, а конкретное требование, встроенное в порядок работы оператора вблизи границы опасной зоны.</p>

    <h2 style="margin:36px 0 16px">Кто отвечает за ограждение на практике</h2>
    <p>Организация ограждения площадки в целом — обычно зона ответственности генподрядчика объекта. Мы как подрядчик по крану рассчитываем реальную границу опасной зоны для конкретной задачи (с учётом вылета, высоты и типа груза) и координируем это с ответственным на площадке — недопущение людей в этой зоне также входит в обязанности лица, ответственного за безопасное производство работ (см. отдельную статью).</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: что запомнить</h2>
    <ul>
      <li>Опасная зона — минимум 5 м от подвижных частей крана и груза.</li>
      <li>Обозначается знаками по ГОСТ 12.4.026-2015, с освещением в тёмное время суток.</li>
      <li>При выходе зоны за периметр площадки — дополнительное согласованное сигнальное ограждение; технические условия — ГОСТ Р 58967-2020.</li>
      <li>Старые номера — ГОСТ Р 12.4.026-2001 и ГОСТ 23407-78 — не действуют; встретили их в ППР — проверьте документ целиком.</li>
      <li>Крановщик обязан снижать скорость перемещения груза за 1 м до предупреждающего знака.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <Sources
      checked={CHECKED}
      items={[
        { text: 'ГОСТ 12.4.026-2015 — действует с 01.03.2017 вместо ГОСТ Р 12.4.026-2001', href: 'https://docs.cntd.ru/document/1200136061' },
        { text: 'карточка ГОСТ 23407-78 — отметка «Утратил силу в РФ», замена на ГОСТ Р 58967-2020', href: 'https://www.gostinfo.ru/catalog/Details/?id=4149811' },
        { text: 'ГОСТ Р 58967-2020 — приказ Росстандарта от 18.08.2020 № 504-ст, дата введения 01.01.2021', href: 'https://base.garant.ru/400294960/' },
        { text: 'centr-teh.ru — зоны работы стрелового крана', href: 'https://centr-teh.ru/blog/podemnye-krany/zony-raboty-strelovogo-krana' }
      ]}
    />
  </article>
  <section class="section wrap"><a class="btn" href="/spravochnik/otvetstvennyy-za-bezopasnoe-proizvodstvo/">Кто следит за соблюдением этих требований →</a></section>
</main>
</SpravochnikLayout>
