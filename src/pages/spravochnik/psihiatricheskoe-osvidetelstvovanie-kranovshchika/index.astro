---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';
import Sources from '../../../components/Sources.astro';

const title = 'Психиатрическое освидетельствование крановщика: зачем и как часто';
const description = 'Крановщик — в перечне профессий, где психиатрическое освидетельствование обязательно не реже раза в 5 лет по приказу Минздрава №342н. Чем это отличается от предрейсового медосмотра и аттестации.';

const CHECKED = '08.09.2026';

const faqs = [
  { q: 'Психиатрическое освидетельствование — это то же самое, что предрейсовый медосмотр водителя?', a: 'Нет, это два разных документа с разной нормативной базой и периодичностью. Предрейсовый медосмотр (о котором мы писали в отдельной статье) — ежедневная проверка перед выездом по приказу Минздрава №266н, привязанная к безопасности дорожного движения. Психиатрическое освидетельствование — проверка психического здоровья работника, занятого на работах с источником повышенной опасности, проводится не чаще одного раза в 5 лет и регулируется отдельным приказом Минздрава — №342н.' },
  { q: 'Почему в списке именно крановщик, а не любой водитель автокрана?', a: 'Основание для включения — управление подъёмным сооружением, подлежащим учёту в органах Ростехнадзора, а не факт вождения транспортного средства как такового. Поэтому в перечень видов деятельности из приложения №2 к приказу №342н попадает работа именно с краном как с опасным техническим устройством, а не с грузовым автомобилем.' },
  { q: 'Кто проводит освидетельствование — любой психиатр в поликлинике по месту жительства?', a: 'Нет, освидетельствование проводит врачебная комиссия, созданная в медицинской организации, имеющей соответствующую лицензию, — а не один врач-психиатр по личному обращению работника. Направление на освидетельствование выдаёт работодатель, а не сам работник по собственной инициативе.' },
  { q: 'Что грозит компании, если крановщик работает без действующего освидетельствования?', a: 'Допуск работника к деятельности из перечня приложения №2 без пройденного в срок психиатрического освидетельствования — нарушение требований охраны труда, а сама обязанность его организовать и оплатить лежит на работодателе в силу статьи 213 Трудового кодекса РФ. Заказчику аренды крана это прямо не грозит, но подтверждает общий уровень кадровой дисциплины подрядчика.' },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Психиатрическое освидетельствование крановщика', item: 'https://moskran-servis.ru/spravochnik/psihiatricheskoe-osvidetelstvovanie-kranovshchika/' },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@id': 'https://moskran-servis.ru/#organization' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: 'https://moskran-servis.ru/spravochnik/psihiatricheskoe-osvidetelstvovanie-kranovshchika/',
  inLanguage: 'ru-RU',
  datePublished: '2026-09-08',
  dateModified: '2026-09-08',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<SpravochnikLayout title={title} description={description} path="/spravochnik/psihiatricheskoe-osvidetelstvovanie-kranovshchika/" slug="psihiatricheskoe-osvidetelstvovanie-kranovshchika" ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Психиатрическое освидетельствование крановщика</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Разбор для заказчика</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Психиатрическое освидетельствование крановщика: зачем и как часто</h1>
    <p class="ref-byline">Инженерная служба МОСКРАН-СЕРВИС · обновлено 08.09.2026</p>

    <p>Мы уже писали про предрейсовый медицинский осмотр водителя автокрана и про аттестацию крановщика — проверку знаний и практических навыков. Есть третья, отдельная проверка, о которой заказчики часто не знают вовсе: обязательное психиатрическое освидетельствование. Это не разновидность обычного медосмотра, а отдельная процедура с собственной нормативной базой, периодичностью и порядком направления.</p>

    <h2 style="margin:36px 0 16px">Что это за освидетельствование</h2>
    <p>Психиатрическое освидетельствование — это проверка психического здоровья работника, занятого на работах, связанных с источником повышенной опасности, то есть там, где ошибка человека может привести к аварии или травмированию окружающих. Обязанность работодателя направлять таких сотрудников на освидетельствование установлена статьёй 213 Трудового кодекса РФ, а конкретный порядок прохождения, периодичность и перечень видов деятельности, подпадающих под это требование, определены приказом Минздрава России от 20.05.2022 №342н. Документ действует с 1 сентября 2022 года и заменил прежний порядок, установленный постановлением Правительства РФ от 23.09.2002 №695.</p>

    <h2 style="margin:36px 0 16px">Почему в перечне — именно крановщик</h2>
    <p>Приложение №2 к приказу №342н перечисляет виды деятельности, при осуществлении которых освидетельствование обязательно. В этот перечень попадает управление подъёмными механизмами (кранами), подлежащими учёту в органах Ростехнадзора, — то есть основанием служит работа именно с краном как с опасным техническим устройством, а не факт управления транспортным средством вообще. Это отличает данное требование от предрейсового медосмотра водителя, который привязан к безопасности дорожного движения и проводится перед каждым выездом, а не раз в несколько лет.</p>

    <h2 style="margin:36px 0 16px">Периодичность и кто направляет</h2>
    <p>Освидетельствование проводится не реже одного раза в 5 лет — сотрудник не проходит его по собственной инициативе и не выбирает врача самостоятельно: направление оформляет работодатель, а само освидетельствование проводит врачебная комиссия в медицинской организации, имеющей лицензию на этот вид деятельности, а не один психиатр в обычной поликлинике по месту жительства. Итог освидетельствования — заключение комиссии о наличии или отсутствии медицинских противопоказаний к конкретному виду деятельности.</p>

    <h2 style="margin:36px 0 16px">Чем новый порядок отличается от прежнего</h2>
    <p>До 1 сентября 2022 года действовал похожий по смыслу порядок, установленный постановлением Правительства РФ №695 от 2002 года, — и периодичность в 5 лет сохранилась без изменений при переходе к новому документу. Изменился уровень акта (постановление Правительства заменено приказом профильного министерства) и отдельные процедурные детали, но сама обязанность и её адресаты — работники, чья деятельность входит в перечень источников повышенной опасности, включая управление кранами, — остались прежними.</p>

    <h2 style="margin:36px 0 16px">Что это значит для заказчика аренды крана</h2>
    <p>Формально обязанность организовать и оплатить освидетельствование лежит на работодателе крановщика — эксплуатирующей организации, а не на заказчике услуги аренды. Но, как и с удостоверением на право управления краном или свидетельством об аттестации, это законный вопрос, который заказчик вправе задать подрядчику при выборе исполнителя: отсутствие пройденного в срок освидетельствования у оператора — сигнал о кадровой дисциплине компании в целом, а не только формальный пробел в личном деле сотрудника.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: что запомнить</h2>
    <ul>
      <li>Психиатрическое освидетельствование — отдельная процедура, не совпадающая ни с предрейсовым медосмотром водителя, ни с аттестацией крановщика.</li>
      <li>Основание — приказ Минздрава России от 20.05.2022 №342н, действует с 01.09.2022, заменил постановление Правительства РФ №695 от 2002 года.</li>
      <li>Периодичность — не реже одного раза в 5 лет; направление выдаёт работодатель, освидетельствование проводит врачебная комиссия, а не один врач по обращению работника.</li>
      <li>В перечень видов деятельности приложения №2 к приказу №342н попадает управление кранами, подлежащими учёту в Ростехнадзоре.</li>
      <li>Заказчик вправе спросить у подрядчика подтверждение пройденного освидетельствования — как и другие документы на оператора техники.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <Sources
      checked={CHECKED}
      items={[
        { text: 'КонсультантПлюс — приказ Минздрава России от 20.05.2022 №342н «Об утверждении порядка прохождения обязательного психиатрического освидетельствования работниками…»', href: 'https://www.consultant.ru/document/cons_doc_LAW_417970/' },
        { text: 'ГАРАНТ — приказ Министерства здравоохранения РФ от 20.05.2022 №342н, приложение №2 «Виды деятельности…»', href: 'https://base.garant.ru/404766305/f7ee959fd36b5699076b35abf4f52c5c/' },
        { text: 'ГАРАНТ — постановление Правительства РФ от 23.09.2002 №695 (утратило силу с 01.09.2022)', href: 'https://base.garant.ru/12128252/' },
      ]}
      note="Приказ №342н действует с изменениями (в т.ч. от 02.07.2025); периодичность и включение крановщика в перечень приложения №2 при последующих правках не менялись, но перед подачей заявления в конкретную медицинскую организацию стоит сверяться с актуальной редакцией."
    />
  </article>
  <section class="section wrap"><a class="btn" href="/spravochnik/predreysovyy-medosmotr-voditelya/">Предрейсовый медосмотр водителя автокрана →</a></section>
</main>
</SpravochnikLayout>
