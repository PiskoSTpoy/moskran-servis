---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';
import Sources from '../../../components/Sources.astro';

const title = 'СОУТ на рабочем месте крановщика: кто обязан её проводить';
const description = 'Специальная оценка условий труда обязательна и для передвижного рабочего места крановщика в кабине автокрана — разбираем периодичность, класс условий труда и кто отвечает за неё при аренде с экипажем.';

const CHECKED = '15.09.2026';

const faqs = [
  {
    q: 'Кто обязан проводить СОУТ на рабочем месте крановщика — арендодатель техники или заказчик?',
    a: 'Обязанность лежит на работодателе, то есть на компании, которая держит крановщика в штате. При аренде автокрана с экипажем — а справочник уже разбирал, почему это единственный формат, в котором мы предоставляем технику, — крановщик остаётся работником подрядчика на весь период работ, поэтому и специальная оценка его рабочего места, и все вытекающие из неё гарантии — обязанность подрядчика, а не заказчика. Заказчику не нужно организовывать СОУТ самостоятельно, но действующие результаты оценки стоит держать в уме как часть стандартной проверки подрядчика — наравне с аттестацией оператора и документами на саму машину.',
  },
  {
    q: 'Как часто нужно повторять СОУТ на одном и том же рабочем месте?',
    a: 'По части 4 статьи 8 закона №426-ФЗ — не реже одного раза в пять лет, отсчитывая от даты внесения предыдущих результатов в федеральную систему учёта. Из этого правила есть исключение: если по итогам оценки условия труда признаны оптимальными или допустимыми и на них подана декларация соответствия, повторная плановая оценка не требуется до тех пор, пока не появятся основания для внеплановой — например, несчастный случай на этом рабочем месте или предписание инспекции труда.',
  },
  {
    q: 'Нужно ли оценивать каждый автокран в парке отдельно, если модели одинаковые?',
    a: 'Не обязательно — закон вводит понятие аналогичных рабочих мест: одна и та же профессия, одинаковые трудовые функции, режим работы и однотипное оборудование. Для парка из нескольких одинаковых по модели автокранов это означает, что комиссия вправе провести измерения выборочно — не менее чем на 20% таких рабочих мест и не менее чем на двух — и распространить результат на все места, признанные аналогичными. Экономит время и деньги там, где парк действительно однороден, но требует, чтобы аналогичность была реальной, а не формальной: разные шасси, разная грузоподъёмность или разный режим работы — уже повод оценивать раздельно.',
  },
  {
    q: 'Что меняется, если по СОУТ рабочему месту крановщика присвоен вредный класс условий труда?',
    a: 'Вредный класс — это класс 3 с подклассами от 3.1 до 3.4 по нарастанию степени вредности, отдельно от него — класс 4, опасный. Присвоение классов 3.2 и выше запускает для работодателя обязанности, которых нет при допустимых условиях: дополнительные гарантии и компенсации работнику по Трудовому кодексу, а также дополнительный тариф страховых взносов на обязательное пенсионное страхование по статье 428 Налогового кодекса РФ, который растёт вместе с классом. Точный размер тарифа для конкретного подкласса — расчёт, который делает бухгалтерия по данным самой оценки, а не общее число, которое можно назвать заранее без итогов конкретной СОУТ.',
  },
  {
    q: 'Что грозит компании, которая вообще не провела СОУТ на рабочих местах крановщиков?',
    a: 'Административная ответственность по статье 5.27.1 КоАП РФ за нарушение порядка проведения специальной оценки или её непроведение: предупреждение либо штраф от 5 000 до 10 000 рублей на должностных лиц и индивидуальных предпринимателей, от 60 000 до 80 000 рублей — на юридических лиц. Кроме прямого штрафа, отсутствие действующей СОУТ обычно всплывает при любой более серьёзной проверке — например, после несчастного случая на площадке, — и в этот момент превращается уже не в формальный, а в содержательный вопрос к системе управления охраной труда в компании.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'СОУТ на рабочем месте крановщика', item: 'https://moskran-servis.ru/spravochnik/sout-kranovshchika-i-stropalshchika/' },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@id': 'https://moskran-servis.ru/#organization' }, // ссылка на единственный узел организации (BaseLayout): отдельный узел с тем же @id, но другим name, был противоречием в графе
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: 'https://moskran-servis.ru/spravochnik/sout-kranovshchika-i-stropalshchika/',
  inLanguage: 'ru-RU',
  datePublished: '2026-09-15',
  dateModified: '2026-09-15',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<SpravochnikLayout title={title} description={description} path="/spravochnik/sout-kranovshchika-i-stropalshchika/" slug="sout-kranovshchika-i-stropalshchika" ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>СОУТ на рабочем месте крановщика</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Разбор для заказчика</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Специальная оценка условий труда на рабочем месте крановщика: кто обязан её проводить</h1>
    <p class="ref-byline">Инженерная служба МОСКРАН-СЕРВИС · обновлено 15.09.2026</p>

    <p>Справочник уже писал, что мы предоставляем автокран только с экипажем и почему это принципиальная позиция, а не формальность: ответственность за безопасную эксплуатацию машины на весь период работ остаётся у подрядчика. Из этого же принципа следует менее очевидная обязанность — специальная оценка условий труда (СОУТ) на рабочем месте крановщика тоже дело подрядчика, а не заказчика. Разбираем, что это за процедура и почему у автокрана она устроена чуть сложнее, чем в обычном офисе или цехе.</p>

    <h2 style="margin:36px 0 16px">Почему кабина автокрана — тоже рабочее место по закону</h2>
    <p>Федеральный закон от 28.12.2013 №426-ФЗ «О специальной оценке условий труда» обязывает работодателя оценивать условия на каждом рабочем месте, и место крановщика не исключение, хотя оно и не привязано к одному помещению — сегодня это один объект в Москве, завтра другой. Методика проведения СОУТ, утверждённая приказом Минтруда России от 24.01.2014 №33н вместе с классификатором вредных и опасных производственных факторов, прямо распространяется и на нестационарные рабочие места, и на работы разъездного характера. Для крановщика это означает, что измерения — шум, вибрация, параметры микроклимата в кабине — проводятся в штатном режиме работы машины, а не в лаборатории или в статике на стоянке.</p>

    <h2 style="margin:36px 0 16px">Периодичность и что её продлевает</h2>
    <p>По части 4 статьи 8 закона №426-ФЗ плановая СОУТ повторяется не реже одного раза в пять лет — отсчёт идёт от даты внесения предыдущих результатов в федеральную информационную систему учёта. Если по итогам оценки условия труда на месте крановщика признаны оптимальными или допустимыми (классы 1 и 2 по статье 14 закона) и работодатель подал декларацию соответствия, повторную плановую оценку проводить не нужно до тех пор, пока не возникнут основания для внеплановой — несчастный случай на этом месте, жалоба работника или предписание государственной инспекции труда.</p>

    <h2 style="margin:36px 0 16px">Один автокран или весь парк: что такое аналогичные рабочие места</h2>
    <p>Компании, у которой в парке несколько одинаковых по модели автокранов, не обязательно поголовно оценивать каждую машину. Закон вводит понятие аналогичных рабочих мест — те же профессия и трудовые функции, тот же режим работы, однотипное оборудование и одинаковые средства индивидуальной защиты. При таком совпадении комиссия вправе провести измерения выборочно, не менее чем на 20% рабочих мест этой группы и не менее чем на двух, а результат распространить на все признанные аналогичными. Разные шасси, разная грузоподъёмность или разный график работы конкретной машины — уже повод не признавать места аналогичными и оценивать их отдельно.</p>

    <h2 style="margin:36px 0 16px">Что меняет вредный класс условий труда</h2>
    <p>Если по итогам оценки рабочему месту присвоен класс 3 (вредный, с подклассами от 3.1 до 3.4 по нарастанию) или класс 4 (опасный), у работодателя появляются обязанности сверх обычных: гарантии и компенсации работнику по Трудовому кодексу и дополнительный тариф страховых взносов на обязательное пенсионное страхование по статье 428 Налогового кодекса РФ, размер которого растёт вместе с классом. Точную ставку для конкретного случая считает бухгалтерия по итогам самой оценки — это расчётная, а не справочная величина, и называть её заранее, без результатов конкретной СОУТ, было бы неверно.</p>

    <h2 style="margin:36px 0 16px">Ответственность за отсутствие СОУТ</h2>
    <p>Нарушение порядка проведения специальной оценки или её полное отсутствие — статья 5.27.1 КоАП РФ: предупреждение либо штраф от 5 000 до 10 000 рублей для должностных лиц и индивидуальных предпринимателей, от 60 000 до 80 000 рублей — для юридических лиц. На практике отсутствие действующей СОУТ редко всплывает само по себе — обычно это находка более серьёзной проверки, например после несчастного случая на объекте, и тогда вопрос перестаёт быть формальным.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: что запомнить</h2>
    <ul>
      <li>СОУТ на рабочем месте крановщика — обязанность работодателя; при аренде с экипажем это подрядчик, а не заказчик.</li>
      <li>Методика по приказу Минтруда №33н прямо распространяется на нестационарные рабочие места вроде кабины автокрана.</li>
      <li>Периодичность — не реже раза в 5 лет (ст. 8 ч. 4 закона №426-ФЗ), при классах 1–2 и поданной декларации повторная оценка не требуется до внепланового основания.</li>
      <li>Одинаковые по модели и режиму работы автокраны можно оценивать выборочно как аналогичные рабочие места.</li>
      <li>Классы 3.2 и выше добавляют гарантии работнику и дополнительный тариф взносов по ст. 428 НК РФ; за непроведение СОУТ — штраф по ст. 5.27.1 КоАП РФ.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <Sources
      checked={CHECKED}
      items={[
        { text: 'КонсультантПлюс — Федеральный закон от 28.12.2013 №426-ФЗ «О специальной оценке условий труда», ст. 8 и ст. 14', href: 'https://www.consultant.ru/document/cons_doc_LAW_156555/' },
        { text: 'КонсультантПлюс — КоАП РФ, статья 5.27.1 «Нарушение государственных нормативных требований охраны труда»', href: 'https://www.consultant.ru/document/cons_doc_LAW_34661/88755cc3b9fd053aebba33b58078eb459aa5a1d8/' },
        { text: 'Проф.Татарстан — СОУТ и аналогичные рабочие места', href: 'https://proftat.ru/sout-i-analogichnye-mesta' },
      ]}
      note="Прямого доступа к полному тексту НК РФ в системе КонсультантПлюс при подготовке материала не было, поэтому конкретные ставки дополнительного тарифа по статье 428 НК РФ по подклассам условий труда в материале намеренно не приводятся — указан только факт их существования и зависимости от класса. Остальные формулировки (периодичность СОУТ, понятие аналогичных рабочих мест, суммы штрафов по ст. 5.27.1 КоАП РФ, приказ Минтруда №33н) сверены по нескольким независимым пересказам нормы и совпадают между источниками."
    />
  </article>
  <section class="section wrap"><a class="btn" href="/spravochnik/arenda-s-ekipazhem-i-bez/">Аренда крана с экипажем и без экипажа — в чём разница →</a></section>
</main>
</SpravochnikLayout>
