---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';
import Sources from '../../../components/Sources.astro';

const title = 'Ответственность за падение груза при подъёме краном';
const description = 'Ответственность за инцидент при грузоподъёмных работах распределяется между стропальщиком, крановщиком и заказчиком — в зависимости от причины.';

const CHECKED = '12.08.2026';

const faqs = [
  { q: 'Заказчик автоматически отвечает за любой инцидент на своём объекте?', a: 'Нет. Верховный суд разъяснял, что заказчик, не обладающий специальными знаниями в области грузоподъёмных работ, не обязан предвидеть ошибку профессионального исполнителя — ответственность заказчика возникает не по факту нахождения инцидента на его территории, а при наличии его собственной вины: например, если он предоставил недостоверные данные о грузе или не предупредил о скрытых препятствиях.' },
  { q: 'Что если груз был закреплён неправильно?', a: 'Стропальщик несёт основную ответственность за неправильное крепление груза, при условии, что он прошёл полный инструктаж — если в журнале инструктажа отсутствует его подпись, ответственность может перейти на лицо, ответственное за безопасное производство работ на объекте, поскольку в этом случае не подтверждён факт надлежащей подготовки стропальщика.' },
  { q: 'Как заранее снизить риск спора об ответственности при аренде крана с оператором?', a: 'Практический способ — письменно фиксировать в акте или наряде-допуске состояние площадки, характеристики груза и распределение обязанностей (кто стропит, кто отвечает за площадку) до начала работ: при возникновении инцидента именно эти документы, а не устные договорённости, становятся основанием для определения виновной стороны.' },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Кто отвечает, если груз упал', item: 'https://moskran-servis.ru/spravochnik/otvetstvennost-za-padenie-gruza/' },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@id': 'https://moskran-servis.ru/#organization' }, // ссылка на единственный узел организации (BaseLayout): отдельный узел с тем же @id, но другим name, был противоречием в графе
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: 'https://moskran-servis.ru/spravochnik/otvetstvennost-za-padenie-gruza/',
  inLanguage: 'ru-RU',
  datePublished: '2026-08-12',
  dateModified: '2026-08-12',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<SpravochnikLayout title={title} description={description} path="/spravochnik/otvetstvennost-za-padenie-gruza/" slug="otvetstvennost-za-padenie-gruza" ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Кто отвечает, если груз упал</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Разбор для заказчика</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Кто отвечает, если груз упал или повреждён при подъёме краном</h1>
    <p class="ref-byline">Инженерная служба МОСКРАН-СЕРВИС · обновлено в 2026 году</p>

    <p>Вопрос об ответственности возникает у заказчиков не как абстрактный, а как практический: если при подъёме груз повреждён, кто платит — арендодатель техники, стропальщик, или сам заказчик? Однозначного ответа «всегда виноват исполнитель» или «всегда виноват заказчик» не существует — распределение ответственности зависит от конкретной причины инцидента.</p>

    <h2 style="margin:36px 0 16px">Ответственность стропальщика и крановщика</h2>
    <p>Стропальщик отвечает за правильность строповки груза, если он прошёл полный инструктаж и это подтверждено его подписью в журнале. Крановщик отвечает за соблюдение технологии подъёма — скорость, угол, недопущение раскачивания и превышения грузового момента согласно грузовысотной характеристике. Если инцидент вызван нарушением этих правил со стороны исполнителя — ответственность лежит на исполнителе (арендодателе техники и его персонале), а не на заказчике.</p>

    <h2 style="margin:36px 0 16px">Когда ответственность переходит на заказчика</h2>
    <p>Заказчик, не обладающий специальными знаниями в области грузоподъёмных работ, не может нести ответственность за ошибку профессионального исполнителя — это прямо следует из судебной практики Верховного суда. Однако ответственность заказчика возникает, если он предоставил недостоверную информацию о грузе (например, занизил реальный вес), скрыл наличие препятствий, о которых знал, либо кран во время работы столкнулся с объектом, отсутствовавшим на этапе предварительного осмотра площадки и не заявленным заказчиком.</p>

    <h2 style="margin:36px 0 16px">Разделённая ответственность</h2>
    <p>На практике ущерб нередко компенсируется не полностью одной стороной, а пропорционально вкладу каждой стороны в возникновение инцидента — суды учитывают вклад и исполнителя, и заказчика при наличии обоюдных нарушений. Это ещё одна причина, почему предварительная фиксация состояния площадки и характеристик груза в письменном виде — не формальность, а реальная защита обеих сторон при возможном споре.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: что запомнить</h2>
    <ul>
      <li>Стропальщик отвечает за строповку, крановщик — за технологию подъёма, если прошли инструктаж.</li>
      <li>Заказчик без спецзнаний не отвечает за профессиональную ошибку исполнителя.</li>
      <li>Ответственность заказчика возникает при недостоверных данных о грузе или скрытых препятствиях на площадке.</li>
      <li>При обоюдной вине ущерб может распределяться пропорционально, а не покрываться одной стороной целиком.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <Sources
      checked={CHECKED}
      items={[
        { text: 'alrf.ru — Верховный суд об ответственности при грузоподъёмных работах', href: 'https://alrf.ru/news/vs-razyasnil-kto-neset-otvetstvennost-za-povrezhdenie-obekta-pri-gruzopodemnykh-rabotakh/' },
        { text: 'gkgz.ru — заказчик не отвечает за действия подрядчика', href: 'https://gkgz.ru/verhovnyj-sud-zakazchik-ne-neset-otvetstvennosti-za-dejstviya-podryadchika/' }
      ]}
    />
  </article>
  <section class="section wrap"><a class="btn" href="/spravochnik/arenda-s-operatorom-nalogi/">Аренда крана с оператором: налоги для заказчика →</a></section>
</main>
</SpravochnikLayout>
