---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = 'Закрывающие документы после аренды автокрана';
const description = 'Какие документы заказчик получает после аренды автокрана в МОСКРАН-СЕРВИС: путевой лист ЭСМ-2 с часами, справка ЭСМ-7, акт или УПД — и кто что подписывает.';

const CHECKED = '26.09.2026';
const PUBLISHED = '2026-09-26';
const SLUG = 'zakryvayushchie-dokumenty-arenda-krana';
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: 'Обязательно ли использовать формы ЭСМ-2 и ЭСМ-7?',
    a: 'Нет. С 2013 года унифицированные формы Госкомстата не обязательны: по ч. 4 ст. 9 закона №402-ФЗ формы первичных документов утверждает руководитель организации. Документ должен лишь содержать обязательные реквизиты из ч. 2 той же статьи. МОСКРАН-СЕРВИС использует формы ЭСМ как привычные бухгалтериям строительных организаций.',
  },
  {
    q: 'Кто на объекте подписывает часы работы автокрана?',
    a: 'Отработанное время подтверждает представитель заказчика — обычно прораб или мастер участка — подписью в путевом листе ЭСМ-2 в конце смены. Указания Госкомстата к форме ЭСМ-2 прямо называют прораба среди подписантов. МОСКРАН-СЕРВИС просит заранее назвать этого человека в заявке, чтобы крановщику было с кем закрыть смену.',
  },
  {
    q: 'Можно ли вместо акта получить УПД?',
    a: 'Можно. Универсальный передаточный документ рекомендован письмом ФНС от 21.10.2013 №ММВ-20-3/96@ и заменяет акт, а в статусе 1 — ещё и счёт-фактуру. Форма рекомендательная, поэтому акт и УПД равноценны как первичный документ. Какой вариант удобнее вашей бухгалтерии, МОСКРАН-СЕРВИС уточняет при заключении договора.',
  },
  {
    q: 'Что делать, если часы в путевом листе не совпадают с фактом?',
    a: 'Спор о часах решают в день работы, а не при получении акта. Представитель заказчика вправе не подписывать ЭСМ-2 с неверным временем и записать своё время с пометкой о разногласии. МОСКРАН-СЕРВИС выставляет справку ЭСМ-7 только по подписанным часам, поэтому неподписанная смена сразу видна обеим сторонам.',
  },
  {
    q: 'Нужен ли договор, если кран заказан на одну смену?',
    a: 'Договор аренды с экипажем по ст. 632 ГК РФ нужен и для одной смены: именно он связывает путевой лист, справку и акт в одну сделку. Для разового заказа МОСКРАН-СЕРВИС оформляет договор-заявку, где указаны кран, адрес, ставка и дата. Без договора бухгалтерия заказчика не сможет обосновать расход.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Закрывающие документы после аренды автокрана', item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ['komplekt', 'Какие документы входят в комплект'],
  ['esm-2', 'Путевой лист ЭСМ-2: где фиксируются часы'],
  ['esm-7', 'Справка ЭСМ-7: расчёт суммы'],
  ['akt-upd', 'Акт или УПД: что выбрать'],
  ['primer', 'Пример: две смены автокрана 25 т'],
  ['faq', 'Частые вопросы'],
  ['istochniki', 'Источники'],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Закрывающие документы</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Договор и деньги · Как закрыть заказ</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Какие документы выдают после аренды автокрана?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>26.09.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>26.09.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>6 мин чтения</span>
    </div>

    <p>После аренды автокрана заказчик получает четыре документа: договор аренды с экипажем, путевой лист строительной машины с подписанными часами, справку для расчётов и акт или УПД. МОСКРАН-СЕРВИС считает сумму только по часам, которые представитель заказчика подписал на объекте, поэтому главный документ для спора о деньгах — путевой лист, а не итоговый акт.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="komplekt" style="margin:36px 0 16px">Какие документы входят в комплект</h2>
    <p>Комплект МОСКРАН-СЕРВИС по одному заказу автокрана состоит из договора, путевого листа формы ЭСМ-2, справки формы ЭСМ-7 и акта или УПД; при работе с НДС добавляется счёт-фактура. Формы ЭСМ утверждены постановлением Госкомстата России от 28.11.1997 №78 и до сих пор привычны бухгалтериям строительных компаний. Каждый документ отвечает на свой вопрос: договор — на каких условиях, путевой лист — сколько работали, справка — сколько это стоит, акт — что услуга принята.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Документ</th><th>Что подтверждает</th><th>Кто подписывает</th><th>Когда</th></tr></thead>
        <tbody>
          <tr><td>Договор аренды с экипажем</td><td>кран, ставку, адрес, порядок оплаты</td><td>обе стороны</td><td>до выезда</td></tr>
          <tr><td>Путевой лист ЭСМ-2</td><td>фактические часы работы крана</td><td>крановщик и прораб заказчика</td><td>в конце каждой смены</td></tr>
          <tr><td>Справка ЭСМ-7</td><td>сумму к оплате по часам и ставке</td><td>исполнитель</td><td>после закрытия смен</td></tr>
          <tr><td>Акт или УПД</td><td>приёмку услуги заказчиком</td><td>обе стороны</td><td>после закрытия смен</td></tr>
          <tr><td>Счёт-фактура</td><td>НДС для вычета</td><td>исполнитель — плательщик НДС</td><td>вместе с актом</td></tr>
        </tbody>
      </table>
    </div>

    <h2 id="esm-2" style="margin:36px 0 16px">Путевой лист ЭСМ-2: где фиксируются часы</h2>
    <p>Форма ЭСМ-2 «Путевой лист строительной машины» по указаниям Госкомстата применяется для учёта работы строительной машины на автомобильном ходу при почасовой оплате — это ровно случай автокрана. В путевой лист крановщик МОСКРАН-СЕРВИС вписывает время начала и окончания работы, а прораб заказчика подписью подтверждает отработанные часы. Отдельные требования к путевому листу как к транспортному документу разобраны в <a href="/spravochnik/putevoy-list-avtokrana/" style="color:var(--yellow)">материале о путевом листе автокрана</a>.</p>
    <p>Подпись прораба в ЭСМ-2 — единственная точка, где заказчик влияет на сумму. МОСКРАН-СЕРВИС советует сверять время прямо на объекте: если кран приехал к 8:00, а площадку открыли в 9:30, это простой по вине заказчика, и он тоже попадёт в часы. Как считается такое ожидание, описано в <a href="/spravochnik/prostoy-tehniki-oplata/" style="color:var(--yellow)">материале об оплате простоя</a>.</p>

    <h2 id="esm-7" style="margin:36px 0 16px">Справка ЭСМ-7: расчёт суммы</h2>
    <p>Справка ЭСМ-7 применяется для расчётов с заказчиками и составляется на основании путевого листа ЭСМ-2 — так прямо сказано в указаниях Госкомстата к форме. В справке МОСКРАН-СЕРВИС умножает подписанные машино-часы на ставку класса крана из договора. Бухгалтерия прикладывает справку к счёту или акту, поэтому заказчик видит не только итог, но и то, из каких часов он сложился.</p>
    <p>Справка ЭСМ-7 не добавляет новых часов: всё, чего нет в подписанных путевых листах, в неё не попадает. Надбавки из договора — например, коэффициент за пропускной режим объекта — МОСКРАН-СЕРВИС показывает в справке отдельной строкой. Формула цены смены разобрана в <a href="/spravochnik/stoimost-arendy-avtokrana/" style="color:var(--yellow)">материале о стоимости аренды автокрана</a>.</p>

    <h2 id="akt-upd" style="margin:36px 0 16px">Акт или УПД: что выбрать</h2>
    <p>Акт оказанных услуг и УПД юридически равноценны: по ч. 4 ст. 9 закона №402-ФЗ форму первичного документа выбирает сама организация, лишь бы в нём были семь обязательных реквизитов из ч. 2 той же статьи. УПД рекомендован письмом ФНС от 21.10.2013 №ММВ-20-3/96@; в статусе 1 он одновременно служит счётом-фактурой, в статусе 2 — только передаточным документом. МОСКРАН-СЕРВИС оформляет тот вариант, который принят в учёте заказчика.</p>
    <p>Для заказчика важнее не название бланка, а совпадение цифр во всей цепочке. Сумма в акте или УПД МОСКРАН-СЕРВИС должна равняться итогу справки ЭСМ-7, а часы в справке — сумме подписанных путевых листов. Если цифры расходятся, бухгалтерия заказчика вправе вернуть документ до исправления.</p>

    <h2 id="primer" style="margin:36px 0 16px">Пример: две смены автокрана 25 т</h2>
    <p>Автокран 25 т в МОСКРАН-СЕРВИС стоит 2 600 ₽ в час, смена — 8 часов, то есть 20 800 ₽. Если кран отработал две полные смены и прораб подписал 16 часов в двух путевых листах ЭСМ-2, справка ЭСМ-7 покажет 16 машино-часов × 2 600 ₽ = 41 600 ₽. Та же сумма уйдёт в акт или УПД.</p>
    <p>Во втором варианте прораб подписал 8 часов в первый день и 10 часов во второй, потому что монтаж затянулся. Справка МОСКРАН-СЕРВИС тогда покажет 18 машино-часов × 2 600 ₽ = 46 800 ₽, и каждый час подтверждён подписью заказчика в конкретном путевом листе. При проверке бухгалтерия сверяет только два числа: 18 часов в путевых листах и 18 часов в справке.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: что проверить при закрытии заказа</h2>
    <ul>
      <li>Часы подписаны в каждом путевом листе ЭСМ-2.</li>
      <li>Справка ЭСМ-7 = часы × ставка из договора.</li>
      <li>Акт или УПД = итог справки.</li>
      <li>Счёт-фактура — только если исполнитель платит НДС.</li>
      <li>Унифицированные формы не обязательны, реквизиты — обязательны.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://legalacts.ru/doc/postanovlenie-goskomstata-rf-ot-28111997-n-78/" target="_blank" rel="noopener" style="color:var(--yellow)">Постановление Госкомстата России от 28.11.1997 №78</a> — формы ЭСМ-2 и ЭСМ-7, указания по применению.</li>
      <li><a href="https://www.consultant.ru/document/cons_doc_LAW_122855/b24121ba7152f33673608559f2ca844ef5b6a74c/" target="_blank" rel="noopener" style="color:var(--yellow)">Федеральный закон от 06.12.2011 №402-ФЗ, ст. 9</a> — обязательные реквизиты и право организации утверждать формы.</li>
      <li><a href="https://www.consultant.ru/document/cons_doc_LAW_153587/" target="_blank" rel="noopener" style="color:var(--yellow)">Письмо ФНС России от 21.10.2013 №ММВ-20-3/96@</a> — рекомендованная форма УПД.</li>
      <li><a href="/" style="color:var(--yellow)">Ставки МОСКРАН-СЕРВИС</a> — главная страница сайта, действуют до 17.02.2027.</li>
    </ul>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-16-25-tonn/">Подробнее об аренде автокрана 16–25 тонн →</a></section>
</main>
</SpravochnikLayout>
