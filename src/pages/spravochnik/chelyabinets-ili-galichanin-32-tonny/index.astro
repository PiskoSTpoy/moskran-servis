---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = 'Челябинец или Галичанин 32 т: КС-55733 против КС-55729-1В';
const description = 'КС-55733 «Челябинец»: 126 т·м, стрела 33 м, контур 5,5×6,3 м, КамАЗ-43118. КС-55729-1В «Галичанин»: 98 т·м, стрела 30,2 м, контур 4,75×5,8 м. Смена 24 800 ₽.';

const CHECKED = '10.10.2026';
const PUBLISHED = '2026-10-10';
const SLUG = 'chelyabinets-ili-galichanin-32-tonny';
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: 'Какой 32-тонник дальше достаёт: Челябинец КС-55733 или Галичанин КС-55729-1В?',
    a: 'Челябинец. По каталогу cmz.ru стрела КС-55733 «СТ» — 33,0 м из четырёх секций, высота подъёма крюка 33,7 м без гуська и до 42,8 м с гуськом 10 м. Галичанин КС-55729-1В по данным gakz.ru несёт стрелу 9,6–30,2 м с высотой крюка 31,1 м и 40,0 м с гуськом 9 м. МОСКРАН-СЕРВИС на вылетах за 28 м ставит Челябинец.',
  },
  {
    q: 'Почему при одинаковых 32 т грузовой момент отличается на 29 %?',
    a: 'Грузовой момент — произведение массы груза на вылет, и 32 т оба крана держат только у самой колонны. Дальше работает момент: 126 т·м у КС-55733 против 98 т·м у КС-55729-1В. Верхняя оценка на вылете 10 м — 12,6 т против 9,8 т. МОСКРАН-СЕРВИС подбирает кран по этой кривой, а не по цифре на двери кабины.',
  },
  {
    q: 'Какой из двух кранов влезет в узкий двор?',
    a: 'Галичанин: его опорный контур 4,75×5,8 м меньше контура Челябинца 5,5×6,3 м, а в убранном положении опор — 4,75×2,27 м против 5,5×2,3 м. Площадь под опорами 27,6 м² против 34,7 м², то есть на 20 % меньше. Габариты шасси близки: 12,0×2,5×3,95 м у Галичанина и 12,0×2,55×4,0 м у Челябинца.',
  },
  {
    q: 'Какой кран проедет по грунтовке к объекту в области?',
    a: 'Челябинец КС-55733 стоит на полноприводном КамАЗ-43118 с колёсной формулой 6×6, Галичанин КС-55729-1В — на дорожном четырёхосном КамАЗ-6540 8×4. На раскисшей подъездной дороге МОСКРАН-СЕРВИС выбирает Челябинец; на асфальте и бетоне разница не играет роли.',
  },
  {
    q: 'Отличается ли цена смены Челябинца и Галичанина у МОСКРАН-СЕРВИС?',
    a: 'Нет. Оба крана относятся к классу 32 т, ставка класса — 3 100 ₽/ч, смена 8 часов — 24 800 ₽. Из-за разницы моментов рубль смены покупает 126 т·м у Челябинца и 98 т·м у Галичанина: около 197 и 253 ₽ за тонно-метр соответственно. Модель назначает диспетчер по вылету и площадке.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Челябинец или Галичанин 32 тонны', item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ['tablitsa', 'Паспортные данные двух кранов'],
  ['moment', 'Грузовой момент: 126 против 98 т·м'],
  ['strela', 'Стрела и высота подъёма'],
  ['kontur', 'Опорный контур и площадка'],
  ['shassi', 'Шасси, масса и проходимость'],
  ['tsena', 'Цена смены и рубль за тонно-метр'],
  ['komu', 'Какой кран под какую задачу'],
  ['faq', 'Частые вопросы'],
  ['istochniki', 'Источники'],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Челябинец или Галичанин 32 тонны</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Выбор техники · 32 тонны</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Челябинец КС-55733 или Галичанин КС-55729-1В: какой автокран 32 т выбрать?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>10.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>10.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>6 мин чтения</span>
    </div>

    <p>КС-55733 «СТ» Челябинского механического завода даёт грузовой момент 126 т·м и стрелу 33,0 м, КС-55729-1В Галичского автокранового завода — 98 т·м и стрелу 9,6–30,2 м; разница в моменте 29 % при одинаковой паспортной грузоподъёмности 32 т. Челябинец стоит на полноприводном КамАЗ-43118 6×6 с контуром опор 5,5×6,3 м, Галичанин — на дорожном КамАЗ-6540 8×4 с контуром 4,75×5,8 м. МОСКРАН-СЕРВИС считает смену класса 32 т по единой ставке 3 100 ₽/ч, поэтому выбор модели делается по вылету и площадке, а не по цене.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="tablitsa" style="margin:36px 0 16px">Паспортные данные двух кранов</h2>
    <p>Таблица собрана МОСКРАН-СЕРВИС из каталогов заводов cmz.ru (КС-55733 «СТ» на КамАЗ-43118) и gakz.ru (КС-55729-1В со стрелой 30,2 м) по состоянию на 10.10.2026. Решающим документом для конкретной машины остаётся её паспорт: заводы меняют комплектации, а модификация КС-55729-1В-3 со стрелой 31 м и моментом 102,4 т·м разобрана в материале <a href="/spravochnik/avtokran-25-ili-32-tonny/" style="color:var(--yellow)">автокран 25 или 32 тонны</a>.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Параметр</th><th>КС-55733 «СТ» Челябинец</th><th>КС-55729-1В Галичанин</th></tr></thead>
        <tbody>
          <tr><td>Грузоподъёмность</td><td>32 т</td><td>32 т на вылете 3,0 м</td></tr>
          <tr><td>Грузовой момент</td><td>126 т·м</td><td>98 т·м</td></tr>
          <tr><td>Стрела</td><td>33,0 м, 4 секции</td><td>9,6–30,2 м</td></tr>
          <tr><td>Гусёк</td><td>9,0 / 10,0 м (0°, 15°, 30°)</td><td>9 м (0°, 30°)</td></tr>
          <tr><td>Высота крюка</td><td>33,7 м; с гуськом 42,1 / 42,8 м</td><td>31,1 м; с гуськом 40,0 м</td></tr>
          <tr><td>Опорный контур</td><td>5,5×6,3 м; неполный 5,5×2,3 м</td><td>4,75×5,8 м; убранный 4,75×2,27 м</td></tr>
          <tr><td>Шасси</td><td>КамАЗ-43118, 6×6</td><td>КамАЗ-6540, 8×4</td></tr>
          <tr><td>Масса</td><td>22,5 т с основной стрелой без противовеса</td><td>31,25 т в транспортном положении с гуськом</td></tr>
          <tr><td>Противовес</td><td>1,0 т базовый, до 8,5 т</td><td>не указан в каталоге</td></tr>
          <tr><td>Габариты (Д×Ш×В)</td><td>12,0×2,55×4,0 м</td><td>12,0×2,5×3,95 м</td></tr>
          <tr><td>Транспортная скорость</td><td>60 км/ч</td><td>до 50 км/ч</td></tr>
        </tbody>
      </table>
    </div>

    <h2 id="moment" style="margin:36px 0 16px">Грузовой момент: 126 против 98 т·м</h2>
    <p>Грузовой момент 126 т·м у КС-55733 «СТ» на 28 т·м, или на 29 %, больше момента 98 т·м у КС-55729-1В — это главное различие двух 32-тонников. Паспортные 32 т оба крана держат только у минимального вылета (у Галичанина — 3,0 м), а на рабочих вылетах грузоподъёмность задаёт момент. Верхняя оценка на вылете 10 м: 12,6 т у Челябинца против 9,8 т у Галичанина; на 15 м — 8,4 т против 6,5 т. МОСКРАН-СЕРВИС подчёркивает, что это оценка по моменту, а рабочее значение читают в грузовой таблице паспорта с учётом массы стрелы и крюковой подвески.</p>
    <p>Разница в 29 % по моменту означает, что груз, который Галичанин берёт на вылете 12 м, Челябинец возьмёт примерно на 15 м. Для монтажа плит перекрытия на дальнем краю дома это, по опыту МОСКРАН-СЕРВИС, равно одной лишней перестановке крана за смену, то есть 30–40 минутам на опоры и плиты. Как читать кривую грузоподъёмности, описано в материале о <a href="/spravochnik/gruzovysotnaya-harakteristika/" style="color:var(--yellow)">грузовысотной характеристике</a>.</p>

    <h2 id="strela" style="margin:36px 0 16px">Стрела и высота подъёма</h2>
    <p>Стрела КС-55733 «СТ» длиной 33,0 м из четырёх секций даёт высоту крюка 33,7 м без гуська и 42,1–42,8 м с гуськом 9 или 10 м. Завод cmz.ru указывает максимальный вылет с гуськом 40,0–41,0 м. КС-55729-1В со стрелой 9,6–30,2 м поднимает крюк на 31,1 м, а с гуськом 9 м — на 40,0 м; по данным gakz.ru гусёк ставится под углом 0° или 30°, а телескопирование под нагрузкой допускается до 4,35 т. Разница по высоте без гуська — 2,6 м, почти этаж жилого дома в практике МОСКРАН-СЕРВИС.</p>
    <p>МОСКРАН-СЕРВИС выбирает Челябинец, когда нужен крюк выше 31 м без гуська: монтаж на десятом этаже или подача через парапет высокого здания. Для коттеджа до трёх этажей и промышленного ангара хватает стрелы Галичанина. Когда ставить гусёк и как он меняет грузоподъёмность, разобрано в материале о <a href="/spravochnik/gusyok-udlinitel-strely/" style="color:var(--yellow)">гуське-удлинителе стрелы</a>.</p>

    <h2 id="kontur" style="margin:36px 0 16px">Опорный контур и площадка</h2>
    <p>Опорный контур КС-55729-1В — 4,75×5,8 м, у КС-55733 «СТ» — 5,5×6,3 м: Галичанину нужна площадка на 0,75 м короче и на 0,5 м уже. Площадь контура 27,6 м² против 34,7 м², разница 20 %. Оба завода допускают работу с неполным выдвижением опор — 4,75×2,27 м у Галичанина и 5,5×2,3 м у Челябинца, но грузоподъёмность на неполном контуре задаёт отдельная таблица паспорта, и МОСКРАН-СЕРВИС применяет такой режим только по ППР.</p>
    <p>Для узкого двора в Москве контур Галичанина, по опыту МОСКРАН-СЕРВИС, — аргумент сильнее момента: там, где между фасадом и забором 6 м, Челябинец с контуром 6,3 м поперёк не встанет на полные опоры. Требования к уклону и грунту площадки под 32-тонник описаны в материалах о <a href="/spravochnik/dopustimyy-uklon-ploshchadki-dlya-avtokrana/" style="color:var(--yellow)">допустимом уклоне площадки</a> и <a href="/spravochnik/nesushchaya-sposobnost-grunta/" style="color:var(--yellow)">несущей способности грунта</a>.</p>

    <h2 id="shassi" style="margin:36px 0 16px">Шасси, масса и проходимость</h2>
    <p>КС-55733 «СТ» смонтирован на трёхосном полноприводном КамАЗ-43118 (6×6), КС-55729-1В — на четырёхосном дорожном КамАЗ-6540 (8×4). Полный привод Челябинца МОСКРАН-СЕРВИС ценит на подъездах к объектам в Московской области после дождя; четыре оси Галичанина распределяют массу 31,25 т (с гуськом, по gakz.ru) и облегчают согласование проезда по дорогам с ограничением нагрузки на ось. Масса Челябинца по каталогу cmz.ru — 22,5 т с основной стрелой без противовеса; с противовесом до 8,5 т и гуськом она растёт, поэтому сравнивать два числа напрямую нельзя.</p>
    <p>Транспортная скорость 60 км/ч у Челябинца против 50 км/ч у Галичанина даёт выигрыш на перегоне МОСКРАН-СЕРВИС в область: 60 км до объекта — около 12 минут разницы. Габариты близки (12,0×2,55×4,0 м и 12,0×2,5×3,95 м), и оба крана по высоте 4 м проходят под стандартными путепроводами. Порядок въезда тяжёлой техники в центр описан в материале о <a href="/spravochnik/propusk-avtokrana-v-moskvu/" style="color:var(--yellow)">пропуске автокрана в Москву</a>.</p>

    <h2 id="tsena" style="margin:36px 0 16px">Цена смены и рубль за тонно-метр</h2>
    <p>Ставка класса 32 т у МОСКРАН-СЕРВИС — 3 100 ₽/ч, смена 8 часов — 24 800 ₽ независимо от модели. Пересчёт на момент показывает, что рубль смены у Челябинца покупает больше: 24 800 ÷ 126 ≈ 197 ₽ за тонно-метр против 24 800 ÷ 98 ≈ 253 ₽ у Галичанина. Для сравнения, класс 25 т (2 600 ₽/ч, 20 800 ₽ за смену) с типичным моментом 85–90 т·м даёт 231–245 ₽ за тонно-метр, а класс 50 т (3 900 ₽/ч, 31 200 ₽) с моментом 175 т·м — около 178 ₽.</p>
    <p>Пример расчёта МОСКРАН-СЕРВИС: блок-контейнер 6 т нужно поставить на вылете 14 м. Верхняя оценка 98 ÷ 14 = 7 т у Галичанина и 126 ÷ 14 = 9 т у Челябинца; с учётом массы стрелы и подвески Галичанин оказывается на границе таблицы, и диспетчер назначает Челябинец за те же 24 800 ₽. Если Челябинец занят, альтернатива — класс 50 т за 31 200 ₽, то есть на 6 400 ₽ дороже; подробнее в материале <a href="/spravochnik/avtokran-32-ili-50-tonn/" style="color:var(--yellow)">автокран 32 или 50 тонн</a>.</p>

    <h2 id="komu" style="margin:36px 0 16px">Какой кран под какую задачу</h2>
    <ul>
      <li><b>Челябинец КС-55733 «СТ»</b> МОСКРАН-СЕРВИС назначает на вылеты 25–30 м, крюк выше 31 м без гуська, грунтовые подъезды в области, груз 6–9 т на вылете 12–15 м.</li>
      <li><b>Галичанин КС-55729-1В</b> МОСКРАН-СЕРВИС ставит в тесный двор с коридором 5–6 м, площадка под контур 4,75×5,8 м, типовой монтаж плит и бытовок на вылете до 12 м, перегон по дорогам с осевыми ограничениями.</li>
      <li><b>Любой из двух</b>: коттедж до трёх этажей, разгрузка фур, подъём ферм до 5 т на вылете 10 м — цена смены одна, модель назначает диспетчер МОСКРАН-СЕРВИС по наличию.</li>
    </ul>
    <p>Заявка принимается по порядку из материала о <a href="/spravochnik/zayavka-na-avtokran/" style="color:var(--yellow)">заявке на автокран</a>: масса и габарит груза, вылет до точки монтажа, высота подъёма, размеры площадки и тип подъезда. По этим пяти данным МОСКРАН-СЕРВИС выбирает между Челябинцем и Галичанином до выезда, а не на объекте.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: Челябинец или Галичанин 32 т</h2>
    <ul>
      <li>Момент: 126 т·м у КС-55733 против 98 т·м у КС-55729-1В, разница 29 % — главный критерий подбора у МОСКРАН-СЕРВИС.</li>
      <li>Стрела: 33,0 м и крюк 33,7 м против 30,2 м и 31,1 м; с гуськом 42,8 м против 40,0 м — выше 31 м МОСКРАН-СЕРВИС ставит Челябинец.</li>
      <li>Контур: 5,5×6,3 м против 4,75×5,8 м — Галичанин на 20 % компактнее по площади опор, его МОСКРАН-СЕРВИС ставит в узкие дворы.</li>
      <li>Шасси: КамАЗ-43118 6×6 против КамАЗ-6540 8×4; 60 против 50 км/ч — на грунтовку МОСКРАН-СЕРВИС отправляет Челябинец.</li>
      <li>Смена класса 32 т — 24 800 ₽ (3 100 ₽/ч × 8 ч) для обеих моделей.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://www.cmz.ru/catalogue/mobile/ks-55733-32-33_kamaz-43118/" target="_blank" rel="noopener" style="color:var(--yellow)">Челябинский механический завод — КС-55733 «СТ» на КамАЗ-43118</a> — 32 т, 126 т·м, стрела 33,0 м (4 секции), гусёк 9,0/10,0 м, высота крюка 33,7 м и 42,1/42,8 м с гуськом, контур 5,5×6,3 м, масса 22,5 т без противовеса, габариты 12,0×2,55×4,0 м, 60 км/ч.</li>
