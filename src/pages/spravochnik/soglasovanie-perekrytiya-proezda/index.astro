---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';
import Sources from '../../../components/Sources.astro';

const title = 'Согласование перекрытия проезда под кран в Москве';
const description = 'Разбор процедуры: ПОДД, согласование с ЦОДД, ордер ОАТИ. Что нужно, чтобы законно перекрыть часть проезжей части под установку автокрана в Москве.';

const CHECKED = '12.08.2026';

const faqs = [
  { q: 'Всегда ли нужно согласование, если кран занимает часть проезжей части?', a: 'Да, если работы затрагивают проезжую часть или тротуар — без согласованного проекта организации дорожного движения (ПОДД) подрядчик не сможет получить ордер ОАТИ на производство работ, а без ордера размещение техники на проезжей части формально незаконно, вне зависимости от того, насколько кратковременна установка.' },
  { q: 'Как часто рассматриваются заявки на согласование ПОДД?', a: 'Комиссия по согласованию проводит заседания на регулярной основе (по имеющимся данным — еженедельно), очно и удалённо. Это определяет минимальный реалистичный срок между подачей документов и получением согласования — на практике стоит закладывать больше времени, чем один рабочий день, особенно если заявка подана не в начале недели.' },
  { q: 'Можно ли обойтись без перекрытия, если кран не помещается во двор?', a: 'В части случаев — да: подбор более компактной или короткобазной модели крана иногда позволяет установить технику в границах двора или на прилегающей непроезжей территории без выхода на проезжую часть. Мы всегда в первую очередь ищем такой вариант — согласование ПОДД дороже и дольше по времени, чем аренда более манёвренной техники.' },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Согласование перекрытия проезда', item: 'https://moskran-servis.ru/spravochnik/soglasovanie-perekrytiya-proezda/' },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@id': 'https://moskran-servis.ru/#organization' }, // ссылка на единственный узел организации (BaseLayout): отдельный узел с тем же @id, но другим name, был противоречием в графе
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: 'https://moskran-servis.ru/spravochnik/soglasovanie-perekrytiya-proezda/',
  inLanguage: 'ru-RU',
  datePublished: '2026-08-12',
  dateModified: '2026-08-12',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<SpravochnikLayout title={title} description={description} path="/spravochnik/soglasovanie-perekrytiya-proezda/" slug="soglasovanie-perekrytiya-proezda" ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Согласование перекрытия проезда</span>
  </nav>

  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Разбор для заказчика</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Как согласовать перекрытие проезда в Москве для установки крана</h1>
    <p class="ref-byline">Инженерная служба МОСКРАН-СЕРВИС · обновлено в 2026 году</p>

    <p>Если двор или прилегающая территория объекта не позволяют установить кран без выхода на проезжую часть или тротуар — потребуется официальное согласование, а не просто «поставить и убрать за пару часов». Разбираем, что это за процедура и сколько реально закладывать времени.</p>

    <h2 style="margin:36px 0 16px">Что такое ПОДД и когда он нужен</h2>
    <p>Проект организации дорожного движения (ПОДД) — документ, который описывает временное изменение схемы движения на конкретном участке: перекрытие полосы, тротуара или части проезжей части на срок проведения работ. Если установка крана на выносные опоры требует занять часть проезжей части или тротуара — даже на несколько часов одной смены — формально это подпадает под требование согласования ПОДД.</p>

    <h2 style="margin:36px 0 16px">Кто согласовывает — ЦОДД</h2>
    <p>Согласование ПОДД в Москве проходит через Центр организации дорожного движения (ЦОДД) — профильную структуру, которая рассматривает подобные проекты на регулярной основе через комиссию, заседающую как очно, так и в удалённом формате. Положительное решение комиссии фиксируется штампом согласования на титульном листе проекта или протоколом заседания.</p>
    <p>Без штампа ЦОДД подрядчик не может получить ордер ОАТИ (Объединения административно-технических инспекций) на производство работ, если они затрагивают проезжую часть или тротуары, — а без ордера размещение техники на проезжей части формально незаконно, независимо от того, насколько кратковременна установка крана.</p>
    <p>Сам ордерный режим в Москве задан постановлением Правительства Москвы от 19.05.2015 №299-ПП, которым утверждены Правила проведения земляных работ, установки временных ограждений, размещения временных объектов в городе Москве. Название документа стоит прочитать целиком: ордер привязан не только к раскопке грунта, но и к установке временных ограждений — то есть попадает под него и ограждение опасной зоны крана на территории общего пользования, даже когда никаких земляных работ на объекте нет вообще. Это тот случай, когда заказчик искренне удивляется: «мы же ничего не копаем».</p>

    <h2 style="margin:36px 0 16px">Сколько это реально занимает по времени</h2>
    <p>Комиссия ЦОДД по имеющимся данным заседает регулярно (согласно открытым источникам — на еженедельной основе), что задаёт минимальный практический ориентир: между подачей документов и рассмотрением проходит по крайней мере несколько рабочих дней, а не «завтра». Честная оговорка: единой публичной цифры «срок рассмотрения — N рабочих дней» для этой процедуры мы в открытых источниках не нашли, и придумывать её не будем. Срок зависит от сложности схемы, полноты пакета при подаче и очереди на заседание, поэтому корректный порядок действий — уточнять его по конкретному адресу, а не подставлять чужой усреднённый норматив в график объекта.</p>
    <p>На практике для заказчика это означает: если площадка объекта требует перекрытия проезда, дату выезда крана нельзя планировать на завтра или послезавтра — нужен запас в несколько рабочих дней минимум, а реалистичнее — больше недели, если заявка подаётся не в начале недели или пакет документов требует доработки.</p>

    <h2 style="margin:36px 0 16px">Как мы стараемся избежать этой процедуры</h2>
    <p>Согласование ПОДД — не бесплатная и не мгновенная процедура, поэтому первый вопрос при расчёте заявки на стеснённую площадку — можно ли обойтись без перекрытия вообще. Иногда более компактная или короткобазная модель крана позволяет установить технику в границах двора или на прилегающей непроезжей территории, не выходя на проезжую часть. Мы предлагаем такой вариант в первую очередь — он и дешевле, и быстрее по срокам, чем оформление полноценного ПОДД.</p>
    <p>Если без перекрытия объективно не обойтись (двор слишком мал, альтернативной площадки физически нет), сообщаем об этом на этапе расчёта заявки — вместе с реалистичной оценкой срока согласования, а не оптимистичной «сделаем быстро».</p>

    <h2 class="ref-takeaway" style="margin:36px 0 16px">Коротко: что запомнить</h2>
    <ul>
      <li>Установка крана с выходом на проезжую часть или тротуар требует согласованного ПОДД — даже для кратковременных работ.</li>
      <li>Согласование проходит через ЦОДД, комиссия рассматривает проекты на регулярной основе.</li>
      <li>Без штампа ЦОДД нельзя получить ордер ОАТИ — а без него размещение техники на проезжей части формально незаконно.</li>
      <li>Ордерный режим задан постановлением Правительства Москвы №299-ПП от 19.05.2015 и охватывает установку временных ограждений, а не только земляные работы.</li>
      <li>Точный норматив срока рассмотрения заявки не является единой публичной цифрой — уточняется по конкретному случаю, закладывайте запас не меньше нескольких рабочих дней.</li>
      <li>Первый шаг — проверить, нельзя ли обойтись без перекрытия за счёт более компактной модели крана.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <Sources
      checked={CHECKED}
      items={[
        { text: 'Постановление Правительства Москвы от 19.05.2015 №299-ПП «Об утверждении Правил проведения земляных работ, установки временных ограждений, размещения временных объектов в городе Москве»', href: 'https://base.garant.ru/71036530/' },
        { text: 'госуслуга «Оформление ордера на проведение земляных работ, установку временных ограждений, размещение временных объектов»', href: 'https://www.mos.ru/pgu2/landing/target/7700000010000311461/' },
        { text: 'orgdoc.ru — согласование ПОДД с ЦОДД: этапы и сроки рассмотрения', href: 'https://orgdoc.ru/spravochnik/soglasovanie-podd-s-codd-sroki-i-cena' }
      ]}
    />
  </article>

  <section class="section wrap">
    <a class="btn" href="/geo/cao/">Специфика согласований по округам →</a>
  </section>
</main>
</SpravochnikLayout>
