---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = "Отлёт груза: границы опасной зоны стройки по ФНП 461";
const description = "Граница опасной зоны — габарит груза плюс отлёт при падении: 4 м при высоте до 10 м, 7 м до 20 м, 10 м до 70 м (приложение №2, таблица 1 ФНП №461).";

const CHECKED = '23.10.2026';
const PUBLISHED = '2026-10-23';
const SLUG = "otlet-gruza-opasnaya-zona-stroyki-fnp-461";
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  { q: "Чему равен отлёт падающего груза при подъёме на 15 метров?", a: "Таблица 1 приложения №2 ФНП №461 содержит строки «до 10» (4 м) и «до 20» (7 м); для промежуточной высоты допускается интерполяция. Линейный расчёт даёт 5,5 м, к нему добавляют наибольший габарит груза." },
  { q: "От чего отсчитывают границу опасной зоны?", a: "От крайней точки горизонтальной проекции наружного наименьшего габарита перемещаемого груза или от стены здания (приложение №2 к ФНП №461). К этой точке прибавляют габарит груза и отлёт по таблице 1." },
  { q: "Что делать, если опасная зона выходит на соседний двор или дорогу?", a: "Предусмотреть в ППР средства принудительного ограничения зоны работы крана и согласовать решение с владельцем территории (п. 156 «ж» ФНП №461). Просто закрыть зону лентой при этом недостаточно." },
  { q: "При каком расстоянии до границы поворот стрелы замедляют?", a: "Когда расстояние от перемещаемого груза до границы опасной зоны меньше 7 м, скорость поворота стрелы в сторону границы ограничивают до минимальной (п. 156 «ж» ФНП №461)." },
  { q: "Чем отличается отлёт груза от отлёта предмета со здания?", a: "В таблице 1 приложения №2 две колонки: для груза, падающего при перемещении подъёмным сооружением, и для предмета, падающего со здания. При одной высоте значения разные: на 10 м это 4 м и 3,5 м." },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: "Отлёт груза и границы опасной зоны стройки", item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ["pravilo", "Как складывается граница опасной зоны"],
  ["tablitsa", "Таблица 1: отлёт груза и предмета"],
  ["primer", "Пример расчёта с интерполяцией"],
  ["chuzhie", "Если в зону попадают чужие здания и дороги"],
  ["granitsy", "Что таблица 1 не учитывает"],
  ["faq", "Частые вопросы"],
  ["istochniki", "Источники"],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Отлёт груза и границы опасной зоны стройки</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">ФНП №461 · Опасные зоны</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Как определить границу опасной зоны при подъёме груза краном?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>23.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>23.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>6 мин чтения</span>
    </div>

    <p>Граница опасной зоны при подъёме груза краном отсчитывается от проекции груза или стены здания и складывается из наибольшего габарита груза и минимального отлёта при падении: 4 м при высоте до 10 м, 7 м до 20 м, 10 м до 70 м (приложение №2, таблица 1 ФНП №461). Для промежуточных высот отлёт допускается находить интерполяцией. МОСКРАН-СЕРВИС закладывает этот расчёт в ППР до выезда крана.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="pravilo" style="margin:36px 0 16px">Как складывается граница опасной зоны</h2>
    <p>Приложение №2 к ФНП №461 задаёт точку отсчёта: ближайший к зоне край проекции груза на землю либо наружная стена строящегося здания. От неё откладывают две величины — наибольший размер самого груза и минимальный отлёт при его падении по таблице 1. Три слагаемых дают одну границу, а не три разных. МОСКРАН-СЕРВИС считает её отдельно для каждого груза и каждой высоты, а не одной цифрой на весь объект.</p>

    <h2 id="tablitsa" style="margin:36px 0 16px">Таблица 1: отлёт груза и предмета</h2>
    <p>Таблица 1 приложения №2 задаёт минимальное расстояние отлёта в зависимости от высоты возможного падения, причём отдельно для груза при перемещении подъёмным сооружением и для предмета, падающего со здания. Для крана важна левая колонка; правая нужна при работе рядом со строящимся зданием.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Высота возможного падения, м</th><th>Отлёт груза при перемещении ПС, м</th><th>Отлёт предмета, падающего со здания, м</th></tr></thead>
        <tbody>
          <tr><td>до 10</td><td>4</td><td>3,5</td></tr>
          <tr><td>до 20</td><td>7</td><td>5</td></tr>
          <tr><td>до 70</td><td>10</td><td>7</td></tr>
          <tr><td>до 120</td><td>15</td><td>10</td></tr>
          <tr><td>до 200</td><td>20</td><td>15</td></tr>
          <tr><td>до 300</td><td>25</td><td>20</td></tr>
          <tr><td>до 450</td><td>30</td><td>25</td></tr>
        </tbody>
      </table>
    </div>
    <p>Рост отлёта нелинеен: высота растёт с 10 до 70 м (в семь раз), а отлёт груза — с 4 до 10 м (в 2,5 раза). Для подъёма плит и блоков на городской стройке чаще всего работают первые три строки таблицы: до 10, до 20 и до 70 м.</p>

    <h2 id="primer" style="margin:36px 0 16px">Пример расчёта с интерполяцией</h2>
    <p>Пример (арифметика по таблице 1, а не данные объекта). Железобетонная плита с наибольшим габаритом 6 м поднимается на высоту 15 м. Высоты 15 м в таблице нет: она лежит между строками «до 10» (4 м) и «до 20» (7 м), и линейная интерполяция даёт 4 + (7 − 4) / 2 = 5,5 м. Граница опасной зоны проходит на 6 + 5,5 = 11,5 м от проекции груза. Для той же плиты на высоте 10 м граница составила бы 6 + 4 = 10 м, на высоте 20 м — 6 + 7 = 13 м.</p>
    <p>Линейная интерполяция — наиболее прозрачный способ применить допущение приложения; вид интерполяции в тексте не уточнён. МОСКРАН-СЕРВИС фиксирует способ в ППР и не меняет его между подъёмами. Порядок расчёта вылета, от которого зависит положение груза, описан в справке о <a href="/spravochnik/kak-opredelit-vylet-strely-avtokrana/" style="color:var(--yellow)">вылете стрелы</a>.</p>

    <h2 id="chuzhie" style="margin:36px 0 16px">Если в зону попадают чужие здания и дороги</h2>
    <p>Если при строительстве в опасную зону попадают эксплуатируемые здания, транспортные или пешеходные дороги и другие места нахождения людей, ППР обязан предусмотреть меры, исключающие опасную зону (п. 156 «ж» ФНП №461). Первая мера — дополнительные средства ограничения зоны работы подъёмного сооружения, которые принудительно не пускают стрелу туда, где находятся люди. Вторая — минимальная скорость поворота стрелы в сторону границы рабочей зоны, когда расстояние от груза до границы опасной зоны меньше 7 м.</p>
    <p>Решения нужно согласовать с собственником, владельцем или иным лицом, отвечающим за безопасное использование имущества, попавшего в опасную зону. Это условие делает опасную зону не только расчётом, но и документом: МОСКРАН-СЕРВИС просит заказчика заранее выяснить, кому принадлежит двор, проезд или здание у границы. Требования ППР для крана разбирает справка о <a href="/spravochnik/ppr-dlya-krana/" style="color:var(--yellow)">ППР для крана</a>.</p>

    <h2 id="granitsy" style="margin:36px 0 16px">Что таблица 1 не учитывает</h2>
    <p>При определении опасных зон не предусматривается возникновение зон от падения самого подъёмного сооружения и его отдельных узлов (п. 156 «ж»). Поэтому граница из таблицы 1 — это зона падения груза, но не зона опрокидывания крана или обрушения стрелы. Устойчивость на площадке отдельно определяют несущей способностью грунта и положением опор; об этом справка про <a href="/spravochnik/nesushchaya-sposobnost-grunta/" style="color:var(--yellow)">несущую способность грунта</a>.</p>
    <p>Пять метров от подвижных рабочих органов, о которых говорит справка про <a href="/spravochnik/opasnaya-zona-krana/" style="color:var(--yellow)">опасную зону крана</a>, и отлёт груза по таблице 1 — разные величины с разным назначением. Работу в стеснённом дворе у стены дома, где граница из таблицы встречается с зазорами 0,5 и 2,3 м, разбирает справка о <a href="/spravochnik/podyom-gruza-u-steny-doma-v-moskve-fnp-461/" style="color:var(--yellow)">подъёме груза у стены дома</a>.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: отлёт груза и опасная зона</h2>
    <ul>
      <li>Граница опасной зоны = проекция груза или стена здания + наибольший габарит груза + отлёт по таблице 1 приложения №2 ФНП №461.</li>
      <li>Отлёт груза при перемещении ПС: 4 м до 10 м высоты, 7 м до 20 м, 10 м до 70 м, 15 м до 120 м, 20 м до 200 м.</li>
      <li>При расстоянии от груза до границы опасной зоны менее 7 м скорость поворота стрелы ограничивают до минимальной (п. 156 «ж»).</li>
      <li>Опасная зона от падения самого крана в расчёт не входит; решения по чужим зданиям согласуют с их владельцем.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://www.consultant.ru/document/cons_doc_LAW_373321/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 (приказ Ростехнадзора от 26.11.2020 №461)</a> — п. 156 «ж» (мероприятия в ППР, опасные зоны, 7 м, согласование), приложение №2 (п. 1 и таблица 1, отлёт груза).</li>
      <li><a href="https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 на legalacts.ru</a> — редакция от 16.04.2026, текст сверен 23.10.2026.</li>
    </ul>
    <p class="small muted">Пример с плитой 6 м на высоте 15 м и линейная интерполяция — арифметическая иллюстрация; вид интерполяции в нормативном тексте не уточнён, поэтому выбор способа и его фиксация в ППР — практика МОСКРАН-СЕРВИС.</p>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-16-25-tonn/">Аренда автокрана 16–25 тонн →</a></section>
</main>
</SpravochnikLayout>
