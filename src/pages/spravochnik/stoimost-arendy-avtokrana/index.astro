---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = 'Как считается стоимость аренды автокрана в Москве';
const description = 'Цена аренды автокрана МОСКРАН-СЕРВИС: ставка за час × 8 часов × смены, × 1,12 на режимном объекте. Примеры для 16–50 т и что не входит в смету.';

const CHECKED = '25.09.2026';
const PUBLISHED = '2026-09-25';
const SLUG = 'stoimost-arendy-avtokrana';
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: 'Можно ли заказать автокран на 3–4 часа, а не на смену?',
    a: 'Минимальный заказ в МОСКРАН-СЕРВИС — одна смена 8 часов, для автокрана 16–20 т это 17 600 ₽. Подача крана, установка на опоры и сборка занимают время независимо от длины работы, поэтому короткий заказ считается как смена. Если работы на 3 часа, выгоднее собрать в ту же смену соседние подъёмы.',
  },
  {
    q: 'Входит ли работа крановщика в ставку?',
    a: 'Да. МОСКРАН-СЕРВИС сдаёт автокраны с экипажем, то есть по договору аренды транспортного средства с экипажем (ст. 632 ГК РФ). По ст. 635 ГК РФ расходы на оплату членов экипажа по умолчанию несёт арендодатель, поэтому оплата крановщика уже внутри часовой ставки.',
  },
  {
    q: 'Почему на режимном объекте цена выше на 12 %?',
    a: 'Коэффициент 1,12 в калькуляторе МОСКРАН-СЕРВИС покрывает оформление пропуска на технику и бригаду и время на досмотр при въезде. Это не произвольная наценка: формула одинакова для всех классов кранов и видна на главной странице до отправки заявки.',
  },
  {
    q: 'Кто платит, если кран приехал, а площадка не готова?',
    a: 'Простой по вине заказчика сверх согласованного времени в ставку МОСКРАН-СЕРВИС не входит и оплачивается отдельно. Порядок оплаты простоя фиксируется в договоре до подтверждения заявки. Чтобы его избежать, до приезда крана проверьте проезд, место под опоры и готовность груза.',
  },
  {
    q: 'До какого числа действуют опубликованные ставки?',
    a: 'Ставки МОСКРАН-СЕРВИС на сайте действуют до 17.02.2027 — дата указана рядом с калькулятором на главной странице. Если заявка подаётся ближе к этой дате, окончательную сумму диспетчер называет при подтверждении заявки, до выезда техники.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Стоимость аренды автокрана', item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ['formula', 'Формула цены МОСКРАН-СЕРВИС'],
  ['stavki', 'Ставки по классам автокранов'],
  ['primery', 'Примеры расчёта'],
  ['ne-vhodit', 'Что не входит в ставку'],
  ['kak-snizit', 'Как не переплатить за класс крана'],
  ['faq', 'Частые вопросы'],
  ['istochniki', 'Источники'],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Стоимость аренды автокрана</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Инструкция для заказчика · Цена</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Как считается стоимость аренды автокрана в Москве?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>25.09.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>25.09.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>6 мин чтения</span>
    </div>

    <p>Аренда автокрана в МОСКРАН-СЕРВИС считается по одной формуле: ставка за час × 8 часов × число смен, а на объекте с пропускным режимом итог умножается на 1,12. Смена 8 часов — минимальный заказ, поэтому самый лёгкий кран 16–20 т стоит от 17 600 ₽, а 50-тонный — от 31 200 ₽ за смену. Подача, выходные и простой по вине заказчика считаются отдельно и называются до подтверждения заявки.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="formula" style="margin:36px 0 16px">Формула цены МОСКРАН-СЕРВИС</h2>
    <p>Цена аренды автокрана в МОСКРАН-СЕРВИС складывается из трёх множителей: часовой ставки класса, 8 часов смены и числа смен. Часовая ставка зависит только от класса машины по грузоподъёмности — 16–20 т, 25 т, 32 т или 50 т. Кран сдаётся с крановщиком, то есть по договору аренды транспортного средства с экипажем по статье 632 ГК РФ, и оплата экипажа уже внутри ставки. Для объектов с пропускным режимом МОСКРАН-СЕРВИС применяет коэффициент 1,12: он покрывает оформление пропуска на технику и бригаду.</p>
    <p>Смена в 8 часов — минимальный заказ МОСКРАН-СЕРВИС, даже если сам подъём занимает час. Автокран нужно довезти до площадки, выставить на выносные опоры, выдвинуть стрелу и после работы привести в транспортное положение. Это время не зависит от длины работы, поэтому почасовой заказ на 2–3 часа в Москве не дешевле смены: подготовительная часть всё равно занимает машину на полдня.</p>

    <h2 id="stavki" style="margin:36px 0 16px">Ставки по классам автокранов</h2>
    <p>Ставки МОСКРАН-СЕРВИС опубликованы на главной странице сайта и действуют до 17.02.2027; ниже они же, пересчитанные на смену. Разница между соседними классами — 400–800 ₽ в час, а между крайними классами 16 т и 50 т — 1 700 ₽ в час, или 13 600 ₽ за смену. Именно поэтому класс крана выгодно подбирать по вылету и массе груза, а не «с запасом».</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Класс</th><th>Ставка, ₽/час</th><th>1 смена, ₽</th><th>С пропуском, ₽</th></tr></thead>
        <tbody>
          <tr><td>16–20 т</td><td>2 200</td><td>17 600</td><td>19 712</td></tr>
          <tr><td>25 т</td><td>2 600</td><td>20 800</td><td>23 296</td></tr>
          <tr><td>32 т</td><td>3 100</td><td>24 800</td><td>27 776</td></tr>
          <tr><td>50 т</td><td>3 900</td><td>31 200</td><td>34 944</td></tr>
        </tbody>
      </table>
    </div>
    <p>Модели в каждом классе МОСКРАН-СЕРВИС перечислены в <a href="/park/" style="color:var(--yellow)">разделе «Парк»</a>: например, 16 т — «Ивановец» КС-35714 на шасси Урал, 25 т — «Клинцы» КС-55713 и «Челябинец» КС-55732, 50 т — «Галичанин» КС-65713-1 и Liebherr LTM 1050. Ставка одинакова для всех машин класса, поэтому выбор модели внутри класса на цену не влияет.</p>

    <h2 id="primery" style="margin:36px 0 16px">Примеры расчёта</h2>
    <p>Разгрузка плит во дворе краном 25 т на две смены обойдётся в МОСКРАН-СЕРВИС в 2 600 × 8 × 2 = 41 600 ₽. Тот же объём работ на территории завода с проходной и досмотром техники — 41 600 × 1,12 = 46 592 ₽. Монтаж оборудования 50-тонным краном «Галичанин» КС-65713-1 за одну смену на режимном объекте — 3 900 × 8 × 1,12 = 34 944 ₽. Рабочая неделя из пяти смен краном 16–20 т — 2 200 × 8 × 5 = 88 000 ₽.</p>
    <p>Калькулятор на <a href="/#uslugi" style="color:var(--yellow)">главной странице МОСКРАН-СЕРВИС</a> считает ровно по этой формуле и использует тот же массив ставок, что и таблица выше, — разойтись с ценой в заявке он не может. К расчёту добавляются только позиции, которые зависят от конкретного объекта, — подача и нестандартное время работы.</p>

    <h2 id="ne-vhodit" style="margin:36px 0 16px">Что не входит в ставку</h2>
    <p>Три позиции в часовую ставку МОСКРАН-СЕРВИС не входят и называются диспетчером до подтверждения заявки, а не в акте после работ:</p>
    <ul>
      <li><strong>Подача техники.</strong> Зависит от удалённости площадки от базы.</li>
      <li><strong>Выходные и праздники.</strong> Считаются по отдельному тарифу.</li>
      <li><strong>Простой по вине заказчика.</strong> Время сверх согласованного, когда кран стоит без работы.</li>
    </ul>
    <p>Простой — самая частая причина роста итоговой суммы, и почти всегда он возникает до первого подъёма: кран МОСКРАН-СЕРВИС приехал, а груз не доставлен, проезд перекрыт или стропальщика нет. Как распределяется оплата простоя и что записать в договор, разобрано в <a href="/spravochnik/prostoy-tehniki-oplata/" style="color:var(--yellow)">материале о простое техники</a>. Для Москвы отдельно стоит учесть пропуск на въезд грузового транспорта — без него автокран не доедет до площадки в пределах МКАД.</p>

    <h2 id="kak-snizit" style="margin:36px 0 16px">Как не переплатить за класс крана</h2>
    <p>Главная переплата при аренде автокрана — лишний класс: 50-тонный кран вместо 25-тонного добавляет 10 400 ₽ за каждую смену по ставкам МОСКРАН-СЕРВИС. Тоннаж в названии крана — это грузоподъёмность на минимальном вылете, и один и тот же груз на 5 м и на 15 м требует разных машин. Поэтому класс подбирается по массе самого тяжёлого груза, вылету до точки опускания и высоте подъёма.</p>
    <p>Точный подбор класса МОСКРАН-СЕРВИС делает по заявке, где есть масса груза, вылет, место установки и сети рядом, — перечень данных приведён в <a href="/spravochnik/zayavka-na-avtokran/" style="color:var(--yellow)">материале о заявке на автокран</a>. Когда 25 т не хватает, а когда 50 т — избыточны, разобрано в сравнении <a href="/spravochnik/avtokran-25-ili-50-tonn/" style="color:var(--yellow)">«Автокран 25 или 50 тонн»</a>.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: как посчитать цену</h2>
    <ul>
      <li>Ставка за час × 8 × число смен.</li>
      <li>Пропускной режим — × 1,12.</li>
      <li>Минимум — одна смена: от 17 600 ₽.</li>
      <li>Подача, выходные, простой — отдельно.</li>
      <li>Ставки на сайте действуют до 17.02.2027.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="/" style="color:var(--yellow)">Ставки и формула калькулятора МОСКРАН-СЕРВИС</a> — главная страница сайта, ставки действуют до 17.02.2027.</li>
      <li><a href="https://www.consultant.ru/document/cons_doc_LAW_9027/1ffe0cb622bfbe86c61d7d6df4c8c6011dfb45fe/" target="_blank" rel="noopener" style="color:var(--yellow)">ГК РФ, ст. 632</a> — договор аренды транспортного средства с экипажем.</li>
      <li><a href="https://base.garant.ru/10164072/08b7d927fd863bb6a25ed3796d6629ee/" target="_blank" rel="noopener" style="color:var(--yellow)">ГК РФ, ст. 632–649</a> — аренда транспортных средств, в т. ч. ст. 635 о расходах на экипаж.</li>
    </ul>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-16-25-tonn/">Подробнее об аренде автокрана 16–25 тонн →</a></section>
</main>
</SpravochnikLayout>
