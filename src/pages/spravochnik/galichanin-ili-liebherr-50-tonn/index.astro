---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = '«Галичанин» или Liebherr LTM 1050: какой кран 50 т';
const description = 'КС-65713-1 «Галичанин» (стрела 34,1 м, 4 оси) против Liebherr LTM 1050-3.1 (38 м, высота 54 м, 3 оси): стрела, опоры, шасси. Смена — 31 200 ₽.';

const CHECKED = '28.09.2026';
const PUBLISHED = '2026-09-28';
const SLUG = 'galichanin-ili-liebherr-50-tonn';
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: 'Что лучше для монтажа на высоте: «Галичанин» или Liebherr LTM 1050-3.1?',
    a: 'Для высоты выигрывает Liebherr LTM 1050-3.1: высота подъёма до 54 м и вылет до 44 м против 50,4 м и 32 м у КС-65713-1 «Галичанин» в максимальной комплектации. На вылете до 20 м обе машины решают большинство задач класса 50 т, и МОСКРАН-СЕРВИС выбирает между ними по площадке и доступности на дату.',
  },
  {
    q: 'Почему аренда Liebherr и «Галичанина» стоит одинаково?',
    a: 'МОСКРАН-СЕРВИС считает ставку по классу грузоподъёмности, а не по марке: для класса 50 т это 3 900 ₽ в час, смена 8 часов — 31 200 ₽. Наценку за импортную машину сервис не вводит. Заказчик выбирает кран по стреле и площадке, а цена смены от выбора не меняется.',
  },
  {
    q: 'Какому крану нужна меньшая площадка?',
    a: 'Максимальный опорный контур у Liebherr LTM 1050-3.1 — 7,15 × 6,4 м против 7,2 × 7,0 м у «Галичанина». Опция VarioBase на Liebherr позволяет выдвигать опоры на разную длину, если одна сторона площадки упирается в забор. МОСКРАН-СЕРВИС уточняет, есть ли VarioBase на конкретной машине, потому что это опция.',
  },
  {
    q: 'Какой 50-тонный кран быстрее доедет до объекта в Москве?',
    a: 'Liebherr LTM 1050-3.1 разгоняется до 85 км/ч на трёхосном шасси, КС-65713-1 «Галичанин» — до 50 км/ч, а с установленным гуськом 40 км/ч. Для объекта за МКАД в Подмосковье разница в подаче заметна. Время подачи МОСКРАН-СЕРВИС называет в заявке с учётом пропуска в зону МКАД.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: '«Галичанин» или Liebherr', item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ['tablica', 'КС-65713-1 и LTM 1050-3.1: таблица'],
  ['strela', 'Стрела, высота и вылет'],
  ['opory', 'Опорный контур и VarioBase'],
  ['shassi', 'Шасси: четыре оси против трёх'],
  ['vybor', 'Когда какой кран выбирать'],
  ['faq', 'Частые вопросы'],
  ['istochniki', 'Источники'],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>«Галичанин» или Liebherr</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Выбор техники · Класс 50 т</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">«Галичанин» или Liebherr LTM 1050: какой автокран 50 тонн выбрать?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>28.09.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>28.09.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>6 мин чтения</span>
    </div>

    <p>Liebherr LTM 1050-3.1 нужен, когда важны высота и вылет: стрела 38 м, высота подъёма до 54 м и вылет до 44 м против 34,1 м, 50,4 м и 32 м у КС-65713-1 «Галичанин». Смена обеих машин в МОСКРАН-СЕРВИС стоит одинаково — 31 200 ₽, поэтому выбор делают по стреле, площадке и шасси, а не по цене.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="tablica" style="margin:36px 0 16px">КС-65713-1 и LTM 1050-3.1: таблица</h2>
    <p>КС-65713-1 «Галичанин» и Liebherr LTM 1050-3.1 поднимают по 50 т на минимальном вылете, но различаются стрелой, опорами и шасси. МОСКРАН-СЕРВИС свёл данные изготовителя Liebherr и дилера «Галичанина» в одну таблицу; у разных исполнений цифры отличаются, и решает паспорт конкретной машины.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Параметр</th><th>КС-65713-1 «Галичанин»</th><th>Liebherr LTM 1050-3.1</th></tr></thead>
        <tbody>
          <tr><td>Грузоподъёмность</td><td>50 т</td><td>50 т на вылете 3 м</td></tr>
          <tr><td>Телескопическая стрела</td><td>11,5–34,1 м</td><td>11,4–38 м</td></tr>
          <tr><td>Гусёк</td><td>9,1–15,1 м</td><td>до 16 м</td></tr>
          <tr><td>Высота подъёма, максимум</td><td>34,5 м; 50,4 м со вставкой и гуськом</td><td>54 м</td></tr>
          <tr><td>Максимальный вылет</td><td>32 м</td><td>44 м</td></tr>
          <tr><td>Опорный контур, максимум</td><td>7,2 × 7,0 м</td><td>7,15 × 6,4 м; VarioBase — опция</td></tr>
          <tr><td>Противовес</td><td>до 10 т</td><td>9 т</td></tr>
          <tr><td>Шасси</td><td>4 оси, 8×4</td><td>3 оси, 6×4×6, все колёса управляемые</td></tr>
          <tr><td>Скорость по дороге</td><td>50 км/ч; 40 км/ч с гуськом</td><td>85 км/ч</td></tr>
          <tr><td>Смена в МОСКРАН-СЕРВИС</td><td>31 200 ₽</td><td>31 200 ₽</td></tr>
        </tbody>
      </table>
    </div>

    <h2 id="strela" style="margin:36px 0 16px">Стрела, высота и вылет</h2>
    <p>Liebherr LTM 1050-3.1 выигрывает у «Галичанина» 3,9 м основной стрелы и 12 м максимального вылета — это разница между «достаём» и «не достаём» при монтаже на кровлю или через здание. У КС-65713-1 высота 50,4 м получается только со вставкой и гуськом, а LTM 1050-3.1 доходит до 54 м с двухсекционным складным гуськом. МОСКРАН-СЕРВИС предлагает Liebherr первым, когда вылет в заявке больше 25–30 м.</p>
    <p>На вылете до 15–20 м разница между машинами для заказчика почти не видна: обе поднимают типовые плиты перекрытия, фермы и технологическое оборудование. Грузоподъёмность на конкретном вылете МОСКРАН-СЕРВИС сверяет по грузовысотной характеристике каждой машины, потому что при одинаковой цифре 50 т таблицы у кранов разные. Логика подбора по вылету разобрана в <a href="/spravochnik/gruzovysotnaya-harakteristika/" style="color:var(--yellow)">материале о грузовысотной характеристике</a>.</p>

    <h2 id="opory" style="margin:36px 0 16px">Опорный контур и VarioBase</h2>
    <p>Максимальный опорный контур Liebherr LTM 1050-3.1 — 7,15 × 6,4 м, у КС-65713-1 «Галичанин» — 7,2 × 7,0 м, то есть трёхосный Liebherr на 0,6 м уже в раскрытом положении. Для московского двора, где кран встаёт между бордюром и газоном, эти 60 см решают, помещается ли машина. МОСКРАН-СЕРВИС замеряет ширину площадки по фото или на выезде инженера до выбора крана.</p>
    <p>Система VarioBase на Liebherr LTM 1050-3.1 позволяет выдвигать каждую опору на свою длину, и кран работает, даже если одна сторона упирается в забор. VarioBase — опция производителя, а не стандарт, поэтому МОСКРАН-СЕРВИС проверяет её наличие на конкретной машине. Требования ФНП №461 к площадке под опоры — в <a href="/spravochnik/nesushchaya-sposobnost-grunta/" style="color:var(--yellow)">материале о несущей способности грунта</a>.</p>

    <h2 id="shassi" style="margin:36px 0 16px">Шасси: четыре оси против трёх</h2>
    <p>КС-65713-1 «Галичанин» стоит на четырёхосном шасси 8×4 и по дороге идёт до 50 км/ч, а с гуськом — до 40 км/ч. Нагрузка на заднюю тележку «Галичанина» по данным дилера — 21,6 тонны. Liebherr LTM 1050-3.1 — трёхосный вездеходный кран со всеми управляемыми колёсами и скоростью до 85 км/ч. МОСКРАН-СЕРВИС учитывает это при подаче на объект в Подмосковье, где время в пути входит в оплачиваемую смену.</p>
    <p>Управляемые колёса всех осей дают Liebherr LTM 1050-3.1 меньший радиус разворота во дворе и на въезде на стройплощадку, чем у длинного четырёхосного шасси «Галичанина». Для въезда в зону МКАД обеим машинам нужен пропуск, а при превышении осевых нагрузок — спецразрешение. МОСКРАН-СЕРВИС оформляет пропуск по правилам из <a href="/spravochnik/propusk-avtokrana-v-moskvu/" style="color:var(--yellow)">материала о пропуске автокрана в Москву</a>.</p>

    <h2 id="vybor" style="margin:36px 0 16px">Когда какой кран выбирать</h2>
    <p>Liebherr LTM 1050-3.1 МОСКРАН-СЕРВИС выбирает для вылета больше 30 м, высоты больше 45 м, узкой площадки и тесного въезда. КС-65713-1 «Галичанин» подходит для разгрузки и монтажа на вылете до 20–25 м, где его стрелы и опорного контура хватает с запасом. Решающее условие — свободная машина на дату, поэтому в заявке полезно указать, какой из двух кранов проходит по расчёту.</p>
    <p>Если груз легче 25 т и вылет небольшой, класс 50 т может быть лишним: XCMG QY25K5-I со стрелой 38,5 м за 20 800 ₽ в смену часто закрывает ту же высоту. Сравнение классов МОСКРАН-СЕРВИС разобрал в материалах <a href="/spravochnik/avtokran-25-ili-50-tonn/" style="color:var(--yellow)">«25 или 50 тонн»</a> и <a href="/spravochnik/klintsy-ili-xcmg-25-tonn/" style="color:var(--yellow)">«Клинцы или XCMG»</a>.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: «Галичанин» или Liebherr</h2>
    <ul>
      <li>Liebherr LTM 1050-3.1 — стрела 38 м, высота 54 м, вылет 44 м.</li>
      <li>КС-65713-1 «Галичанин» — стрела 34,1 м, вылет 32 м, опоры до 7,2 × 7,0 м.</li>
      <li>Liebherr уже на 0,6 м в опорах и маневреннее на трёх управляемых осях.</li>
      <li>Смена в МОСКРАН-СЕРВИС одинаковая — 31 200 ₽.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://www.liebherr.com/en-us/p/ltm105031-4407335" target="_blank" rel="noopener" style="color:var(--yellow)">Liebherr LTM 1050-3.1 — страница производителя</a> — 50 т на вылете 3 м, стрела 11,4–38 м, решётчатый гусёк до 16 м, высота 54 м, вылет 44 м, балласт 9 т, 6×4×6, 85 км/ч, VarioBase — опция.</li>
      <li>Технический паспорт-проспект Liebherr LTM 1050-3.1 (раздел Dimensions) — опорный контур 23'6" × 21' (≈ 7,15 × 6,4 м).</li>
      <li><a href="https://kran-master74.ru/heavy/truck_cranes/galichanin/avtokran_galichanin_ks_65713_1_50_t/" target="_blank" rel="noopener" style="color:var(--yellow)">КС-65713-1 «Галичанин» — характеристики у дилера</a> — 175 т·м, стрела 11,5–34,1 м, гусёк 9,1–15,1 м, высота 34,5 / 50,4 м, вылет 32 м, опоры 7,2 × 7,0 м, противовес 10 т, 8×4, 50 км/ч.</li>
      <li>Ставка класса 50 т — прайс МОСКРАН-СЕРВИС (3 900 ₽/ч, смена 8 ч), действует до 17.02.2027.</li>
    </ul>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-40-50-tonn/">Подробнее об аренде автокрана 40–50 тонн →</a></section>
</main>
</SpravochnikLayout>
