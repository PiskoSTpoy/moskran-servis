---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';
import Sources from '../../../components/Sources.astro';

const title = 'Требования ПДД к знаку «Крупногабаритный груз» на автокране';
const description = 'Когда автокран на марше обязан нести опознавательный знак 400×400 мм и когда включается жёлтый проблесковый маячок.';

const CHECKED = '12.08.2026';

/* --- Волна 14 (дедупликация сети) -------------------------------------------
   Из статьи убран блок про согласование специального разрешения на движение
   тяжеловесного и крупногабаритного транспорта: это отдельная тема, закреплённая
   в сети за другим сайтом, и держать её пересказ здесь означало вести одну тему
   с двух площадок. Статья сужена до того, что относится к самой маркировке.

   Заодно исправлены две фактические ошибки прежней версии:
   • спецификация знака приписывалась ГОСТ Р 12.4.026-2001 — это стандарт на
     сигнальные цвета и знаки безопасности на производстве, к опознавательным
     знакам транспортных средств он отношения не имеет. Верный источник —
     пункт 8 Основных положений по допуску транспортных средств к эксплуатации
     (приложение к ПДД РФ);
   • в пункте 23.4 ПДД условие звучит «спереди и сзади более чем на 1 м», а не
     «спереди или сзади», как было написано.
   Формулировки сверены по тексту ПДД 12.08.2026. */

const faqs = [
  { q: 'Когда автокран на марше обязан нести знак «Крупногабаритный груз»?', a: 'Когда груз или конструктивный элемент выступает за габариты транспортного средства спереди и сзади более чем на 1 метр либо сбоку более чем на 0,4 метра от внешнего края габаритного огня — так сформулирован пункт 23.4 ПДД РФ. У автокрана в транспортном положении под это чаще всего попадает стрела или элементы противовеса, которые не удалось убрать в габарит шасси.' },
  { q: 'Как именно выглядит знак и чем это установлено?', a: 'Щиток размером 400×400 мм с нанесёнными по диагонали чередующимися красными и белыми световозвращающими полосами шириной 50 мм. Описание даёт пункт 8 «Опознавательные знаки» Основных положений по допуску транспортных средств к эксплуатации — приложения к Правилам дорожного движения. Знак ставится с той стороны, с которой груз выходит за габарит; если выступ и сзади, и вбок — знаки нужны на каждой такой стороне.' },
  { q: 'Когда включается жёлтый проблесковый маячок?', a: 'По пункту 3.4 ПДД жёлтый или оранжевый проблесковый маячок включается, в частности, при движении крупногабаритных и тяжеловесных транспортных средств и при их сопровождении. Важная оговорка того же пункта: такой маячок не даёт преимущества в движении и служит только предупреждением для остальных участников.' },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Знак «Крупногабаритный груз» на автокране', item: 'https://moskran-servis.ru/spravochnik/markirovka-negabarita-pri-transportirovke/' },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@id': 'https://moskran-servis.ru/#organization' }, // ссылка на единственный узел организации (BaseLayout): отдельный узел с тем же @id, но другим name, был противоречием в графе
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: 'https://moskran-servis.ru/spravochnik/markirovka-negabarita-pri-transportirovke/',
  inLanguage: 'ru-RU',
  datePublished: '2026-08-12',
  dateModified: '2026-08-12',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<SpravochnikLayout title={title} description={description} path="/spravochnik/markirovka-negabarita-pri-transportirovke/" slug="markirovka-negabarita-pri-transportirovke" ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Знак «Крупногабаритный груз» на автокране</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Разбор для заказчика</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Знак «Крупногабаритный груз» на автокране: точные требования ПДД</h1>
    <p class="ref-byline">Инженерная служба МОСКРАН-СЕРВИС · обновлено 12.08.2026</p>

    <p>Пока автокран едет по дорогам общего пользования, он не спецтехника, а обычное транспортное средство и подчиняется ПДД. Разбираем узкий вопрос: когда на нём обязана появиться маркировка крупногабаритного груза и как эта маркировка устроена по букве правил. Только маркировка — процедура получения специального разрешения на движение тяжеловесного и крупногабаритного транспорта это отдельный сюжет, и мы его здесь не пересказываем.</p>

    <h2 style="margin:36px 0 16px">Условие из пункта 23.4 ПДД</h2>
    <p>Формулировка правил такая: груз, выступающий за габариты транспортного средства спереди и сзади более чем на 1 метр или сбоку более чем на 0,4 метра от внешнего края габаритного огня, должен быть обозначен опознавательными знаками «Крупногабаритный груз». Обратите внимание на союз: по продольной оси условие сформулировано через «и», по боковой — отдельным порогом в 0,4 метра.</p>
    <p>У автокрана в транспортном положении под это подпадает прежде всего стрела, если она не убирается в габарит шасси, и элементы противовеса. Проверяется это не «на глаз в день выезда», а заранее, по конкретной модели: у каждой машины парка транспортное положение известно, и вопрос решается до постановки в график, а не на выезде из бокса.</p>

    <h2 style="margin:36px 0 16px">Как устроен сам знак</h2>
    <p>Щиток 400×400 мм, по диагонали — чередующиеся красные и белые световозвращающие полосы шириной 50 мм. Это описание даёт пункт 8 «Опознавательные знаки» Основных положений по допуску транспортных средств к эксплуатации — приложения к ПДД, а не какой-либо производственный ГОСТ на знаки безопасности: путаница здесь встречается регулярно, в том числе в чужих статьях на эту тему.</p>
    <p>Знак размещается с той стороны, с которой груз выходит за габарит. Если выступ есть и сзади, и вбок — знаки ставятся на каждую из этих сторон отдельно, один щиток «за всё» правилам не соответствует.</p>

    <h2 style="margin:36px 0 16px">Свет: световозвращатели и проблесковый маячок</h2>
    <p>Тот же пункт 23.4 добавляет к знаку световую часть: в тёмное время суток и в условиях недостаточной видимости выступающая часть обозначается спереди фонарём или световозвращателем белого цвета, сзади — красного.</p>
    <p>Проблесковый маячок — отдельное требование из другого раздела правил. По пункту 3.4 ПДД жёлтый или оранжевый проблесковый маячок включается при движении крупногабаритных и тяжеловесных транспортных средств, а также при их сопровождении. Там же прямо сказано, что включённый жёлтый маячок не даёт никакого преимущества в движении — он только предупреждает. Это стоит помнить, когда подача техники планируется в московский утренний трафик: маячок не ускоряет ничего.</p>

    <h2 style="margin:36px 0 16px">Чего эта статья не покрывает</h2>
    <p>Три соседних вопроса намеренно оставлены за рамками, чтобы не смешивать разные процедуры:</p>
    <ul>
      <li><strong>Специальное разрешение на движение</strong> тяжеловесного и (или) крупногабаритного транспортного средства — это отдельная разрешительная процедура по пункту 23.5 ПДД и профильному законодательству, и маркировка её не заменяет и не отменяет.</li>
      <li><strong>Пропускной режим для грузового транспорта на московских магистралях</strong> — самостоятельная городская тема, к маркировке груза отношения не имеющая, но влияющая на то, в какое время техника физически доедет до объекта.</li>
      <li><strong>Перекрытие проезда на самом объекте</strong> — это уже не про марш, а про постановку крана, и разобрано в <a href="/spravochnik/soglasovanie-perekrytiya-proezda/" style="color:var(--yellow)">статье про согласование перекрытия проезда в Москве</a>.</li>
    </ul>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: что запомнить</h2>
    <ul>
      <li>Порог по пункту 23.4 ПДД: спереди и сзади более 1 м либо сбоку более 0,4 м от внешнего края габаритного огня.</li>
      <li>Знак — щиток 400×400 мм, диагональные красно-белые световозвращающие полосы по 50 мм; источник — пункт 8 Основных положений по допуску ТС, приложение к ПДД.</li>
      <li>Знак ставится на каждую сторону, с которой есть выступ, а не один на машину.</li>
      <li>В тёмное время добавляются световозвращатели: спереди белый, сзади красный.</li>
      <li>Жёлтый проблесковый маячок по пункту 3.4 предупреждает, но преимущества в движении не даёт.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <Sources
      checked={CHECKED}
      items={[
        { text: 'ПДД РФ, раздел 23 «Перевозка грузов» (пункты 23.4 и 23.5)', href: 'https://www.consultant.ru/document/cons_doc_LAW_2709/9f6f60efaee3994438e38b50a90595abfaaaf5a2/' },
        { text: 'ПДД РФ, раздел 3 «Применение специальных сигналов» (пункт 3.4)', href: 'https://www.consultant.ru/document/cons_doc_LAW_2709/367c97a177672081a40df5256f7b2150d8ff81c6/' },
        { text: 'Опознавательные знаки — пункт 8 Основных положений по допуску транспортных средств к эксплуатации', href: 'https://1pdd.ru/oz/' }
      ]}
    />
  </article>
  <section class="section wrap"><a class="btn" href="/spravochnik/soglasovanie-perekrytiya-proezda/">Согласование перекрытия проезда в Москве →</a></section>
</main>
</SpravochnikLayout>
