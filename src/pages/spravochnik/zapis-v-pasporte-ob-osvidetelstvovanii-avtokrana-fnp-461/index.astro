---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = 'Запись об освидетельствовании в паспорте автокрана';
const description = 'Что должна подтверждать запись об освидетельствовании в паспорте автокрана и кто её делает: п. 167, 168, 189, 190 ФНП №461. Что проверить до заявки.';

const CHECKED = '14.10.2026';
const PUBLISHED = '2026-10-14';
const SLUG = 'zapis-v-pasporte-ob-osvidetelstvovanii-avtokrana-fnp-461';
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: 'Кто делает запись об освидетельствовании в паспорте автокрана?',
    a: 'Инженерно-технический работник, ответственный за осуществление производственного контроля при эксплуатации подъёмных сооружений, который проводил освидетельствование (п. 189 ФНП №461). В запись он вносит срок следующего освидетельствования. МОСКРАН-СЕРВИС сверяет фамилию и должность в записи с приказом о назначении.',
  },
  {
    q: 'Что должна подтверждать запись для действующего автокрана?',
    a: 'Три вещи: кран отвечает требованиям ФНП, находится в работоспособном состоянии и выдержал испытания (п. 189 ФНП №461). Для вновь смонтированного крана запись подтверждает также монтаж по руководству по эксплуатации. Формулировку МОСКРАН-СЕРВИС читает в паспорте дословно, без пересказа.',
  },
  {
    q: 'Кто разрешает дальнейшую работу крана после освидетельствования?',
    a: 'Разрешение на дальнейшую работу выдаёт тот же инженерно-технический работник, ответственный за производственный контроль, с соответствующей записью в паспорте (п. 189 ФНП №461). Отдельного документа от Ростехнадзора для этого не нужно. МОСКРАН-СЕРВИС ищет эту запись рядом со сроком следующего освидетельствования.',
  },
  {
    q: 'Что проверяют при освидетельствовании металлоконструкций автокрана?',
    a: 'Оценивают работоспособность расчётных элементов и соединений, ищут трещины, остаточные деформации, утонение стенок от коррозии, ослабление соединений кабины, лестниц, площадок и ограждений (п. 190 ФНП №461). Нормы браковки приведены в приложении №3 к ФНП. МОСКРАН-СЕРВИС числа оттуда в справку не выносит.',
  },
  {
    q: 'Как заказчику проверить запись, если паспорт в офисе арендодателя?',
    a: 'Попросить скан страницы с записью и сроком следующего освидетельствования до подписания заявки. Требования к хранению копий норма не задаёт, поэтому МОСКРАН-СЕРВИС присылает страницу по запросу и показывает оригинал при приёмке на площадке. Это практика службы, а не пункт нормы.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Запись об освидетельствовании в паспорте автокрана по ФНП №461', item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ['kto', 'Кто проводит освидетельствование и пишет запись'],
  ['osmotr', 'Что осматривают и проверяют в работе'],
  ['metall', 'Металлоконструкции: что ищут по п. 190'],
  ['zapis', 'Что должна подтверждать запись'],
  ['razreshenie', 'Разрешение на дальнейшую работу'],
  ['zakazchik', 'Как читать запись заказчику'],
  ['faq', 'Частые вопросы'],
  ['istochniki', 'Источники'],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Запись об освидетельствовании в паспорте автокрана по ФНП №461</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">ФНП №461 · Паспорт</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Что должна подтверждать запись об освидетельствовании в паспорте автокрана?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>14.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>14.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>6 мин чтения</span>
    </div>

    <p>Запись в паспорте действующего автокрана должна подтверждать три вещи: кран отвечает требованиям ФНП, находится в работоспособном состоянии и выдержал испытания (п. 189 ФНП №461). Запись делает инженерно-технический работник, проводивший освидетельствование, и указывает срок следующего. МОСКРАН-СЕРВИС проверяет эту страницу до отправки машины.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="kto" style="margin:36px 0 16px">Кто проводит освидетельствование и пишет запись</h2>
    <p>Освидетельствование проводит инженерно-технический работник, ответственный за производственный контроль при эксплуатации подъёмных сооружений, при участии работника, ответственного за содержание крана в работоспособном состоянии (п. 167 ФНП №461). Эту же роль называет п. 189 для записи в паспорте. МОСКРАН-СЕРВИС держит оба назначения приказом по организации.</p>
    <p>Для заказчика это означает, что подпись под записью принадлежит конкретному работнику собственника машины, а не подрядной «бумажной» структуре без ответственности. Роли и обязанности близкой должности — ответственного за безопасное производство работ — описаны в справке об <a href="/spravochnik/otvetstvennyy-za-bezopasnoe-proizvodstvo/" style="color:var(--yellow)">ответственном за безопасное производство работ</a>.</p>

    <h2 id="osmotr" style="margin:36px 0 16px">Что осматривают и проверяют в работе</h2>
    <p>Пункт 170 ФНП №461 требует при освидетельствовании осмотреть кран, а механизмы, тормоза, гидро- и электрооборудование, указатели, ограничители и регистраторы проверить в работе. Осмотр без проверки приборов безопасности запись не подтверждает. МОСКРАН-СЕРВИС при подготовке автокрана к заявке повторяет этот набор на машине КС-55713 «Клинцы» или КС-65713-1 «Галичанин».</p>
    <p>Приборы безопасности — ограничитель грузоподъёмности, указатель вылета и регистратор — отдельная тема норм. Их проверки в сроки из руководства по эксплуатации устанавливает п. 122, а допуск автокрана к объекту — материал о <a href="/spravochnik/kogda-avtokran-ne-dopuskayut-k-rabote-fnp-461/" style="color:var(--yellow)">недопуске автокрана к работе</a>.</p>

    <h2 id="metall" style="margin:36px 0 16px">Металлоконструкции: что ищут по п. 190</h2>
    <p>Пункт 190 ФНП №461 перечисляет, что проверяют в металлоконструкциях при освидетельствовании. Это оценка работоспособности расчётных элементов и сварных, клёпаных, болтовых соединений, поиск трещин, остаточных деформаций и утонения стенок от коррозии. Нормы браковки берут из приложения №3 к ФНП, если они не противоречат руководству. МОСКРАН-СЕРВИС этих чисел в справку не выносит.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Дефект по п. 190</th><th>Где ищут</th><th>Что подтверждает отсутствие</th></tr></thead>
        <tbody>
          <tr><td>трещины</td><td>расчётные элементы, сварные швы</td><td>целостность несущих узлов</td></tr>
          <tr><td>остаточные деформации</td><td>секции стрелы, рама, опоры</td><td>геометрию без изменений</td></tr>
          <tr><td>утонение стенок от коррозии</td><td>элементы конструкции</td><td>сохранение расчётного сечения</td></tr>
          <tr><td>ослабление соединений</td><td>кабина, лестницы, площадки, ограждения</td><td>безопасный доступ</td></tr>
        </tbody>
      </table>
    </div>

    <h2 id="zapis" style="margin:36px 0 16px">Что должна подтверждать запись</h2>
    <p>Пункт 189 ФНП №461 задаёт два варианта записи: для вновь смонтированного и для действующего крана. Для вновь смонтированного крана она подтверждает, что кран смонтирован и установлен по руководству по эксплуатации и ФНП и выдержал испытания. Для действующего крана — что он отвечает требованиям ФНП, работоспособен и выдержал испытания (п. 189). МОСКРАН-СЕРВИС читает формулировку в паспорте, а не пересказ арендодателя.</p>
    <p>Результат освидетельствования по п. 168 также должен подтверждать две вещи: соответствие крана и его установки эксплуатационной документации и ФНП, а также состояние, обеспечивающее безопасную работу. Паспорт как документ и его состав разобраны в справке о <a href="/spravochnik/pasport-krana/" style="color:var(--yellow)">паспорте крана</a>.</p>

    <h2 id="razreshenie" style="margin:36px 0 16px">Разрешение на дальнейшую работу</h2>
    <p>Разрешение на дальнейшую работу действующего крана выдаёт инженерно-технический работник, ответственный за производственный контроль, и вносит его в паспорт (п. 189 ФНП №461). Отдельной «справки от Ростехнадзора» для этого норма не называет. МОСКРАН-СЕРВИС считает связку «запись плюс срок следующего освидетельствования» достаточным признаком допуска машины к работе.</p>
    <p>Срок следующего освидетельствования определяется периодичностью п. 165: частичное не реже одного раза в 12 месяцев, полное не реже одного раза в 3 года. Если в паспорте срок истёк, МОСКРАН-СЕРВИС на заявку машину не направляет. Что происходит с графиком после ремонта, описано в материале о <a href="/spravochnik/vneocherednoe-osvidetelstvovanie-avtokrana-fnp-461/" style="color:var(--yellow)">внеочередном освидетельствовании</a>.</p>

    <h2 id="zakazchik" style="margin:36px 0 16px">Как читать запись заказчику</h2>
    <p>Четыре элемента записи по п. 189 ФНП №461 заказчик проверяет без знания методики испытаний. МОСКРАН-СЕРВИС выдаёт на запрос скан страницы с этой записью до подписания заявки. Перечень — практика службы, составленная по п. 167 и п. 189.</p>
    <ul>
      <li>МОСКРАН-СЕРВИС показывает дату освидетельствования и вид: частичное или полное.</li>
      <li>Запись МОСКРАН-СЕРВИС содержит подпись инженерно-технического работника с указанием должности.</li>
      <li>Формулировку «отвечает требованиям, работоспособен, выдержал испытания» МОСКРАН-СЕРВИС приводит дословно.</li>
      <li>Срок следующего освидетельствования МОСКРАН-СЕРВИС называет с датой, не «по графику».</li>
    </ul>
    <p>Остальные документы собраны в материале <a href="/proverka-dokumentov/" style="color:var(--yellow)">о проверке документов</a>, а положение этой записи среди прочих сведений для подбора машины — в материале о <a href="/spravochnik/zayavka-na-avtokran/" style="color:var(--yellow)">заявке на автокран</a>.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: запись об освидетельствовании автокрана</h2>
    <ul>
      <li>МОСКРАН-СЕРВИС принимает запись как годную, если в ней три подтверждения: требования ФНП, работоспособность, испытания (п. 189 ФНП №461).</li>
      <li>Запись в МОСКРАН-СЕРВИС делает работник, ответственный за производственный контроль, с указанием срока следующего.</li>
      <li>Дальнейшую работу крана МОСКРАН-СЕРВИС подтверждает записью в паспорте, отдельной справки норма не называет.</li>
      <li>Металлоконструкции МОСКРАН-СЕРВИС оценивает по п. 190: трещины, деформации, коррозия, соединения.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://www.consultant.ru/document/cons_doc_LAW_373321/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 (приказ Ростехнадзора от 26.11.2020 №461)</a> — п. 165, 167–168 (кто и что подтверждает), п. 170 (осмотр и проверка в работе), п. 189–190 (запись в паспорте, металлоконструкции).</li>
      <li><a href="https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 на legalacts.ru</a> — редакция от 16.04.2026, текст пунктов 165, 167–170, 189–190 сверен 14.10.2026.</li>
    </ul>
    <p class="small muted">Нормы браковки из приложения №3 к ФНП в справке не приводятся: их применяют по руководству по эксплуатации конкретной машины. Перечень проверок записи для заказчика и запрос скана страницы — практика МОСКРАН-СЕРВИС, а не пункты нормы.</p>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-16-25-tonn/">Аренда автокрана 16–25 тонн →</a></section>
</main>
</SpravochnikLayout>
