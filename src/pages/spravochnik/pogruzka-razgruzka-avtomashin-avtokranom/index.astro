---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = 'Погрузка машин автокраном: что запрещает ФНП №461';
const description = 'Опускать груз на машину, где в кузове или кабине люди, нельзя (п. 125 ФНП №461). Пакеты труб и металла — только в двух пакетирующих стропах. Порядок работ.';

const CHECKED = '09.10.2026';
const PUBLISHED = '2026-10-09';
const SLUG = 'pogruzka-razgruzka-avtomashin-avtokranom';
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: 'Можно ли опускать груз на кузов, если водитель остался в кабине?',
    a: 'Нет. Пункт 125 ФНП №461 не разрешает ни опускать груз на автомашину, ни поднимать его с неё, пока в кузове или кабине находятся люди. Водитель выходит из кабины и отходит за границу опасной зоны. МОСКРАН-СЕРВИС просит заказчика предупредить водителя транспорта заранее.',
  },
  {
    q: 'Можно ли стропить пакет труб за обвязку, в которой его привезли?',
    a: 'Нельзя. Пункт 126 запрещает строповку пакетов труб и металлопроката за элементы упаковки: скрутки и стяжки не рассчитаны на подъём. МОСКРАН-СЕРВИС стропит такой пакет собственными стропами, а длинномерный груз берёт не менее чем двумя пакетирующими стропами.',
  },
  {
    q: 'Что делать, если на грузе нет маркировки массы и схемы строповки?',
    a: 'Работа допустима, но по пункту 127 её ведут под непосредственным руководством инженерно-технического работника, ответственного за безопасное производство работ с применением ПС. МОСКРАН-СЕРВИС до выезда просит у заказчика массу по документам поставщика, чтобы не подбирать кран наугад.',
  },
  {
    q: 'Нужны ли эстакады или площадки для стропальщика при разгрузке фуры?',
    a: 'В местах постоянной погрузки и разгрузки автомашин пункт 124 требует стационарные эстакады или навесные площадки для стропальщиков. Для разовой разгрузки на стройплощадке порядок задаёт ППР. МОСКРАН-СЕРВИС рекомендует закладывать место стропальщика в схему до начала работ.',
  },
  {
    q: 'Кто отвечает за равновесие машины при погрузке?',
    a: 'Пункт 126 требует выполнять погрузку и разгрузку транспортных средств без нарушения их равновесия, то есть укладывать груз так, чтобы борт не кренился. Схему погрузки разрабатывает эксплуатирующая организация крана и выдаёт на место работ (п. 122). МОСКРАН-СЕРВИС согласовывает схему с заказчиком.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Погрузка и разгрузка машин автокраном', item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ['lyudi', 'Люди в кабине и кузове'],
  ['ravnovesie', 'Равновесие машины и укладка груза'],
  ['pakety', 'Пакеты труб и металла: чем стропить'],
  ['bez-markirovki', 'Груз без массы и схемы строповки'],
  ['ploshchadka', 'Эстакады, схемы и место стропальщика'],
  ['zayavka', 'Что передать при заказе'],
  ['faq', 'Частые вопросы'],
  ['istochniki', 'Источники'],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Погрузка и разгрузка машин автокраном</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">ФНП №461 · Погрузочно-разгрузочные работы</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Что запрещает ФНП №461 при погрузке и разгрузке машин автокраном?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>09.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>09.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>5 мин чтения</span>
    </div>

    <p>Пункты 124–127 ФНП №461 запрещают три действия при работе автокрана с транспортом: опускать груз на машину или снимать его, пока в кузове или кабине есть люди, строповать пакеты труб за упаковочные стяжки и нарушать равновесие машины. МОСКРАН-СЕРВИС ставит эти запреты в заявку до выезда: нарушение на разгрузке фуры останавливает подъём независимо от тоннажа крана.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="lyudi" style="margin:36px 0 16px">Люди в кабине и кузове</h2>
    <p>Пункт 125 ФНП №461 не разрешает опускать груз на автомашину и поднимать груз, пока в кузове или кабине этой машины находятся люди. МОСКРАН-СЕРВИС применяет правило без исключений: водитель выходит из кабины и ожидает за пределами зоны перемещения груза, а грузчика в кузове при подъёме не оставляют. Норма относится и к подвозу материалов на стройплощадку, и к отправке с неё.</p>
    <p>Второе требование пункта 125 касается погрузки: груз кладут так, чтобы при последующей разгрузке стропы можно было завести безопасно. МОСКРАН-СЕРВИС просит поставщика укладывать груз так, чтобы место заведения стропов оставалось доступным. Как выбрать схему обвязки, описано в материале о <a href="/spravochnik/shemy-stropovki-gruzov/" style="color:var(--yellow)">схемах строповки грузов</a>.</p>

    <h2 id="ravnovesie" style="margin:36px 0 16px">Равновесие машины и укладка груза</h2>
    <p>Пункт 126 требует выполнять погрузку и разгрузку полувагонов, платформ, автомашин и других транспортных средств без нарушения их равновесия. Для заказчика это означает последовательность: МОСКРАН-СЕРВИС снимает груз с борта или укладывает его симметрично, чтобы платформа не кренилась в сторону вылета стрелы. Односторонняя выгрузка тяжёлого пакета с одного борта — типичный повод остановить работу.</p>
    <p>Положение стрелы при этом проверяют по таблице грузовой характеристики: вылет до дальнего борта фуры больше, чем до ближнего. Расчёт вылета описан в материале о том, <a href="/spravochnik/kak-opredelit-vylet-strely-avtokrana/" style="color:var(--yellow)">как определить вылет автокрана</a>.</p>

    <h2 id="pakety" style="margin:36px 0 16px">Пакеты труб и металла: чем стропить</h2>
    <p>Строповка пакетов труб или металлопроката за элементы упаковки запрещена пунктом 126: скрутки и стяжки не предназначены для подъёма. МОСКРАН-СЕРВИС заводит под пакет собственные испытанные стропы, а длинномерный груз берёт не менее чем двумя пакетирующими стропами подходящей грузоподъёмности — одним стропом такой груз не поднимают.</p>
    <p>Тип стропа МОСКРАН-СЕРВИС выбирает по грузу и его массе. Сравнение материалов стропов дано в материале о <a href="/spravochnik/tekstilnye-stropy/" style="color:var(--yellow)">текстильных стропах</a>.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Ситуация на разгрузке</th><th>Требование ФНП №461</th><th>Пункт</th></tr></thead>
        <tbody>
          <tr><td>Люди в кабине или кузове</td><td>груз не опускают и не поднимают</td><td>125</td></tr>
          <tr><td>Кузов или платформа может накрениться</td><td>работа без нарушения равновесия машины</td><td>126</td></tr>
          <tr><td>Пакет труб или проката в упаковке</td><td>строповка за скрутки и стяжки запрещена</td><td>126</td></tr>
          <tr><td>Длинномерный груз в пакетирующих стропах</td><td>не менее двух стропов</td><td>126</td></tr>
          <tr><td>Нет маркировки массы или схемы строповки</td><td>работа под руководством ИТР</td><td>127</td></tr>
          <tr><td>Постоянное место погрузки автомашин</td><td>эстакады или навесные площадки для стропальщиков</td><td>124</td></tr>
        </tbody>
      </table>
    </div>

    <h2 id="bez-markirovki" style="margin:36px 0 16px">Груз без массы и схемы строповки</h2>
    <p>Если на грузе нет маркировки массы или схемы строповки, пункт 127 разрешает работу только под непосредственным руководством инженерно-технического работника, ответственного за безопасное производство работ с применением ПС. МОСКРАН-СЕРВИС просит заказчика назначить такого работника в заявке или запросить массу у поставщика. Как этот специалист назначается, объясняет материал об <a href="/spravochnik/otvetstvennyy-za-bezopasnoe-proizvodstvo/" style="color:var(--yellow)">ответственном за безопасное производство работ</a>.</p>
    <p>Массу без паспорта груза оценивают взвешиванием или по документам изготовителя; способы разобраны в материале о <a href="/spravochnik/massa-tary-vzveshivanie/" style="color:var(--yellow)">массе тары и взвешивании</a>. Для МОСКРАН-СЕРВИС неизвестная масса — причина запросить документы до выезда, а не выбирать кран «с запасом».</p>

    <h2 id="ploshchadka" style="margin:36px 0 16px">Эстакады, схемы и место стропальщика</h2>
    <p>Пункт 124 требует в местах постоянной погрузки и разгрузки автомашин и полувагонов стационарных эстакад или навесных площадок для стропальщиков. На разовой разгрузке во дворе стройки эстакады нет, поэтому МОСКРАН-СЕРВИС опирается на пункт 122: эксплуатирующая организация разрабатывает и выдаёт на место ППР или технологическую карту со схемами погрузки и разгрузки транспортных средств.</p>
    <p>Порядок разгрузки с учётом проезда машины и места стропальщика входит в ППР; содержание документа описано в материале о <a href="/spravochnik/ppr-dlya-krana/" style="color:var(--yellow)">ППР для крана</a>. Для въезда крупной техники в центр Москвы отдельно проверяют правила движения — см. <a href="/spravochnik/propusk-avtokrana-v-moskvu/" style="color:var(--yellow)">пропуск автокрана в Москву</a>.</p>

    <h2 id="zayavka" style="margin:36px 0 16px">Что передать при заказе</h2>
    <p>Для подбора МОСКРАН-СЕРВИС нужны масса и размеры груза, число пакетов, тип транспорта, расстояние от оси крана до борта и место, где груз будет стоять. Масса и вылет определяют тоннаж: смена 16–20 т стоит 17 600 ₽, 25 т — 20 800 ₽, 32 т — 24 800 ₽, 50 т — 31 200 ₽ (ставки 2 200, 2 600, 3 100 и 3 900 ₽/ч × 8 ч). Заявку оформляют по порядку из материала о <a href="/spravochnik/zayavka-na-avtokran/" style="color:var(--yellow)">заявке на автокран</a>.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: погрузка и разгрузка машин</h2>
    <ul>
      <li>Люди в кабине или кузове — груз не опускают и не поднимают (п. 125).</li>
      <li>Машину нельзя перекашивать: работа без нарушения равновесия (п. 126).</li>
      <li>Пакеты труб и металла стропят не за упаковку; длинномерный груз — не менее чем двумя пакетирующими стропами (п. 126).</li>
      <li>Нет маркировки массы или схемы строповки — работа под руководством ИТР (п. 127).</li>
      <li>Схемы погрузки и разгрузки выдаёт на место эксплуатирующая организация (п. 122).</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://www.consultant.ru/document/cons_doc_LAW_373321/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 (приказ Ростехнадзора от 26.11.2020 №461)</a> — п. 122: обязанности эксплуатирующей организации, схемы погрузки и разгрузки; п. 124: эстакады и площадки для стропальщиков; п. 125–126: люди в машине, равновесие, упаковка пакетов, пакетирующие стропы; п. 127: работа без маркировки массы и схем строповки.</li>
    </ul>
    <p class="small muted">Текст пунктов сверен с редакцией ФНП №461 на legalacts.ru 09.10.2026. Ставки — из калькулятора на главной странице. МОСКРАН-СЕРВИС не заменяет проект производства работ и решение ответственного специалиста на объекте.</p>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-25-40-tonn/">Аренда автокрана 25–40 тонн →</a></section>
</main>
</SpravochnikLayout>
