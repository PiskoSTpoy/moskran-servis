---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = 'Автокран 25 т: «Клинцы» КС-55713-1К или XCMG QY25K5';
const description = '«Клинцы» КС-55713-1К (85 т·м, стрела 21 м, 20,2 т) или XCMG QY25K5-I (≈98 т·м, стрела 38,5 м, 31 т): что выбрать. Смена в МОСКРАН-СЕРВИС — 20 800 ₽.';

const CHECKED = '27.09.2026';
const PUBLISHED = '2026-09-27';
const SLUG = 'klintsy-ili-xcmg-25-tonn';
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: 'Почему смена XCMG и «Клинцов» стоит одинаково?',
    a: 'МОСКРАН-СЕРВИС тарифицирует автокраны по классу грузоподъёмности, а не по марке: для класса 25 т ставка 2 600 ₽ в час, смена 8 часов — 20 800 ₽. Поэтому XCMG QY25K5-I и «Клинцы» КС-55713-1К стоят одинаково, и выбирать между ними стоит по стреле, массе и подъезду.',
  },
  {
    q: 'Китайский автокран XCMG хуже отечественного?',
    a: 'По паспортным данным XCMG QY25K5-I не уступает: грузовой момент 961 кН·м (около 98 т·м) против 85 т·м у «Клинцов» КС-55713-1К, стрела 38,5 м против 21 м. Решающее для МОСКРАН-СЕРВИС — не страна сборки, а действующее освидетельствование и паспорт конкретной машины.',
  },
  {
    q: 'Какой кран лучше для подъёма на кровлю пятиэтажного дома?',
    a: 'Для кровли с вылетом больше 20 м обычно подходит XCMG QY25K5-I: пятисекционная стрела длиной до 38,5 м позволяет держать груз высоко на большом вылете. У «Клинцов» КС-55713-1К стрела 21 м, и такой подъём возможен только с гуськом 7,5 м. МОСКРАН-СЕРВИС проверяет высоту и вылет по грузовой таблице.',
  },
  {
    q: 'Пройдёт ли 31-тонный XCMG во двор или на частный участок?',
    a: 'Масса XCMG QY25K5-I в рабочем состоянии 31–31,75 т, у «Клинцов» КС-55713-1К — 20,2 т. На слабом покрытии, над подземным паркингом или на частной дороге МОСКРАН-СЕРВИС чаще подаёт более лёгкий кран, если его стрелы хватает. Основание под опоры проверяют для обоих.',
  },
  {
    q: 'Можно ли выбрать конкретную модель при заказе?',
    a: 'Да, в заявке можно указать модель, и МОСКРАН-СЕРВИС подтвердит её доступность на дату. Если задача решается обоими кранами, диспетчер предложит тот, что свободен и ближе к объекту; если нужна длинная стрела XCMG, это фиксируется в заявке как требование.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: '«Клинцы» или XCMG 25 т', item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ['sravnenie', 'КС-55713-1К и QY25K5-I: сравнение'],
  ['strela', 'Стрела 21 или 38,5 м: высота и вылет'],
  ['primer', 'Пример: груз 2 т на вылете 25 м'],
  ['massa', 'Масса 20 или 31 т: подъезд и основание'],
  ['vybor', 'Как выбирает МОСКРАН-СЕРВИС'],
  ['faq', 'Частые вопросы'],
  ['istochniki', 'Источники'],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>«Клинцы» или XCMG 25 т</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Выбор техники · Сравнение моделей</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Какой автокран 25 тонн выбрать: «Клинцы» или XCMG QY25K5?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>27.09.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>27.09.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>6 мин чтения</span>
    </div>

    <p>XCMG QY25K5-I берут, когда нужна длинная стрела: 38,5 м против 21 м у «Клинцов» КС-55713-1К и грузовой момент около 98 т·м против 85 т·м. «Клинцы» выигрывают массой — 20,2 т против 31 т, что важно на слабом основании и узком подъезде. Смена обоих кранов в МОСКРАН-СЕРВИС стоит одинаково, 20 800 ₽, поэтому выбор определяет задача.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="sravnenie" style="margin:36px 0 16px">КС-55713-1К и QY25K5-I: сравнение</h2>
    <p>Оба крана имеют номинальную грузоподъёмность 25 т и колёсную формулу 6×4, но XCMG QY25K5-I почти вдвое длиннее по стреле и на 11 т тяжелее «Клинцов» КС-55713-1К. МОСКРАН-СЕРВИС свёл данные заводских и дилерских карточек в таблицу; у разных исполнений одной модели цифры отличаются, и решает паспорт конкретной машины.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Параметр</th><th>«Клинцы» КС-55713-1К</th><th>XCMG QY25K5-I</th></tr></thead>
        <tbody>
          <tr><td>Грузовой момент</td><td>85 т·м</td><td>961 кН·м (≈ 98 т·м)</td></tr>
          <tr><td>Основная стрела</td><td>21 м</td><td>10,1–38,5 м, 5 секций</td></tr>
          <tr><td>Гусёк</td><td>7,5 м — опция</td><td>вылет с гуськом до 46,8 м</td></tr>
          <tr><td>Высота подъёма</td><td>21,6 м, с гуськом 29,3 м</td><td>по паспорту исполнения</td></tr>
          <tr><td>Опорный контур</td><td>4,9 × 6,1 м</td><td>5,14 × 6,0 м</td></tr>
          <tr><td>Масса</td><td>20,2 т (транспортная)</td><td>31–31,75 т (рабочая)</td></tr>
          <tr><td>Шасси</td><td>КАМАЗ-65115, 6×4</td><td>автомобильное, 6×4</td></tr>
          <tr><td>Смена в МОСКРАН-СЕРВИС</td><td>20 800 ₽</td><td>20 800 ₽</td></tr>
        </tbody>
      </table>
    </div>
    <p>Для XCMG QY25K5-I в карточке парка МОСКРАН-СЕРВИС указаны стрела до 41 м и высота подъёма до 48,5 м — так описано исполнение с удлинённой стрелой. Дилерская карточка базового QY25K5-I даёт 38,5 м, и в таблице МОСКРАН-СЕРВИС взял меньшее значение, чтобы не завышать возможности крана.</p>

    <h2 id="strela" style="margin:36px 0 16px">Стрела 21 или 38,5 м: высота и вылет</h2>
    <p>Стрела XCMG QY25K5-I длиной до 38,5 м позволяет работать там, где «Клинцы» КС-55713-1К со стрелой 21 м упираются в геометрию: вылет и высоту подъёма даёт одна и та же стрела. Чтобы поднять груз на кровлю через фасад, стрела должна быть заметно длиннее вылета. МОСКРАН-СЕРВИС поэтому смотрит на пару «высота + вылет», а не на тоннаж.</p>
    <p>На коротком вылете длинная стрела не нужна: разгрузка фуры на 6–10 м от оси, подача поддонов на площадку, монтаж ЖБИ рядом с краном — работа для «Клинцов» КС-55713-1К. Гусёк 7,5 м поднимает высоту «Клинцов» до 29,3 м, но на гуське грузоподъёмность заметно ниже основной стрелы. Как читать такие графики, МОСКРАН-СЕРВИС разобрал в <a href="/spravochnik/gruzovysotnaya-harakteristika/" style="color:var(--yellow)">материале о грузовысотной характеристике</a>.</p>

    <h2 id="primer" style="margin:36px 0 16px">Пример: груз 2 т на вылете 25 м</h2>
    <p>Груз массой 2 т на вылете 25 м даёт 2 × 25 = 50 т·м, и по моменту проходят оба крана. Но «Клинцы» КС-55713-1К со стрелой 21 м до вылета 25 м без гуська физически не дотягиваются. XCMG QY25K5-I на том же вылете имеет верхнюю границу 98 / 25 ≈ 3,9 тонны. МОСКРАН-СЕРВИС в такой задаче предлагает XCMG и проверяет подъём по его грузовой таблице.</p>
    <p>Деление момента на вылет даёт только верхнюю границу: на длинной выдвинутой стреле часть момента уходит на её собственную массу, и табличная грузоподъёмность ниже. Если тот же груз 2 т опускать на вылете 12 м, момент 24 т·м укладывается в возможности «Клинцов» КС-55713-1К с большим запасом, и МОСКРАН-СЕРВИС подаст более лёгкий кран. Вылет полезно измерить заранее, как в <a href="/spravochnik/zayavka-na-avtokran/" style="color:var(--yellow)">материале о заявке на автокран</a>.</p>

    <h2 id="massa" style="margin:36px 0 16px">Масса 20 или 31 т: подъезд и основание</h2>
    <p>XCMG QY25K5-I весит в рабочем состоянии 31–31,75 т, из них 24,6–25,2 т приходится на заднюю тележку, а «Клинцы» КС-55713-1К — 20,2 т в транспортном положении. Разница около 11 т сказывается на дворовых проездах, покрытии над подземными паркингами и частных дорогах. МОСКРАН-СЕРВИС на таких объектах чаще подаёт более лёгкий кран, если его стрелы хватает.</p>
    <p>Опорные контуры у кранов близки — 4,9 × 6,1 м у «Клинцов» и 5,14 × 6,0 м у XCMG QY25K5-I, поэтому место под опоры нужно примерно одинаковое. Требования к площадке общие: по п. 108 ФНП №461 кран ставится на подготовленную площадку, не на свеженасыпанный грунт, а по п. 109 между поворотной частью и строениями оставляют не менее 1 м. Основание МОСКРАН-СЕРВИС проверяет по <a href="/spravochnik/nesushchaya-sposobnost-grunta/" style="color:var(--yellow)">материалу о несущей способности грунта</a>.</p>

    <h2 id="vybor" style="margin:36px 0 16px">Как выбирает МОСКРАН-СЕРВИС</h2>
    <p>Правило подбора МОСКРАН-СЕРВИС простое: сначала высота и вылет, потом масса груза, потом подъезд. Если задача укладывается в стрелу 21 м, подаётся «Клинцы» КС-55713-1К или другой 25-тонный кран с короткой стрелой. Если нужен вылет 25 м и больше или высокая подача через фасад, в заявке фиксируется XCMG QY25K5-I.</p>
    <p>Когда не хватает и длинной стрелы XCMG, следующий шаг — класс 50 т, например Liebherr LTM 1050 или «Галичанин» КС-65713-1; сравнение разобрано в <a href="/spravochnik/avtokran-25-ili-50-tonn/" style="color:var(--yellow)">материале о выборе между 25 и 50 т</a>. Если задача, наоборот, легче, МОСКРАН-СЕРВИС предложит 16 т — см. <a href="/spravochnik/avtokran-16-ili-25-tonn/" style="color:var(--yellow)">сравнение 16 и 25 т</a>.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: «Клинцы» или XCMG</h2>
    <ul>
      <li>Цена смены одинаковая — 20 800 ₽.</li>
      <li>Вылет больше 20 м или высокая подача — XCMG QY25K5-I.</li>
      <li>Короткий вылет, слабое основание, узкий двор — «Клинцы».</li>
      <li>Разница в массе — около 11 т.</li>
      <li>Решает паспорт и грузовая таблица конкретной машины.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://www.avtocrane.by/katalog-produkcii/avtokrany-klincy/25-tonn/ks-55713-1k-klincy" target="_blank" rel="noopener" style="color:var(--yellow)">Технические данные КС-55713-1К «Клинцы»</a> — грузовой момент, стрела, гусёк, высота подъёма, опорный контур, масса, шасси.</li>
      <li><a href="https://xcmgru.ru/catalogue/avtokrani/xcmg_qy25k5i/" target="_blank" rel="noopener" style="color:var(--yellow)">Технические данные QY25K5-I (карточка дилера)</a> — момент подъёма 961 кН·м, стрела 10,1–38,5 м, вылет с гуськом 46,8 м, выносные опоры 5,14 × 6 м, масса 31 000 / 31 750 кг.</li>
      <li><a href="https://www.consultant.ru/document/cons_doc_LAW_373321/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 (приказ Ростехнадзора от 26.11.2020 №461, ред. от 16.04.2026)</a> — п. 108, 109: установка кранов стрелового типа.</li>
      <li><a href="/park/xcmg-qy25k5/" style="color:var(--yellow)">Карточка XCMG QY25K5-I в парке МОСКРАН-СЕРВИС</a> и <a href="/" style="color:var(--yellow)">ставки на главной</a> — действуют до 17.02.2027.</li>
    </ul>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-16-25-tonn/">Подробнее об аренде автокрана 16–25 тонн →</a></section>
</main>
</SpravochnikLayout>
