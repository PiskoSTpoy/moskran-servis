---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = "Автокран в перерыве и после смены: что требует ФНП 461";
const description = "В перерыв и после смены на крюке автокрана не должно висеть груза (п. 114 ФНП №461); кран приводят в безопасное нерабочее положение по руководству.";

const CHECKED = '26.10.2026';
const PUBLISHED = '2026-10-26';
const SLUG = "avtokran-pri-pereryve-i-po-okonchanii-smeny-fnp-461";
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    "q": "Можно ли оставить груз на крюке автокрана на время обеда?",
    "a": "Нет. При перерыве или по окончании работ на грузозахватном органе подъёмного сооружения не должно находиться подвешенного груза (п. 114 ФНП №461). Груз опускают на заранее определённое место, стропы снимают, и только после этого крановщик покидает кабину."
  },
  {
    "q": "Что значит «безопасное положение в нерабочем состоянии» для автокрана?",
    "a": "ФНП №461 не перечисляет операции: в п. 114 сказано «согласно требованиям руководства (инструкции) по эксплуатации». Какие именно действия нужны (положение стрелы, крюковой подвески, опор), определяет руководство конкретной модели, например КС-55713 «Клинцы» или КС-65713-1 «Галичанин»."
  },
  {
    "q": "Кто отвечает за то, чтобы кран не угнало ветром на стоянке?",
    "a": "Эксплуатирующая организация. По п. 122 ФНП №461 она обязана обеспечить соблюдение требований безопасности для смонтированных кранов в нерабочем состоянии: кран обесточен, приняты меры против угона ветром. Порядок приведения крана в безопасное положение она устанавливает сама."
  },
  {
    "q": "Нужно ли письменно знать порядок действий при аварии, если кран стоит на объекте?",
    "a": "Да. Инструкции для аварийных ситуаций разрабатывают и доводят до работников под подпись (п. 252 ФНП №461). В них, помимо прочего, указывают порядок приведения крана в безопасное положение, места его нахождения в нерабочем состоянии и места отключения вводов электропитания (п. 253)."
  },
  {
    "q": "Когда работу автокрана нужно прекращать, не дожидаясь конца смены?",
    "a": "Три случая названы в п. 132 ФНП №461: ветер выше предельно допустимого по паспорту, температура ниже предельно допустимой по паспорту, снегопад, дождь или туман, при которых крановщик плохо различает сигналы стропальщика или груз. После остановки кран приводят в безопасное положение так же, как в конце смены."
  }
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: "Автокран в перерыве и после смены", item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [["gruz", "Что делать с грузом перед перерывом"], ["polozhenie", "Безопасное положение крана в нерабочем состоянии"], ["organizaciya", "Что обязана обеспечить эксплуатирующая организация"], ["avariya", "Как нерабочее положение попадает в аварийную инструкцию"], ["dosrochno", "Когда остановка наступает раньше конца смены"], ["tablica", "Порядок действий: от последнего подъёма до стоянки"], ["faq", "Частые вопросы"], ["istochniki", "Источники"]];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Автокран в перерыве и после смены</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">ФНП №461 · Эксплуатация</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Что делать с автокраном при перерыве и в конце смены?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>26.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>26.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>6 мин чтения</span>
    </div>

    <p>При перерыве или по окончании работ на крюке автокрана не должно висеть груза, а сам кран приводят в безопасное положение в нерабочем состоянии по руководству по эксплуатации (п. 114 ФНП №461). Эксплуатирующая организация обязана обесточить кран и принять меры против угона ветром (п. 122). МОСКРАН-СЕРВИС закладывает эту процедуру в каждую смену: груз на крюке и кран без нерабочего положения остаются без присмотра именно в перерыв, когда людей на площадке меньше всего.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="gruz" style="margin:36px 0 16px">Что делать с грузом перед перерывом</h2>
    <p>Груз на крюке автокрана на время перерыва не оставляют: п. 114 ФНП №461 требует, чтобы на грузозахватном органе при перерыве или по окончании работ не было подвешенного груза. Перемещаемый груз опускают только на предназначенное для этого место, где исключено падение, опрокидывание и сползание. МОСКРАН-СЕРВИС просит заказчика определить такое место до начала смены, а не в момент, когда крановщик уже держит плиту над площадкой.</p>
    <p>Для извлечения стропов груз опускают на подкладки достаточной прочности и толщины, а укладку и разборку ведут равномерно, не нарушая габариты складирования и не загромождая проходы (п. 114). Автокран КС-55713 «Клинцы» не освободит стропы из-под плиты, лежащей на голом грунте: подкладки готовят заранее. Складские схемы и места укладки, в свою очередь, входят в ППР или технологическую карту (п. 122), о различии которых написано в справке про <a href="/spravochnik/ppr-ili-tehnologicheskaya-karta-avtokran-fnp-461/" style="color:var(--yellow)">ППР и технологическую карту</a>.</p>

    <h2 id="polozhenie" style="margin:36px 0 16px">Безопасное положение крана в нерабочем состоянии</h2>
    <p>Нерабочее положение автокрана описывает руководство по эксплуатации машины, а не ФНП №461: в п. 114 норма отсылает к «требованиям руководства (инструкции)», но не перечисляет операции. Поэтому для КС-65713-1 «Галичанин» и для Liebherr LTM 1050 порядок может различаться: он зависит от конструкции стрелы, опор и крюковой подвески. МОСКРАН-СЕРВИС не выдумывает общий список, а берёт порядок из паспорта и руководства конкретной машины, которые лежат в кабине.</p>
    <p>Стоянку крана в нерабочем состоянии ФНП №461 связывает ещё с двумя условиями: кран обесточен, а меры против угона ветром приняты (п. 122). Сильный ветер — отдельная тема, о которой рассказано в справке про <a href="/spravochnik/rabota-krana-pri-silnom-vetre/" style="color:var(--yellow)">работу крана при сильном ветре</a>.</p>

    <h2 id="organizaciya" style="margin:36px 0 16px">Что обязана обеспечить эксплуатирующая организация</h2>
    <p>Пункт 122 ФНП №461 возлагает на эксплуатирующую организацию три обязанности, связанные с нерабочим состоянием: соблюдать требования безопасности для смонтированных кранов в нерабочем состоянии, установить порядок приведения крана в безопасное положение и определить действия работников, включая покидание опасной зоны при аварии. Для арендованного автокрана МОСКРАН-СЕРВИС выступает эксплуатирующей организацией своей машины, и порядок остановки кран получает от нас; заказчик отвечает за площадку, на которой кран стоит.</p>
    <p>Распределение ответственности между организацией, выделившей кран, и заказчиком подробно разобрано в справке об <a href="/spravochnik/obyazannosti-organizacii-pri-vydelenii-avtokrana/" style="color:var(--yellow)">обязанностях организации при выделении автокрана</a>.</p>

    <h2 id="avariya" style="margin:36px 0 16px">Как нерабочее положение попадает в аварийную инструкцию</h2>
    <p>Аварийные инструкции для работников разрабатывают и доводят до них под подпись (п. 252 ФНП №461), и в них прямо названо нерабочее положение крана. Пункт 253 перечисляет сведения для работников: порядок приведения крана в безопасное положение, схему и порядок эвакуации крановщика, места отведённые для нахождения крана в нерабочем состоянии (пп. «д», «е») и места отключения вводов электропитания (п. «ж»). Эти сведения МОСКРАН-СЕРВИС передаёт бригаде заказчика до начала работ.</p>
    <p>Полный порядок действий при аварии — в справке про <a href="/spravochnik/instrukciya-pri-avarii-avtokrana-fnp-461/" style="color:var(--yellow)">инструкцию при аварии автокрана</a>.</p>

    <h2 id="dosrochno" style="margin:36px 0 16px">Когда остановка наступает раньше конца смены</h2>
    <p>Работу автокрана на открытом воздухе прекращают в трёх случаях (п. 132 ФНП №461): ветер сильнее предельного по паспорту, температура ниже предельной по паспорту, снегопад, дождь или туман, при которых крановщик плохо различает сигналы стропальщика или груз. Конкретные значения ветра и температуры нормативы не называют — их задаёт паспорт каждого крана, и МОСКРАН-СЕРВИС сверяется именно с ним. После такой остановки кран приводят в безопасное положение так же, как при обычном окончании смены.</p>

    <h2 id="tablica" style="margin:36px 0 16px">Порядок действий: от последнего подъёма до стоянки</h2>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Шаг</th><th>Что делают</th><th>Основание</th></tr></thead>
        <tbody>
          <tr><td>1</td><td>Опускают груз на предназначенное место, на подкладки, достаточные для извлечения стропов</td><td>п. 114</td></tr>
          <tr><td>2</td><td>Снимают стропы; на крюке не остаётся подвешенного груза</td><td>п. 114</td></tr>
          <tr><td>3</td><td>Приводят кран в безопасное положение по руководству по эксплуатации</td><td>п. 114</td></tr>
          <tr><td>4</td><td>Обесточивают кран, принимают меры против угона ветром</td><td>п. 122</td></tr>
          <tr><td>5</td><td>Оставляют кран на месте, отведённом для нерабочего состояния</td><td>п. 253 «е»</td></tr>
        </tbody>
      </table>
    </div>
    <p>Таблица показывает, что нерабочее положение — это последовательность из пяти шагов, и только шаг 3 зависит от модели машины. Остальные четыре одинаковы для любого автокрана МОСКРАН-СЕРВИС, от 16-тонного до 50-тонного.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: автокран в перерыве и после смены</h2>
    <ul>
      <li>На крюке при перерыве и по окончании работ не должно быть подвешенного груза (п. 114).</li>
      <li>Безопасное нерабочее положение определяет руководство по эксплуатации конкретной модели (п. 114).</li>
      <li>Кран обесточивают и защищают от угона ветром; порядок устанавливает эксплуатирующая организация (п. 122).</li>
      <li>Ветер, мороз и плохая видимость выше паспортных пределов — повод остановиться до конца смены (п. 132).</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://www.consultant.ru/document/cons_doc_LAW_373321/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 (приказ Ростехнадзора от 26.11.2020 №461)</a> — пп. 114, 122, 132, 252–253 (груз на крюке, нерабочее состояние, остановка работ, аварийные инструкции).</li>
      <li><a href="https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 на legalacts.ru</a> — текст пунктов сверен 26.10.2026.</li>
    </ul>
    <p class="small muted">Справка не заменяет руководство по эксплуатации конкретного автокрана: порядок приведения в нерабочее положение задаёт изготовитель.</p>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-16-25-tonn/">Аренда автокрана 16–25 тонн →</a></section>
</main>
</SpravochnikLayout>
