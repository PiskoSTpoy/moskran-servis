---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';
import Sources from '../../../components/Sources.astro';

const title = 'Что делать при неисправности крана на объекте';
const description = 'При обнаружении неисправности оператор обязан опустить груз, остановить работу и сообщить ответственному за безопасное производство работ.';

const CHECKED = '12.08.2026';

const faqs = [
  { q: 'Что происходит с уже начатой работой, если во время смены обнаружена неисправность?', a: 'Оператор обязан опустить груз, остановить работу крана и сообщить об этом ответственному за безопасное производство работ — вне зависимости от того, насколько близко к завершению была задача. Продолжение работы с неустранённой неисправностью не допускается.' },
  { q: 'Кто принимает решение о продолжении или прекращении работ?', a: 'Если неисправность обнаружена при осмотре и её нельзя устранить своими силами на месте, оператор обязан сообщить об этом специалисту, ответственному за содержание крана в исправном состоянии, и ответственному за безопасное производство работ — решение о дальнейших действиях принимается этими лицами, а не единолично оператором.' },
  { q: 'Что это значит для сроков заявки заказчика?', a: 'Если неисправность требует замены техники, мы подаём резервную единицу максимально оперативно — простой по этой причине не тарифицируется заказчику (см. статью про простой техники), это наш риск, а не повод для дополнительной оплаты с вашей стороны.' },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Неисправность крана на объекте', item: 'https://moskran-servis.ru/spravochnik/neispravnost-krana-na-obekte/' },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@id': 'https://moskran-servis.ru/#organization' }, // ссылка на единственный узел организации (BaseLayout): отдельный узел с тем же @id, но другим name, был противоречием в графе
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: 'https://moskran-servis.ru/spravochnik/neispravnost-krana-na-obekte/',
  inLanguage: 'ru-RU',
  datePublished: '2026-08-12',
  dateModified: '2026-08-12',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<SpravochnikLayout title={title} description={description} path="/spravochnik/neispravnost-krana-na-obekte/" slug="neispravnost-krana-na-obekte" ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Неисправность крана на объекте</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Разбор для заказчика</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Неисправность крана обнаружена на объекте — что происходит дальше</h1>
    <p class="ref-byline">Инженерная служба МОСКРАН-СЕРВИС · обновлено в 2026 году</p>

    <p>Мы уже писали, что оператор останавливает подъём при превышении грузовысотной характеристики. Здесь разбираем более широкий случай — что происходит, если на самом кране обнаруживается техническая неисправность прямо во время работы на объекте.</p>

    <h2 style="margin:36px 0 16px">Обязанности оператора при обнаружении опасных факторов</h2>
    <p>При возникновении на кране опасных факторов, которые могут вызвать аварию или несчастный случай — трещины в металлоконструкциях, повреждение каната, поломка осей колёс и других элементов, неисправность механизмов, тормозов, электрооборудования и других узлов — оператор обязан опустить груз, остановить работу крана и сообщить об этом ответственному за безопасное производство работ.</p>

    <h2 style="margin:36px 0 16px">Что если неисправность обнаружена при осмотре, а не в процессе работы</h2>
    <p>Если во время предварительного осмотра и проверки крана перед началом работы обнаруживаются неисправности или дефекты, препятствующие безопасной эксплуатации, и они не могут быть устранены силами оператора самостоятельно, он обязан сообщить об этом инженерно-техническому работнику, ответственному за содержание крана в исправном состоянии, и уведомить ответственного за безопасное производство работ. Работа с неустранённой неисправностью, которая мешает безопасной эксплуатации, попросту не начинается.</p>

    <h2 style="margin:36px 0 16px">Почему это не просто формальная процедура</h2>
    <p>Продолжение работы с очевидной неисправностью — прямой риск аварии, а не вопрос удобства графика. Именно поэтому решение о дальнейших действиях принимает не единолично оператор на своё усмотрение, а совместно с ответственными лицами — эта многоступенчатая проверка снижает риск того, что усталость или спешка приведут к продолжению работы там, где нужно остановиться.</p>

    <h2 style="margin:36px 0 16px">Что это значит для заказчика</h2>
    <p>Если неисправность требует замены техники, мы организуем подачу резервной единицы максимально оперативно. Такой простой не тарифицируется заказчику как простой по его вине (см. статью про простой техники) — это риск на нашей стороне, поскольку причина остановки не связана с готовностью площадки заказчика.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: что запомнить</h2>
    <ul>
      <li>При обнаружении опасных факторов оператор обязан опустить груз, остановить работу и сообщить ответственному лицу.</li>
      <li>Работа с неустранённой неисправностью, обнаруженной при осмотре, не начинается вовсе.</li>
      <li>Решение о дальнейших действиях принимается совместно с ответственными лицами, не единолично оператором.</li>
      <li>Простой из-за неисправности техники не тарифицируется заказчику.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <Sources
      checked={CHECKED}
      items={[
        { text: 'fnp-test.nadzor-info.ru — обязанности крановщика при опасных факторах', href: 'https://fnp-test.nadzor-info.ru/course/7463/1328421' },
        { text: 'consultant.ru — Приказ Ростехнадзора №461', href: 'https://www.consultant.ru/document/cons_doc_LAW_373321/' }
      ]}
    />
  </article>
  <section class="section wrap"><a class="btn" href="/spravochnik/prostoy-tehniki-oplata/">Простой техники — кто оплачивает →</a></section>
</main>
</SpravochnikLayout>
