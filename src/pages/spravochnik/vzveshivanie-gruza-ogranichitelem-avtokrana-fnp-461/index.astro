---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = "Можно ли взвешивать груз ограничителем автокрана";
const description = "Нет: ограничители, указатели и регистраторы не используют для учёта веса груза (п. 134 ФНП №461). Как узнать массу груза до заказа автокрана — по пунктам нормы.";

const CHECKED = '27.10.2026';
const PUBLISHED = '2026-10-27';
const SLUG = "vzveshivanie-gruza-ogranichitelem-avtokrana-fnp-461";
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    "q": "Можно ли узнать вес груза по показаниям ограничителя грузоподъёмности автокрана?",
    "a": "Нельзя: п. 134 ФНП №461 прямо запрещает использовать ограничители, указатели и регистраторы для учёта веса перемещаемых грузов. Прибор защищает кран от перегруза и срабатывает по порогу, а не измеряет массу для документа или оплаты."
  },
  {
    "q": "Что делать, если масса груза неизвестна?",
    "a": "Взвесить груз отдельно либо рассчитать массу по чертежу и плотности материала до начала подъёма. Подъём груза, масса которого неизвестна, запрещён (п. 114 ФНП №461). Результат стоит записать в заявке на автокран, чтобы подобрать машину по грузовысотной характеристике."
  },
  {
    "q": "Для чего тогда нужен пробный подъём на 0,2–0,3 м?",
    "a": "Пробный подъём проверяет правильность строповки и надёжность действия тормоза (п. 114 ФНП №461). Он не заменяет знание массы: груз сначала должен укладываться в грузоподъёмность на нужном вылете, и только потом его поднимают для проверки."
  },
  {
    "q": "Можно ли сдавать или принимать груз «по крану» при погрузке?",
    "a": "Нет: п. 134 ФНП №461 не допускает использовать приборы безопасности для учёта веса. Для приёмки по массе нужны весы или документы на груз. Показания прибора на кране не считаются доказательством массы."
  },
  {
    "q": "Кто отвечает за правильную массу в заявке на автокран?",
    "a": "Заказчик отвечает за сведения о грузе, которые передаёт в заявке, а крановая служба подбирает машину и стропы по ним. Распределение обязанностей между организацией, выделившей кран, и заказчиком определяется п. 122 ФНП №461 и договором аренды."
  }
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: "Взвешивание груза ограничителем", item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [["zapret", "Что запрещает п. 134 ФНП №461"], ["neizvestnaya", "Почему нельзя поднимать груз неизвестной массы"], ["sposoby", "Как узнать массу груза до заказа крана"], ["zayavka", "Что указать в заявке на автокран"], ["stropy", "Масса груза и строповка: что зависит от цифры"], ["faq", "Частые вопросы"], ["istochniki", "Источники"]];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Взвешивание груза ограничителем</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">ФНП №461 · Подъём груза</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Можно ли взвешивать груз ограничителем грузоподъёмности автокрана?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>27.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>27.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>6 мин чтения</span>
    </div>

    <p>Нет, нельзя: ограничители, указатели и регистраторы не должны использоваться для учёта веса грузов, которые перемещает подъёмное сооружение (п. 134 ФНП №461). Одновременно запрещён подъём груза неизвестной массы (п. 114). МОСКРАН-СЕРВИС поэтому просит заказчика назвать массу груза при заказе: диспетчер подбирает КС-55713 «Клинцы» или КС-65713-1 «Галичанин» по цифре, а не по показаниям прибора на крюке.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="zapret" style="margin:36px 0 16px">Что запрещает п. 134 ФНП №461</h2>
    <p>Пункт 134 ФНП №461 состоит из одной фразы: ограничители, указатели и регистраторы не должны использоваться для учёта веса грузов (материалов), перемещаемых подъёмным сооружением. Ограничитель грузоподъёмности автокрана защищает машину от перегруза, а не служит весами. МОСКРАН-СЕРВИС объясняет заказчику эту разницу на этапе заявки, чтобы груз с неизвестной массой не оказался на крюке в день работ.</p>
    <p>Устройство и назначение прибора разобраны в справке про <a href="/spravochnik/ogranichitel-gruzopodemnosti/" style="color:var(--yellow)">ограничитель грузоподъёмности</a>, а проверки его работоспособности — в справке про <a href="/spravochnik/proverka-priborov-bezopasnosti-avtokrana-fnp-461/" style="color:var(--yellow)">проверку приборов безопасности автокрана</a>.</p>

    <h2 id="neizvestnaya" style="margin:36px 0 16px">Почему нельзя поднимать груз неизвестной массы</h2>
    <p>Подъём груза неизвестной массы запрещён прямо: п. 114 ФНП №461 перечисляет это среди требований при перемещении груза. Там же закреплён порядок начала подъёма: сначала груз поднимают на высоту не более 0,2–0,3 м и останавливают для проверки строповки и тормоза. Пробный подъём не заменяет знание массы: он проверяет строповку и тормоз, но не говорит, укладывается ли груз в грузоподъёмность на вылете.</p>
    <p>Вылет определяет, сколько кран реально поднимет. Для автокрана МОСКРАН-СЕРВИС предельная масса зависит от вылета по грузовысотной характеристике, о которой рассказано в справке про <a href="/spravochnik/gruzovysotnaya-harakteristika/" style="color:var(--yellow)">грузовысотную характеристику</a>.</p>

    <h2 id="sposoby" style="margin:36px 0 16px">Как узнать массу груза до заказа крана</h2>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Способ</th><th>Подходит</th><th>Основание</th></tr></thead>
        <tbody>
          <tr><td>Масса из паспорта, накладной или маркировки груза</td><td>Железобетонные изделия, оборудование, контейнеры</td><td>Практика; п. 114 требует знать массу</td></tr>
          <tr><td>Расчёт по чертежу: объём × плотность</td><td>Металлоконструкции, блоки, ёмкости</td><td>Практика; арифметика заказчика</td></tr>
          <tr><td>Взвешивание на отдельных весах или динамометре вне крана</td><td>Партия неизвестного оборудования</td><td>Практика; кран весами не служит (п. 134)</td></tr>
          <tr><td>Показания ограничителя грузоподъёмности на крюке</td><td>Не подходит</td><td>Прямой запрет, п. 134</td></tr>
        </tbody>
      </table>
    </div>
    <p>Таблица показывает, что нормативный запрет касается только последней строки, а три первых способа — рабочая практика без отдельной нормы в ФНП №461. Для автокрана МОСКРАН-СЕРВИС любой из трёх годится, если результат записан в заявке и подтверждён документом.</p>

    <h2 id="zayavka" style="margin:36px 0 16px">Что указать в заявке на автокран</h2>
    <p>В заявке на автокран нужны масса самого тяжёлого груза, размеры, высота подъёма и вылет до места установки. Эти четыре цифры позволяют диспетчеру МОСКРАН-СЕРВИС подобрать машину по грузовысотной характеристике: 16, 25, 32 или 50 тонн. Если масса неизвестна, груз взвешивают отдельно, а не поднимают «на пробу».</p>
    <p>Примеры оформления списка грузов — в справке про <a href="/spravochnik/spisok-gruzov-s-massoy-v-zone-rabot-avtokrana-fnp-461/" style="color:var(--yellow)">список грузов с массой в зоне работ</a>. Вопрос веса тары и поддонов — в справке про <a href="/spravochnik/massa-tary-vzveshivanie/" style="color:var(--yellow)">массу тары и взвешивание</a>.</p>

    <h2 id="stropy" style="margin:36px 0 16px">Масса груза и строповка: что зависит от цифры</h2>
    <p>Масса груза определяет подбор стропов: эксплуатирующая организация обязана обеспечить стропальщиков испытанными и маркированными грузозахватными приспособлениями и тарой, соответствующими массе и характеру перемещаемых грузов (п. 122 ФНП №461). Стропы с запасом по маркировке выбирают именно по известной массе. Расчёт многоветвевого стропа — в справке про <a href="/spravochnik/raschet-mnogovetvevogo-stropa-avtokran-fnp-461/" style="color:var(--yellow)">расчёт многоветвевого стропа</a>; МОСКРАН-СЕРВИС присылает на объект стропы, подобранные под заявленную массу.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: ограничитель — не весы</h2>
    <ul>
      <li>Ограничитель, указатель и регистратор не служат для учёта веса груза (п. 134 ФНП №461).</li>
      <li>Подъём груза неизвестной массы запрещён (п. 114).</li>
      <li>Пробный подъём на 0,2–0,3 м проверяет строповку и тормоз, но не массу.</li>
      <li>Массу называют при заказе: по документам, расчётом или взвешиванием вне крана.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://www.consultant.ru/document/cons_doc_LAW_373321/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 (приказ Ростехнадзора от 26.11.2020 №461)</a> — пп. 114, 122, 134 (груз неизвестной массы, пробный подъём, стропы по массе, запрет учёта веса приборами безопасности).</li>
      <li><a href="https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 на legalacts.ru</a> — текст пунктов сверен 27.10.2026.</li>
    </ul>
    <p class="small muted">Справка не заменяет руководство по эксплуатации прибора и паспорт конкретного автокрана; способы определения массы в таблице помечены как практика, а не норма.</p>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-16-25-tonn/">Аренда автокрана 16–25 тонн →</a></section>
</main>
</SpravochnikLayout>
