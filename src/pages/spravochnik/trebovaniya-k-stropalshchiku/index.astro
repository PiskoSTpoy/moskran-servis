---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';
import Sources from '../../../components/Sources.astro';

const title = 'Что проверяют у стропальщика и строп перед подъёмом';
const description = 'Маркировка строп, периодичность испытаний раз в 10 дней, нормы браковки. Что должен проверить стропальщик перед каждым подъёмом груза краном.';

const CHECKED = '12.08.2026';

const faqs = [
  { q: 'Кто отвечает за строповку груза — стропальщик или крановщик?', a: 'Стропальщик отвечает за правильную строповку и подбор грузозахватных приспособлений под конкретный груз, крановщик — за безопасное перемещение застропованного груза. Это разные роли, даже если на небольших объектах их иногда совмещает один человек с соответствующей аттестацией на обе функции.' },
  { q: 'Может ли кран работать без отдельного стропальщика?', a: 'В части случаев эту функцию может взять на себя оператор крана, но это не гарантировано автоматически и обсуждается с заказчиком заранее — на объекте без своего ответственного за строповку мы уточняем это на этапе заявки, как упомянуто на странице услуги «Автокраны 16–25 тонн».' },
  { q: 'Как часто нужно испытывать стропы?', a: 'Стропы, которые используются регулярно, испытывают не реже раза в 10 дней. Редко применяемые стропы тестируют непосредственно перед выдачей их в работу — то есть перед конкретным использованием, если между использованиями прошло много времени.' },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Требования к стропальщику', item: 'https://moskran-servis.ru/spravochnik/trebovaniya-k-stropalshchiku/' },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@id': 'https://moskran-servis.ru/#organization' }, // ссылка на единственный узел организации (BaseLayout): отдельный узел с тем же @id, но другим name, был противоречием в графе
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: 'https://moskran-servis.ru/spravochnik/trebovaniya-k-stropalshchiku/',
  inLanguage: 'ru-RU',
  datePublished: '2026-08-12',
  dateModified: '2026-08-12',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<SpravochnikLayout title={title} description={description} path="/spravochnik/trebovaniya-k-stropalshchiku/" slug="trebovaniya-k-stropalshchiku" ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Требования к стропальщику</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Разбор для заказчика</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Требования к стропальщику и стропам — что проверяют перед подъёмом груза</h1>
    <p class="ref-byline">Инженерная служба МОСКРАН-СЕРВИС · обновлено в 2026 году</p>

    <p>Кран поднимает груз не сам по себе — между грузом и крюком всегда есть грузозахватное приспособление (строп, траверса, захват), и то, насколько правильно оно подобрано и в каком оно состоянии, напрямую влияет на безопасность подъёма. Разбираем требования к этому звену цепи.</p>

    <h2 style="margin:36px 0 16px">Что проверяет стропальщик перед подъёмом</h2>
    <p>Перед началом работы стропальщик обязан проверить исправность грузозахватных приспособлений, наличие на них клейм или бирок с обозначением номера, даты испытания и грузоподъёмности, а также проверить исправность тары и подобрать приспособления, соответствующие массе и характеру поднимаемого груза. Это не формальная процедура «для галочки», а основной способ убедиться, что конкретный строп физически рассчитан на конкретный груз.</p>

    <h2 style="margin:36px 0 16px">Маркировка — обязательное условие допуска к работе</h2>
    <p>Грузозахватные приспособления без необходимой маркировки не должны находиться в местах производства работ — отсутствие бирки или клейма само по себе достаточное основание, чтобы не допустить строп к использованию, даже если он визуально выглядит исправным. Это защищает от ситуации, когда фактическая грузоподъёмность стропа неизвестна или не соответствует заявленной задаче.</p>

    <h2 style="margin:36px 0 16px">Периодичность испытаний</h2>
    <p>Стропы, которые используются регулярно, испытывают не реже одного раза в 10 дней. Стропы, применяемые редко, тестируют непосредственно перед выдачей их в работу — то есть перед конкретным подъёмом, если с момента последнего использования прошло значительное время. Такая периодичность учитывает, что строп — расходуемый со временем элемент: механический износ и усталостные повреждения накапливаются при каждом цикле нагрузки.</p>

    <h2 style="margin:36px 0 16px">Когда строп подлежит браковке</h2>
    <p>Для круглопрядных стальных изделий действуют конкретные нормы: браковка происходит при обрыве более шести проволок, наличии отверстий в защитном чехле, разрывах нитей в узлах более чем на 10% длины. Осмотр перед каждым применением проводят и стропальщик, и крановщик, ориентируясь на браковочные показатели из руководства по эксплуатации конкретного изделия — не «на глаз по общему виду».</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: что запомнить</h2>
    <ul>
      <li>Стропальщик проверяет маркировку (номер, дату испытания, грузоподъёмность) перед каждым подъёмом.</li>
      <li>Строп без маркировки не допускается к работе независимо от визуального состояния.</li>
      <li>Регулярно используемые стропы испытывают раз в 10 дней, редкие — перед выдачей в работу.</li>
      <li>Браковка круглопрядных строп — при обрыве более 6 проволок или других конкретных признаках износа.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <Sources
      checked={CHECKED}
      items={[
        { text: 'startkom.ru — испытание стропов', href: 'https://startkom.ru/ispytanie-stropov/' },
        { text: 'stropexpert.ru — браковка грузоподъёмных стропов', href: 'https://stropexpert.ru/spravochnik/brakovka-strop/' }
      ]}
    />
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-16-25-tonn/">Подробнее об аренде с оператором →</a></section>
</main>
</SpravochnikLayout>
