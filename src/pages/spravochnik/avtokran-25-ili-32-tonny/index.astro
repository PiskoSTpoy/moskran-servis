---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = 'Автокран 25 или 32 тонны: что выбрать и сколько доплатить';
const description = 'Класс 32 т: 102,4 т·м и стрела 31 м у КС-55729-1В-3 против 85 т·м и 21 м у КС-55713-1К. Смена 24 800 ₽ против 20 800 ₽ — когда доплата оправдана.';

const CHECKED = '01.10.2026';
const PUBLISHED = '2026-10-01';
const SLUG = 'avtokran-25-ili-32-tonny';
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: 'На сколько автокран 32 тонны дороже 25-тонного?',
    a: 'МОСКРАН-СЕРВИС берёт за класс 25 т 2 600 ₽ в час, за класс 32 т — 3 100 ₽. Смена 8 часов стоит 20 800 ₽ и 24 800 ₽, разница — 4 000 ₽, или около 19 %. Грузовой момент при этом вырастает с 85 до 102,4 т·м, то есть на 20 %.',
  },
  {
    q: 'Чем автокран 32 тонны лучше 25-тонного, кроме грузоподъёмности?',
    a: 'КС-55729-1В-3 «Галичанин» класса 32 т несёт стрелу 9,7–31 м и поднимает крюк на 31,6 м, а с гуськом 9 м — на 40,4 м. КС-55713-1К «Клинцы» класса 25 т со стрелой 21 м даёт 21,6 м и 29,3 м. МОСКРАН-СЕРВИС предлагает 32 т, когда не хватает высоты или вылета.',
  },
  {
    q: 'Пройдёт ли автокран 32 тонны в обычный двор?',
    a: 'КС-55729-1В-3 «Галичанин» в транспортном положении имеет габариты 11,8 × 2,55 × 3,97 м и стоит на трёхосном КАМАЗ-65115, как и 25-тонные краны. Опорный контур шире: 5,45 × 6,1 м против 4,9 × 6,1 м у «Клинцов». МОСКРАН-СЕРВИС проверяет ширину площадки по схеме из заявки.',
  },
  {
    q: 'Какой груз поднимет автокран 32 тонны на вылете 15 метров?',
    a: 'Деление момента 102,4 т·м на вылет 15 м даёт около 6,8 т против 5,7 т у крана с моментом 85 т·м. Числа показывают верхнюю границу: на длинной стреле допустимая масса меньше. МОСКРАН-СЕРВИС называет точную цифру по таблице паспорта машины, которая поедет на объект.',
  },
  {
    q: 'Когда вместо 32 тонн сразу брать 50 тонн?',
    a: 'Класс 50 т за 31 200 ₽ в смену нужен, когда груз на рабочем вылете требует больше 102,4 т·м или высота крюка превышает 40 м. КС-65713-1 «Галичанин» класса 50 т даёт 175 т·м. МОСКРАН-СЕРВИС сравнивает три класса по одной схеме объекта и предлагает младший из подходящих.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Автокран 25 или 32 тонны', item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ['tablica', 'Два класса рядом'],
  ['moment', 'Грузовой момент и цена'],
  ['vysota', 'Стрела и высота крюка'],
  ['ploshadka', 'Опоры и проезд'],
  ['vybor', 'Когда хватит 25 тонн'],
  ['faq', 'Частые вопросы'],
  ['istochniki', 'Источники'],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Автокран 25 или 32 тонны</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Выбор техники · Класс 25–32 т</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Автокран 25 или 32 тонны: когда доплата 4 000 ₽ за смену оправдана?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>01.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>01.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>6 мин чтения</span>
    </div>

    <p>Автокран класса 32 т стоит в МОСКРАН-СЕРВИС 24 800 ₽ за смену против 20 800 ₽ у класса 25 т, то есть на 4 000 ₽ дороже. За эти деньги заказчик получает около 20 % грузового момента: 102,4 т·м у КС-55729-1В-3 «Галичанин» против 85 т·м у КС-55713-1К «Клинцы». Стрела при этом длиннее на 10 м — 31 м против 21 м. Доплата оправдана, когда 25-тонному крану не хватает вылета или высоты.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="tablica" style="margin:36px 0 16px">Два класса рядом</h2>
    <p>КС-55729-1В-3 «Галичанин» взят как типичный серийный кран класса 32 т, КС-55713-1К «Клинцы» — как типичный кран класса 25 т; МОСКРАН-СЕРВИС сверил карточки дилеров 01.10.2026. Конкретную модель под заявку МОСКРАН-СЕРВИС называет при подборе, а допустимую массу на вылете задаёт паспорт машины.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Параметр</th><th>Класс 25 т — КС-55713-1К</th><th>Класс 32 т — КС-55729-1В-3</th></tr></thead>
        <tbody>
          <tr><td>Грузовой момент</td><td>85 т·м</td><td>102,4 т·м</td></tr>
          <tr><td>Основная стрела</td><td>до 21 м</td><td>9,7–31 м</td></tr>
          <tr><td>Высота крюка без гуська</td><td>21,6 м</td><td>31,6 м</td></tr>
          <tr><td>Высота крюка с гуськом</td><td>29,3 м</td><td>40,4 м (гусёк 9 м)</td></tr>
          <tr><td>Опорный контур</td><td>4,9 × 6,1 м</td><td>5,45 × 6,1 м</td></tr>
          <tr><td>Масса крана</td><td>20,2 т</td><td>21,65 т (минимальная комплектация)</td></tr>
          <tr><td>Шасси</td><td>КАМАЗ-65115, 6×4</td><td>КАМАЗ-65115, 6×4</td></tr>
          <tr><td>Ставка МОСКРАН-СЕРВИС</td><td>2 600 ₽/час</td><td>3 100 ₽/час</td></tr>
          <tr><td>Смена 8 часов</td><td>20 800 ₽</td><td>24 800 ₽</td></tr>
        </tbody>
      </table>
    </div>

    <h2 id="moment" style="margin:36px 0 16px">Грузовой момент и цена</h2>
    <p>Грузовой момент КС-55729-1В-3 «Галичанин» больше на 17,4 т·м, или на 20 %, а смена в МОСКРАН-СЕРВИС дороже на 19 %: цена растёт почти в той же пропорции, что и возможности. Рубль за тонно-метр получается одинаковым — около 245 ₽ за смену у класса 25 т и 242 ₽ у класса 32 т. Переплаты «за класс» в этой паре нет.</p>
    <p>Груз 5 т кран с моментом 85 т·м удерживает на вылете до 17 м, кран с моментом 102,4 т·м — до 20,5 м по верхней оценке. Для груза 8 т граница сдвигается с 10,6 до 12,8 м. МОСКРАН-СЕРВИС использует деление момента на массу только для отсева: окончательный ответ даёт таблица паспорта, где на длинной стреле допустимая масса ниже расчётной.</p>

    <h2 id="vysota" style="margin:36px 0 16px">Стрела и высота крюка</h2>
    <p>Стрела КС-55729-1В-3 «Галичанин» раздвигается до 31 м и поднимает крюк на 31,6 м — на 10 м выше, чем 21,6 м у КС-55713-1К «Клинцы». С гуськом 9 м «Галичанин» достаёт до 40,4 м, а максимальный вылет основной стрелой дилер называет равным 29 м. Для монтажа на кровлю шести–восьмиэтажного дома это разница между «кран дотягивается» и «нужен гусёк».</p>
    <p>Высоту парапета МОСКРАН-СЕРВИС получает вычитанием: из высоты крюка убирают 0,5 м запаса по п. 114 ФНП №461, высоту груза и длину строп. Для поддона 1,2 м на стропах 2 м класс 25 т без гуська обслуживает парапет около 17,9 м, класс 32 т — около 27,9 м. Методика описана в <a href="/spravochnik/podyom-gruza-na-kryshu-avtokranom/" style="color:var(--yellow)">материале о подъёме груза на крышу</a>.</p>

    <h2 id="ploshadka" style="margin:36px 0 16px">Опоры и проезд</h2>
    <p>Опорный контур КС-55729-1В-3 «Галичанин» — 5,45 × 6,1 м, у КС-55713-1К «Клинцы» — 4,9 × 6,1 м: кран класса 32 т шире на 0,55 м. Габариты «Галичанина» в транспортном положении — 11,8 × 2,55 × 3,97 м на трёхосном КАМАЗ-65115, поэтому в арку и на дворовый проезд оба класса заходят одинаково. МОСКРАН-СЕРВИС проверяет по схеме именно ширину площадки под опоры.</p>
    <p>Противовес КС-55729-1В-3 достигает 6,4 т, и нагрузка на опору при работе над ней выше, чем у 25-тонного крана. ФНП №461 (п. 108–110) требует установки на все опоры на подготовленном основании, а под пятой МОСКРАН-СЕРВИС кладёт подкладки по расчёту давления; расчёт показан в <a href="/spravochnik/nesushchaya-sposobnost-grunta/" style="color:var(--yellow)">материале о несущей способности грунта</a>.</p>

    <h2 id="vybor" style="margin:36px 0 16px">Когда хватит 25 тонн</h2>
    <p>Класс 25 т за 20 800 ₽ закрывает разгрузку фур, монтаж плит и блоков на вылете до 15–17 м и подъём на высоту до 20 м. Класс 32 т за 24 800 ₽ МОСКРАН-СЕРВИС рекомендует в трёх случаях: крюк нужен выше 22 м, груз 5–8 т стоит дальше 12–17 м или в графике есть запас только на одну установку крана без перестановки.</p>
    <p>Перестановка 25-тонного крана занимает время смены, и одна лишняя перестановка может стоить дороже, чем 4 000 ₽ разницы. Если не хватает и 102,4 т·м, МОСКРАН-СЕРВИС предлагает класс 50 т за 31 200 ₽; переход разобран в материалах <a href="/spravochnik/avtokran-25-ili-50-tonn/" style="color:var(--yellow)">«Автокран 25 или 50 тонн»</a> и <a href="/spravochnik/avtokran-16-ili-25-tonn/" style="color:var(--yellow)">«Автокран 16 или 25 тонн»</a>.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: 25 или 32 тонны</h2>
    <ul>
      <li>Смена в МОСКРАН-СЕРВИС: 25 т — 20 800 ₽, 32 т — 24 800 ₽, разница 4 000 ₽ (19 %).</li>
      <li>Грузовой момент: 85 т·м у КС-55713-1К против 102,4 т·м у КС-55729-1В-3 (+20 %).</li>
      <li>Высота крюка: 21,6 / 29,3 м против 31,6 / 40,4 м.</li>
      <li>Опорный контур класса 32 т шире на 0,55 м; шасси то же — КАМАЗ-65115.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://kran-master74.ru/heavy/truck_cranes/galichanin/avtokran_galichanin_ks_55729_1v_3_/" target="_blank" rel="noopener" style="color:var(--yellow)">КС-55729-1В-3 «Галичанин», 32 т, шасси КАМАЗ-65115 — карточка дилера «Кран-Мастер»</a> — 102,4 т·м, стрела 9,7–31 м, крюк 31,6 / 40,4 м, вылет 29 м, опоры 5,45 × 6,1 м, противовес до 6,4 т, 21,65 т.</li>
      <li><a href="https://www.avtocrane.by/katalog-produkcii/avtokrany-klincy/25-tonn/ks-55713-1k-klincy" target="_blank" rel="noopener" style="color:var(--yellow)">КС-55713-1К «Клинцы» — карточка официального дилера</a> — 85 т·м, стрела 21 м, крюк 21,6 / 29,3 м, опоры 4,9 × 6,1 м, 20,2 т.</li>
      <li><a href="https://sudact.ru/law/prikaz-rostekhnadzora-ot-26112020-n-461-ob/federalnye-normy-i-pravila-v/vi/ustanovka-ps-i-proizvodstvo-rabot/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461, раздел VI «Установка ПС и производство работ» (ред. от 16.04.2026)</a> — п. 108–110, 114.</li>
    </ul>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-25-40-tonn/">Аренда автокрана 25–40 тонн →</a></section>
</main>
</SpravochnikLayout>
