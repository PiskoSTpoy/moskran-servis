---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = 'Пуск автокрана в работу на новом объекте: ФНП №461';
const description = 'После перестановки на новый объект решение о пуске автокрана выдаёт инженер с записью в вахтенном журнале (п. 136 ФНП №461). Когда нужна комиссия.';

const CHECKED = '12.10.2026';
const PUBLISHED = '2026-10-12';
const SLUG = 'pusk-avtokrana-v-rabotu-na-novom-obekte-fnp-461';
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: 'Нужно ли решение о пуске, когда автокран переезжает на новый объект?',
    a: 'Да. Пункт 136 ФНП №461 требует, чтобы после перестановки крана на автомобильном шасси на новый объект решение о пуске в работу выдал инженерно-технический работник, ответственный за безопасное производство работ, с записью в вахтенном журнале. МОСКРАН-СЕРВИС оформляет эту запись при каждой смене площадки.',
  },
  {
    q: 'Кто выдаёт решение о пуске автокрана после перестановки?',
    a: 'Инженерно-технический работник, ответственный за безопасное производство работ с применением подъёмных сооружений. Это не руководитель организации и не комиссия: п. 136 ФНП №461 прямо называет эту должность и место записи — вахтенный журнал крана. МОСКРАН-СЕРВИС назначает такого работника на каждый объект.',
  },
  {
    q: 'Когда для пуска автокрана собирают комиссию?',
    a: 'Пункт 138 ФНП №461 называет четыре случая: башенные краны после установки на объекте, мостовые и портальные краны, самоходные краны иностранного производства грузоподъёмностью 25 т и более и смена эксплуатирующей организации для крана с отработанным сроком службы. Для обычной перестановки автокрана комиссия не названа, поэтому МОСКРАН-СЕРВИС её не собирает.',
  },
  {
    q: 'За сколько дней уведомляют о заседании комиссии по пуску?',
    a: 'Не менее чем за 10 рабочих дней. Пункт 139 ФНП №461 требует письменно уведомить организации и орган Ростехнадзора, чьи представители входят в состав комиссии. Результаты фиксируются в акте пуска в работу по п. 140, а акт готовности прикладывают к паспорту; МОСКРАН-СЕРВИС хранит эти документы вместе с паспортом машины.',
  },
  {
    q: 'Что проверяет комиссия перед пуском крана?',
    a: 'Комплект документов по п. 141 ФНП №461: разрешение на строительство, паспорт, сертификаты или декларации соответствия, руководство по эксплуатации, акт монтажа, при отсутствии сертификата — заключение экспертизы, ППР и ТК. Для автокрана МОСКРАН-СЕРВИС часть позиций — рельсовый путь и фундаменты — не применяется.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Пуск автокрана в работу по ФНП №461', item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ['tri-resheniya', 'Три вида решения о пуске: кто и где записывает'],
  ['perestanovka', 'Перестановка на новый объект: п. 136'],
  ['komissiya', 'Когда нужна комиссия: четыре случая п. 138'],
  ['inostrannye', 'Иностранный кран от 25 т: что говорит норма'],
  ['dokumenty', 'Документы для комиссии по п. 141'],
  ['zakazchik', 'Что запросить у исполнителя до выезда'],
  ['faq', 'Частые вопросы'],
  ['istochniki', 'Источники'],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Пуск автокрана в работу по ФНП №461</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">ФНП №461 · Пуск в работу</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Кто и как допускает автокран в работу после перестановки на новый объект?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>12.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>12.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>7 мин чтения</span>
    </div>

    <p>После перестановки автокрана на новый объект решение о пуске в работу выдаёт инженерно-технический работник, ответственный за безопасное производство работ, и записывает его в вахтенный журнал (п. 136 ФНП №461). Комиссия по п. 138 для обычной перестановки не нужна: она собирается в четырёх других случаях. МОСКРАН-СЕРВИС оформляет запись в журнале на каждой новой площадке до первого подъёма.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="tri-resheniya" style="margin:36px 0 16px">Три вида решения о пуске: кто и где записывает</h2>
    <p>ФНП №461 различает три порядка пуска подъёмного сооружения в работу, и для автокрана МОСКРАН-СЕРВИС важно не перепутать их. Пункт 135 называет решение с записью в паспорте по результатам технического освидетельствования, пункт 136 — решение с записью в вахтенном журнале для самоходных кранов после перестановки, пункт 138 — решение по предложению комиссии с актом готовности. Для автомобильного шасси применяется пункт 136, но не пункт 135.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Пункт</th><th>Кто выдаёт</th><th>Где запись</th></tr></thead>
        <tbody>
          <tr><td>135</td><td>ответственный за производственный контроль</td><td>паспорт крана</td></tr>
          <tr><td>136</td><td>ответственный за безопасное производство работ</td><td>вахтенный журнал</td></tr>
          <tr><td>138</td><td>ответственный за производственный контроль</td><td>паспорт, акт готовности</td></tr>
        </tbody>
      </table>
    </div>
    <p>Разница в должностях принципиальна: пункты 135 и 138 ведёт инженерно-технический работник, ответственный за осуществление производственного контроля, а пункт 136 — ответственный за безопасное производство работ, то есть тот, кто находится на площадке. Кто это и чем отличается от прораба, МОСКРАН-СЕРВИС разобрал в материале об <a href="/spravochnik/otvetstvennyy-za-bezopasnoe-proizvodstvo/" style="color:var(--yellow)">ответственном за безопасное производство работ</a>.</p>

    <h2 id="perestanovka" style="margin:36px 0 16px">Перестановка на новый объект: п. 136</h2>
    <p>Пункт 136 ФНП №461 касается кранов с собственным источником энергии. Это краны на автомобильных шасси, на пневмоколёсном и гусеничном ходу, краны-манипуляторы и подъёмники. Автокраны МОСКРАН-СЕРВИС входят в эту группу. После перестановки такого крана на новый объект решение о пуске в работу выдаёт ответственный за безопасное производство работ с записью в вахтенном журнале.</p>
    <p>Для автокрана МОСКРАН-СЕРВИС это означает, что каждый новый адрес в Москве или области начинается с записи в вахтенном журнале машины, а не с подъёма «по договорённости». Запись относится к площадке, а не к заказчику: если кран на следующий день переезжает на другой объект, решение оформляется заново. Что ещё вносят в вахтенный журнал, описано в материале о <a href="/spravochnik/vahtennyy-zhurnal-krana/" style="color:var(--yellow)">вахтенном журнале крана</a>.</p>

    <h2 id="komissiya" style="margin:36px 0 16px">Когда нужна комиссия: четыре случая п. 138</h2>
    <p>Пункт 138 ФНП №461 называет четыре случая, когда решение о пуске принимают по предложению комиссии. Это башенные краны после установки, мостовые и портальные краны, иностранные самоходные краны от 25 т и смена эксплуатирующей организации для кранов с отработанным сроком службы. Автокран отечественной сборки до 25 т в этом списке не назван, и МОСКРАН-СЕРВИС не оформляет для него комиссию.</p>
    <p>Состав комиссии по п. 138: председатель — представитель эксплуатирующей организации, не менее двух её представителей, а по согласованию — монтажная и экспертная организации и представитель органа Ростехнадзора. Результат оформляется актом готовности, который МОСКРАН-СЕРВИС прикладывает к паспорту, при несогласии члена комиссии прикладывается особое мнение, а решение руководителя фиксируется внутренним распорядительным документом. Это процедура организации-эксплуатанта, а не заказчика площадки.</p>

    <h2 id="inostrannye" style="margin:36px 0 16px">Иностранный кран от 25 т: что говорит норма</h2>
    <p>Пункт 138 ФНП №461 прямо называет самоходные краны иностранного производства грузоподъёмностью 25 т и более, и в парке МОСКРАН-СЕРВИС к ним относятся, например, Liebherr LTM 1050 и XCMG QY25K5-I. Норма говорит о «пуске в работу» и не уточняет, повторяется ли процедура при каждой перестановке; для перестановки автокрана на шасси отдельно действует п. 136. МОСКРАН-СЕРВИС читает пункты вместе: комиссия — при вводе, запись в журнале — на каждом объекте.</p>
    <p>Прочтение п. 138 ФНП №461 здесь осторожное, а не цитата: официального разъяснения Ростехнадзора по этому вопросу в сверенном тексте нет. Заказчику достаточно уточнить у исполнителя, есть ли акт пуска или акт готовности по конкретной машине и когда он оформлен. Документы машины описаны в материале о <a href="/spravochnik/pasport-krana/" style="color:var(--yellow)">паспорте крана</a>, а срок службы — в материале о <a href="/spravochnik/srok-sluzhby-krana/" style="color:var(--yellow)">сроке службы крана</a>.</p>

    <h2 id="dokumenty" style="margin:36px 0 16px">Документы для комиссии по п. 141</h2>
    <p>Пункт 141 ФНП №461 задаёт комплект документов для комиссии. В него входят разрешение на строительство, паспорт, сертификаты или декларации соответствия, руководство по эксплуатации, акт монтажа, а при отсутствии сертификата — заключение экспертизы, ППР и ТК по пунктам 155–163. Рельсовый путь и фундаменты в списке относятся к башенным и мостовым кранам.</p>
    <p>Для автокрана МОСКРАН-СЕРВИС ключевые позиции из этого списка — паспорт, декларация соответствия и ППР. Декларацию описывает материал о <a href="/spravochnik/deklaraciya-tr-ts-010/" style="color:var(--yellow)">декларации ТР ТС 010</a>, проект производства работ — материал о <a href="/spravochnik/ppr-dlya-krana/" style="color:var(--yellow)">ППР для крана</a>. Регистрация самого крана и объекта — отдельные процедуры, см. <a href="/spravochnik/registraciya-krana-rostehnadzor/" style="color:var(--yellow)">регистрацию крана в Ростехнадзоре</a>.</p>

    <h2 id="zakazchik" style="margin:36px 0 16px">Что запросить у исполнителя до выезда</h2>
    <p>Перед заказом заказчик может запросить у МОСКРАН-СЕРВИС три вещи: паспорт машины с записями об освидетельствовании, ответственное лицо за безопасное производство работ на вашей площадке и готовность оформить запись в вахтенном журнале при постановке крана. МОСКРАН-СЕРВИС передаёт эти сведения вместе с подтверждением заявки. Это практика МОСКРАН-СЕРВИС, построенная на п. 136 и 141 ФНП №461, а не прямое требование к заказчику.</p>
    <p>Если машина по какой-то причине не может быть допущена, основания перечислены в п. 251 ФНП №461 и собраны в материале о <a href="/spravochnik/kogda-avtokran-ne-dopuskayut-k-rabote-fnp-461/" style="color:var(--yellow)">случаях, когда автокран не допускают к работе</a>. Обязанности организации, выделяющей кран, раскрыты в материале об <a href="/spravochnik/obyazannosti-organizacii-pri-vydelenii-avtokrana/" style="color:var(--yellow)">обязанностях организации при выделении автокрана</a>.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: пуск автокрана в работу</h2>
    <ul>
      <li>После перестановки на новый объект МОСКРАН-СЕРВИС оформляет решение о пуске в вахтенном журнале (п. 136 ФНП №461).</li>
      <li>Решение на объекте МОСКРАН-СЕРВИС выдаёт ответственный за безопасное производство работ, а не комиссия (п. 136).</li>
      <li>Комиссия по п. 138 собирается в четырёх случаях, и МОСКРАН-СЕРВИС не находит среди них перестановку автокрана.</li>
      <li>Иностранный самоходный кран от 25 т МОСКРАН-СЕРВИС подтверждает актом пуска или готовности (п. 138).</li>
      <li>О заседании комиссии МОСКРАН-СЕРВИС уведомляет участников не менее чем за 10 рабочих дней (п. 139).</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://www.consultant.ru/document/cons_doc_LAW_373321/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 (приказ Ростехнадзора от 26.11.2020 №461)</a> — п. 135 (пуск по результатам освидетельствования), п. 136 (пуск самоходных кранов после перестановки), п. 138 (комиссия и акт готовности), п. 139 (уведомление за 10 рабочих дней), п. 140 (акт пуска), п. 141 (комплект документов), п. 251 (основания не допускать).</li>
      <li><a href="https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 на legalacts.ru</a> — редакция от 16.04.2026, текст пунктов 135–141 сверен 12.10.2026.</li>
    </ul>
    <p class="small muted">Прочтение п. 138 применительно к перестановкам иностранных кранов и порядок запроса документов у исполнителя — практика МОСКРАН-СЕРВИС, не разъяснение Ростехнадзора. Применимость пунктов к конкретной машине определяет её паспорт.</p>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-40-50-tonn/">Аренда автокрана 40–50 тонн →</a></section>
</main>
</SpravochnikLayout>
