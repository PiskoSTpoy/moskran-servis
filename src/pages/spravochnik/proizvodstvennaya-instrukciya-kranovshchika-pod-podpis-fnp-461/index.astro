---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = "Инструкции крановщику и стропальщику под подпись";
const description = "Производственные инструкции выдают под подпись до допуска к работе (п. 152 ФНП №461); с ППР знакомят под подпись (п. 122). Что и кому вручают на объекте.";

const CHECKED = '27.10.2026';
const PUBLISHED = '2026-10-27';
const SLUG = "proizvodstvennaya-instrukciya-kranovshchika-pod-podpis-fnp-461";
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    "q": "Обязательно ли выдавать инструкцию крановщику под подпись?",
    "a": "Да. Производственные инструкции выдаются персоналу под подпись перед допуском к работе (п. 152 ФНП №461). В них определены обязанности, порядок безопасного производства работ и ответственность. Подпись фиксирует, что работник получил инструкцию до начала работы на кране."
  },
  {
    "q": "С чем знакомят крановщиков и стропальщиков под подпись?",
    "a": "С ППР и технологическими картами, по которым ведутся работы (п. 122 ФНП №461). Список лиц включает ответственных инженерно-технических работников, крановщиков, рабочих люльки и стропальщиков. Знакомство оформляют до первого подъёма на объекте."
  },
  {
    "q": "Что должно быть указано в удостоверении крановщика?",
    "a": "Тип подъёмного сооружения, а также виды работ и оборудования, к которым допущен работник (п. 147 «б» ФНП №461). Если в удостоверении записан другой тип крана, допуск на автокран по нему подтвердить нельзя."
  },
  {
    "q": "Кто замещает ответственного инженера, если он болен?",
    "a": "Работник, назначенный внутренним распорядительным актом: он замещает по должности, имеет квалификацию и прошёл обучение и аттестацию (п. 149 ФНП №461). Приказ нужен до наступления отсутствия, а не после происшествия."
  },
  {
    "q": "Кто назначает крановщиков и стропальщиков на конкретный кран?",
    "a": "Эксплуатирующая организация внутренним распорядительным актом (п. 151 ФНП №461): он назначает крановщиков, их помощников, стропальщиков, слесарей, электромонтёров и рабочих люльки. Для арендованного крана с экипажем разделение обязанностей зависит от договора аренды."
  }
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: "Инструкции под подпись", item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [["instrukcii", "Какие инструкции должны быть у персонала"], ["podpis", "Что выдают под подпись и когда"], ["udostoverenie", "Удостоверение крановщика: какие сведения в нём указаны"], ["zamena", "Кто подменяет ответственного, если он в отпуске"], ["obekt", "Что собрать на московской площадке до первого подъёма"], ["faq", "Частые вопросы"], ["istochniki", "Источники"]];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Инструкции под подпись</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">ФНП №461 · Персонал</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Какие инструкции и под подпись выдают крановщику и стропальщику?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>27.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>27.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>6 мин чтения</span>
    </div>

    <p>Производственные инструкции с обязанностями, порядком безопасной работы и ответственностью выдают персоналу под подпись перед допуском к работе (п. 152 ФНП №461). С ППР и технологическими картами крановщиков и стропальщиков знакомят тоже под подпись (п. 122). МОСКРАН-СЕРВИС просит заказчика собрать подписи до первого подъёма: без них кран на московской площадке стоит, а ставка за час идёт.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="instrukcii" style="margin:36px 0 16px">Какие инструкции должны быть у персонала</h2>
    <p>Эксплуатирующая организация обязана обеспечить персонал производственными инструкциями, в которых определены обязанности, порядок безопасного производства работ и ответственность (п. 152 ФНП №461). Для инженерно-технических работников нужны должностные инструкции и руководящие указания по безопасной эксплуатации (п. 147 «г»). Инструкции составляют на основе паспорта и руководства по эксплуатации конкретного крана (п. 147 «в»), поэтому у КС-55713 «Клинцы» и у Liebherr LTM 1050 они не совпадают.</p>
    <p>Квалификацию и допуск самого крановщика описывает справка про <a href="/spravochnik/attestaciya-kranovshchika/" style="color:var(--yellow)">аттестацию крановщика</a>; здесь разобрана именно документальная сторона допуска.</p>

    <h2 id="podpis" style="margin:36px 0 16px">Что выдают под подпись и когда</h2>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Документ</th><th>Кому</th><th>Когда</th><th>Основание</th></tr></thead>
        <tbody>
          <tr><td>Производственная инструкция</td><td>Крановщику, стропальщику, другому персоналу</td><td>Перед допуском к работе</td><td>п. 152</td></tr>
          <tr><td>ППР или технологическая карта</td><td>Ответственным ИТР, крановщикам, стропальщикам, рабочим люльки</td><td>До начала работ на объекте</td><td>п. 122</td></tr>
          <tr><td>Аварийная инструкция</td><td>Работникам, занятым с краном</td><td>Доводится под подпись</td><td>п. 252</td></tr>
          <tr><td>Должностная инструкция и руководящие указания</td><td>Инженерно-техническим работникам</td><td>Наличие обязательно</td><td>п. 147 «г»</td></tr>
        </tbody>
      </table>
    </div>
    <p>Таблица показывает, что три из четырёх документов вручают под подпись, а должностные инструкции ИТР обязаны просто находиться у работника. Для арендованного автокрана МОСКРАН-СЕРВИС достаточно, чтобы бригада заказчика подписала ознакомление с ППР: производственные инструкции своего экипажа остаются у нас.</p>

    <h2 id="udostoverenie" style="margin:36px 0 16px">Удостоверение крановщика: какие сведения в нём указаны</h2>
    <p>Порядок допуска к самостоятельной работе включает выдачу удостоверений, в которых указывают тип подъёмного сооружения, а также виды работ и оборудования, к которым допущен работник (п. 147 «б» ФНП №461). Удостоверение, выданное на мостовой кран, не допускает к работе на автокране: тип в нём записан отдельно. МОСКРАН-СЕРВИС проверяет это поле у каждого оператора, прежде чем назначить его на 16-, 25-, 32- или 50-тонную машину.</p>
    <p>Назначение операторов, стропальщиков и слесарей оформляют внутренним распорядительным актом (п. 151). О требованиях к стропальщику — в справке про <a href="/spravochnik/trebovaniya-k-stropalshchiku/" style="color:var(--yellow)">требования к стропальщику</a>.</p>

    <h2 id="zamena" style="margin:36px 0 16px">Кто подменяет ответственного, если он в отпуске</h2>
    <p>На время отпуска, командировки или болезни ответственного инженерно-технического работника его обязанности передаёт внутренний распорядительный акт работникам, замещающим его по должности, с нужной квалификацией, обучением и аттестацией (п. 149 ФНП №461). Периодическую проверку знаний ИТР проводит комиссия эксплуатирующей организации по её собственному акту (п. 150). Устная передача обязанностей по телефону не заменяет приказ; МОСКРАН-СЕРВИС на объекте опирается на приказ, а не на слова.</p>
    <p>Роль ответственного за безопасное производство работ описана в справке про <a href="/spravochnik/otvetstvennyy-za-bezopasnoe-proizvodstvo/" style="color:var(--yellow)">ответственного за безопасное производство работ</a>.</p>

    <h2 id="obekt" style="margin:36px 0 16px">Что собрать на московской площадке до первого подъёма</h2>
    <p>Перед первым подъёмом автокрана на объекте заказчик собирает пять документов: ППР или технологическую карту, подписи ознакомления, копии удостоверений, приказ о назначении ответственного за безопасное производство работ и приказ о замещении. Это практический порядок, собранный из пп. 122, 147, 149, 151–152 ФНП №461, а не отдельная норма. МОСКРАН-СЕРВИС присылает сканы удостоверений и инструкции экипажа заранее, чтобы к приезду крана оставалось подписать ознакомление с ППР.</p>
    <p>Различие между ППР и технологической картой — в справке про <a href="/spravochnik/ppr-ili-tehnologicheskaya-karta-avtokran-fnp-461/" style="color:var(--yellow)">ППР и технологическую карту автокрана</a>.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: инструкции под подпись</h2>
    <ul>
      <li>Производственные инструкции выдают под подпись перед допуском к работе (п. 152 ФНП №461).</li>
      <li>С ППР и ТК под подпись знакомят ответственных ИТР, крановщиков и стропальщиков (п. 122).</li>
      <li>В удостоверении указывают тип подъёмного сооружения и виды работ (п. 147 «б»).</li>
      <li>Замещение ответственных на время отсутствия оформляют внутренним актом (п. 149).</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://www.consultant.ru/document/cons_doc_LAW_373321/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 (приказ Ростехнадзора от 26.11.2020 №461)</a> — пп. 122, 147, 149–152, 252 (инструкции, допуск персонала, замещение ответственных).</li>
      <li><a href="https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 на legalacts.ru</a> — текст пунктов сверен 27.10.2026.</li>
    </ul>
    <p class="small muted">Справка не заменяет внутренние акты эксплуатирующей организации: перечень документов и форму подписей она устанавливает сама.</p>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-16-25-tonn/">Аренда автокрана 16–25 тонн →</a></section>
</main>
</SpravochnikLayout>
