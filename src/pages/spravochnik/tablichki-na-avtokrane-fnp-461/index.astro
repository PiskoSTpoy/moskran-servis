---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = "Таблички на автокране: что требует ФНП 461";
const description = "На автокране в эксплуатации нужна табличка с заводским номером, паспортной грузоподъёмностью и датами следующих освидетельствований (п. 121 ФНП №461).";

const CHECKED = '27.10.2026';
const PUBLISHED = '2026-10-27';
const SLUG = "tablichki-na-avtokrane-fnp-461";
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    "q": "Какая табличка обязательна на автокране по ФНП 461?",
    "a": "Табличка с заводским номером, паспортной грузоподъёмностью и датами следующего полного и частичного технического освидетельствования (п. 121 ФНП №461). Требование относится к подъёмным сооружениям, находящимся в эксплуатации. Размеры и способ крепления норма не задаёт — они определяются руководством по эксплуатации."
  },
  {
    "q": "Как часто проводят техническое освидетельствование автокрана?",
    "a": "Частичное — не реже одного раза в 12 месяцев, полное — не реже одного раза в 3 года (п. 165 ФНП №461). Исключение в 5 лет касается подъёмных сооружений, которые используются только при ремонте оборудования и обслуживают машинные залы, станции и компрессорные установки."
  },
  {
    "q": "Нужен ли регистрационный номер на табличке автокрана?",
    "a": "Пункт 121 ФНП №461 его не называет: он требует только заводской номер, грузоподъёмность и даты освидетельствований. Регистрационный номер в реестре опасных производственных объектов фиксируется отдельными документами, а нанесение его на кран определяется практикой и руководством по эксплуатации."
  },
  {
    "q": "Что делать, если дата на табличке прошла?",
    "a": "Кран не допускают к работе до проведения освидетельствования и записи результата в паспорт. Подтверждает пригодность именно освидетельствование (п. 168 ФНП №461): оно должно показать, что кран соответствует документации и находится в состоянии, обеспечивающем безопасную работу."
  },
  {
    "q": "Меняется ли табличка после замены стрелы?",
    "a": "Замена стрелы или установка сменного стрелового оборудования — основание для внеочередного полного освидетельствования (п. 166 ФНП №461). После него дата следующего полного освидетельствования меняется, и её отражают на табличке; паспортную грузоподъёмность уточняют по записи в паспорте."
  }
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: "Таблички на автокране", item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [["trebovanie", "Что именно написано в п. 121 ФНП №461"], ["tablica", "Три группы данных на табличке и откуда они берутся"], ["daty", "Как считать даты следующих освидетельствований"], ["vneocherednoe", "Когда дату на табличке нужно менять раньше срока"], ["proverka", "Как заказчику проверить табличку при приёмке крана"], ["faq", "Частые вопросы"], ["istochniki", "Источники"]];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Таблички на автокране</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">ФНП №461 · Эксплуатация</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Какие таблички должны быть на автокране по ФНП 461?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>27.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>27.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>6 мин чтения</span>
    </div>

    <p>На автокране в эксплуатации должна быть табличка с тремя группами данных: заводской номер, паспортная грузоподъёмность и даты следующего полного и частичного технического освидетельствования (п. 121 ФНП №461). Частичное освидетельствование проводят не реже раза в 12 месяцев, полное — не реже раза в 3 года (п. 165). МОСКРАН-СЕРВИС сверяет табличку с паспортом перед выездом: расхождение номера или просроченная дата означает, что кран на объект не уходит.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="trebovanie" style="margin:36px 0 16px">Что именно написано в п. 121 ФНП №461</h2>
    <p>Пункт 121 ФНП №461 требует снабдить находящиеся в эксплуатации подъёмные сооружения табличками с тремя сведениями: заводской номер, паспортная грузоподъёмность, даты следующего полного и частичного технического освидетельствования. Норма не называет материал, размеры и место крепления таблички, поэтому МОСКРАН-СЕРВИС ориентируется на руководство по эксплуатации конкретной машины и на паспорт.</p>
    <p>Регистрационный номер из реестра опасных производственных объектов в п. 121 не упомянут, хотя на практике его часто наносят рядом. Порядок регистрации разобран в справке про <a href="/spravochnik/registraciya-avtokrana-v-gostehnadzore/" style="color:var(--yellow)">регистрацию автокрана</a>, а эта справка ограничена тем, что прямо перечислено в п. 121.</p>

    <h2 id="tablica" style="margin:36px 0 16px">Три группы данных на табличке и откуда они берутся</h2>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Данные на табличке</th><th>Откуда берутся</th><th>Когда меняются</th></tr></thead>
        <tbody>
          <tr><td>Заводской номер</td><td>Паспорт крана (раздел общих сведений)</td><td>Не меняются за срок службы машины</td></tr>
          <tr><td>Паспортная грузоподъёмность</td><td>Паспорт и грузовысотная характеристика</td><td>После реконструкции или модернизации с новой записью в паспорте</td></tr>
          <tr><td>Дата следующего частичного освидетельствования</td><td>Запись о последнем освидетельствовании (п. 165 «а»)</td><td>Не реже раза в 12 месяцев</td></tr>
          <tr><td>Дата следующего полного освидетельствования</td><td>Запись о последнем полном освидетельствовании (п. 165 «б»)</td><td>Не реже раза в 3 года и после внеочередных случаев (п. 166)</td></tr>
        </tbody>
      </table>
    </div>
    <p>Таблица показывает, что неподвижны только заводской номер и (до модернизации) грузоподъёмность; две даты на табличке живые и требуют обновления после каждого освидетельствования. У автокрана КС-55713 «Клинцы» и у КС-65713-1 «Галичанин» эти четыре строки одинаковы по смыслу, различаются лишь цифры из паспорта.</p>

    <h2 id="daty" style="margin:36px 0 16px">Как считать даты следующих освидетельствований</h2>
    <p>Срок следующего освидетельствования отсчитывают от даты проведения последнего: частичное — не реже одного раза в 12 месяцев, полное — не реже одного раза в 3 года (п. 165 ФНП №461). Для подъёмных сооружений, которые обслуживают машинные залы, электрические и насосные станции, компрессорные установки или используются только при ремонте оборудования, полное освидетельствование проводят раз в 5 лет; к автокрану на стройплощадке это исключение не относится.</p>
    <p>Пример (арифметика, не из нормы): если частичное освидетельствование автокрана прошло 14.03.2026, на табличке указывают дату не позже 14.03.2027. Результат освидетельствования записывают в паспорт, как описано в справке про <a href="/spravochnik/zapis-v-pasporte-ob-osvidetelstvovanii-avtokrana-fnp-461/" style="color:var(--yellow)">запись в паспорте об освидетельствовании</a>.</p>

    <h2 id="vneocherednoe" style="margin:36px 0 16px">Когда дату на табличке нужно менять раньше срока</h2>
    <p>Внеочередное полное освидетельствование проводят после ремонта расчётных элементов металлоконструкций с заменой или сваркой, после замены стрелы или установки сменного стрелового оборудования, после капитального ремонта или замены грузовой либо стреловой лебёдки, после реконструкции (п. 166 ФНП №461). После замены грузозахватного органа проводят только статические испытания. Новая дата полного освидетельствования в этих случаях пойдёт на табличку, и МОСКРАН-СЕРВИС не выпускает кран на линию, пока табличка не обновлена.</p>
    <p>Перечень случаев подробнее — в справке про <a href="/spravochnik/vneocherednoe-osvidetelstvovanie-avtokrana-fnp-461/" style="color:var(--yellow)">внеочередное освидетельствование автокрана</a>.</p>

    <h2 id="proverka" style="margin:36px 0 16px">Как заказчику проверить табличку при приёмке крана</h2>
    <p>Проверка таблички на месте занимает пару минут: заказчик сверяет заводской номер с паспортом, смотрит дату следующего частичного и полного освидетельствования и убеждается, что она не прошла. Это практический порядок, а не пункт нормы, но он опирается на п. 121 и п. 165 ФНП №461. МОСКРАН-СЕРВИС передаёт копию паспорта вместе с краном, поэтому расхождение номера видно сразу.</p>
    <ol>
      <li>Найдите табличку на кране и сфотографируйте её.</li>
      <li>Сравните заводской номер с паспортом и с путевым листом.</li>
      <li>Проверьте, что даты следующих освидетельствований ещё не прошли.</li>
      <li>Убедитесь, что паспортная грузоподъёмность на табличке совпадает с заказанным тоннажем.</li>
    </ol>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: таблички на автокране</h2>
    <ul>
      <li>Табличка обязательна для всех подъёмных сооружений в эксплуатации (п. 121 ФНП №461).</li>
      <li>На ней три группы данных: заводской номер, паспортная грузоподъёмность, даты следующего полного и частичного освидетельствования.</li>
      <li>Частичное освидетельствование — не реже раза в 12 месяцев, полное — не реже раза в 3 года (п. 165).</li>
      <li>Внеочередное полное освидетельствование после ремонта, замены стрелы или лебёдки меняет дату на табличке (п. 166).</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://www.consultant.ru/document/cons_doc_LAW_373321/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 (приказ Ростехнадзора от 26.11.2020 №461)</a> — пп. 121, 164–168 (табличка, периодичность и внеочередные случаи освидетельствования).</li>
      <li><a href="https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 на legalacts.ru</a> — текст пунктов сверен 27.10.2026.</li>
    </ul>
    <p class="small muted">Справка не заменяет паспорт и руководство по эксплуатации конкретного автокрана: расположение и вид таблички задаёт изготовитель.</p>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-16-25-tonn/">Аренда автокрана 16–25 тонн →</a></section>
</main>
</SpravochnikLayout>
