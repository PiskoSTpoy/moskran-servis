---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = 'Минимальные расстояния при работе автокрана: ФНП №461';
const description = 'Сводка расстояний для автокрана по ФНП №461: 1 м до строений, 0,5 м над препятствиями, 5 м между кранами, 0,5 м до края проёма, 30 м до ЛЭП.';

const CHECKED = '13.10.2026';
const PUBLISHED = '2026-10-13';
const SLUG = 'minimalnye-rasstoyaniya-pri-rabote-avtokrana-fnp-461';
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: 'Какое минимальное расстояние от автокрана до здания по ФНП №461?',
    a: 'Не менее 1 м между поворотной частью крана при любом её положении, в том числе нагруженном, и строениями, штабелями грузов и другими предметами (п. 109 ФНП №461). Расстояние считают от поворотной части, а не от колёс или опор. МОСКРАН-СЕРВИС проверяет его на площадке до подъёма.',
  },
  {
    q: 'На сколько груз должен быть выше препятствий при перемещении?',
    a: 'Не менее чем на 0,5 м выше встречающихся на пути конструкций, оборудования, штабелей грузов, бортов подвижного состава и других предметов (п. 102 ФНП №461). Это относится к грузу и грузозахватному приспособлению, а также к стреле при её перемещении.',
  },
  {
    q: 'Какое расстояние между двумя кранами на одной площадке?',
    a: 'Не менее 5 м по горизонтали между подъёмными сооружениями, их стрелами, стрелой одного и грузом на стреле другого, а также между перемещаемыми грузами (п. 160 ФНП №461). Условия совместной работы описывают в ППР. МОСКРАН-СЕРВИС просит этот раздел до выезда второго крана.',
  },
  {
    q: 'С какого расстояния до ЛЭП нужен наряд-допуск?',
    a: 'Менее 30 м от крайнего провода воздушной линии электропередачи напряжением более 50 В: установка и работа крана стрелового типа допускаются только по наряду-допуску (п. 112 ФНП №461). В охранной зоне наряд выдаётся при наличии разрешения организации, эксплуатирующей линию.',
  },
  {
    q: 'Есть ли в норме единая «безопасная дистанция» для автокрана?',
    a: 'Нет. ФНП №461 задаёт отдельные расстояния для разных ситуаций: поворотная часть, препятствия на пути, соседний кран, проём, провода, откос котлована. Общей цифры для всех случаев нет, и МОСКРАН-СЕРВИС не использует «запасное» число вместо пункта нормы.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Минимальные расстояния при работе автокрана по ФНП №461', item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ['tablica', 'Сводная таблица расстояний'],
  ['povorotnaya', 'Поворотная часть: 1 м до предметов'],
  ['prepyatstviya', 'Груз и стрела над препятствиями: 0,5 м'],
  ['kranov-dva', 'Два крана на площадке: 5 м'],
  ['lep', 'Провода: 30 м и 1 м'],
  ['kotlovan', 'Откос котлована и проём'],
  ['moskva', 'Как применять расстояния на московской площадке'],
  ['faq', 'Частые вопросы'],
  ['istochniki', 'Источники'],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Минимальные расстояния при работе автокрана по ФНП №461</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">ФНП №461 · Установка и работа</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Какие минимальные расстояния соблюдает автокран на площадке?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>13.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>13.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>7 мин чтения</span>
    </div>

    <p>ФНП №461 задаёт для автокрана не одно расстояние, а пять разных: 1 м от поворотной части до предметов, 0,5 м над препятствиями на пути груза, 5 м между совместно работающими кранами, 0,5 м до края проёма и 30 м до воздушной линии как порог для наряда-допуска. МОСКРАН-СЕРВИС собрал их в одну таблицу с номерами пунктов.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="tablica" style="margin:36px 0 16px">Сводная таблица расстояний</h2>
    <p>Таблица ниже перечисляет расстояния из ФНП №461, которые чаще всего возникают при работе автокрана в городе. МОСКРАН-СЕРВИС указывает пункт нормы рядом с каждым значением, чтобы заказчик мог сверить цифру с текстом документа, а не с пересказом.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Ситуация</th><th>Расстояние</th><th>Пункт</th></tr></thead>
        <tbody>
          <tr><td>Поворотная часть — строения, штабели, предметы</td><td>не менее 1 м</td><td>109</td></tr>
          <tr><td>Груз и стрела — препятствия на пути</td><td>не менее 0,5 м выше</td><td>102</td></tr>
          <tr><td>Два крана: стрелы и грузы</td><td>не менее 5 м</td><td>160</td></tr>
          <tr><td>Груз или обойма — край проёма</td><td>не менее 0,5 м</td><td>162</td></tr>
          <tr><td>Кран — крайний провод ВЛ</td><td>менее 30 м: наряд-допуск</td><td>112</td></tr>
          <tr><td>Стрела — контактные провода транспорта</td><td>не менее 1 м с упором</td><td>112</td></tr>
          <tr><td>Опоры — откос котлована</td><td>по приложению №1</td><td>111</td></tr>
        </tbody>
      </table>
    </div>
    <p>Все значения здесь — минимумы: пункты ФНП №461 задают нижнюю границу, а конкретную величину на объекте может увеличить ППР или руководство по эксплуатации машины. МОСКРАН-СЕРВИС при расхождении берёт более строгое значение из двух документов.</p>

    <h2 id="povorotnaya" style="margin:36px 0 16px">Поворотная часть: 1 м до предметов</h2>
    <p>Пункт 109 ФНП №461 требует, чтобы расстояние между поворотной частью крана стрелового типа и строениями, штабелями грузов и другими предметами составляло не менее 1 м. Оговорка важная: при любом положении поворотной части, в том числе при нагруженном кране. Для автокрана КС-55713 «Клинцы» проверять нужно весь круг поворота стрелы, а не одну сторону.</p>
    <p>На практике это условие нарушают чаще всего у стены здания и у штабеля плит. МОСКРАН-СЕРВИС просит заказчика отметить на схеме площадки, где стоят забор, штабели и бытовки, а затем проверяет круг поворота холостым проворотом стрелы до подъёма. Выбор места установки подробнее разобран в материале о <a href="/spravochnik/opasnaya-zona-krana/" style="color:var(--yellow)">опасной зоне крана</a>.</p>

    <h2 id="prepyatstviya" style="margin:36px 0 16px">Груз и стрела над препятствиями: 0,5 м</h2>
    <p>Пункт 102 ФНП №461 задаёт вертикальный запас: груз или грузозахватное приспособление должны перемещаться не менее чем на 0,5 м выше встречающихся на пути конструкций, оборудования, штабелей грузов и бортов подвижного состава. Тот же запас в 0,5 м пункт требует для стрел кранов и кранов-манипуляторов при их перемещении. МОСКРАН-СЕРВИС измеряет его по самой высокой точке на трассе, а не по «обычной» высоте штабеля.</p>
    <p>Для погрузки на автомашину борт кузова — такое же препятствие, как забор. Порядок работы с транспортом описан в материале о <a href="/spravochnik/pogruzka-razgruzka-avtomashin-avtokranom/" style="color:var(--yellow)">погрузке и разгрузке автомашин автокраном</a>, а подъём над кровлей и парапетом — в материале о <a href="/spravochnik/podyom-gruza-na-kryshu-avtokranom/" style="color:var(--yellow)">подъёме груза на крышу автокраном</a>.</p>

    <h2 id="kranov-dva" style="margin:36px 0 16px">Два крана на площадке: 5 м</h2>
    <p>При совместной работе нескольких подъёмных сооружений пункт 160 ФНП №461 требует не менее 5 м по горизонтали между ними, между их стрелами, между стрелой одного и грузом на стреле другого, а также между перемещаемыми грузами. Это же расстояние действует для кранов разных типов на одной строительной площадке. МОСКРАН-СЕРВИС при заказе двух машин просит ППР с условиями совместной работы.</p>
    <p>Для двух автокранов «Клинцы» на одной площадке расстояние между ними — не единственная проблема: стрелы работают по пересекающимся траекториям. Подъём одного груза двумя кранами — отдельная операция, она описана в материале о <a href="/spravochnik/podyom-gruza-dvumya-kranami/" style="color:var(--yellow)">подъёме груза двумя кранами</a>.</p>

    <h2 id="lep" style="margin:36px 0 16px">Провода: 30 м и 1 м</h2>
    <p>Для воздушных линий пункт 112 ФНП №461 вводит порог 30 м: при установке и работе крана стрелового типа ближе 30 м от крайнего провода линии напряжением выше 50 В нужен наряд-допуск. В охранной зоне наряд выдают только при разрешении организации, эксплуатирующей линию. МОСКРАН-СЕРВИС не начинает работу ближе 30 м без наряда, даже если стрела до проводов не достаёт.</p>
    <p>Под неотключёнными контактными проводами городского транспорта пункт 112 допускает работу при расстоянии между стрелой и проводами не менее 1 м и при наличии ограничителя (упора), не позволяющего его уменьшить при подъёме стрелы. Подробности по охранной зоне и допускам собраны в материале о <a href="/spravochnik/rabota-krana-ryadom-s-lep/" style="color:var(--yellow)">работе крана рядом с ЛЭП</a>, а про 30 метров — в материале об <a href="/spravochnik/ohrannaya-zona-lep-i-30-metrov-fnp-461/" style="color:var(--yellow)">охранной зоне ЛЭП и 30 метрах</a>.</p>

    <h2 id="kotlovan" style="margin:36px 0 16px">Откос котлована и проём</h2>
    <p>Расстояние от опор крана до откоса котлована пункт 111 ФНП №461 отдаёт приложению №1, а при глубине котлована более 5 м и невозможности соблюсти таблицу требует укреплять откос по ППР. МОСКРАН-СЕРВИС не приводит значения из приложения в сводке, чтобы не дублировать таблицу: нужное значение читают по глубине и виду грунта в самом документе. Порядок работы описан в материале о <a href="/spravochnik/rasstoyanie-ot-kotlovana/" style="color:var(--yellow)">расстоянии от котлована</a>.</p>
    <p>Для проёма в перекрытии зазор 0,5 м закреплён в пункте 162 и сопровождается набором условий: ППР, минимальная скорость, световая сигнализация. Этот случай разобран отдельно в материале о <a href="/spravochnik/podacha-gruza-v-proyom-perekrytiya-avtokranom-fnp-461/" style="color:var(--yellow)">подаче груза в проём перекрытия автокраном</a>.</p>

    <h2 id="moskva" style="margin:36px 0 16px">Как применять расстояния на московской площадке</h2>
    <p>В московском дворе расстояния из ФНП №461 складываются: поворотная часть стоит в 1 м от стены, груз идёт на 0,5 м выше борта бытовки, а линия электропередачи может оказаться ближе 30 м. МОСКРАН-СЕРВИС до выезда просит у заказчика схему площадки с габаритами, расположением сетей и проводов, а решение о месте установки принимает по самому строгому условию.</p>
    <p>Если одно из условий выполнить нельзя, норма не предлагает «компенсации» вторым: берут другую точку установки, другой вылет или другую машину. Где эти границы записывают в проект, описано в материале о <a href="/spravochnik/ppr-dlya-krana/" style="color:var(--yellow)">ППР для крана</a>.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: расстояния при работе автокрана</h2>
    <ul>
      <li>Поворотную часть автокрана МОСКРАН-СЕРВИС держит не ближе 1 м от предметов (п. 109 ФНП №461).</li>
      <li>Груз и стрелу МОСКРАН-СЕРВИС проводит не менее чем на 0,5 м выше препятствий (п. 102).</li>
      <li>Между совместно работающими кранами МОСКРАН-СЕРВИС выдерживает не менее 5 м (п. 160).</li>
      <li>Ближе 30 м до крайнего провода ВЛ МОСКРАН-СЕРВИС работает только по наряду-допуску (п. 112).</li>
      <li>Единой «безопасной дистанции» МОСКРАН-СЕРВИС не применяет: в ФНП №461 расстояния заданы по ситуациям.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://www.consultant.ru/document/cons_doc_LAW_373321/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 (приказ Ростехнадзора от 26.11.2020 №461)</a> — п. 102 (запас 0,5 м над препятствиями), п. 109 (1 м от поворотной части), п. 111 (откос котлована), п. 112 (30 м до ВЛ, контактные провода), п. 160 (5 м между ПС), п. 162 (0,5 м до края проёма).</li>
      <li><a href="https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 на legalacts.ru</a> — редакция от 16.04.2026, текст пунктов 102, 109, 111, 112, 160 и 162 сверен 13.10.2026.</li>
    </ul>
    <p class="small muted">Значения таблицы приложения №1 (откос котлована) в статью не вынесены. Порядок применения расстояний на московской площадке и проверка холостым проворотом стрелы — практика МОСКРАН-СЕРВИС.</p>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-16-25-tonn/">Аренда автокрана 16–25 тонн →</a></section>
</main>
</SpravochnikLayout>
