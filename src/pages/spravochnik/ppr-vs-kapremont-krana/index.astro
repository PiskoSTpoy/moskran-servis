---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';
import Sources from '../../../components/Sources.astro';

const title = 'ППР и капремонт крана — в чём разница';
const description = 'Планово-предупредительный ремонт предотвращает поломки по графику, капитальный — устраняет накопленный износ по дефектной ведомости.';

const CHECKED = '12.08.2026';

const faqs = [
  { q: 'Можно ли обойтись без ППР, если кран новый?', a: 'Формально требования к техническому обслуживанию действуют с начала эксплуатации независимо от возраста крана — ППР не про «старость», а про предотвращение износа узлов, которые работают под нагрузкой с первого дня. Пропуск ТО на новом кране не считается нарушением закона в первые месяцы, но статистически именно отказ от планового обслуживания на раннем этапе приводит к более тяжёлым и дорогим поломкам в течение года-двух.' },
  { q: 'Кто определяет, что крану нужен капремонт, а не очередное ТО?', a: 'Решение принимается по результатам технического освидетельствования и/или экспертизы промышленной безопасности: если обнаружен износ, деформация или дефект несущих элементов, выходящий за рамки допустимого регламентом планового ТО, составляется дефектная ведомость, и объём работ переходит в категорию капитального ремонта — это не субъективное решение владельца, а результат документированной проверки.' },
  { q: 'Влияет ли капитальный ремонт на срок службы крана?', a: 'Качественно выполненный капитальный ремонт с заменой изношенных несущих элементов и последующей экспертизой промышленной безопасности может продлить допустимый срок эксплуатации крана — но только при документальном подтверждении экспертной организацией, а не автоматически по факту ремонта.' },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'ППР или капремонт крана', item: 'https://moskran-servis.ru/spravochnik/ppr-vs-kapremont-krana/' },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@id': 'https://moskran-servis.ru/#organization' }, // ссылка на единственный узел организации (BaseLayout): отдельный узел с тем же @id, но другим name, был противоречием в графе
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: 'https://moskran-servis.ru/spravochnik/ppr-vs-kapremont-krana/',
  inLanguage: 'ru-RU',
  datePublished: '2026-08-12',
  dateModified: '2026-08-12',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<SpravochnikLayout title={title} description={description} path="/spravochnik/ppr-vs-kapremont-krana/" slug="ppr-vs-kapremont-krana" ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>ППР или капремонт крана</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Разбор для заказчика</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">ППР или капремонт крана: в чём разница и когда что нужно</h1>
    <p class="ref-byline">Инженерная служба МОСКРАН-СЕРВИС · обновлено в 2026 году</p>

    <p>Заказчики иногда спрашивают, почему у одной подрядной организации кран регулярно «встаёт на ТО», а у другой — раз в год-два выходит на капитальный ремонт на несколько недель. Это два разных, но взаимосвязанных процесса обслуживания грузоподъёмной техники.</p>

    <h2 style="margin:36px 0 16px">Планово-предупредительный ремонт (ППР)</h2>
    <p>ППР — система обслуживания, направленная на предотвращение поломок, а не на устранение уже случившихся. Работы выполняются по заранее составленному графику с определённой периодичностью: технический осмотр, замена расходных узлов (фильтры, масла, изношенные тросы), диагностика гидравлики и электрики. Например, ТО-1 в среднем проводится каждые два месяца, но точный интервал устанавливается для каждой единицы техники отдельно исходя из интенсивности эксплуатации и рекомендаций завода-изготовителя.</p>
    <p>Смысл ППР — не допустить, чтобы мелкий износ превратился в отказ узла во время работы на объекте: замена уплотнения на плановом ТО стоит в разы дешевле, чем аварийный ремонт гидроцилиндра после его разрушения на объекте заказчика с простоем техники и срывом сроков.</p>

    <h2 style="margin:36px 0 16px">Капитальный ремонт</h2>
    <p>Капитальный ремонт — устранение уже накопленного износа или повреждения, который выходит за рамки планового обслуживания. Для его назначения составляется дефектная ведомость по результатам технического освидетельствования или экспертизы промышленной безопасности, рассчитывается объём и стоимость работ, разрабатывается план и закупаются необходимые узлы и материалы. Стоимость капитального ремонта может быть кратно выше текущего планового обслуживания — речь идёт о замене несущих элементов, крупных агрегатов или полной переборке узлов.</p>
    <p>После капитального ремонта, затрагивающего несущие металлоконструкции или ограничитель грузоподъёмности, кран не может вернуться к работе без повторной экспертизы промышленной безопасности — это отдельный этап, который не входит в стоимость самого ремонта и должен быть учтён в сроках возврата техники в работу.</p>

    <h2 style="margin:36px 0 16px">Как это отражается на арендаторе техники</h2>
    <p>Для заказчика, берущего кран в аренду, разница практична: техника с исправно выполняемым ППР реже срывает сроки из-за внезапной поломки на объекте, а капитальный ремонт — это плановая недоступность конкретной единицы техники, о которой добросовестный арендодатель предупреждает заранее, а не постфактум после аварийного простоя.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: что запомнить</h2>
    <ul>
      <li>ППР — плановое обслуживание по графику для предотвращения поломок, регулярное и относительно недорогое.</li>
      <li>Капремонт — устранение накопленного износа по дефектной ведомости, дороже и требует повторной экспертизы для несущих узлов.</li>
      <li>Отказ от ППР — частая причина того, что лёгкая неисправность превращается в дорогой капитальный ремонт.</li>
      <li>После капремонта несущих конструкций кран не допускается к работе без новой экспертизы промышленной безопасности.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <Sources
      checked={CHECKED}
      items={[
        { text: 'kran.expert — ТО vs капитальный ремонт крана', href: 'https://kran.expert/press/stati/to-vs-kapitalnyj-remont-krana-v-chem-raznica-i-chto-vybrat/' },
        { text: 'valve-service.ru — система планово-предупредительного ремонта', href: 'https://www.valve-service.ru/Sistema_planovo-predupreditelnogo_remonta' }
      ]}
    />
  </article>
  <section class="section wrap"><a class="btn" href="/spravochnik/remont-strely-posle-avarii-dopusk/">Ремонт стрелы после аварии — допуск к эксплуатации →</a></section>
</main>
</SpravochnikLayout>
