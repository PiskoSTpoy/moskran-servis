---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = "Подъём груза у стены дома в Москве: пп. 129 и 156 ФНП 461";
const description = "У стены дома человек не может стоять между грузом и стеной (п. 129 ФНП №461), а зазор от низа груза до выступов здания — не менее 0,5 м (п. 156 «к»).";

const CHECKED = '22.10.2026';
const PUBLISHED = '2026-10-22';
const SLUG = "podyom-gruza-u-steny-doma-v-moskve-fnp-461";
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: "Можно ли стропальщику придерживать груз между ним и стеной дома?",
    a: "Нет. При подъёме, опускании и перемещении груза краном, стоящим у стены, колонны, штабеля или вагона, людям, в том числе стропальщику, нельзя находиться между грузом и этими конструкциями (п. 129 ФНП №461).",
  },
  {
    q: "Какой зазор нужен между грузом и балконом или карнизом?",
    a: "От низа перемещаемого груза до наиболее выступающих по вертикали частей здания — не менее 0,5 м, до перекрытий и площадок, где могут быть люди, — не менее 2,3 м (п. 156 «к» ФНП №461). Расстояния считают с учётом длины строп и траверс.",
  },
  {
    q: "Нужно ли указывать в ППР балконы и эркеры соседнего дома?",
    a: "Да. П. 156 «м» ФНП №461 требует указывать размеры наиболее выступающих в горизонтальной плоскости элементов здания: карнизов, балконов, ограждений, эркеров, козырьков и входов. МОСКРАН-СЕРВИС проверяет их по фото до выезда.",
  },
  {
    q: "Можно ли проносить груз над крышей жилого дома?",
    a: "Нет, если под перекрытием находятся жилые, производственные или служебные помещения, где могут быть люди (п. 128 ФНП №461). Маршрут груза в ППР строят в обход таких перекрытий.",
  },
  {
    q: "Почему в Москве эта тема актуальна?",
    a: "Программа реновации, утверждённая в 2017 году, предусматривает расселение 5176 домов и касается около миллиона москвичей (mos.ru). Новые корпуса строят рядом с жилыми домами, поэтому автокран часто работает у чужой стены.",
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: "Подъём груза у стены дома в Москве", item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ["moskva", "Почему в Москве кран работает у чужой стены"],
  ["p129", "Человек между грузом и стеной: п. 129"],
  ["zazory", "Зазоры 0,5 и 2,3 м: п. 156 «к»"],
  ["vystupy", "Балконы, эркеры, козырьки: п. 156 «м»"],
  ["p128", "Груз над жилым перекрытием: п. 128"],
  ["praktika", "Что МОСКРАН-СЕРВИС проверяет до выезда во двор"],
  ["faq", "Частые вопросы"],
  ["istochniki", "Источники"],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Подъём груза у стены дома в Москве</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">ФНП №461 · Стеснённая площадка · Москва</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Как поднимать груз автокраном у стены жилого дома в Москве?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>22.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>22.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>5 мин чтения</span>
    </div>

    <p>Пункт 129 ФНП №461 запрещает людям, включая стропальщика, находиться между поднимаемым грузом и стеной, колонной или штабелем, у которых стоит кран. Пункт 156 «к» добавляет зазор не менее 0,5 м от низа груза до выступающих частей здания и 2,3 м — до площадок, где могут быть люди. МОСКРАН-СЕРВИС закладывает оба требования в схему установки автокрана в московском дворе до выезда.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="moskva" style="margin:36px 0 16px">Почему в Москве кран работает у чужой стены</h2>
    <p>Программа реновации Москвы, утверждённая в 2017 году, предусматривает расселение 5176 домов и касается около миллиона москвичей (данные mos.ru, 2026). Стартовые корпуса и снос старых пятиэтажек идут внутри сложившихся кварталов, где соседний жилой дом стоит в нескольких метрах от площадки. Для автокрана КС-35714 «Ивановец» на 16 т это означает работу у стены, балконов и подъездных козырьков, которые не принадлежат заказчику. МОСКРАН-СЕРВИС поэтому разбирает стеснённые дворы отдельно от открытых площадок.</p>


    <h2 id="p129" style="margin:36px 0 16px">Человек между грузом и стеной: п. 129</h2>
    <p>При подъёме груза краном, установленным вблизи стены, колонны, штабеля, железнодорожного вагона, станка или другого оборудования, нахождение людей, в том числе стропальщика, между грузом и этими частями здания или оборудованием не допускается (п. 129 ФНП №461). Запрет действует и при опускании, и при перемещении груза. Стропальщик у автокрана КС-55713-1К «Клинцы» направляет груз оттяжкой, стоя сбоку, а не спиной к стене. МОСКРАН-СЕРВИС прописывает место стропальщика на схеме, потому что во дворе его «естественная» позиция часто оказывается именно у фасада.</p>


    <h2 id="zazory" style="margin:36px 0 16px">Зазоры 0,5 и 2,3 м: п. 156 «к»</h2>
    <p>ППР с применением ПС задаёт зазор не менее 0,5 м от низа груза до наиболее выступающих по вертикали частей здания (п. 156 «к» ФНП №461). До перекрытий и площадок, где могут находиться люди, зазор — не менее 2,3 м. Расстояния считают с учётом длины применяемых строп и размеров траверс. МОСКРАН-СЕРВИС проверяет зазор по низу груза, а не по крюку: строп длиной 4 м опускает низ плиты на 4 м ниже крюковой подвески.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Что рядом с грузом</th><th>Минимальный зазор от низа груза</th><th>Норма</th></tr></thead>
        <tbody>
          <tr><td>Выступающие по вертикали части здания: парапет, кровля пристройки, ограждение</td><td>0,5 м</td><td>п. 156 «к»</td></tr>
          <tr><td>Перекрытия и площадки, где могут находиться люди: балконы, лоджии, кровля с выходом</td><td>2,3 м</td><td>п. 156 «к»</td></tr>
          <tr><td>Перекрытие, под которым жилые или служебные помещения с людьми</td><td>перемещение груза не допускается</td><td>п. 128</td></tr>
          <tr><td>Пространство между грузом и стеной</td><td>людей быть не должно</td><td>п. 129</td></tr>
        </tbody>
      </table>
    </div>


    <h2 id="vystupy" style="margin:36px 0 16px">Балконы, эркеры, козырьки: п. 156 «м»</h2>
    <p>ППР должен содержать размеры наиболее выступающих в горизонтальной плоскости элементов здания: карнизов, балконов, ограждений, эркеров, козырьков и входов (п. 156 «м» ФНП №461). Для московской панельной застройки это прежде всего балконные плиты и козырьки подъездов, которые выступают за плоскость стены. МОСКРАН-СЕРВИС просит у заказчика фото фасада со стороны работ, чтобы заранее увидеть эти элементы, а не на месте. Порядок ППР в целом описан в справке о <a href="/spravochnik/ppr-dlya-krana/" style="color:var(--yellow)">ППР для крана</a>.</p>


    <h2 id="p128" style="margin:36px 0 16px">Груз над жилым перекрытием: п. 128</h2>
    <p>Перемещение грузов при строительно-монтажных и погрузочно-разгрузочных работах над перекрытиями, под которыми находятся производственные, жилые или служебные помещения с людьми, не допускается (п. 128 ФНП №461). Во дворе это кровля одноэтажной пристройки с магазином или пункт выдачи на первом этаже. МОСКРАН-СЕРВИС ставит автокран так, чтобы траектория груза обходила такие перекрытия, даже если это удлиняет вылет. Подъём на собственную кровлю заказчика разобран в справке о <a href="/spravochnik/podyom-gruza-na-kryshu-avtokranom/" style="color:var(--yellow)">подъёме груза на крышу</a>.</p>


    <h2 id="praktika" style="margin:36px 0 16px">Что МОСКРАН-СЕРВИС проверяет до выезда во двор</h2>
    <p>Практика МОСКРАН-СЕРВИС, а не отдельная норма: до подачи автокрана в московский двор заказчик присылает фото фасадов со стороны работ, высоту балконов и козырьков, массу и размеры груза, длину строп. По этим данным инженер проверяет зазоры 0,5 и 2,3 м и место стропальщика вне пространства между грузом и стеной. Если вылет растёт, вместо КС-35714 «Ивановец» предлагается КС-55713-1К «Клинцы» с запасом грузоподъёмности. Как подать такие данные, описано в справке о <a href="/spravochnik/zayavka-na-avtokran/" style="color:var(--yellow)">заявке на автокран</a>.</p>


    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: груз у стены дома</h2>
    <ul>
      <li>Между грузом и стеной людей быть не должно — ни при подъёме, ни при опускании (п. 129 ФНП №461).</li>
      <li>Зазор от низа груза: 0,5 м до выступов здания, 2,3 м до балконов и площадок с людьми (п. 156 «к»).</li>
      <li>Балконы, эркеры и козырьки указывают в ППР (п. 156 «м»); над жилыми перекрытиями груз не носят (п. 128).</li>
      <li>МОСКРАН-СЕРВИС проверяет фасад по фото до выезда — реновация на 5176 домов делает стеснённые дворы нормой.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://www.consultant.ru/document/cons_doc_LAW_373321/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 (приказ Ростехнадзора от 26.11.2020 №461)</a> — пп. 128, 129, 156 «к» и «м».</li>
      <li><a href="https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 на legalacts.ru</a> — редакция от 16.04.2026, текст пунктов 128, 129 и 156 сверен 22.10.2026.</li>
      <li><a href="https://www.mos.ru/news/item/172981073/" target="_blank" rel="noopener" style="color:var(--yellow)">mos.ru — программа реновации</a> — утверждена в 2017 году, 5176 домов, около миллиона москвичей; проверено 22.10.2026.</li>
    </ul>
    <p class="small muted">Пример со стропом 4 м — арифметическая иллюстрация; порядок проверки фасада по фото — практика МОСКРАН-СЕРВИС, а не требование ФНП.</p>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-16-25-tonn/">Аренда автокрана 16–25 тонн →</a></section>
</main>
</SpravochnikLayout>
