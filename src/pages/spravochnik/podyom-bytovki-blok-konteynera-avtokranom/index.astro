---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = 'Подъём бытовки автокраном: масса и выбор крана';
const description = 'Бытовка 6 м весит 1,4–3 т в зависимости от ширины и утепления. Как узнать реальную массу, подобрать автокран по моменту и безопасно поднять блок-контейнер.';

const CHECKED = '05.10.2026';
const PUBLISHED = '2026-10-05';
const SLUG = 'podyom-bytovki-blok-konteynera-avtokranom';
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: 'Сколько весит бытовка 6 метров?',
    a: 'Металлическая бытовка 6×2,4 м весит 1400–2200 кг, а 6×3 м — 1800–3000 кг по данным производителя бытовок. Стандартный модуль 6×2,45 м в справочнике поставщика блок-контейнеров оценён примерно в 2,5 т. МОСКРАН-СЕРВИС подбирает кран по верхней границе диапазона, пока не получена паспортная масса конкретной бытовки.',
  },
  {
    q: 'Какой автокран нужен, чтобы поднять бытовку?',
    a: 'Для бытовки 6 м хватает 16-тонного КС-35714 «Ивановец», если вылет до места установки небольшой. По моменту 48 т·м он удерживает 3 т примерно до 16 м, а смена стоит 17 600 ₽. МОСКРАН-СЕРВИС проверяет окончательно по грузовой характеристике на нужном вылете.',
  },
  {
    q: 'Можно ли оставлять людей и вещи в бытовке при подъёме?',
    a: 'Нет, МОСКРАН-СЕРВИС поднимает только пустую бытовку без людей и свободных предметов. Содержимое добавляет вес, которого нет в паспортной массе, и может сместиться при подъёме. Перемещение груза над людьми ФНП №461 ограничивает отдельными требованиями.',
  },
  {
    q: 'Как узнать точную массу бытовки?',
    a: 'Самый надёжный способ — паспорт изделия или табличка изготовителя. Если их нет, МОСКРАН-СЕРВИС рекомендует взвесить бытовку на автомобильных весах вместе с транспортом и вычесть массу тягача. Утепление минватой толщиной 50–100 мм добавляет 80–150 кг, внутренняя отделка и электрощит — 100–250 кг.',
  },
  {
    q: 'Нужен ли кран, если бытовку везёт манипулятор?',
    a: 'Для лёгких бытовок 3–4 м хватает манипулятора. По справочнику производителя для бытовки 6 м нужен манипулятор грузоподъёмностью 3–7 т, а при массе свыше 2,5 т обычно привлекают автокран. МОСКРАН-СЕРВИС выбирает автокран, когда вылет до места установки превышает возможности манипулятора.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Подъём бытовки автокраном', item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ['massa', 'Сколько весит бытовка'],
  ['faktory', 'Что добавляет килограммы'],
  ['kran', 'Какой автокран выбрать'],
  ['podyom', 'Порядок подъёма'],
  ['ploshadka', 'Площадка и опоры'],
  ['faq', 'Частые вопросы'],
  ['istochniki', 'Источники'],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Подъём бытовки автокраном</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Инструкция · Блок-контейнеры</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Каким автокраном поднять бытовку и сколько она весит?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>05.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>05.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>5 мин чтения</span>
    </div>

    <p>Металлическая бытовка 6×2,4 м весит 1400–2200 кг, а 6×3 м — до 3000 кг, поэтому для её подъёма достаточно 16-тонного автокрана при вылете до 16 м. Точную массу задают утепление, отделка и электрощит. МОСКРАН-СЕРВИС разбирает, как считать массу, подбирать машину и ставить кран под блок-контейнер.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="massa" style="margin:36px 0 16px">Сколько весит бытовка</h2>
    <p>Масса бытовки зависит от длины, ширины и материала каркаса, и разброс в пределах одного типоразмера достигает 800 кг. Поставщики блок-контейнеров называют стандартным модуль 6×2,45 м и оценивают его примерно в 2,5 т, а облегчённые складские модели — не тяжелее 2 т (по стандарту ISO 2145–2370 кг). МОСКРАН-СЕРВИС сводит данные производителей в одну таблицу.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Бытовка</th><th>Металл, кг</th><th>Дерево, кг</th></tr></thead>
        <tbody>
          <tr><td>2–3 м</td><td>500–1100</td><td>700–1000</td></tr>
          <tr><td>4–5 м</td><td>900–1700</td><td>1000–1500</td></tr>
          <tr><td>6×2,4 м</td><td>1400–2200</td><td>—</td></tr>
          <tr><td>6×3 м</td><td>1800–3000</td><td>1500–2300</td></tr>
          <tr><td>7–9 м</td><td>2000–4200</td><td>—</td></tr>
        </tbody>
      </table>
    </div>

    <h2 id="faktory" style="margin:36px 0 16px">Что добавляет килограммы</h2>
    <p>Три добавки меняют массу бытовки на 100–500 кг: утепление, отделка и лишняя длина. Утепление минватой 50–100 мм добавляет 80–150 кг, внутренняя отделка с электрощитом и коммуникациями — 100–250 кг, каждый лишний метр длины — 180–350 кг. МОСКРАН-СЕРВИС поэтому прибавляет к паспортной массе запас на отделку, пока бытовка не взвешена.</p>
    <p>Если паспорта нет, самое надёжное — взвесить бытовку на весах вместе с транспортом. Порядок такого взвешивания описан в материале <a href="/spravochnik/massa-tary-vzveshivanie/" style="color:var(--yellow)">«Масса тары и взвешивание груза»</a>. Заказчик получает от МОСКРАН-СЕРВИС расчёт по реальной массе, а не по рекламной цифре из объявления.</p>

    <h2 id="kran" style="margin:36px 0 16px">Какой автокран выбрать</h2>
    <p>Для бытовки до 3 т МОСКРАН-СЕРВИС начинает подбор с 16-тонного КС-35714 «Ивановец» с моментом 48 т·м. Если разделить момент на массу, 3-тонный блок-контейнер проходит по моменту до вылета 16 м, а смена этой машины стоит 17 600 ₽. Грузовая характеристика конкретного крана на нужном вылете всегда строже простого деления, поэтому её проверяют по паспорту.</p>
    <p>Если бытовку нужно подать через забор или на второй ряд, вылет растёт, и 16 т уже не хватает. Тогда МОСКРАН-СЕРВИС берёт КС-55713-1К «Клинцы» (85 т·м) и сверяется с логикой из материала <a href="/spravochnik/gruzovysotnaya-harakteristika/" style="color:var(--yellow)">о грузовысотной характеристике</a>. Сравнение классов 16 и 25 т по цене и моменту приведено в <a href="/spravochnik/avtokran-16-ili-25-tonn/" style="color:var(--yellow)">отдельном разборе</a>.</p>

    <h2 id="podyom" style="margin:36px 0 16px">Порядок подъёма</h2>
    <p>Бытовку поднимают за 4 точки строповки, которые указал изготовитель, пустой и закрытой. МОСКРАН-СЕРВИС рекомендует до приезда крана выяснить у поставщика, есть ли на каркасе рым-болты, петли или угловые фитинги. Схему и расчёт угла ветвей строп смотрите в материалах о <a href="/spravochnik/shemy-stropovki-gruzov/" style="color:var(--yellow)">схемах строповки</a> и <a href="/spravochnik/ugol-naklona-stropa/" style="color:var(--yellow)">угле наклона стропа</a>.</p>
    <p>Людей и вещи в бытовке на время подъёма не оставляют: перемещение груза над людьми ограничено, подробности есть в справочнике <a href="/spravochnik/peremeshchenie-gruza-nad-lyudmi/" style="color:var(--yellow)">о перемещении груза над людьми</a>. МОСКРАН-СЕРВИС также просит убрать с крыши бытовки снег и предметы заранее, чтобы масса не менялась в воздухе.</p>

    <h2 id="ploshadka" style="margin:36px 0 16px">Площадка и опоры</h2>
    <p>Под бытовку и под выносные опоры крана нужны два основания, и п. 108–110 ФНП №461 касаются обоих. По п. 108–110 ФНП №461 площадка должна выдерживать нагрузку, а кран выставляется в пределах паспортного уклона. МОСКРАН-СЕРВИС проверяет грунт под опорами заранее — как это делается, показано в материале о <a href="/spravochnik/nesushchaya-sposobnost-grunta/" style="color:var(--yellow)">несущей способности грунта</a>.</p>
    <p>Для 16-тонной машины на узком участке главная проблема — не масса бытовки, а вылет до точки установки и место под опоры. Если участок частный, пригодится материал об <a href="/spravochnik/avtokran-dlya-chastnogo-doma/" style="color:var(--yellow)">автокране для частного дома</a>. Заявку на подачу МОСКРАН-СЕРВИС оформляет по <a href="/spravochnik/zayavka-na-avtokran/" style="color:var(--yellow)">шаблону заявки</a>.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: подъём бытовки</h2>
    <ul>
      <li>Бытовка 6×2,4 м — 1400–2200 кг, 6×3 м — 1800–3000 кг; стандартный модуль 6×2,45 м — около 2,5 т.</li>
      <li>Утепление добавляет 80–150 кг, отделка и щит — 100–250 кг.</li>
      <li>16-тонный КС-35714 по моменту держит 3 т примерно до 16 м.</li>
      <li>Строповка — только за точки изготовителя, внутри никого и ничего.</li>
      <li>Площадка и опоры проверяются до приезда крана (п. 108–110 ФНП №461).</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://rmrail.ru/poleznaya-informatsiya/razmery-i-ves-blok-kontejnera/" target="_blank" rel="noopener" style="color:var(--yellow)">Размеры и вес блок-контейнера — rmrail.ru</a> — модуль 6×2,45 м около 2,5 т, ISO 2145–2370 кг.</li>
      <li><a href="https://bk-resurs.ru/poleznye-sovety/ves-bytovki-skolko-vesit-bytovka-v-zavisimosti-ot-tipa-i-razmera/" target="_blank" rel="noopener" style="color:var(--yellow)">Вес бытовки по типу и размеру — bk-resurs.ru</a> — диапазоны масс и добавки за утепление и отделку.</li>
      <li><a href="https://sudact.ru/law/prikaz-rostekhnadzora-ot-26112020-n-461-ob/federalnye-normy-i-pravila-v/vi/ustanovka-ps-i-proizvodstvo-rabot/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461, раздел VI «Установка ПС и производство работ»</a> — п. 108–110.</li>
      <li><a href="/spravochnik/avtokran-16-ili-25-tonn/" style="color:var(--yellow)">Автокран 16 или 25 т — справочник МОСКРАН-СЕРВИС</a> — момент 48 и 85 т·м, цена смены.</li>
    </ul>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-16-25-tonn/">Аренда автокрана 16–25 тонн →</a></section>
</main>
</SpravochnikLayout>
