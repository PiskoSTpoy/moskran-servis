---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';
import Sources from '../../../components/Sources.astro';

/* --- Волна 16 (исправление статуса документа) --------------------------------
   Прежняя редакция описывала ПОТ РМ-007-98 как действующий документ, который
   «применяется параллельно с ФНП №461». Проверка 12.08.2026: документ помечен
   как прекративший действие; правила по охране труда при погрузочно-разгрузочных
   работах и размещении грузов сегодня утверждены приказом Минтруда России
   от 28.10.2020 №753н (ред. от 29.04.2025, срок действия — до 01.09.2027).
   Страница переписана целиком: она сохраняет адрес (по нему приходят за старым
   документом) и отвечает на главный вопрос такого посетителя — «действует ли
   ПОТ РМ-007-98 и что вместо него». Ссылки на ПОТ в других материалах сайта
   сняты в этой же волне. */

const title = 'Какие правила охраны труда заменили ПОТ РМ-007-98';
const description = 'ПОТ РМ-007-98 прекратили действие. Действующий документ — Правила по охране труда при ПРР (приказ Минтруда №753н). Что это меняет на площадке.';

const CHECKED = '12.08.2026';

const faqs = [
  { q: 'ПОТ РМ-007-98 действует в 2026 году?', a: 'Нет. Межотраслевые правила по охране труда при погрузочно-разгрузочных работах и размещении грузов (ПОТ РМ-007-98, утверждены постановлением Минтруда России от 20.03.1998 №16) помечены как прекратившие действие. Действующий документ на эту тему — Правила по охране труда при погрузочно-разгрузочных работах и размещении грузов, утверждённые приказом Минтруда России от 28.10.2020 №753н, в редакции от 29.04.2025; срок их действия рассчитан до 1 сентября 2027 года.' },
  { q: 'Что делать, если наша инструкция ссылается на ПОТ РМ-007-98?', a: 'Заменить ссылку на действующий документ и перепроверить те пункты инструкции, которые из него переписаны. Ссылка на отменённый документ сама по себе не делает содержание инструкции неправильным, но означает, что документ не пересматривали как минимум с 2020 года — и другие его положения тоже стоит сверить.' },
  { q: 'Чем эти правила отличаются от ФНП №461?', a: 'Разной областью действия. ФНП №461 регулируют промышленную безопасность подъёмного сооружения как составляющей опасного производственного объекта: освидетельствование, приборы безопасности, допуск персонала, установка и производство работ. Правила по охране труда при погрузочно-разгрузочных работах шире по объекту и уже по предмету: они про безопасность самих работ и размещения грузов, независимо от того, чем груз перемещают — краном, погрузчиком или вручную. Оба документа применяются параллельно.' },
  { q: 'Откуда на отраслевых сайтах цифра «42 В» для работы у ЛЭП?', a: 'Из приложения 16 к ПОТ РМ-007-98. Поскольку документ прекратил действие, ссылаться на этот порог некорректно: действующее требование к крану стоит в пункте 112 ФНП №461 и говорит о воздушной линии или воздушной электрической сети напряжением более 50 В. Разбор — в отдельном материале справочника про работу рядом с ЛЭП.' },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'ПОТ РМ-007-98', item: 'https://moskran-servis.ru/spravochnik/pot-rm-007-98/' },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@id': 'https://moskran-servis.ru/#organization' }, // ссылка на единственный узел организации (BaseLayout): отдельный узел с тем же @id, но другим name, был противоречием в графе
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: 'https://moskran-servis.ru/spravochnik/pot-rm-007-98/',
  inLanguage: 'ru-RU',
  datePublished: '2026-08-12',
  dateModified: '2026-08-12',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<SpravochnikLayout title={title} description={description} path="/spravochnik/pot-rm-007-98/" slug="pot-rm-007-98" ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>ПОТ РМ-007-98</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Статус документа</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">ПОТ РМ-007-98 не действует. Что применяется вместо них</h1>
    <p class="ref-byline">Инженерная служба МОСКРАН-СЕРВИС · статус проверен 12.08.2026</p>

    <div class="alert">
      <p><b>Коротко.</b> Межотраслевые правила по охране труда при погрузочно-разгрузочных работах и размещении грузов (ПОТ РМ-007-98) прекратили действие. Действующий документ — Правила по охране труда при погрузочно-разгрузочных работах и размещении грузов, утверждённые приказом Минтруда России от 28.10.2020 №753н, в редакции от 29.04.2025.</p>
    </div>

    <p>Этот материал стоит по тому же адресу, что и прежний разбор ПОТ РМ-007-98, намеренно: по названию отменённого документа продолжают искать — он до сих пор упоминается в типовых инструкциях, в договорах подряда и в отраслевых статьях. Поэтому первое, что здесь написано, — что искомого документа больше нет, и второе — чем именно он заменён.</p>

    <h2 style="margin:36px 0 16px">Что это был за документ</h2>
    <p>ПОТ РМ-007-98 — межотраслевые правила, утверждённые постановлением Минтруда России от 20.03.1998 №16. Они задавали единые требования безопасности при погрузочно-разгрузочных работах и размещении грузов для организаций всех сфер деятельности, а не только для строительства, и содержали приложения, которые впоследствии разошлись по отрасли цитатами: схемы строповки, форма наряда-допуска на работы вблизи воздушных линий, таблица минимальных расстояний.</p>
    <p>Именно из приложения 16 этих правил происходит формулировка «30 метров до крайнего провода линии напряжением 42 В и выше», которую до сих пор переписывают друг у друга отраслевые сайты. Норма про кран сегодня стоит в другом документе и звучит иначе — разбор в материале <a href="/spravochnik/rabota-krana-ryadom-s-lep/" style="color:var(--yellow)">о работе рядом с ЛЭП</a>.</p>

    <h2 style="margin:36px 0 16px">Чем заменён</h2>
    <table class="ttx">
      <tbody>
        <tr><td>Документ</td><td>Правила по охране труда при погрузочно-разгрузочных работах и размещении грузов</td></tr>
        <tr><td>Чем утверждён</td><td>приказ Минтруда России от 28.10.2020 №753н</td></tr>
        <tr><td>Регистрация в Минюсте</td><td>15.12.2020, №61471</td></tr>
        <tr><td>Действующая редакция</td><td>от 29.04.2025 (приказ Минтруда России №287н)</td></tr>
        <tr><td>Срок действия</td><td>до 1 сентября 2027 года</td></tr>
        <tr><td>Что признано утратившим силу</td><td>приказ Минтруда России от 17.09.2014 №642н — предыдущие правила той же темы</td></tr>
      </tbody>
    </table>
    <p>Обратите внимание на последнюю строку: между ПОТ РМ-007-98 и действующими правилами был ещё один документ. Это типичная для охраны труда цепочка, из-за которой ссылка «по ПОТ РМ» в инструкции означает не одно устаревание, а два подряд.</p>

    <h2 style="margin:36px 0 16px">Как это соотносится с ФНП №461</h2>
    <p>Два документа не заменяют друг друга и не конкурируют — у них разная область действия, и на площадке они работают одновременно.</p>
    <table class="ttx">
      <tbody>
        <tr><td>ФНП №461</td><td>промышленная безопасность подъёмного сооружения: освидетельствование, приборы безопасности, назначение ответственных, установка машины и производство работ с её применением</td></tr>
        <tr><td>Правила по охране труда при ПРР (753н)</td><td>безопасность самих погрузочно-разгрузочных работ и размещения грузов — независимо от того, чем перемещается груз: краном, погрузчиком или вручную</td></tr>
      </tbody>
    </table>
    <p>Практический критерий разделения простой. Вопрос «действует ли освидетельствование этой машины и кто подписал наряд-допуск» — это ФНП №461. Вопрос «известна ли масса груза до подъёма, как он застроплен и куда его можно положить» — это правила по охране труда при погрузочно-разгрузочных работах.</p>

    <h2 style="margin:36px 0 16px">Что это меняет для заказчика крана</h2>
    <p>Напрямую — ничего в порядке работы: требования по существу похожи, и добросовестный подрядчик выполняет их независимо от того, на какой документ ссылается его инструкция. Косвенно — это удобный индикатор. Если в присланном вам регламенте, инструкции по строповке или в приложении к договору стоит ПОТ РМ-007-98, документ не пересматривали минимум с 2020 года. Рядом в таком же комплекте обычно обнаруживаются ПБ 10-382-00, отменённые ещё в 2014 году, — <a href="/spravochnik/fnp-461-chto-izmenilos/" style="color:var(--yellow)">разбор этой замены</a> у нас отдельный.</p>
    <p>Второе следствие — цитаты. Любая цифра, взятая из ПОТ РМ-007-98 и приведённая как действующая норма, требует перепроверки по актуальному документу. Мы прошли по собственному сайту и сняли такие ссылки в этой же волне правок; если найдёте оставшуюся — это дефект, а не «историческая справка».</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: что запомнить</h2>
    <ul>
      <li>ПОТ РМ-007-98 прекратили действие; искать их актуальную редакцию бессмысленно.</li>
      <li>Действующий документ — приказ Минтруда России от 28.10.2020 №753н, редакция от 29.04.2025, срок действия до 01.09.2027.</li>
      <li>Между ними был промежуточный документ — приказ №642н от 2014 года, признанный утратившим силу.</li>
      <li>ФНП №461 не отменяет правила по охране труда и не заменяется ими: разная область действия, применяются параллельно.</li>
      <li>Ссылка на ПОТ РМ-007-98 в чужом документе — повод проверить весь документ, а не только этот пункт.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <Sources
      checked={CHECKED}
      items={[
        { text: 'ПОТ РМ-007-98 (постановление Минтруда России от 20.03.1998 №16) — карточка документа с отметкой «прекратили действие»', href: 'https://base.garant.ru/12126870/' },
        { text: 'Приказ Минтруда России от 28.10.2020 №753н «Об утверждении Правил по охране труда при погрузочно-разгрузочных работах и размещении грузов» — редакция от 29.04.2025, срок действия до 01.09.2027, признаёт утратившим силу приказ №642н', href: 'https://normativ.kontur.ru/document?moduleId=1&documentId=501427' },
        { text: 'Приказ Ростехнадзора от 26.11.2020 №461 (ред. от 16.04.2026) — ФНП по подъёмным сооружениям, п. 112', href: 'https://www.consultant.ru/document/cons_doc_LAW_373321/' },
      ]}
      note="Дата проверки относится к статусу документов, а не к содержанию наших выводов: если после 12.08.2026 выйдет новая редакция или продление срока действия, правы будут реквизиты в источнике, а не эта страница."
    />
  </article>
</main>
<style>
  .alert { border: 2px solid var(--yellow); background: var(--bg-2); padding: 18px 20px; margin-bottom: 28px; }
  .alert p { font-size: var(--t-md); }
  .ttx { width: 100%; border-collapse: collapse; margin: 20px 0; font-size: var(--t-md); }
  .ttx td { padding: 11px 14px 11px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
  .ttx td:first-child { color: var(--muted); width: 34%; }
</style>
</SpravochnikLayout>
