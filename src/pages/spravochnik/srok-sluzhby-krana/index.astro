---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';
import Sources from '../../../components/Sources.astro';

const title = 'Что будет с краном после истечения срока службы';
const description = 'Срок службы крана зависит от состояния несущих металлоконструкций. По истечении нормативного срока — обследование, а не автоматическое списание.';

const CHECKED = '12.08.2026';

const faqs = [
  { q: 'Кран автоматически списывается по истечении нормативного срока службы?', a: 'Нет — истечение срока не означает автоматический запрет на эксплуатацию, но и работать «как раньше» после этой даты нельзя. Подпункт «а» пункта 22 ФНП №461 формулирует это прямо: эксплуатирующая организация не должна превышать срок службы, заявленный изготовителем в паспорте подъёмного сооружения, без заключения экспертизы промышленной безопасности о возможности его продления. То есть основанием для дальнейшей работы становится заключение аккредитованной экспертной организации, а не решение владельца техники.' },
  { q: 'Что изнашивается быстрее — металлоконструкция или навесное оборудование?', a: 'Как правило, навесные компоненты (электродвигатели, лебёдки, тормозные системы) изнашиваются быстрее и заменяются на новые в процессе эксплуатации. Срок службы самого крана как единицы техники определяется в первую очередь состоянием несущих металлоконструкций, которые заменить полностью невозможно.' },
  { q: 'Почему мы упоминаем срок службы техники на сайте?', a: 'Потому что это прямо влияет на надёжность подаваемой на ваш объект техники — кран с добросовестно обслуживаемой историей и вовремя пройденными обследованиями безопасен и после истечения формального нормативного срока, а кран без такой истории — риск независимо от возраста.' },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Срок службы крана', item: 'https://moskran-servis.ru/spravochnik/srok-sluzhby-krana/' },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@id': 'https://moskran-servis.ru/#organization' }, // ссылка на единственный узел организации (BaseLayout): отдельный узел с тем же @id, но другим name, был противоречием в графе
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: 'https://moskran-servis.ru/spravochnik/srok-sluzhby-krana/',
  inLanguage: 'ru-RU',
  datePublished: '2026-08-12',
  dateModified: '2026-08-12',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<SpravochnikLayout title={title} description={description} path="/spravochnik/srok-sluzhby-krana/" slug="srok-sluzhby-krana" ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Срок службы крана</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Разбор для заказчика</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Истечение срока службы крана — что происходит дальше</h1>
    <p class="ref-byline">Инженерная служба МОСКРАН-СЕРВИС · обновлено в 2026 году</p>

    <p>Мы упоминали в статье про экспертизу промышленной безопасности, что истечение нормативного срока службы — один из поводов для проведения ЭПБ. Здесь разбираем подробнее: что вообще значит «срок службы» крана и почему это не то же самое, что автоматическое списание.</p>

    <h2 style="margin:36px 0 16px">От чего зависит срок службы</h2>
    <p>Срок службы крана как единицы техники определяется в первую очередь состоянием несущих металлоконструкций — стрелы, башни, рамы. На практике в процессе эксплуатации почти все навесные компоненты (электродвигатели, лебёдки, тормозные системы) изнашиваются быстрее металлоконструкции и заменяются на новые — то есть у крана в возрасте многих лет часть узлов может быть значительно моложе, чем сам корпус.</p>

    <h2 style="margin:36px 0 16px">Что происходит по истечении нормативного срока</h2>
    <p>Истечение срока службы не означает автоматический запрет на дальнейшую эксплуатацию — оно означает, что дальше техника работает только по заключению экспертизы промышленной безопасности. Формулировка подпункта «а» пункта 22 ФНП №461: не превышать срок службы, заявленный изготовителем в паспорте подъёмного сооружения, без наличия заключения экспертизы о возможности его продления. По результатам экспертизы принимается одно из трёх решений: продолжить эксплуатацию (возможно, с ограничениями по нагрузке или режиму), выполнить ремонт, или списать технику как непригодную к дальнейшей работе.</p>
    <p>Уточнение по источнику, если вы сверяете сами. Методические указания серии РД по экспертному обследованию грузоподъёмных машин (например, РД 10-112-96) — документы Госгортехнадзора девяностых годов, они писались под Правила ПБ 10-382-00, не применяемые с 7 марта 2014 года. Экспертные организации до сих пор используют их методики как отраслевую практику, но обязательным основанием является ФНП №461, а не РД. Если вам показывают заключение со ссылкой только на РД — это не повод считать заключение недействительным, но повод спросить, по какому пункту ФНП оно выдано.</p>

    <h2 style="margin:36px 0 16px">Почему добросовестное обслуживание важнее формального возраста</h2>
    <p>На предприятиях, где надзор за техническим состоянием организован хорошо — своевременно проводятся техническое обслуживание, профилактические ремонты и технические освидетельствования — грузоподъёмные машины могут оставаться в исправном состоянии и работать надёжно и безопасно даже после истечения нормативного срока службы. И наоборот: формально «молодой» кран с плохой историей обслуживания может представлять больший риск, чем старый кран с безупречным журналом освидетельствований.</p>

    <h2 style="margin:36px 0 16px">Что это значит для заказчика</h2>
    <p>Возраст конкретной единицы техники сам по себе — не главный показатель надёжности. Куда важнее история обслуживания: регулярность освидетельствований (см. отдельную статью про ЧТО/ПТО), своевременные экспертизы промышленной безопасности при наступлении соответствующих оснований, регистрация в реестре ОПО. Мы поддерживаем эту историю в порядке по каждой единице техники — и предоставляем документы по запросу, вне зависимости от возраста конкретной модели.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: что запомнить</h2>
    <ul>
      <li>Срок службы крана определяется состоянием несущих металлоконструкций, не навесного оборудования.</li>
      <li>Истечение нормативного срока требует обследования, а не означает автоматическое списание.</li>
      <li>По итогам обследования: продолжение эксплуатации, ремонт или списание — решение принимается по факту состояния, не по формальной дате.</li>
      <li>История добросовестного обслуживания важнее формального возраста техники.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <Sources
      checked={CHECKED}
      items={[
        { text: 'приказ Ростехнадзора от 26.11.2020 №461 (ред. от 16.04.2026) — п. 22, подпункт «а»', href: 'https://www.consultant.ru/document/cons_doc_LAW_373321/' },
        { text: 'mehanik-23.ru — сроки службы грузоподъёмных кранов', href: 'https://mehanik-23.ru/page23' },
        { text: 'itecokran.ru — сроки службы грузоподъёмного оборудования', href: 'https://itecokran.ru/press-czentr/stati/sroki-sluzhby-gruzopodyemnogo-oborudovaniya/' }
      ]}
    />
  </article>
  <section class="section wrap"><a class="btn" href="/spravochnik/ekspertiza-promyshlennoy-bezopasnosti/">Когда требуется экспертиза промышленной безопасности →</a></section>
</main>
</SpravochnikLayout>
