---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';
import Sources from '../../../components/Sources.astro';

const title = 'Как работают концевые выключатели крана';
const description = 'Концевые выключатели автоматически останавливают механизм крана при подходе к крайнему положению — предотвращают падение груза и повреждение конструкции.';

const CHECKED = '12.08.2026';

const faqs = [
  { q: 'Концевой выключатель — это то же самое, что ограничитель грузоподъёмности?', a: 'Нет, это разные устройства безопасности. Ограничитель грузоподъёмности (ОГП, о котором мы писали отдельно) реагирует на вес груза. Концевой выключатель реагирует на положение механизма — останавливает движение при достижении крайней точки хода, независимо от веса груза.' },
  { q: 'На каком расстоянии от упора срабатывает концевой выключатель?', a: 'При срабатывании выключателей механизмов передвижения расстояние от буферов крана или тележки до упора должно быть не менее половины пути торможения для большинства кранов, и не менее полного пути торможения для кранов на наземных подкрановых путях (башенных, козловых).' },
  { q: 'Что произойдёт, если концевой выключатель неисправен?', a: 'Неисправность концевого выключателя — один из опасных факторов, о которых мы писали в статье про действия при обнаружении неисправности крана: оператор обязан остановить работу и сообщить ответственному лицу, а не продолжать эксплуатацию, полагаясь на ручной контроль вместо автоматической защиты.' },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Концевые выключатели', item: 'https://moskran-servis.ru/spravochnik/konczevye-vyklyuchateli/' },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@id': 'https://moskran-servis.ru/#organization' }, // ссылка на единственный узел организации (BaseLayout): отдельный узел с тем же @id, но другим name, был противоречием в графе
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: 'https://moskran-servis.ru/spravochnik/konczevye-vyklyuchateli/',
  inLanguage: 'ru-RU',
  datePublished: '2026-08-12',
  dateModified: '2026-08-12',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<SpravochnikLayout title={title} description={description} path="/spravochnik/konczevye-vyklyuchateli/" slug="konczevye-vyklyuchateli" ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Концевые выключатели</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Разбор для заказчика</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Концевые выключатели крана — зачем нужны и как работают</h1>
    <p class="ref-byline">Инженерная служба МОСКРАН-СЕРВИС · обновлено в 2026 году</p>

    <p>Мы уже разбирали ограничитель грузоподъёмности — прибор, реагирующий на вес груза. Есть ещё одна категория приборов безопасности, реагирующая на положение механизма, — концевые выключатели.</p>

    <h2 style="margin:36px 0 16px">Что делают концевые выключатели</h2>
    <p>Концевые выключатели предназначены для автоматической остановки или изменения направления движения механизма крана при достижении определённых конечных положений — грузоподъёмных и движущихся частей. Они обеспечивают остановку механизма при достижении крайнего положения, предотвращая падение груза, повреждение конструкции крана или разматывание кабеля сверх допустимого.</p>

    <h2 style="margin:36px 0 16px">Где именно применяются</h2>
    <p>Концевыми выключателями производится автоматическая остановка механизмов передвижения кранов и их грузовых тележек перед подходом к упорам в конце рельсового пути. На портальных кранах концевые выключатели устанавливаются также для остановки механизма передвижения с целью предупреждения полного разматывания токоподводящего кабеля с кабельного барабана.</p>

    <h2 style="margin:36px 0 16px">Виды выключателей</h2>
    <p>В крановом оборудовании применяются разные типы концевых выключателей: механические, рычажные, магнитные и бесконтактные. Для механизмов с небольшим тормозным путём применяются одни модели, для механизмов с большим выбегом — другие, рассчитанные на более раннее срабатывание с учётом большей инерции.</p>

    <h2 style="margin:36px 0 16px">Требования к расстоянию срабатывания</h2>
    <p>При срабатывании выключателей механизмов передвижения расстояние от буферов крана или тележки до упора должно быть не менее половины пути торможения для большинства кранов и не менее полного пути торможения для кранов, работающих на наземных подкрановых путях (башенных, козловых). Для мостовых кранов, приближающихся друг к другу, минимальное расстояние отключения — 0,5 метра.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: что запомнить</h2>
    <ul>
      <li>Концевые выключатели останавливают механизм при достижении крайнего положения — в отличие от ОГП, реагирующего на вес груза.</li>
      <li>Применяются для остановки передвижения крана/тележки перед упором и предотвращения полного разматывания кабеля.</li>
      <li>Расстояние срабатывания рассчитывается от пути торможения конкретного механизма.</li>
      <li>Неисправность концевого выключателя — повод остановить работу, а не продолжать на ручном контроле.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <Sources
      checked={CHECKED}
      items={[
        { text: 'stroy-technics.ru — концевые выключатели кранов', href: 'https://stroy-technics.ru/article/kontsevye-vyklyuchateli-kranov' },
        { text: 'kranserv.ru — концевые выключатели в кранах', href: 'https://kranserv.ru/konczevye-vyklyuchateli-v-kranah-tipy-konstrukcziya-i-chastye-neispravnosti/' }
      ]}
    />
  </article>
  <section class="section wrap"><a class="btn" href="/spravochnik/ogranichitel-gruzopodemnosti/">Ограничитель грузоподъёмности →</a></section>
</main>
</SpravochnikLayout>
