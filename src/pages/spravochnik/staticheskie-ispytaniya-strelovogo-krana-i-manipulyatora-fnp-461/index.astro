---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = "Статические испытания крана и манипулятора: ФНП 461";
const description = "Стреловой кран испытывают в положении наименьшей устойчивости, манипулятор — наибольшей грузоподъёмности; груз 50–100 мм, 10 минут (пп. 175–176 ФНП №461).";

const CHECKED = '29.10.2026';
const PUBLISHED = '2026-10-29';
const SLUG = "staticheskie-ispytaniya-strelovogo-krana-i-manipulyatora-fnp-461";
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    "q": "В каком положении испытывают стреловой автокран?",
    "a": "Стрелу устанавливают относительно ходовой части в положение, где расчётная устойчивость крана наименьшая (п. 175 ФНП №461), и поднимают груз на высоту 50–100 мм. Положение зависит от модели и берётся из руководства по эксплуатации, поэтому единой цифры вылета в норме нет."
  },
  {
    "q": "Чем испытание крана-манипулятора отличается от испытания автокрана?",
    "a": "Манипулятор испытывают на горизонтальной площадке в положении наибольшей грузоподъёмности, а при установленном сменном оборудовании — именно с ним (п. 176 ФНП №461). У стрелового крана критерий другой: положение наименьшей расчётной устойчивости (п. 175)."
  },
  {
    "q": "Сколько времени держат груз при статических испытаниях?",
    "a": "Не менее 10 минут (пп. 175, 176, 178 ФНП №461). Груз поднимают на 50–100 мм от земли. Если за 10 минут он не опустился и не обнаружено трещин, остаточных деформаций и других повреждений, результат считается положительным."
  },
  {
    "q": "Нужно ли проверять шины перед испытанием автокрана?",
    "a": "Да, если испытание проводится без выносных опор в соответствии с руководством по эксплуатации: п. 175 ФНП №461 требует проверить давление в шинах для подъёмных сооружений на автомобильном и пневмоколёсном ходу. При работе на опорах это условие неприменимо."
  },
  {
    "q": "Что делать, если после испытания обнаружена остаточная деформация?",
    "a": "Кран не допускают к работе до выяснения причины специализированной организацией и определения возможности дальнейшей эксплуатации (п. 172 ФНП №461). Результат испытания, как и решение о допуске, фиксируют в паспорте крана."
  }
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: "Статические испытания стрелового крана и манипулятора", item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [["obshchee", "Что общего: подъём на 50–100 мм и выдержка 10 минут"], ["strelovoy", "Стреловой кран (п. 175): площадка, шины и положение стрелы"], ["manipulyator", "Кран-манипулятор (п. 176): положение наибольшей грузоподъёмности"], ["tablica", "Сравнение: три типа машин и их положения при испытании"], ["zamer", "Как проверяют остаточную деформацию"], ["zakazchik", "Что спросить у арендодателя перед заказом"], ["faq", "Частые вопросы"], ["istochniki", "Источники"]];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Статические испытания стрелового крана и манипулятора</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">ФНП №461 · Испытания</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Чем отличаются статические испытания стрелового крана и крана-манипулятора по ФНП 461?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>29.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>29.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>6 мин чтения</span>
    </div>

    <p>Стреловой кран испытывают в положении стрелы, где его расчётная устойчивость наименьшая (п. 175 ФНП №461), а кран-манипулятор — в положении наибольшей грузоподъёмности на горизонтальной площадке (п. 176). Общее у них одно: груз поднимают на 50–100 мм и выдерживают не менее 10 минут. Для автокрана КС-65713-1 «Галичанин» это означает испытание в самом невыгодном для устойчивости положении, а для манипулятора на шасси — в самом нагруженном по грузоподъёмности.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="obshchee" style="margin:36px 0 16px">Что общего: подъём на 50–100 мм и выдержка 10 минут</h2>
    <p>Статические испытания стрелового крана и крана-манипулятора строятся по одной схеме: груз поднимают на высоту 50–100 мм от земли и выдерживают минимум 10 минут (пп. 175 и 176 ФНП №461). Кран выдержал испытание, если за это время груз не опустился, а в металлоконструкциях и механизмах нет трещин, остаточных деформаций и других повреждений.</p>
    <p>Величина испытательной нагрузки задана другим пунктом: статические испытания проводят грузом, превышающим паспортную грузоподъёмность на 25 %, о чём МОСКРАН-СЕРВИС писал в справке про <a href="/spravochnik/staticheskie-i-dinamicheskie-ispytaniya-avtokrana-fnp-461/" style="color:var(--yellow)">статические и динамические испытания автокрана</a>. Эта справка посвящена различиям: в каком положении стрелы и на каком основании выполняют подъём.</p>

    <h2 id="strelovoy" style="margin:36px 0 16px">Стреловой кран (п. 175): площадка, шины и положение стрелы</h2>
    <p>Для стрелового крана ФНП №461 требует подготовленную площадку с плотностью грунта и уклоном, соответствующими руководству по эксплуатации, а стрелу ставят относительно ходовой части в положение наименьшей расчётной устойчивости (п. 175). Именно поэтому испытание считается проверкой запаса устойчивости: кран нагружают там, где опрокидывающий момент максимален.</p>
    <p>Если по руководству испытание допускается без выносных опор, перед подъёмом проверяют давление в шинах колёс. Это условие относится к подъёмным сооружениям на автомобильном и пневмоколёсном ходу, то есть к автокранам. Требования к основанию описаны в справках про <a href="/spravochnik/nesushchaya-sposobnost-grunta/" style="color:var(--yellow)">несущую способность грунта</a> и <a href="/spravochnik/dopustimyy-uklon-ploshchadki-dlya-avtokrana/" style="color:var(--yellow)">допустимый уклон площадки</a>.</p>

    <h2 id="manipulyator" style="margin:36px 0 16px">Кран-манипулятор (п. 176): положение наибольшей грузоподъёмности</h2>
    <p>Кран-манипулятор или кран-трубоукладчик устанавливают на горизонтальной площадке и испытывают в положении, соответствующем наибольшей грузоподъёмности (п. 176 ФНП №461). Критерий здесь другой, чем у стрелового крана: норма смотрит на предельную нагрузку, а не на положение с наименьшей устойчивостью.</p>
    <p>Если на манипулятор установлено сменное стреловое оборудование, испытание проводят именно с ним, в положении наибольшей грузоподъёмности при установленном оборудовании. Выбор между автокраном и манипулятором под задачу разобран в справке про <a href="/spravochnik/avtokran-ili-kran-manipulyator/" style="color:var(--yellow)">автокран или кран-манипулятор</a>, а здесь важно, что паспорт и запись об испытании привязаны к конкретной комплектации.</p>

    <h2 id="tablica" style="margin:36px 0 16px">Сравнение: три типа машин и их положения при испытании</h2>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Тип машины</th><th>Площадка и основание</th><th>Положение при испытании</th><th>Пункт</th></tr></thead>
        <tbody>
          <tr><td>Кран стрелового типа (автокран)</td><td>Подготовленная площадка: плотность грунта и уклон по руководству; при испытании без опор — проверка давления в шинах</td><td>Стрела в положении наименьшей расчётной устойчивости относительно ходовой части</td><td>175</td></tr>
          <tr><td>Кран-манипулятор, кран-трубоукладчик</td><td>Горизонтальная площадка</td><td>Положение наибольшей грузоподъёмности, при установленном сменном оборудовании</td><td>176</td></tr>
          <tr><td>Подъёмник (вышка), кроме строительных</td><td>Горизонтальная площадка</td><td>Положение наименьшей расчётной устойчивости; в люльке 110 % и 40 % на гибкой подвеске</td><td>178</td></tr>
        </tbody>
      </table>
    </div>
    <p>Таблица показывает, что критерий выбора положения зависит от типа машины: у стрелового крана и подъёмника он связан с устойчивостью, у манипулятора — с предельной грузоподъёмностью. Строка про подъёмник (вышку) приведена для сравнения: автовышка испытывается по иной схеме и иной нагрузке, о выборе между краном и вышкой см. справку про <a href="/spravochnik/avtokran-ili-avtovyshka/" style="color:var(--yellow)">автокран или автовышку</a>.</p>

    <h2 id="zamer" style="margin:36px 0 16px">Как проверяют остаточную деформацию</h2>
    <p>Замеры остаточных деформаций проводят по порядку из п. 172 ФНП №461. До подъёма фиксируют положение контролируемой точки, затем поднимают груз на 50–100 мм и выдерживают 10 минут, после опускания замер повторяют. Если третье измерение совпало с первым, остаточной деформации нет. У стрелового крана положение сверяют по оголовку стрелы (п. 175).</p>
    <p>Пункт 172 написан для мостовых кранов, а пп. 175, 176 и 178 отсылают к нему только по способу замеров. Если остаточная деформация обнаружена, кран не допускают к работе до выяснения причины специализированной организацией. Результат фиксируют в паспорте, порядок записи описан в справке про <a href="/spravochnik/zapis-v-pasporte-ob-osvidetelstvovanii-avtokrana-fnp-461/" style="color:var(--yellow)">запись в паспорте об освидетельствовании</a>.</p>

    <h2 id="zakazchik" style="margin:36px 0 16px">Что спросить у арендодателя перед заказом</h2>
    <p>Заказчику автокрана или манипулятора достаточно запросить три вещи: дату последнего освидетельствования с записью об испытаниях, подтверждение, что испытание проводилось в положении, предусмотренном для этого типа машины, и данные о сменном оборудовании, если оно установлено. Это практический перечень, а не цитата нормы; МОСКРАН-СЕРВИС выдаёт копию паспорта вместе с краном.</p>
    <ol>
      <li>Найдите в паспорте запись о последнем полном освидетельствовании и дату следующего.</li>
      <li>Сверьте комплектацию крана с записью: сменная стрела или гусёк меняют положение, в котором кран испытывают.</li>
      <li>Если кран прошёл ремонт расчётных элементов, уточните, проводились ли испытания после него.</li>
    </ol>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: статические испытания стрелового крана и манипулятора</h2>
    <ul>
      <li>Стреловой кран испытывают в положении наименьшей расчётной устойчивости, манипулятор — в положении наибольшей грузоподъёмности (пп. 175, 176 ФНП №461).</li>
      <li>Груз поднимают на 50–100 мм и выдерживают не менее 10 минут; положительный результат — груз не опустился, повреждений нет.</li>
      <li>У автокранов на колёсном ходу без опор проверяют давление в шинах; площадка должна соответствовать руководству по эксплуатации.</li>
      <li>Остаточную деформацию замеряют по порядку п. 172, у стрелового крана — по оголовку стрелы.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://www.consultant.ru/document/cons_doc_LAW_373321/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 (приказ Ростехнадзора от 26.11.2020 №461)</a> — пп. 172, 175, 176, 178 (статические испытания стрелового крана, манипулятора, подъёмника; порядок замеров).</li>
      <li><a href="https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 на legalacts.ru</a> — текст пунктов сверен 29.10.2026.</li>
    </ul>
    <p class="small muted">Справка не заменяет паспорт и руководство по эксплуатации конкретного автокрана: положение стрелы при испытании и допуски задаёт изготовитель.</p>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-16-25-tonn/">Аренда автокрана 16–25 тонн →</a></section>
</main>
</SpravochnikLayout>
