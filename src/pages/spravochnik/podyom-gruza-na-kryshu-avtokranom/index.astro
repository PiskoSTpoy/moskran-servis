---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = 'Какой автокран нужен, чтобы поднять груз на крышу';
const description = 'Высота крюка = кровля + 0,5 м (п. 114 ФНП №461) + груз + стропы. Расчёт стрелы и вылета, пример на КС-55713-1К и XCMG QY25K5-I, выбор класса.';

const CHECKED = '28.09.2026';
const PUBLISHED = '2026-09-28';
const SLUG = 'podyom-gruza-na-kryshu-avtokranom';
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: 'Хватит ли 25-тонного автокрана, чтобы поднять груз на крышу пятиэтажки?',
    a: 'Зависит от вылета, а не от тоннажа. КС-55713-1К «Клинцы» со стрелой 21 м поднимает крюк до 21,6 м, но на вылете 12–13 м основной стрелы уже не хватает по геометрии. XCMG QY25K5-I того же класса 25 т имеет стрелу до 38,5 м. МОСКРАН-СЕРВИС подбирает машину по высоте кровли и расстоянию до точки опускания.',
  },
  {
    q: 'Что нужно сообщить МОСКРАН-СЕРВИС для расчёта подъёма на кровлю?',
    a: 'Нужны пять чисел: высота кровли или парапета, масса груза вместе с поддоном, высота самого груза, расстояние от места установки крана до стены и глубина точки опускания от края кровли. Добавьте фото фасада с проездом. По этим данным инженер МОСКРАН-СЕРВИС проверяет строку грузовысотной характеристики конкретного крана.',
  },
  {
    q: 'Можно ли опустить груз на кровлю, если под ней работают люди?',
    a: 'Над перекрытиями, под которыми находятся помещения с людьми, груз перемещать нельзя — это прямой запрет п. 128 ФНП №461. МОСКРАН-СЕРВИС строит траекторию так, чтобы груз шёл над пустыми зонами, или просит вывести людей из помещений верхнего этажа на время подъёма.',
  },
  {
    q: 'Почему гусёк не всегда решает задачу высоты?',
    a: 'Гусёк увеличивает высоту подъёма: у КС-55713-1К с гуськом 7,5 м крюк доходит до 29,3 м против 21,6 м на основной стреле. Грузоподъёмность на гуське при этом заметно ниже, и точную цифру даёт только таблица из паспорта машины. МОСКРАН-СЕРВИС проверяет массу груза по этой таблице до выезда.',
  },
  {
    q: 'Сколько стоит подъём материалов на крышу краном?',
    a: 'МОСКРАН-СЕРВИС считает аренду по ставке класса: смена 8 часов для крана 25 т — 20 800 ₽, для 32 т — 24 800 ₽, для 50 т — 31 200 ₽. Высота кровли на ставку не влияет, она влияет на выбор класса. Если задачу решает 25-тонный кран с длинной стрелой, переплачивать за 50 т не нужно.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Подъём груза на крышу', item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ['vysota', 'Высота крюка: из чего складывается'],
  ['vylet', 'Вылет до точки опускания на кровле'],
  ['strela', 'Длина стрелы: проверка треугольником'],
  ['primer', 'Пример: кровля 15 м, вылет 13 м'],
  ['normy', 'Кровля и ФНП №461: п. 115, 128, 112'],
  ['faq', 'Частые вопросы'],
  ['istochniki', 'Источники'],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Подъём груза на крышу</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Выбор техники · Расчёт подъёма</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Какой автокран нужен, чтобы поднять груз на крышу дома?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>28.09.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>28.09.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>6 мин чтения</span>
    </div>

    <p>Для подъёма на крышу автокран выбирают по двум числам — высоте крюка и вылету, а не по тоннажу. Высота крюка равна отметке кровли плюс 0,5 м запаса по п. 114 ФНП №461, плюс высота груза и строп. Для кровли на 15 м и вылета 13 м стрела должна быть длиннее 22 м, поэтому МОСКРАН-СЕРВИС сравнивает КС-55713-1К «Клинцы» и XCMG QY25K5-I одного класса по длине стрелы.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="vysota" style="margin:36px 0 16px">Высота крюка: из чего складывается</h2>
    <p>Высота подъёма крюка складывается из четырёх слагаемых: отметка кровли или парапета, 0,5 м над встречными предметами, высота груза и длина стропов от крюка до груза. Запас 0,5 м задаёт п. 114 ФНП №461: при горизонтальном перемещении груз ведут на 0,5 м выше предметов на пути. МОСКРАН-СЕРВИС берёт отметку не от уровня кровли, а от верха парапета, вентшахт и ограждений — груз проходит именно над ними.</p>
    <p>Стропы съедают высоту сильнее, чем ожидает заказчик: четырёхветвевой строп длиной 2 м под поддоном с кровельным материалом добавляет к расчёту почти всю свою длину. Инженер МОСКРАН-СЕРВИС поэтому спрашивает, чем будут цеплять груз, и учитывает тип стропа в заявке. Выбор стропа и угол ветвей разобраны в <a href="/spravochnik/ugol-naklona-stropa/" style="color:var(--yellow)">материале об угле наклона стропа</a>.</p>

    <h2 id="vylet" style="margin:36px 0 16px">Вылет до точки опускания на кровле</h2>
    <p>Вылет в паспорте КС-55713-1К и любого другого автокрана отсчитывают от оси вращения до точки, где груз ложится на крышу, а не до стены дома. Автокран стоит на выносных опорах, и ось поворота оказывается в нескольких метрах от фасада; к этому добавляется глубина точки опускания от края кровли. МОСКРАН-СЕРВИС просит заказчика указать место складирования на кровле, потому что каждые лишние 2–3 м вылета отнимают грузоподъёмность.</p>
    <p>Минимальное расстояние от крана до строения тоже задано нормой: по п. 108–110 ФНП №461 кран ставят на подготовленную площадку на выносных опорах и не ближе 1 м от выступающих частей здания до поворотной части. Для узкого московского двора это означает, что кран не прижать вплотную к стене, и вылет растёт. Требования к основанию под опоры МОСКРАН-СЕРВИС разбирает в <a href="/spravochnik/nesushchaya-sposobnost-grunta/" style="color:var(--yellow)">материале о несущей способности грунта</a>.</p>

    <h2 id="strela" style="margin:36px 0 16px">Длина стрелы: проверка треугольником</h2>
    <p>Первый отсев крана делается по теореме Пифагора: стрела не может быть короче гипотенузы треугольника, где один катет — нужная высота крюка, а другой — вылет. Формула грубая: пята стрелы стоит на поворотной платформе выше земли, а оголовок поднимается выше крюка на длину подвески, и эти поправки частично гасят друг друга. МОСКРАН-СЕРВИС использует треугольник только для отсева заведомо коротких машин.</p>
    <p>Окончательное решение принимается по грузовысотной характеристике из паспорта конкретного крана: в ней на каждую длину стрелы и вылет указана допустимая масса груза. Кран, который проходит по геометрии, может не пройти по массе, особенно на гуське. Как читать эту таблицу, МОСКРАН-СЕРВИС показывает в <a href="/spravochnik/gruzovysotnaya-harakteristika/" style="color:var(--yellow)">материале о грузовысотной характеристике</a>.</p>

    <h2 id="primer" style="margin:36px 0 16px">Пример: кровля 15 м, вылет 13 м</h2>
    <p>Для примера возьмём парапет на отметке 15 м, поддон высотой 1,2 м на стропах 2 м и точку опускания в 13 м от оси крана. Нужная высота крюка — 15 + 0,5 + 1,2 + 2 = 18,7 м. Гипотенуза: √(18,7² + 13²) ≈ 22,8 м. МОСКРАН-СЕРВИС сравнивает с этим числом стрелы машин своего парка по данным изготовителей.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Кран</th><th>Класс</th><th>Основная стрела</th><th>Высота крюка</th><th>Проходит 22,8 м по геометрии</th><th>Смена</th></tr></thead>
        <tbody>
          <tr><td>КС-55713-1К «Клинцы»</td><td>25 т</td><td>21 м</td><td>21,6 м; 29,3 м с гуськом 7,5 м</td><td>Только с гуськом</td><td>20 800 ₽</td></tr>
          <tr><td>XCMG QY25K5-I</td><td>25 т</td><td>10,1–38,5 м</td><td>—</td><td>Да</td><td>20 800 ₽</td></tr>
          <tr><td>КС-65713-1 «Галичанин»</td><td>50 т</td><td>11,5–34,1 м</td><td>34,5 м</td><td>Да</td><td>31 200 ₽</td></tr>
          <tr><td>Liebherr LTM 1050-3.1</td><td>50 т</td><td>11,4–38 м</td><td>54 м с гуськом</td><td>Да</td><td>31 200 ₽</td></tr>
        </tbody>
      </table>
    </div>
    <p>Главный вывод таблицы: КС-55713-1К «Клинцы» на основной стреле 21 м эту кровлю не достаёт, а XCMG QY25K5-I того же класса и за те же 20 800 ₽ за смену проходит по геометрии с запасом. Массу поддона на вылете 13 м при стреле около 23 м МОСКРАН-СЕРВИС затем сверяет по таблице XCMG; если масса не проходит, следующий кандидат — класс 50 т.</p>

    <h2 id="normy" style="margin:36px 0 16px">Кровля и ФНП №461: п. 115, 128, 112</h2>
    <p>Пункт 128 ФНП №461 запрещает перемещать груз над перекрытиями, под которыми находятся производственные, жилые или служебные помещения с людьми. Для подачи на крышу жилого дома траектория груза должна идти над пустыми зонами, либо людей выводят из помещений верхнего этажа на время подъёма. МОСКРАН-СЕРВИС согласует это с заказчиком до выезда, подробнее — в <a href="/spravochnik/peremeshchenie-gruza-nad-lyudmi/" style="color:var(--yellow)">материале о грузе над людьми</a>.</p>
    <p>Пункт 115 ФНП №461 запрещает подавать груз в оконные проёмы и на балконы без приёмных площадок, поэтому «поднять на крышу» и «подать на балкон верхнего этажа» — разные задачи. Над двором часто проходят провода: ближе 30 м от линии электропередачи напряжением выше 50 В кран работает только по наряду-допуску (п. 112). МОСКРАН-СЕРВИС уточняет наличие проводов по фото фасада, порядок разобран в <a href="/spravochnik/rabota-krana-ryadom-s-lep/" style="color:var(--yellow)">материале о работе крана у ЛЭП</a>.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: как МОСКРАН-СЕРВИС подбирает кран под кровлю</h2>
    <ul>
      <li>Высота крюка = парапет + 0,5 м (п. 114) + груз + стропы.</li>
      <li>Вылет — до точки опускания на кровле, а не до стены.</li>
      <li>Стрела не короче √(высота² + вылет²) — это отсев, не решение.</li>
      <li>Решает грузовысотная характеристика конкретной машины.</li>
      <li>XCMG QY25K5-I со стрелой 38,5 м часто заменяет 50-тонный кран по цене класса 25 т.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://sudact.ru/law/prikaz-rostekhnadzora-ot-26112020-n-461-ob/federalnye-normy-i-pravila-v/vi/ustanovka-ps-i-proizvodstvo-rabot/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461, раздел VI «Установка ПС и производство работ» (ред. от 16.04.2026)</a> — п. 108–110, 112, 114, 115, 128.</li>
      <li><a href="https://www.avtocrane.by/katalog-produkcii/avtokrany-klincy/25-tonn/ks-55713-1k-klincy" target="_blank" rel="noopener" style="color:var(--yellow)">КС-55713-1К «Клинцы» — карточка дилера завода</a> — стрела 21 м, гусёк 7,5 м, высота подъёма 21,6 / 29,3 м.</li>
      <li><a href="https://kran-master74.ru/heavy/truck_cranes/galichanin/avtokran_galichanin_ks_65713_1_50_t/" target="_blank" rel="noopener" style="color:var(--yellow)">КС-65713-1 «Галичанин» — характеристики</a> — стрела 11,5–34,1 м, высота 34,5 м.</li>
      <li><a href="https://www.liebherr.com/en-us/p/ltm105031-4407335" target="_blank" rel="noopener" style="color:var(--yellow)">Liebherr LTM 1050-3.1 — страница производителя</a> — стрела 11,4–38 м, высота подъёма 54 м.</li>
      <li>XCMG QY25K5-I — стрела 10,1–38,5 м по карточке официального дилера (сверено 27.09.2026 для <a href="/spravochnik/klintsy-ili-xcmg-25-tonn/" style="color:var(--yellow)">сравнения «Клинцы» и XCMG</a>).</li>
    </ul>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-16-25-tonn/">Подробнее об аренде автокрана 16–25 тонн →</a></section>
</main>
</SpravochnikLayout>
