---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = "Статические и динамические испытания автокрана: 125 и 110 %";
const description = "При освидетельствовании автокран нагружают на 125 % паспортной грузоподъёмности (статика) и на 110 % (динамика, не менее трёх циклов) — пп. 171, 179 ФНП №461.";

