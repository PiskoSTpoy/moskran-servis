  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [["staticheskie", "Статические испытания: зачем и с какой нагрузкой"], ["dinamicheskie", "Динамические испытания: что проверяют грузом +10 %"], ["sravnenie", "Статика и динамика рядом: сравнительная таблица"], ["podgotovka", "Что должно быть готово до испытаний"], ["rezultat", "Как фиксируется результат и что значит отрицательный"], ["zakazchik", "Что это значит для заказчика, который арендует автокран"], ["faq", "Частые вопросы"], ["istochniki", "Источники"]];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Статические и динамические испытания автокрана</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">ФНП №461 · Освидетельствование</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Чем статические испытания автокрана отличаются от динамических?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>28.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>28.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>7 мин чтения</span>
    </div>

    <p>Статические испытания автокрана проводят грузом в 125 % паспортной грузоподъёмности и проверяют ими прочность конструкции, а динамические — грузом в 110 %, не менее трёх циклов подъёма и опускания, и проверяют ими механизмы и тормоза (пп. 171, 179 ФНП №461). МОСКРАН-СЕРВИС выпускает на линию только те краны, у которых результат обоих испытаний записан в паспорт, а срок следующего освидетельствования не истёк.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="staticheskie" style="margin:36px 0 16px">Статические испытания: зачем и с какой нагрузкой</h2>
    <p>Статические испытания по п. 171 ФНП №461 проверяют конструктивную пригодность подъёмного сооружения и его сборочных единиц, поэтому груз для них самый тяжёлый: 125 % номинальной паспортной грузоподъёмности для подъёмных сооружений всех типов, кроме подъёмников. Для кранов-трубоукладчиков норма — 140 %, для подъёмников (вышек) — от 150 до 200 %, но стреловой автокран КС-55713 «Клинцы» или КС-65713-1 «Галичанин» испытывают по базовой цифре 125 %.</p>
    <p>Положение крана выбирают так, чтобы усилия в канатах, изгибающие моменты и осевые усилия в основных элементах были наибольшими. У стрелового крана с несколькими грузовыми характеристиками это положение наибольшей грузоподъёмности или наибольшего грузового момента, если руководство по эксплуатации не запрещает (п. 174). Кран со сменным стреловым оборудованием испытывают с установленной стрелой, а после замены стрелового оборудования испытания проводят заново.</p>
    <p>Перед нагружением тормоза всех механизмов регулируют согласно руководству на тормозной момент из паспорта, а ограничитель грузоподъёмности отключают (п. 171). Масса контрольных грузов не должна отличаться от необходимой более чем на 3 %.</p>
    <p>Пример (арифметика, не из нормы): при паспортной грузоподъёмности 25 т статическая нагрузка составляет 31,25 т, а допуск на массу контрольных грузов — около 0,94 т (3 % от 31,25 т). Реальную цифру для конкретной машины определяет её паспорт.</p>

    <h2 id="dinamicheskie" style="margin:36px 0 16px">Динамические испытания: что проверяют грузом +10 %</h2>
    <p>Динамические испытания по п. 179 ФНП №461 проводят грузом, масса которого на 10 % превышает паспортную грузоподъёмность, и проверяют ими действие механизмов и тормозов. Прочность конструкции здесь не оценивают: её уже подтвердила статика с запасом 125 %. Поэтому нагрузка меньше, а движений больше.</p>
    <p>Норма требует многократных подъёмов и опусканий груза — не менее трёх раз — и проверки всех других механизмов при совмещении рабочих движений, которые предусмотрены руководством по эксплуатации. Для автокрана это подъём груза с одновременным поворотом платформы и изменением вылета, если такое совмещение разрешено руководством. МОСКРАН-СЕРВИС следит, чтобы совмещённые движения проверяли именно в тех сочетаниях, которые указаны в руководстве конкретной машины.</p>
    <p>Если у крана два и более механизма подъёма и их работа предусмотрена раздельной (основная и вспомогательная лебёдки), статические и динамические испытания проводят отдельно для каждого механизма (п. 180).</p>

    <h2 id="sravnenie" style="margin:36px 0 16px">Статика и динамика рядом: сравнительная таблица</h2>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Параметр</th><th>Статические (п. 171)</th><th>Динамические (п. 179)</th></tr></thead>
        <tbody>
          <tr><td>Цель</td><td>Конструктивная пригодность крана и его сборочных единиц</td><td>Действие механизмов и тормозов</td></tr>
          <tr><td>Нагрузка от паспортной</td><td>125 % (автокран)</td><td>110 %</td></tr>
          <tr><td>Допуск на массу груза</td><td>Не более 3 % от необходимой массы</td><td>В норме не указан — масса определяется «на 10 % выше паспортной»</td></tr>
          <tr><td>Ограничитель грузоподъёмности</td><td>Отключён на время испытаний</td><td>Норма об отключении не говорит</td></tr>
          <tr><td>Что делают с грузом</td><td>Поднимают и выдерживают в положении наибольших усилий</td><td>Не менее трёх подъёмов и опусканий, совмещение движений</td></tr>
        </tbody>
      </table>
    </div>
    <p>Таблица показывает, что два вида испытаний не заменяют друг друга: статика отвечает за запас прочности, динамика за работу механизмов в движении. Графа про ограничитель заполнена по тексту пп. 171 и 179: норма отключение называет только для статики, а как действовать при динамике, в ней не сказано, и это решается руководством по эксплуатации.</p>

    <h2 id="podgotovka" style="margin:36px 0 16px">Что должно быть готово до испытаний</h2>
    <p>Для испытаний нужен комплект контрольных грузов с указанной фактической массой, и обеспечивает его эксплуатирующая организация (п. 183 ФНП №461). Если кран испытывают после ремонта или реконструкции на территории специализированной организации, грузы предоставляет она. Заказчику, который арендует автокран у МОСКРАН-СЕРВИС с экипажем, этот комплект не нужен, но срок действия предыдущего освидетельствования он вправе проверить по табличке и паспорту.</p>
    <p>Перед испытаниями кран осматривают, а механизмы, тормоза, гидро- и электрооборудование, указатели, ограничители и регистраторы проверяют в работе (п. 170). Дополнительно проверяют металлоконструкции и сварные соединения, крюк и блоки, фактическое расстояние между крюковой подвеской и упором при срабатывании концевого выключателя, массу противовеса и балласта по паспорту, крепление осей и пальцев, состояние канатов (п. 170, подпункты «а»–«з»).</p>

    <h2 id="rezultat" style="margin:36px 0 16px">Как фиксируется результат и что значит отрицательный</h2>
    <p>Результат освидетельствования записывает в паспорт инженерно-технический работник, ответственный за производственный контроль, с указанием срока следующего освидетельствования (п. 189 ФНП №461). Запись подтверждает три вещи: кран отвечает требованиям ФНП, находится в работоспособном состоянии и выдержал испытания. Разрешение на дальнейшую работу выдаёт тот же работник, также записью в паспорте.</p>
    <p>Отрицательный результат оформляют актом, в котором перечислены несоответствия документации и ФНП, превышения нормативных значений и признаки неработоспособности (п. 190). Пока замечания не устранены, эксплуатирующая организация не допускает кран в работу: отсутствие освидетельствования входит в список запретов п. 251. Подробнее о записи — в справке про <a href="/spravochnik/zapis-v-pasporte-ob-osvidetelstvovanii-avtokrana-fnp-461/" style="color:var(--yellow)">запись в паспорте об освидетельствовании</a>.</p>

    <h2 id="zakazchik" style="margin:36px 0 16px">Что это значит для заказчика, который арендует автокран</h2>
    <p>Заказчику аренды достаточно убедиться, что освидетельствование крана не просрочено, и самих испытаний на его площадке не будет. Проверка занимает минуты: на табличке и в паспорте видны даты последнего и следующего освидетельствования (см. справку про <a href="/spravochnik/tablichki-na-avtokrane-fnp-461/" style="color:var(--yellow)">таблички на автокране</a>). Это практический порядок, опирающийся на пп. 121 и 165 ФНП №461, а не отдельная норма.</p>
    <ol>
      <li>Запросите копию паспорта крана и найдите запись о последнем освидетельствовании.</li>
      <li>Сверьте дату следующего освидетельствования с датой работ.</li>
      <li>Если вы заказывали кран после замены стрелы или лебёдки, спросите, проведено ли внеочередное освидетельствование (<a href="/spravochnik/vneocherednoe-osvidetelstvovanie-avtokrana-fnp-461/" style="color:var(--yellow)">справка про внеочередное освидетельствование</a>).</li>
      <li>Для проверки устойчивости крана на опорах смотрите отдельную справку про <a href="/spravochnik/ispytaniya-avtokrana-na-gruzovuyu-ustoychivost-fnp-461/" style="color:var(--yellow)">испытания на грузовую устойчивость</a>.</li>
    </ol>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: испытания автокрана</h2>
    <ul>
      <li>Статика — 125 % паспортной грузоподъёмности, проверка конструкции; ограничитель грузоподъёмности отключён (п. 171 ФНП №461).</li>
      <li>Динамика — 110 %, не менее трёх циклов подъёма и опускания, проверка механизмов и тормозов (п. 179).</li>
      <li>Контрольные грузы обеспечивает эксплуатирующая организация, допуск на их массу — 3 % (пп. 171, 183).</li>
      <li>Результат записывают в паспорт; отрицательный оформляют актом (пп. 189–190).</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://www.consultant.ru/document/cons_doc_LAW_373321/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 (приказ Ростехнадзора от 26.11.2020 №461)</a> — пп. 170, 171, 174, 179, 180, 183, 189, 190, 251.</li>
      <li><a href="https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 на legalacts.ru</a> — текст пунктов сверен 28.10.2026.</li>
    </ul>
    <p class="small muted">Справка не заменяет паспорт и руководство по эксплуатации конкретного автокрана: порядок и положения при испытаниях задаёт изготовитель.</p>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-25-40-tonn/">Аренда автокрана 25–40 тонн →</a></section>
</main>
</SpravochnikLayout>
