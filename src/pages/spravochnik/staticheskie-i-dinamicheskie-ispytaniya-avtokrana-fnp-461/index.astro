const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    "q": "На сколько процентов перегружают автокран при статических испытаниях?",
    "a": "Статические испытания автокрана проводят с нагрузкой 125 % от номинальной паспортной грузоподъёмности (п. 171 ФНП №461). Для кранов-трубоукладчиков норма выше — 140 %, для подъёмников и вышек — 150–200 %, но к стреловому автокрану эти значения не относятся. Масса контрольных грузов не должна отличаться от нужной более чем на 3 %."
  },
  {
    "q": "Какой груз берут для динамических испытаний автокрана?",
    "a": "Груз, масса которого на 10 % выше паспортной грузоподъёмности (п. 179 ФНП №461). Им выполняют подъём и опускание не менее трёх раз и проверяют действие других механизмов при совмещении рабочих движений, которые предусмотрены руководством по эксплуатации. Цель динамики — проверить механизмы и тормоза, а не прочность конструкции."
  },
  {
    "q": "Почему при статических испытаниях ограничитель грузоподъёмности отключают?",
    "a": "Пункт 171 ФНП №461 прямо требует отключить ограничитель грузоподъёмности до статических испытаний: иначе прибор остановил бы подъём ещё до достижения 125 %. Тормоза при этом отрегулированы на момент, указанный в паспорте. После испытаний работоспособность ограничителя проверяют отдельно, по пп. 259–269 ФНП."
  },
  {
    "q": "Кто обеспечивает контрольные грузы для испытаний автокрана?",
    "a": "Контрольные грузы с указанием фактической массы обеспечивает эксплуатирующая организация (п. 183 ФНП №461). Если испытания проходят после ремонта или реконструкции на территории специализированной организации, грузы предоставляет она. Заказчик, арендующий автокран с экипажем, этого комплекта не готовит."
  },
  {
    "q": "Где фиксируется результат испытаний и что делать при отрицательном результате?",
    "a": "Результат освидетельствования записывает в паспорт инженерно-технический работник, ответственный за производственный контроль, с указанием срока следующего освидетельствования (п. 189 ФНП №461). Отрицательный результат оформляется актом с перечнем несоответствий (п. 190). До устранения замечаний кран к работе не допускают."
  }
];

