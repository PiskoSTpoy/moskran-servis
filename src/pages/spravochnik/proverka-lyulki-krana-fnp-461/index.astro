---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = "Проверка люльки для подъёма людей: пп. 242–247 ФНП 461";
const description = "Люльку проверяют ежесменно, ежемесячно и испытывают раз в 6 месяцев грузом вдвое больше грузоподъёмности на 10 минут (пп. 243–247 ФНП №461).";

const CHECKED = '19.10.2026';
const PUBLISHED = '2026-10-19';
const SLUG = "proverka-lyulki-krana-fnp-461";
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: "Как часто проверять люльку для подъёма людей?",
    a: "Осмотр — каждую смену, плановая проверка — не реже раза в месяц, грузовые испытания — не реже раза в 6 месяцев (пп. 244–246 ФНП №461). МОСКРАН-СЕРВИС сверяет записи в паспорте перед подъёмом.",
  },
  {
    q: "Кто проводит ежесменный осмотр люльки?",
    a: "Инженерно-технический работник, ответственный за безопасное производство работ с применением ПС (п. 244 ФНП №461). МОСКРАН-СЕРВИС просит заказчика назвать его до начала работ.",
  },
  {
    q: "Какой груз берут для испытания люльки?",
    a: "Груз на дне люльки вдвое тяжелее её грузоподъёмности, с удержанием 10 минут (п. 246 ФНП №461). Для люльки на 300 кг это 600 кг — условный пример арифметики.",
  },
  {
    q: "Когда нужна внеплановая проверка люльки?",
    a: "Если люлька стояла на консервации и не эксплуатировалась более 6 месяцев (п. 243 ФНП №461); дополнительно проводят грузовые испытания (п. 245). МОСКРАН-СЕРВИС такую люльку без испытаний не принимает.",
  },
  {
    q: "Куда записывают результаты проверок люльки?",
    a: "Внеплановые проверки и грузовые испытания — в паспорт люльки, плановые проверки и ежесменные осмотры — в журнал осмотра (п. 247 ФНП №461).",
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: "Проверка люльки крана по ФНП №461", item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ["vidy", "Четыре вида проверки по п. 243"],
  ["smena", "Ежесменный осмотр по п. 244"],
  ["plan", "Плановая и внеплановая проверка по п. 245"],
  ["ispytaniya", "Грузовые испытания по п. 246"],
  ["zhurnal", "Паспорт и журнал по п. 247"],
  ["praktika", "Что просит МОСКРАН-СЕРВИС до подъёма людей"],
  ["faq", "Частые вопросы"],
  ["istochniki", "Источники"],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Проверка люльки крана по ФНП №461</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">ФНП №461 · Люлька для подъёма людей</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Как часто проверять люльку для подъёма людей краном и кто это делает?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>19.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>19.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>5 мин чтения</span>
    </div>

    <p>П. 243 ФНП №461 делит проверку люльки (кабины) на четыре вида: ежесменный осмотр, плановую проверку, внеплановую проверку и грузовые испытания. Плановую проверку проводят не реже раза в месяц, испытания — не реже раза в 6 месяцев. МОСКРАН-СЕРВИС не поднимает людей краном без паспорта люльки с записями этих проверок.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="vidy" style="margin:36px 0 16px">Четыре вида проверки по п. 243</h2>
    <p>Люльку (кабину), находящуюся в эксплуатации, подвергают периодической проверке, техническому обслуживанию и при необходимости ремонту (п. 242 ФНП №461). Проверка состояния по п. 243 включает ежесменный осмотр, плановую проверку, внеплановую проверку после консервации дольше 6 месяцев и грузовые испытания. Каждый вид имеет своего исполнителя и свою периодичность. МОСКРАН-СЕРВИС раскладывает их в таблицу и держит её вместе с паспортом люльки.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Вид проверки</th><th>Периодичность</th><th>Кто проводит</th><th>Куда записывают</th></tr></thead>
        <tbody>
          <tr><td>Ежесменный осмотр (п. 244)</td><td>каждую смену</td><td>ИТР, ответственный за безопасное производство работ с ПС</td><td>журнал осмотра (п. 247)</td></tr>
          <tr><td>Плановая проверка (п. 245)</td><td>не реже раза в месяц</td><td>под руководством ИТР, ответственного за содержание ПС в работоспособном состоянии</td><td>журнал осмотра (п. 247)</td></tr>
          <tr><td>Внеплановая проверка (пп. 243, 245)</td><td>после консервации более 6 месяцев; плюс грузовые испытания</td><td>под руководством ИТР, ответственного за содержание ПС</td><td>паспорт люльки (п. 247)</td></tr>
          <tr><td>Грузовые испытания (п. 246)</td><td>не реже раза в 6 месяцев</td><td>с ИТР за содержание ПС, под руководством специалиста по производственному контролю</td><td>паспорт люльки (п. 247)</td></tr>
        </tbody>
      </table>
    </div>


    <h2 id="smena" style="margin:36px 0 16px">Ежесменный осмотр по п. 244</h2>
    <p>Ежесменный осмотр люльки (кабины) осуществляет инженерно-технический работник, ответственный за безопасное производство работ с применением ПС (п. 244 ФНП №461). Не крановщик и не стропальщик, а назначенный ИТР. Это тот же человек, который по п. 241 «б» руководит подъёмом людей. МОСКРАН-СЕРВИС записывает его фамилию в заявку на автокран КС-55713 «Клинцы».</p>


    <h2 id="plan" style="margin:36px 0 16px">Плановая и внеплановая проверка по п. 245</h2>
    <p>Плановую проверку проводят не реже одного раза в месяц под руководством ИТР, ответственного за содержание ПС в работоспособном состоянии (п. 245 ФНП №461). В неё входят осмотр металлоконструкций и точек крепления предохранительных поясов и самоспасателей с высоты для выявления деформаций и трещин, проверка стропов подвеса в сборе с канат-оттяжками, проверка лакокрасочного покрытия и маркировки на табличке. МОСКРАН-СЕРВИС сверяет табличку люльки с паспортом.</p>
    <p>При внеплановой проверке к этому перечню добавляют грузовые испытания (п. 245). Внеплановая проверка нужна, если люлька находилась на консервации более 6 месяцев (п. 243). Люлька, которую достали со склада после зимы, этот порог легко превысит. МОСКРАН-СЕРВИС спрашивает дату последней эксплуатации.</p>


    <h2 id="ispytaniya" style="margin:36px 0 16px">Грузовые испытания по п. 246</h2>
    <p>Грузовые испытания люльки проводят не реже одного раза в 6 месяцев при участии ИТР, ответственного за содержание ПС, под руководством специалиста, ответственного за производственный контроль (п. 246 ФНП №461). Испытание — подъём и удержание в течение 10 минут груза на дне люльки, масса которого в два раза превышает её грузоподъёмность. МОСКРАН-СЕРВИС для люльки с паспортной грузоподъёмностью 300 кг (условное число) ждал бы груз 600 кг.</p>
    <p>Если выявлены дефекты, повреждения или отклонения от проектной документации люльки, её дальнейшая эксплуатация запрещается (п. 246). Нагрузка вдвое выше паспортной отличается от коэффициента 1,25 для съёмных грузозахватных приспособлений, описанного в справке о <a href="/spravochnik/staticheskoe-ispytanie-gruzozahvatnyh-prisposoblenij-fnp-461/" style="color:var(--yellow)">статическом испытании строп</a>. МОСКРАН-СЕРВИС не переносит один коэффициент на другой.</p>


    <h2 id="zhurnal" style="margin:36px 0 16px">Паспорт и журнал по п. 247</h2>
    <p>Результаты внеплановых проверок и грузовых испытаний заносят в паспорт люльки (кабины), а результаты плановых проверок и ежесменных осмотров — в журнал осмотра люльки (п. 247 ФНП №461). Для заказчика это два документа, которые можно запросить до подъёма людей. Требования к стропам подвеса и условия подъёма (ветер выше 10 м/с, связь, ИТР) разобраны в материале о <a href="/spravochnik/lyulka-dlya-podema-lyudey-krana-stropy-i-usloviya-fnp-461/" style="color:var(--yellow)">люльке для подъёма людей</a>. МОСКРАН-СЕРВИС читает записи, а не просто просит «бумагу».</p>


    <h2 id="praktika" style="margin:36px 0 16px">Что просит МОСКРАН-СЕРВИС до подъёма людей</h2>
    <p>Практика МОСКРАН-СЕРВИС, а не отдельная норма: до подачи автокрана КС-55713 «Клинцы» под люльку заказчик присылает паспорт люльки с датой последних грузовых испытаний и журнал осмотра. Если с испытаний прошло более 6 месяцев (п. 246), подъём людей откладывается до повторного испытания. Такой порядок обходится дешевле простоя крана на московской площадке.</p>


    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: проверка люльки для подъёма людей</h2>
    <ul>
      <li>МОСКРАН-СЕРВИС различает четыре вида проверки люльки: осмотр, плановая, внеплановая и грузовые испытания (п. 243 ФНП №461).</li>
      <li>Осмотр — каждую смену силами ИТР, ответственного за безопасное производство работ (п. 244).</li>
      <li>Плановая проверка — не реже раза в месяц, испытания — не реже раза в 6 месяцев грузом вдвое больше грузоподъёмности на 10 минут (пп. 245–246).</li>
      <li>Испытания и внеплановые проверки пишут в паспорт, осмотры и плановые проверки — в журнал (п. 247).</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://www.consultant.ru/document/cons_doc_LAW_373321/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 (приказ Ростехнадзора от 26.11.2020 №461)</a> — пп. 241–247 (подъём людей в люльке, виды проверки, периодичность, грузовые испытания, паспорт и журнал).</li>
      <li><a href="https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 на legalacts.ru</a> — редакция от 16.04.2026, текст пунктов 241–247 сверен 19.10.2026.</li>
    </ul>
    <p class="small muted">Пример с люлькой 300 кг — арифметическая иллюстрация, а не данные конкретной люльки; практика МОСКРАН-СЕРВИС описана отдельно от норм.</p>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-16-25-tonn/">Аренда автокрана 16–25 тонн →</a></section>
</main>
</SpravochnikLayout>
