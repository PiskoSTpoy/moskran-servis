---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';
import Sources from '../../../components/Sources.astro';

const title = 'Как часто крановщик проходит проверку знаний';
const description = 'Периодическая проверка знаний машиниста крана проводится не реже раза в 12 месяцев — отдельно от первичной аттестации. Что это значит для заказчика.';

const CHECKED = '12.08.2026';

const faqs = [
  { q: 'Ежегодная проверка знаний — это то же самое, что первичная аттестация?', a: 'Нет, это разные этапы. Первичная аттестация (о которой мы писали в отдельной статье) — экзамен с участием инспектора Ростехнадзора при получении удостоверения. Ежегодная проверка знаний — периодическое подтверждение квалификации уже аттестованного крановщика, проводится комиссией на предприятии.' },
  { q: 'Кто входит в комиссию, которая проводит ежегодную проверку?', a: 'На предприятиях, эксплуатирующих грузоподъёмную технику, создаётся квалификационная комиссия, в которую обычно входят главный инженер, главный механик, руководитель профильного подразделения и ответственный за безопасность.' },
  { q: 'Что если крановщик не прошёл ежегодную проверку вовремя?', a: 'Без отметки о пройденной проверке в удостоверении оператор не допускается к дальнейшей работе на технике — это не формальность, а условие законной эксплуатации крана с данным оператором.' },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Ежегодная проверка знаний', item: 'https://moskran-servis.ru/spravochnik/ezhegodnaya-proverka-znaniy/' },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@id': 'https://moskran-servis.ru/#organization' }, // ссылка на единственный узел организации (BaseLayout): отдельный узел с тем же @id, но другим name, был противоречием в графе
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: 'https://moskran-servis.ru/spravochnik/ezhegodnaya-proverka-znaniy/',
  inLanguage: 'ru-RU',
  datePublished: '2026-08-12',
  dateModified: '2026-08-12',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<SpravochnikLayout title={title} description={description} path="/spravochnik/ezhegodnaya-proverka-znaniy/" slug="ezhegodnaya-proverka-znaniy" ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Ежегодная проверка знаний</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Разбор для заказчика</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Ежегодная проверка знаний крановщика — как часто и зачем</h1>
    <p class="ref-byline">Инженерная служба МОСКРАН-СЕРВИС · обновлено в 2026 году</p>

    <p>В статье про аттестацию крановщика мы упоминали, что удостоверение подтверждается периодически, а не выдаётся один раз на всю карьеру. Здесь разбираем эту периодичность конкретнее.</p>

    <h2 style="margin:36px 0 16px">Как часто проводится проверка</h2>
    <p>Периодическая проверка знаний машиниста крана проводится не реже одного раза в 12 месяцев. Это применимо к операторам грузоподъёмной техники в целом, включая автокраны и башенные краны, о которых мы пишем на этом сайте.</p>

    <h2 style="margin:36px 0 16px">Чем это отличается от первичной аттестации</h2>
    <p>Первичная аттестация (о которой мы писали в отдельной статье) — это итоговый экзамен с участием инспектора Ростехнадзора, который крановщик проходит при получении удостоверения. Ежегодная проверка знаний — периодическое подтверждение уже имеющейся квалификации, проводится комиссией непосредственно на предприятии, без обязательного участия внешнего инспектора в каждом случае.</p>

    <h2 style="margin:36px 0 16px">Кто проводит проверку</h2>
    <p>На предприятиях, эксплуатирующих грузоподъёмную технику, создаётся квалификационная комиссия — в неё, как правило, входят главный инженер, главный механик, руководитель профильного подразделения и ответственный за безопасность. После успешного прохождения проверки в удостоверении оператора делается отметка, и он допускается к работе на следующий период.</p>

    <h2 style="margin:36px 0 16px">Почему периодичность зависит от типа техники</h2>
    <p>Важно понимать: не существует единого универсального правила «раз в год для абсолютно всех» — периодичность зависит от типа техники, где она применяется, и на какие работы допущен сотрудник. Годовой цикл — устоявшийся ориентир для большинства случаев, но конкретные требования стоит уточнять применительно к классу техники и специфике объекта.</p>

    <h2 style="margin:36px 0 16px">Что именно проверяет заказчик</h2>
    <p>Заказчику не нужно разбираться во внутренней кухне комиссий. Практически проверяются две вещи, и обе — на одном документе. Первая: документ о квалификации оператора существует и относится к тому человеку, который приехал на объект, а не к «бригаде вообще». Вторая: отметка о последней проверке знаний свежая, а не двухлетней давности. Это тот же принцип, что и с машиной: у крана смотрят запись об освидетельствовании в паспорте, у оператора — отметку в удостоверении.</p>
    <p>На объекте с контрольно-пропускным режимом эти документы спрашивают на КПП, и отсутствие отметки означает не спор о трактовке нормы, а разворот машины на въезде. Поэтому мы просим уточнять требования объекта заранее: <a href="/documents/propusk-na-obekt/" style="color:var(--yellow)">что подают на пропуск</a> — отдельная страница.</p>

    <h2 style="margin:36px 0 16px">Почему это не формальность именно для крановых работ</h2>
    <p>Оператор подъёмного сооружения принимает решения, которые нельзя отыграть назад: остановить подъём при расхождении фактического веса с заявленным, отказаться работать на неподготовленной площадке, потребовать наряд-допуск при близости воздушной линии. Ни одно из этих решений не проверяется автоматикой — ограничитель грузоподъёмности сработает по перегрузу, но он не знает, что кран стоит на свеженасыпанном грунте или что в тридцати метрах провода. Периодическая проверка знаний — единственный регулярный механизм, который поддерживает эти решения в актуальном состоянии.</p>
    <p>Второй аргумент — сменяемость норм. За последние годы изменились и федеральные нормы по подъёмным сооружениям, и правила по охране труда при погрузочно-разгрузочных работах: ПОТ РМ-007-98 прекратили действие, действует приказ Минтруда России №753н. Оператор, аттестованный по старому набору документов и ни разу не проходивший проверку с тех пор, формально имеет удостоверение, а фактически знает отменённые правила.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: что запомнить</h2>
    <ul>
      <li>Периодическая проверка знаний крановщика — не реже раза в 12 месяцев.</li>
      <li>Отличается от первичной аттестации — проводится комиссией на предприятии, не обязательно с участием инспектора Ростехнадзора.</li>
      <li>Без отметки о пройденной проверке оператор не допускается к дальнейшей работе.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <Sources
      checked={CHECKED}
      items={[
        { text: 'Приказ Ростехнадзора от 26.11.2020 №461 (ред. от 16.04.2026) — требования к персоналу, обслуживающему подъёмные сооружения, и обязанности эксплуатирующей организации', href: 'https://www.consultant.ru/document/cons_doc_LAW_373321/' },
        { text: 'Приказ Минтруда России от 28.10.2020 №753н (ред. от 29.04.2025) — действующие правила по охране труда при погрузочно-разгрузочных работах, заменившие ПОТ РМ-007-98', href: 'https://normativ.kontur.ru/document?moduleId=1&documentId=501427' },
      ]}
      note="Годовой цикл проверки знаний — устоявшаяся практика эксплуатирующих организаций; конкретная периодичность и состав комиссии устанавливаются внутренними документами организации, поэтому единой цифры «для всех» мы не приводим."
    />

  </article>
  <section class="section wrap"><a class="btn" href="/spravochnik/attestaciya-kranovshchika/">Требования к первичной аттестации →</a></section>
</main>
</SpravochnikLayout>
