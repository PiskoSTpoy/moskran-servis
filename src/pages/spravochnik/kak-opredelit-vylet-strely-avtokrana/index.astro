---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = 'Как определить вылет автокрана до места установки груза';
const description = 'Вылет считают от оси вращения крана, а не от опор: ось на 4 м от стены и груз на 6 м вглубь дают 10 м. Пример с КС-55732 (90 т·м) и порядок замера.';

const CHECKED = '07.10.2026';
const PUBLISHED = '2026-10-07';
const SLUG = 'kak-opredelit-vylet-strely-avtokrana';
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: 'От чего считать вылет автокрана — от опор или от оси вращения?',
    a: 'Вылет считают по плану от оси вращения поворотной части до вертикали крюка с грузом. Края опор для этого не годятся: ось не лежит на балках. МОСКРАН-СЕРВИС берёт положение оси из паспорта или чертежа машины и откладывает расстояние от неё.',
  },
  {
    q: 'Как посчитать вылет, если груз ставят не напротив крана?',
    a: 'Нужны два размера по плану: расстояние от оси вращения до стены и смещение вдоль стены. Вылет — гипотенуза: корень из суммы квадратов. Например, 9 м по нормали и 6 м вдоль дают около 10,8 м. МОСКРАН-СЕРВИС просит заказчика приложить такой эскиз к заявке.',
  },
  {
    q: 'Можно ли оценить допустимую массу делением момента на вылет?',
    a: 'Оценить можно, но только как верхнюю границу: для КС-55732 (90 т·м) на 10,8 м получается около 8,3 т. Реальная цифра в таблице паспорта ниже, потому что на неё влияют длина стрелы, прочность и устойчивость. МОСКРАН-СЕРВИС использует деление только для предварительного отбора.',
  },
  {
    q: 'Что делать, если вылет больше, чем у выбранного крана?',
    a: 'Варианты три: переставить машину ближе, взять кран большей грузоподъёмности или поднимать груз в два приёма. Перестановка зависит от площадки, остальное — от бюджета. МОСКРАН-СЕРВИС предлагает сначала проверить площадку, потому что смена 25 т стоит 20 800 ₽, а 50 т — 31 200 ₽.',
  },
  {
    q: 'Кто должен предоставить размеры площадки?',
    a: 'Размеры даёт заказчик: расстояние до стены или котлована, высоту и точку установки груза. МОСКРАН-СЕРВИС сверяет эти числа с контуром опор выбранной модели и таблицей грузовой характеристики и может скорректировать подбор до выезда.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Как определить вылет автокрана', item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ['opredelenie', 'От какой точки считают вылет'],
  ['zamer', 'Как замерить на площадке'],
  ['primer', 'Пример расчёта для КС-55732'],
  ['oshibki', 'Типичные ошибки замера'],
  ['zayavka', 'Что передать при заказе'],
  ['faq', 'Частые вопросы'],
  ['istochniki', 'Источники'],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Как определить вылет автокрана</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Практика · Подбор крана по вылету</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Как определить вылет автокрана до места установки груза?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>07.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>07.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>5 мин чтения</span>
    </div>

    <p>Вылет автокрана — это расстояние по плану от оси вращения поворотной части до вертикали, на которой висит груз; если ось стоит в 4 м от стены, а груз надо поставить на 5 м вглубь, вылет равен 9 м. МОСКРАН-СЕРВИС считает вылет до выезда, потому что допустимая масса падает с его ростом. Ниже — порядок замера и пример для КС-55732 с моментом 90 т·м.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="opredelenie" style="margin:36px 0 16px">От какой точки считают вылет</h2>
    <p>Для расчёта вылета МОСКРАН-СЕРВИС берёт одну точку — ось вращения поворотной части крана, а не край опорной балки и не борт шасси. Положение оси относительно опор у автокранов разное, поэтому МОСКРАН-СЕРВИС берёт его из чертежа машины и не оценивает на глаз. Для КС-55732 завод указывает опорный контур 5,75×6,3 м; если ось близка к центру контура, она отстоит от каждой стороны на 2,9–3,2 м, но точное значение берут из паспорта.</p>
    <p>МОСКРАН-СЕРВИС измеряет вылет по горизонтали, высота подъёма на него не влияет. Высоту учитывают отдельно, по высоте подъёма крюка из грузовысотной характеристики: как её читать, описано в материале о <a href="/spravochnik/gruzovysotnaya-harakteristika/" style="color:var(--yellow)">грузовысотной характеристике</a>.</p>

    <h2 id="zamer" style="margin:36px 0 16px">Как замерить на площадке</h2>
    <p>Замер вылета на месте занимает три шага и рулетку на 20–30 м. МОСКРАН-СЕРВИС просит заказчика сделать их до заявки, чтобы подбор был сразу правильным.</p>
    <ol>
      <li>Отметить точку стоянки крана — центр будущей машины между опорами.</li>
      <li>Измерить расстояние от этой точки до стены или края проёма по нормали.</li>
      <li>Измерить смещение вдоль стены до места, куда ставят груз, и глубину установки.</li>
    </ol>
    <p>Если груз ставят на кровлю, МОСКРАН-СЕРВИС считает глубину от кромки до дальней точки установки, а не до края. Проверку габаритов рядом со стеной дополняет материал о <a href="/spravochnik/podyom-gruza-na-kryshu-avtokranom/" style="color:var(--yellow)">подъёме груза на крышу</a>.</p>

    <h2 id="primer" style="margin:36px 0 16px">Пример расчёта для КС-55732</h2>
    <p>Допустим, ось крана КС-55732 стоит в 4 м от стены, груз ставят на кровлю в 5 м от кромки и со смещением 6 м вдоль здания. Прямой вылет — 4 + 5 = 9 м, с учётом смещения √(9² + 6²) ≈ 10,8 м. МОСКРАН-СЕРВИС делит паспортный момент 90 т·м на 10,8 м и получает верхнюю оценку около 8,3 т.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Величина</th><th>Значение</th><th>Как получено</th></tr></thead>
        <tbody>
          <tr><td>Расстояние до стены</td><td>4 м</td><td>замер на площадке</td></tr>
          <tr><td>Глубина установки</td><td>5 м</td><td>замер по проекту</td></tr>
          <tr><td>Смещение вдоль стены</td><td>6 м</td><td>замер на площадке</td></tr>
          <tr><td>Вылет</td><td>≈10,8 м</td><td>√(9² + 6²)</td></tr>
          <tr><td>Верхняя оценка массы</td><td>≈8,3 т</td><td>90 т·м ÷ 10,8 м</td></tr>
        </tbody>
      </table>
    </div>
    <p>Оценка по моменту не заменяет таблицу: фактическая допустимая масса на 10,8 м у конкретной машины ниже, потому что кроме момента действуют ограничения по прочности стрелы и устойчивости. МОСКРАН-СЕРВИС поэтому сверяет груз с паспортом и оставляет запас, а не работает на пределе момента. Для сравнения моментов 25-тонных моделей смотрите материал <a href="/spravochnik/chelyabinets-ili-ivanovets-25-tonn/" style="color:var(--yellow)">«Челябинец или Ивановец»</a>.</p>

    <h2 id="oshibki" style="margin:36px 0 16px">Типичные ошибки замера</h2>
    <p>Самая частая ошибка — мерить от края опор или от забора вместо оси: так вылет занижается на 3 м и больше. МОСКРАН-СЕРВИС встречает и обратную ошибку: не учитывают смещение вдоль стены, хотя оно добавляет к вылету метры, как в примере выше. Третья ошибка — брать вылет «на уровне земли», когда груз ставят дальше, на кровле.</p>
    <p>Отдельно МОСКРАН-СЕРВИС считает расстояние до котлована и подземных коммуникаций: оно задаёт, где вообще можно поставить опоры. Порядок описан в материале о <a href="/spravochnik/rasstoyanie-ot-kotlovana/" style="color:var(--yellow)">расстоянии от котлована</a>, а зона, куда нельзя заходить людям, — в материале об <a href="/spravochnik/opasnaya-zona-krana/" style="color:var(--yellow)">опасной зоне крана</a>.</p>

    <h2 id="zayavka" style="margin:36px 0 16px">Что передать при заказе</h2>
    <p>Для подбора МОСКРАН-СЕРВИС нужны масса груза, расстояние до стены, глубина и смещение установки, высота подъёма и ширина проезда. Если вылет оказывается больше, чем тянет 25-тонная машина, подбор смещается к 32 или 50 т: смена 25 т стоит 20 800 ₽, 32 т — 24 800 ₽, 50 т — 31 200 ₽ (ставки 2 600, 3 100 и 3 900 ₽/ч × 8 ч). Заказ оформляют по <a href="/spravochnik/zayavka-na-avtokran/" style="color:var(--yellow)">заявке на автокран</a>.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: вылет автокрана</h2>
    <ul>
      <li>Вылет считают от оси вращения, а не от опор.</li>
      <li>По плану: гипотенуза из расстояния до стены с глубиной и смещения вдоль стены.</li>
      <li>Пример: 9 м и 6 м дают ≈10,8 м; для КС-55732 (90 т·м) верхняя оценка ≈8,3 т.</li>
      <li>Деление момента на вылет — только оценка; решает таблица паспорта.</li>
      <li>Размеры площадки заказчик передаёт до выезда.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://www.cmz.ru/en/catalogue/mobile/ks-55732-25-24_ural-4320/" target="_blank" rel="noopener" style="color:var(--yellow)">КС-55732 — cmz.ru (Челябинский механический завод)</a> — грузовой момент 90 т·м, опорный контур 5,75×6,3 м, стрела 24,5 м.</li>
    </ul>
    <p class="small muted">Расчёт вылета и оценка массы — инженерная оценка МОСКРАН-СЕРВИС для предварительного подбора, не норма; допустимую массу определяет таблица паспорта машины. Ставки — из калькулятора на главной странице.</p>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-25-40-tonn/">Аренда автокрана 25–40 тонн →</a></section>
</main>
</SpravochnikLayout>
