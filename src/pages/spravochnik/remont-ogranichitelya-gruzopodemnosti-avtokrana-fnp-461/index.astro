---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = "Ремонт ограничителя грузоподъёмности автокрана по ФНП 461";
const description = "Ремонтировать ограничитель грузоподъёмности вправе четыре категории исполнителей (п. 85 ФНП №461); после ремонта нужны настройка, проверка и пломба.";

const CHECKED = '25.10.2026';
const PUBLISHED = '2026-10-25';
const SLUG = "remont-ogranichitelya-gruzopodemnosti-avtokrana-fnp-461";
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    "q": "Можно ли отремонтировать ограничитель грузоподъёмности своими силами?",
    "a": "Только при условии, что персонал эксплуатирующей организации имеет квалификацию, соответствующую требованиям изготовителей в эксплуатационных документах крана и прибора (п. 20 ФНП №461). Список исполнителей в п. 85 включает изготовителей, их сервисные организации и специализированные организации с квалифицированным персоналом."
  },
  {
    "q": "Нужно ли пломбировать ограничитель после ремонта?",
    "a": "Да, опломбирование входит в обязательные действия после ремонта наряду с настройкой и проверкой работоспособности (п. 87 ФНП №461). Исключение — электромеханические концевые выключатели ограничителей рабочих движений и блокировок: их пломбировать не нужно."
  },
  {
    "q": "Что делать, если после ремонта регистратора пропали данные?",
    "a": "Если специализированная организация не может восстановить информацию долговременного хранения, она обязана сделать об этом запись в паспорте крана (п. 88 ФНП №461). Сам ремонт не должен приводить к потере таких данных."
  },
  {
    "q": "Кто разрешает вернуть кран в работу после ремонта прибора?",
    "a": "Разрешение на пуск в работу после ремонта, реконструкции или модернизации ограничителя, указателя или регистратора даёт инженерно-технический работник, ответственный за содержание подъёмного сооружения в работоспособном состоянии (п. 91 ФНП №461)."
  },
  {
    "q": "Можно ли поставить на автокран ограничитель другого типа?",
    "a": "Можно, если работа выполнена с учётом пп. 85 и 86, по документации разработчика прибора и с согласованием изготовителя крана (п. 89 ФНП №461). После установки в паспорт и руководство крана вносят изменения, а к паспорту прикладывают документы на новый прибор (п. 91)."
  }
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: "Ремонт ограничителя грузоподъёмности автокрана", item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [["kto", "Кто вправе ремонтировать ограничитель, указатель и регистратор"], ["kogda", "Когда ремонт обязателен"], ["posle", "Что обязательно сделать после ремонта"], ["registrator", "Ремонт регистратора и сохранность данных"], ["izmeneniya", "Замена прибора, обновление программы, внесение изменений"], ["dokumenty", "Какие документы меняются после реконструкции прибора"], ["faq", "Частые вопросы"], ["istochniki", "Источники"]];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Ремонт ограничителя грузоподъёмности автокрана</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">ФНП №461 · Приборы безопасности</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Кто вправе ремонтировать ограничитель грузоподъёмности автокрана?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>25.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>25.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>6 мин чтения</span>
    </div>

    <p>Ограничитель грузоподъёмности автокрана вправе ремонтировать четыре категории исполнителей: изготовитель крана, изготовитель прибора, сервисная организация изготовителя прибора и специализированная организация, и каждая обязана иметь квалифицированный персонал (п. 85 ФНП №461). После ремонта обязательны настройка, проверка работоспособности и опломбирование, а допуск крана в работу даёт ответственный инженерно-технический работник. МОСКРАН-СЕРВИС сверяет эту цепочку до выезда крана на объект.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="kto" style="margin:36px 0 16px">Кто вправе ремонтировать ограничитель, указатель и регистратор</h2>
    <p>Пункт 85 ФНП №461 называет четыре категории исполнителей ремонта ограничителей, указателей и регистраторов: изготовители подъёмных сооружений, изготовители ограничителей и указателей, их сервисные организации (сервисные центры) и специализированные организации. Для каждой категории норма ставит одно и то же условие — наличие квалифицированного персонала на эти виды работ. Организация без такого персонала в список не входит, и МОСКРАН-СЕРВИС не принимает от неё работы по приборам безопасности, даже если у неё есть доступ к запчастям.</p>
    <p>Квалификацию работников задаёт п. 20 ФНП №461: она должна соответствовать требованиям изготовителей, изложенным в эксплуатационных документах крана и самих приборов. Работы на регистраторах, ограничителях и указателях выполняют работники специализированных или эксплуатирующих организаций. Для автокранов КС-55713 «Клинцы» и КС-65713-1 «Галичанин» МОСКРАН-СЕРВИС ориентируется на эксплуатационные документы конкретного прибора, а не на общий регламент сервиса.</p>
    <h2 id="kogda" style="margin:36px 0 16px">Когда ремонт обязателен</h2>
    <p>Ремонт ограничителя проводят в двух случаях: при возникновении неисправности и при наступлении срока в графике планово-предупредительного ремонта, установленном эксплуатирующей организацией (п. 86 ФНП №461). МОСКРАН-СЕРВИС отделяет техническое обслуживание приборов, которое идёт по их эксплуатационной документации, от ремонта. Неисправный ограничитель — повод остановить подъёмы: порядок действий описан в справке об <a href="/spravochnik/ogranichitel-gruzopodemnosti/" style="color:var(--yellow)">ограничителе грузоподъёмности</a>.</p>
    <h2 id="posle" style="margin:36px 0 16px">Что обязательно сделать после ремонта</h2>
    <p>После ремонта регистратора, ограничителя, указателя или их отдельных узлов проводят три действия: настройку (регулировку), проверку работоспособности и опломбирование в соответствии с эксплуатационной документацией (п. 87 ФНП №461). Единственное исключение закреплено в той же норме: опломбирование электромеханических концевых выключателей в ограничителях рабочих движений и блокировках не требуется.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Действие после ремонта</th><th>Что требует ФНП №461</th><th>Пункт</th></tr></thead>
        <tbody>
          <tr><td>Настройка (регулировка)</td><td>По указаниям эксплуатационной документации прибора</td><td>п. 87</td></tr>
          <tr><td>Проверка работоспособности</td><td>После ремонта прибора или его узлов</td><td>п. 87</td></tr>
          <tr><td>Опломбирование</td><td>Обязательно; для электромеханических концевых выключателей не требуется</td><td>п. 87</td></tr>
          <tr><td>Запись в паспорт</td><td>Если данные регистратора не удалось восстановить — запись об этом в паспорте крана</td><td>п. 88</td></tr>
          <tr><td>Разрешение на пуск</td><td>Даёт ИТР, ответственный за содержание ПС в работоспособном состоянии</td><td>п. 91</td></tr>
        </tbody>
      </table>
    </div>
    <p>Таблица ФНП №461 показывает, что пломба — не формальность, а часть результата ремонта. Как проверяют сам ограничитель после настройки и какие точки характеристики берут, разобрано в справке про <a href="/spravochnik/proverka-priborov-bezopasnosti-avtokrana-fnp-461/" style="color:var(--yellow)">проверку приборов безопасности</a>.</p>
    <h2 id="registrator" style="margin:36px 0 16px">Ремонт регистратора и сохранность данных</h2>
    <p>Ремонт регистратора параметров работы не должен приводить к потере информации долговременного хранения (п. 88 ФНП №461). Если специализированная организация не смогла восстановить такие данные, она делает запись об этом в паспорте крана. Для МОСКРАН-СЕРВИС и заказчика это значит одно: журнал параметров автокрана — часть документов на машину, а не память прибора, которую допустимо стереть.</p>
    <h2 id="izmeneniya" style="margin:36px 0 16px">Замена прибора, обновление программы, внесение изменений</h2>
    <p>Установку прибора иного типа и внесение изменений в ограничитель разрешено проводить по документации разработчика или изготовителя прибора и при наличии согласования с изготовителем крана (п. 89 ФНП №461). Если изготовителя крана установить нельзя, работу выполняют по проекту специализированной организации, отвечающей требованиям п. 20. Корректировку программного обеспечения для ограничения проектных параметров допускает п. 90, но новое ПО устанавливают работники изготовителя прибора или специализированных организаций, а выполненное программирование вносят в паспорт прибора.</p>
    <h2 id="dokumenty" style="margin:36px 0 16px">Какие документы меняются после реконструкции прибора</h2>
    <p>После реконструкции или модернизации ограничителя организация, выполнившая работу, обязана внести изменения в паспорт и руководство по эксплуатации крана, а также в паспорт и руководство прибора (п. 91 ФНП №461). Если на автокран МОСКРАН-СЕРВИС установлен прибор иного типа, к паспорту прикладывают руководство и паспорт на него. Разрешение на пуск в работу даёт ответственный за содержание крана в работоспособном состоянии — это условие описано и в справке о <a href="/spravochnik/pasport-krana/" style="color:var(--yellow)">паспорте крана</a>.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: ремонт ограничителя грузоподъёмности</h2>
    <ul>
      <li>Ремонтируют изготовители крана и прибора, их сервисные центры и специализированные организации — только с квалифицированным персоналом (п. 85).</li>
      <li>Ремонт идёт при неисправности или по графику планово-предупредительного ремонта (п. 86).</li>
      <li>После ремонта: настройка, проверка работоспособности, опломбирование; электромеханические концевики не пломбируют (п. 87).</li>
      <li>Изменения вносят в паспорт и руководство крана и прибора; разрешение на пуск даёт ответственный ИТР (п. 91).</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://www.consultant.ru/document/cons_doc_LAW_373321/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 (приказ Ростехнадзора от 26.11.2020 №461)</a> — пп. 20, 85–91 (кто ремонтирует, ремонт по неисправности и графику, настройка и опломбирование, запись в паспорт, разрешение на пуск).</li>
      <li><a href="https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 на legalacts.ru</a> — текст пунктов сверен 25.10.2026.</li>
    </ul>
    <p class="small muted">Справка не заменяет эксплуатационные документы конкретного ограничителя: порядок настройки и состав пломб задаёт изготовитель прибора.</p>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-16-25-tonn/">Аренда автокрана 16–25 тонн →</a></section>
</main>
</SpravochnikLayout>
