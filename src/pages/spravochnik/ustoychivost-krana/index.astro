---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';
import Sources from '../../../components/Sources.astro';

const title = 'Как рассчитывается запас устойчивости крана';
const description = 'Грузовая и собственная устойчивость крана проверяются с учётом ветровой нагрузки, уклона площадки и инерционных сил. Расчёт делается заранее.';

const CHECKED = '21.08.2026';

const faqs = [
  { q: 'Кто рассчитывает устойчивость крана — оператор на объекте или производитель заранее?', a: 'Базовый расчёт устойчивости конкретной модели закладывается производителем в паспорт крана и грузовысотную характеристику. На объекте мы дополнительно проверяем факторы конкретной площадки — уклон, несущую способность грунта, ветровые условия — которые могут повлиять на фактический запас устойчивости.' },
  { q: 'Что такое грузовая устойчивость в отличие от собственной?', a: 'Грузовая устойчивость — устойчивость крана с поднятым грузом, самый требовательный сценарий проверки. Собственная устойчивость — устойчивость крана без груза, актуальна, например, при сильном ветре или на уклоне, когда сама масса и геометрия крана могут стать фактором риска даже без нагрузки.' },
  { q: 'Почему уклон площадки влияет на устойчивость?', a: 'Уклон местности в сторону груза создаёт дополнительное усилие, действующее в направлении опрокидывания — это учитывается в расчёте наряду с ветровой нагрузкой и инерционными силами при пуске и торможении механизмов.' },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Устойчивость крана', item: 'https://moskran-servis.ru/spravochnik/ustoychivost-krana/' },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@id': 'https://moskran-servis.ru/#organization' }, // ссылка на единственный узел организации (BaseLayout): отдельный узел с тем же @id, но другим name, был противоречием в графе
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: 'https://moskran-servis.ru/spravochnik/ustoychivost-krana/',
  inLanguage: 'ru-RU',
  datePublished: '2026-08-12',
  dateModified: '2026-08-21',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<SpravochnikLayout title={title} description={description} path="/spravochnik/ustoychivost-krana/" slug="ustoychivost-krana" ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Устойчивость крана</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Разбор для заказчика</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Устойчивость крана против опрокидывания — как рассчитывается запас</h1>
    <p class="ref-byline">Инженерная служба МОСКРАН-СЕРВИС · обновлено в 2026 году</p>

    <p>Мы разбирали несущую способность грунта под опорами и требования к площадке. Устойчивость самого крана как конструкции против опрокидывания — отдельный, более фундаментальный параметр безопасности.</p>

    <h2 style="margin:36px 0 16px">Что проверяется</h2>
    <p>Краны стрелового типа должны быть устойчивыми против опрокидывания и в рабочем, и в нерабочем состоянии. Расчёт устойчивости проводится для нескольких сценариев: действие испытательной нагрузки, действие рабочего груза (грузовая устойчивость), отсутствие груза (собственная устойчивость), внезапное снятие нагрузки и процесс монтажа крана.</p>

    <h2 style="margin:36px 0 16px">Грузовая и собственная устойчивость</h2>
    <p>Грузовая устойчивость проверяется в самом требовательном сценарии: кран установлен на площадке с предельно допустимым уклоном в сторону груза, груз номинальной массы поднимается при максимальном вылете стрелы — то есть наихудшее реалистичное сочетание условий. Собственная устойчивость (без груза) отдельно важна при сильном ветре или на уклоне, когда даже без нагрузки геометрия и масса самого крана могут создать риск.</p>

    <h2 style="margin:36px 0 16px">Что учитывается в коэффициенте грузовой устойчивости</h2>
    <p>Коэффициент грузовой устойчивости — это отношение момента, создаваемого весом всех частей крана с учётом дополнительных нагрузок (ветровая нагрузка, инерционные силы при пуске или торможении механизмов подъёма, поворота и передвижения крана, усилие от допустимого уклона местности), к моменту, создаваемому рабочим грузом. Чем выше этот коэффициент, тем больше запас устойчивости у конкретной модели в конкретных условиях.</p>

    <h2 style="margin:36px 0 16px">Что это значит на практике для нашей работы</h2>
    <p>Базовый расчёт устойчивости для каждой модели заложен производителем в паспорт и грузовысотную характеристику (мы разбирали это отдельно). На объекте мы дополнительно оцениваем условия конкретной площадки — уклон, ветер, несущую способность грунта — потому что фактический запас устойчивости на конкретной площадке зависит не только от паспортных данных крана, но и от реальных условий, в которых он работает в данный момент.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: что запомнить</h2>
    <ul>
      <li>Устойчивость крана проверяется для нескольких сценариев: с грузом, без груза, при внезапном снятии нагрузки, при монтаже.</li>
      <li>Грузовая устойчивость — самый требовательный сценарий: предельный уклон площадки + максимальный вылет + номинальный груз.</li>
      <li>Коэффициент устойчивости учитывает ветровую нагрузку, инерционные силы и уклон местности.</li>
      <li>Мы дополнительно проверяем реальные условия конкретной площадки поверх паспортных данных крана.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <Sources
      checked={CHECKED}
      items={[
        { text: 'stroy-technics.ru — устойчивость кранов', href: 'https://stroy-technics.ru/article/ustoichivost-kranov' },
        { text: 'centr-teh.ru — устойчивость крана: факторы и способы установки', href: 'https://centr-teh.ru/blog/podemnye-krany/ustoichivost-krana' }
      ]}
    />
  </article>
  <section class="section wrap"><a class="btn" href="/spravochnik/nesushchaya-sposobnost-grunta/">Несущая способность грунта под опорами →</a></section>
</main>
</SpravochnikLayout>
