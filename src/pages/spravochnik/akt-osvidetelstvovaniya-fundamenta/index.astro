---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';
import Sources from '../../../components/Sources.astro';

const title = 'Акт скрытых работ для фундамента крана: зачем нужен';
const description = 'Фундамент крана после заливки становится скрытым элементом — качество подтверждается актом освидетельствования до начала монтажа техники.';

const CHECKED = '12.08.2026';

const faqs = [
  { q: 'Кто составляет акт освидетельствования скрытых работ по фундаменту крана?', a: 'Комиссия с участием представителя строительного контроля и, как правило, независимой лаборатории, проверяющей качество работ — например, прочность фундамента. Исполнитель работ должен подтвердить качество документами, а не только собственным заявлением.' },
  { q: 'Можно ли начать монтаж крана до подписания акта?', a: 'Нет, монтаж на фундамент, качество которого не подтверждено актом освидетельствования, — риск для устойчивости всей конструкции крана. Это тот же принцип, что и с другими скрытыми элементами — трубами, кабелями, изоляцией: то, что будет скрыто следующим этапом работ, документируется до того, как станет недоступно для визуальной проверки.' },
  { q: 'Это тот же документ, что и техническое освидетельствование самого крана?', a: 'Нет — это разные документы про разные объекты. Акт освидетельствования скрытых работ касается строительной части (фундамента), техническое освидетельствование (о котором мы писали в отдельной статье) — самого крана как оборудования.' },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Акт освидетельствования фундамента', item: 'https://moskran-servis.ru/spravochnik/akt-osvidetelstvovaniya-fundamenta/' },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@id': 'https://moskran-servis.ru/#organization' }, // ссылка на единственный узел организации (BaseLayout): отдельный узел с тем же @id, но другим name, был противоречием в графе
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: 'https://moskran-servis.ru/spravochnik/akt-osvidetelstvovaniya-fundamenta/',
  inLanguage: 'ru-RU',
  datePublished: '2026-08-12',
  dateModified: '2026-08-12',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<SpravochnikLayout title={title} description={description} path="/spravochnik/akt-osvidetelstvovaniya-fundamenta/" slug="akt-osvidetelstvovaniya-fundamenta" ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Акт освидетельствования фундамента</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Разбор для заказчика</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Акт освидетельствования скрытых работ — зачем нужен для фундамента башенного крана</h1>
    <p class="ref-byline">Инженерная служба МОСКРАН-СЕРВИС · обновлено в 2026 году</p>

    <p>На странице услуги «Башенный кран» мы писали, что фундамент — отдельный проектный элемент, подготавливаемый заранее. Здесь разбираем документ, который подтверждает качество этого фундамента до начала монтажа техники.</p>

    <h2 style="margin:36px 0 16px">Что такое скрытые работы</h2>
    <p>Акты освидетельствования скрытых работ составляются для строительных операций, результат которых становится недоступен для последующей визуальной проверки — установка или ремонт основания фундамента, заливка основания, прокладка коммуникационных сетей, крепление конструкций к стенам и крыше. Фундамент под башенный кран попадает в эту категорию: после заливки и застывания бетона внутреннее армирование и качество заливки уже нельзя проверить визуально.</p>

    <h2 style="margin:36px 0 16px">Кто составляет акт</h2>
    <p>Акт составляется по результатам проверки работ комиссией, обычно с участием представителя строительного контроля. Независимые лаборатории проверяют качество работ — например, прочность фундамента — а исполнитель работ должен подтвердить качество документами, а не только собственным заявлением о готовности.</p>

    <h2 style="margin:36px 0 16px">Почему нельзя начинать монтаж крана без акта</h2>
    <p>Фундамент — основа устойчивости всей конструкции башенного крана при работе на максимальном вылете и грузе. Начинать монтаж на фундаменте, качество которого не подтверждено документально, — риск, сопоставимый с работой на неподтверждённой несущей способности грунта под выносными опорами автокрана (о чём мы писали в отдельной статье), только с гораздо более серьёзными последствиями из-за постоянной, а не временной установки техники.</p>

    <h2 style="margin:36px 0 16px">Отличие от технического освидетельствования крана</h2>
    <p>Важно не путать два документа: акт освидетельствования скрытых работ касается строительной части — фундамента, подготовленного до монтажа. Техническое освидетельствование (ЧТО/ПТО, о котором мы писали отдельно) — это проверка самого крана как единицы оборудования, а не строительной конструкции под ним. Оба документа независимы друг от друга, но оба обязательны в своей области.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: что запомнить</h2>
    <ul>
      <li>Фундамент крана после заливки — скрытый элемент, качество которого подтверждается актом до монтажа техники.</li>
      <li>Акт составляет комиссия, часто с участием независимой лаборатории, проверяющей прочность.</li>
      <li>Монтаж крана на неподтверждённом фундаменте — прямой риск устойчивости всей конструкции.</li>
      <li>Это отдельный документ от технического освидетельствования самого крана.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <Sources
      checked={CHECKED}
      items={[
        { text: 'moedelo.org — акт освидетельствования скрытых работ', href: 'https://www.moedelo.org/club/article-knowledge/akt-skrytyh-rabot' },
        { text: 'gectaro.com — акт освидетельствования скрытых работ в строительстве', href: 'https://gectaro.com/spravochnik/tpost/ziv208de01-akt-osvidetelstvovaniya-skritih-rabot-v' }
      ]}
    />
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/bashennyy-kran/">Подробнее об аренде башенного крана →</a></section>
</main>
</SpravochnikLayout>
