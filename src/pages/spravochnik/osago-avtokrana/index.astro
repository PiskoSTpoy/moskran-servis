---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';
import Sources from '../../../components/Sources.astro';

const title = 'ОСАГО для автокрана: нужен ли полис и чем он отличается от ОСОПО';
const description = 'Автокран едет по дорогам общего пользования быстрее 20 км/ч — значит, подпадает под обязательное ОСАГО по 40-ФЗ. Разбираем порог скорости, что полис покрывает и чем это отличается от страхования ОПО.';

const CHECKED = '09.09.2026';

const faqs = [
  {
    q: 'Кран уже застрахован по 225-ФЗ как опасный объект — зачем ещё и ОСАГО?',
    a: 'Это два полиса про два разных риска одной и той же машины. Страхование ответственности владельца ОПО по 225-ФЗ, о котором справочник уже писал, покрывает вред от аварии на опасном производственном объекте — то есть от работы крана как подъёмного сооружения. ОСАГО по 40-ФЗ — это страхование гражданской ответственности владельца транспортного средства, и оно про другой момент: пока автокран едет по дороге общего пользования как обычный участник движения. Один и тот же автокран в течение дня успевает побывать и тем, и другим — сначала транспортным средством в потоке, потом подъёмным сооружением на выносных опорах, — и для каждой из этих ролей закон требует свою страховку.',
  },
  {
    q: 'Как понять, что автокран попадает под требование об ОСАГО, а не под исключение из него?',
    a: 'Ключевой критерий закона №40-ФЗ — максимальная конструктивная скорость машины: если она не превышает 20 км/ч, обязанность страховать не возникает. У автокрана на шасси грузового автомобиля этот порог не проблема: например, машины на распространённом шасси КАМАЗ-43118 или КАМАЗ-65115 идут по трассе со скоростью около 60 км/ч, то есть кратно выше порога из закона. Гусеничный или тихоходный самоходный кран, ограниченный скоростью 20 км/ч и ниже, под то же исключение мог бы попасть — но это не про типичный автокран на колёсном шасси, каким подрядчики выполняют аренду в Москве.',
  },
  {
    q: 'Кто обязан оформлять ОСАГО на автокран — арендодатель или заказчик?',
    a: 'Обязанность лежит на владельце транспортного средства, то есть на компании, которая предоставляет технику в аренду, а не на заказчике услуги. Как и с полисом ОПО по 225-ФЗ, заказчику не нужно оформлять что-либо самостоятельно — но действующий полис ОСАГО у подрядчика стоит проверять вместе с остальным пакетом документов на машину: паспортом самоходной машины, свидетельством о регистрации и полисом ответственности владельца ОПО.',
  },
  {
    q: 'Полис ОСАГО покрывает ущерб, если кран уронит груз во время работы на объекте?',
    a: 'Нет, и это частая путаница. ОСАГО отвечает за вред, причинённый при использовании транспортного средства именно как участника дорожного движения — то есть в дороге. Пока кран стоит на выносных опорах и выполняет подъём груза, он работает не как транспортное средство в потоке, а как подъёмное сооружение на закрытой площадке объекта, и это уже зона другой ответственности — страхования ОПО по 225-ФЗ либо общегражданской ответственности подрядчика по договору. Смешивать эти два полиса и ждать от ОСАГО покрытия аварии на площадке не стоит.',
  },
  {
    q: 'Что грозит, если автокран поедет по городу без полиса ОСАГО?',
    a: 'Административную ответственность по статье 12.37 КоАП РФ: за полное отсутствие полиса — штраф 800 рублей, за использование транспортного средства вне периода, указанного в полисе, или водителем, не вписанным в него, — 500 рублей. С 1 января 2025 года в статью добавлена часть 3 — за повторное правонарушение в течение года штраф вырастает до 3000–5000 рублей. Суммы по меркам самого автокрана небольшие, но задержка на посту из-за проверки документов — уже потерянное время подачи техники на объект.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'ОСАГО для автокрана', item: 'https://moskran-servis.ru/spravochnik/osago-avtokrana/' },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@id': 'https://moskran-servis.ru/#organization' }, // ссылка на единственный узел организации (BaseLayout): отдельный узел с тем же @id, но другим name, был противоречием в графе
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: 'https://moskran-servis.ru/spravochnik/osago-avtokrana/',
  inLanguage: 'ru-RU',
  datePublished: '2026-09-09',
  dateModified: '2026-09-09',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<SpravochnikLayout title={title} description={description} path="/spravochnik/osago-avtokrana/" slug="osago-avtokrana" ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>ОСАГО для автокрана</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Разбор для заказчика</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">ОСАГО для автокрана: нужен ли полис и чем он отличается от страхования ОПО</h1>
    <p class="ref-byline">Инженерная служба МОСКРАН-СЕРВИС · обновлено 09.09.2026</p>

    <p>Справочник уже разбирал <a href="/spravochnik/strahovanie-otvetstvennosti-opo/" style="color:var(--yellow)">обязательное страхование ответственности владельца опасного объекта</a> по 225-ФЗ — полис, который защищает от вреда, причинённого аварией на объекте, где работает кран как подъёмное сооружение. У той же машины есть вторая, гораздо более привычная сторона: пока автокран своим ходом идёт по улицам Москвы или области, он — обычное транспортное средство, и на него распространяется обязательное страхование автогражданской ответственности, ОСАГО. Разбираем, откуда берётся это требование, почему оно касается именно автокрана, и почему полис ОСАГО не заменяет и не дублирует страхование ОПО.</p>

    <h2 style="margin:36px 0 16px">Требование из закона №40-ФЗ, а не из ФНП №461</h2>
    <p>Обязательное страхование гражданской ответственности владельцев транспортных средств установлено Федеральным законом от 25.04.2002 №40-ФЗ «Об обязательном страховании гражданской ответственности владельцев транспортных средств». Это гражданское, а не промышленное законодательство: закон защищает третьих лиц от вреда, причинённого при использовании транспортного средства на дороге, — авариях, наездах, столкновениях, — и не имеет прямого отношения к нормам Ростехнадзора о безопасной эксплуатации подъёмных сооружений, которые справочник разбирал применительно к самому крану.</p>
    <p>Статья 4 закона №40-ФЗ задаёт саму обязанность страховать, а её пункт 3 перечисляет исключения: обязанность не распространяется на владельцев транспортных средств, максимальная конструктивная скорость которых не превышает 20 км/ч, а также на транспортные средства, не предназначенные для движения по дорогам общего пользования и (или) не подлежащие государственной регистрации. Именно этот порог и решает, нужен ли полис конкретной единице техники.</p>

    <h2 style="margin:36px 0 16px">Почему автокран не попадает под исключение</h2>
    <p>Автокран на колёсном шасси — это не тихоходная спецтехника, ограниченная площадкой. Он строится на базе серийного грузового автомобиля и по трассе способен идти на обычной для грузовика скорости: например, машины на распространённом в парках подрядчиков шасси КАМАЗ-43118 или КАМАЗ-65115 развивают на дороге около 60 км/ч — втрое выше порога из пункта 3 статьи 4 закона №40-ФЗ. При этом сам автокран подлежит государственной регистрации: не в ГИБДД, как обычный грузовик, а в органах Гостехнадзора, как самоходная машина, — но регистрация в любом случае есть, а значит, и второе основание для исключения тоже не выполняется. Вместе это означает: типичный автокран на колёсном шасси, каким подрядчики выполняют заказы по Москве и области, подпадает под требование об ОСАГО в полном объёме, пока он передвигается своим ходом по дорогам общего пользования.</p>

    <h2 style="margin:36px 0 16px">Что полис покрывает, а что — нет</h2>
    <p>ОСАГО отвечает за вред, причинённый именно при использовании транспортного средства как участника дорожного движения: столкновение, наезд, повреждение чужого имущества на дороге во время марша техники к объекту или обратно. Но как только автокран прибывает на площадку, выставляется на выносные опоры и начинает работать как подъёмное сооружение, а не как транспортное средство в потоке, — это уже другая правовая ситуация. Вред, причинённый в ходе самой грузоподъёмной операции — например, при падении груза или опрокидывании стрелы, — относится к зоне страхования ответственности владельца опасного объекта по 225-ФЗ либо к общегражданской ответственности подрядчика по договору, но не к ОСАГО. Разделение простое: ОСАГО — про дорогу, страхование ОПО — про площадку.</p>

    <h2 style="margin:36px 0 16px">Ответственность за отсутствие полиса</h2>
    <p>Несоблюдение требований об обязательном страховании — предмет статьи 12.37 КоАП РФ. Управление транспортным средством без оформленного полиса ОСАГО — часть 2 статьи, штраф 800 рублей; использование машины в период, не предусмотренный полисом, или водителем, не вписанным в него, — часть 1, штраф 500 рублей. С 1 января 2025 года в статью добавлена часть 3: за повторное в течение года нарушение по части 2 штраф вырастает до 3000–5000 рублей. Для компании, которая держит парк техники в порядке, сами суммы штрафа некритичны — а вот задержка автокрана на посту весовогабаритного или простого дорожного контроля из-за проверки полиса — уже риск сорвать время подачи техники на объект.</p>

    <h2 style="margin:36px 0 16px">Что это значит для заказчика</h2>
    <p>Оформление и продление ОСАГО — обязанность владельца техники, то есть подрядчика, а не заказчика услуги аренды крана. Но, как и с полисом ответственности владельца ОПО, действующий ОСАГО стоит держать в уме как часть стандартного пакета документов на машину — вместе с паспортом самоходной машины, свидетельством о регистрации в Гостехнадзоре и полисом по 225-ФЗ. Подрядчик, у которого в порядке весь этот комплект, реже сталкивается с задержками на дороге по формальным причинам, а значит, реже срывает согласованное время подачи техники.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: что запомнить</h2>
    <ul>
      <li>ОСАГО по 40-ФЗ и страхование ОПО по 225-ФЗ — два разных обязательных полиса одного автокрана: один про дорогу, второй про работу крана на объекте.</li>
      <li>Порог из пункта 3 статьи 4 закона №40-ФЗ — максимальная конструктивная скорость 20 км/ч; у автокрана на колёсном шасси она в разы выше, поэтому исключение не действует.</li>
      <li>ОСАГО покрывает вред, причинённый в дорожном движении, а не аварию во время грузоподъёмной операции на выносных опорах.</li>
      <li>Отсутствие полиса — статья 12.37 КоАП РФ: 800 рублей за полное отсутствие полиса (ч. 2), 500 рублей за нарушение условий полиса (ч. 1), с 2025 года — 3000–5000 рублей за повторное нарушение по ч. 2 (ч. 3).</li>
      <li>Оформляет и поддерживает полис владелец техники; заказчику стоит проверять его как часть стандартного пакета документов на автокран.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <Sources
      checked={CHECKED}
      items={[
        { text: 'КонсультантПлюс — Федеральный закон от 25.04.2002 №40-ФЗ «Об обязательном страховании гражданской ответственности владельцев транспортных средств», ст. 4', href: 'https://www.consultant.ru/document/cons_doc_LAW_36528/' },
        { text: 'КонсультантПлюс — КоАП РФ, статья 12.37 «Несоблюдение требований об обязательном страховании гражданской ответственности владельцев транспортных средств»', href: 'https://www.consultant.ru/document/cons_doc_LAW_34661/42019d66e0b2432916c9085c738546d47354b1c4/' },
        { text: 'Росгосстрах — ОСАГО на спецтехнику: условия и исключения из обязательного страхования', href: 'https://www.rgs.ru/auto/osago/osago-na-spetstekhniku' },
      ]}
      note="Прямого доступа к полному тексту закона №40-ФЗ и КоАП РФ в системе КонсультантПлюс при подготовке материала не было; формулировки статьи 4 (порог 20 км/ч, основания исключения) и статьи 12.37 (суммы штрафов по частям 1, 2 и 3) сверены по нескольким независимым пересказам нормы и совпадают между источниками."
    />
  </article>
  <section class="section wrap"><a class="btn" href="/spravochnik/strahovanie-otvetstvennosti-opo/">Страхование ОПО при аренде крана: зачем оно нужно →</a></section>
</main>
</SpravochnikLayout>
