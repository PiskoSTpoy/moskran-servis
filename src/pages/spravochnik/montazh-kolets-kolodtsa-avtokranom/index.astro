---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = 'Монтаж колец колодца автокраном: масса и выбор крана';
const description = 'Кольцо КС 10-9 весит 0,6 т, КС 15-9 — 1 т, КС 20-9 — 1,47 т. Строповка по п. 8.3 ГОСТ 8020-2016, расчёт вылета и смена автокрана от 17 600 ₽.';

const CHECKED = '01.10.2026';
const PUBLISHED = '2026-10-01';
const SLUG = 'montazh-kolets-kolodtsa-avtokranom';
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: 'Сколько весит бетонное кольцо для колодца?',
    a: 'Кольцо КС 10-9 диаметром 1,16 м и высотой 0,89 м весит 0,6 т, КС 15-9 — 1 т, КС 20-9 — 1,47 т, КС 25-9 — 2,7 т по каталогу завода ЖБИ. МОСКРАН-СЕРВИС просит заказчика назвать марку кольца в заявке: масса конкретной партии указана в паспорте изделия.',
  },
  {
    q: 'Какой автокран нужен для колец септика?',
    a: 'Для колец КС 15-9 массой 1 т хватает автокрана класса 16–20 т: на вылете 14 м кольцо создаёт момент 14 т·м. МОСКРАН-СЕРВИС берёт за этот класс 2 200 ₽ в час, смена 8 часов — 17 600 ₽. Класс 25 т за 20 800 ₽ нужен при вылете больше 15–18 м или кольцах КС 25-9.',
  },
  {
    q: 'Как правильно стропить кольцо колодца?',
    a: 'Пункт 8.3 ГОСТ 8020-2016 требует стропить стеновое кольцо через монтажные отверстия: в них вставляют отрезок стальной трубы или стержень диаметром 48–55 мм, который длиннее наружного диаметра кольца на 300–400 мм. Крановщик МОСКРАН-СЕРВИС не поднимает кольцо, обвязанное стропом «в обхват» без такого приспособления.',
  },
  {
    q: 'Можно ли сбрасывать кольца с машины без крана?',
    a: 'Нет: пункт 8.4 ГОСТ 8020-2016 запрещает разгрузку сбрасыванием и скатыванием по наклонным плоскостям. Кольцо без арматурного каркаса от удара трескается, и колодец потеряет герметичность. МОСКРАН-СЕРВИС поэтому снимает кольца с кузова тем же автокраном, который потом ставит их в котлован.',
  },
  {
    q: 'На каком расстоянии от ямы ставить автокран?',
    a: 'Расстояние от опоры крана до откоса котлована задаёт таблица ФНП №461 в зависимости от глубины выемки и типа грунта; для ямы под септик глубиной 3 м это несколько метров. МОСКРАН-СЕРВИС считает вылет от оси поворота до центра ямы уже с учётом этого отступа.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Монтаж колец колодца', item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ['massa', 'Масса колец'],
  ['stropovka', 'Строповка по ГОСТ 8020-2016'],
  ['vylet', 'Вылет и грузовой момент'],
  ['ploshadka', 'Площадка у котлована'],
  ['stoimost', 'Сколько стоит смена'],
  ['faq', 'Частые вопросы'],
  ['istochniki', 'Источники'],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Монтаж колец колодца</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Монтаж ЖБИ · Колодец и септик</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Какой автокран нужен для монтажа колец колодца и септика?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>01.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>01.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>6 мин чтения</span>
    </div>

    <p>Стеновое кольцо КС 15-9 для септика весит 1 т, КС 20-9 — 1,47 т, поэтому по массе с ними справляется автокран класса 16–20 т. Класс выбирают по вылету: кран стоит в стороне от ямы, и кольцо 1,47 т на вылете 14 м даёт 20,6 т·м грузового момента. ГОСТ 8020-2016 в п. 8.3 задаёт способ строповки — трубой через монтажные отверстия. МОСКРАН-СЕРВИС берёт за смену класса 16–20 т 17 600 ₽.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="massa" style="margin:36px 0 16px">Масса колец</h2>
    <p>ГОСТ 8020-2016 действует с 1 июля 2017 года вместо ГОСТ 8020-90 и задаёт ряд размеров колец, а массу каждой марки указывает изготовитель. МОСКРАН-СЕРВИС сверил 01.10.2026 каталог завода ЖБИ: цифры в марке означают внутренний диаметр и высоту в дециметрах, так что КС 15-9 — кольцо с проходом 1,5 м и высотой 0,89 м.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Марка</th><th>Наружный диаметр</th><th>Высота</th><th>Масса</th><th>Момент на вылете 14 м</th></tr></thead>
        <tbody>
          <tr><td>КС 10-9</td><td>1,16 м</td><td>0,89 м</td><td>0,6 т</td><td>8,4 т·м</td></tr>
          <tr><td>КС 15-9</td><td>1,68 м</td><td>0,89 м</td><td>1,0 т</td><td>14,0 т·м</td></tr>
          <tr><td>КС 20-9</td><td>2,2 м</td><td>0,89 м</td><td>1,47 т</td><td>20,6 т·м</td></tr>
          <tr><td>КС 20-12</td><td>2,2 м</td><td>1,19 м</td><td>1,96 т</td><td>27,5 т·м</td></tr>
          <tr><td>КС 25-9</td><td>2,8 м</td><td>0,89 м</td><td>2,7 т</td><td>37,8 т·м</td></tr>
        </tbody>
      </table>
    </div>
    <p>Питьевой колодец из шести колец КС 10-9 — это 3,6 т бетона и ствол высотой 5,34 м. Септик из двух камер по три кольца КС 15-9 — шесть подъёмов по 1 т, не считая плит днища и перекрытия. МОСКРАН-СЕРВИС считает кран по самому тяжёлому элементу, а не по сумме: кольца поднимаются по одному.</p>

    <h2 id="stropovka" style="margin:36px 0 16px">Строповка по ГОСТ 8020-2016</h2>
    <p>Пункт 8.3 ГОСТ 8020-2016 предписывает стропить стеновое кольцо через монтажные отверстия: сквозь них продевают отрезок стальной трубы или стержень наружным диаметром 48–55 мм. Длина приспособления должна превышать наружный диаметр кольца на 300–400 мм, то есть для КС 15-9 с диаметром 1,68 м нужна труба около 2 м, для КС 20-9 — около 2,5–2,6 м. Стропы МОСКРАН-СЕРВИС цепляет за выступающие концы трубы.</p>
    <p>Кольца с монтажными петлями стропят за все петли сразу, а пункт 8.4 ГОСТ 8020-2016 запрещает разгрузку сбрасыванием и скатыванием по наклонной плоскости. Трубу заказчик готовит заранее: в комплект автокрана она не входит, и без неё крановщик МОСКРАН-СЕРВИС не начнёт подъём кольца без петель. Схемы зацепки других грузов собраны в <a href="/spravochnik/shemy-stropovki-gruzov/" style="color:var(--yellow)">материале о схемах строповки</a>.</p>

    <h2 id="vylet" style="margin:36px 0 16px">Вылет и грузовой момент</h2>
    <p>Кольцо КС 20-9 массой 1,47 т на вылете 14 м нагружает кран моментом 20,6 т·м — это четверть от 85 т·м, которые есть у 25-тонного КС-55713-1К «Клинцы». Вылет складывается из половины опорного контура, отступа от бровки ямы и расстояния до её центра. На дачном участке автокран часто остаётся на дороге за забором, и вылет вырастает до 15–18 м.</p>
    <p>Грузовой момент даёт только верхнюю оценку: на длинной стреле допустимая масса ниже, чем результат деления момента на вылет. МОСКРАН-СЕРВИС поэтому сверяет вылет с таблицей паспорта конкретной машины и добавляет к массе кольца массу стропов и трубы. Порядок чтения таблицы показан в <a href="/spravochnik/gruzovysotnaya-harakteristika/" style="color:var(--yellow)">материале о грузовысотной характеристике</a>.</p>

    <h2 id="ploshadka" style="margin:36px 0 16px">Площадка у котлована</h2>
    <p>ФНП №461 (п. 108–110) требует ставить автокран на все выносные опоры на подготовленной площадке, а расстояние от опоры до откоса выемки брать по таблице правил. Яма под септик глубиной 3 м в суглинке отодвигает кран от бровки на несколько метров, и именно этот отступ увеличивает вылет. МОСКРАН-СЕРВИС просит в заявке глубину ямы и тип грунта; таблица отступов разобрана в <a href="/spravochnik/rasstoyanie-ot-kotlovana/" style="color:var(--yellow)">материале о расстоянии от котлована</a>.</p>
    <p>Под опоры КС-55713-1К «Клинцы» нужен контур 4,9 × 6,1 м на плотном основании: свежая отсыпка и вынутый из ямы грунт для этого не годятся. Кольца МОСКРАН-СЕРВИС советует выгружать в зоне досягаемости стрелы, чтобы не переставлять кран; по п. 8.2 ГОСТ 8020-2016 стеновые кольца складируют не выше двух рядов. Про въезд на участок — в <a href="/spravochnik/avtokran-dlya-chastnogo-doma/" style="color:var(--yellow)">материале об автокране для частного дома</a>.</p>

    <h2 id="stoimost" style="margin:36px 0 16px">Сколько стоит смена</h2>
    <p>Смена 8 часов автокрана класса 16–20 т в МОСКРАН-СЕРВИС стоит 17 600 ₽ при ставке 2 200 ₽ в час, класса 25 т — 20 800 ₽ при ставке 2 600 ₽. Разница 3 200 ₽ оправдана, когда вылет больше 15 м или в проекте кольца КС 25-9 по 2,7 т. Для одного колодца из КС 10-9 рядом с проездом достаточно младшего класса.</p>
    <p>Манипулятор привозит и ставит кольца одной машиной, но его вылет с грузом 1–1,5 т заметно меньше, чем у автокрана. МОСКРАН-СЕРВИС манипуляторы в собственном парке не держит и подбирает их через партнёров; когда выгоднее каждая машина, разобрано в <a href="/spravochnik/avtokran-ili-kran-manipulyator/" style="color:var(--yellow)">сравнении автокрана и крана-манипулятора</a>.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: кольца колодца и автокран</h2>
    <ul>
      <li>КС 10-9 — 0,6 т, КС 15-9 — 1 т, КС 20-9 — 1,47 т, КС 25-9 — 2,7 т (каталог завода ЖБИ).</li>
      <li>Строповка — трубой 48–55 мм через монтажные отверстия (п. 8.3 ГОСТ 8020-2016); сбрасывать кольца нельзя (п. 8.4).</li>
      <li>Класс крана определяет вылет: 1,47 т на 14 м — это 20,6 т·м.</li>
      <li>Смена в МОСКРАН-СЕРВИС: 16–20 т — 17 600 ₽, 25 т — 20 800 ₽.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://meganorm.ru/Data2/1/4293749/4293749631.htm" target="_blank" rel="noopener" style="color:var(--yellow)">ГОСТ 8020-2016 «Конструкции бетонные и железобетонные для колодцев канализационных, водопроводных и газопроводных сетей»</a> — введён 01.07.2017 взамен ГОСТ 8020-90; п. 8.2–8.4 (складирование, строповка, запрет сбрасывания).</li>
      <li><a href="https://skladgbi.ru/catalog/product/ks_20-9_gost_8020-2016/" target="_blank" rel="noopener" style="color:var(--yellow)">Кольца стеновые КС по ГОСТ 8020-2016 — каталог завода ЖБИ</a> — размеры и масса КС 10-9, КС 15-9, КС 20-9, КС 20-12, КС 25-9.</li>
      <li><a href="https://www.avtocrane.by/katalog-produkcii/avtokrany-klincy/25-tonn/ks-55713-1k-klincy" target="_blank" rel="noopener" style="color:var(--yellow)">КС-55713-1К «Клинцы» — карточка официального дилера</a> — грузовой момент 85 т·м, опорный контур 4,9 × 6,1 м.</li>
      <li><a href="https://sudact.ru/law/prikaz-rostekhnadzora-ot-26112020-n-461-ob/federalnye-normy-i-pravila-v/vi/ustanovka-ps-i-proizvodstvo-rabot/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461, раздел VI «Установка ПС и производство работ» (ред. от 16.04.2026)</a> — п. 108–110.</li>
    </ul>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-16-25-tonn/">Аренда автокрана 16–25 тонн →</a></section>
</main>
</SpravochnikLayout>
