---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';
import Sources from '../../../components/Sources.astro';

const title = 'Когда ППР обязателен для крана и кто его утверждает';
const description = 'ППРк обязателен для любого объекта, где применяется грузоподъёмный кран — работать без него запрещено. Кто разрабатывает и утверждает документ.';

const CHECKED = '12.08.2026';

const faqs = [
  { q: 'ППР нужен даже для разовой разгрузки фуры краном?', a: 'Да, формально ППРк обязателен на любом объекте, где применяется грузоподъёмное сооружение — работать краном без него запрещено вне зависимости от масштаба задачи. На практике для типовых кратковременных операций используется типовой ППР, разработанный заранее под стандартные сценарии, а не индивидуальный документ на каждую разгрузку.' },
  { q: 'Кто отвечает за качество ППР?', a: 'Ответственность за качество и соответствие требованиям промышленной безопасности несёт разработчик документа. Утверждает ППР организация, эксплуатирующая грузоподъёмное сооружение.' },
  { q: 'Есть ли исключения, когда ППР не требуется?', a: 'Да — для подъёмных устройств с ручным приводом, лифтов, эскалаторов, погрузчиков, техники на судах и в шахтах, а также манипуляторов, используемых в технологических процессах. Для стреловых автокранов и башенных кранов, о которых мы пишем на этом сайте, исключений нет.' },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'ППР для крана', item: 'https://moskran-servis.ru/spravochnik/ppr-dlya-krana/' },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@id': 'https://moskran-servis.ru/#organization' }, // ссылка на единственный узел организации (BaseLayout): отдельный узел с тем же @id, но другим name, был противоречием в графе
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: 'https://moskran-servis.ru/spravochnik/ppr-dlya-krana/',
  inLanguage: 'ru-RU',
  datePublished: '2026-08-12',
  dateModified: '2026-08-12',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<SpravochnikLayout title={title} description={description} path="/spravochnik/ppr-dlya-krana/" slug="ppr-dlya-krana" ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>ППР для крана</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Разбор для заказчика</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">ППР для крана — когда обязателен проект производства работ</h1>
    <p class="ref-byline">Инженерная служба МОСКРАН-СЕРВИС · обновлено в 2026 году</p>

    <p>На странице услуги «Автокраны 16–25 тонн» мы упоминали, что для типовых операций достаточно технологической карты, а полноценный ППР требуется не всегда. Здесь разбираем подробно, что это за документ и когда он действительно обязателен.</p>

    <h2 style="margin:36px 0 16px">Что такое ППРк</h2>
    <p>Проект производства работ кранами (ППРк) — документ, определяющий безопасные условия и технологию выполнения работ с применением грузоподъёмного крана на конкретном объекте: расположение техники, опасные зоны, порядок перемещения грузов. Разрабатывается согласно требованиям СП 48.13330.2019 «Организация строительства» и Приказу Ростехнадзора №461 от 26.11.2020.</p>

    <h2 style="margin:36px 0 16px">Когда ППРк обязателен</h2>
    <p>На всех объектах, где применяется любое грузоподъёмное сооружение, должен быть разработан и утверждён ППРк. Работать краном без него запрещено — это не рекомендация, а прямое требование. Документ утверждает организация, эксплуатирующая кран, а ответственность за его качество и соответствие нормам несёт разработчик.</p>

    <h2 style="margin:36px 0 16px">Исключения</h2>
    <p>ППРк не требуется для подъёмных устройств с ручным приводом, лифтов, эскалаторов, электро- и автопогрузчиков, техники, установленной на судах и в шахтах, а также манипуляторов, используемых в технологических процессах. Для стреловых автокранов и башенных кранов — основной техники этого сайта — исключений нет.</p>

    <h2 style="margin:36px 0 16px">Типовой ППР для повторяющихся сценариев</h2>
    <p>Для типовых кратковременных операций (разгрузка, разовый подъём некритичного груза) на практике применяется заранее разработанный типовой ППР под стандартный сценарий, а не индивидуальный проект под каждую отдельную заявку — это ускоряет процесс, не снижая требований безопасности. Индивидуальный проект разрабатывается для нестандартных задач: работа на стеснённой площадке, рядом с ЛЭП, вблизи котлована, на увеличенном вылете.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: что запомнить</h2>
    <ul>
      <li>ППРк обязателен для любого объекта с применением грузоподъёмного крана — без исключений для этого класса техники.</li>
      <li>Утверждает документ эксплуатирующая кран организация, отвечает за качество — разработчик.</li>
      <li>Для типовых операций применяется типовой ППР, для нестандартных задач — индивидуальный проект.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <Sources
      checked={CHECKED}
      items={[
        { text: 'trudohrana.ru — проект производства работ кранами', href: 'https://www.trudohrana.ru/article/104857-25-m10-proekt-proizvodstva-rabot-kranami-2025-trebovaniya-i-obrazets' },
        { text: 'ppr.expert — что такое ППР с применением подъёмных сооружений', href: 'https://www.ppr.expert/spravochnik/ppr-na-otdelnye-vidy-rabot/chto-takoe-proekt-proizvodstva-rabot-kranami/' }
      ]}
    />
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-16-25-tonn/">Подробнее об услуге →</a></section>
</main>
</SpravochnikLayout>
