---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = 'Осмотр стропов и траверс: сроки и журнал по ФНП №461';
const description = 'Стропы осматривают каждые 10 дней, траверсы, клещи и захваты — раз в месяц (п. 224 ФНП №461). Результат вносят в журнал осмотра по п. 225.';

const CHECKED = '11.10.2026';
const PUBLISHED = '2026-10-11';
const SLUG = 'osmotr-stropov-i-traverc-fnp-461';
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: 'Как часто нужно осматривать стропы по ФНП №461?',
    a: 'Каждые 10 дней. Пункт 224 ФНП №461 устанавливает для стропов осмотр раз в 10 дней, для траверс, клещей, захватов и тары — раз в месяц, а для приспособлений, которыми пользуются реже одного раза в 10 дней, — перед началом работ. МОСКРАН-СЕРВИС ведёт эти сроки по журналу осмотра.',
  },
  {
    q: 'Чем осмотр отличается от испытания стропа?',
    a: 'Осмотр — проверка состояния без нагрузки по браковочным показателям, испытание — нагружение. Статическая нагрузка 125 % от паспортной грузоподъёмности по п. 222 ФНП №461 нужна после ремонта приспособления, а не каждые 10 дней. Регулярный осмотр стропа МОСКРАН-СЕРВИС оформляет записью в журнале.',
  },
  {
    q: 'Кто обязан осматривать стропы перед подъёмом?',
    a: 'Стропальщик и крановщик. По п. 219 ФНП №461 они осматривают грузозахватные приспособления перед применением и пользуются браковочными показателями из руководства по эксплуатации. Периодический осмотр по п. 224 проводит назначенный инженерно-технический работник эксплуатирующей организации.',
  },
  {
    q: 'Нужно ли записывать в журнал осмотр пакетирующего стропа на грузе?',
    a: 'Нет. Пункт 225 ФНП №461 освобождает от записи в журнал оценку состояния пакетирующих стропов, которые находятся на запакетированном грузе. Проверку при этом всё равно проводят перед каждым подъёмом пакета: подъём на 100–200 мм и выдержка не менее 30 секунд по п. 224.',
  },
  {
    q: 'Можно ли работать стропом без маркировки?',
    a: 'Нет. Пункт 218 ФНП №461 требует, чтобы приспособления, признанные негодными, в том числе из-за отсутствия маркировки, не находились в местах производства работ с краном. МОСКРАН-СЕРВИС не принимает в работу строп без бирки с грузоподъёмностью и номером.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Осмотр стропов и траверс по ФНП №461', item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ['sroki', 'Сроки осмотра: стропы 10 дней, траверсы месяц'],
  ['pered-podyomom', 'Осмотр перед подъёмом: стропальщик и крановщик'],
  ['zhurnal', 'Журнал осмотра: что вносят и что нет'],
  ['pakety', 'Пакетирующие стропы: подъём на 100–200 мм'],
  ['negodnye', 'Негодный строп: изъять и не держать на площадке'],
  ['revizii', 'Ревизия и ремонт: раз в год и после ремонта'],
  ['zakazchik', 'Если стропы заказчика: что показать до подъёма'],
  ['faq', 'Частые вопросы'],
  ['istochniki', 'Источники'],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Осмотр стропов и траверс по ФНП №461</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">ФНП №461 · Грузозахватные приспособления</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Как часто осматривать стропы и траверсы и что записывать в журнал по ФНП №461?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>11.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>11.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>6 мин чтения</span>
    </div>

    <p>Пункт 224 ФНП №461 требует осматривать стропы каждые 10 дней, а траверсы, клещи, захваты и тару — каждый месяц; результат вносят в журнал осмотра по п. 225. Перед каждым подъёмом строп осматривают ещё и стропальщик с крановщиком (п. 219). МОСКРАН-СЕРВИС выделяет три разных проверки: ежедневный осмотр перед подъёмом, периодический осмотр по журналу и испытание после ремонта.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="sroki" style="margin:36px 0 16px">Сроки осмотра: стропы 10 дней, траверсы месяц</h2>
    <p>Пункт 224 ФНП №461 разделяет грузозахватные приспособления на три группы по частоте применения. Стропы осматривают каждые 10 дней, траверсы, клещи, захваты и тару — каждый месяц, а приспособления, которые используют реже одного раза в 10 дней, — перед началом работ. МОСКРАН-СЕРВИС считает срок от даты последней записи в журнале осмотра: строп, осмотренный 1 октября, подлежит следующему осмотру не позже 11 октября.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Что осматривают</th><th>Периодичность</th><th>Норма</th></tr></thead>
        <tbody>
          <tr><td>Стропы</td><td>каждые 10 дней</td><td>п. 224</td></tr>
          <tr><td>Траверсы, клещи, захваты, тара</td><td>каждый месяц</td><td>п. 224</td></tr>
          <tr><td>Редко применяемые приспособления</td><td>перед началом работ</td><td>п. 224</td></tr>
          <tr><td>Любое приспособление</td><td>перед применением</td><td>п. 219</td></tr>
          <tr><td>Клещи, траверсы, захваты</td><td>ежегодная ревизия</td><td>п. 220</td></tr>
        </tbody>
      </table>
    </div>
    <p>Периодический осмотр по п. 224 выполняет инженерно-технический работник, назначенный эксплуатирующей организацией. В МОСКРАН-СЕРВИС порядок и браковочные показатели берут из руководства изготовителя, а при его отсутствии — из инструкции, утверждённой внутренним распорядительным актом. Нормы браковки канатных стропов разобраны в материале о <a href="/spravochnik/brakovka-kanatov/" style="color:var(--yellow)">браковке стальных канатов</a>.</p>

    <h2 id="pered-podyomom" style="margin:36px 0 16px">Осмотр перед подъёмом: стропальщик и крановщик</h2>
    <p>Пункт 219 ФНП №461 возлагает осмотр перед применением на стропальщиков и крановщиков (операторов) и требует пользоваться браковочными показателями из руководства по эксплуатации приспособления. Этот осмотр не заменяет периодический по п. 224 и не записывается в журнал построчно. Крановщик МОСКРАН-СЕРВИС откажется поднимать груз на стропе с оборванными прядями, узлом, изломом или стёртой биркой.</p>
    <p>Перед подъёмом стропальщик проверяет четыре вещи: наличие маркировки с грузоподъёмностью, целостность ветвей и коушей, состояние крюка с замком и соответствие стропа массе груза и углу между ветвями. Расчёт угла и натяжения ветвей показан в материале об <a href="/spravochnik/ugol-naklona-stropa/" style="color:var(--yellow)">угле наклона стропа</a>, а требования к самому работнику — в материале о <a href="/spravochnik/trebovaniya-k-stropalshchiku/" style="color:var(--yellow)">стропальщике</a>.</p>

    <h2 id="zhurnal" style="margin:36px 0 16px">Журнал осмотра: что вносят и что нет</h2>
    <p>Пункт 225 ФНП №461 прямо называет журнал осмотра грузозахватных приспособлений местом для результатов периодического осмотра съёмных приспособлений и тары. Текст нормы не перечисляет граф журнала, поэтому МОСКРАН-СЕРВИС ведёт запись по смыслу п. 224: дата осмотра, номер или маркировка приспособления, результат, фамилия осматривающего и решение об изъятии. Формат граф — инженерная практика, а не требование нормы.</p>
    <p>Из журнала исключена одна категория: пункт 225 не требует записывать оценку пакетирующих стропов, которые находятся на запакетированном грузе. Эти стропы проверяют перед каждым подъёмом пакета, и отдельной записи в журнале такая проверка не даёт. Остальные приспособления МОСКРАН-СЕРВИС вносит в журнал по каждому периодическому осмотру, иначе срок следующего осмотра нечем подтвердить.</p>

    <h2 id="pakety" style="margin:36px 0 16px">Пакетирующие стропы: подъём на 100–200 мм</h2>
    <p>Пакетирующий строп проверяют подъёмом самого пакета: груз по утверждённой схеме строповки поднимают на 100–200 мм от поверхности и выдерживают не менее 30 секунд (п. 224 ФНП №461). Если форма и целостность пакета за это время не изменились, строп признают годным к дальнейшему использованию. МОСКРАН-СЕРВИС применяет этот приём к пакетам труб, металлопроката и пиломатериалов.</p>
    <p>Правило работает только при утверждённой схеме строповки: без неё нечего сравнивать, и подъём пакета превращается в обычную строповку без проверки. Схемы для типовых грузов собраны в материале о <a href="/spravochnik/shemy-stropovki-gruzov/" style="color:var(--yellow)">схемах строповки грузов</a>, а погрузка длинномеров с двумя стропами — в материале о <a href="/spravochnik/pogruzka-razgruzka-avtomashin-avtokranom/" style="color:var(--yellow)">погрузке и разгрузке автомашин краном</a>.</p>

    <h2 id="negodnye" style="margin:36px 0 16px">Негодный строп: изъять и не держать на площадке</h2>
    <p>Пункт 218 ФНП №461 запрещает держать на месте работ с краном съёмные грузозахватные приспособления и тару, признанные негодными, в том числе из-за отсутствия маркировки, а также приспособления с истёкшим сроком службы. Пункт 224 добавляет: повреждённые при осмотре приспособления изымают из работы. МОСКРАН-СЕРВИС убирает такой строп с площадки, а не откладывает в сторону.</p>
    <p>Отдельное правило касается замены ветви. Ветвь многоветвевого стропа, разъёмное звено или крюк, поставленные взамен изношенных, обязаны иметь маркировку изготовителя, а в паспорте приспособления делают отметку о ремонте (п. 223). Для ветвей канатных стропов при замене коэффициент запаса не менее 6, для цепных — не менее 4, для текстильных круглопрядных — не менее 7 (п. 217). Тип стропа выбирают по материалу из <a href="/spravochnik/tekstilnye-stropy/" style="color:var(--yellow)">справочника о текстильных стропах</a>.</p>

    <h2 id="revizii" style="margin:36px 0 16px">Ревизия и ремонт: раз в год и после ремонта</h2>
    <p>Клещи, траверсы и захваты кроме ежемесячного осмотра проходят ежегодную частичную разборку, осмотр и ревизию по графику, утверждённому внутренним актом (п. 220 ФНП №461). Если на втулках или расчётных элементах находят трещины, применяют методы неразрушающего контроля. МОСКРАН-СЕРВИС совмещает ревизию с техническим освидетельствованием крана, как рекомендует тот же пункт.</p>
    <p>После ремонта приспособление нагружают статически: 125 % от паспортной грузоподъёмности для грузозахватного приспособления и 110 % от разности масс брутто и нетто для тары (п. 222). Строп, у которого заменили ветвь, повторно испытывают так же. Порядок испытаний и протокол описаны в материале об <a href="/spravochnik/traversy-ispytaniya/" style="color:var(--yellow)">испытаниях траверс</a>; периодичность осмотра траверс МОСКРАН-СЕРВИС берёт из п. 224 ФНП №461: каждый месяц.</p>

    <h2 id="zakazchik" style="margin:36px 0 16px">Если стропы заказчика: что показать до подъёма</h2>
    <p>Когда заказчик приносит собственные стропы, МОСКРАН-СЕРВИС просит до начала подъёма показать три вещи: маркировку с грузоподъёмностью, паспорт или копию сертификата и последнюю запись журнала осмотра с датой не старше 10 дней. Без записи строп считается неосмотренным и в работу не идёт. Это внутреннее правило МОСКРАН-СЕРВИС, построенное на п. 218, 219 и 224.</p>
    <p>Нормативное обоснование простое: если приспособление отсутствует, неработоспособно или не соответствует массе груза, эксплуатирующая организация не должна допускать работу (п. 251 ФНП №461, подпункт «е»). Другие основания отказа в допуске собраны в материале о <a href="/spravochnik/kogda-avtokran-ne-dopuskayut-k-rabote-fnp-461/" style="color:var(--yellow)">случаях, когда автокран не допускают к работе</a>. Для заказа техники используйте порядок из материала о <a href="/spravochnik/zayavka-na-avtokran/" style="color:var(--yellow)">заявке на автокран</a>.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: осмотр стропов и траверс</h2>
    <ul>
      <li>Стропы МОСКРАН-СЕРВИС осматривает каждые 10 дней, траверсы, клещи, захваты и тару — каждый месяц (п. 224 ФНП №461).</li>
      <li>Перед каждым подъёмом строп осматривают стропальщик и крановщик по браковочным показателям изготовителя (п. 219).</li>
      <li>Результат периодического осмотра МОСКРАН-СЕРВИС вносит в журнал осмотра; запись о пакетирующих стропах на грузе не нужна (п. 225).</li>
      <li>Пакетирующий строп проверяют подъёмом на 100–200 мм с выдержкой 30 секунд (п. 224).</li>
      <li>Негодный или немаркированный строп МОСКРАН-СЕРВИС убирает с площадки (п. 218).</li>
      <li>После ремонта приспособление испытывают нагрузкой 125 % от паспортной (п. 222).</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://www.consultant.ru/document/cons_doc_LAW_373321/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 (приказ Ростехнадзора от 26.11.2020 №461)</a> — п. 217 (коэффициенты запаса при замене ветвей), п. 218 (негодные приспособления), п. 219 (осмотр перед применением), п. 220 (ежегодная ревизия), п. 222 (испытание после ремонта), п. 223 (маркировка заменённых элементов), п. 224 (сроки осмотра, пакетирующие стропы), п. 225 (журнал осмотра).</li>
      <li><a href="https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 на legalacts.ru</a> — редакция от 16.04.2026, текст пунктов 217–225 и 251 сверен 11.10.2026.</li>
    </ul>
    <p class="small muted">Содержание граф журнала осмотра и внутренние правила приёма стропов заказчика — практика МОСКРАН-СЕРВИС, а не текст нормы. Браковочные показатели конкретного приспособления определяет руководство по его эксплуатации.</p>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-16-25-tonn/">Аренда автокрана 16–25 тонн →</a></section>
</main>
</SpravochnikLayout>
