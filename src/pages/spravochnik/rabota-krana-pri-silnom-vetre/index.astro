const title = 'Кран и сильный ветер: анемометр, паспортный предел и штормовое предупреждение';
const description = 'Скорость ветра, при которой кран обязан остановить работу, — не число из закона, а значение из паспорта машины. Когда обязателен анемометр и при чём тут штормовые предупреждения МЧС.';

const CHECKED = '11.09.2026';

const faqs = [
  { q: 'При какой скорости ветра кран должен остановить работу?', a: 'Единого числа в законе для всех кранов нет — предельную скорость ветра для рабочего состояния конкретной машины устанавливает завод-изготовитель и указывает в паспорте крана. На практике для автокранов ориентир — около 10–15 м/с в зависимости от парусности груза, для башенных кранов встречаются паспортные значения и выше, но это не универсальная норма, а характеристика конкретной модели.' },
  { q: 'Анемометр обязателен на любом кране?', a: 'Нет. Обязательным прибором он является для башенных, портальных и им подобных кранов с высотой до верха конструкции более 15 м — устройство должно автоматически подавать звуковой или световой сигнал при достижении скорости ветра, заданной в паспорте для рабочего состояния. Для автокранов анемометр по ФНП не обязателен, хотя многие операторы используют переносной прибор при работе в открытой местности.' },
  { q: 'Если МЧС объявило жёлтый уровень опасности из-за ветра, кран точно останавливают?', a: 'Формально предупреждение МЧС само по себе не является нормой промышленной безопасности, обязывающей остановить именно кран, — это метеорологическое предупреждение для населения и служб. Но заявленные в таких предупреждениях порывы (то есть кратковременные пики, а не средняя скорость) нередко превышают паспортный предел крана, поэтому на практике при жёлтом и тем более оранжевом уровне опасности высотные и крановые работы на объектах обычно приостанавливают заранее, не дожидаясь фактического порыва на площадке.' },
  { q: 'Что делать крановщику, если ветер усилился прямо во время подъёма груза?', a: 'Прекратить дальнейший подъём и по возможности как можно быстрее опустить груз на устойчивую опору или на землю, не оставляя его висящим на крюке, после чего перевести кран в нерабочее (для башенных кранов — «штормовое») положение согласно руководству по эксплуатации конкретной машины. Продолжать цикл строповки или перемещения груза при показаниях, приближающихся к паспортному пределу, нельзя.' },
];

