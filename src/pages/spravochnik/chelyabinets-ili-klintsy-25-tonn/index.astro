---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = 'Челябинец или Клинцы: какой автокран 25 тонн выбрать';
const description = 'КС-55732 «Челябинец»: стрела 24,5 м, крюк 25,2 м, 90 т·м, есть шасси 6×6. КС-55713-1К «Клинцы»: 21 м и 85 т·м, опоры уже. Смена обоих — 20 800 ₽.';

const CHECKED = '29.09.2026';
const PUBLISHED = '2026-09-29';
const SLUG = 'chelyabinets-ili-klintsy-25-tonn';
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: 'Какой 25-тонный кран выше поднимает: Челябинец или Клинцы?',
    a: 'Челябинец КС-55732 поднимает крюк на 25,2 м основной стрелой 24,5 м, КС-55713-1К «Клинцы» — на 21,6 м стрелой 21 м. С гуськом разница сохраняется: 31,7–34,7 м против 29,3 м. МОСКРАН-СЕРВИС предлагает Челябинец, когда высота крюка без гуська нужна больше 21 м.',
  },
  {
    q: 'Почему смена у обоих кранов стоит одинаково?',
    a: 'МОСКРАН-СЕРВИС тарифицирует автокраны по классу грузоподъёмности, а не по модели: оба крана относятся к классу 25 т со ставкой 2 600 ₽ в час. Минимальный заказ — смена 8 часов, то есть 20 800 ₽ за любую из двух машин. Выбор модели поэтому делается по задаче, а не по цене.',
  },
  {
    q: 'Какой кран лучше для узкого двора?',
    a: 'Для узкого двора важнее опорный контур: у КС-55713-1К «Клинцы» он 4,9 × 6,1 м, у Челябинца КС-55732 — 5,75 × 6,3 м. Разница 0,85 м по ширине иногда решает, встанет ли кран на все опоры между бордюром и газоном. МОСКРАН-СЕРВИС уточняет размеры проезда по схеме из заявки.',
  },
  {
    q: 'Есть ли у Челябинца версия повышенной проходимости?',
    a: 'Да, завод выпускает КС-55732 на шасси Урал NEXT и КАМАЗ-43118 с колёсной формулой 6×6, а исполнение на КАМАЗ-65115 имеет формулу 6×4. Полный привод помогает доехать по грунтовому подъезду, но не отменяет подготовленную площадку под опоры по ФНП №461. МОСКРАН-СЕРВИС уточняет подъезд до выбора шасси.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Челябинец или Клинцы', item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ['tablica', 'Характеристики рядом'],
  ['strela', 'Стрела и высота крюка'],
  ['opory', 'Опорный контур и узкие дворы'],
  ['shassi', 'Шасси и подъезд'],
  ['vybor', 'Какой кран под какую задачу'],
  ['faq', 'Частые вопросы'],
  ['istochniki', 'Источники'],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Челябинец или Клинцы</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Выбор техники · Класс 25 тонн</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Челябинец КС-55732 или Клинцы КС-55713: какой автокран на 25 тонн выбрать?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>29.09.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>29.09.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>5 мин чтения</span>
    </div>

    <p>Челябинец КС-55732 выигрывает по высоте: основная стрела 24,5 м поднимает крюк на 25,2 м против 21,6 м у КС-55713-1К «Клинцы». «Клинцы» компактнее на опорах — 4,9 × 6,1 м против 5,75 × 6,3 м, что важно в тесном дворе. МОСКРАН-СЕРВИС берёт за оба крана одинаково, 20 800 ₽ за смену, поэтому модель выбирают по высоте подъёма и месту установки.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="tablica" style="margin:36px 0 16px">Характеристики рядом</h2>
    <p>Грузоподъёмность у обеих машин одинаковая — 25 тонн, а различаются они стрелой, опорным контуром и шасси. Данные Челябинца КС-55732 взяты с сайта Челябинского механического завода для исполнения со стрелой 24,5 м, данные КС-55713-1К — из карточки официального дилера. МОСКРАН-СЕРВИС напоминает, что решающая цифра для конкретного подъёма — таблица грузоподъёмности из паспорта машины, которая приедет на объект.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Параметр</th><th>Челябинец КС-55732 (стрела 24,5 м)</th><th>«Клинцы» КС-55713-1К</th></tr></thead>
        <tbody>
          <tr><td>Грузовой момент</td><td>90 т·м</td><td>85 т·м</td></tr>
          <tr><td>Основная стрела</td><td>24,5 м</td><td>21 м</td></tr>
          <tr><td>Высота крюка без гуська</td><td>25,2 м</td><td>21,6 м</td></tr>
          <tr><td>Гусёк / высота с гуськом</td><td>7, 9 или 10 м / 31,7–34,7 м</td><td>7,5 м / 29,3 м</td></tr>
          <tr><td>Максимальный вылет</td><td>22,8 м</td><td>по паспорту исполнения</td></tr>
          <tr><td>Опорный контур</td><td>5,75 × 6,3 м</td><td>4,9 × 6,1 м</td></tr>
          <tr><td>Масса крана</td><td>21,0–21,4 т</td><td>20,2 т</td></tr>
          <tr><td>Шасси</td><td>КАМАЗ-65115 6×4, КАМАЗ-43118 или Урал NEXT 6×6</td><td>КАМАЗ-65115, 6×4</td></tr>
          <tr><td>Смена в МОСКРАН-СЕРВИС</td><td>20 800 ₽</td><td>20 800 ₽</td></tr>
        </tbody>
      </table>
    </div>

    <h2 id="strela" style="margin:36px 0 16px">Стрела и высота крюка</h2>
    <p>Разница в 3,5 м стрелы превращается в 3,6 м высоты крюка: 25,2 м у Челябинца КС-55732 против 21,6 м у КС-55713-1К «Клинцы». Для подачи груза на кровлю пятиэтажки с парапетом около 16 м нужна высота крюка с запасом 0,5 м по п. 114 ФНП №461 плюс груз и стропы. МОСКРАН-СЕРВИС в таком случае берёт Челябинец без гуська, а «Клинцы» поехали бы только с гуськом 7,5 м.</p>
    <p>Гусёк увеличивает высоту, но снижает грузоподъёмность и добавляет время на монтаж решётчатой секции на объекте. У Челябинца КС-55732 завод предлагает гусёк на выбор 7, 9 или 10 м с высотой крюка до 34,7 м, у КС-55713-1К — один вариант 7,5 м и 29,3 м. МОСКРАН-СЕРВИС предпочитает закрыть высоту основной стрелой, если это возможно; порядок расчёта описан в <a href="/spravochnik/podyom-gruza-na-kryshu-avtokranom/" style="color:var(--yellow)">материале о подъёме груза на крышу</a>.</p>

    <h2 id="opory" style="margin:36px 0 16px">Опорный контур и узкие дворы</h2>
    <p>КС-55713-1К «Клинцы» разворачивает опоры на 4,9 м в ширину, Челябинец КС-55732 — на 5,75 м, и в московском дворе эти 0,85 м часто решают задачу. ФНП №461 (п. 108–110) требует ставить стреловой кран на все выносные опоры, если руководство по эксплуатации не допускает иного, и выдерживать не менее 1 м до строений. МОСКРАН-СЕРВИС по схеме проезда проверяет, помещаются ли опоры на твёрдом покрытии, прежде чем назначить модель.</p>
    <p>Опоры на газон ставить нельзя даже частично: в Москве это штраф по ст. 8.25 КоАП города и слабое основание под нагрузку. Если Челябинец КС-55732 не встаёт на асфальт по ширине, МОСКРАН-СЕРВИС предлагает «Клинцы» или кран с более длинной стрелой, который работает с проезда. Подробности — в <a href="/spravochnik/avtokran-na-gazone-v-moskve/" style="color:var(--yellow)">материале об автокране на газоне</a> и <a href="/spravochnik/ustoychivost-krana/" style="color:var(--yellow)">материале об устойчивости крана</a>.</p>

    <h2 id="shassi" style="margin:36px 0 16px">Шасси и подъезд</h2>
    <p>Челябинский механический завод выпускает КС-55732 на трёх шасси: КАМАЗ-65115 с формулой 6×4, КАМАЗ-43118 и Урал NEXT с формулой 6×6. Полноприводная версия проходит по грунтовому подъезду к коттеджу или раннему котловану, где заднеприводная машина буксует. КС-55713-1К «Клинцы» в карточке дилера описан на КАМАЗ-65115 6×4 — для города с асфальтом этого достаточно, и МОСКРАН-СЕРВИС исходит из состояния подъезда.</p>
    <p>Проходимость отвечает на вопрос «доехать», а не «встать под нагрузку»: ФНП №461 запрещает устанавливать кран на свеженасыпанном неутрамбованном грунте. Полный привод Челябинца КС-55732 не заменяет подготовку площадки под опоры и подкладки. МОСКРАН-СЕРВИС разбирает требования к основанию в <a href="/spravochnik/nesushchaya-sposobnost-grunta/" style="color:var(--yellow)">материале о несущей способности грунта</a>.</p>

    <h2 id="vybor" style="margin:36px 0 16px">Какой кран под какую задачу</h2>
    <p>Челябинец КС-55732 выбирают, когда нужна высота крюка больше 21 м без гуська, вылет до 22,8 м или грунтовый подъезд под машину 6×6. КС-55713-1К «Клинцы» выбирают для разгрузки у склада, монтажа на один-два этажа и тесных дворов, где опорный контур 4,9 м вписывается, а 5,75 м — нет. МОСКРАН-СЕРВИС сравнивает оба варианта по схеме объекта, потому что смена у обоих одна — 20 800 ₽.</p>
    <p>Если высоты и вылета 25-тонника не хватает, следующий шаг — не Челябинец с длинным гуськом, а другой класс: XCMG QY25K5-I со стрелой до 38,5 м за те же 20 800 ₽ или 50-тонный кран за 31 200 ₽ в смену. МОСКРАН-СЕРВИС разбирает эти варианты в <a href="/spravochnik/klintsy-ili-xcmg-25-tonn/" style="color:var(--yellow)">сравнении «Клинцы» и XCMG</a> и в <a href="/spravochnik/avtokran-25-ili-50-tonn/" style="color:var(--yellow)">материале о выборе между 25 и 50 тоннами</a>.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: Челябинец или Клинцы</h2>
    <ul>
      <li>Челябинец КС-55732: стрела 24,5 м, крюк 25,2 м, 90 т·м, есть шасси 6×6.</li>
      <li>КС-55713-1К «Клинцы»: стрела 21 м, крюк 21,6 м, 85 т·м, опоры 4,9 × 6,1 м.</li>
      <li>Нужна высота без гуська — Челябинец; тесный двор — «Клинцы».</li>
      <li>Смена обоих в МОСКРАН-СЕРВИС — 20 800 ₽.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://www.cmz.ru/catalogue/avtokrany/ks-55732-25-24_kamaz-65115/" target="_blank" rel="noopener" style="color:var(--yellow)">КС-55732 «СТ» на шасси КАМАЗ-65115, стрела 24,5 м — Челябинский механический завод</a> — 90 т·м, крюк 25,2 м, вылет 22,8 м, опоры 5,75 × 6,3 м, 21,4 т, гусёк 7/9/10 м.</li>
      <li><a href="https://www.cmz.ru/catalogue/avtokrany/ks-55732-25-24_ural-4320/" target="_blank" rel="noopener" style="color:var(--yellow)">КС-55732 «СТ» на шасси Урал NEXT — Челябинский механический завод</a> — формула 6×6, масса 21,0 т.</li>
      <li><a href="https://www.cmz.ru/catalogue/avtokrany/ks-55732-25-24_kamaz-43118/" target="_blank" rel="noopener" style="color:var(--yellow)">КС-55732 «СТ» на шасси КАМАЗ-43118 — Челябинский механический завод</a>.</li>
      <li><a href="https://www.avtocrane.by/katalog-produkcii/avtokrany-klincy/25-tonn/ks-55713-1k-klincy" target="_blank" rel="noopener" style="color:var(--yellow)">КС-55713-1К «Клинцы» — карточка официального дилера</a> — 85 т·м, стрела 21 м, крюк 21,6 / 29,3 м, опоры 4,9 × 6,1 м, 20,2 т.</li>
      <li><a href="https://sudact.ru/law/prikaz-rostekhnadzora-ot-26112020-n-461-ob/federalnye-normy-i-pravila-v/vi/ustanovka-ps-i-proizvodstvo-rabot/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461, раздел VI (ред. от 16.04.2026)</a> — п. 108–110, 114.</li>
    </ul>
  </article>
  <section class="section wrap"><a class="btn" href="/park/chelyabinets-ks-55732/">Челябинец КС-55732 в парке МОСКРАН-СЕРВИС →</a></section>
</main>
</SpravochnikLayout>
