---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = 'Укладка дорожных плит автокраном: масса, вылет, класс крана';
const description = 'Плита ПДН 6×2 м весит 4,2 т, 2П60-30-30 — 6,28 т. Какой вылет держит кран 25 т с моментом 85 т·м и когда нужен класс 32 т — расчёт с примером.';

const CHECKED = '04.10.2026';
const PUBLISHED = '2026-10-04';
const SLUG = 'ukladka-dorozhnyh-plit-avtokranom';
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: 'Сколько весит дорожная плита 6×2 м?',
    a: 'Плита ПДН 6000 × 2000 × 140 мм весит 4 200 кг, объём бетона 1,68 м³ — данные каталога завода okgbi.ru. Более толстая плита ПАГ-20 тех же 6 × 2 м, но высотой 200 мм, весит 6 т. МОСКРАН-СЕРВИС берёт массу из паспорта партии на заводской бирке, а не из справочной таблицы.',
  },
  {
    q: 'Какой автокран нужен для укладки плит 6×2 м?',
    a: 'Для ПДН 4,2 т на вылете до 12 м хватает КС-55713-1К «Клинцы» класса 25 т: 4,2 × 12 = 50,4 т·м при моменте 85 т·м. Кран 16 т с моментом 48 т·м проходит только до 11,4 м. МОСКРАН-СЕРВИС ставит 25 т по умолчанию, если плиты кладутся со стороны, а не под стрелой.',
  },
  {
    q: 'Сколько плит 6×2 м помещается на один автомобиль?',
    a: 'Полуприцеп грузоподъёмностью 14 т везёт три плиты 6 × 2 м общей массой 12,6 т, то есть 36 м² покрытия — расчёт справочника beton96.com. На 60 м временной дороги шириной 4 м нужно 20 плит, это 7 рейсов.',
  },
  {
    q: 'Можно ли класть плиты без расчёта по моменту?',
    a: 'Нельзя: допустимая масса зависит от вылета, а кран по ФНП №461 п. 108 ставится на подготовленную площадку с известными опорами. МОСКРАН-СЕРВИС делит момент крана на массу плиты только для отсева и сверяет итог с таблицей паспорта конкретной машины.',
  },
  {
    q: 'Почему плиту нельзя оставить на весу при перерыве?',
    a: 'ФНП №461 п. 114: по окончании работ на грузозахватном органе не должно находиться подвешенного груза. Для укладки плит МОСКРАН-СЕРВИС выстраивает цикл так, чтобы плита всегда опускалась на основание до остановки крана, а строп снимался стропальщиком.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Укладка дорожных плит автокраном', item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ['massy', 'Масса плит по каталогу'],
  ['moment', 'Вылет и грузовой момент'],
  ['primer', 'Пример: временная дорога 60 м'],
  ['osnovanie', 'Основание под плиты и под кран'],
  ['vybor', 'Какой класс крана брать'],
  ['faq', 'Частые вопросы'],
  ['istochniki', 'Источники'],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Укладка дорожных плит автокраном</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Монтаж · Дорожные плиты</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Как уложить дорожные плиты автокраном: какая масса, вылет и класс крана?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>04.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>04.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>6 мин чтения</span>
    </div>

    <p>Дорожная плита ПДН 6000 × 2000 × 140 мм весит 4,2 т. На вылете 12 м она создаёт момент 50,4 т·м, а КС-55713-1К «Клинцы» класса 25 т имеет 85 т·м. МОСКРАН-СЕРВИС ставит такой кран на укладку временных дорог, если плиты опускаются не под стрелой, а со стороны.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="massy" style="margin:36px 0 16px">Масса плит по каталогу</h2>
    <p>Каталог завода ЖБИ okgbi.ru даёт для плиты ПДН 14 размером 6000 × 2000 × 140 мм массу 4 200 кг и объём 1,68 м³. Серия 3.503.1-91 — стандартная плита под постоянные и временные дороги. МОСКРАН-СЕРВИС сверил типоразмеры 04.10.2026 по таблице завода и отдельному справочнику масс beton96.com: расчёт 14-тонного полуприцепа с тремя плитами 6 × 2 м даёт 12,6 т, то есть те же 4,2 т на штуку.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Плита</th><th>Размеры, мм</th><th>Масса</th><th>Предельный вылет КС-55713-1К (85 т·м)</th></tr></thead>
        <tbody>
          <tr><td>1П18-15-10</td><td>1750 × 1500 × 160</td><td>1,03 т</td><td>82 м — ограничен стрелой 21 м</td></tr>
          <tr><td>ПДН 14</td><td>6000 × 2000 × 140</td><td>4,2 т</td><td>20,2 м — ограничен стрелой 21 м</td></tr>
          <tr><td>ПАГ-20</td><td>6000 × 2000 × 200</td><td>6 т</td><td>14,2 м</td></tr>
          <tr><td>2П60-30-30</td><td>6000 × 3000 × 140</td><td>6,28 т</td><td>13,5 м</td></tr>
        </tbody>
      </table>
    </div>

    <h2 id="moment" style="margin:36px 0 16px">Вылет и грузовой момент</h2>
    <p>Грузовой момент плиты ПДН 4,2 т равен массе на вылет и должен быть меньше момента крана. КС-55713-1К «Клинцы» развивает 85 т·м, а базовый КС-35714 «Ивановец» — 48 т·м, поэтому ПДН 4,2 т «Ивановец» держит до 11,4 м, а «Клинцы» — до 20,2 м. МОСКРАН-СЕРВИС использует деление как первичный отсев: таблица паспорта на длинной стреле даёт меньшую допустимую массу, чем простое деление.</p>
    <p>Для плиты 2П60-30-30 массой 6,28 т картина жёстче: на вылете 12 м момент равен 75,4 т·м, это 89 % возможностей «Клинцов» без запаса, а на 14 м получается 87,9 т·м — выше 85 т·м. Укладка трёхметровых плит на такой вылет требует перехода на класс 32 т, где КС-55729-1В-3 «Галичанин» даёт 102,4 т·м.</p>

    <h2 id="primer" style="margin:36px 0 16px">Пример: временная дорога 60 м</h2>
    <p>Дорога 60 × 4 м из ПДН — это 20 плит и 84 т. Она складывается из 10 рядов по две плиты 6 × 2 м. По расчёту справочника beton96.com три плиты занимают один 14-тонный полуприцеп, поэтому на объект приедут 7 рейсов. МОСКРАН-СЕРВИС рекомендует разгружать плиты прямо с борта на основание, а не на промежуточный склад: так каждая плита поднимается один раз.</p>
    <p>Кран 25 т МОСКРАН-СЕРВИС стоит на ходу дороги и кладёт каждую следующую плиту по мере продвижения: вылет остаётся 6–10 м, момент 25–42 т·м, запас по КС-55713-1К превышает вдвое. Смена 8 часов в МОСКРАН-СЕРВИС стоит 20 800 ₽ по ставке 2 600 ₽ в час. Сколько плит кран уложит за смену, зависит от подготовки основания и работы стропальщиков, поэтому честного числа здесь нет — его фиксируют на первой смене.</p>

    <h2 id="osnovanie" style="margin:36px 0 16px">Основание под плиты и под кран</h2>
    <p>ФНП №461 п. 108 требует подготовленное основание, и плита ПДН его не заменяет: она распределяет нагрузку, но под ней нужен подготовленный грунт или песчаная подсыпка. Требование к основанию под кран остаётся таким же: ФНП №461 п. 108–110 требует подготовленную площадку, а п. 109 — отступ от строений не менее 1 м. МОСКРАН-СЕРВИС описывает расчёт опорного давления в <a href="/spravochnik/nesushchaya-sposobnost-grunta/" style="color:var(--yellow)">материале о несущей способности грунта</a>.</p>
    <p>Плиты ПДН поставляются с монтажными петлями, а схему строповки задаёт завод или ППР. Угол между ветвями влияет на усилие в каждой ветви — расчёт показан в материале <a href="/spravochnik/ugol-naklona-stropa/" style="color:var(--yellow)">об угле наклона стропа</a>, а схемы подвеса — в <a href="/spravochnik/shemy-stropovki-gruzov/" style="color:var(--yellow)">справочнике по схемам строповки</a>. По окончании работ плита не остаётся на крюке: п. 114 ФНП №461 требует освободить грузозахватный орган.</p>

    <h2 id="vybor" style="margin:36px 0 16px">Какой класс крана брать</h2>
    <p>Класс 16 т за 17 600 ₽ в смену подходит для плит до 1,5 т при длине стрелы 8–18 м, но 4,2 т он держит только до 11,4 м. Класс 25 т за 20 800 ₽ закрывает ПДН на вылете до 20,2 м и ПАГ-20 до 14,2 м. Класс 32 т за 24 800 ₽ МОСКРАН-СЕРВИС предлагает для плит 2П60-30-30 и всех случаев, когда расчёт даёт более 85 % момента 25-тонного крана.</p>
    <p>МОСКРАН-СЕРВИС советует: если плиты складываются вдоль дороги по ходу крана, а подъезд короткий, обратите внимание на <a href="/spravochnik/avtokran-25-ili-32-tonny/" style="color:var(--yellow)">сравнение классов 25 и 32 тонны</a>. Полуприцеп с плитами заезжает в зону вылета, поэтому разгрузку согласуют с ответственным за безопасное производство работ краном до начала смены.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: дорожные плиты и автокран</h2>
    <ul>
      <li>ПДН 6 × 2 × 0,14 м — 4,2 т; ПАГ-20 — 6 т; 2П60-30-30 — 6,28 т.</li>
      <li>Предельный вылет для ПДН: «Ивановец» 11,4 м, «Клинцы» 20,2 м по грубой оценке момента.</li>
      <li>Три плиты 6 × 2 м — один 14-тонный полуприцеп (12,6 т).</li>
      <li>Смена в МОСКРАН-СЕРВИС: 16 т — 17 600 ₽, 25 т — 20 800 ₽, 32 т — 24 800 ₽.</li>
      <li>Груз не оставляют на крюке по окончании работ (ФНП №461 п. 114).</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://okgbi.ru/catalog/aerodromnye_plity/1pdn_14_p/" target="_blank" rel="noopener" style="color:var(--yellow)">Плита дорожная ПДН 14 — каталог завода</a> — 6000 × 2000 × 140 мм, 4 200 кг, 1,68 м³, серия 3.503.1-91.</li>
      <li><a href="https://okgbi.ru/enterprises/articles/razmery-dorozhnuh-plit/" target="_blank" rel="noopener" style="color:var(--yellow)">Размеры дорожных плит — таблица завода</a> — 1П18-15-10 (1,03 т), 2П60-30-30 (6,28 т), ПАГ-20 (6 т).</li>
      <li><a href="https://beton96.com/articles/post/ves-plity-pdn" target="_blank" rel="noopener" style="color:var(--yellow)">Вес плиты ПДН — справочник масс</a> — 3 плиты 6 × 2 м на полуприцепе, 12,6 т.</li>
      <li><a href="https://www.avtocrane.by/katalog-produkcii/avtokrany-klincy/25-tonn/ks-55713-1k-klincy" target="_blank" rel="noopener" style="color:var(--yellow)">КС-55713-1К «Клинцы» — карточка официального дилера</a> — 85 т·м.</li>
      <li><a href="https://uzst.ru/tech/avtokrany-i-specztexnika-s-kmu/avtokrany-ural/avtokrany-ivanovec/ural-ks-35714-ivanovecz-16-t" target="_blank" rel="noopener" style="color:var(--yellow)">КС-35714 «Ивановец» — технические данные завода</a> — 48 т·м.</li>
      <li><a href="https://sudact.ru/law/prikaz-rostekhnadzora-ot-26112020-n-461-ob/federalnye-normy-i-pravila-v/vi/ustanovka-ps-i-proizvodstvo-rabot/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461, раздел VI «Установка ПС и производство работ» (ред. от 16.04.2026)</a> — п. 108–110, 114.</li>
      <li><a href="/" style="color:var(--yellow)">Ставки МОСКРАН-СЕРВИС</a> — главная страница сайта, действуют до 17.02.2027.</li>
    </ul>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-25-40-tonn/">Аренда автокрана 25–40 тонн →</a></section>
</main>
</SpravochnikLayout>
