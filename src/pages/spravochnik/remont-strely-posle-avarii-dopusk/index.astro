---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';
import Sources from '../../../components/Sources.astro';

const title = 'Допуск крана к работе после ремонта стрелы';
const description = 'После перегруза, удара или деформации стрелы крану нужен не просто ремонт, а повторная экспертиза промышленной безопасности перед возвратом к эксплуатации.';

const CHECKED = '12.08.2026';

const faqs = [
  { q: 'Можно ли эксплуатировать кран сразу после ремонта стрелы своими силами?', a: 'Нет, если ремонт затрагивал несущие металлоконструкции секции стрелы. После такого ремонта требуется обращение в аккредитованную экспертную организацию, имеющую лицензию на проведение экспертизы промышленной безопасности — только по её заключению кран может вернуться к эксплуатации. Ремонт без последующей экспертизы означает эксплуатацию без документального подтверждения безопасности несущих элементов.' },
  { q: 'Какие повреждения требуют полноценного ремонта, а не мелкой правки?', a: 'При перегрузе, ударе или падении в металлоконструкции секции стрелы возникают остаточные деформации, смятие стенок, нарушение формы короба или перекос сопрягаемых элементов — это не устраняется простой рихтовкой и требует изготовления новых элементов секции, сварки и последующего контроля качества сварных швов.' },
  { q: 'Какие документы нужны для проведения экспертизы после ремонта?', a: 'Экспертной организации предоставляется паспорт технического устройства (или данные о грузоподъёмности, вылете стрелы, заводском номере и годе выпуска), а также документация о выполненном ремонте — объём замен, применённые материалы, протоколы контроля сварных соединений.' },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Ремонт стрелы после аварии', item: 'https://moskran-servis.ru/spravochnik/remont-strely-posle-avarii-dopusk/' },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@id': 'https://moskran-servis.ru/#organization' }, // ссылка на единственный узел организации (BaseLayout): отдельный узел с тем же @id, но другим name, был противоречием в графе
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: 'https://moskran-servis.ru/spravochnik/remont-strely-posle-avarii-dopusk/',
  inLanguage: 'ru-RU',
  datePublished: '2026-08-12',
  dateModified: '2026-08-12',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<SpravochnikLayout title={title} description={description} path="/spravochnik/remont-strely-posle-avarii-dopusk/" slug="remont-strely-posle-avarii-dopusk" ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Ремонт стрелы после аварии</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Разбор для заказчика</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Ремонт стрелы крана после аварии: как кран возвращают в работу</h1>
    <p class="ref-byline">Инженерная служба МОСКРАН-СЕРВИС · обновлено в 2026 году</p>

    <p>Мы уже писали про экспертизу промышленной безопасности как плановую процедуру и про её роль при модернизации крана. Отдельный случай — восстановление крана после аварии или инцидента с повреждением стрелы: здесь экспертиза не плановая, а обязательное условие возврата техники в эксплуатацию.</p>

    <h2 style="margin:36px 0 16px">Что происходит со стрелой при перегрузе или ударе</h2>
    <p>При перегрузе, ударе о препятствие или падении груза в металлоконструкции секции стрелы возникают остаточные деформации: смятие стенок короба, нарушение его геометрической формы, перекос сопрягаемых элементов в местах телескопирования. Такие повреждения не восстанавливаются простой правкой — они требуют инженерного расчёта, изготовления новых элементов секции взамен повреждённых и полного цикла сварочно-монтажных работ.</p>

    <h2 style="margin:36px 0 16px">Из чего состоит ремонт</h2>
    <p>Процесс включает снятие точных замеров повреждённой секции, проработку конструкторской документации под конкретную модель крана, изготовление новых элементов, подготовку кромок под сварку (фасок), сборку, сварку, механическую зачистку швов и финишную окраску. Это не косметический, а полноценный производственный процесс — что и определяет реальные сроки простоя техники, обычно измеряемые неделями, а не днями.</p>

    <h2 style="margin:36px 0 16px">Экспертиза после ремонта — обязательный этап</h2>
    <p>После восстановительного ремонта несущих металлоконструкций кран не может вернуться к эксплуатации без экспертизы промышленной безопасности, проводимой аккредитованной организацией с соответствующей лицензией. На предварительном этапе экспертной организации предоставляется паспорт технического устройства с его характеристиками — грузоподъёмностью, вылетом стрелы, заводским номером и годом выпуска — а также полная документация о выполненном ремонте.</p>
    <p>Именно наличие действующего заключения экспертизы после ремонта — а не сам факт ремонта — является формальным подтверждением того, что кран безопасен для дальнейшей эксплуатации.</p>

    <h2 style="margin:36px 0 16px">Что это значит для заказчика, арендующего технику</h2>
    <p>Добросовестный арендодатель предоставляет заключение экспертизы промышленной безопасности по запросу — включая случаи, когда кран ранее проходил восстановительный ремонт после инцидента. Отсутствие готовности показать этот документ — повод насторожиться и уточнить историю обслуживания конкретной единицы техники до подписания договора аренды.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: что запомнить</h2>
    <ul>
      <li>Перегруз, удар или падение приводят к остаточным деформациям металлоконструкции стрелы, которые не устраняются рихтовкой.</li>
      <li>Ремонт включает изготовление новых элементов секции, сварку и контроль качества швов.</li>
      <li>После ремонта несущих узлов обязательна повторная экспертиза промышленной безопасности перед возвратом в работу.</li>
      <li>Заказчику стоит запрашивать заключение экспертизы, если есть основания полагать, что техника ранее проходила восстановительный ремонт.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <Sources
      checked={CHECKED}
      items={[
        { text: '1grc.ru — инженерное восстановление секций стрелы после перегруза и деформации', href: 'https://www.1grc.ru/post/remont-strel-avtokrana-inzhenernoe-vosstanovlenie-avarijnyh-sekczij-posle-peregruza-i-deformaczii' },
        { text: 'сервис АСТ — проведение ЭПБ грузоподъёмных кранов', href: 'https://xn--80akuqker.xn--p1ai/dopolnitelno/ekspertiza/epb-kranov' }
      ]}
    />
  </article>
  <section class="section wrap"><a class="btn" href="/spravochnik/ekspertiza-promyshlennoy-bezopasnosti/">Экспертиза промышленной безопасности крана →</a></section>
</main>
</SpravochnikLayout>
