---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = 'Монтаж панелей и витражей автокраном: требования ФНП №461';
const description = 'Витражи, фермы, перегородки и стеновые панели — работы в местах действия опасных факторов (п. 163 ФНП №461): нужны ППР и инженер-руководитель.';

const CHECKED = '09.10.2026';
const PUBLISHED = '2026-10-09';
const SLUG = 'montazh-stenovyh-paneley-i-vitrazhey-avtokranom';
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: 'Почему монтаж витражей и стеновых панелей считается опасной работой?',
    a: 'Пункт 163 ФНП №461 называет витражи, фермы, перегородки и стеновые панели конструкциями с большой парусностью и габаритами и относит их монтаж к работам в местах действия опасных факторов. МОСКРАН-СЕРВИС поэтому требует ППР и руководителя работ на площадке даже при небольшой массе элемента.',
  },
  {
    q: 'Кто должен руководить монтажом панелей краном?',
    a: 'Работы ведут под непосредственным руководством инженерно-технического работника, ответственного за безопасное производство работ с применением ПС (п. 163). Назначает его заказчик или генподрядчик приказом. МОСКРАН-СЕРВИС просит указать фамилию и должность в заявке, чтобы свериться с документами до выезда.',
  },
  {
    q: 'Что относится к зоне примыкания к эксплуатируемым зданиям?',
    a: 'Пункт 163 относит к опасным и монтаж в зоне примыкания к эксплуатируемым зданиям и сооружениям — например, пристройку или надстройку к работающему дому. Как далеко эта зона простирается, определяет ППР конкретного объекта. МОСКРАН-СЕРВИС не называет универсальных метров и берёт границу из проекта.',
  },
  {
    q: 'Нужен ли второй кран для установки длинной панели или фермы?',
    a: 'Не всегда: решает масса, длина и схема строповки. Если нужны два крана, пункт 127 разрешает совместный подъём только по ППР или технологической карте, а пункт 160 требует расстояние между кранами и грузами не менее 5 м. МОСКРАН-СЕРВИС оценивает такую схему отдельно до заказа.',
  },
  {
    q: 'Какой ветер допустим при монтаже витража?',
    a: 'Единого числа в ФНП нет: выписку о силе ветра, при которой работа ПС не допускается, включают в ППР из паспорта машины (п. 159, подпункт «ж»). Для парусных элементов МОСКРАН-СЕРВИС ждёт запаса от паспортного предела. Подробности — в материале о работе крана при сильном ветре.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Монтаж стеновых панелей и витражей автокраном', item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ['pochemu-opasno', 'Почему такие конструкции особая категория'],
  ['ppr', 'Что должно быть в ППР'],
  ['rukovoditel', 'Кто руководит монтажом'],
  ['dva-krana', 'Когда нужен второй кран'],
  ['veter', 'Ветер и парусность'],
  ['stoimost', 'Подбор тоннажа и стоимость смены'],
  ['faq', 'Частые вопросы'],
  ['istochniki', 'Источники'],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Монтаж стеновых панелей и витражей автокраном</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">ФНП №461 · Монтаж конструкций</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Какие требования действуют при монтаже стеновых панелей и витражей автокраном?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>09.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>09.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>5 мин чтения</span>
    </div>

    <p>Пункт 163 ФНП №461 относит монтаж витражей, ферм, перегородок и стеновых панелей, а также любой монтаж рядом с эксплуатируемыми зданиями к работам в местах действия опасных факторов: их проводят по ППР под непосредственным руководством инженера. МОСКРАН-СЕРВИС выезжает на такой монтаж только при наличии ППР и назначенного руководителя работ.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="pochemu-opasno" style="margin:36px 0 16px">Почему такие конструкции особая категория</h2>
    <p>В пункте 163 ФНП №461 перечень конструкций с большой парусностью и габаритами назван прямо: витражи, фермы, перегородки, стеновые панели. МОСКРАН-СЕРВИС объясняет заказчику причину просто: большая площадь элемента превращает ветер в боковую нагрузку на груз, а габарит затрудняет подход стропальщика и выверку положения. Масса при этом может быть умеренной, но риск остаётся.</p>
    <p>МОСКРАН-СЕРВИС выделяет вторую группу работ в том же пункте — монтаж в зоне примыкания к эксплуатируемым зданиям и сооружениям. Для Москвы это частый случай: пристройки, надстройки, реконструкция в плотной застройке. МОСКРАН-СЕРВИС относит такой объект к работам по пункту 163, даже если сам элемент не парусный.</p>

    <h2 id="ppr" style="margin:36px 0 16px">Что должно быть в ППР</h2>
    <p>Пункт 159 ФНП №461 перечисляет раздел ППР и технологических карт об организации безопасного производства работ с применением ПС. Для монтажа панелей МОСКРАН-СЕРВИС выделяет из него подпункты: условия перемещения груза над помещениями, где идут работы; выписка из паспорта о силе ветра, при которой работа не допускается; условия радиосвязи между крановщиком и стропальщиком; мероприятия при опасной зоне на пути транспорта и пешеходов.</p>
    <p>Если панели монтируют двумя кранами, МОСКРАН-СЕРВИС вносит в ППР и условия совместной работы нескольких ПС. Общий порядок составления документа описан в материале о <a href="/spravochnik/ppr-dlya-krana/" style="color:var(--yellow)">ППР для крана</a>, а границу зоны, куда нельзя заходить людям, — в материале об <a href="/spravochnik/opasnaya-zona-krana/" style="color:var(--yellow)">опасной зоне крана</a>.</p>

    <h2 id="rukovoditel" style="margin:36px 0 16px">Кто руководит монтажом</h2>
    <p>Пункт 163 требует непосредственного руководства инженерно-технического работника, ответственного за безопасное производство работ с применением ПС. МОСКРАН-СЕРВИС не заменяет эту роль крановщиком или стропальщиком: крановщик выполняет команды, а решение о начале подъёма в сложных условиях принимает руководитель работ. Заказчик назначает его приказом до выезда крана.</p>
    <p>Требования к квалификации и обязанности этого специалиста изложены в материале об <a href="/spravochnik/otvetstvennyy-za-bezopasnoe-proizvodstvo/" style="color:var(--yellow)">ответственном за безопасное производство работ</a>. Сигналы, которые МОСКРАН-СЕРВИС согласует между стропальщиком и крановщиком, описаны в материале о <a href="/spravochnik/signaly-stropalshchika/" style="color:var(--yellow)">сигналах стропальщика</a>.</p>

    <h2 id="dva-krana" style="margin:36px 0 16px">Когда нужен второй кран</h2>
    <p>Подъём груза несколькими подъёмными сооружениями пункт 127 ФНП №461 разрешает только по ППР или технологической карте, а нагрузка на каждый кран не должна превышать его грузоподъёмность. МОСКРАН-СЕРВИС применяет схему двух кранов для длинных ферм и крупных панелей, которые невозможно уравновесить одним крюком. Расстояние между кранами, их стрелами и грузами по пункту 160 должно быть не менее 5 м.</p>
    <p>МОСКРАН-СЕРВИС планирует работу двух машин заранее, потому что вылет, подъезд и площадки у каждой считаются отдельно. Подробно схема описана в материале о <a href="/spravochnik/podyom-gruza-dvumya-kranami/" style="color:var(--yellow)">подъёме груза двумя кранами</a>.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Условие</th><th>Что требует ФНП №461</th><th>Пункт</th></tr></thead>
        <tbody>
          <tr><td>Витражи, фермы, перегородки, стеновые панели</td><td>работа в месте действия опасных факторов: ППР и руководитель-инженер</td><td>163</td></tr>
          <tr><td>Монтаж в зоне примыкания к эксплуатируемому зданию</td><td>то же</td><td>163</td></tr>
          <tr><td>Предельный ветер для работы крана</td><td>выписка из паспорта в составе ППР</td><td>159 «ж»</td></tr>
          <tr><td>Подъём двумя кранами</td><td>только по ППР или ТК, нагрузка не выше грузоподъёмности каждого</td><td>127</td></tr>
          <tr><td>Два крана на одной площадке</td><td>не менее 5 м между кранами, стрелами и грузами</td><td>160</td></tr>
        </tbody>
      </table>
    </div>

    <h2 id="veter" style="margin:36px 0 16px">Ветер и парусность</h2>
    <p>Единой допустимой скорости ветра ФНП №461 не задаёт: пункт 159 требует включить в ППР выписку из паспорта крана о силе ветра, при которой работа не допускается. МОСКРАН-СЕРВИС берёт предел из паспорта конкретной машины и для парусных элементов оставляет запас, а при приближении к пределу прекращает подъём. Откуда берётся число, разобрано в материале о <a href="/spravochnik/rabota-krana-pri-silnom-vetre/" style="color:var(--yellow)">работе крана при сильном ветре</a>.</p>
    <p>МОСКРАН-СЕРВИС отделяет монтаж панелей от подъёма людей: люлька и работа на высоте — отдельные режимы со своими запретами; граница описана в материале о <a href="/spravochnik/podyom-lyudey-kranom/" style="color:var(--yellow)">подъёме людей краном</a>.</p>

    <h2 id="stoimost" style="margin:36px 0 16px">Подбор тоннажа и стоимость смены</h2>
    <p>Для подбора МОСКРАН-СЕРВИС нужны масса и габариты элемента, высота установки, расстояние от оси крана до стены и число элементов в смену. Вылет и высота подъёма определяют тоннаж по таблице грузовой характеристики; метод описан в материале о <a href="/spravochnik/gruzovysotnaya-harakteristika/" style="color:var(--yellow)">грузовысотной характеристике</a>, замер — в материале о том, <a href="/spravochnik/kak-opredelit-vylet-strely-avtokrana/" style="color:var(--yellow)">как определить вылет автокрана</a>.</p>
    <p>Смена 25 т стоит 20 800 ₽, 32 т — 24 800 ₽, 50 т — 31 200 ₽ (ставки 2 600, 3 100 и 3 900 ₽/ч × 8 ч). Если требуются два крана, стоимость суммируется по каждой машине. Заявку оформляют по порядку из материала о <a href="/spravochnik/zayavka-na-avtokran/" style="color:var(--yellow)">заявке на автокран</a>.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: монтаж панелей и витражей</h2>
    <ul>
      <li>Витражи, фермы, перегородки и стеновые панели — работа в месте действия опасных факторов (п. 163).</li>
      <li>Нужны ППР и инженерно-технический работник, руководящий непосредственно на площадке (п. 163).</li>
      <li>В ППР включают выписку из паспорта о предельном ветре (п. 159 «ж»).</li>
      <li>Два крана — только по ППР или ТК, расстояние не менее 5 м (п. 127, 160).</li>
      <li>Монтаж рядом с эксплуатируемым зданием попадает под ту же норму.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://www.consultant.ru/document/cons_doc_LAW_373321/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 (приказ Ростехнадзора от 26.11.2020 №461)</a> — п. 127: подъём груза несколькими ПС; п. 159: раздел ППР и ТК, выписка о силе ветра; п. 160: расстояние между совместно работающими ПС; п. 163: монтаж парусных конструкций и в зоне примыкания к эксплуатируемым зданиям.</li>
    </ul>
    <p class="small muted">Текст пунктов сверен с редакцией ФНП №461 на legalacts.ru 09.10.2026. Ставки — из калькулятора на главной странице. Границу зоны примыкания и допустимый ветер определяют ППР объекта и паспорт машины.</p>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-25-40-tonn/">Аренда автокрана 25–40 тонн →</a></section>
</main>
</SpravochnikLayout>
