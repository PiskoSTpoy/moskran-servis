---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = "Статическое испытание строп и захватов: п. 232 ФНП 461";
const description = "Стропы и захваты испытывают нагрузкой на 25% выше грузоподъёмности: подъём на 50–100 мм, выдержка от 10 минут, затем акт (пп. 232–234 ФНП №461).";

const CHECKED = '18.10.2026';
const PUBLISHED = '2026-10-18';
const SLUG = "staticheskoe-ispytanie-gruzozahvatnyh-prisposoblenij-fnp-461";
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    q: "На сколько процентов испытывают стропы выше грузоподъёмности?",
    a: "Статическая нагрузка при испытании превышает грузоподъёмность приспособления на 25% (п. 232 ФНП №461). Для стропа на 5 т это 6,25 т. МОСКРАН-СЕРВИС проверяет это число в протоколе.",
  },
  {
    q: "Сколько времени держат груз при статическом испытании?",
    a: "Груз поднимают на высоту 50–100 мм и выдерживают не менее 10 минут, затем опускают на площадку (п. 232 ФНП №461). МОСКРАН-СЕРВИС не принимает акт без указания выдержки.",
  },
  {
    q: "Что делать, если после испытания осталась деформация?",
    a: "Приспособление с остаточной деформацией, вызванной испытанием, к работе не допускается (п. 233 ФНП №461). Его направляют в ремонт или на утилизацию. МОСКРАН-СЕРВИС не возвращает такой строп в комплект.",
  },
  {
    q: "Нужен ли акт на испытание тары?",
    a: "Да, результаты испытания грузозахватных приспособлений и тары статической нагрузкой оформляют актом (протоколом) по п. 234 ФНП №461. МОСКРАН-СЕРВИС запрашивает акт и на тару, если она заказчика.",
  },
  {
    q: "Можно ли испытывать многоветвевой строп не под углом 90°?",
    a: "Допускается другой угол с соответствующим пересчётом испытательных нагрузок (п. 230 ФНП №461). Стандартная расстановка ветвей — 90° друг к другу. МОСКРАН-СЕРВИС просит пересчёт в акте, если угол иной.",
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: "Статическое испытание грузозахватных приспособлений по ФНП №461", item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [
  ["nagruzka", "Какая нагрузка и сколько держать"],
  ["rasschet", "Пример расчёта испытательной нагрузки"],
  ["rezultat", "Как читают результат и когда прекращают"],
  ["akt", "Что должно быть в акте"],
  ["moskva", "Акт для КС-55713 «Клинцы» на московской площадке"],
  ["faq", "Частые вопросы"],
  ["istochniki", "Источники"],
];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Статическое испытание грузозахватных приспособлений по ФНП №461</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">ФНП №461 · Грузозахватные приспособления</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Как проводят статическое испытание строп и захватов и что должно быть в акте?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>18.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>18.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>5 мин чтения</span>
    </div>

    <p>Статическое испытание грузозахватного приспособления по п. 232 ФНП №461 ведут нагрузкой на 25% больше его грузоподъёмности: груз поднимают на 50–100 мм и держат не менее 10 минут. Остаточная деформация закрывает допуск к работе, результат оформляют актом (протоколом). МОСКРАН-СЕРВИС требует такой акт на каждое чужое приспособление.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="nagruzka" style="margin:36px 0 16px">Какая нагрузка и сколько держать</h2>
    <p>Статическое испытание грузозахватного приспособления п. 232 ФНП №461 ведёт нагрузкой, превышающей его грузоподъёмность на 25%, то есть 1,25 от паспортного значения. Испытательный груз зацепляют (охватывают, обвязывают) самим приспособлением или подвешивают к нему. МОСКРАН-СЕРВИС при проверке документов находит это число в протоколе: меньшая нагрузка испытанием по ФНП не считается.</p>
    <p>Порядок в п. 232 состоит из двух действий: груз с возможно меньшими ускорениями поднимают на высоту 50–100 мм и выдерживают не менее 10 минут, затем опускают на площадку. Подъём «на ладонь» нужен, чтобы приспособление реально повисло, а не стояло на грунте. МОСКРАН-СЕРВИС не принимает акт, где высота или выдержка не указаны.</p>

    <h2 id="rasschet" style="margin:36px 0 16px">Пример расчёта испытательной нагрузки</h2>
    <p>Испытательная нагрузка равна грузоподъёмности приспособления, умноженной на 1,25, а время выдержки не зависит от массы. Для строп, траверс и захватов разной грузоподъёмности получается ряд значений ниже. Значения — арифметика по п. 232, а не отдельные нормативы; МОСКРАН-СЕРВИС использует их как контрольную сверку с протоколом.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Грузоподъёмность приспособления</th><th>Испытательная нагрузка (×1,25)</th><th>Подъём и выдержка</th></tr></thead>
        <tbody>
          <tr><td>2 т</td><td>2,5 т</td><td>50–100 мм, не менее 10 мин</td></tr>
          <tr><td>5 т</td><td>6,25 т</td><td>50–100 мм, не менее 10 мин</td></tr>
          <tr><td>10 т</td><td>12,5 т</td><td>50–100 мм, не менее 10 мин</td></tr>
          <tr><td>20 т</td><td>25 т</td><td>50–100 мм, не менее 10 мин</td></tr>
        </tbody>
      </table>
    </div>
    <p>Если испытательный груз зацепить нельзя, п. 231 требует в инструкции по испытаниям схему надёжного присоединения груза нужной массы к изделиям, для которых сделано приспособление; масса изделий входит в испытательный груз, а отклонение по массе не больше 3%. Для многоветвевых стропов ветви при испытании расставляют под 90° друг к другу (п. 230), что разобрано в материале о <a href="/spravochnik/raschet-mnogovetvevogo-stropa-avtokran-fnp-461/" style="color:var(--yellow)">расчёте многоветвевого стропа</a>. МОСКРАН-СЕРВИС сверяет схему с этим углом.</p>

    <h2 id="rezultat" style="margin:36px 0 16px">Как читают результат и когда прекращают</h2>
    <p>Результат статического испытания анализируют после снятия нагрузки: при остаточной деформации, вызванной испытанием, приспособление к работе не допускается (п. 233 ФНП №461). Смотрят именно на остаточную, а не на упругую деформацию под нагрузкой. МОСКРАН-СЕРВИС отбраковывает траверсу с прогибом, который не вернулся, даже если сертификат старый.</p>
    <p>Испытания прекращают или приостанавливают при аварийной ситуации, угрожающей людям, а продолжают только после устранения причин (п. 233). Аналогичная логика про испытания после ремонта описана в справке об <a href="/spravochnik/osmotr-stropov-i-traverc-fnp-461/" style="color:var(--yellow)">осмотре строп и траверс</a>: испытание по п. 222 выполняют после ремонта, а не по календарю. МОСКРАН-СЕРВИС ведёт отдельный журнал приостановок.</p>

    <h2 id="akt" style="margin:36px 0 16px">Что должно быть в акте</h2>
    <p>Результаты статического испытания грузозахватных приспособлений и тары оформляют актом (протоколом), и п. 234 ФНП №461 различает два содержания. При положительном результате акт подтверждает, что приспособление выдержало испытание, соответствует действующим паспорту и руководству по эксплуатации ПС и работоспособно. МОСКРАН-СЕРВИС просит этот текст в акте до допуска приспособления на площадку.</p>
    <p>При отрицательном результате в акте указывают выявленные дефекты и повреждения и вероятные причины, а приспособление или тару направляют в ремонт либо на утилизацию (п. 234). Проверка срока испытаний — часть осмотра, который описан в материале о <a href="/spravochnik/trebovaniya-k-stropalshchiku/" style="color:var(--yellow)">требованиях к стропальщику</a>. МОСКРАН-СЕРВИС отправляет стропу с отрицательным актом в отдельный контейнер, чтобы она не вернулась в работу.</p>

    <h2 id="moskva" style="margin:36px 0 16px">Акт для КС-55713 «Клинцы» на московской площадке</h2>
    <p>На московской стройке акт чаще всего запрашивают в двух случаях: при приёмке чужих траверс от субподрядчика и после ремонта своего строп-комплекта. Автокран КС-55713 «Клинцы» работает со стропами заказчика, поэтому МОСКРАН-СЕРВИС просит акт и маркировку до подъёма, а не после замечания надзора. Эта практика — не требование нормы, а способ не терять смену на остановку.</p>
    <p>П. 229 ФНП №461 добавляет, что необходимость, условия и способы испытаний в период эксплуатации определяют с учётом требований эксплуатационной документации изготовителя. МОСКРАН-СЕРВИС поэтому смотрит в паспорт приспособления, а не только в общий порядок п. 232.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: статическое испытание грузозахватных приспособлений</h2>
    <ul>
      <li>МОСКРАН-СЕРВИС принимает акт испытания на нагрузку 125% грузоподъёмности приспособления (п. 232 ФНП №461).</li>
      <li>МОСКРАН-СЕРВИС проверяет в акте подъём на 50–100 мм и выдержку не менее 10 минут.</li>
      <li>Приспособление с остаточной деформацией МОСКРАН-СЕРВИС к работе не допускает (п. 233).</li>
      <li>Отрицательный акт отправляет приспособление в ремонт или на утилизацию (п. 234).</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://www.consultant.ru/document/cons_doc_LAW_373321/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 (приказ Ростехнадзора от 26.11.2020 №461)</a> — пп. 229–234 (условия, схема присоединения груза, нагрузка +25%, подъём на 50–100 мм и выдержка 10 минут, остаточная деформация, акт), п. 222, п. 230.</li>
      <li><a href="https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 на legalacts.ru</a> — редакция от 16.04.2026, текст пунктов 229–234 сверен 18.10.2026.</li>
    </ul>
    <p class="small muted">Таблица нагрузок — арифметика по п. 232, не отдельный норматив. Практика запроса акта до подъёма — решение МОСКРАН-СЕРВИС, а не пункт нормы.</p>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-16-25-tonn/">Аренда автокрана 16–25 тонн →</a></section>
</main>
</SpravochnikLayout>
