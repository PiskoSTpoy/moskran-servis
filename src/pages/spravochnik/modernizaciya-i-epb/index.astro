---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';
import Sources from '../../../components/Sources.astro';

const title = 'Когда модернизация крана требует экспертизы промбезопасности';
const description = 'Модернизация, реконструкция и ремонт с заменой несущих элементов требуют последующей ЭПБ. Простой ремонт без изменения конструкции — не всегда.';

const CHECKED = '12.08.2026';

const faqs = [
  { q: 'Любой ремонт крана требует новой экспертизы промышленной безопасности?', a: 'Нет — простой ремонт без изменения конструкции не всегда требует ЭПБ. Экспертиза требуется, если ремонт связан с заменой материалов опорных и несущих элементов, либо вызван аварией, в результате которой крану были нанесены повреждения.' },
  { q: 'Чем модернизация отличается от ремонта с точки зрения документов?', a: 'Модернизация и реконструкция всегда предполагают изменение конструкции или характеристик крана — а значит, требуют экспертизы для подтверждения безопасности изменённого оборудования. Обычный ремонт может ограничиваться заменой изношенных деталей на аналогичные без изменения конструкции — тогда экспертиза не обязательна.' },
  { q: 'Какие документы нужны для проведения экспертизы после модернизации?', a: 'Документы, оформленные в ходе и по результатам ремонта, реконструкции или модернизации, включая сертификаты на использованные материалы, детали и конструкции — без них экспертная организация не может подтвердить соответствие изменённого крана требованиям безопасности.' },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Модернизация и ЭПБ', item: 'https://moskran-servis.ru/spravochnik/modernizaciya-i-epb/' },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@id': 'https://moskran-servis.ru/#organization' }, // ссылка на единственный узел организации (BaseLayout): отдельный узел с тем же @id, но другим name, был противоречием в графе
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: 'https://moskran-servis.ru/spravochnik/modernizaciya-i-epb/',
  inLanguage: 'ru-RU',
  datePublished: '2026-08-12',
  dateModified: '2026-08-12',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<SpravochnikLayout title={title} description={description} path="/spravochnik/modernizaciya-i-epb/" slug="modernizaciya-i-epb" ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Модернизация и ЭПБ</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Разбор для заказчика</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Модернизация крана и экспертиза промышленной безопасности — когда одно требует другого</h1>
    <p class="ref-byline">Инженерная служба МОСКРАН-СЕРВИС · обновлено в 2026 году</p>

    <p>В статье про экспертизу промышленной безопасности мы упоминали модернизацию и реконструкцию как один из поводов для ЭПБ. Здесь разбираем это подробнее — где проходит граница между «просто ремонт» и «требуется экспертиза».</p>

    <h2 style="margin:36px 0 16px">Когда требуется экспертиза</h2>
    <p>Экспертиза промышленной безопасности требуется после модернизации, ремонта, реконструкции, замены элементов крана, после аварии и в других ситуациях, при которых конструкция изделия претерпела изменения. Ключевой критерий — не название процедуры («ремонт» или «модернизация»), а фактический характер выполненных работ.</p>

    <h2 style="margin:36px 0 16px">Где проходит граница между ремонтом и модернизацией</h2>
    <p>Экспертиза требуется после модернизаций или ремонтов, связанных с заменой материалов опорных и несущих элементов, а также после ремонта, вызванного аварией с повреждением крана. Простой ремонт без изменения конструкции (например, замена изношенной детали на аналогичную от того же производителя) не всегда требует последующей экспертизы — граница определяется тем, затронуты ли несущие элементы и изменилась ли конструкция.</p>

    <h2 style="margin:36px 0 16px">Какие документы нужны для экспертизы после изменений</h2>
    <p>Документы, оформленные в ходе и по результатам ремонта, реконструкции или модернизации грузоподъёмной машины, включая сертификаты на использованные в ходе работ материалы, детали или конструкции, необходимы для проведения экспертизы — без этой документации экспертная организация не может объективно оценить, соответствует ли изменённая техника требованиям безопасности.</p>

    <h2 style="margin:36px 0 16px">Что это значит для заказчика</h2>
    <p>Если техника, которую мы подаём на ваш объект, проходила модернизацию или капитальный ремонт с заменой несущих элементов, у неё должна быть актуальная экспертиза промышленной безопасности, подтверждающая, что изменения не снизили уровень безопасности эксплуатации. Это часть общей истории обслуживания техники, о которой мы писали в статье про срок службы крана — модернизированная машина с правильно оформленной ЭПБ безопасна не меньше новой.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: что запомнить</h2>
    <ul>
      <li>ЭПБ требуется после изменений конструкции — модернизации, реконструкции, ремонта несущих элементов, аварии.</li>
      <li>Простой ремонт без изменения конструкции не всегда требует новой экспертизы.</li>
      <li>Для экспертизы нужны документы о выполненных работах и сертификаты на использованные материалы.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <Sources
      checked={CHECKED}
      items={[
        { text: 'skb-visota.ru — реконструкция и модернизация грузоподъёмных кранов', href: 'https://skb-visota.ru/uslugi/rekonstrukcija-i-modernizacija/rekonstrukcija-i-modernizacija-kranov/' },
        { text: 'sevtest.com — экспертиза промышленной безопасности кранов', href: 'https://sevtest.com/ekspertiza-promyshlennoj-bezopasnosti-gruzopodyomnyx-kranov/' }
      ]}
    />
  </article>
  <section class="section wrap"><a class="btn" href="/spravochnik/ekspertiza-promyshlennoy-bezopasnosti/">Общий разбор экспертизы промышленной безопасности →</a></section>
</main>
</SpravochnikLayout>
