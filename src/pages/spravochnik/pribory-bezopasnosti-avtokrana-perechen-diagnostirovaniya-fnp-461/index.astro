---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';

const title = "Какие приборы автокрана проверяют при диагностировании";
const description = "Перечень проверок п. 259 ФНП №461 для автокрана: ограничитель грузоподъёмности, регистратор, защита от ЛЭП, координатная защита, указатель наклона, сигнализатор ветра.";

const CHECKED = '30.10.2026';
const PUBLISHED = '2026-10-30';
const SLUG = "pribory-bezopasnosti-avtokrana-perechen-diagnostirovaniya-fnp-461";
const URL = `https://moskran-servis.ru/spravochnik/${SLUG}/`;

const faqs = [
  {
    "q": "Какие приборы безопасности проверяют при диагностировании автокрана?",
    "a": "Пункт 259 ФНП №461 называет световые и звуковые указатели, ограничитель грузоподъёмности, средства автоматической остановки, ограничитель перемещения груза в запрещённой зоне, регистратор параметров, защиту от приближения к ЛЭП, координатную защиту, блокировки, указатель угла наклона и сигнализатор предельной скорости ветра."
  },
  {
    "q": "Что такое ограничитель перемещения груза в запрещённой зоне?",
    "a": "Устройство, которое не даёт перемещать груз над запрещёнными участками; п. 259 «г» ФНП №461 в качестве примера называет зону над кабиной стрелового крана на автомобильном шасси. Работоспособность этого ограничителя проверяют при диагностировании."
  },
  {
    "q": "Нужно ли проверять сигнализатор ветра на автокране?",
    "a": "Перечень п. 259 ФНП №461 включает сигнализатор предельной скорости ветра («т»). Проверяют его на соответствие документации изготовителя. Пороги, при которых работу прекращают, задаёт руководство по эксплуатации конкретного крана, поэтому числа в этой справке нет."
  },
  {
    "q": "Кто проверяет ограничители и указатели автокрана?",
    "a": "Работники, отвечающие требованиям п. 20 ФНП №461, в присутствии инженерно-технического работника эксплуатирующей организации (п. 261). Проверки, не указанные в п. 259, проводят по требованию эксплуатирующей организации (п. 260)."
  },
  {
    "q": "Может ли кран работать с неработоспособным ограничителем?",
    "a": "Нет: по п. 22 «г» ФНП №461 эксплуатировать подъёмное сооружение с неработоспособными ограничителями, указателями и регистраторами нельзя, а п. 115 запрещает работу при отключённых или неработоспособных ограничителях, регистраторах, указателях, тормозах."
  }
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: "Приборы безопасности автокрана при диагностировании", item: URL },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@type': 'Organization', '@id': 'https://moskran-servis.ru/#organization', name: 'МОСКРАН-СЕРВИС' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: URL,
  inLanguage: 'ru-RU',
  datePublished: PUBLISHED,
  dateModified: PUBLISHED,
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };

const toc = [["osnova", "Что требует п. 259 при диагностировании"], ["tablica", "Какие приборы из перечня есть на автокране"], ["zapretnaya-zona", "Ограничитель запретной зоны над кабиной"], ["kto", "Кто и в чьём присутствии проверяет"], ["zakazchik", "Что заказчику спросить у арендодателя"], ["faq", "Частые вопросы"], ["istochniki", "Источники"]];
---
<SpravochnikLayout title={title} description={description} path={`/spravochnik/${SLUG}/`} slug={SLUG} ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Приборы безопасности автокрана при диагностировании</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">ФНП №461 · Приборы безопасности</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Какие приборы безопасности автокрана проверяют при диагностировании?</h1>
    <div class="ref-byline meta-row">
      <span>Автор: инженерная служба МОСКРАН-СЕРВИС</span>
      <span>опубликовано <time datetime={PUBLISHED}>30.10.2026</time></span>
      <span>обновлено <time datetime={PUBLISHED}>30.10.2026</time></span>
      <span>факты проверены {CHECKED}</span>
      <span>6 мин чтения</span>
    </div>

    <p>При техническом диагностировании подъёмного сооружения п. 259 ФНП №461 требует проверить работоспособность и соответствие документации изготовителя у двадцати устройств, от световых указателей до противоугонных захватов. К автокрану КС-55713 «Клинцы» или КС-65713-1 «Галичанин» относятся около десяти из них: ограничитель грузоподъёмности, регистратор параметров, защита от приближения к ЛЭП, координатная защита, указатель угла наклона и сигнализатор ветра.</p>

    <nav class="toc ref-toc ref-toc--static" aria-label="Содержание">
      <div class="ref-toc__label">Содержание</div>
      <ol class="ref-toc__list">
        {toc.map(([id, text]) => <li><a href={`#${id}`} data-toc-id={id}>{text}</a></li>)}
      </ol>
    </nav>

    <h2 id="osnova" style="margin:36px 0 16px">Что требует п. 259 при диагностировании</h2>
    <p>Пункт 259 ФНП №461 относится к техническому диагностированию и касается металлоконструкций, узлов, механизмов, пневмо- и гидросистем, электрооборудования, указателей, ограничителей, регистраторов, средств автоматической остановки и предупредительной сигнализации. Для них проводят проверки работоспособности и соответствия требованиям документации изготовителя, причём далее в пункте идёт перечень из подпунктов «а»–«ф». Проверки, которых в перечне нет, проводят по требованию эксплуатирующей организации (п. 260).</p>
    <p>Общий порядок диагностирования и его место в жизненном цикле крана разобраны в справке про <a href="/spravochnik/tehnicheskoe-diagnostirovanie/" style="color:var(--yellow)">техническое диагностирование</a>.</p>

    <h2 id="tablica" style="margin:36px 0 16px">Какие приборы из перечня есть на автокране</h2>
    <p>Перечень п. 259 составлен для всех подъёмных сооружений сразу: в нём вышки, строительные подъёмники, рельсовые и электрические краны. Таблица отбирает подпункты, которые относятся к автокрану на автомобильном шасси; столбец «Применимость» — вывод по тексту нормы, а не цитата ФНП.</p>
    <div class="table-wrap" style="overflow-x:auto">
      <table>
        <thead><tr><th>Подпункт п. 259</th><th>Что проверяют</th><th>Автокран</th></tr></thead>
        <tbody>
          <tr><td>«а»</td><td>Световые и звуковые указатели и сигнализаторы</td><td>Да</td></tr>
          <tr><td>«б»</td><td>Ограничитель грузоподъёмности и грузового момента</td><td>Да</td></tr>
          <tr><td>«в»</td><td>Средства автоматической остановки (ограничители положения грузозахватного органа)</td><td>Да</td></tr>
          <tr><td>«г»</td><td>Ограничитель перемещения груза в запрещённой зоне</td><td>Да</td></tr>
          <tr><td>«д»</td><td>Регистратор параметров, часы и календарь</td><td>Да</td></tr>
          <tr><td>«е»</td><td>Защита от опасного приближения к ЛЭП</td><td>Да</td></tr>
          <tr><td>«ж»</td><td>Координатная защита</td><td>Да</td></tr>
          <tr><td>«з»</td><td>Блокировки</td><td>Да</td></tr>
          <tr><td>«п»</td><td>Указатель угла наклона самоходных ПС</td><td>Да</td></tr>
          <tr><td>«т»</td><td>Сигнализатор предельной скорости ветра</td><td>Да</td></tr>
          <tr><td>«у», «ф»</td><td>Противоугонные захваты и тупиковые упоры</td><td>Нет: для рельсовых кранов</td></tr>
          <tr><td>«и», «к»–«р»</td><td>Ловители, устройства люльки и опор подъёмников (вышек)</td><td>Нет: для подъёмников и вышек</td></tr>
        </tbody>
      </table>
    </div>

    <h2 id="zapretnaya-zona" style="margin:36px 0 16px">Ограничитель запретной зоны над кабиной</h2>
    <p>Подпункт «г» п. 259 ФНП №461 включает в перечень ограничитель перемещения груза в запрещённой зоне и приводит пример: зона над кабиной стрелового крана на автомобильном шасси. Для автокрана «Клинцы» это означает, что устройство, не пускающее груз над кабиной водителя, проверяют так же, как ограничитель грузоподъёмности. Правило о перемещении груза над людьми разобрано в справке про <a href="/spravochnik/peremeshchenie-gruza-nad-lyudmi/" style="color:var(--yellow)">перемещение груза над людьми</a>.</p>
    <p>Защита от ЛЭП и координатная защита проверяются отдельными подпунктами «е» и «ж». Подробности по ним — в справках про <a href="/spravochnik/rabota-krana-ryadom-s-lep/" style="color:var(--yellow)">работу крана рядом с ЛЭП</a> и <a href="/spravochnik/koordinatnaya-zashchita-avtokrana-fnp-461/" style="color:var(--yellow)">координатную защиту автокрана</a>.</p>

    <h2 id="kto" style="margin:36px 0 16px">Кто и в чьём присутствии проверяет</h2>
    <p>Пункт 261 ФНП №461 поручает проверки ограничителей, указателей и регистратора работникам, отвечающим требованиям п. 20, и требует присутствия инженерно-технического работника. Ограничитель грузоподъёмности проверяют грузами или аттестованным устройством нагружения с погрешностью не более 3 % (п. 262). Масса контрольных грузов и порядок нагружения разобраны в справке про <a href="/spravochnik/gruzy-dlya-ispytaniy-avtokrana-nagruzhateli-ili-poligon-fnp-461/" style="color:var(--yellow)">грузы для испытаний автокрана</a>.</p>

    <h2 id="zakazchik" style="margin:36px 0 16px">Что заказчику спросить у арендодателя</h2>
    <p>Заказчику не нужно проверять приборы самому, но есть смысл спросить, исправны ли они и когда проходили проверку. Работать с отключённым или неработоспособным ограничителем нельзя (п. 22 «г» и п. 115 ФНП №461), поэтому МОСКРАН-СЕРВИС останавливает кран при отказе прибора; порядок описан в справке про <a href="/spravochnik/kogda-avtokran-ne-dopuskayut-k-rabote-fnp-461/" style="color:var(--yellow)">недопуск автокрана к работе</a>. Базовое описание прибора даёт справка про <a href="/spravochnik/ogranichitel-gruzopodemnosti/" style="color:var(--yellow)">ограничитель грузоподъёмности</a>.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: приборы безопасности при диагностировании</h2>
    <ul>
      <li>Перечень п. 259 ФНП №461 содержит подпункты «а»–«ф»; к автокрану относятся указатели, ограничители, регистратор, защита от ЛЭП, координатная защита, блокировки, указатель наклона, сигнализатор ветра.</li>
      <li>Проверки вне перечня проводят по требованию эксплуатирующей организации (п. 260).</li>
      <li>Проверяют работники по п. 20 в присутствии инженерно-технического работника (п. 261).</li>
      <li>С неработоспособными ограничителями, указателями и регистраторами кран не эксплуатируют (пп. 22 «г», 115).</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 id="faq" style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <h2 id="istochniki" style="margin:36px 0 16px">Источники · проверено {CHECKED}</h2>
    <ul>
      <li><a href="https://www.consultant.ru/document/cons_doc_LAW_373321/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 (приказ Ростехнадзора от 26.11.2020 №461)</a> — пп. 22 «г», 115, 259–262 (диагностирование, приборы безопасности).</li>
      <li><a href="https://legalacts.ru/doc/prikaz-rostekhnadzora-ot-26112020-n-461-ob-utverzhdenii-federalnykh/" target="_blank" rel="noopener" style="color:var(--yellow)">ФНП №461 на legalacts.ru</a> — текст пунктов сверен 30.10.2026.</li>
    </ul>
    <p class="small muted">Справка не заменяет документацию изготовителя: состав приборов и методики проверки определяет она для конкретной модели крана.</p>
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-16-25-tonn/">Аренда автокрана 16–25 тонн →</a></section>
</main>
</SpravochnikLayout>
