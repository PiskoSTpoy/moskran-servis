---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';
import Sources from '../../../components/Sources.astro';

const title = 'Как читать грузовысотную характеристику крана';
const description = 'Что такое грузовысотная характеристика автокрана, как она связана с вылетом стрелы и почему её игнорирование — главная причина срыва заявок на кран.';

const CHECKED = '12.08.2026';

const faqs = [
  { q: 'Почему нельзя просто взять кран потяжелее «на всякий случай»?', a: 'Можно, но это неэффективно с точки зрения стоимости — переплата за более тяжёлый класс техники там, где хватило бы младшего, не решает задачу лучше, только дороже. Правильный подход — точный расчёт по весу и вылету, а не запас «с большим числом в названии».' },
  { q: 'Где взять грузовысотную характеристику конкретной модели крана?', a: 'Это часть паспорта крана — таблица или график, обязательная документация для каждой модели по требованиям промышленной безопасности. Подрядчик, предоставляющий технику, обязан иметь этот документ и делать по нему расчёт применительно к вашей задаче — попросите показать расчёт, если сомневаетесь.' },
  { q: 'Что если реальный вес груза окажется больше заявленного уже на объекте?', a: 'Оператор обязан остановить подъём, если фактический вес выходит за пределы грузовысотной характеристики на данном вылете — это требование безопасности, а не формальность, которую можно обойти по договорённости на месте.' },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Грузовысотная характеристика', item: 'https://moskran-servis.ru/spravochnik/gruzovysotnaya-harakteristika/' },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@id': 'https://moskran-servis.ru/#organization' }, // ссылка на единственный узел организации (BaseLayout): отдельный узел с тем же @id, но другим name, был противоречием в графе
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: 'https://moskran-servis.ru/spravochnik/gruzovysotnaya-harakteristika/',
  inLanguage: 'ru-RU',
  datePublished: '2026-08-12',
  dateModified: '2026-08-12',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<SpravochnikLayout title={title} description={description} path="/spravochnik/gruzovysotnaya-harakteristika/" slug="gruzovysotnaya-harakteristika" ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Грузовысотная характеристика</span>
  </nav>

  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Разбор для заказчика</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Грузовысотная характеристика крана — как читать и не сорвать заявку</h1>
    <p class="ref-byline">Инженерная служба МОСКРАН-СЕРВИС · обновлено в 2026 году</p>

    <p>Самая частая причина, по которой заказанный кран «не справляется» на объекте, — не ошибка подрядчика в выборе техники, а то, что при заказе не учли один параметр: вылет стрелы. На каждой странице услуги на этом сайте мы упоминаем грузовысотную характеристику — здесь разбираем подробно, что это такое и как ей пользоваться.</p>

    <h2 style="margin:36px 0 16px">Что это такое</h2>
    <p>Грузовысотная характеристика — таблица или график в паспорте крана, которые показывают, какой максимальный вес кран способен поднять на каждом конкретном сочетании вылета стрелы (расстояния от оси крана до точки подъёма) и высоты подъёма. Это не одна цифра, а целый набор значений: чем больше вылет, тем меньше доступная грузоподъёмность — и это снижение не линейное, а часто довольно резкое уже на средних дистанциях.</p>

    <h2 style="margin:36px 0 16px">Почему цифра в названии крана — это максимум, а не гарантия</h2>
    <p>Когда кран называют «25-тонным» или «40-тонным», это грузоподъёмность на минимальном вылете — практически у основания стрелы, вплотную к крану. На практике такой минимальный вылет редко достижим: между краном и точкой подъёма почти всегда есть расстояние — здание, забор, соседняя техника, сам груз, который нужно доставить не под кран, а в конкретное место. Уже на вылете 10–12 метров грузоподъёмность типичного крана этого класса может быть заметно ниже паспортного максимума, а на вылете 18–20 метров — упасть вдвое и больше.</p>

    <h2 style="margin:36px 0 16px">Как это выглядит на практике — пример логики (без привязки к конкретной модели)</h2>
    <p>Представим кран с паспортной грузоподъёмностью 25 тонн на минимальном вылете. На вылете 5 метров он всё ещё может поднимать, условно, 15–18 тонн — с запасом для большинства задач. На вылете 12 метров цифра снижается уже заметнее — условно до 6–8 тонн. На вылете 18–20 метров запас может сократиться до 2–3 тонн. Это иллюстративные цифры для объяснения принципа, а не характеристика конкретной модели — точные значения для реальной техники берутся строго из паспорта конкретного крана, не по аналогии.</p>
    <p>Вывод из этой логики: груз в 3 тонны на вылете 5 метров — тривиальная задача для любого крана этого класса. Тот же груз в 3 тонны на вылете 20 метров — уже задача на пределе возможностей той же машины, а иногда и за пределами. Именно поэтому мы всегда просим оба параметра — вес и примерное расстояние от возможной точки стоянки крана до точки подъёма, а не один только вес.</p>

    <h2 style="margin:36px 0 16px">Откуда берётся вылет на конкретном объекте</h2>
    <p>Вылет определяется не желанием заказчика, а физическими ограничениями площадки: шириной двора, наличием соседних зданий и заборов, расположением подземных коммуникаций (под которыми нельзя ставить выносные опоры), плотностью парковки. На стеснённых городских площадках — особенно в старой застройке центра Москвы — кран часто физически не может подъехать ближе определённой границы, и вылет получается больше, чем хотелось бы, а не по расчёту «как удобнее».</p>

    <h2 style="margin:36px 0 16px">Как мы используем это при расчёте заявки</h2>
    <p>При приёме заявки мы просим: точный вес самого тяжёлого груза (по накладной или паспорту изделия, не «на глаз») и, если площадка не очевидна по карте, фото или схему подъезда. По этим данным прикидываем реальный вылет и сверяем с грузовысотной характеристикой конкретной модели, которую планируем подать — это бесплатный этап расчёта, до подтверждения заявки, а не постфактум на месте.</p>
    <p>Если по расчёту выясняется, что запланированный класс техники не справится с задачей на нужном вылете, предлагаем технику следующего класса сразу — пересчитываем по тем же исходным данным, без необходимости заново собирать всю информацию с нуля.</p>

    <h2 style="margin:36px 0 16px">Что происходит, если это проигнорировать</h2>
    <p>Если кран заказан «на глаз», без расчёта вылета, а по факту на объекте выясняется, что груз тяжелее допустимого на реальном вылете, — оператор обязан остановить подъём до замены техники на более мощную. Это требование промышленной безопасности, а не перестраховка: превышение грузовысотной характеристики создаёт риск потери устойчивости крана и аварии, а не просто «немного не поднимет». Итог такой ситуации — перенос части работ на повторный выезд, что почти всегда дороже и дольше по срокам, чем изначально заказать технику нужного класса.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: что запомнить</h2>
    <ul>
      <li>Цифра в названии крана — максимальная грузоподъёмность на минимальном вылете, а не гарантия для любого расстояния.</li>
      <li>Грузоподъёмность падает по мере роста вылета, часто нелинейно и значительно.</li>
      <li>Вылет определяется физическими ограничениями площадки, а не пожеланием заказчика.</li>
      <li>Правильный заказ требует двух данных: вес груза и примерный вылет, а не только тоннаж.</li>
      <li>Превышение грузовысотной характеристики — вопрос безопасности, оператор обязан остановить подъём, а не рисковать.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (
        <details class="faq__item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
      <Sources
      checked={CHECKED}
      items={[
        { text: 'Приказ Ростехнадзора от 26.11.2020 №461 (ред. от 16.04.2026), п. 189 — результаты технического освидетельствования записываются в паспорт ПС', href: 'https://www.consultant.ru/document/cons_doc_LAW_373321/' },
        { text: 'Паспорт подъёмного сооружения конкретной машины — первоисточник грузовой характеристики; сводных характеристик «по классу техники» не существует' },
      ]}
      note="Числовые примеры в тексте иллюстративные: реальная характеристика берётся из паспорта конкретной машины на конкретном вылете, а не из таблицы «для 25 тонн вообще»."
    />
</article>

  <section class="section wrap">
    <a class="btn" href="/#zayavka">Рассчитать вылет для моего объекта →</a>
  </section>
</main>
</SpravochnikLayout>
