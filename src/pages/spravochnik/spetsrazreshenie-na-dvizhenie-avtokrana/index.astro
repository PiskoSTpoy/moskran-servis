---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';
import Sources from '../../../components/Sources.astro';

const title = 'Спецразрешение на движение тяжеловесного автокрана: когда нужно и как получить';
const description = 'Автокран, который своей массой или габаритами превышает допустимые параметры, — тяжеловесное и (или) крупногабаритное транспортное средство даже без груза на крюке. Разбираем, когда нужно специальное разрешение на движение и что грозит за его отсутствие.';

const CHECKED = '20.09.2026';

const faqs = [
  {
    q: 'Разве специальное разрешение нужно только когда кран везёт крупногабаритный груз?',
    a: 'Нет, это частая путаница. Правила движения тяжеловесного и (или) крупногабаритного транспортного средства, утверждённые постановлением Правительства РФ от 01.12.2023 №2060, прямо говорят про массу и габариты транспортного средства «с грузом или без груза». Если сам автокран — из-за массы шасси, противовесов или длины стрелы в транспортном положении — превышает допустимые параметры, разрешение требуется на его собственный переезд, даже когда на крюке ничего нет.',
  },
  {
    q: 'Чем это отличается от маркировки груза, о которой справочник уже писал?',
    a: 'Маркировка крупногабаритного груза — это про то, как обозначить транспортное средство при движении: сигнальные щитки, опознавательные знаки, габаритные фонари. Специальное разрешение — это отдельная разрешительная процедура, дающая право вообще двигаться по дороге с превышением параметров, и маркировка её не заменяет: можно правильно промаркировать кран и всё равно нарушить правила, если разрешения на сам факт движения нет.',
  },
  {
    q: 'Кто должен получать разрешение — владелец автокрана или заказчик?',
    a: 'Разрешение оформляет владелец транспортного средства либо перевозчик, то есть подрядчик, предоставляющий кран. Заказчику как стороне договора аренды не нужно самому обращаться за разрешением, но стоит уточнить у подрядчика, оформлено ли оно на маршрут до объекта — если кран остановят в пути без разрешения, это сорвёт согласованное время подачи техники.',
  },
  {
    q: 'Что будет, если автокран поедет по дороге без разрешения при том, что оно требовалось?',
    a: 'Ответственность наступает по статье 12.21.1 КоАП РФ «Нарушение правил движения тяжеловесного и (или) крупногабаритного транспортного средства». Она построена по нарастающей шкале: чем больше превышение допустимой массы, нагрузки на ось или габаритов и чем более грубым является нарушение (включая полное отсутствие разрешения), тем выше штраф, и для юридических лиц суммы измеряются сотнями тысяч рублей. К административной ответственности может быть привлечён и водитель, и должностное лицо, и сама организация-перевозчик.',
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Спецразрешение на движение автокрана', item: 'https://moskran-servis.ru/spravochnik/spetsrazreshenie-na-dvizhenie-avtokrana/' },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@id': 'https://moskran-servis.ru/#organization' },
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: 'https://moskran-servis.ru/spravochnik/spetsrazreshenie-na-dvizhenie-avtokrana/',
  inLanguage: 'ru-RU',
  datePublished: '2026-09-20',
  dateModified: '2026-09-20',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<SpravochnikLayout title={title} description={description} path="/spravochnik/spetsrazreshenie-na-dvizhenie-avtokrana/" slug="spetsrazreshenie-na-dvizhenie-avtokrana" ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Спецразрешение на движение автокрана</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Разбор для заказчика</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Спецразрешение на движение тяжеловесного автокрана: когда нужно и как получить</h1>
    <p class="ref-byline">Инженерная служба МОСКРАН-СЕРВИС · обновлено 20.09.2026</p>

    <p>В <a href="/spravochnik/markirovka-negabarita-pri-transportirovke/" style="color:var(--yellow)">статье про маркировку крупногабаритного груза при транспортировке</a> справочник намеренно оставил в стороне отдельную процедуру — специальное разрешение на движение тяжеловесного и (или) крупногабаритного транспортного средства. Маркировка отвечает на вопрос «как обозначить технику в пути», разрешение — на вопрос «можно ли вообще ехать с такими параметрами». Разбираем эту процедуру отдельно, потому что для автокрана она касается не только перевозимого груза, но и самой машины.</p>

    <h2 style="margin:36px 0 16px">Почему это касается крана, даже когда он ничего не везёт</h2>
    <p>Правила движения тяжеловесного и (или) крупногабаритного транспортного средства, утверждённые постановлением Правительства РФ от 01.12.2023 №2060 (действуют с 1 марта 2024 года), определяют оба статуса через массу и габариты самого транспортного средства «с грузом или без груза». Автокран на дороге общего пользования — это прежде всего тяжёлая специальная машина: снаряжённая масса шасси с установленной стрелой, противовесами и лебёдкой у моделей грузоподъёмностью от 25–40 тонн и выше нередко сама по себе превышает допустимую массу или нагрузку на ось, установленную для дорог общего пользования, а стрела в транспортном положении может выходить за допустимые габариты по длине. Поэтому вопрос о разрешении встаёт при каждом самостоятельном переезде крана между объектами, независимо от того, что он перевозит на крюке.</p>

    <h2 style="margin:36px 0 16px">Кто выдаёт разрешение и как долго это занимает</h2>
    <p>С 1 марта 2024 года разрешения оформляются в электронном виде через реестр выдачи специальных разрешений; для маршрутов по дорожной сети Москвы заявку подают через Единый транспортный портал на mos.ru. Срок выдачи зависит от того, чей маршрут затрагивает переезд: если требуется согласование только с владельцами автомобильных дорог, по общему порядку это до 11 рабочих дней, а если маршрут пересекает посты и участки, требующие согласования с Госавтоинспекцией, — до 15 рабочих дней. Само разрешение действует ограниченный срок — до трёх месяцев, поэтому подрядчику с несколькими переездами на один объект и обратно есть смысл оформлять его заранее, а не в последний момент перед подачей крана.</p>

    <h2 style="margin:36px 0 16px">Что нового принесло постановление №2060</h2>
    <p>Постановление №2060 заменило прежний порядок, который много лет устанавливал приказ Минтранса России от 24.07.2012 №258. Общий смысл процедуры — необходимость получать разрешение при превышении допустимых параметров — сохранился, но процесс стал полнее автоматизирован: маршрут движения система определяет на основании данных об автомобильных дорогах, внесённых их владельцами, а часть типовых маршрутов, не требующих согласования с ГИБДД, оформляется быстрее прежнего. Это не отменяет главного правила: без действующего разрешения тяжеловесный или крупногабаритный автокран не имеет права выезжать на дорогу общего пользования с превышением параметров.</p>

    <h2 style="margin:36px 0 16px">Ответственность за движение без разрешения</h2>
    <p>Ответственность за нарушение правил движения тяжеловесного и (или) крупногабаритного транспортного средства предусмотрена статьёй 12.21.1 КоАП РФ. Норма построена по возрастающей шкале в зависимости от того, насколько превышены допустимые масса, нагрузка на ось или габариты и есть ли разрешение вообще — чем грубее нарушение, тем выше штраф, а для юридических лиц (то есть для организации-владельца автокрана) суммы по верхним частям статьи измеряются сотнями тысяч рублей. Привлечь к ответственности могут одновременно водителя, ответственное должностное лицо и саму организацию-перевозчика. Точный размер штрафа для конкретной ситуации — превышение по массе, по нагрузке на ось или полное отсутствие разрешения — стоит смотреть по актуальному тексту статьи, так как составов внутри неё несколько и суммы по ним заметно различаются.</p>

    <h2 style="margin:36px 0 16px">Что это значит для заказчика</h2>
    <p>Заказчику не нужно самому подавать заявление на разрешение — это обязанность подрядчика как владельца техники или перевозчика. Но при выборе крана большой грузоподъёмности для объекта с неблизким переездом стоит спросить у подрядчика, учтено ли время на оформление разрешения в графике подачи техники: маршрут, требующий согласования с ГИБДД, занимает до двух недель, и это тот срок, который нельзя сжать в последний момент так, как можно ускорить, например, подготовку внутренних документов на площадке.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: что запомнить</h2>
    <ul>
      <li>Специальное разрешение на движение тяжеловесного и (или) крупногабаритного транспортного средства нужно и тогда, когда сам автокран без груза превышает допустимые массу, нагрузку на ось или габариты.</li>
      <li>Это отдельная процедура, не заменяемая маркировкой груза при транспортировке.</li>
      <li>Действующий порядок — постановление Правительства РФ №2060 от 01.12.2023, разрешения выдаются электронно, для Москвы — через портал mos.ru.</li>
      <li>Срок выдачи — до 11 рабочих дней при согласовании только с владельцами дорог и до 15 рабочих дней, если требуется согласование с ГИБДД; срок действия разрешения — до трёх месяцев.</li>
      <li>Движение без разрешения или с нарушением его условий — статья 12.21.1 КоАП РФ, штрафы растут вместе с превышением параметров и для организаций доходят до сотен тысяч рублей.</li>
      <li>Оформляет разрешение подрядчик, но заказчику стоит уточнять сроки его получения при планировании переезда крана на объект.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <Sources
      checked={CHECKED}
      items={[
        { text: 'ГАРАНТ.РУ — постановление Правительства РФ от 01.12.2023 №2060 «Об утверждении Правил движения тяжеловесного и (или) крупногабаритного транспортного средства»', href: 'https://www.garant.ru/hotlaw/federal/1661471/' },
        { text: 'КонсультантПлюс — постановление Правительства РФ от 01.12.2023 №2060', href: 'https://www.consultant.ru/document/cons_doc_LAW_463407/' },
        { text: 'Единый транспортный портал mos.ru — оформление спецразрешения для тяжеловесного и (или) крупногабаритного грузовика', href: 'https://transport.mos.ru/gruzoviki/specrazreshenie' },
        { text: 'КонсультантПлюс — статья 12.21.1 КоАП РФ «Нарушение правил движения тяжеловесного и (или) крупногабаритного транспортного средства»', href: 'https://www.consultant.ru/document/cons_doc_LAW_34661/f727c535f35518ba16c7d51b782a5f6ed67b76a3/' },
      ]}
      note="Статья 12.21.1 КоАП РФ содержит несколько частей с разными суммами штрафов в зависимости от степени превышения параметров и наличия разрешения — точный размер штрафа для конкретной ситуации стоит проверять по актуальной редакции кодекса."
    />
  </article>
  <section class="section wrap"><a class="btn" href="/uslugi/arenda-avtokrana-40-50-tonn/">Подробнее об аренде автокрана 40–50 тонн →</a></section>
</main>
</SpravochnikLayout>
