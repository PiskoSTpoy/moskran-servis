---
import SpravochnikLayout from '../../../layouts/SpravochnikLayout.astro';
import Sources from '../../../components/Sources.astro';

const title = 'Декларация ТР ТС 010/2011 на кран и документы Ростехнадзора';
const description = 'ТР ТС 010/2011 — техническое регулирование безопасности машин, декларация подтверждает конструкцию. Ростехнадзор отдельно контролирует эксплуатацию.';

const CHECKED = '12.08.2026';

const faqs = [
  { q: 'Декларация ТР ТС 010/2011 заменяет документы Ростехнадзора?', a: 'Нет — это два независимых, параллельных требования. Декларация подтверждает, что конкретная модель техники соответствует требованиям безопасности на этапе производства и ввода в оборот. Ростехнадзор отдельно контролирует промышленную безопасность и правильность эксплуатации уже работающего крана — освидетельствование, регистрацию в реестре ОПО, аттестацию персонала.' },
  { q: 'Кто оформляет декларацию — мы или производитель крана?', a: 'Декларацию принимает заявитель — юридическое лицо или ИП, резидент страны ЕАЭС, на основании технической документации и протоколов испытаний. Обычно это производитель или его официальный представитель, а не эксплуатирующая организация вроде нас.' },
  { q: 'Как заказчику убедиться, что кран легально введён в оборот?', a: 'Попросить у подрядчика копию декларации соответствия на конкретную модель техники — это отдельный документ от комплекта, который мы обычно предоставляем (освидетельствование, регистрация в ОПО, удостоверение оператора), и добросовестная компания предоставит его без затруднений.' },
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Справочник', item: 'https://moskran-servis.ru/spravochnik/' },
    { '@type': 'ListItem', position: 3, name: 'Декларация ТР ТС 010/2011', item: 'https://moskran-servis.ru/spravochnik/deklaraciya-tr-ts-010/' },
  ],
};
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: title, description,
  author: { '@id': 'https://moskran-servis.ru/#organization' }, // ссылка на единственный узел организации (BaseLayout): отдельный узел с тем же @id, но другим name, был противоречием в графе
  publisher: { '@id': 'https://moskran-servis.ru/#organization' },
  mainEntityOfPage: 'https://moskran-servis.ru/spravochnik/deklaraciya-tr-ts-010/',
  inLanguage: 'ru-RU',
  datePublished: '2026-08-12',
  dateModified: '2026-08-12',
};
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---
<SpravochnikLayout title={title} description={description} path="/spravochnik/deklaraciya-tr-ts-010/" slug="deklaraciya-tr-ts-010" ldExtra={[breadcrumbLd, articleLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/spravochnik/">Справочник</a><span>/</span><span>Декларация ТР ТС 010/2011</span>
  </nav>
  <article class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Разбор для заказчика</span>
    <h1 style="font-size:var(--t-h1);margin:14px 0 8px">Декларация соответствия ТР ТС 010/2011 для крана — чем отличается от документов Ростехнадзора</h1>
    <p class="ref-byline">Инженерная служба МОСКРАН-СЕРВИС · обновлено в 2026 году</p>

    <p>Мы подробно писали про требования Ростехнадзора — освидетельствование, регистрацию в реестре ОПО, аттестацию оператора. Есть ещё один слой требований, о котором реже говорят: техническое регулирование на уровне Евразийского экономического союза.</p>

    <h2 style="margin:36px 0 16px">Что такое ТР ТС 010/2011</h2>
    <p>Технический регламент Таможенного союза ТР ТС 010/2011 «О безопасности машин и оборудования» устанавливает требования безопасности к машинам и оборудованию, включая отдельные виды грузоподъёмной техники. Большая часть машин и технологического оборудования, попадающего под этот регламент, подлежит декларированию соответствия.</p>

    <h2 style="margin:36px 0 16px">Кто и как оформляет декларацию</h2>
    <p>Декларацию принимает заявитель — юридическое лицо или индивидуальный предприниматель, резидент страны ЕАЭС — на основании доказательных материалов: технической и эксплуатационной документации, протоколов испытаний продукции. На практике это, как правило, производитель техники или его официальный представитель, а не компания, впоследствии эксплуатирующая кран.</p>

    <h2 style="margin:36px 0 16px">Чем это отличается от документов Ростехнадзора</h2>
    <p>Здесь важно различие: сертификаты и декларации относятся к техническому регулированию — они подтверждают, что конкретная модель техники безопасна по конструкции на этапе производства и ввода в оборот. Ростехнадзор отдельно контролирует промышленную безопасность и правильность эксплуатации уже работающего крана — то есть то, о чём мы писали в статьях про техническое освидетельствование, экспертизу промышленной безопасности и регистрацию в реестре ОПО. Это два параллельных, не заменяющих друг друга требования.</p>

    <h2 class="ref-takeaway" style="margin:36px 0 18px">Коротко: что запомнить</h2>
    <ul>
      <li>ТР ТС 010/2011 регулирует безопасность конструкции техники на этапе производства и ввода в оборот.</li>
      <li>Декларацию оформляет заявитель (обычно производитель), на основании технической документации и испытаний.</li>
      <li>Это отдельное требование от контроля Ростехнадзора за эксплуатацией уже работающего крана.</li>
      <li>Заказчик вправе запросить копию декларации у подрядчика как часть комплекта документов.</li>
    </ul>

    <div class="faq" style="margin-top:44px">
      <h2 style="margin-bottom:18px">Частые вопросы</h2>
      {faqs.map((f) => (<details class="faq__item"><summary>{f.q}</summary><p>{f.a}</p></details>))}
    </div>

    <Sources
      checked={CHECKED}
      items={[
        { text: 'certification.vnesenie-v-reestr.ru — сертификация подъёмных кранов по ТР ТС 010/2011', href: 'https://certification.vnesenie-v-reestr.ru/news/sertifikatsiya-podyomnyh-kranov-tr-ts-0102011-ispytaniya-i-rostehnadzor' },
        { text: 'gostest.com — декларация о соответствии по техрегламентам ТС', href: 'https://www.gostest.com/services/tamozhennyy-soyuz/deklaratsiya-o-sootvetstvii-po-tekhnicheskim-reglamentam-ts/mashiny-i-oborudovanie/' }
      ]}
    />
  </article>
  <section class="section wrap"><a class="btn" href="/spravochnik/registraciya-krana-rostehnadzor/">Регистрация крана в реестре ОПО →</a></section>
</main>
</SpravochnikLayout>
