---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Sources from '../../../components/Sources.astro';
import ModelPrice from '../../../components/ModelPrice.astro';

const title = 'Автокран XCMG QY25K5-I — технические характеристики, 25 тонн';
const description = 'XCMG QY25K5-I: грузоподъёмность 25 т, пятисекционная стрела 10,5–41 м, высота подъёма до 48,5 м, гусёк 8,3 м. Технические характеристики.';

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Парк техники', item: 'https://moskran-servis.ru/park/' },
    { '@type': 'ListItem', position: 3, name: 'XCMG QY25K5-I', item: 'https://moskran-servis.ru/park/xcmg-qy25k5/' },
  ],
};

// Волна 33 / цена. 25 т — тот же тариф класса «25 т», что и у остальных 25-тонных
// моделей парка (см. комментарий в park/ivanovets-ks-45717/index.astro): 2600 ₽/час
// (rates[] в src/pages/index.astro) × 8 ч = 20 800 ₽/смена. WebSearch общего рынка
// (kran365.ru не использовался): 1200–4500 ₽/час, 15 000–16 500 ₽/смена — glavarendakran.com,
// kranauto.ru, manipulyator-avtokran.ru, msp-moscow.ru, agrostroymech.ru, ragnarr.ru.
const priceValue = '20 800';
const priceUnit = 'смена';
const priceNote = 'Смена — 8 часов, минимальный заказ. Точный расчёт под вылет и надбавки — калькулятор на главной.';
const priceLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'XCMG QY25K5-I',
  category: 'Автокран',
  offers: {
    '@type': 'Offer',
    // Аренда, а НЕ продажа. Без явного businessFunction значение по умолчанию —
    // Sell, то есть разметка объявляла бы продажу крана за эту сумму. Техника
    // передаётся во временное пользование (с экипажем, ст. 632 ГК) — LeaseOut.
    businessFunction: 'http://purl.org/goodrelations/v1#LeaseOut',
    priceCurrency: 'RUB',
    price: '20800',
    areaServed: 'Москва',
    priceValidUntil: '2027-02-17',
    seller: { '@id': 'https://moskran-servis.ru/#organization' },
    priceSpecification: { '@type': 'UnitPriceSpecification', price: '20800', priceCurrency: 'RUB', unitText: 'SHIFT' },
  },
};
---
<BaseLayout title={title} description={description} path="/park/xcmg-qy25k5/" ldExtra={[breadcrumbLd, priceLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/park/">Парк техники</a><span>/</span><span>XCMG QY25K5-I</span>
  </nav>
  <section class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Автокран · 25 тонн</span>
    <h1 style="margin:14px 0 20px">XCMG QY25K5-I</h1>
    <ModelPrice value={priceValue} unit={priceUnit} note={priceNote} />
    <figure class="model-art model-art--mobile">
      <svg viewBox="0 0 440 260" role="img" focusable="false" aria-label="Чертёж автокрана XCMG QY25K5-I: грузоподъёмность 25 т, пятисекционная стрела длиной до 41 м, гусёк 8,3 м, высота подъёма до 48,5 м">
        <defs>
          <pattern id="xq-dots" width="16" height="16" patternUnits="userSpaceOnUse">
            <circle cx="1.3" cy="1.3" r="1.2" fill="var(--line-strong)" />
          </pattern>
          <marker id="xq-tick" markerWidth="10" markerHeight="10" refX="5" refY="5" orient="auto">
            <path d="M5 0 V10" stroke="var(--yellow)" stroke-width="1.4" />
          </marker>
        </defs>
        <rect x="6" y="6" width="428" height="248" fill="url(#xq-dots)" opacity="0.3" />
        <rect x="6" y="6" width="428" height="248" fill="none" stroke="var(--line-strong)" stroke-width="1.4" stroke-dasharray="2 7" />
        <g stroke="var(--yellow)" stroke-width="2.5" stroke-linecap="square" fill="none">
          <path d="M6 26 V6 H26" />
          <path d="M414 6 H434 V26" />
          <path d="M434 234 V254 H414" />
          <path d="M26 254 H6 V234" />
        </g>

        <line x1="14" y1="225" x2="426" y2="225" stroke="var(--muted)" stroke-width="1.6" />

        <path d="M40 225 V183 L70 183 L70 204 H40 Z" fill="none" stroke="var(--ink)" stroke-width="1.6" />
        <rect x="45" y="188" width="15" height="12" fill="none" stroke="var(--ink)" stroke-width="1.2" />
        <rect x="55" y="182" width="155" height="30" fill="none" stroke="var(--ink)" stroke-width="1.8" />
        <circle cx="68" cy="225" r="11" fill="var(--bg-2)" stroke="var(--ink)" stroke-width="1.6" />
        <circle cx="98" cy="225" r="11" fill="var(--bg-2)" stroke="var(--ink)" stroke-width="1.6" />
        <circle cx="168" cy="225" r="11" fill="var(--bg-2)" stroke="var(--ink)" stroke-width="1.6" />
        <circle cx="198" cy="225" r="11" fill="var(--bg-2)" stroke="var(--ink)" stroke-width="1.6" />

        <rect x="150" y="156" width="38" height="26" fill="none" stroke="var(--ink)" stroke-width="1.8" />
        <line x1="168" y1="158" x2="365" y2="70" stroke="var(--ink)" stroke-width="2.8" />
        <circle cx="207.4" cy="140.4" r="1.9" fill="var(--ink)" />
        <circle cx="246.8" cy="122.8" r="1.9" fill="var(--ink)" />
        <circle cx="286.2" cy="105.2" r="1.9" fill="var(--ink)" />
        <circle cx="325.6" cy="87.6" r="1.9" fill="var(--ink)" />
        <line x1="365" y1="70" x2="400" y2="42" stroke="var(--muted)" stroke-width="2" />
        <line x1="400" y1="42" x2="390" y2="80" stroke="var(--muted)" stroke-width="1.2" stroke-dasharray="1 3" />
        <path d="M386 80 h8 l-3 7 h-2 z" fill="none" stroke="var(--ink)" stroke-width="1.4" />

        <text x="169" y="150" font-family="var(--sans)" font-size="9" fill="var(--ink)" text-anchor="middle" font-weight="700">25 т</text>
        <text x="278" y="95" font-family="var(--sans)" font-size="9" fill="var(--ink)" text-anchor="middle" font-weight="700">41 м</text>
        <text x="278" y="106" font-family="var(--sans)" font-size="7.5" fill="var(--muted)" text-anchor="middle">5 секций</text>
        <text x="345" y="35" font-family="var(--sans)" font-size="8" fill="var(--muted)" text-anchor="start">гусёк 8,3 м</text>

        <line x1="400" y1="42" x2="392" y2="42" stroke="var(--line-strong)" stroke-width="1.2" />
        <line x1="392" y1="42" x2="392" y2="225" stroke="var(--yellow)" stroke-width="1.4" marker-start="url(#xq-tick)" marker-end="url(#xq-tick)" />
        <text x="398" y="133" font-family="var(--sans)" font-size="10" font-weight="700" fill="var(--yellow)" text-anchor="middle" transform="rotate(90 398 133)">48,5 м</text>
      </svg>
      <figcaption>Схема силуэта — не масштабный чертёж, цифры на выносках соответствуют таблице характеристик ниже.</figcaption>
    </figure>
    <p>Китайский автокран производства XCMG — один из самых распространённых в России кранов этого класса среди импортной техники, с пятисекционной телескопической стрелой увеличенной длины по сравнению с типовыми отечественными аналогами того же тоннажа.</p>

    <table class="ttx">
      <tbody>
        <tr><td>Грузоподъёмность</td><td>25 т (на минимальном вылете)</td></tr>
        <tr><td>Стрела</td><td>5-секционная, U-образного профиля, длина 10,5–41 м</td></tr>
        <tr><td>Высота подъёма</td><td>9,8–48,5 м</td></tr>
        <tr><td>Гусёк</td><td>8,3 м</td></tr>
        <tr><td>Двигатель</td><td>235 кВт (2200 об/мин)</td></tr>
      </tbody>
    </table>

    <h2 style="margin:32px 0 14px">Где применяется</h2>
    <p>Более длинная стрела (до 41 м против типичных 31–34 м у отечественных аналогов 25-тонного класса) и высота подъёма до 48,5 м дают запас по досягаемости для задач, где важна высота или увеличенный вылет, а не только грузоподъёмность у основания стрелы — например, монтаж на кровлю зданий повышенной этажности без необходимости переходить на более тяжёлый класс техники.</p>
    <p>Подробнее о задачах для этого класса грузоподъёмности — на странице услуги <a href="/uslugi/arenda-avtokrana-16-25-tonn/" style="color:var(--yellow)">«Автокраны 16–25 тонн»</a>.</p>
  </section>
  <section class="section wrap prose" style="padding-top:0;max-width:820px">
    <h2 style="margin-bottom:16px">Что проверяют у этой машины перед выездом</h2>
    <p>У импортной техники к обычному комплекту добавляется вопрос происхождения документов. Подъёмное сооружение выпускается в обращение по техническому регламенту Таможенного союза «О безопасности машин и оборудования», а эксплуатируется уже по российским федеральным нормам и правилам: это два разных документа, и наличие одного не заменяет второй.</p>
    <p>Дальше — общий порядок: частичное освидетельствование не реже раза в 12 месяцев, полное — не реже раза в 3 года, результат и срок следующего записываются в паспорт. Записи в паспорте импортной машины должны быть на русском языке — иначе проверить их на КПП объекта физически невозможно.</p>
    <p>Пятисекционная стрела длиной до 41 м — это преимущество по досягаемости и одновременно повод внимательнее смотреть грузовую характеристику: чем длиннее стрела, тем сильнее разрыв между паспортным максимумом и реальной цифрой на рабочем вылете.</p>
    <h2 style="margin:34px 0 16px">Высота подъёма и городские ограничения</h2>
    <p>Высота подъёма до 48,5 м означает, что машина регулярно попадает в ситуации, где над площадкой проходят провода: воздушные линии, контактная сеть городского транспорта. Работа ближе 30 м к крайнему проводу линии или сети напряжением более 50 В допускается только по наряду-допуску — независимо от того, насколько аккуратно работает оператор.</p>
    <p style="margin-top:18px">Средний класс закрывает большинство городских задач, и отказ приходит обычно не по грузоподъёмности, а по подъезду. Проверить себя можно по <a href="/proverka-dokumentov/" style="color:var(--yellow)">чек-лист допуска</a>; заявка — через <a href="/#zayavka" style="color:var(--yellow)">форму на главной</a>.</p>
    <Sources
      checked="12.08.2026"
      items={[
        { text: 'Приказ Ростехнадзора от 26.11.2020 №461 (ред. от 16.04.2026): п. 108 — площадка и уклон, п. 110 — выносные опоры, п. 111 — откос выемки, п. 138 — пуск в работу, п. 165 — периодичность освидетельствования, п. 171 и 179 — нагрузки при испытаниях, п. 189 — запись в паспорт', href: 'https://www.consultant.ru/document/cons_doc_LAW_373321/' },
      ]}
    />
  </section>
</main>
<style>
  .ttx { width: 100%; border-collapse: collapse; margin: 20px 0; font-size: var(--t-md); }
  .ttx td { padding: 10px 14px; border-bottom: 1px solid var(--line); }
  .ttx td:first-child { color: var(--muted); width: 45%; }
  .model-art { width: min(100%, 480px); margin: 20px 0 6px; }
  .model-art svg { display: block; width: 100%; height: auto; }
  .model-art figcaption { margin-top: 10px; font-size: var(--t-sm); color: var(--muted); max-width: 60ch; }
</style>
</BaseLayout>
