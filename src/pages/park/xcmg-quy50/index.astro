---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Sources from '../../../components/Sources.astro';
import ModelPrice from '../../../components/ModelPrice.astro';

const title = 'Гусеничный кран XCMG QUY50 — технические характеристики';
const description = 'XCMG QUY50: гусеничный кран грузоподъёмностью 50 т, стрела 52 м, гусёк 15,25 м, высота подъёма 57,7 м. Технические характеристики.';

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Парк техники', item: 'https://moskran-servis.ru/park/' },
    { '@type': 'ListItem', position: 3, name: 'XCMG QUY50', item: 'https://moskran-servis.ru/park/xcmg-quy50/' },
  ],
};

// Волна 33 / цена. Гусеничный кран — отдельный от автокранов сегмент рынка (другая
// логистика: только трал, сборка на площадке), поэтому тариф не приравнивается к
// 50-тонному автокрану парка, а выведен отдельно через WebSearch общего рынка
// (kran365.ru исключён из поиска): аренда гусеничного крана 50 т в Москве — от
// 50 000 ₽/смена по данным greenkran.ru, glavrent.ru, itirus.ru, groskran.ru,
// spectexalliance.ru. У гусеничных кранов «смена» в отраслевой практике длиннее
// 8-часовой смены автокрана (нередко 22 ч) — это оговорено в примечании под ценой,
// чтобы не создавать ложного впечатления прямой сопоставимости с автокраном.
const priceValue = '50 000';
const priceUnit = 'смена';
const priceNote = 'Смена гусеничного крана длиннее, чем у автокрана (уточняется при подаче заявки); доставка на трале и сборка на площадке — отдельная позиция срока и стоимости.';
const priceLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'XCMG QUY50',
  category: 'Гусеничный кран',
  offers: {
    '@type': 'Offer',
    // Аренда, а НЕ продажа. Без явного businessFunction значение по умолчанию —
    // Sell, то есть разметка объявляла бы продажу крана за эту сумму. Техника
    // передаётся во временное пользование (с экипажем, ст. 632 ГК) — LeaseOut.
    businessFunction: 'http://purl.org/goodrelations/v1#LeaseOut',
    priceCurrency: 'RUB',
    price: '50000',
    areaServed: 'Москва',
    priceValidUntil: '2027-02-17',
    seller: { '@id': 'https://moskran-servis.ru/#organization' },
    priceSpecification: { '@type': 'UnitPriceSpecification', price: '50000', priceCurrency: 'RUB', unitText: 'SHIFT' },
  },
};
---
<BaseLayout title={title} description={description} path="/park/xcmg-quy50/" ldExtra={[breadcrumbLd, priceLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/park/">Парк техники</a><span>/</span><span>XCMG QUY50</span>
  </nav>
  <section class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Гусеничный кран · 50 тонн</span>
    <h1 style="margin:14px 0 20px">XCMG QUY50</h1>
    <ModelPrice value={priceValue} unit={priceUnit} note={priceNote} />
    <figure class="model-art model-art--crawler">
      <svg viewBox="0 0 440 260" role="img" focusable="false" aria-label="Чертёж гусеничного крана XCMG QUY50 на гусеничном ходу без выносных опор: грузоподъёмность 50 т, стрела 52 м, гусёк 15,25 м, высота подъёма 57,7 м">
        <defs>
          <pattern id="xc-dots" width="16" height="16" patternUnits="userSpaceOnUse">
            <circle cx="1.3" cy="1.3" r="1.2" fill="var(--line-strong)" />
          </pattern>
          <marker id="xc-tick" markerWidth="10" markerHeight="10" refX="5" refY="5" orient="auto">
            <path d="M5 0 V10" stroke="var(--yellow)" stroke-width="1.4" />
          </marker>
        </defs>
        <rect x="6" y="6" width="428" height="248" fill="url(#xc-dots)" opacity="0.3" />
        <rect x="6" y="6" width="428" height="248" fill="none" stroke="var(--line-strong)" stroke-width="1.4" stroke-dasharray="2 7" />
        <g stroke="var(--yellow)" stroke-width="2.5" stroke-linecap="square" fill="none">
          <path d="M6 26 V6 H26" />
          <path d="M414 6 H434 V26" />
          <path d="M434 234 V254 H414" />
          <path d="M26 254 H6 V234" />
        </g>

        <line x1="14" y1="230" x2="426" y2="230" stroke="var(--muted)" stroke-width="1.6" />

        <path d="M45 228 Q45 200 70 200 H160 Q185 200 185 228 Z" fill="none" stroke="var(--ink)" stroke-width="1.8" />
        <circle cx="60" cy="222" r="7" fill="var(--bg-2)" stroke="var(--ink)" stroke-width="1.2" />
        <circle cx="85" cy="222" r="7" fill="var(--bg-2)" stroke="var(--ink)" stroke-width="1.2" />
        <circle cx="110" cy="222" r="7" fill="var(--bg-2)" stroke="var(--ink)" stroke-width="1.2" />
        <circle cx="135" cy="222" r="7" fill="var(--bg-2)" stroke="var(--ink)" stroke-width="1.2" />
        <circle cx="160" cy="222" r="7" fill="var(--bg-2)" stroke="var(--ink)" stroke-width="1.2" />

        <rect x="68" y="142" width="24" height="26" fill="var(--muted)" />
        <rect x="75" y="150" width="85" height="42" fill="none" stroke="var(--ink)" stroke-width="1.8" />
        <rect x="148" y="158" width="20" height="26" fill="none" stroke="var(--ink)" stroke-width="1.4" />

        <line x1="158" y1="155" x2="390" y2="55" stroke="var(--ink)" stroke-width="3.2" />
        <line x1="390" y1="55" x2="428" y2="26" stroke="var(--muted)" stroke-width="2.2" />
        <line x1="428" y1="26" x2="415" y2="70" stroke="var(--muted)" stroke-width="1.2" stroke-dasharray="1 3" />
        <path d="M411 70 h8 l-3 7 h-2 z" fill="none" stroke="var(--ink)" stroke-width="1.4" />

        <text x="117" y="147" font-family="var(--sans)" font-size="9" fill="var(--ink)" text-anchor="middle" font-weight="700">50 т</text>
        <text x="290" y="90" font-family="var(--sans)" font-size="9" fill="var(--ink)" text-anchor="middle" font-weight="700">52 м</text>
        <text x="404" y="45" font-family="var(--sans)" font-size="8" fill="var(--muted)" text-anchor="end">гусёк 15,25 м</text>
        <text x="63" y="245" font-family="var(--sans)" font-size="7.5" fill="var(--muted)" text-anchor="middle">гусеничный ход — без опор</text>

        <line x1="428" y1="26" x2="418" y2="26" stroke="var(--line-strong)" stroke-width="1.2" />
        <line x1="418" y1="26" x2="418" y2="230" stroke="var(--yellow)" stroke-width="1.4" marker-start="url(#xc-tick)" marker-end="url(#xc-tick)" />
        <text x="424" y="130" font-family="var(--sans)" font-size="10" font-weight="700" fill="var(--yellow)" text-anchor="middle" transform="rotate(90 424 130)">57,7 м</text>
      </svg>
      <figcaption>Схема силуэта — не масштабный чертёж, цифры на выносках соответствуют таблице характеристик ниже.</figcaption>
    </figure>
    <p>Полностью гидравлический гусеничный кран — в отличие от автокранов линейки, работает без выносных опор на грунте (опирается на гусеничный ход целиком), что снимает часть требований к твёрдому покрытию площадки, но требует другой логистики доставки — на трале, а не своим ходом по дорогам общего пользования.</p>

    <table class="ttx">
      <tbody>
        <tr><td>Грузоподъёмность</td><td>50 т</td></tr>
        <tr><td>Длина стрелы</td><td>52 м</td></tr>
        <tr><td>Гусёк</td><td>15,25 м</td></tr>
        <tr><td>Максимальная высота подъёма</td><td>57,7 м</td></tr>
        <tr><td>Мощность двигателя</td><td>115 кВт</td></tr>
        <tr><td>Тип соединения секций стрелы</td><td>пальцевые безрезьбовые (быстрая сборка)</td></tr>
      </tbody>
    </table>

    <h2 style="margin:32px 0 14px">Где применяется</h2>
    <p>Гусеничный ход даёт устойчивость на мягком или неровном грунте, где колёсный автокран того же класса потребовал бы дорогостоящей подготовки площадки под выносные опоры — актуально для промышленных площадок, территорий с незавершённым благоустройством, объектов вне городской застройки. Возможность оснащения грейфером расширяет применение за пределы типового монтажа — включая перегрузку сыпучих материалов. Обратная сторона — доставка на объект только на трале (в отличие от автокрана, который может доехать своим ходом), что нужно закладывать в срок и стоимость подачи техники отдельно.</p>
  </section>
  <section class="section wrap prose" style="padding-top:0;max-width:820px">
    <h2 style="margin-bottom:16px">Что проверяют у этого крана перед выездом</h2>
    <p>Гусеничный кран не едет по дорогам общего пользования: доставка только на трале, и вместе с ней появляется вторая транспортная задача со своими согласованиями. Это первое, что закладывается в срок, — сам кран может быть свободен, а окно на перевозку нет.</p>
    <p>Отсутствие выносных опор не отменяет требований к площадке. Норма запрещает установку подъёмного сооружения для работы на свеженасыпанном неутрамбованном грунте и на уклоне больше паспортного — гусеничного хода это касается ровно так же. Меняется характер нагрузки: она распределённая, а не точечная, но суммарная масса никуда не девается.</p>
    <p>Документальная часть общая: паспорт с записью об освидетельствовании (частичное — раз в 12 месяцев, полное — раз в 3 года), квалификация оператора, приказы о назначении ответственных.</p>
    <h2 style="margin:34px 0 16px">Где гусеничный ход действительно выигрывает</h2>
    <p>Промышленные площадки, территории с незавершённым благоустройством, объекты за городом — там, где подготовка пятна под выносные опоры автокрана обошлась бы дороже доставки гусеничной машины на трале. Ещё один случай — длительная работа на одной площадке с перемещением между точками: гусеничный кран переезжает с грузом на крюке в пределах, оговорённых руководством по эксплуатации, а автокран для каждой новой точки заново вывешивается на опорах.</p>
    <p style="margin-top:18px">Гусеничный ход выигрывает там, где нет твёрдого покрытия, и проигрывает в логистике: перевозка планируется раньше самой смены. Вопросы к объекту собраны в <a href="/proverka-dokumentov/" style="color:var(--yellow)">чек-лист допуска</a>, заявка — через <a href="/#zayavka" style="color:var(--yellow)">форму на главной</a>.</p>
    <Sources
      checked="12.08.2026"
      items={[
        { text: 'Приказ Ростехнадзора от 26.11.2020 №461 (ред. от 16.04.2026): п. 108 — площадка и уклон, п. 110 — выносные опоры, п. 111 — откос выемки, п. 138 — пуск в работу, п. 165 — периодичность освидетельствования, п. 171 и 179 — нагрузки при испытаниях, п. 189 — запись в паспорт', href: 'https://www.consultant.ru/document/cons_doc_LAW_373321/' },
      ]}
    />
  </section>
</main>
<style>
  .ttx { width: 100%; border-collapse: collapse; margin: 20px 0; font-size: var(--t-md); }
  .ttx td { padding: 10px 14px; border-bottom: 1px solid var(--line); }
  .ttx td:first-child { color: var(--muted); width: 45%; }
  .model-art { width: min(100%, 480px); margin: 20px 0 6px; }
  .model-art svg { display: block; width: 100%; height: auto; }
  .model-art figcaption { margin-top: 10px; font-size: var(--t-sm); color: var(--muted); max-width: 60ch; }
</style>
</BaseLayout>
