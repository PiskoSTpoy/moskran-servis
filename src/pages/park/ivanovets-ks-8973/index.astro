---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Sources from '../../../components/Sources.astro';
import ParkCraneArt from '../../../components/ParkCraneArt.astro';
import ModelPrice from '../../../components/ModelPrice.astro';

const title = 'Автокран Ивановец КС-8973 — технические характеристики';
const description = 'Ивановец КС-8973: тяжёлый автокран 100 т на пятиосном шасси, вылет стрелы до 46 м, высота подъёма до 59 м с гуськом. Технические характеристики.';

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Парк техники', item: 'https://moskran-servis.ru/park/' },
    { '@type': 'ListItem', position: 3, name: 'Ивановец КС-8973', item: 'https://moskran-servis.ru/park/ivanovets-ks-8973/' },
  ],
};

// Волна 33 / цена. 100 т — верхний класс, для которого на сайте ещё не было
// опубликованного тарифа (rates[] на главной доходит только до 50 т). Ставка выведена
// самостоятельно через WebSearch общего рынка (kran365.ru исключён из поиска и не
// открывался): аренда автокрана 100 т в Москве — 29 600–144 000 ₽/смена, типичный
// сегмент 70 000–85 000 ₽/смена по данным rent-partner.ru (от 85 000), autotowers.ru,
// kran4rent.ru, yard-imperial.ru, glavarendakran.com, transspecnaz.ru, kranmar.ru
// (от 29 600), mskran.ru. Взято консервативное значение у нижней границы типичного
// сегмента — 70 000 ₽/смена, со словом «от», как и у остальных моделей парка.
const priceValue = '70 000';
const priceUnit = 'смена';
const priceNote = 'Смена — 8 часов, минимальный заказ. Итоговая ставка для этого класса — индивидуально, с учётом маршрута и пятна под опоры.';
const priceLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Ивановец КС-8973',
  category: 'Автокран',
  offers: {
    '@type': 'Offer',
    // Аренда, а НЕ продажа. Без явного businessFunction значение по умолчанию —
    // Sell, то есть разметка объявляла бы продажу крана за эту сумму. Техника
    // передаётся во временное пользование (с экипажем, ст. 632 ГК) — LeaseOut.
    businessFunction: 'http://purl.org/goodrelations/v1#LeaseOut',
    priceCurrency: 'RUB',
    price: '70000',
    areaServed: 'Москва',
    priceValidUntil: '2027-02-17',
    seller: { '@id': 'https://moskran-servis.ru/#organization' },
    priceSpecification: { '@type': 'UnitPriceSpecification', price: '70000', priceCurrency: 'RUB', unitText: 'SHIFT' },
  },
};
---
<BaseLayout title={title} description={description} path="/park/ivanovets-ks-8973/" ldExtra={[breadcrumbLd, priceLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/park/">Парк техники</a><span>/</span><span>Ивановец КС-8973</span>
  </nav>
  <section class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Автокран · 100 тонн</span>
    <h1 style="margin:14px 0 20px">Ивановец КС-8973</h1>
    <ModelPrice value={priceValue} unit={priceUnit} note={priceNote} />
    <ParkCraneArt
      capacity="100 т"
      axles={5}
      boomAngle={54}
      boomLen={168}
      boomHalfWidth={13}
      gusek={{ label: '59 м с гуськом', kink: 4, len: 30 }}
      chassisLabel="спецшасси · 5 осей"
      boomDimLabel="вылет 3,0–46,0 м"
      heightDimLabel="подъём 41,5 м"
    />
    <p>Самая тяжёлая модель в нашем парке — отечественный автокран специального класса на пятиосном шасси, спроектированном для передвижения по дорогам всех категорий своим ходом, без перевозки на трале, в отличие от гусеничных кранов сопоставимой грузоподъёмности.</p>

    <table class="ttx">
      <tbody>
        <tr><td>Грузоподъёмность</td><td>100 т</td></tr>
        <tr><td>Вылет стрелы</td><td>3,0–46,0 м</td></tr>
        <tr><td>Максимальная высота подъёма</td><td>41,5 м (59,0 м с гуськом)</td></tr>
        <tr><td>Шасси</td><td>специальное пятиосное, проходимость по дорогам всех категорий</td></tr>
      </tbody>
    </table>

    <h2 style="margin:32px 0 14px">Где применяется</h2>
    <p>Класс техники для задач, где даже 40–50-тонный автокран не покрывает нужное сочетание веса и вылета — тяжёлое инженерное оборудование (крупные градирни, реакторы, трансформаторы), монтаж и демонтаж элементов промышленных объектов, где единичный груз превышает 30–40 тонн на среднем вылете. В отличие от гусеничного крана сопоставимого класса, этот автокран доезжает до объекта своим ходом по дорогам общего пользования — с учётом требований к согласованию маршрута для тяжеловесного транспорта (см. также нашу статью про маркировку при негабаритной перевозке), что для некоторых объектов быстрее и дешевле, чем доставка гусеничной техники на трале.</p>
    <p>Нагрузка на выносные опоры при полной загрузке у техники этого класса значительно выше, чем у 40–50-тонного сегмента — расчёт несущей способности грунта под площадкой обязателен и проводится индивидуально для каждого объекта, без исключений.</p>
  </section>
  <section class="section wrap prose" style="padding-top:0;max-width:820px">
    <h2 style="margin-bottom:16px">Что проверяют у этой машины перед выездом</h2>
    <p>Сто тонн на пятиосном шасси — верхняя граница того, что вообще едет по городу своим ходом. Транспортная часть допуска здесь тяжелее крановой: пропуск грузового каркаса, регистрация в РНИС, проработанный маршрут и, при выходе габарита за пределы, установленные разделом 23 ПДД, опознавательный знак «Крупногабаритный груз» по Основным положениям по допуску транспортных средств.</p>
    <p>Крановая часть — по общей норме: частичное освидетельствование не реже раза в 12 месяцев, полное — не реже раза в 3 года. Для машины такого класса протокол испытаний при полном освидетельствовании — документ, который стоит посмотреть отдельно: статика проводится грузом 125 % от паспортной грузоподъёмности.</p>
    <p>Расчёт несущей способности грунта под опорами обязателен без исключений: давление на пятно у стотонника таково, что «вроде асфальт» перестаёт быть аргументом. Норма отдельно запрещает установку на свеженасыпанный неутрамбованный грунт.</p>
    <h2 style="margin:34px 0 16px">Своим ходом против трала</h2>
    <p>Гусеничный кран сопоставимого класса приезжает на трале, и это отдельный срок, отдельное согласование и отдельные деньги. Автокран на 100 т доезжает сам — при условии, что маршрут проработан. Именно это сравнение, а не цифра грузоподъёмности, обычно и определяет выбор между двумя типами техники на московском объекте.</p>
    <p style="margin-top:18px">Сто тонн — это уже не «заказать кран», а согласовать заезд, пятно и маршрут доставки. Что из перечисленного готово, а что нет, разбирает <a href="/proverka-dokumentov/" style="color:var(--yellow)">чек-лист допуска</a>; запрос по модели — через <a href="/#zayavka" style="color:var(--yellow)">форму на главной</a>.</p>
    <Sources
      checked="12.08.2026"
      items={[
        { text: 'Приказ Ростехнадзора от 26.11.2020 №461 (ред. от 16.04.2026): п. 108 — площадка и уклон, п. 110 — выносные опоры, п. 111 — откос выемки, п. 138 — пуск в работу, п. 165 — периодичность освидетельствования, п. 171 и 179 — нагрузки при испытаниях, п. 189 — запись в паспорт', href: 'https://www.consultant.ru/document/cons_doc_LAW_373321/' },
        { text: 'Единый транспортный портал Москвы — пропуск для ТС с разрешённой массой свыше 3,5 т в границах МКАД и регистрация в РНИС', href: 'https://transport.mos.ru/gruzoviki/perevod_ckad' },
        { text: 'ПДД РФ, раздел 23 и п. 8 Основных положений по допуску транспортных средств — опознавательный знак «Крупногабаритный груз»' },
      ]}
    />
  </section>
</main>
<style>
  .ttx { width: 100%; border-collapse: collapse; margin: 20px 0; font-size: var(--t-md); }
  .ttx td { padding: 10px 14px; border-bottom: 1px solid var(--line); }
  .ttx td:first-child { color: var(--muted); width: 45%; }
</style>
</BaseLayout>
