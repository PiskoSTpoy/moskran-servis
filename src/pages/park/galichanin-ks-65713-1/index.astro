---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Sources from '../../../components/Sources.astro';
import ParkCraneArt from '../../../components/ParkCraneArt.astro';
import ModelPrice from '../../../components/ModelPrice.astro';

const title = 'Автокран Галичанин КС-65713-1 — технические характеристики';
const description = 'Галичанин КС-65713-1: грузоподъёмность 50 т, стрела 34,1 м, шасси КАМАЗ-65201 (8×4). Технические характеристики и применение.';

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Парк техники', item: 'https://moskran-servis.ru/park/' },
    { '@type': 'ListItem', position: 3, name: 'Галичанин КС-65713-1', item: 'https://moskran-servis.ru/park/galichanin-ks-65713-1/' },
  ],
};

// Волна 33 / цена. 50 т — тариф класса «50 т», уже опубликованный и на калькуляторе
// главной (rates[] в src/pages/index.astro: 3900 ₽/час), и текстом на странице услуги
// /uslugi/arenda-avtokrana-40-50-tonn/ («Базовая ставка — от 3 900 ₽/час»). × 8 ч
// (минимальный заказ — одна смена) = 31 200 ₽/смена. WebSearch общего рынка (kran365.ru
// не использовался): аренда автокрана 50 т в Москве — 2750–5000 ₽/час, посменные от
// 36 000 ₽ — msp-moscow.ru, umiat-termo.ru, trans-alex.ru, mosvektor.ru, kran4rent.ru.
// Наша ставка — у нижней границы диапазона: это осознанный стартовый минимум сайта
// («от»), а не завышение относительно рынка.
const priceValue = '31 200';
const priceUnit = 'смена';
const priceNote = 'Смена — 8 часов, минимальный заказ. Точный расчёт под вылет и надбавки — калькулятор на главной.';
const priceLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Галичанин КС-65713-1',
  category: 'Автокран',
  offers: {
    '@type': 'Offer',
    // Аренда, а НЕ продажа. Без явного businessFunction значение по умолчанию —
    // Sell, то есть разметка объявляла бы продажу крана за эту сумму. Техника
    // передаётся во временное пользование (с экипажем, ст. 632 ГК) — LeaseOut.
    businessFunction: 'http://purl.org/goodrelations/v1#LeaseOut',
    priceCurrency: 'RUB',
    price: '31200',
    areaServed: 'Москва',
    priceValidUntil: '2027-02-17',
    seller: { '@id': 'https://moskran-servis.ru/#organization' },
    priceSpecification: { '@type': 'UnitPriceSpecification', price: '31200', priceCurrency: 'RUB', unitText: 'SHIFT' },
  },
};
---
<BaseLayout title={title} description={description} path="/park/galichanin-ks-65713-1/" ldExtra={[breadcrumbLd, priceLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/park/">Парк техники</a><span>/</span><span>Галичанин КС-65713-1</span>
  </nav>
  <section class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Автокран · 50 тонн</span>
    <h1 style="margin:14px 0 20px">Галичанин КС-65713-1</h1>
    <ModelPrice value={priceValue} unit={priceUnit} note={priceNote} />
    <ParkCraneArt
      capacity="50 т"
      axles={4}
      boomAngle={62}
      boomLen={175}
      boomHalfWidth={11}
      chassisLabel="КАМАЗ-65201 · 8×4"
      boomDimLabel="стрела до 34,1 м"
      noteNearBase="Евро-5"
    />
    <p>Тяжёлый автокран производства Галичского автокранового завода на четырёхосном шасси КАМАЗ-65201 (8×4) — верхний класс грузоподъёмности в линейке отечественных серийных автокранов.</p>

    <table class="ttx">
      <tbody>
        <tr><td>Грузоподъёмность</td><td>50 т</td></tr>
        <tr><td>Длина стрелы</td><td>телескопическая, до 34,1 м</td></tr>
        <tr><td>Шасси</td><td>КАМАЗ-65201, колёсная формула 8×4</td></tr>
        <tr><td>Экологический класс</td><td>Евро-5 (у актуальных модификаций)</td></tr>
      </tbody>
    </table>

    <h2 style="margin:32px 0 14px">Где применяется</h2>
    <p>Класс техники для тяжёлых монтажей и крупногабаритного оборудования, где 25–32-тонной техники уже недостаточно — крупные ЖБИ, тяжёлые инженерные установки, демонтаж массивных конструкций. Четырёхосное шасси даёт больше устойчивости на выносных опорах при полном вылете по сравнению с более лёгкими трёхосными аналогами того же класса грузоподъёмности.</p>
    <p>Подробнее о задачах и требованиях к площадке для этого класса — на странице услуги <a href="/uslugi/arenda-avtokrana-40-50-tonn/" style="color:var(--yellow)">«Автокраны 40–50 тонн»</a>.</p>
  </section>
  <section class="section wrap prose" style="padding-top:0;max-width:820px">
    <h2 style="margin-bottom:16px">Что проверяют у этой машины перед выездом</h2>
    <p>Четыре оси и 50 тонн — это машина, у которой транспортная часть допуска не менее важна, чем крановая. Разрешённая максимальная масса заведомо превышает 3,5 т, поэтому в границах МКАД нужен пропуск грузового каркаса и регистрация в системе РНИС, а маршрут строится с учётом мостов и путепроводов с ограничением по массе.</p>
    <p>Крановая часть — стандартная по норме, но с более дорогими последствиями ошибки: частичное освидетельствование не реже раза в 12 месяцев, полное — не реже раза в 3 года. При полном освидетельствовании статические испытания проводятся грузом 125 % от паспортной грузоподъёмности, то есть для 50-тонной машины речь идёт о 62,5 т испытательного груза.</p>
    <p>Установка — на все выносные опоры, если руководство не предусматривает иного. У тяжёлого класса это принципиально: нагрузка на одну опору такова, что асфальт бытового двора её не держит, и подкладки здесь не формальность.</p>
    <h2 style="margin:34px 0 16px">Что уточняем до подачи</h2>
    <p>Размер пятна под опоры при полном вылете, состояние покрытия и наличие под площадкой подземных сооружений — паркинга, коллектора, обратной засыпки. В Москве точка постановки тяжёлого крана чаще оказывается над чем-то, чем на природном грунте, поэтому подбор идёт от допустимой нагрузки на пятно к машине, а не наоборот.</p>
    <p style="margin-top:18px">У четырёхосной машины узкое место — не бумаги, а пятно под опоры и маршрут с мостами. Что из этого уже закрыто на вашем объекте, покажет <a href="/proverka-dokumentov/" style="color:var(--yellow)">чек-лист допуска</a>; забронировать модель — через <a href="/#zayavka" style="color:var(--yellow)">форму на главной</a>.</p>
    <Sources
      checked="12.08.2026"
      items={[
        { text: 'Приказ Ростехнадзора от 26.11.2020 №461 (ред. от 16.04.2026): п. 108 — площадка и уклон, п. 110 — выносные опоры, п. 111 — откос выемки, п. 138 — пуск в работу, п. 165 — периодичность освидетельствования, п. 171 и 179 — нагрузки при испытаниях, п. 189 — запись в паспорт', href: 'https://www.consultant.ru/document/cons_doc_LAW_373321/' },
        { text: 'Единый транспортный портал Москвы — пропуск для ТС с разрешённой массой свыше 3,5 т в границах МКАД и регистрация в РНИС', href: 'https://transport.mos.ru/gruzoviki/perevod_ckad' },
      ]}
    />
  </section>
</main>
<style>
  .ttx { width: 100%; border-collapse: collapse; margin: 20px 0; font-size: var(--t-md); }
  .ttx td { padding: 10px 14px; border-bottom: 1px solid var(--line); }
  .ttx td:first-child { color: var(--muted); width: 45%; }
</style>
</BaseLayout>
