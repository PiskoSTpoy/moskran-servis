---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Sources from '../../../components/Sources.astro';
import ModelPrice from '../../../components/ModelPrice.astro';

const title = 'Башенный кран Potain MDT 178 — технические характеристики';
const description = 'Potain MDT 178: грузоподъёмность 8 т, вылет стрелы 60 м, высота подъёма до 74,5 м, безоголовочная конструкция. Технические характеристики.';

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Парк техники', item: 'https://moskran-servis.ru/park/' },
    { '@type': 'ListItem', position: 3, name: 'Potain MDT 178', item: 'https://moskran-servis.ru/park/potain-mdt-178/' },
  ],
};

// Волна 33 / цена. У этой модели на сайте указана грузоподъёмность (8 т) и вылет
// (60 м), но не грузовой момент в тм — значит, прямая привязка к вилке
// /uslugi/bashennyy-kran/ (та привязана по тм) невозможна без домысливания непроверенной
// характеристики. Ставка выведена независимо через WebSearch общего рынка (kran365.ru
// не использовался): аренда башенного крана в Москве — от 240 000 ₽/мес в целом по
// рынку, крупные модели 400 000–500 000+ ₽/мес, у сопоставимых по классу Potain — от
// 350 000 ₽/мес (модель IGO 50, меньшего класса) до 720 000+ ₽/мес у крупных Liebherr
// — glavrentakran.ru, kranauto.ru, rentakran.ru, spetstehnika-novosti.ru. MDT 178 —
// крупная модель (8 т у мачты, вылет 60 м), поэтому взято значение в верхней части
// диапазона, но ниже уже опубликованного тарифа для Liebherr 132 EC-H8 (780 000 ₽/мес,
// см. park/liebherr-132-ec-h8/index.astro) — у той модели грузовой момент точно
// известен и документально закреплён, у этой — нет, поэтому её ставка не завышается
// до того же уровня.
const priceValue = '650 000';
const priceUnit = 'мес';
const priceNote = 'Помесячная аренда, монтаж/демонтаж — отдельной строкой. Ориентир по общему рынку — тм для этой модели на сайте не указан.';
const priceLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Potain MDT 178',
  category: 'Башенный кран',
  offers: {
    '@type': 'Offer',
    // Аренда, а НЕ продажа. Без явного businessFunction значение по умолчанию —
    // Sell, то есть разметка объявляла бы продажу крана за эту сумму. Техника
    // передаётся во временное пользование (с экипажем, ст. 632 ГК) — LeaseOut.
    businessFunction: 'http://purl.org/goodrelations/v1#LeaseOut',
    priceCurrency: 'RUB',
    price: '650000',
    areaServed: 'Москва',
    priceValidUntil: '2027-02-17',
    seller: { '@id': 'https://moskran-servis.ru/#organization' },
    priceSpecification: { '@type': 'UnitPriceSpecification', price: '650000', priceCurrency: 'RUB', unitText: 'MONTH' },
  },
};
---
<BaseLayout title={title} description={description} path="/park/potain-mdt-178/" ldExtra={[breadcrumbLd, priceLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/park/">Парк техники</a><span>/</span><span>Potain MDT 178</span>
  </nav>
  <section class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Башенный кран · грузоподъёмность 8 т</span>
    <h1 style="margin:14px 0 20px">Potain MDT 178</h1>
    <ModelPrice value={priceValue} unit={priceUnit} note={priceNote} />
    <figure class="model-photo">
      <picture>
        <source srcset="/images/park/potain-mdt-178.webp" type="image/webp" />
        <img
          src="/images/park/potain-mdt-178.jpg"
          width="1280"
          height="960"
          loading="lazy"
          decoding="async"
          alt="Башенный кран Potain MDT 178 безоголовочной конструкции на объекте в Сен-Приесте, Франция — фото модели производителя, не конкретная машина из нашего парка"
        />
      </picture>
      <figcaption>Фото этой модели крана (не единица нашего парка — иллюстрация внешнего вида и конструкции). Сен-Приест, Франция, октябрь 2019. Автор: Benoît Prieur, лицензия <a href="https://creativecommons.org/publicdomain/zero/1.0/deed.ru" target="_blank" rel="noopener">CC0 (общественное достояние)</a>, <a href="https://commons.wikimedia.org/wiki/File:Potain_MDT_178_%C3%A0_Saint-Priest_(Rh%C3%B4ne).jpg" target="_blank" rel="noopener">Wikimedia Commons</a>.</figcaption>
    </figure>
    <figure class="model-art model-art--tower">
      <svg viewBox="0 0 320 380" role="img" focusable="false" aria-label="Чертёж башенного крана Potain MDT 178 безоголовочной (flat-top) конструкции без вершинной части и оттяжек: грузоподъёмность 8 т у мачты и 1,5 т на максимальном вылете 60 м, высота подъёма до 74,5 м, высота крана 86,9 м">
        <defs>
          <pattern id="pt-dots" width="16" height="16" patternUnits="userSpaceOnUse">
            <circle cx="1.3" cy="1.3" r="1.2" fill="var(--line-strong)" />
          </pattern>
          <marker id="pt-tick" markerWidth="10" markerHeight="10" refX="5" refY="5" orient="auto">
            <path d="M5 0 V10" stroke="var(--yellow)" stroke-width="1.4" />
          </marker>
        </defs>
        <rect x="6" y="6" width="308" height="368" fill="url(#pt-dots)" opacity="0.3" />
        <rect x="6" y="6" width="308" height="368" fill="none" stroke="var(--line-strong)" stroke-width="1.4" stroke-dasharray="2 7" />
        <g stroke="var(--yellow)" stroke-width="2.5" stroke-linecap="square" fill="none">
          <path d="M6 26 V6 H26" />
          <path d="M294 6 H314 V26" />
          <path d="M314 354 V374 H294" />
          <path d="M26 374 H6 V354" />
        </g>

        <line x1="14" y1="350" x2="306" y2="350" stroke="var(--muted)" stroke-width="1.6" />

        <g stroke="var(--ink)" stroke-width="2.2" fill="none">
          <line x1="150" y1="350" x2="150" y2="64" />
          <line x1="162" y1="350" x2="162" y2="64" />
          <line x1="150" y1="330" x2="162" y2="310" stroke-width="1.2" />
          <line x1="162" y1="330" x2="150" y2="310" stroke-width="1.2" />
          <line x1="150" y1="290" x2="162" y2="270" stroke-width="1.2" />
          <line x1="162" y1="290" x2="150" y2="270" stroke-width="1.2" />
          <line x1="150" y1="250" x2="162" y2="230" stroke-width="1.2" />
          <line x1="162" y1="250" x2="150" y2="230" stroke-width="1.2" />
          <line x1="150" y1="210" x2="162" y2="190" stroke-width="1.2" />
          <line x1="162" y1="210" x2="150" y2="190" stroke-width="1.2" />
          <line x1="150" y1="170" x2="162" y2="150" stroke-width="1.2" />
          <line x1="162" y1="170" x2="150" y2="150" stroke-width="1.2" />
          <line x1="150" y1="130" x2="162" y2="110" stroke-width="1.2" />
          <line x1="162" y1="130" x2="150" y2="110" stroke-width="1.2" />
          <line x1="150" y1="90" x2="162" y2="70" stroke-width="1.2" />
          <line x1="162" y1="90" x2="150" y2="70" stroke-width="1.2" />
        </g>

        {/* плоский верх: сразу горизонтальный стрелоблок на мачте — без вершинной части и оттяжек, в отличие от Liebherr 132 EC-H8 */}
        <rect x="148" y="50" width="16" height="14" fill="none" stroke="var(--ink)" stroke-width="1.6" />
        <text x="170" y="60" font-family="var(--sans)" font-size="8" fill="var(--muted)">86,9 м — высота крана</text>

        <line x1="162" y1="64" x2="284" y2="64" stroke="var(--ink)" stroke-width="2.2" />
        <rect x="222" y="61" width="6" height="6" fill="var(--yellow)" />
        <line x1="225" y1="67" x2="225" y2="82" stroke="var(--muted)" stroke-width="1.2" stroke-dasharray="1 3" />
        <path d="M221 82 h8 l-3 7 h-2 z" fill="none" stroke="var(--ink)" stroke-width="1.4" />

        <line x1="150" y1="64" x2="104" y2="64" stroke="var(--ink)" stroke-width="2.2" />
        <rect x="88" y="58" width="16" height="13" fill="var(--muted)" />

        <text x="185" y="79" font-family="var(--sans)" font-size="8.5" fill="var(--ink)" text-anchor="middle" font-weight="700">8 т</text>
        <text x="280" y="58" font-family="var(--sans)" font-size="8" fill="var(--muted)" text-anchor="end">1,5 т</text>

        <g stroke="var(--line-strong)" stroke-width="1.2">
          <line x1="162" y1="64" x2="162" y2="40" />
          <line x1="284" y1="64" x2="284" y2="40" />
        </g>
        <line x1="162" y1="40" x2="284" y2="40" stroke="var(--yellow)" stroke-width="1.4" marker-start="url(#pt-tick)" marker-end="url(#pt-tick)" />
        <text x="223" y="34" font-family="var(--sans)" font-size="10" font-weight="700" fill="var(--yellow)" text-anchor="middle">вылет 60 м</text>

        <g stroke="var(--line-strong)" stroke-width="1.2">
          <line x1="162" y1="64" x2="296" y2="64" />
          <line x1="162" y1="350" x2="296" y2="350" />
        </g>
        <line x1="292" y1="68" x2="292" y2="346" stroke="var(--yellow)" stroke-width="1.4" marker-start="url(#pt-tick)" marker-end="url(#pt-tick)" />
        <text x="300" y="210" font-family="var(--sans)" font-size="10" font-weight="700" fill="var(--yellow)" text-anchor="middle" transform="rotate(90 300 210)">74,5 м</text>

        <circle cx="128" cy="340" r="9" fill="none" stroke="var(--muted)" stroke-width="1.2" />
        <path d="M122 340 a6 4 0 1 0 12 0" fill="none" stroke="var(--muted)" stroke-width="1" />
        <text x="128" y="360" font-family="var(--sans)" font-size="7.5" fill="var(--muted)" text-anchor="middle">634 м каната</text>
      </svg>
      <figcaption>Схема силуэта — не масштабный чертёж, цифры на выносках соответствуют таблице характеристик ниже.</figcaption>
    </figure>
    <p>Французский башенный кран с безоголовочной («flat-top») конструкцией — в отличие от классической схемы с вершинной частью и оттяжками (как у Liebherr 132 EC-H8), у этой модели плоский верх без выступающих элементов, что удобно при работе нескольких кранов рядом на одной площадке.</p>

    <table class="ttx">
      <tbody>
        <tr><td>Грузоподъёмность</td><td>8 т (на минимальном вылете)</td></tr>
        <tr><td>Вылет стрелы</td><td>до 60 м</td></tr>
        <tr><td>Грузоподъёмность на максимальном вылете</td><td>1,5 т</td></tr>
        <tr><td>Высота подъёма</td><td>до 74,5 м</td></tr>
        <tr><td>Высота крана (одно крепление к зданию)</td><td>86,9 м</td></tr>
        <tr><td>Канатоёмкость барабана</td><td>634 м</td></tr>
      </tbody>
    </table>

    <h2 style="margin:32px 0 14px">Где применяется</h2>
    <p>Безоголовочная конструкция — практическое преимущество на площадках, где рядом работает несколько башенных кранов одновременно (например, в кварталах комплексной жилой застройки): у соседних кранов не возникает риска зацепа за оттяжки и вершинную часть при пересечении зон действия стрел. Вылет до 60 метров при этом остаётся конкурентным для крана этого класса грузоподъёмности — подходит для площадок, где здание вытянуто в длину, а кран физически может стоять только с одной стороны.</p>
    <p>Подробнее о логике аренды башенного крана, монтаже и требованиях к фундаменту — на странице услуги <a href="/uslugi/bashennyy-kran/" style="color:var(--yellow)">«Башенный кран»</a>.</p>
  </section>
  <section class="section wrap prose" style="padding-top:0;max-width:820px">
    <h2 style="margin-bottom:16px">Что проверяют у башенного крана перед пуском</h2>
    <p>Пуск в работу после установки на объекте принимает комиссия с участием уполномоченного представителя надзорного органа — это прямо предусмотренная процедура для башенных кранов, а не внутреннее решение подрядчика. Планируется вместе с монтажом, а не после него.</p>
    <p>Основание закрывается актом освидетельствования скрытых работ до установки крана. Дальше — обычная периодичность: частичное освидетельствование не реже раза в 12 месяцев, полное — не реже раза в 3 года, результаты в паспорте с датой следующего.</p>
    <p>Отдельно проверяются приборы и устройства безопасности, включая концевые выключатели механизмов: у крана, который стоит на объекте месяцами и работает в постоянном цикле, это не разовая проверка при монтаже.</p>
    <h2 style="margin:34px 0 16px">Плоский верх и работа в связке</h2>
    <p>Безоголовочная схема нужна там, где зоны действия нескольких кранов пересекаются: у соседних машин нет вершинной части и оттяжек, за которые можно зацепиться при повороте стрелы. В кварталах комплексной застройки это влияет на саму схему расстановки кранов — и на то, сколько их вообще понадобится на площадку.</p>
    <p style="margin-top:18px">Дату здесь определяет не наличие крана, а готовность основания и процедура пуска в работу. Разложить это по шагам помогает <a href="/proverka-dokumentov/" style="color:var(--yellow)">чек-лист допуска</a>; по конкретному проекту пишите через <a href="/#zayavka" style="color:var(--yellow)">форму на главной</a>.</p>
    <Sources
      checked="12.08.2026"
      items={[
        { text: 'Приказ Ростехнадзора от 26.11.2020 №461 (ред. от 16.04.2026): п. 108 — площадка и уклон, п. 110 — выносные опоры, п. 111 — откос выемки, п. 138 — пуск в работу, п. 165 — периодичность освидетельствования, п. 171 и 179 — нагрузки при испытаниях, п. 189 — запись в паспорт', href: 'https://www.consultant.ru/document/cons_doc_LAW_373321/' },
      ]}
    />
  </section>
</main>
<style>
  .ttx { width: 100%; border-collapse: collapse; margin: 20px 0; font-size: var(--t-md); }
  .ttx td { padding: 10px 14px; border-bottom: 1px solid var(--line); }
  .ttx td:first-child { color: var(--muted); width: 45%; }
  .model-art { width: min(100%, 320px); margin: 20px 0 6px; }
  .model-art svg { display: block; width: 100%; height: auto; }
  .model-art figcaption { margin-top: 10px; font-size: var(--t-sm); color: var(--muted); max-width: 60ch; }
  .model-photo { width: 100%; max-width: 640px; margin: 20px 0 6px; }
  .model-photo img { display: block; width: 100%; height: auto; border: 1px solid var(--line-strong); }
  .model-photo figcaption { margin-top: 10px; font-size: var(--t-xs); color: var(--muted); max-width: 70ch; }
  .model-photo figcaption a { color: var(--muted); text-decoration: underline; text-underline-offset: 2px; }
  .model-photo figcaption a:hover { color: var(--yellow); }
</style>
</BaseLayout>
