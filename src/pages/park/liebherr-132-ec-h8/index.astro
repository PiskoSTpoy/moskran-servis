---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Sources from '../../../components/Sources.astro';
import ModelPrice from '../../../components/ModelPrice.astro';

const title = 'Башенный кран Liebherr 132 EC-H8 — характеристики';
const description = 'Liebherr 132 EC-H8: грузовой момент 132 тм, грузоподъёмность до 8 т, высота подъёма 50,5–72,1 м в зависимости от типа башни. Характеристики.';

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Парк техники', item: 'https://moskran-servis.ru/park/' },
    { '@type': 'ListItem', position: 3, name: 'Liebherr 132 EC-H8', item: 'https://moskran-servis.ru/park/liebherr-132-ec-h8/' },
  ],
};

// Волна 33 / цена. Грузовой момент модели — 132 тм (см. таблицу характеристик ниже),
// что попадает в верхнюю из трёх вилок, уже опубликованных на /uslugi/bashennyy-kran/
// («до 160 тм — от 780 000 ₽/мес»; 132 > 125, значит следующая вилка — «до 160»).
// Число не новое — то же самое, что уже стоит на сайте для этого класса момента, без
// внутреннего противоречия. WebSearch общего рынка (kran365.ru не использовался)
// подтверждает порядок цифр для крупных башенных кранов в Москве: аренда башенного
// крана — от 240 000 ₽/мес в целом по рынку, для крупных моделей 400 000–500 000+
// ₽/мес, у крупного Liebherr (280 EC-H12) — от 720 000 ₽/мес — glavrentakran.ru,
// kranauto.ru, rentakran.ru, spetstehnika-novosti.ru.
const priceValue = '780 000';
const priceUnit = 'мес';
const priceNote = 'Помесячная аренда, монтаж/демонтаж — отдельной строкой. Соответствует вилке «до 160 тм» на странице услуги «Башенный кран».';
const priceLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Liebherr 132 EC-H8',
  category: 'Башенный кран',
  offers: {
    '@type': 'Offer',
    // Аренда, а НЕ продажа. Без явного businessFunction значение по умолчанию —
    // Sell, то есть разметка объявляла бы продажу крана за эту сумму. Техника
    // передаётся во временное пользование (с экипажем, ст. 632 ГК) — LeaseOut.
    businessFunction: 'http://purl.org/goodrelations/v1#LeaseOut',
    priceCurrency: 'RUB',
    price: '780000',
    areaServed: 'Москва',
    priceValidUntil: '2027-02-17',
    seller: { '@id': 'https://moskran-servis.ru/#organization' },
    priceSpecification: { '@type': 'UnitPriceSpecification', price: '780000', priceCurrency: 'RUB', unitText: 'MONTH' },
  },
};
---
<BaseLayout title={title} description={description} path="/park/liebherr-132-ec-h8/" ldExtra={[breadcrumbLd, priceLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/park/">Парк техники</a><span>/</span><span>Liebherr 132 EC-H8</span>
  </nav>
  <section class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Башенный кран · класс 80 тм (см. услугу)</span>
    <h1 style="margin:14px 0 20px">Liebherr 132 EC-H8</h1>
    <ModelPrice value={priceValue} unit={priceUnit} note={priceNote} />
    <figure class="model-photo">
      <picture>
        <source srcset="/images/park/liebherr-132-ec-h8.webp" type="image/webp" />
        <img
          src="/images/park/liebherr-132-ec-h8.jpg"
          width="1280"
          height="853"
          loading="lazy"
          decoding="async"
          alt="Башенный кран Liebherr 132 EC-H8 Litronic на монтаже жилого комплекса LIVINGSTONE II в Люксембурге — фото модели производителя, не конкретная машина из нашего парка"
        />
      </picture>
      <figcaption>Фото этой модели крана (не единица нашего парка — иллюстрация внешнего вида и конструкции). Люксембург, июнь 2019. Автор: Alexandre Prevot, лицензия <a href="https://creativecommons.org/licenses/by-sa/2.0/" target="_blank" rel="noopener">CC BY-SA 2.0</a>, <a href="https://commons.wikimedia.org/wiki/File:Liebherr_132_EC-H_8_Litronic_(52642225648).jpg" target="_blank" rel="noopener">Wikimedia Commons</a>.</figcaption>
    </figure>
    <figure class="model-art model-art--tower">
      <svg viewBox="0 0 300 360" role="img" focusable="false" aria-label="Чертёж башенного крана Liebherr 132 EC-H8 классической схемы с вершинной частью и оттяжками: грузовой момент 132 тм, грузоподъёмность 8 т у мачты и 1,7 т у оголовка стрелы, высота подъёма от 50,5 м (мачта 132 HC) до 72,1 м (мачта 290 HC, база 8 м)">
        <defs>
          <pattern id="lb-dots" width="16" height="16" patternUnits="userSpaceOnUse">
            <circle cx="1.3" cy="1.3" r="1.2" fill="var(--line-strong)" />
          </pattern>
          <marker id="lb-tick" markerWidth="10" markerHeight="10" refX="5" refY="5" orient="auto">
            <path d="M5 0 V10" stroke="var(--yellow)" stroke-width="1.4" />
          </marker>
        </defs>
        <rect x="6" y="6" width="288" height="348" fill="url(#lb-dots)" opacity="0.3" />
        <rect x="6" y="6" width="288" height="348" fill="none" stroke="var(--line-strong)" stroke-width="1.4" stroke-dasharray="2 7" />
        <g stroke="var(--yellow)" stroke-width="2.5" stroke-linecap="square" fill="none">
          <path d="M6 26 V6 H26" />
          <path d="M274 6 H294 V26" />
          <path d="M294 334 V354 H274" />
          <path d="M26 354 H6 V334" />
        </g>

        <line x1="14" y1="330" x2="286" y2="330" stroke="var(--muted)" stroke-width="1.6" />

        <g>
          <rect x="30" y="239" width="12" height="91" fill="var(--line-strong)" />
          <rect x="50" y="219" width="12" height="111" fill="var(--line-strong)" />
          <rect x="70" y="212" width="12" height="118" fill="var(--line-strong)" />
          <rect x="90" y="200" width="12" height="130" fill="var(--yellow)" />
        </g>
        <g font-family="var(--sans)" font-size="7.5" fill="var(--muted)" text-anchor="middle">
          <text x="36" y="234">50,5</text>
          <text x="56" y="214">61,4</text>
          <text x="76" y="207">65,6</text>
          <text x="96" y="195" fill="var(--yellow)" font-weight="700">72,1</text>
        </g>
        <text x="63" y="345" font-family="var(--sans)" font-size="8.5" fill="var(--muted)" text-anchor="middle">4 варианта мачты, м</text>

        <g stroke="var(--ink)" stroke-width="2.2" fill="none">
          <line x1="188" y1="330" x2="188" y2="70" />
          <line x1="202" y1="330" x2="202" y2="70" />
          <line x1="188" y1="310" x2="202" y2="290" stroke-width="1.2" />
          <line x1="202" y1="310" x2="188" y2="290" stroke-width="1.2" />
          <line x1="188" y1="270" x2="202" y2="250" stroke-width="1.2" />
          <line x1="202" y1="270" x2="188" y2="250" stroke-width="1.2" />
          <line x1="188" y1="230" x2="202" y2="210" stroke-width="1.2" />
          <line x1="202" y1="230" x2="188" y2="210" stroke-width="1.2" />
          <line x1="188" y1="190" x2="202" y2="170" stroke-width="1.2" />
          <line x1="202" y1="190" x2="188" y2="170" stroke-width="1.2" />
          <line x1="188" y1="150" x2="202" y2="130" stroke-width="1.2" />
          <line x1="202" y1="150" x2="188" y2="130" stroke-width="1.2" />
          <line x1="188" y1="110" x2="202" y2="90" stroke-width="1.2" />
          <line x1="202" y1="110" x2="188" y2="90" stroke-width="1.2" />
        </g>

        <path d="M195 70 L195 42" stroke="var(--ink)" stroke-width="2.2" fill="none" />
        <path d="M195 42 L258 86 M195 42 L130 86" stroke="var(--muted)" stroke-width="1.2" fill="none" />

        <line x1="202" y1="86" x2="268" y2="86" stroke="var(--ink)" stroke-width="2.2" />
        <rect x="228" y="82" width="7" height="7" fill="var(--yellow)" />
        <line x1="231" y1="89" x2="231" y2="108" stroke="var(--muted)" stroke-width="1.2" stroke-dasharray="1 3" />
        <path d="M227 108 h8 l-3 7 h-2 z" fill="none" stroke="var(--ink)" stroke-width="1.4" />

        <line x1="188" y1="86" x2="132" y2="86" stroke="var(--ink)" stroke-width="2.2" />
        <rect x="118" y="80" width="16" height="13" fill="var(--muted)" />

        <rect x="182" y="90" width="14" height="12" fill="none" stroke="var(--ink)" stroke-width="1.4" />

        <g stroke="var(--line-strong)" stroke-width="1.2">
          <line x1="270" y1="86" x2="284" y2="86" />
          <line x1="270" y1="330" x2="284" y2="330" />
        </g>
        <line x1="280" y1="90" x2="280" y2="326" stroke="var(--yellow)" stroke-width="1.4" marker-start="url(#lb-tick)" marker-end="url(#lb-tick)" />
        <text x="286" y="210" font-family="var(--sans)" font-size="10" font-weight="700" fill="var(--yellow)" text-anchor="middle" transform="rotate(90 286 210)">72,1 м</text>

        <text x="231" y="78" font-family="var(--sans)" font-size="8.5" fill="var(--ink)" text-anchor="middle" font-weight="700">8 т</text>
        <text x="264" y="98" font-family="var(--sans)" font-size="8" fill="var(--muted)" text-anchor="end">1,7 т</text>
        <text x="150" y="78" font-family="var(--sans)" font-size="8.5" fill="var(--ink)" text-anchor="middle" font-weight="700">132 тм</text>
      </svg>
      <figcaption>Схема силуэта — не масштабный чертёж, цифры на выносках соответствуют таблице характеристик ниже.</figcaption>
    </figure>
    <p>Немецкий приставной башенный кран профессионального класса — одна из самых распространённых моделей на объектах монолитного домостроения в Москве в диапазоне грузового момента, близком к нашему базовому классу «до 80 тм» (см. <a href="/#zayavka" style="color:var(--yellow)">ориентир по стоимости на главной</a>).</p>

    <table class="ttx">
      <tbody>
        <tr><td>Грузовой момент</td><td>132 тм</td></tr>
        <tr><td>Максимальная грузоподъёмность</td><td>8 т (у оголовка стрелы — 1,7 т)</td></tr>
        <tr><td>Скорость подъёма груза</td><td>222 м/мин</td></tr>
        <tr><td>Скорость движения каретки</td><td>142 м/мин</td></tr>
        <tr><td>Высота подъёма (башня 132 HC)</td><td>50,5 м</td></tr>
        <tr><td>Высота подъёма (башня 200 HC)</td><td>61,4 м</td></tr>
        <tr><td>Высота подъёма (башня 290 HC, база 6 м)</td><td>65,6 м</td></tr>
        <tr><td>Высота подъёма (башня 290 HC, база 8 м)</td><td>72,1 м</td></tr>
      </tbody>
    </table>

    <h2 style="margin:32px 0 14px">Где применяется</h2>
    <p>Модульная система из четырёх типов башни позволяет подобрать высоту подъёма под конкретный объект без смены модели крана целиком — от 50,5 м для зданий средней этажности до 72,1 м для высотных объектов. Высокая скорость подъёма груза (222 м/мин) сокращает цикл подачи материалов на верхние этажи по сравнению с более медленными моделями того же класса — параметр, значимый именно для монолитного строительства, где кран работает в постоянном цикле подачи бетона и арматуры.</p>
    <p>Подробнее о логике аренды башенного крана, монтаже и требованиях к фундаменту — на странице услуги <a href="/uslugi/bashennyy-kran/" style="color:var(--yellow)">«Башенный кран»</a>.</p>
  </section>
  <section class="section wrap prose" style="padding-top:0;max-width:820px">
    <h2 style="margin-bottom:16px">Что проверяют у башенного крана перед пуском</h2>
    <p>У башенного крана допуск устроен принципиально иначе, чем у автокрана: решение о пуске в работу после установки на объекте принимается на основании предложений комиссии, в состав которой входит уполномоченный представитель надзорного органа. Это отдельный этап графика стройки со своим сроком, и сжать его до дня монтажа нельзя.</p>
    <p>До этого закрывается основание: работы по его подготовке оформляются актом освидетельствования скрытых работ. После установки крана проверить, что было под плитой, физически невозможно — отсюда и сам жанр документа.</p>
    <p>Периодичность освидетельствования общая: частичное — не реже раза в 12 месяцев, полное — не реже раза в 3 года, с записью в паспорт и указанием срока следующего.</p>
    <h2 style="margin:34px 0 16px">Как читать модульность башни</h2>
    <p>Четыре варианта башни дают высоту подъёма от 50,5 до 72,1 м, и это не просто «выше — лучше»: каждая конфигурация означает свой фундамент, своё крепление к зданию и свой монтажный график. Высоту выбирают под конкретный объект на этапе проекта, а не подбирают по факту, поэтому вопрос о башне возникает раньше вопроса о цене аренды.</p>
    <p style="margin-top:18px">Башенный кран берут не на смену, а на месяцы, и считают в первую очередь не ставку, а фундамент, питание и сроки пуска. Свести вводные помогает <a href="/proverka-dokumentov/" style="color:var(--yellow)">чек-лист допуска</a>; проект обсуждаем через <a href="/#zayavka" style="color:var(--yellow)">форму на главной</a>.</p>
    <Sources
      checked="12.08.2026"
      items={[
        { text: 'Приказ Ростехнадзора от 26.11.2020 №461 (ред. от 16.04.2026): п. 108 — площадка и уклон, п. 110 — выносные опоры, п. 111 — откос выемки, п. 138 — пуск в работу, п. 165 — периодичность освидетельствования, п. 171 и 179 — нагрузки при испытаниях, п. 189 — запись в паспорт', href: 'https://www.consultant.ru/document/cons_doc_LAW_373321/' },
      ]}
    />
  </section>
</main>
<style>
  .ttx { width: 100%; border-collapse: collapse; margin: 20px 0; font-size: var(--t-md); }
  .ttx td { padding: 10px 14px; border-bottom: 1px solid var(--line); }
  .ttx td:first-child { color: var(--muted); width: 45%; }
  .model-art { width: min(100%, 300px); margin: 20px 0 6px; }
  .model-art svg { display: block; width: 100%; height: auto; }
  .model-art figcaption { margin-top: 10px; font-size: var(--t-sm); color: var(--muted); max-width: 60ch; }
  .model-photo { width: 100%; max-width: 640px; margin: 20px 0 6px; }
  .model-photo img { display: block; width: 100%; height: auto; border: 1px solid var(--line-strong); }
  .model-photo figcaption { margin-top: 10px; font-size: var(--t-xs); color: var(--muted); max-width: 70ch; }
  .model-photo figcaption a { color: var(--muted); text-decoration: underline; text-underline-offset: 2px; }
  .model-photo figcaption a:hover { color: var(--yellow); }
</style>
</BaseLayout>
