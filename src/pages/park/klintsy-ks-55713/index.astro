---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Sources from '../../../components/Sources.astro';
import ParkCraneArt from '../../../components/ParkCraneArt.astro';
import ModelPrice from '../../../components/ModelPrice.astro';

const title = 'Автокран Клинцы КС-55713 — технические характеристики';
const description = 'Клинцы КС-55713: грузоподъёмность 25 т, грузовой момент 80 тм, телескопическая стрела 21–24 м + гусёк 7,5 м. Технические характеристики.';

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Парк техники', item: 'https://moskran-servis.ru/park/' },
    { '@type': 'ListItem', position: 3, name: 'Клинцы КС-55713', item: 'https://moskran-servis.ru/park/klintsy-ks-55713/' },
  ],
};

// Волна 33 / цена. 25 т — тот же тариф класса «25 т», что и у остальных 25-тонных
// моделей парка (см. комментарий в park/ivanovets-ks-45717/index.astro): 2600 ₽/час
// (rates[] в src/pages/index.astro) × 8 ч = 20 800 ₽/смена. WebSearch общего рынка
// (kran365.ru не использовался): 1200–4500 ₽/час, 15 000–16 500 ₽/смена — glavarendakran.com,
// kranauto.ru, manipulyator-avtokran.ru, msp-moscow.ru, agrostroymech.ru, ragnarr.ru.
const priceValue = '20 800';
const priceUnit = 'смена';
const priceNote = 'Смена — 8 часов, минимальный заказ. Точный расчёт под вылет и надбавки — калькулятор на главной.';
const priceLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Клинцы КС-55713',
  category: 'Автокран',
  offers: {
    '@type': 'Offer',
    // Аренда, а НЕ продажа. Без явного businessFunction значение по умолчанию —
    // Sell, то есть разметка объявляла бы продажу крана за эту сумму. Техника
    // передаётся во временное пользование (с экипажем, ст. 632 ГК) — LeaseOut.
    businessFunction: 'http://purl.org/goodrelations/v1#LeaseOut',
    priceCurrency: 'RUB',
    price: '20800',
    areaServed: 'Москва',
    priceValidUntil: '2027-02-17',
    seller: { '@id': 'https://moskran-servis.ru/#organization' },
    priceSpecification: { '@type': 'UnitPriceSpecification', price: '20800', priceCurrency: 'RUB', unitText: 'SHIFT' },
  },
};
---
<BaseLayout title={title} description={description} path="/park/klintsy-ks-55713/" ldExtra={[breadcrumbLd, priceLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/park/">Парк техники</a><span>/</span><span>Клинцы КС-55713</span>
  </nav>
  <section class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Автокран · 25 тонн</span>
    <h1 style="margin:14px 0 20px">Клинцы КС-55713</h1>
    <ModelPrice value={priceValue} unit={priceUnit} note={priceNote} />
    <ParkCraneArt
      capacity="25 т"
      axles={3}
      boomAngle={52}
      boomLen={140}
      boomHalfWidth={8.5}
      gusek={{ label: 'гусёк 7,5 м · 0°/30°', kink: 20, len: 44 }}
      chassisLabel="Клинцы · шасси МАЗ-6303"
      boomDimLabel="стрела 21–24 м"
      noteNearBase="момент 80 тм"
    />
    <p>Автокран производства Клинцовского автокрановогo завода на шасси МАЗ — второй по распространённости после Ивановца класс техники этого тоннажа на российском рынке, с несколькими модификациями по длине стрелы под разные задачи.</p>

    <table class="ttx">
      <tbody>
        <tr><td>Грузоподъёмность</td><td>25 т</td></tr>
        <tr><td>Максимальный грузовой момент</td><td>80 тм</td></tr>
        <tr><td>Длина стрелы</td><td>телескопическая, 21–24 м (зависит от модификации), 10–24 м у трёхсекционных версий</td></tr>
        <tr><td>Решётчатый гусёк</td><td>7,5 м, устанавливается под углом 0° или 30°</td></tr>
        <tr><td>Шасси</td><td>МАЗ-6303 (у части модификаций)</td></tr>
        <tr><td>Назначение</td><td>погрузо-разгрузочные и строительно-монтажные работы на рассредоточенных площадках</td></tr>
      </tbody>
    </table>

    <h2 style="margin:32px 0 14px">Где применяется</h2>
    <p>По грузоподъёмности и грузовому моменту сопоставим с Ивановцем КС-45717 — выбор между моделями чаще определяется наличием техники на момент заявки и конкретной конфигурацией стрелы под задачу, а не принципиальной разницей в возможностях. Гусёк 7,5 м даёт дополнительную гибкость для задач с небольшим грузом на увеличенной высоте.</p>
    <p>Подробнее о логике подбора для этого класса грузоподъёмности — на странице услуги <a href="/uslugi/arenda-avtokrana-16-25-tonn/" style="color:var(--yellow)">«Автокраны 16–25 тонн»</a>.</p>
  </section>
  <section class="section wrap prose" style="padding-top:0;max-width:820px">
    <h2 style="margin-bottom:16px">Что проверяют у этой машины перед выездом</h2>
    <p>Модификаций у модели несколько, и длина стрелы у них разная — от коротких трёхсекционных до 24-метровых. Практический вывод: заявка «дайте Клинцы 25 тонн» ничего не определяет, пока не названа конфигурация. В паспорте конкретной машины смотрится и длина стрелы, и наличие решётчатого гуська 7,5 м, и угол его установки.</p>
    <p>Нормативная часть от конфигурации не зависит: частичное освидетельствование — не реже раза в 12 месяцев, полное — не реже раза в 3 года, с записью в паспорте и датой следующего. Испытания при полном освидетельствовании проводятся грузом 125 % от паспортной грузоподъёмности (статика) и 110 % (динамика).</p>
    <p>Отдельная строка — приказы эксплуатирующей организации. Их три, и это разные люди: ответственный за производственный контроль, ответственный за содержание машины в работоспособном состоянии и ответственный за безопасное производство работ. Последний подписывает решения на площадке, и именно его отсутствие превращает «кран приехал» в «кран стоит».</p>
    <h2 style="margin:34px 0 16px">Гусёк — не бесплатная прибавка</h2>
    <p>Решётчатый гусёк 7,5 м под углом 0° или 30° увеличивает досягаемость, но грузоподъёмность на гуське измеряется единицами тонн, а не десятками: это оснастка для лёгкого груза на высоте, а не способ поднять то же самое дальше. Конфигурация с гуськом отдельно оговаривается в заявке, потому что её установка занимает время на площадке.</p>
    <p style="margin-top:18px">В заявках на средний класс чаще всего не хватает данных о покрытии и уклоне площадки — <a href="/proverka-dokumentov/" style="color:var(--yellow)">чек-лист допуска</a> подсказывает, что прислать сразу, чтобы не переспрашивать. Написать нам — через <a href="/#zayavka" style="color:var(--yellow)">форму на главной</a>.</p>
    <Sources
      checked="12.08.2026"
      items={[
        { text: 'Приказ Ростехнадзора от 26.11.2020 №461 (ред. от 16.04.2026): п. 108 — площадка и уклон, п. 110 — выносные опоры, п. 111 — откос выемки, п. 138 — пуск в работу, п. 165 — периодичность освидетельствования, п. 171 и 179 — нагрузки при испытаниях, п. 189 — запись в паспорт', href: 'https://www.consultant.ru/document/cons_doc_LAW_373321/' },
      ]}
    />
  </section>
</main>
<style>
  .ttx { width: 100%; border-collapse: collapse; margin: 20px 0; font-size: var(--t-md); }
  .ttx td { padding: 10px 14px; border-bottom: 1px solid var(--line); }
  .ttx td:first-child { color: var(--muted); width: 45%; }
</style>
</BaseLayout>
