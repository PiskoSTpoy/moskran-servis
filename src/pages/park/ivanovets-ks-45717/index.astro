---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Sources from '../../../components/Sources.astro';
import ParkCraneArt from '../../../components/ParkCraneArt.astro';
import ModelPrice from '../../../components/ModelPrice.astro';

const title = 'Автокран Ивановец КС-45717 — технические характеристики';
const description = 'Ивановец КС-45717: грузоподъёмность 25 т, телескопическая стрела до 31 м, высота подъёма до 40,1 м. Технические характеристики и применение.';

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Парк техники', item: 'https://moskran-servis.ru/park/' },
    { '@type': 'ListItem', position: 3, name: 'Ивановец КС-45717', item: 'https://moskran-servis.ru/park/ivanovets-ks-45717/' },
  ],
};

// Волна 33 / цена. 25 т — тариф класса «25 т», уже опубликованный в калькуляторе на
// главной (rates[] в src/pages/index.astro: 2600 ₽/час) × 8 ч (минимальный заказ — одна
// смена, см. /uslugi/arenda-avtokrana-16-25-tonn/). Сверено с общим рынком через
// WebSearch (kran365.ru исключён из поиска): аренда автокрана 25 т в Москве —
// 1200–4500 ₽/час, 15 000–16 500 ₽/смена по данным glavarendakran.com, kranauto.ru,
// manipulyator-avtokran.ru, msp-moscow.ru, agrostroymech.ru, ragnarr.ru — наша ставка
// (20 800 ₽ = 2600×8) в этом диапазоне.
const priceValue = '20 800';
const priceUnit = 'смена';
const priceNote = 'Смена — 8 часов, минимальный заказ. Точный расчёт под вылет и надбавки — калькулятор на главной.';
const priceLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Ивановец КС-45717',
  category: 'Автокран',
  offers: {
    '@type': 'Offer',
    // Аренда, а НЕ продажа. Без явного businessFunction значение по умолчанию —
    // Sell, то есть разметка объявляла бы продажу крана за эту сумму. Техника
    // передаётся во временное пользование (с экипажем, ст. 632 ГК) — LeaseOut.
    businessFunction: 'http://purl.org/goodrelations/v1#LeaseOut',
    priceCurrency: 'RUB',
    price: '20800',
    areaServed: 'Москва',
    priceValidUntil: '2027-02-17',
    seller: { '@id': 'https://moskran-servis.ru/#organization' },
    priceSpecification: { '@type': 'UnitPriceSpecification', price: '20800', priceCurrency: 'RUB', unitText: 'SHIFT' },
  },
};
---
<BaseLayout title={title} description={description} path="/park/ivanovets-ks-45717/" ldExtra={[breadcrumbLd, priceLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/park/">Парк техники</a><span>/</span><span>Ивановец КС-45717</span>
  </nav>
  <section class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Автокран · 25 тонн</span>
    <h1 style="margin:14px 0 20px">Ивановец КС-45717</h1>
    <ModelPrice value={priceValue} unit={priceUnit} note={priceNote} />
    <figure class="model-photo">
      <picture>
        <source srcset="/images/park/ivanovets-ks-45717.webp" type="image/webp" />
        <img
          src="/images/park/ivanovets-ks-45717.jpg"
          width="1280"
          height="740"
          loading="lazy"
          decoding="async"
          alt="Автокран Ивановец 25Т (КС-45717) на шасси КАМАЗ — фото модели производителя, не конкретная машина из нашего парка"
        />
      </picture>
      <figcaption>Фото этой модели крана (не единица нашего парка — иллюстрация внешнего вида и конструкции; на стреле надпись «Ивановец 25т»). Ханты-Мансийск, май 2015. Автор: Alexey8601, лицензия <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener">CC BY-SA 4.0</a>, <a href="https://commons.wikimedia.org/wiki/File:2015.05.28_ks--45717_kamaz-53228.jpg" target="_blank" rel="noopener">Wikimedia Commons</a>.</figcaption>
    </figure>
    <ParkCraneArt
      capacity="25 т"
      axles={4}
      boomAngle={58}
      boomLen={150}
      gusek={{ label: 'гусёк 7 м', kink: 6, len: 40 }}
      chassisLabel="Ивановец · КАМАЗ, 4-осное шасси"
      boomDimLabel="стрела до 31 м"
      heightDimLabel="подъём до 40,1 м"
    />
    <p>Один из самых распространённых автокранов на дорогах Москвы и области — базовая рабочая лошадка городского строительства, производится Ивановским машиностроительным заводом «Автокран» на шасси КАМАЗ.</p>

    <table class="ttx">
      <tbody>
        <tr><td>Грузоподъёмность</td><td>25 т (на минимальном вылете)</td></tr>
        <tr><td>Длина стрелы</td><td>телескопическая, до 31 м (в зависимости от модификации)</td></tr>
        <tr><td>Высота подъёма крюка</td><td>до 40,1 м с полностью выдвинутой стрелой</td></tr>
        <tr><td>Удлинитель стрелы (гусёк)</td><td>7 м, увеличивает высоту подъёма до 28,2 м на гуське</td></tr>
        <tr><td>Привод</td><td>гидравлический, с совмещением рабочих операций</td></tr>
        <tr><td>Шасси</td><td>КАМАЗ (4-осное)</td></tr>
      </tbody>
    </table>

    <h2 style="margin:32px 0 14px">Где применяется</h2>
    <p>Стандартная задача для этого класса — разгрузка транспорта, монтаж лёгких и средних конструкций, подача материалов на этаж при отделочных работах. Манёвренность и распространённость модели (широкая сеть сервиса и запчастей по всей России) делают её одним из самых предсказуемых по срокам подачи вариантов для типовых городских задач.</p>
    <p>Подробный разбор задач и логики подбора грузоподъёмности для этого класса техники — на странице услуги <a href="/uslugi/arenda-avtokrana-16-25-tonn/" style="color:var(--yellow)">«Автокраны 16–25 тонн»</a>.</p>
  </section>
  <section class="section wrap prose" style="padding-top:0;max-width:820px">
    <h2 style="margin-bottom:16px">Что проверяют у этой машины перед выездом</h2>
    <p>Распространённость модели работает и в обратную сторону: именно такие машины чаще всего подают «с колёс», не показав документы. Проверяемых позиций три, и все они смотрятся в одном месте — в паспорте подъёмного сооружения. Результаты технического освидетельствования записываются туда с указанием срока следующего, поэтому одна страница отвечает сразу на вопрос, действует ли допуск.</p>
    <p>Периодичность задана нормой: частичное освидетельствование — не реже одного раза в 12 месяцев, полное — не реже одного раза в 3 года. Полное включает статические испытания грузом 125 % от паспортной грузоподъёмности и динамические — грузом на 10 % выше паспортной. Для 25-тонной машины это 31,25 т на статике: цифра, которую видно в протоколе, если он вообще есть.</p>
    <p>Второй документ — квалификация оператора с действующей проверкой знаний. Третий появляется на площадке: если стрела или груз оказываются ближе 30 м к крайнему проводу воздушной линии напряжением более 50 В, нужен наряд-допуск, и оформляется он не оператором в момент установки.</p>
    <h2 style="margin:34px 0 16px">Что в паспорте важнее названия модели</h2>
    <p>«25 тонн» — это максимум на минимальном вылете, у основания стрелы. На вылете 8–10 м, типичном для разгрузки во дворе, доступная грузоподъёмность заметно ниже, и смотреть надо строку грузовой характеристики на своём вылете, а не заголовок карточки. Четырёхосное шасси КАМАЗ означает разрешённую массу заведомо больше 3,5 т — значит, в границах МКАД машина едет по пропуску грузового каркаса и с регистрацией в РНИС.</p>
    <p style="margin-top:18px">Если выбираете между этой машиной и шестнадцатитонной, начинать стоит не с прайса: <a href="/proverka-dokumentov/" style="color:var(--yellow)">чек-лист допуска</a> показывает, какие условия объекта на самом деле определяют класс техники. Заявка — через <a href="/#zayavka" style="color:var(--yellow)">форму на главной</a>.</p>
    <Sources
      checked="12.08.2026"
      items={[
        { text: 'Приказ Ростехнадзора от 26.11.2020 №461 (ред. от 16.04.2026): п. 108 — площадка и уклон, п. 110 — выносные опоры, п. 111 — откос выемки, п. 138 — пуск в работу, п. 165 — периодичность освидетельствования, п. 171 и 179 — нагрузки при испытаниях, п. 189 — запись в паспорт', href: 'https://www.consultant.ru/document/cons_doc_LAW_373321/' },
        { text: 'Единый транспортный портал Москвы — пропуск для ТС с разрешённой массой свыше 3,5 т в границах МКАД и регистрация в РНИС', href: 'https://transport.mos.ru/gruzoviki/perevod_ckad' },
      ]}
    />
  </section>
</main>
<style>
  .ttx { width: 100%; border-collapse: collapse; margin: 20px 0; font-size: var(--t-md); }
  .ttx td { padding: 10px 14px; border-bottom: 1px solid var(--line); }
  .ttx td:first-child { color: var(--muted); width: 45%; }
  .model-photo { width: 100%; max-width: 640px; margin: 20px 0 6px; }
  .model-photo img { display: block; width: 100%; height: auto; border: 1px solid var(--line-strong); }
  .model-photo figcaption { margin-top: 10px; font-size: var(--t-xs); color: var(--muted); max-width: 70ch; }
  .model-photo figcaption a { color: var(--muted); text-decoration: underline; text-underline-offset: 2px; }
  .model-photo figcaption a:hover { color: var(--yellow); }
</style>
</BaseLayout>
