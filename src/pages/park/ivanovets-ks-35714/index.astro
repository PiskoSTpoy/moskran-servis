---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Sources from '../../../components/Sources.astro';
import ParkCraneArt from '../../../components/ParkCraneArt.astro';
import ModelPrice from '../../../components/ModelPrice.astro';

const title = 'Автокран Ивановец КС-35714 — технические характеристики';
const description = 'Ивановец КС-35714: грузоподъёмность 16 т, вездеходное шасси Урал 5557 (6×6), телескопическая стрела, гусёк 7 м. Технические характеристики.';

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Парк техники', item: 'https://moskran-servis.ru/park/' },
    { '@type': 'ListItem', position: 3, name: 'Ивановец КС-35714', item: 'https://moskran-servis.ru/park/ivanovets-ks-35714/' },
  ],
};

// Волна 33 / цена. 16 т — тариф класса «16–20 т», уже опубликованный в калькуляторе
// на главной (rates[] в src/pages/index.astro: 2200 ₽/час) × 8 ч (минимальный заказ —
// одна смена, см. /uslugi/arenda-avtokrana-16-25-tonn/). Число не новое — то же самое,
// что уже стоит на сайте для этого тоннажа, без внутреннего противоречия. Сверено с
// общим рынком через WebSearch (kran365.ru исключён из поиска и не открывался):
// аренда автокрана 16 т в Москве — 1300–2500 ₽/час, 11 000–15 000 ₽/смена по данным
// msp-moscow.ru, dcs-rent.ru, trans-alex.ru, yard-imperial.ru, mskran.ru — наша ставка
// (17 600 ₽ = 2200×8) укладывается в этот диапазон.
const priceValue = '17 600';
const priceUnit = 'смена';
const priceNote = 'Смена — 8 часов, минимальный заказ. Точный расчёт под вылет и надбавки — калькулятор на главной.';
const priceLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Ивановец КС-35714',
  category: 'Автокран',
  offers: {
    '@type': 'Offer',
    // Аренда, а НЕ продажа. Без явного businessFunction значение по умолчанию —
    // Sell, то есть разметка объявляла бы продажу крана за эту сумму. Техника
    // передаётся во временное пользование (с экипажем, ст. 632 ГК) — LeaseOut.
    businessFunction: 'http://purl.org/goodrelations/v1#LeaseOut',
    priceCurrency: 'RUB',
    price: '17600',
    areaServed: 'Москва',
    priceValidUntil: '2027-02-17',
    seller: { '@id': 'https://moskran-servis.ru/#organization' },
    priceSpecification: { '@type': 'UnitPriceSpecification', price: '17600', priceCurrency: 'RUB', unitText: 'SHIFT' },
  },
};
---
<BaseLayout title={title} description={description} path="/park/ivanovets-ks-35714/" ldExtra={[breadcrumbLd, priceLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/park/">Парк техники</a><span>/</span><span>Ивановец КС-35714</span>
  </nav>
  <section class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Автокран · 16 тонн</span>
    <h1 style="margin:14px 0 20px">Ивановец КС-35714</h1>
    <ModelPrice value={priceValue} unit={priceUnit} note={priceNote} />
    <figure class="model-photo">
      <picture>
        <source srcset="/images/park/ivanovets-ks-35714.webp" type="image/webp" />
        <img
          src="/images/park/ivanovets-ks-35714.jpg"
          width="1280"
          height="853"
          loading="lazy"
          decoding="async"
          alt="Автокран Ивановец КС-35714 на вездеходном шасси Урал 5557 на дороге — фото модели производителя, не конкретная машина из нашего парка"
        />
      </picture>
      <figcaption>Фото этой модели крана (не единица нашего парка — иллюстрация внешнего вида и конструкции; на снимке видна маркировка «КС-35714» на стреле). Фото 2013 года. Автор: Saveliy ufa, лицензия <a href="https://creativecommons.org/licenses/by-sa/3.0/" target="_blank" rel="noopener">CC BY-SA 3.0</a>, <a href="https://commons.wikimedia.org/wiki/File:%D0%9A%D0%A1-35714.jpg" target="_blank" rel="noopener">Wikimedia Commons</a>.</figcaption>
    </figure>
    <ParkCraneArt
      capacity="16 т"
      axles={3}
      wheelsLarge
      boomAngle={50}
      boomLen={110}
      boomHalfWidth={7}
      gusek={{ label: 'гусёк 7,0 м (опция)', kink: 14, len: 36 }}
      chassisLabel="Урал-5557 · 6×6, вездеходное"
      noteNearBase="стрела трёхсекционная"
    />
    <p>Базовый городской класс от Ивановского машиностроительного завода — манёвренная и при этом вездеходная машина на шасси Урал 5557 (6×6), рассчитанная на работу на объектах, рассредоточенных на значительном удалении друг от друга.</p>

    <table class="ttx">
      <tbody>
        <tr><td>Грузоподъёмность</td><td>16 т</td></tr>
        <tr><td>Шасси</td><td>Урал-5557, колёсная формула 6×6 (вездеходное)</td></tr>
        <tr><td>Стрела</td><td>телескопическая, трёхсекционная</td></tr>
        <tr><td>Гусёк (опция)</td><td>7,0 м — увеличивает длину стрелы и подстреловое пространство</td></tr>
        <tr><td>Привод</td><td>гидравлический, с совмещением рабочих операций</td></tr>
      </tbody>
    </table>

    <h2 style="margin:32px 0 14px">Где применяется</h2>
    <p>Проходимость вездеходного шасси Урал 6×6 позволяет уверенно работать по рыхлому снегу, грязи, песку и заболоченным участкам — это отличает модель от кранов на дорожных шасси того же тоннажа. Базовый класс для разгрузки транспорта, монтажа лёгких конструкций, подачи материалов на высоту в условиях обычной городской застройки, а также для объектов с ограниченным качеством подъездных путей.</p>
    <p>Подробнее о задачах и логике подбора для этого класса грузоподъёмности — на странице услуги <a href="/uslugi/arenda-avtokrana-16-25-tonn/" style="color:var(--yellow)">«Автокраны 16–25 тонн»</a>.</p>
  </section>
  <section class="section wrap prose" style="padding-top:0;max-width:820px">
    <h2 style="margin-bottom:16px">Что проверяют у этой машины перед выездом</h2>
    <p>Самый лёгкий класс в парке — и самый частый повод сэкономить на проверке. Формальных послаблений у него нет: 16-тонный автокран проходит то же техническое освидетельствование, что и 50-тонный. Частичное — не реже одного раза в 12 месяцев, полное — не реже одного раза в 3 года, с записью в паспорт и указанием срока следующего.</p>
    <p>Вездеходное шасси 6×6 меняет логистику, но не требования к площадке: запрет на установку на свеженасыпанный неутрамбованный грунт и на уклон сверх паспортного действует одинаково. Проходимость помогает добраться до точки, дальше начинается расчёт пятна под опоры.</p>
    <p>Оператор допускается к управлению по документу о квалификации с действующей проверкой знаний. Это тот же комплект, что у тяжёлых машин, и спрашивать его у лёгкой техники так же уместно.</p>
    <h2 style="margin:34px 0 16px">16 тонн — это про манёвренность, а не про запас</h2>
    <p>Разница между 16 и 25 тоннами проявляется не на минимальном вылете, где обе машины избыточны для типового поддона, а на среднем: с ростом вылета грузоподъёмность падает нелинейно, и запас у 25-тонника оказывается там, где у 16-тонного класса он уже исчерпан. Поэтому выбор делается по паре «вес груза плюс вылет», а не по одному числу в названии.</p>
    <p style="margin-top:18px">Самая лёгкая машина линейки чаще других едет в тесный двор, и требования к площадке у неё те же, что у тяжёлых. Пройтись по ним можно в <a href="/proverka-dokumentov/" style="color:var(--yellow)">чек-лист допуска</a>, а описать объект — через <a href="/#zayavka" style="color:var(--yellow)">форму на главной</a>.</p>
    <Sources
      checked="12.08.2026"
      items={[
        { text: 'Приказ Ростехнадзора от 26.11.2020 №461 (ред. от 16.04.2026): п. 108 — площадка и уклон, п. 110 — выносные опоры, п. 111 — откос выемки, п. 138 — пуск в работу, п. 165 — периодичность освидетельствования, п. 171 и 179 — нагрузки при испытаниях, п. 189 — запись в паспорт', href: 'https://www.consultant.ru/document/cons_doc_LAW_373321/' },
      ]}
    />
  </section>
</main>
<style>
  .ttx { width: 100%; border-collapse: collapse; margin: 20px 0; font-size: var(--t-md); }
  .ttx td { padding: 10px 14px; border-bottom: 1px solid var(--line); }
  .ttx td:first-child { color: var(--muted); width: 45%; }
  .model-photo { width: 100%; max-width: 640px; margin: 20px 0 6px; }
  .model-photo img { display: block; width: 100%; height: auto; border: 1px solid var(--line-strong); }
  .model-photo figcaption { margin-top: 10px; font-size: var(--t-xs); color: var(--muted); max-width: 70ch; }
  .model-photo figcaption a { color: var(--muted); text-decoration: underline; text-underline-offset: 2px; }
  .model-photo figcaption a:hover { color: var(--yellow); }
</style>
</BaseLayout>
