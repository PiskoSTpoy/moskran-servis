---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Sources from '../../../components/Sources.astro';
import ParkCraneArt from '../../../components/ParkCraneArt.astro';
import ModelPrice from '../../../components/ModelPrice.astro';

const title = 'Автокран Челябинец КС-55732-24 — технические характеристики';
const description = 'Челябинец КС-55732-24: автокран 25 т на шасси КАМАЗ или Урал-NEXT, стрела 24,5 м, 6-кратная запасовка каната. Технические характеристики.';

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Парк техники', item: 'https://moskran-servis.ru/park/' },
    { '@type': 'ListItem', position: 3, name: 'Челябинец КС-55732-24', item: 'https://moskran-servis.ru/park/chelyabinets-ks-55732/' },
  ],
};

// Волна 33 / цена. 25 т — тот же тариф класса «25 т», что и у остальных 25-тонных
// моделей парка (см. комментарий в park/ivanovets-ks-45717/index.astro): 2600 ₽/час
// (rates[] в src/pages/index.astro) × 8 ч = 20 800 ₽/смена. WebSearch общего рынка
// (kran365.ru не использовался): 1200–4500 ₽/час, 15 000–16 500 ₽/смена — glavarendakran.com,
// kranauto.ru, manipulyator-avtokran.ru, msp-moscow.ru, agrostroymech.ru, ragnarr.ru.
const priceValue = '20 800';
const priceUnit = 'смена';
const priceNote = 'Смена — 8 часов, минимальный заказ. Точный расчёт под вылет и надбавки — калькулятор на главной.';
const priceLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Челябинец КС-55732-24',
  category: 'Автокран',
  offers: {
    '@type': 'Offer',
    // Аренда, а НЕ продажа. Без явного businessFunction значение по умолчанию —
    // Sell, то есть разметка объявляла бы продажу крана за эту сумму. Техника
    // передаётся во временное пользование (с экипажем, ст. 632 ГК) — LeaseOut.
    businessFunction: 'http://purl.org/goodrelations/v1#LeaseOut',
    priceCurrency: 'RUB',
    price: '20800',
    areaServed: 'Москва',
    priceValidUntil: '2027-02-17',
    seller: { '@id': 'https://moskran-servis.ru/#organization' },
    priceSpecification: { '@type': 'UnitPriceSpecification', price: '20800', priceCurrency: 'RUB', unitText: 'SHIFT' },
  },
};
---
<BaseLayout title={title} description={description} path="/park/chelyabinets-ks-55732/" ldExtra={[breadcrumbLd, priceLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/park/">Парк техники</a><span>/</span><span>Челябинец КС-55732-24</span>
  </nav>
  <section class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Автокран · 25 тонн</span>
    <h1 style="margin:14px 0 20px">Челябинец КС-55732-24</h1>
    <ModelPrice value={priceValue} unit={priceUnit} note={priceNote} />
    <figure class="model-photo">
      <picture>
        <source srcset="/images/park/chelyabinets-ks-55732.webp" type="image/webp" />
        <img
          src="/images/park/chelyabinets-ks-55732.jpg"
          width="1280"
          height="679"
          loading="lazy"
          decoding="async"
          alt="Автокран Челябинец 25т (КС-55732) на шасси КАМАЗ, надпись «Челябинец» и «Челябинский механический завод» на кабине — фото модели производителя, не конкретная машина из нашего парка"
        />
      </picture>
      <figcaption>Фото этой модели крана (не единица нашего парка — иллюстрация внешнего вида и конструкции; на стреле надпись «Челябинец», на кабине — название завода-изготовителя). Фото 2014 года. Автор: Alexey8601, лицензия <a href="https://creativecommons.org/licenses/by-sa/4.0/" target="_blank" rel="noopener">CC BY-SA 4.0</a>, <a href="https://commons.wikimedia.org/wiki/File:2014.05.14_ks-55732(1).jpg" target="_blank" rel="noopener">Wikimedia Commons</a>.</figcaption>
    </figure>
    <ParkCraneArt
      capacity="25 т"
      axles={3}
      boomAngle={64}
      boomLen={160}
      ropeStrands={4}
      chassisLabel="КАМАЗ / Урал-NEXT"
      boomDimLabel="стрела 24,5 м"
      noteNearTip="11,1 т на 8 м"
      noteNearHook="запасовка 6-кратная"
    />
    <p>Ещё один отечественный производитель в линейке 25-тонного класса, наряду с Ивановцем и Клинцами — отличается доступностью шасси Урал-NEXT с колёсной формулой повышенной проходимости, что расширяет применимость на площадках без асфальтированного подъезда, где колёсная база КАМАЗ уже не так уверенно себя чувствует.</p>

    <table class="ttx">
      <tbody>
        <tr><td>Грузоподъёмность</td><td>25 т</td></tr>
        <tr><td>Длина стрелы</td><td>24,5 м</td></tr>
        <tr><td>Грузоподъёмность на вылете 8,0 м</td><td>11,1 т</td></tr>
        <tr><td>Груз на высоте подъёма до 25,2 м</td><td>6,5 т</td></tr>
        <tr><td>Шасси</td><td>КАМАЗ-43118 / КАМАЗ-65115 / Урал-NEXT</td></tr>
        <tr><td>Запасовка грузового каната</td><td>шестикратная</td></tr>
        <tr><td>Телескопирование стрелы</td><td>один гидроцилиндр + система полиспастов, синхронное выдвижение секций</td></tr>
      </tbody>
    </table>

    <h2 style="margin:32px 0 14px">Где применяется</h2>
    <p>Секции стрелы овоидного сечения из высокопрочной стали и синхронная схема телескопирования одним гидроцилиндром — конструктивная особенность этой модели по сравнению с другими 25-тонниками линейки, упрощающая обслуживание гидравлики стрелы. Версия на шасси Урал-NEXT — практичный выбор для объектов с грунтовым или частично разрушенным подъездом (частный сектор на границе округов, площадки на ранней стадии благоустройства), где колёсная база на базе КАМАЗ была бы менее уверенной без предварительной подготовки проезда.</p>
  </section>
  <section class="section wrap prose" style="padding-top:0;max-width:820px">
    <h2 style="margin-bottom:16px">Что проверяют у этой машины перед выездом</h2>
    <p>Шасси повышенной проходимости создаёт соблазн заехать туда, куда обычный автокран не заедет. Норма это ограничивает прямо: устанавливать машину для работы на свеженасыпанном неутрамбованном грунте и на площадке с уклоном больше указанного в паспорте нельзя. Проходимость решает вопрос «доехать», а не вопрос «встать под нагрузку».</p>
    <p>Второе ограничение того же порядка — режим опирания. Если руководство по эксплуатации не предусматривает иного, машина устанавливается на все выносные опоры. Работа на части опор — не способ вписаться в узкое место, а отдельно оговорённый в руководстве режим со своей, сниженной грузовой характеристикой.</p>
    <p>Нормативный минимум документов тот же, что у любого автокрана: паспорт с действующей записью об освидетельствовании (частичное — раз в 12 месяцев, полное — раз в 3 года), квалификация оператора и приказы о назначении ответственных.</p>
    <h2 style="margin:34px 0 16px">Когда проходимость действительно решает</h2>
    <p>Площадки на ранней стадии благоустройства, частный сектор на границе округов, объекты с разрушенным подъездом — там, где вопрос стоит именно о заезде, а не о работе. Под опоры в таких местах всё равно нужны инвентарные подкладки и проверка пятна: давление опоры на грунт у 25-тонной машины несопоставимо с давлением колеса.</p>
    <p style="margin-top:18px">Двадцать пять тонн в городе упираются обычно не в кран, а в подъезд и покрытие. Собрать эти вопросы в один список помогает <a href="/proverka-dokumentov/" style="color:var(--yellow)">чек-лист допуска</a>, а заявку на машину оставляйте через <a href="/#zayavka" style="color:var(--yellow)">форму на главной</a>.</p>
    <Sources
      checked="12.08.2026"
      items={[
        { text: 'Приказ Ростехнадзора от 26.11.2020 №461 (ред. от 16.04.2026): п. 108 — площадка и уклон, п. 110 — выносные опоры, п. 111 — откос выемки, п. 138 — пуск в работу, п. 165 — периодичность освидетельствования, п. 171 и 179 — нагрузки при испытаниях, п. 189 — запись в паспорт', href: 'https://www.consultant.ru/document/cons_doc_LAW_373321/' },
      ]}
    />
  </section>
</main>
<style>
  .ttx { width: 100%; border-collapse: collapse; margin: 20px 0; font-size: var(--t-md); }
  .ttx td { padding: 10px 14px; border-bottom: 1px solid var(--line); }
  .ttx td:first-child { color: var(--muted); width: 45%; }
  .model-photo { width: 100%; max-width: 640px; margin: 20px 0 6px; }
  .model-photo img { display: block; width: 100%; height: auto; border: 1px solid var(--line-strong); }
  .model-photo figcaption { margin-top: 10px; font-size: var(--t-xs); color: var(--muted); max-width: 70ch; }
  .model-photo figcaption a { color: var(--muted); text-decoration: underline; text-underline-offset: 2px; }
  .model-photo figcaption a:hover { color: var(--yellow); }
</style>
</BaseLayout>
