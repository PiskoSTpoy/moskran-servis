---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Sources from '../../../components/Sources.astro';
import ParkCraneArt from '../../../components/ParkCraneArt.astro';
import ModelPrice from '../../../components/ModelPrice.astro';

const title = 'Гусеничный кран SANY SCC550E — технические характеристики';
const description = 'SANY SCC550E: гусеничный кран 55 т, стрела 13-52 м, грузовой момент 203,5 тм, телескопическая гусеничная рама для узкого транспортного габарита.';

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Парк техники', item: 'https://moskran-servis.ru/park/' },
    { '@type': 'ListItem', position: 3, name: 'SANY SCC550E', item: 'https://moskran-servis.ru/park/sany-scc550e/' },
  ],
};

// Волна 33 / цена. 55 т — тот же общерыночный сегмент гусеничных кранов, что и у
// XCMG QUY50 (см. комментарий в park/xcmg-quy50/index.astro): WebSearch (kran365.ru
// не использовался) даёт гусеничные краны 50–60 т в Москве от ~50 000 ₽/смена
// (greenkran.ru, glavrent.ru, itirus.ru, groskran.ru, spectexalliance.ru). 55 т —
// собственный, немного более тяжёлый класс внутри этого сегмента: ставка сдвинута
// вверх от базовой 50 000 ₽ пропорционально тому же шагу, что и у автокранов между
// соседними тоннажами (не отдельная непроверенная цифра, а масштабирование внутри
// уже обоснованного диапазона).
const priceValue = '55 000';
const priceUnit = 'смена';
const priceNote = 'Смена гусеничного крана длиннее, чем у автокрана (уточняется при подаче заявки); доставка на трале и сборка на площадке — отдельная позиция срока и стоимости.';
const priceLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'SANY SCC550E',
  category: 'Гусеничный кран',
  offers: {
    '@type': 'Offer',
    // Аренда, а НЕ продажа. Без явного businessFunction значение по умолчанию —
    // Sell, то есть разметка объявляла бы продажу крана за эту сумму. Техника
    // передаётся во временное пользование (с экипажем, ст. 632 ГК) — LeaseOut.
    businessFunction: 'http://purl.org/goodrelations/v1#LeaseOut',
    priceCurrency: 'RUB',
    price: '55000',
    areaServed: 'Москва',
    priceValidUntil: '2027-02-17',
    seller: { '@id': 'https://moskran-servis.ru/#organization' },
    priceSpecification: { '@type': 'UnitPriceSpecification', price: '55000', priceCurrency: 'RUB', unitText: 'SHIFT' },
  },
};
---
<BaseLayout title={title} description={description} path="/park/sany-scc550e/" ldExtra={[breadcrumbLd, priceLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/park/">Парк техники</a><span>/</span><span>SANY SCC550E</span>
  </nav>
  <section class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Гусеничный кран · 55 тонн</span>
    <h1 style="margin:14px 0 20px">SANY SCC550E</h1>
    <ModelPrice value={priceValue} unit={priceUnit} note={priceNote} />
    <figure class="model-photo">
      <picture>
        <source srcset="/images/park/sany-scc550e.webp" type="image/webp" />
        <img
          src="/images/park/sany-scc550e.jpg"
          width="1280"
          height="960"
          loading="lazy"
          decoding="async"
          alt="Гусеничный кран SANY на трале с частично сложенной решётчатой стрелой на шоссе в Кастильехосе, Филиппины — фото модели производителя, не конкретная машина из нашего парка"
        />
      </picture>
      <figcaption>Фото этой модели крана (не единица нашего парка — иллюстрация внешнего вида и конструкции). Кастильехос, Замбалес, Филиппины, март 2019. Автор: Judgefloro, лицензия <a href="https://creativecommons.org/publicdomain/zero/1.0/deed.ru" target="_blank" rel="noopener">CC0 (общественное достояние)</a>, <a href="https://commons.wikimedia.org/wiki/File:9647Castillejos_National_Highway_30.jpg" target="_blank" rel="noopener">Wikimedia Commons</a>.</figcaption>
    </figure>
    <ParkCraneArt
      capacity="55 т"
      kind="crawler"
      boomAngle={72}
      boomLen={155}
      chassisLabel="гусеничный ход · рама сужается для трала"
      boomDimLabel="стрела 13–52 м"
      noteNearBase="момент до 203,5 тм"
    />
    <p>Второй гусеничный кран в парке наряду с XCMG QUY50 — отличается телескопической гусеничной рамой, которая сужается для транспортировки, упрощая логистику доставки на трале по сравнению с кранами с несъёмной шириной хода.</p>

    <table class="ttx">
      <tbody>
        <tr><td>Грузоподъёмность</td><td>55 т</td></tr>
        <tr><td>Длина стрелы</td><td>13–52 м</td></tr>
        <tr><td>Максимальный грузовой момент</td><td>203,5 тм</td></tr>
        <tr><td>Скорость грузовой/вспомогательной лебёдки</td><td>120 м/мин</td></tr>
        <tr><td>Гусеничная рама</td><td>телескопическая, сужается для транспортного положения</td></tr>
      </tbody>
    </table>

    <h2 style="margin:32px 0 14px">Где применяется</h2>
    <p>Производитель заявляет эту модель для задач судостроения, метростроя, металлургии и инфраструктурных объектов — то есть для площадок, где сочетаются высокая грузоподъёмность и необходимость манёвренности на стеснённой территории. Телескопическая рама хода, сужающаяся для транспортировки, — практичное преимущество для городских объектов Москвы, где узкие подъездные пути ограничивают доставку кранов с фиксированной шириной гусеничного хода. Как и для любого гусеничного крана, доставка на объект — только на трале, согласование маршрута перевозки закладываем в сроки заранее.</p>
  </section>
  <section class="section wrap prose" style="padding-top:0;max-width:820px">
    <h2 style="margin-bottom:16px">Что проверяют у этого крана перед выездом</h2>
    <p>Телескопическая гусеничная рама снимает часть транспортной проблемы — в сведённом положении кран уже гораздо ближе к обычному габариту, — но не отменяет доставку на трале и согласование перевозки. Это по-прежнему отдельная позиция графика, а не приложение к заявке на кран.</p>
    <p>На площадке действует общий запрет: не устанавливать подъёмное сооружение для работы на свеженасыпанном неутрамбованном грунте и на уклоне больше паспортного. Для 55-тонной машины с грузовым моментом свыше 200 тм это не формальность — при повороте стрелы нагрузка перераспределяется на одну сторону хода.</p>
    <p>Документы — стандартный набор: паспорт с действующей записью об освидетельствовании, квалификация оператора, приказы эксплуатирующей организации. Периодичность освидетельствования от типа ходовой части не зависит: 12 месяцев на частичное, 3 года на полное.</p>
    <h2 style="margin:34px 0 16px">Сужающаяся рама и городская логистика</h2>
    <p>Для Москвы это практическое преимущество: узкий внутриквартальный проезд, ворота промплощадки, поворот между корпусами — те места, где кран с фиксированной шириной хода просто не проходит. Ширину в рабочем и транспортном положении сверяем со схемой заезда до подтверждения даты, а не по факту приезда трала.</p>
<h2 style="margin:34px 0 16px">Что определяет срок выезда этой машины</h2>
    <p>Не занятость крана, а перевозка. Гусеничная машина не имеет права выехать на дороги общего пользования, значит нужен трал, маршрут и согласование перевозки — три позиции, каждая со своим сроком на чужой стороне. Телескопическая рама сокращает габарит в транспортном положении и снимает часть вопросов по ширине, но саму перевозку она не отменяет.</p>
    <p>Второе, что двигает дату, — сборка на площадке. Стрела гусеничного крана приезжает секциями и собирается на месте, для чего нужна ровная полоса длиной под собираемую конфигурацию. На стеснённом городском объекте эту полосу приходится искать отдельно, и иногда она оказывается дефицитнее, чем само пятно под работу.</p>

    <p style="margin-top:18px">Гусеничная машина не приезжает своим ходом — доставка тралом становится отдельной позицией срока. Что уточнить заранее, собрано в <a href="/proverka-dokumentov/" style="color:var(--yellow)">чек-лист допуска</a>; описать задачу можно через <a href="/#zayavka" style="color:var(--yellow)">форму на главной</a>.</p>
    <Sources
      checked="12.08.2026"
      items={[
        { text: 'Приказ Ростехнадзора от 26.11.2020 №461 (ред. от 16.04.2026): п. 108 — площадка и уклон, п. 110 — выносные опоры, п. 111 — откос выемки, п. 138 — пуск в работу, п. 165 — периодичность освидетельствования, п. 171 и 179 — нагрузки при испытаниях, п. 189 — запись в паспорт', href: 'https://www.consultant.ru/document/cons_doc_LAW_373321/' },
      ]}
    />
  </section>
</main>
<style>
  .ttx { width: 100%; border-collapse: collapse; margin: 20px 0; font-size: var(--t-md); }
  .ttx td { padding: 10px 14px; border-bottom: 1px solid var(--line); }
  .ttx td:first-child { color: var(--muted); width: 45%; }
  .model-photo { width: 100%; max-width: 640px; margin: 20px 0 6px; }
  .model-photo img { display: block; width: 100%; height: auto; border: 1px solid var(--line-strong); }
  .model-photo figcaption { margin-top: 10px; font-size: var(--t-xs); color: var(--muted); max-width: 70ch; }
  .model-photo figcaption a { color: var(--muted); text-decoration: underline; text-underline-offset: 2px; }
  .model-photo figcaption a:hover { color: var(--yellow); }
</style>
</BaseLayout>
