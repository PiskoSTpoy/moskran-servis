---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Sources from '../../../components/Sources.astro';
import ModelPrice from '../../../components/ModelPrice.astro';

const title = 'Автокран Zoomlion QY50V — технические характеристики';
const description = 'Zoomlion QY50V: грузоподъёмность 50 т, стрела 42 м + гусёк 16,2 м, высота подъёма 53 м. Технические характеристики китайского автокрана.';

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Парк техники', item: 'https://moskran-servis.ru/park/' },
    { '@type': 'ListItem', position: 3, name: 'Zoomlion QY50V', item: 'https://moskran-servis.ru/park/zoomlion-qy50v/' },
  ],
};

// Волна 33 / цена. 50 т — тот же тариф класса «50 т», что и у остальных 50-тонных
// автокранов парка (см. комментарий в park/galichanin-ks-65713-1/index.astro): 3900 ₽/час
// (rates[] в src/pages/index.astro) × 8 ч = 31 200 ₽/смена. WebSearch общего рынка
// (kran365.ru не использовался): 2750–5000 ₽/час, посменные от 36 000 ₽ — msp-moscow.ru,
// umiat-termo.ru, trans-alex.ru, mosvektor.ru, kran4rent.ru.
const priceValue = '31 200';
const priceUnit = 'смена';
const priceNote = 'Смена — 8 часов, минимальный заказ. Точный расчёт под вылет и надбавки — калькулятор на главной.';
const priceLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'Zoomlion QY50V',
  category: 'Автокран',
  offers: {
    '@type': 'Offer',
    // Аренда, а НЕ продажа. Без явного businessFunction значение по умолчанию —
    // Sell, то есть разметка объявляла бы продажу крана за эту сумму. Техника
    // передаётся во временное пользование (с экипажем, ст. 632 ГК) — LeaseOut.
    businessFunction: 'http://purl.org/goodrelations/v1#LeaseOut',
    priceCurrency: 'RUB',
    price: '31200',
    areaServed: 'Москва',
    priceValidUntil: '2027-02-17',
    seller: { '@id': 'https://moskran-servis.ru/#organization' },
    priceSpecification: { '@type': 'UnitPriceSpecification', price: '31200', priceCurrency: 'RUB', unitText: 'SHIFT' },
  },
};
---
<BaseLayout title={title} description={description} path="/park/zoomlion-qy50v/" ldExtra={[breadcrumbLd, priceLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/park/">Парк техники</a><span>/</span><span>Zoomlion QY50V</span>
  </nav>
  <section class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Автокран · 50 тонн</span>
    <h1 style="margin:14px 0 20px">Zoomlion QY50V</h1>
    <ModelPrice value={priceValue} unit={priceUnit} note={priceNote} />
    <figure class="model-art model-art--mobile">
      <svg viewBox="0 0 440 260" role="img" focusable="false" aria-label="Чертёж автокрана Zoomlion QY50V со стрелой шестигранного сечения: грузоподъёмность 50 т, стрела 42 м, гусёк 16,2 м, общая длина со стрелой до 58 м, высота подъёма крюка 53 м, снаряжённая масса 40,4 т">
        <defs>
          <pattern id="zl-dots" width="16" height="16" patternUnits="userSpaceOnUse">
            <circle cx="1.3" cy="1.3" r="1.2" fill="var(--line-strong)" />
          </pattern>
          <marker id="zl-tick" markerWidth="10" markerHeight="10" refX="5" refY="5" orient="auto">
            <path d="M5 0 V10" stroke="var(--yellow)" stroke-width="1.4" />
          </marker>
        </defs>
        <rect x="6" y="6" width="428" height="248" fill="url(#zl-dots)" opacity="0.3" />
        <rect x="6" y="6" width="428" height="248" fill="none" stroke="var(--line-strong)" stroke-width="1.4" stroke-dasharray="2 7" />
        <g stroke="var(--yellow)" stroke-width="2.5" stroke-linecap="square" fill="none">
          <path d="M6 26 V6 H26" />
          <path d="M414 6 H434 V26" />
          <path d="M434 234 V254 H414" />
          <path d="M26 254 H6 V234" />
        </g>

        <line x1="14" y1="225" x2="426" y2="225" stroke="var(--muted)" stroke-width="1.6" />

        <path d="M18 225 V190 L44 190 L58 208 V225 Z" fill="none" stroke="var(--ink)" stroke-width="1.6" />
        <rect x="23" y="196" width="17" height="13" fill="none" stroke="var(--ink)" stroke-width="1.2" />
        <rect x="35" y="172" width="215" height="40" fill="none" stroke="var(--ink)" stroke-width="1.8" />
        <circle cx="50" cy="225" r="13" fill="var(--bg-2)" stroke="var(--ink)" stroke-width="1.6" />
        <circle cx="90" cy="225" r="13" fill="var(--bg-2)" stroke="var(--ink)" stroke-width="1.6" />
        <circle cx="130" cy="225" r="13" fill="var(--bg-2)" stroke="var(--ink)" stroke-width="1.6" />
        <circle cx="170" cy="225" r="13" fill="var(--bg-2)" stroke="var(--ink)" stroke-width="1.6" />
        <circle cx="225" cy="225" r="13" fill="var(--bg-2)" stroke="var(--ink)" stroke-width="1.6" />

        <rect x="160" y="148" width="20" height="24" fill="var(--muted)" />
        <rect x="175" y="142" width="58" height="32" fill="none" stroke="var(--ink)" stroke-width="1.8" />
        <line x1="205" y1="150" x2="375" y2="68" stroke="var(--ink)" stroke-width="3.4" />
        <polygon points="254,128 250.5,134.06 243.5,134.06 240,128 243.5,121.94 250.5,121.94" fill="none" stroke="var(--ink)" stroke-width="1.2" />
        <text x="247" y="145" font-family="var(--sans)" font-size="7" fill="var(--muted)" text-anchor="middle">6-гранная стрела</text>
        <line x1="375" y1="68" x2="418" y2="32" stroke="var(--muted)" stroke-width="2.2" />
        <line x1="418" y1="32" x2="405" y2="75" stroke="var(--muted)" stroke-width="1.2" stroke-dasharray="1 3" />
        <path d="M401 75 h8 l-3 7 h-2 z" fill="none" stroke="var(--ink)" stroke-width="1.4" />

        <text x="204" y="138" font-family="var(--sans)" font-size="9" fill="var(--ink)" text-anchor="middle" font-weight="700">50 т</text>
        <text x="290" y="93" font-family="var(--sans)" font-size="9" fill="var(--ink)" text-anchor="middle" font-weight="700">42 м</text>
        <text x="358" y="42" font-family="var(--sans)" font-size="8" fill="var(--muted)" text-anchor="start">гусёк 16,2 м</text>
        <text x="428" y="16" font-family="var(--sans)" font-size="7.5" fill="var(--muted)" text-anchor="end">до 58 м со стрелой и гуськом</text>
        <rect x="15" y="144" width="52" height="16" fill="var(--bg)" stroke="var(--yellow)" stroke-width="1.2" />
        <text x="41" y="155" font-family="var(--sans)" font-size="7.5" fill="var(--yellow)" text-anchor="middle" font-weight="700">масса 40,4 т</text>

        <line x1="418" y1="32" x2="410" y2="32" stroke="var(--line-strong)" stroke-width="1.2" />
        <line x1="410" y1="32" x2="410" y2="225" stroke="var(--yellow)" stroke-width="1.4" marker-start="url(#zl-tick)" marker-end="url(#zl-tick)" />
        <text x="416" y="128" font-family="var(--sans)" font-size="10" font-weight="700" fill="var(--yellow)" text-anchor="middle" transform="rotate(90 416 128)">53 м</text>
      </svg>
      <figcaption>Схема силуэта — не масштабный чертёж, цифры на выносках соответствуют таблице характеристик ниже.</figcaption>
    </figure>
    <p>Тяжёлый китайский автокран с телескопической стрелой шестигранного сечения — конструкция обеспечивает высокую прочность на изгиб при относительно небольшой собственной массе стрелы по сравнению с классическими профилями.</p>

    <table class="ttx">
      <tbody>
        <tr><td>Грузоподъёмность</td><td>50 т</td></tr>
        <tr><td>Длина стрелы</td><td>42 м (42,1 м)</td></tr>
        <tr><td>Гусёк</td><td>16,2 м — общая длина со стрелой до 58 м</td></tr>
        <tr><td>Максимальная высота подъёма крюка</td><td>53 м</td></tr>
        <tr><td>Мощность двигателя</td><td>318 л.с.</td></tr>
        <tr><td>Снаряжённая масса</td><td>40,4 т</td></tr>
      </tbody>
    </table>

    <h2 style="margin:32px 0 14px">Где применяется</h2>
    <p>По грузоподъёмности сопоставим с Галичанином КС-65713-1 и Liebherr LTM 1050-3.1, но с промежуточными по сравнению с ними параметрами стрелы — длиннее, чем у отечественного аналога, но короче, чем у премиального немецкого крана того же класса. С гуськом 16,2 м общая досягаемость достигает 58 м — подходит для тяжёлых монтажей с большим вылетом или на значительной высоте.</p>
    <p>Подробнее о задачах для этого класса грузоподъёмности — на странице услуги <a href="/uslugi/arenda-avtokrana-40-50-tonn/" style="color:var(--yellow)">«Автокраны 40–50 тонн»</a>.</p>
  </section>
  <section class="section wrap prose" style="padding-top:0;max-width:820px">
    <h2 style="margin-bottom:16px">Что проверяют у этой машины перед выездом</h2>
    <p>Снаряжённая масса 40,4 т — цифра, из которой следует практически всё транспортное: пропуск грузового каркаса в границах МКАД, регистрация в РНИС, маршрут в обход мостов с ограничением по массе. Эти позиции проверяются до согласования даты, а не в день выезда.</p>
    <p>Крановая часть: частичное освидетельствование — не реже одного раза в 12 месяцев, полное — не реже одного раза в 3 года, результат записывается в паспорт с указанием срока следующего. Динамические испытания при полном освидетельствовании проводятся грузом, масса которого на 10 % превышает паспортную грузоподъёмность.</p>
    <p>Установка на все выносные опоры и подготовленная площадка без свеженасыпанного грунта и сверхпаспортного уклона — требование, которое для машины такой массы определяет не удобство, а саму возможность работы.</p>
    <h2 style="margin:34px 0 16px">Гусёк 16,2 м и что он меняет</h2>
    <p>Общая досягаемость со стрелой доходит до 58 м, но грузоподъёмность на гуське несопоставима с работой на основной стреле: это оснастка для лёгких грузов на большой высоте. Конфигурацию с гуськом оговариваем в заявке отдельно — её сборка занимает время на площадке и требует места, которого в плотной застройке может просто не быть.</p>
    <p style="margin-top:18px">В парке не одна машина этого класса, и выбор между ними решает не марка, а то, что помещается на вашем проезде. Разобраться помогает <a href="/proverka-dokumentov/" style="color:var(--yellow)">чек-лист допуска</a>, а описать площадку — через <a href="/#zayavka" style="color:var(--yellow)">форму на главной</a>.</p>
    <Sources
      checked="12.08.2026"
      items={[
        { text: 'Приказ Ростехнадзора от 26.11.2020 №461 (ред. от 16.04.2026): п. 108 — площадка и уклон, п. 110 — выносные опоры, п. 111 — откос выемки, п. 138 — пуск в работу, п. 165 — периодичность освидетельствования, п. 171 и 179 — нагрузки при испытаниях, п. 189 — запись в паспорт', href: 'https://www.consultant.ru/document/cons_doc_LAW_373321/' },
        { text: 'Единый транспортный портал Москвы — пропуск для ТС с разрешённой массой свыше 3,5 т в границах МКАД и регистрация в РНИС', href: 'https://transport.mos.ru/gruzoviki/perevod_ckad' },
      ]}
    />
  </section>
</main>
<style>
  .ttx { width: 100%; border-collapse: collapse; margin: 20px 0; font-size: var(--t-md); }
  .ttx td { padding: 10px 14px; border-bottom: 1px solid var(--line); }
  .ttx td:first-child { color: var(--muted); width: 45%; }
  .model-art { width: min(100%, 480px); margin: 20px 0 6px; }
  .model-art svg { display: block; width: 100%; height: auto; }
  .model-art figcaption { margin-top: 10px; font-size: var(--t-sm); color: var(--muted); max-width: 60ch; }
</style>
</BaseLayout>
