---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Sources from '../../../components/Sources.astro';
import ZoneTable from '../../../components/ZoneTable.astro';

const title = 'Подача крана на площадку без асфальтированного подъезда';
const description = 'Типовой сценарий: объект на территории без твёрдого дорожного покрытия — выбор автокрана на шасси повышенной проходимости.';

// Волна 39: карточка параметров сценария. Ни одного нового факта — класс
// техники, условие площадки и нормативные реквизиты уже названы на этой же
// странице (подзаголовок над H1, разделы ниже и блок «Источники»). Таблица
// собирает их в одном месте с подписями столбцов: и человеку, и языковой
// модели, которая цитирует страницу в ответе, не приходится вытаскивать эти
// значения из середины абзацев (критерий рубрикатора geo-table-present).
const caseRows = [
  ['Техника в сценарии', 'Автокран 25 т на шасси повышенной проходимости'],
  ['Что делает задачу нетиповой', 'К площадке нет асфальтированного подъезда'],
  ['Что определяет исход', 'Проходимость по дороге и несущая способность под опорой — разные вещи, и решаются они разным'],
  ['Норма, по которой это считается', 'ФНП №461 (ред. от 16.04.2026): п. 108 — площадка и уклон, п. 110 — выносные опоры, п. 111 — откос выемки, п. 112 — 30 м до провода'],
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Примеры задач', item: 'https://moskran-servis.ru/keysy/' },
    { '@type': 'ListItem', position: 3, name: 'Подача крана по грунтовой дороге', item: 'https://moskran-servis.ru/keysy/podyezd-po-gruntovoy-doroge-vnedorozhnik/' },
  ],
};
---
<BaseLayout title={title} description={description} path="/keysy/podyezd-po-gruntovoy-doroge-vnedorozhnik/" ldExtra={[breadcrumbLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/keysy/">Примеры задач</a><span>/</span><span>Подача крана по грунтовой дороге</span>
  </nav>
  <section class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Пример задачи · автокран 25 т на шасси повышенной проходимости</span>
    <h1 style="margin:14px 0 8px">Подача крана на площадку без асфальтированного подъезда</h1>
    <p style="margin-bottom:16px">Шасси повышенной проходимости решает задачу «доехать» и не решает задачу «встать под нагрузку»: давление одной выносной опоры 25-тонной машины несопоставимо с давлением колеса, а пункт 108 ФНП №461 запрещает ставить кран под нагрузку на свеженасыпанном неутрамбованном грунте и на площадке с уклоном больше паспортного. Поэтому по грунтовому подъезду мы задаём два разных вопроса — про маршрут и про пятно под опорами, — а ответ «дорога плохая, но кран проходимый» закрывает только первый.</p>
    <p style="color:var(--muted);font-size:var(--t-md);margin-bottom:24px">Иллюстративный сценарий — не описание конкретного выполненного объекта.</p>

    <h2 style="margin-bottom:14px">Задача</h2>
    <p>Разгрузка и монтаж лёгкого инженерного оборудования на объекте, где подъезд к точке установки представляет собой грунтовую дорогу без твёрдого покрытия — например, территория на ранней стадии благоустройства новой жилой застройки или частный сектор на границе округа.</p>

    <ZoneTable
      caption="Параметры сценария"
      columns={['Параметр', 'Значение в этом сценарии']}
      rows={caseRows}
    />

    <h2 style="margin:32px 0 14px">Почему стандартное шасси не всегда подходит</h2>
    <p>Автокран на шасси КАМАЗ с колёсной формулой, рассчитанной прежде всего на дороги с твёрдым покрытием, может застрять или потерять устойчивость на размокшем грунте, особенно после дождя — риск, который лучше исключить заранее, чем разбираться с ним по факту прибытия техники на объект. Для таких площадок в парке есть модели на шасси повышенной проходимости (например, Урал-NEXT), рассчитанные на движение по грунтовым и не полностью подготовленным дорогам.</p>

    <h2 style="margin:32px 0 14px">Что уточняем на этапе заявки</h2>
    <ul>
      <li>Тип покрытия подъездного пути — по фото или видео, а не по устному описанию «дорога плохая/нормальная».</li>
      <li>Погодные условия за последние дни: недавние осадки резко меняют проходимость грунтовой дороги.</li>
      <li>Наличие точки для разворота техники такого класса — узкая грунтовая дорога может не позволить развернуться, даже если сам проезд возможен.</li>
    </ul>

    <h2 style="margin:32px 0 14px">Итог</h2>
    <p>Для объектов без твёрдого подъезда выбор шасси техники — не менее важный параметр расчёта, чем грузоподъёмность самого крана: правильно подобранная база позволяет избежать срыва заявки из-за банальной невозможности проезда, а не из-за нехватки грузоподъёмности.</p>
  </section>
  <section class="section wrap prose" style="padding-top:0;max-width:820px">
    <h2 style="margin-bottom:16px">Проходимость и несущая способность — разные вещи</h2>
    <p>Шасси повышенной проходимости решает задачу «доехать». Задачу «встать под нагрузку» оно не решает: норма прямо запрещает устанавливать подъёмное сооружение для работы на свеженасыпанном неутрамбованном грунте и на площадке с уклоном больше паспортного. Грунтовая дорога после дождя — ровно тот случай, когда машина доедет, а работать с этой точки будет нельзя.</p>
    <p>Практическое следствие — два разных вопроса в заявке. Первый про маршрут: тип покрытия, ширина, наличие места для разворота. Второй про пятно: что под опорами, какой уклон, есть ли отсыпка. Ответ «дорога плохая, но кран проходимый» закрывает только первый.</p>
    <p>Под опоры на таком объекте обязательны инвентарные подкладки, а установка ведётся на все выносные опоры, если руководство по эксплуатации не предусматривает иного. Давление одной опоры 25-тонной машины несопоставимо с давлением колеса, и именно поэтому проходимость не переносится с движения на работу.</p>
    <p style="margin-top:18px">Проверить, какие из этих позиций уже закрыты по вашему объекту, можно в <a href="/proverka-dokumentov/" style="color:var(--yellow)">чек-листе допуска</a>; сами нормы разобраны в <a href="/spravochnik/" style="color:var(--yellow)">справочнике</a>.</p>
    <Sources
      checked="12.08.2026"
      items={[
        { text: 'Приказ Ростехнадзора от 26.11.2020 №461 (ред. от 16.04.2026): п. 108 — площадка и уклон, п. 110 — выносные опоры, п. 111 — откос выемки, п. 112 — 30 м до провода и наряд-допуск, п. 138 — пуск в работу, п. 165 — периодичность освидетельствования, п. 189 — запись в паспорт', href: 'https://www.consultant.ru/document/cons_doc_LAW_373321/' },
      ]}
    />
  </section>
</main>
</BaseLayout>
