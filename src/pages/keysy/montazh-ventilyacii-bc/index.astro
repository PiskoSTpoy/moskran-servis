---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Sources from '../../../components/Sources.astro';
import ZoneTable from '../../../components/ZoneTable.astro';

const title = 'Монтаж вентиляционной установки на кровлю бизнес-центра';
const description = 'Типовой сценарий: подъём вентиляционной установки на кровлю режимного бизнес-центра — расчёт вылета, пропуск, логика подбора крана.';

// Волна 39: карточка параметров сценария. Ни одного нового факта — класс
// техники, условие площадки и нормативные реквизиты уже названы на этой же
// странице (подзаголовок над H1, разделы ниже и блок «Источники»). Таблица
// собирает их в одном месте с подписями столбцов: и человеку, и языковой
// модели, которая цитирует страницу в ответе, не приходится вытаскивать эти
// значения из середины абзацев (критерий рубрикатора geo-table-present).
const caseRows = [
  ['Техника в сценарии', 'Автокран 32 т'],
  ['Что делает задачу нетиповой', 'Кровля действующего бизнес-центра с пропускным режимом'],
  ['Что определяет исход', 'Процедурный слой: что должно быть проверено до назначения даты, а не в день выезда'],
  ['Норма, по которой это считается', 'ФНП №461 (ред. от 16.04.2026): п. 108 — площадка и уклон, п. 110 — выносные опоры, п. 111 — откос выемки, п. 112 — 30 м до провода; Закон г. Москвы от 12.07.2002 №42 и ст. 3.13 КоАП города Москвы — запрет шумных работ с 23:00 до 07:00'],
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Примеры задач', item: 'https://moskran-servis.ru/keysy/' },
    { '@type': 'ListItem', position: 3, name: 'Монтаж вентиляции', item: 'https://moskran-servis.ru/keysy/montazh-ventilyacii-bc/' },
  ],
};
---
<BaseLayout title={title} description={description} path="/keysy/montazh-ventilyacii-bc/" ldExtra={[breadcrumbLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/keysy/">Примеры задач</a><span>/</span><span>Монтаж вентиляции</span>
  </nav>
  <section class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Пример задачи · автокран 32 т · режимный объект</span>
    <h1 style="margin:14px 0 8px">Монтаж вентиляционного оборудования на кровлю бизнес-центра</h1>
    <p style="color:var(--muted);font-size:var(--t-md);margin-bottom:24px">Иллюстративный сценарий — не описание конкретного выполненного объекта.</p>

    <h2 style="margin-bottom:14px">Задача</h2>
    <p>Подъём крупной вентиляционной установки весом около 7 тонн на кровлю действующего бизнес-центра высотой 12 этажей. Объект — территория с контрольно-пропускным режимом: единый КПП, требование на аккредитацию техники и бригады заранее.</p>

    <ZoneTable
      caption="Параметры сценария"
      columns={['Параметр', 'Значение в этом сценарии']}
      rows={caseRows}
    />

    <h2 style="margin:32px 0 14px">Расчёт техники</h2>
    <p>Кран не может встать вплотную к зданию — периметр занят подъездными путями и парковкой, реальный вылет от возможной точки установки до места монтажа на кровле — порядка 16–18 метров при высоте подъёма 40+ метров. На таком сочетании веса, вылета и высоты 25-тонного класса уже недостаточно — выбран 32-тонный автокран с соответствующей грузовысотной характеристикой.</p>

    <h2 style="margin:32px 0 14px">Особенности, которые важны на практике</h2>
    <ul>
      <li>Оформление пропуска — заявка на аккредитацию техники и бригады подаётся за несколько дней до выезда, с указанием госномера крана и данных оператора, как описано на странице услуги «Кран на режимный объект».</li>
      <li>Согласование времени работ с управляющей компанией здания — монтаж на кровле действующего бизнес-центра планируется так, чтобы не создавать помех работе арендаторов в рабочие часы, часто это раннее утро или выходной день.</li>
      <li>Точка установки крана согласовывается заранее по схеме территории — не любое место у здания годится из-за подземных коммуникаций и разметки парковки.</li>
    </ul>

    <h2 style="margin:32px 0 14px">Итог</h2>
    <p>Определяющий фактор для класса техники здесь — не столько вес груза (7 тонн — не экстремально много), сколько вынужденный вылет из-за невозможности подъехать вплотную к зданию. Плюс отдельный процедурный слой — оформление пропуска, которое влияет на срок подготовки заявки больше, чем сам расчёт техники.</p>
  </section>
  <section class="section wrap prose" style="padding-top:0;max-width:820px">
    <h2 style="margin-bottom:16px">Процедурный слой: что проверяется до даты</h2>
    <p>Пропуск — не единственная процедура. На кровле действующего бизнес-центра к нему добавляется согласование окна работ, а если кран частично встаёт на городскую территорию — ордер на установку временных ограждений. Каждая из этих позиций живёт на чужой стороне и имеет собственный срок, который складывается не с нашим, а идёт параллельно.</p>
    <p>Отдельно проверяется соседство с проводами. Если стрела или груз при повороте оказываются ближе 30 м к крайнему проводу воздушной линии или воздушной электрической сети напряжением более 50 В, работа ведётся только по наряду-допуску. В плотной городской застройке под это определение попадает и контактная сеть городского транспорта.</p>
    <p>Ограничение по времени — московское: шумные строительные и погрузочно-разгрузочные работы в жилой застройке ограничены с 23:00 до 07:00. Для бизнес-центра, окружённого жилыми домами, «сделаем ночью, чтобы не мешать арендаторам» превращается в решение, которое надо проверять до того, как оно попало в график.</p>
    <p style="margin-top:18px">Проверить, какие из этих позиций уже закрыты по вашему объекту, можно в <a href="/proverka-dokumentov/" style="color:var(--yellow)">чек-листе допуска</a>; сами нормы разобраны в <a href="/spravochnik/" style="color:var(--yellow)">справочнике</a>.</p>
    <Sources
      checked="12.08.2026"
      items={[
        { text: 'Приказ Ростехнадзора от 26.11.2020 №461 (ред. от 16.04.2026): п. 108 — площадка и уклон, п. 110 — выносные опоры, п. 111 — откос выемки, п. 112 — 30 м до провода и наряд-допуск, п. 138 — пуск в работу, п. 165 — периодичность освидетельствования, п. 189 — запись в паспорт', href: 'https://www.consultant.ru/document/cons_doc_LAW_373321/' },
        { text: 'Закон г. Москвы от 12.07.2002 №42 и ст. 3.13 КоАП города Москвы — запрет шумных работ с 23:00 до 07:00 и размер штрафа' },
      ]}
    />
  </section>
</main>
</BaseLayout>
