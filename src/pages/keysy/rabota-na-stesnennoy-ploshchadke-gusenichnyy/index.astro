---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Sources from '../../../components/Sources.astro';
import ZoneTable from '../../../components/ZoneTable.astro';

const title = 'Гусеничный кран на стеснённой городской площадке';
const description = 'Типовой сценарий: узкая площадка без места для выносных опор автокрана — гусеничный кран с телескопической рамой хода как решение.';

// Волна 39: карточка параметров сценария. Ни одного нового факта — класс
// техники, условие площадки и нормативные реквизиты уже названы на этой же
// странице (подзаголовок над H1, разделы ниже и блок «Источники»). Таблица
// собирает их в одном месте с подписями столбцов: и человеку, и языковой
// модели, которая цитирует страницу в ответе, не приходится вытаскивать эти
// значения из середины абзацев (критерий рубрикатора geo-table-present).
const caseRows = [
  ['Техника в сценарии', 'Гусеничный кран 55 т'],
  ['Что делает задачу нетиповой', 'Стеснённая городская площадка, на которой автокрану не хватает места под опоры'],
  ['Что определяет исход', 'Геометрия установки задаётся нормой, а не удобством; обратная сторона решения — доставка крана на трале'],
  ['Норма, по которой это считается', 'ФНП №461 (ред. от 16.04.2026): п. 108 — площадка и уклон, п. 110 — выносные опоры, п. 111 — откос выемки, п. 112 — 30 м до провода'],
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Примеры задач', item: 'https://moskran-servis.ru/keysy/' },
    { '@type': 'ListItem', position: 3, name: 'Гусеничный кран на стеснённой площадке', item: 'https://moskran-servis.ru/keysy/rabota-na-stesnennoy-ploshchadke-gusenichnyy/' },
  ],
};
---
<BaseLayout title={title} description={description} path="/keysy/rabota-na-stesnennoy-ploshchadke-gusenichnyy/" ldExtra={[breadcrumbLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/keysy/">Примеры задач</a><span>/</span><span>Гусеничный кран на стеснённой площадке</span>
  </nav>
  <section class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Пример задачи · гусеничный кран 55 т</span>
    <h1 style="margin:14px 0 8px">Гусеничный кран на стеснённой городской площадке</h1>
    <p style="color:var(--muted);font-size:var(--t-md);margin-bottom:24px">Иллюстративный сценарий — не описание конкретного выполненного объекта.</p>

    <h2 style="margin-bottom:14px">Задача</h2>
    <p>Монтаж тяжёлого оборудования весом около 20 тонн на площадке, где подъездной путь и место для установки техники ограничены соседними зданиями и инженерными коммуникациями — классический вариант для объектов рядом с метро или в плотной старой застройке.</p>

    <ZoneTable
      caption="Параметры сценария"
      columns={['Параметр', 'Значение в этом сценарии']}
      rows={caseRows}
    />

    <h2 style="margin:32px 0 14px">Почему автокран не подходит по геометрии</h2>
    <p>Автокран сопоставимого класса на выносных опорах занимает площадь порядка 8-9 метров в каждую сторону от оси — на стеснённой площадке этого пространства часто просто нет, независимо от грузоподъёмности техники. Гусеничный кран не нуждается в выносных опорах на грунте (опирается на гусеничный ход целиком), что снимает это конкретное ограничение геометрии площадки.</p>

    <h2 style="margin:32px 0 14px">Логистика доставки — обратная сторона решения</h2>
    <p>Гусеничный кран не может доехать до объекта своим ходом — только на трале, что требует отдельного согласования маршрута перевозки и, для моделей с телескопической рамой хода (сужающейся для транспортировки), дополнительного времени на сборку рамы в рабочее положение уже на площадке. Это заранее закладывается в график работ как отдельный этап, а не «довесок» к обычной подаче техники.</p>

    <h2 style="margin:32px 0 14px">Итог</h2>
    <p>Выбор между автокраном и гусеничным краном для стеснённой площадки — это в первую очередь вопрос геометрии, а не грузоподъёмности: даже если по весу и вылету автокран технически справился бы, отсутствие места под выносные опоры делает гусеничный кран единственным реалистичным вариантом.</p>
  </section>
  <section class="section wrap prose" style="padding-top:0;max-width:820px">
    <h2 style="margin-bottom:16px">Почему геометрию задаёт норма, а не удобство</h2>
    <p>Соблазн «поставим автокран на две опоры со стороны груза» на стеснённой площадке возникает всегда. Норма отвечает на него однозначно: установка на выносные опоры выполняется по требованиям руководства (инструкции) по эксплуатации, а при отсутствии таких требований машина устанавливается на все выносные опоры. Работа на части опор — это отдельно предусмотренный производителем режим со своей, сниженной грузовой характеристикой, а не способ вписаться в узкое место.</p>
    <p>Отсюда и вывод в пользу гусеничной машины: она снимает не грузоподъёмностное, а геометрическое ограничение. При этом требования к основанию остаются: запрет на свеженасыпанный неутрамбованный грунт и на сверхпаспортный уклон действует и для гусеничного хода.</p>
    <p>Если рядом котлован или траншея — добавляется ещё одно расстояние: краны стрелового типа у края откоса устанавливаются с соблюдением значений из приложения к Правилам, которые зависят от глубины выемки и грунта. В плотной городской застройке это ограничение срабатывает чаще, чем кажется по плану площадки.</p>
    <p style="margin-top:18px">Проверить, какие из этих позиций уже закрыты по вашему объекту, можно в <a href="/proverka-dokumentov/" style="color:var(--yellow)">чек-листе допуска</a>; сами нормы разобраны в <a href="/spravochnik/" style="color:var(--yellow)">справочнике</a>.</p>
    <Sources
      checked="12.08.2026"
      items={[
        { text: 'Приказ Ростехнадзора от 26.11.2020 №461 (ред. от 16.04.2026): п. 108 — площадка и уклон, п. 110 — выносные опоры, п. 111 — откос выемки, п. 112 — 30 м до провода и наряд-допуск, п. 138 — пуск в работу, п. 165 — периодичность освидетельствования, п. 189 — запись в паспорт', href: 'https://www.consultant.ru/document/cons_doc_LAW_373321/' },
      ]}
    />
  </section>
</main>
</BaseLayout>
