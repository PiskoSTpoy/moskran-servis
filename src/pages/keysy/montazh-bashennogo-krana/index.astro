---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Sources from '../../../components/Sources.astro';
import ZoneTable from '../../../components/ZoneTable.astro';

const title = 'Монтаж башенного крана на объекте монолитного домостроения';
const description = 'Типовой сценарий: монтаж башенного крана на новом объекте монолитного домостроения — фундамент, монтаж автокраном-помощником, наращивание.';

// Волна 39: карточка параметров сценария. Ни одного нового факта — класс
// техники, условие площадки и нормативные реквизиты уже названы на этой же
// странице (подзаголовок над H1, разделы ниже и блок «Источники»). Таблица
// собирает их в одном месте с подписями столбцов: и человеку, и языковой
// модели, которая цитирует страницу в ответе, не приходится вытаскивать эти
// значения из середины абзацев (критерий рубрикатора geo-table-present).
const caseRows = [
  ['Техника в сценарии', 'Башенный кран на объекте монолитного домостроения'],
  ['Что делает задачу нетиповой', 'Монтируется сам подъёмный кран, а не груз для стройки'],
  ['Что определяет исход', 'Допуск башенного крана — отдельный этап стройки со своим сроком'],
  ['Норма, по которой это считается', 'ФНП №461 (ред. от 16.04.2026): п. 108 — площадка и уклон, п. 110 — выносные опоры, п. 111 — откос выемки, п. 112 — 30 м до провода'],
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Примеры задач', item: 'https://moskran-servis.ru/keysy/' },
    { '@type': 'ListItem', position: 3, name: 'Монтаж башенного крана', item: 'https://moskran-servis.ru/keysy/montazh-bashennogo-krana/' },
  ],
};
---
<BaseLayout title={title} description={description} path="/keysy/montazh-bashennogo-krana/" ldExtra={[breadcrumbLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/keysy/">Примеры задач</a><span>/</span><span>Монтаж башенного крана</span>
  </nav>
  <section class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Пример задачи · башенный кран</span>
    <h1 style="margin:14px 0 8px">Монтаж башенного крана на объекте монолитного домостроения</h1>
    <p style="color:var(--muted);font-size:var(--t-md);margin-bottom:24px">Иллюстративный сценарий — не описание конкретного выполненного объекта.</p>

    <h2 style="margin-bottom:14px">Задача</h2>
    <p>Установка башенного крана на начальном этапе строительства монолитного жилого дома высотой 22 этажа — заказчик заранее спроектировал место под фундамент крана в составе стройгенплана, кран должен обслуживать весь цикл работ до финального этапа отделки.</p>

    <ZoneTable
      caption="Параметры сценария"
      columns={['Параметр', 'Значение в этом сценарии']}
      rows={caseRows}
    />

    <h2 style="margin:32px 0 14px">Расчёт техники</h2>
    <p>По расстоянию от предполагаемого места установки башни до самой дальней точки здания (около 45 метров по горизонтали) и требуемой высоте подъёма (порядка 65 метров с учётом этажности и высоты будущей парапетной части) выбран кран класса 132 тм с башней увеличенной высоты — обеспечивает нужный вылет и высоту с запасом на возможное уточнение этажности на финальной стадии проектирования.</p>

    <h2 style="margin:32px 0 14px">Особенности, которые важны на практике</h2>
    <ul>
      <li>Фундамент под кран заливается заранее, на подготовительном этапе стройки, до начала возведения самого здания — расчёт фундамента выполняет проектировщик крановой части стройгенплана, исходя из паспортных нагрузок конкретной модели.</li>
      <li>Монтаж выполняется автокраном-помощником (для этого класса подходит техника класса 32–40 тонн из собственной линейки) — секции башни собираются последовательно снизу вверх.</li>
      <li>По мере роста здания при приставной схеме кран требует периодического наращивания башни синхронно с этажами — это плановые остановки в графике, встроенные в общий план работ, а не внеплановый простой.</li>
      <li>Демонтаж по завершении монтажных работ — на этапе, когда дальнейшая работа крана уже не требуется, но здание ещё не полностью готово к сдаче, то есть демонтаж не совпадает с датой сдачи объекта, а планируется отдельно.</li>
    </ul>

    <h2 style="margin:32px 0 14px">Итог</h2>
    <p>В отличие от заявок на автокран, расчёт под башенный кран начинается не в день заявки, а на этапе проектирования стройгенплана — место установки, тип фундамента и класс крана закладываются заранее, задолго до фактического монтажа. Это определяет и совсем другой формат сотрудничества: не разовая заявка, а согласование проекта на подготовительном этапе стройки.</p>
  </section>
  <section class="section wrap prose" style="padding-top:0;max-width:820px">
    <h2 style="margin-bottom:16px">Почему допуск башенного крана — отдельный этап стройки</h2>
    <p>У автокрана допуск заканчивается на выезде из парка. У башенного крана он начинается на объекте: решение о пуске в работу после установки принимается на основании предложений комиссии, в состав которой входит уполномоченный представитель надзорного органа. Это прямо предусмотренная процедура именно для башенных кранов, и в графике она занимает своё место — её нельзя провести «в фоне» параллельно с началом работ.</p>
    <p>До монтажа закрывается основание. Работы по подготовке фундамента или анкерного узла оформляются актом освидетельствования скрытых работ: после установки крана проверить, что именно лежит под плитой, физически невозможно. Расчёт фундамента ведётся от паспортных нагрузок конкретной модели, а не от «класса 132 тм вообще».</p>
    <p>Периодичность освидетельствования при этом общая: частичное — не реже раза в 12 месяцев, полное — не реже раза в 3 года. Для крана, который стоит на площадке год и больше, это означает плановую остановку внутри срока аренды, и её тоже полезно увидеть в графике заранее.</p>
    <p style="margin-top:18px">Проверить, какие из этих позиций уже закрыты по вашему объекту, можно в <a href="/proverka-dokumentov/" style="color:var(--yellow)">чек-листе допуска</a>; сами нормы разобраны в <a href="/spravochnik/" style="color:var(--yellow)">справочнике</a>.</p>
    <Sources
      checked="12.08.2026"
      items={[
        { text: 'Приказ Ростехнадзора от 26.11.2020 №461 (ред. от 16.04.2026): п. 108 — площадка и уклон, п. 110 — выносные опоры, п. 111 — откос выемки, п. 112 — 30 м до провода и наряд-допуск, п. 138 — пуск в работу, п. 165 — периодичность освидетельствования, п. 189 — запись в паспорт', href: 'https://www.consultant.ru/document/cons_doc_LAW_373321/' },
      ]}
    />
  </section>
</main>
</BaseLayout>
