---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Sources from '../../../components/Sources.astro';
import ZoneTable from '../../../components/ZoneTable.astro';

const title = 'Кран рядом с газопроводом во дворе старой застройки';
const description = 'Установка автокрана в двух метрах от газопровода — согласование Мосгаза и отдельный риск для ордера всей площадки по постановлению №980-ПП.';

// Волна 39: карточка параметров сценария. Ни одного нового факта — класс
// техники, условие площадки и нормативные реквизиты уже названы на этой же
// странице (подзаголовок над H1, разделы ниже и блок «Источники»). Таблица
// собирает их в одном месте с подписями столбцов: и человеку, и языковой
// модели, которая цитирует страницу в ответе, не приходится вытаскивать эти
// значения из середины абзацев (критерий рубрикатора geo-table-present).
const caseRows = [
  ['Техника в сценарии', 'Автокран 25 т'],
  ['Что делает задачу нетиповой', 'Подземный газопровод во дворе старой застройки'],
  ['Что определяет исход', 'Согласование с газораспределительной организацией и границы охранной зоны сети'],
  ['Норма, по которой это считается', 'Постановление Правительства РФ от 20.11.2000 №878 «Правила охраны газораспределительных сетей»; постановление Правительства Москвы от 06.12.2005 №980-ПП'],
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Примеры задач', item: 'https://moskran-servis.ru/keysy/' },
    { '@type': 'ListItem', position: 3, name: 'Кран рядом с газопроводом', item: 'https://moskran-servis.ru/keysy/podyom-ryadom-s-gazoprovodom/' },
  ],
};
---
<BaseLayout title={title} description={description} path="/keysy/podyom-ryadom-s-gazoprovodom/" ldExtra={[breadcrumbLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/keysy/">Примеры задач</a><span>/</span><span>Кран рядом с газопроводом</span>
  </nav>
  <section class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Пример задачи · автокран 25 т · согласование Мосгаза</span>
    <h1 style="margin:14px 0 8px">Кран рядом с подземным газопроводом во дворе старой застройки</h1>
    <p style="color:var(--muted);font-size:var(--t-md);margin-bottom:24px">Иллюстративный сценарий — не описание конкретного выполненного объекта.</p>

    <h2 style="margin-bottom:14px">Задача</h2>
    <p>Замена инженерного оборудования на кровле дома в квартале застройки 1960–70-х годов. По топографическому плану участка примерно в двух метрах от предполагаемой точки установки одной из выносных опор крана проходит подземный газопровод низкого давления — типичная ситуация для дворов старой застройки, где карта подземных коммуникаций плотнее и хуже задокументирована, чем на новых площадках.</p>

    <ZoneTable
      caption="Параметры сценария"
      columns={['Параметр', 'Значение в этом сценарии']}
      rows={caseRows}
    />

    <h2 style="margin:32px 0 14px">Расчёт и согласование</h2>
    <p>Охранная зона газопровода по правилам охраны газораспределительных сетей — 2 метра от оси в каждую сторону независимо от давления в трубе. Расчётная точка опоры попадала прямо в границу этой зоны, поэтому без письменного разрешения владельца сети установка технически запрещена — даже если под опорой не копают, а просто ставят инвентарную подкладку на поверхность. Мы направили запрос в районную эксплуатационную службу «Мосгаза», обслуживающую этот адрес, — рассмотрение обращения по регламенту занимает не позднее 5 рабочих дней, и это время заложено в график ещё на этапе приёма заявки, а не выяснено по факту готовности техники к выезду.</p>
    <p>Отдельно от письма «Мосгаза» на площадке действовал второй, менее очевидный слой: участок относился к зоне комплексной застройки, где сохранность подземных сетей при производстве работ регулирует не только владелец конкретной трубы, но и городской надзор в целом. Мы уточнили у генподрядчика, учтены ли в проекте организации строительства мероприятия по сохранности сетей и есть ли согласованная схема пересечений с коммуникациями — это отдельный документ, не тот же самый, что письмо «Мосгаза» на установку опоры.</p>

    <h2 style="margin:32px 0 14px">Особенности, которые важны на практике</h2>
    <ul>
      <li>Разрешение «Мосгаза» закрывает вопрос конкретно по установке опоры крана — оно не заменяет и не отменяет обязанности генподрядчика по сохранности сетей на площадке в целом.</li>
      <li>Если бы при работах на этой же площадке (не обязательно нашей техникой) была повреждена труба, Объединение административно-технических инспекций Москвы вправе приостановить действие ордера на производство работ по всему участку, а не только в точке повреждения — это резко увеличивает цену ошибки для всех подрядчиков на объекте одновременно.</li>
      <li>Точку установки сдвинули на полметра относительно первоначального плана, чтобы выйти за границу двухметровой зоны там, где это позволяла геометрия площадки, — там, где вылет стрелы это допускал, обошлись без формального разрешения вообще.</li>
    </ul>

    <h2 style="margin:32px 0 14px">Итог</h2>
    <p>Близость подземного газопровода — фактор, который не меняет расчёт самого подъёма (вес и вылет считаются как обычно), но добавляет процедурный слой сразу на двух уровнях: точечное разрешение владельца сети на конкретную опору и общую ответственность площадки за сохранность сетей, которая может затронуть график даже при чужой ошибке. Оба слоя стоит выяснять на этапе приёма заявки, если адрес — двор старой застройки, а не только держать в уме расчёт грунта под опорами.</p>
  </section>
  <section class="section wrap prose" style="padding-top:0;max-width:820px">
    <h2 style="margin-bottom:16px">Норма, по которой это считается</h2>
    <p>Охранная зона газопровода и порядок получения разрешения на работы в ней заданы Правилами охраны газораспределительных сетей (постановление Правительства РФ от 20.11.2000 №878) — подробный разбор с таблицей расстояний и контактами согласующих организаций есть на отдельной странице справочника, ссылка ниже. Городской надзор за сохранностью подземных сетей и коммуникаций при производстве земляных и строительных работ в Москве отдельно регулирует постановление Правительства Москвы от 06.12.2005 №980-ПП: оно обязывает включать в проект организации строительства мероприятия по сохранности сетей, согласовывать их с эксплуатирующими организациями и описывать места пересечений и границы охранных зон, а контроль через выдачу и отзыв ордеров на производство работ ведёт Объединение административно-технических инспекций города Москвы (ОАТИ).</p>
    <p>Это не тот же самый ордер, что при перекрытии проезжей части под установку крана, — там свой порядок по постановлению №299-ПП, разобранный на странице <a href="/spravochnik/soglasovanie-perekrytiya-proezda/" style="color:var(--yellow)">«Согласование перекрытия проезда»</a>. Оба порядка ведёт один и тот же орган (ОАТИ), но основания и предмет ордера разные, и путать их не стоит.</p>
    <p style="margin-top:18px">Полный разбор охранной зоны газопровода, согласующих организаций и ответственности за повреждение — в статье <a href="/spravochnik/rabota-krana-ryadom-s-gazoprovodom/" style="color:var(--yellow)">«Кран рядом с газопроводом»</a>. Похожая по логике, но по другому типу сети ситуация — в примере <a href="/keysy/podyom-ryadom-s-lep/" style="color:var(--yellow)">«Подъём оборудования рядом с ЛЭП»</a>. Проверить, какие документы по вашему объекту уже закрыты, можно в <a href="/proverka-dokumentov/" style="color:var(--yellow)">чек-листе допуска</a>.</p>
    <Sources
      checked="19.08.2026"
      items={[
        { text: 'ГАРАНТ — постановление Правительства РФ от 20.11.2000 №878 «Об утверждении Правил охраны газораспределительных сетей»', href: 'https://base.garant.ru/12121252/' },
        { text: 'mos.ru — постановление Правительства Москвы от 06.12.2005 №980-ПП «Об обеспечении сохранности подземных сетей и коммуникаций при производстве земляных и строительных работ в городе Москве»', href: 'https://www.mos.ru/authority/documents/doc/18206220/' },
      ]}
      note="Сценарий иллюстративный: конкретный адрес, дата и участники не приводятся — норма разрешения по 878 и обязанности по 980-ПП настоящие, применяются к типовой ситуации двора старой застройки."
    />
  </section>
</main>
</BaseLayout>
