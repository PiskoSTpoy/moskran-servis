---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sources from '../../components/Sources.astro';

const title = 'Как в Москве подбирают кран под задачу — 18 разборов';
const description = 'Почему в Москве кран выбирают не по тоннажу: пропуск и РНИС, точка постановки над паркингом, вылет вместо грузоподъёмности, сроки согласований.';

const CHECKED = '12.08.2026';

const SITE = 'https://moskran-servis.ru';
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: `${SITE}/` },
    { '@type': 'ListItem', position: 2, name: 'Примеры задач', item: `${SITE}/keysy/` },
  ],
};

const groups = [
  {
    id: 'doehat',
    head: 'Доехать до адреса',
    intro: 'Задачи, где решение упирается не в грузоподъёмность, а в то, какая машина физически и юридически попадёт на площадку.',
    cases: [
      { href: '/keysy/podyezd-po-gruntovoy-doroge-vnedorozhnik/', title: 'Подача крана на площадку без асфальтированного подъезда', tag: 'Автокран 25 т · шасси повышенной проходимости' },
      { href: '/keysy/montazh-tyazhelogo-oborudovaniya-100t/', title: 'Монтаж крупногабаритного технологического блока весом свыше 30 тонн', tag: 'Автокран 100 т' },
      { href: '/keysy/rabota-na-stesnennoy-ploshchadke-gusenichnyy/', title: 'Гусеничный кран на стеснённой городской площадке', tag: 'Гусеничный кран 55 т' },
      { href: '/keysy/avariynyy-vyezd/', title: 'Срочный аварийный выезд крана вне графика', tag: 'Автокран 25 т' },
      { href: '/keysy/proezd-cherez-arku/', title: 'Проезд крана во двор через арку старого дома', tag: 'Автокран 25 т · габариты проезда' },
    ],
  },
  {
    id: 'opory',
    head: 'Что под выносными опорами',
    intro: 'Задачи, где точку постановки выбирают раньше модели крана: насыпной грунт, перекрытие подземного паркинга, площадка без подготовленного основания.',
    cases: [
      { href: '/keysy/montazh-oborudovaniya-zavod/', title: 'Монтаж тяжёлого оборудования на территории завода на мягком грунте', tag: 'Гусеничный кран 50 т' },
      { href: '/keysy/podacha-materialov-monolit/', title: 'Подача материалов при монолитном строительстве без башенного крана', tag: 'Автокран 50 т' },
      { href: '/keysy/razgruzka-zhbi-zhk/', title: 'Разгрузка ЖБИ на стройплощадке жилого комплекса', tag: 'Автокран 25 т' },
      { href: '/keysy/opory-na-perekrytii-parkinga/', title: 'Опоры автокрана на перекрытии подземного паркинга', tag: 'Автокран 32 т · поверочный расчёт плиты' },
    ],
  },
  {
    id: 'vylet',
    head: 'Дотянуться, не подъезжая вплотную',
    intro: 'Задачи, где кран нельзя поставить рядом с грузом, и всё решает грузоподъёмность на нужном вылете, а не цифра в названии модели.',
    cases: [
      { href: '/keysy/fasad-vysotnogo-doma/', title: 'Монтаж элементов фасада на высотном жилом доме', tag: 'Автокран 25 т · увеличенная стрела' },
      { href: '/keysy/montazh-ventilyacii-bc/', title: 'Монтаж вентиляционного оборудования на кровлю бизнес-центра', tag: 'Автокран 32 т · режимный объект' },
      { href: '/keysy/zamena-lifta-zhiloy-dom/', title: 'Замена лифтового оборудования в жилом доме', tag: 'Автокран 25 т' },
      { href: '/keysy/demontazh-avariynoy-krovli/', title: 'Демонтаж аварийной кровельной конструкции', tag: 'Автокран 40 т' },
    ],
  },
  {
    id: 'dopuski',
    head: 'Допуски, без которых стрела не поднимется',
    intro: 'Задачи, где срок определяет не техника, а разрешительная часть: наряд-допуск сетевой организации, индивидуальный проект производства работ.',
    cases: [
      { href: '/keysy/podyom-ryadom-s-lep/', title: 'Подъём оборудования рядом с воздушной линией электропередачи', tag: 'Автокран 32 т · наряд-допуск' },
      { href: '/keysy/montazh-bashennogo-krana/', title: 'Монтаж башенного крана на объекте монолитного домостроения', tag: 'Башенный кран' },
      { href: '/keysy/podyom-ryadom-s-gazoprovodom/', title: 'Кран рядом с подземным газопроводом во дворе старой застройки', tag: 'Автокран 25 т · согласование Мосгаза' },
      { href: '/keysy/podyom-ryadom-s-teplotrassoy/', title: 'Кран рядом с теплотрассой: сезонный риск гидравлических испытаний', tag: 'Автокран 32 т · согласование МОЭК' },
      { href: '/keysy/podyom-v-tehnicheskoy-zone-metro/', title: 'Кран в технической зоне метрополитена', tag: 'Автокран 40 т · техническая зона метро' },
    ],
  },
];

const itemListLd = {
  '@context': 'https://schema.org', '@type': 'ItemList',
  name: 'Разборы типовых заявок на кран в Москве',
  itemListElement: groups.flatMap((g) => g.cases).map((c, i) => ({
    '@type': 'ListItem', position: i + 1, name: c.title, url: SITE + c.href,
  })),
};
---
<BaseLayout title={title} description={description} path="/keysy/" ldExtra={[breadcrumbLd, itemListLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span aria-hidden="true">/</span><span aria-current="page">Примеры задач</span>
  </nav>

  <section class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Логика подбора · Москва</span>
    <h1 style="margin:14px 0 20px">Как в Москве подбирают кран под задачу</h1>

    <p>Тоннаж в названии машины — последнее, что решается по московской заявке, и почти никогда не первое. Прежде чем говорить про 25 или 50 тонн, приходится ответить на четыре вопроса, каждый из которых способен вычеркнуть половину парка.</p>

    <h2 style="margin:34px 0 14px">1. Доедет ли эта машина до адреса и в какие часы</h2>
    <p>Автокран на грузовом шасси для города — обычное грузовое транспортное средство, и он попадает под грузовой каркас Москвы наравне с фурой. Для въезда и движения в границах МКАД транспортным средствам разрешённой максимальной массой свыше 3,5 тонн нужен пропуск, причём с 1 января 2022 года — круглосуточно, а не только днём; тогда же добавилось требование регистрации в московской РНИС. Под 3,5 тонны не проходит ни один автокран, поэтому вопрос стоит не «нужен ли пропуск», а «какой зоны и какого режима он у конкретной машины». Дневной режим — с 07:00 до 23:00, ночной — оставшиеся часы; внутри МКАД действует ещё и порог по экологическому классу техники.</p>
    <p>Практический вывод для заказчика: при обзвоне подрядчиков спрашивайте не только «есть ли кран нужного тоннажа», а есть ли у этой конкретной машины действующий пропуск нужной зоны и регистрация в РНИС. Кран без пропуска либо не приедет, либо приедет под камеру. Отдельная история — техника, которая не идёт своим ходом: гусеничный кран и краны верхнего сегмента везут тралом, а это уже перевозка тяжеловесного груза с согласованием маршрута, то есть плюс несколько дней к сроку.</p>

    <h2 style="margin:34px 0 14px">2. Куда физически встанут выносные опоры</h2>
    <p>В московской застройке кран заметно чаще стоит не на грунте, а на том, что человек сделал: на перекрытии подземного паркинга, на эксплуатируемой кровле стилобата, на тротуарной плитке над инженерными сетями, на обратной засыпке пазух котлована. Нагрузка под опорами распределяется неравномерно — со стороны груза она максимальна, и это не «вес крана, делённый на четыре». Поэтому подбор идёт в обратную сторону: сначала выясняется <a href="/spravochnik/nesushchaya-sposobnost-grunta/" style="color:var(--yellow)">допустимая нагрузка на конкретное пятно</a>, потом под неё берётся самая лёгкая машина, которой хватит вылета. Взять кран «с запасом» на такой площадке — это не перестраховка, а лишние тонны на плиту.</p>
    <p>Отдельный московский нюанс — сезон. Грунт под опорой в городе редко бывает природным: вокруг новых объектов это почти всегда обратная засыпка, которая зимой держит промерзанием, а в оттепель ведёт себя иначе на той же самой точке. Прошлогодняя схема постановки крана по этому же адресу в марте не гарантирует ничего.</p>

    <h2 style="margin:34px 0 14px">3. Хватит ли вылета, если подъехать вплотную нельзя</h2>
    <p>Плотная застройка означает, что расстояние от опор до груза задаётся не удобством, а тем, где заканчивается участок. «Двадцатипятитонник» поднимает свои 25 тонн на минимальном вылете; на вылете 18–20 метров от паспортной цифры остаётся малая доля. Именно поэтому в московских заявках так часто выигрывает не более тяжёлый кран, а машина с более длинной стрелой или с гуськом — и поэтому разговор без <a href="/spravochnik/gruzovysotnaya-harakteristika/" style="color:var(--yellow)">грузовысотной характеристики</a> и точного расстояния до груза смысла не имеет.</p>

    <h2 style="margin:34px 0 14px">4. Кто и сколько будет согласовывать</h2>
    <p>Если опоры или опасная зона выходят за границы участка, техника ждёт не поставщика, а город: ордерный режим, временная схема движения, метрополитен под площадкой, наряд-допуск при работе рядом с воздушной линией. Разрешительный слой мы держим отдельной страницей — <a href="/documents/" style="color:var(--yellow)">документы вокруг московской заявки</a>, — потому что именно он, а не наличие свободного крана, чаще всего определяет дату выезда. На выбор техники это влияет напрямую: компактная короткобазная машина, которая помещается во двор, нередко дешевле и быстрее, чем согласование выхода на проезжую часть под машину покрупнее.</p>

    <p style="margin-top:26px">Ниже — разборы заявок, сгруппированные по тому, какой из четырёх вопросов в них главный.</p>
  </section>

  <section class="section wrap" style="padding-top:0">
    <p class="keysy-note">Это разборы типовых задач, а не отчёты о выполненных объектах: техника, нормы и ограничения здесь настоящие, а конкретных адресов, дат и заказчиков нет — сочинять их мы не станем, своих завершённых объектов через сайт у нас пока не набралось.</p>

    {groups.map((g) => (
      <div class="keysy-group">
        <h2 id={g.id} class="keysy-group__head">{g.head}</h2>
        <p class="keysy-group__intro">{g.intro}</p>
        <div class="keysy-grid">
          {g.cases.map((c) => (
            <a class="keysy-card box" href={c.href}>
              <span class="keysy-card__tag">{c.tag}</span>
              <h3>{c.title}</h3>
            </a>
          ))}
        </div>
      </div>
    ))}

    <Sources
      checked={CHECKED}
      items={[
        { text: 'Единый транспортный портал Москвы — пропуска для грузового транспорта и требование РНИС', href: 'https://transport.mos.ru/gruzoviki/perevod_ckad' },
        { text: 'mos.ru — грузовой каркас и оформление пропуска', href: 'https://www.mos.ru/otvet-transport/kak-oformit-propusk-dlya-gruzovogo-transporta/' },
      ]}
      note="Разбор разрешительной части по московскому адресу — на странице «Документы вокруг московской заявки» (/documents/)."
    />
  </section>

  <section class="section wrap">
    <a class="btn" href="/#zayavka">Рассчитать заявку по адресу →</a>
  </section>
</main>
<style>
  .keysy-note { max-width: 820px; border-left: 3px solid transparent; background-image: var(--hazard-edge); background-repeat: no-repeat; background-size: 3px 100%; background-position: left top; background-origin: border-box; padding: 12px 0 12px 16px; color: var(--muted); font-size: var(--t-md); margin-bottom: 40px; }
  .keysy-group + .keysy-group { margin-top: 44px; }
  .keysy-group__head { font-size: var(--t-h3); }
  .keysy-group__intro { color: var(--muted); font-size: var(--t-md); max-width: 74ch; margin: 10px 0 18px; }
  .keysy-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; }
  .keysy-card { display: block; text-decoration: none; padding: 26px; background: var(--bg-2); border: 1px solid var(--line-strong); }
  .keysy-card:hover { border-color: var(--yellow); }
  .keysy-card__tag { color: var(--yellow); font-size: var(--t-xs); font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
  .keysy-card h3 { font-size: var(--t-lead); margin-top: 10px; text-transform: none; }
  @media (max-width: 800px) { .keysy-grid { grid-template-columns: 1fr; } }
</style>
</BaseLayout>
