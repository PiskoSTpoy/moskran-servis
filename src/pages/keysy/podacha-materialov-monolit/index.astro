---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Sources from '../../../components/Sources.astro';
import ZoneTable from '../../../components/ZoneTable.astro';

const title = 'Подача материалов при монолитном строительстве';
const description = 'Типовой сценарий: автокран вместо башенного на небольшом монолитном объекте — когда это оправдано, а когда нет. Иллюстративный пример расчёта.';

// Волна 39: карточка параметров сценария. Ни одного нового факта — класс
// техники, условие площадки и нормативные реквизиты уже названы на этой же
// странице (подзаголовок над H1, разделы ниже и блок «Источники»). Таблица
// собирает их в одном месте с подписями столбцов: и человеку, и языковой
// модели, которая цитирует страницу в ответе, не приходится вытаскивать эти
// значения из середины абзацев (критерий рубрикатора geo-table-present).
const caseRows = [
  ['Техника в сценарии', 'Автокран 50 т'],
  ['Что делает задачу нетиповой', 'Монолитное строительство, на котором башенного крана нет'],
  ['Что определяет исход', 'Сравнение двух вариантов подачи и разница в допуске между ними'],
  ['Норма, по которой это считается', 'ФНП №461 (ред. от 16.04.2026): п. 108 — площадка и уклон, п. 110 — выносные опоры, п. 111 — откос выемки, п. 112 — 30 м до провода'],
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Примеры задач', item: 'https://moskran-servis.ru/keysy/' },
    { '@type': 'ListItem', position: 3, name: 'Автокран вместо башенного', item: 'https://moskran-servis.ru/keysy/podacha-materialov-monolit/' },
  ],
};
---
<BaseLayout title={title} description={description} path="/keysy/podacha-materialov-monolit/" ldExtra={[breadcrumbLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/keysy/">Примеры задач</a><span>/</span><span>Автокран вместо башенного</span>
  </nav>
  <section class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Пример задачи · автокран 50 т</span>
    <h1 style="margin:14px 0 8px">Подача материалов при монолитном строительстве без башенного крана</h1>
    <p style="color:var(--muted);font-size:var(--t-md);margin-bottom:24px">Иллюстративный сценарий — не описание конкретного выполненного объекта.</p>

    <h2 style="margin-bottom:14px">Задача</h2>
    <p>Малоэтажный монолитный объект (4 этажа), короткий срок строительства (около двух месяцев), заказчик рассматривает вариант с башенным краном, но сомневается — монтаж/демонтаж и помесячная аренда башенного крана на такой короткий срок могут оказаться дороже, чем периодическая подача автокрана.</p>

    <ZoneTable
      caption="Параметры сценария"
      columns={['Параметр', 'Значение в этом сценарии']}
      rows={caseRows}
    />

    <h2 style="margin:32px 0 14px">Расчёт и сравнение вариантов</h2>
    <p>Для объекта такой этажности и продолжительности реальная потребность в подъёмной технике — не постоянная (в отличие от высотного дома, где башенный кран работает практически непрерывно весь цикл), а периодическая: несколько смен в неделю на подачу материалов и опалубки. При таком режиме использования 50-тонный автокран, вызываемый по графику заливки этажей, обходится дешевле, чем монтаж/демонтаж башенного крана плюс помесячная аренда на два месяца — итоговая стоимость сравнивается по факту графика объекта, не по общему правилу «монолит = обязательно башенный кран».</p>

    <h2 style="margin:32px 0 14px">Особенности, которые важны на практике</h2>
    <ul>
      <li>График подачи автокрана синхронизируется с графиком заливки этажей — кран приезжает не каждый день, а в дни, когда идёт монтаж опалубки или подача арматуры.</li>
      <li>Вылет и высота подъёма проверяются для самого верхнего, четвёртого этажа — с учётом того, что кран должен доставать до дальней точки плиты перекрытия, а не только до края здания.</li>
      <li>Точка установки крана согласовывается заранее на весь период стройки — при коротком объекте нет смысла каждый раз искать новое место, если исходная позиция подходит для всех этажей.</li>
    </ul>

    <h2 style="margin:32px 0 14px">Итог</h2>
    <p>Решение «автокран или башенный» — не универсальное правило по типу объекта (монолит), а расчёт конкретной интенсивности использования техники и продолжительности стройки. Для коротких и невысоких объектов периодическая подача автокрана часто оказывается более выгодным вариантом, чем монтаж стационарного башенного крана.</p>
  </section>
  <section class="section wrap prose" style="padding-top:0;max-width:820px">
    <h2 style="margin-bottom:16px">Чем отличается допуск в двух вариантах</h2>
    <p>Сравнение автокрана и башенного крана обычно ведут по деньгам, но у них ещё и разный допуск. Башенный кран после установки на объекте пускают в работу по решению комиссии с участием уполномоченного представителя надзорного органа, и перед этим закрывают основание актом освидетельствования скрытых работ. Автокран приезжает с готовым комплектом и уезжает — процедуры пуска в работу на объекте у него нет.</p>
    <p>Обратная сторона: автокран каждый раз заново устанавливается на выносные опоры, и каждый раз действует требование к площадке — не свеженасыпанный неутрамбованный грунт, уклон не больше паспортного, опирание на все опоры, если руководство не предусматривает иного. При десятке выездов это десять проверок одной и той же точки, а не одна.</p>
    <p>Поэтому решение «автокран или башенный» на коротком объекте считается не только по ставке за смену, но и по количеству процедур: у башенного они разовые и длинные, у автокрана — короткие, но повторяющиеся.</p>
    <p style="margin-top:18px">Проверить, какие из этих позиций уже закрыты по вашему объекту, можно в <a href="/proverka-dokumentov/" style="color:var(--yellow)">чек-листе допуска</a>; сами нормы разобраны в <a href="/spravochnik/" style="color:var(--yellow)">справочнике</a>.</p>
    <Sources
      checked="12.08.2026"
      items={[
        { text: 'Приказ Ростехнадзора от 26.11.2020 №461 (ред. от 16.04.2026): п. 108 — площадка и уклон, п. 110 — выносные опоры, п. 111 — откос выемки, п. 112 — 30 м до провода и наряд-допуск, п. 138 — пуск в работу, п. 165 — периодичность освидетельствования, п. 189 — запись в паспорт', href: 'https://www.consultant.ru/document/cons_doc_LAW_373321/' },
      ]}
    />
  </section>
</main>
</BaseLayout>
