---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Sources from '../../../components/Sources.astro';
import ZoneTable from '../../../components/ZoneTable.astro';

const title = 'Пример задачи: замена лифтового оборудования в жилом доме';
const description = 'Типовой сценарий: подъём и монтаж нового лифтового блока в многоквартирном доме — расчёт вылета во дворе, шумовые ограничения.';

// Волна 39: карточка параметров сценария. Ни одного нового факта — класс
// техники, условие площадки и нормативные реквизиты уже названы на этой же
// странице (подзаголовок над H1, разделы ниже и блок «Источники»). Таблица
// собирает их в одном месте с подписями столбцов: и человеку, и языковой
// модели, которая цитирует страницу в ответе, не приходится вытаскивать эти
// значения из середины абзацев (критерий рубрикатора geo-table-present).
const caseRows = [
  ['Техника в сценарии', 'Автокран 25 т'],
  ['Что делает задачу нетиповой', 'Работа во дворе жилого дома, в котором живут люди'],
  ['Что определяет исход', 'Две нормы сразу: допуск подъёмного сооружения и режим тишины во дворе'],
  ['Норма, по которой это считается', 'ФНП №461 (ред. от 16.04.2026): п. 108 — площадка и уклон, п. 110 — выносные опоры, п. 111 — откос выемки, п. 112 — 30 м до провода; Закон г. Москвы от 12.07.2002 №42 и ст. 3.13 КоАП города Москвы — запрет шумных работ с 23:00 до 07:00'],
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Примеры задач', item: 'https://moskran-servis.ru/keysy/' },
    { '@type': 'ListItem', position: 3, name: 'Замена лифта', item: 'https://moskran-servis.ru/keysy/zamena-lifta-zhiloy-dom/' },
  ],
};
---
<BaseLayout title={title} description={description} path="/keysy/zamena-lifta-zhiloy-dom/" ldExtra={[breadcrumbLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/keysy/">Примеры задач</a><span>/</span><span>Замена лифта</span>
  </nav>
  <section class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Пример задачи · автокран 25 т</span>
    <h1 style="margin:14px 0 8px">Замена лифтового оборудования в жилом доме</h1>
    <p style="color:var(--muted);font-size:var(--t-md);margin-bottom:24px">Иллюстративный сценарий — не описание конкретного выполненного объекта.</p>
    <p style="margin-bottom:24px">Короткий ответ: по технике задача закрывается автокраном 25 т, а определяют её две нормы сразу — допуск подъёмного сооружения и режим тишины во дворе жилого дома с 23:00 до 07:00.</p>

    <h2 style="margin-bottom:14px">Задача</h2>
    <p>Демонтаж старой лифтовой кабины и подъём нового лифтового блока через технологический проём в шахте многоквартирного дома советской постройки — регулярный сценарий при программе капитального ремонта жилого фонда. Двор дома тесный, часть проезда занята парковкой жильцов.</p>

    <ZoneTable
      caption="Параметры сценария"
      columns={['Параметр', 'Значение в этом сценарии']}
      rows={caseRows}
    />

    <h2 style="margin:32px 0 14px">Расчёт техники</h2>
    <p>Вес нового лифтового блока — порядка 2–3 тонн, но кран не может подъехать вплотную к нужному фасаду из-за припаркованных машин и небольшой площади двора — реальный вылет составляет около 10–11 метров. На таком вылете даже 16-тонного класса было бы достаточно по чистой грузоподъёмности, но выбран 25-тонный кран — с учётом того, что часть дворов такого типа требует установки на неполные опоры из-за ограниченного пространства, что снижает фактическую грузоподъёмность техники относительно паспортного максимума.</p>

    <h2 style="margin:32px 0 14px">Особенности, которые важны на практике</h2>
    <ul>
      <li>Согласование с управляющей компанией дома об освобождении части парковочных мест на день работ — без этого кран может не найти точку установки вообще.</li>
      <li>Демонтаж старой кабины — отдельный подъём в начале работ, отличается от подъёма нового блока направлением движения груза и часто большей неопределённостью фактического веса изношенного оборудования.</li>
      <li>Работы планируются на дневное время буднего дня — в жилой застройке действуют ограничения по шуму, монтажные работы с использованием крана не проводят рано утром или поздно вечером.</li>
    </ul>

    <h2 style="margin:32px 0 14px">Итог</h2>
    <p>Небольшой по абсолютному весу груз (2–3 тонны) не означает автоматически минимальный класс техники — стеснённость двора и необходимость работы на неполных опорах определили выбор 25-тонного, а не 16-тонного крана, несмотря на то что паспортной грузоподъёмности младшего класса формально хватило бы на полных опорах.</p>
  </section>
  <section class="section wrap prose" style="padding-top:0;max-width:820px">
    <h2 style="margin-bottom:16px">Две нормы, которые определяют этот сценарий</h2>
    <p>Первая — про опоры. Работа на неполных опорах возможна только тогда, когда такой режим предусмотрен руководством (инструкцией) по эксплуатации конкретной машины; при отсутствии таких требований кран устанавливается на все выносные опоры. Поэтому фраза «во дворе поставим на две опоры» проверяется не по опыту оператора, а по руководству, и если режим не предусмотрен — двор освобождают под полное опирание либо меняют точку установки.</p>
    <p>Вторая — про время. В Москве шумные строительные и погрузочно-разгрузочные работы в жилой застройке ограничены с 23:00 до 07:00; ответственность за нарушение установлена статьёй 3.13 КоАП города Москвы, для юридических лиц это от 40 до 80 тысяч рублей. Отсюда дневное окно буднего дня, а не «когда двор свободнее».</p>
    <p>Демонтаж старой кабины подчиняется общему правилу для демонтажа: фактическая масса изношенного оборудования известна хуже, чем масса нового блока по паспорту, поэтому расчёт ведётся по верхней границе и с запасом.</p>
    <p style="margin-top:18px">Проверить, какие из этих позиций уже закрыты по вашему объекту, можно в <a href="/proverka-dokumentov/" style="color:var(--yellow)">чек-листе допуска</a>; сами нормы разобраны в <a href="/spravochnik/" style="color:var(--yellow)">справочнике</a>.</p>
    <Sources
      checked="12.08.2026"
      items={[
        { text: 'Приказ Ростехнадзора от 26.11.2020 №461 (ред. от 16.04.2026): п. 108 — площадка и уклон, п. 110 — выносные опоры, п. 111 — откос выемки, п. 112 — 30 м до провода и наряд-допуск, п. 138 — пуск в работу, п. 165 — периодичность освидетельствования, п. 189 — запись в паспорт', href: 'https://www.consultant.ru/document/cons_doc_LAW_373321/' },
        { text: 'Закон г. Москвы от 12.07.2002 №42 и ст. 3.13 КоАП города Москвы — запрет шумных работ с 23:00 до 07:00 и размер штрафа' },
      ]}
    />
  </section>
</main>
</BaseLayout>
