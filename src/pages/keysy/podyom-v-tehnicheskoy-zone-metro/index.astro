---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Sources from '../../../components/Sources.astro';
import ZoneTable from '../../../components/ZoneTable.astro';

const title = 'Пример задачи: кран в технической зоне метрополитена';
const description = 'Автокран в 18 метрах от тоннеля метро — согласование с метрополитеном и мониторинг вместо разового письма, как у ЛЭП или газопровода.';

// Волна 39: карточка параметров сценария. Ни одного нового факта — класс
// техники, условие площадки и нормативные реквизиты уже названы на этой же
// странице (подзаголовок над H1, разделы ниже и блок «Источники»). Таблица
// собирает их в одном месте с подписями столбцов: и человеку, и языковой
// модели, которая цитирует страницу в ответе, не приходится вытаскивать эти
// значения из середины абзацев (критерий рубрикатора geo-table-present).
const caseRows = [
  ['Техника в сценарии', 'Автокран 40 т'],
  ['Что делает задачу нетиповой', 'Техническая зона метрополитена под площадкой'],
  ['Что определяет исход', 'Одного письма недостаточно: порядок согласования отличается от разового разрешения сетевой организации'],
  ['Норма, по которой это считается', 'Приказ Председателя Москомархитектуры от 13.03.2006 №52 и Правила использования технических и охранных зон метрополитена; СП 120.13330.2022 «Метрополитены»; СанПиН 1.2.3685-21'],
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Примеры задач', item: 'https://moskran-servis.ru/keysy/' },
    { '@type': 'ListItem', position: 3, name: 'Кран в технической зоне метрополитена', item: 'https://moskran-servis.ru/keysy/podyom-v-tehnicheskoy-zone-metro/' },
  ],
};
---
<BaseLayout title={title} description={description} path="/keysy/podyom-v-tehnicheskoy-zone-metro/" ldExtra={[breadcrumbLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/keysy/">Примеры задач</a><span>/</span><span>Кран в технической зоне метрополитена</span>
  </nav>
  <section class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Пример задачи · автокран 40 т · техническая зона метрополитена</span>
    <h1 style="margin:14px 0 8px">Кран в технической зоне метрополитена: когда мало одного письма</h1>
    <p style="color:var(--muted);font-size:var(--t-md);margin-bottom:24px">Иллюстративный сценарий — не описание конкретного выполненного объекта.</p>
    <p style="margin-bottom:24px">Короткий ответ: одного письма недостаточно — работы в технической зоне метрополитена идут по правилам, утверждённым приказом Председателя Москомархитектуры от 13.03.2006 №52, и требуют обследования конструкций, а не разового разрешения сетевой организации.</p>

    <h2 style="margin-bottom:14px">Задача</h2>
    <p>Монтаж технологического оборудования на площадке монолитного жилого дома. По проекту одна из точек установки выносных опор автокрана 40 т оказывается примерно в 18 метрах от внешнего контура тоннеля действующей линии метро мелкого заложения — расстояние, которое на глаз выглядит безопасным, но на топографическом плане площадки прямо накладывается на техническую зону метрополитена. В отличие от воздушной линии или подземной трубы, здесь ничего не видно на поверхности и ничего физически не задевается стрелой или опорой — и именно поэтому этот пункт проверки чаще всего пропускают на этапе приёма заявки.</p>

    <ZoneTable
      caption="Параметры сценария"
      columns={['Параметр', 'Значение в этом сценарии']}
      rows={caseRows}
    />

    <h2 style="margin:32px 0 14px">Расчёт и согласование</h2>
    <p>Техническая зона метрополитена — не придомовая формальность, а отдельный вид городской территории по приказу Москомархитектуры от 13.03.2006 №52: 40 метров в обе стороны от внешнего контура сооружений для действующих линий, 20 метров — для проектируемых и строящихся. Расчётная точка опоры в нашем сценарии — 18 метров — попадает внутрь этой зоны, значит, установка требует согласования с ГУП «Московский метрополитен», а по типу сооружений (в зависимости от того, к чьему ведению относится конкретный участок трассы) — ещё и с профильной проектной организацией, «Метрогипротрансом» или «Мосинжпроектом». Если бы опора оказалась ближе 10 метров от контура тоннеля, порядок производства работ пришлось бы оформлять не письмом, а отдельным совместным приказом заказчика и эксплуатирующей организации метрополитена — на согласование такого документа закладывается заметно больше времени, чем на обычное разрешение.</p>
    <p>Мы направили в метрополитен схему расположения крана с нагрузками на каждую опору и планируемыми датами работ и параллельно уточнили у генподрядчика, к какой из двух проектных организаций относится этот участок трассы, — без этого запрос уходит не по адресу и цикл согласования начинается заново.</p>

    <h2 style="margin:32px 0 14px">Чем это отличается от разового разрешения сетевой организации</h2>
    <p>У газопровода и теплотрассы из соседних примеров логика одна: получил письменное согласие владельца сети на конкретную точку — вопрос закрыт до конца работ. С метрополитеном программа шире. Действующий свод правил СП 120.13330.2022 «Метрополитены» требует геодезического и маркшейдерского контроля осадок грунта и деформаций сооружений при строительстве по соседству — то есть не разовой бумаги, а наблюдения, растянутого на весь период, пока площадка нагружает территорию рядом с тоннелем. На практике это оборачивается двумя дополнительными процедурами, которых нет ни у ЛЭП, ни у сетей: обследованием фактического состояния конструкций метро специализированной организацией до начала работ и мониторингом виброакустической обстановки с экспертным заключением Роспотребнадзора — эквивалентный уровень шума в жилых и служебных помещениях по СанПиН 1.2.3685-21 не должен превышать в дневное время 40 дБА, и это тот норматив, из которого исходит заключение.</p>

    <h2 style="margin:32px 0 14px">Особенности, которые важны на практике</h2>
    <ul>
      <li>Риск здесь не в моменте — не задели провод, не пробили трубу, — а в накопленной статической и вибрационной нагрузке площадки на грунт вокруг тоннеля, поэтому контроль не заканчивается с получением одного письма, а идёт параллельно самим работам.</li>
      <li>40-метровая граница отсчитывается от фактического внешнего контура сооружений, а не от условной оси линии на схеме — на изогнутых участках трассы это может дать другой результат, чем прямая линия на топоплане площадки.</li>
      <li>Тот же порядок согласования действует и при статичной установке опоры на подкладку без вскрытия грунта — точно так же, как и у охранных зон газопровода или теплосети, только с другим порогом расстояния и другим кругом согласующих организаций.</li>
    </ul>

    <h2 style="margin:32px 0 14px">Итог</h2>
    <p>Попадание точки установки крана в техническую зону метрополитена не отменяет расчёт вылета и нагрузки на опору — он считается как обычно. Но по срокам это самая длинная из процедур допуска на нашем сайте: вместо одного письма — обследование конструкций, согласование сразу с двумя организациями и мониторинг, который не прекращается с началом монтажа. Выяснять, попадает ли площадка в 40-метровую зону, стоит на этапе приёма заявки по топоплану, а не после того, как техника уже подтверждена на дату.</p>
  </section>
  <section class="section wrap prose" style="padding-top:0;max-width:820px">
    <h2 style="margin-bottom:16px">Норма, по которой это считается</h2>
    <p>Ширину технической зоны и порог совместного приказа задаёт приказ Москомархитектуры от 13.03.2006 №52 «О введении Правил использования территорий технических и охранных зон метрополитена в городе Москве». Требование геодезического и маркшейдерского контроля деформаций при строительстве рядом с действующими линиями — из свода правил СП 120.13330.2022 «Метрополитены» (актуализированная редакция СНиП 32-02-2003). Норматив шума для виброакустического мониторинга — СанПиН 1.2.3685-21, раздел о допустимых уровнях звука в жилых и общественных зданиях.</p>
    <p>Похожая по механике, но по другому типу городской инфраструктуры ситуация — в примерах <a href="/keysy/podyom-ryadom-s-lep/" style="color:var(--yellow)">«Подъём рядом с ЛЭП»</a>, <a href="/keysy/podyom-ryadom-s-gazoprovodom/" style="color:var(--yellow)">«Кран рядом с газопроводом»</a> и <a href="/keysy/podyom-ryadom-s-teplotrassoy/" style="color:var(--yellow)">«Кран рядом с теплотрассой»</a> — там во всех трёх случаях вопрос закрывает одно письмо владельца сети, а не программа обследования и мониторинга. Как этот же вопрос сдвигает срок по конкретному московскому округу — на примере территории ЗИЛа в Нагатинском Затоне — на странице услуги <a href="/uslugi/bashennyy-kran/yuao/" style="color:var(--yellow)">«Башенный кран: ЮАО»</a>. Общий порядок оформления пропуска на объект, в том числе про техническую зону метрополитена, — на странице <a href="/documents/propusk-na-obekt/" style="color:var(--yellow)">«Оформление пропуска на объект»</a>. Проверить, какие документы по вашему объекту уже закрыты, можно в <a href="/proverka-dokumentov/" style="color:var(--yellow)">чек-листе допуска</a>.</p>
    <Sources
      checked="19.08.2026"
      items={[
        { text: 'v2b.ru — приказ Председателя Москомархитектуры от 13.03.2006 №52 и Правила использования территорий технических и охранных зон метрополитена в Москве', href: 'https://www.v2b.ru/documents/prikaz-predsedatelya-moskomarhitektury-ot-13-03-2006-52/' },
        { text: 'Минстрой России — СП 120.13330.2022 «СНиП 32-02-2003 Метрополитены» (утверждён приказом от 27.12.2022 №1131/пр)', href: 'https://minstroyrf.gov.ru/docs/306920/' },
        { text: 'arakis.su — требования к обследованию конструкций метро, виброакустическому мониторингу и согласованию с ГУП «Московский метрополитен» и профильными проектными организациями при строительстве в технической зоне', href: 'https://arakis.su/articles/transportnye-linii-metropolitena/' },
        { text: 'КонсультантПлюс — СанПиН 1.2.3685-21, допустимые уровни звука в жилых и общественных зданиях: дневной эквивалентный уровень 40 дБА', href: 'https://www.consultant.ru/document/cons_doc_LAW_381809/' },
      ]}
      note="Сценарий иллюстративный: конкретный адрес, дата и участники не приводятся. Ширина зон (40/20/10 м) и норма СП 120.13330.2022 — действующие; формулировка «совместный приказ» для работ ближе 10 м и разделение согласующих проектных организаций по типу сооружений приведены по вторичному источнику (v2b.ru, arakis.su), поскольку у самого приказа №52 нет стабильной бесплатной публичной ссылки — при спорной площадке точный круг согласующих уточняется индивидуально через ГУП «Московский метрополитен»."
    />
  </section>
</main>
</BaseLayout>
