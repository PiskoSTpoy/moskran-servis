---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Sources from '../../../components/Sources.astro';
import ZoneTable from '../../../components/ZoneTable.astro';

const title = 'Пример задачи: кран на перекрытии подземного паркинга';
const description = 'Иллюстративный сценарий: опоры автокрана на плите паркинга — точечная нагрузка выше расчётной для стоянки, нужен поверочный расчёт, а не изыскания грунта.';

// Волна 39: карточка параметров сценария. Ни одного нового факта — класс
// техники, условие площадки и нормативные реквизиты уже названы на этой же
// странице (подзаголовок над H1, разделы ниже и блок «Источники»). Таблица
// собирает их в одном месте с подписями столбцов: и человеку, и языковой
// модели, которая цитирует страницу в ответе, не приходится вытаскивать эти
// значения из середины абзацев (критерий рубрикатора geo-table-present).
const caseRows = [
  ['Техника в сценарии', 'Автокран 32 т'],
  ['Что делает задачу нетиповой', 'Опоры встают не на грунт, а на плиту перекрытия подземного паркинга'],
  ['Что определяет исход', 'Расчётный предел плиты из проектной документации паркинга, а не несущая способность грунта'],
  ['Норма, по которой это считается', 'СП 20.13330.2016, таблица 8.4 (для техники тяжелее 16 т табличного значения нет); ФНП №461, п. 110; постановление Правительства Москвы от 05.08.2026 №2118-ПП'],
];

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Примеры задач', item: 'https://moskran-servis.ru/keysy/' },
    { '@type': 'ListItem', position: 3, name: 'Опоры на перекрытии паркинга', item: 'https://moskran-servis.ru/keysy/opory-na-perekrytii-parkinga/' },
  ],
};
---
<BaseLayout title={title} description={description} path="/keysy/opory-na-perekrytii-parkinga/" ldExtra={[breadcrumbLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/keysy/">Примеры задач</a><span>/</span><span>Опоры на перекрытии паркинга</span>
  </nav>
  <section class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">Пример задачи · автокран 32 т · перекрытие подземного паркинга</span>
    <h1 style="margin:14px 0 8px">Кран на перекрытии подземного паркинга: почему это не вопрос грунта</h1>
    <p style="color:var(--muted);font-size:var(--t-md);margin-bottom:24px">Иллюстративный сценарий — не описание конкретного выполненного объекта.</p>
    <p style="margin-bottom:24px">Короткий ответ: несущая способность грунта здесь ни при чём — считать надо расчётный предел самой плиты, а для техники тяжелее 16 т таблица 8.4 СП 20.13330.2016 типового значения не даёт вовсе и отправляет к заданию на проектирование.</p>

    <h2 style="margin-bottom:14px">Задача</h2>
    <p>Точка постановки автокрана по проекту производства работ приходится не на грунт, а на плиту перекрытия уже построенного подземного паркинга — например, кран должен встать на будущем дворовом пространстве жилого комплекса, под которым на минус первом-втором уровне готов паркинг, а благоустройство сверху ещё не сделано. Стандартный вопрос заказчика в такой ситуации — «а выдержит ли перекрытие», и стандартная ошибка — искать ответ в тех же терминах, что и для обычного грунта.</p>

    <ZoneTable
      caption="Параметры сценария"
      columns={['Параметр', 'Значение в этом сценарии']}
      rows={caseRows}
    />

    <h2 style="margin:32px 0 14px">Расчёт и почему грунтовая логика здесь не работает</h2>
    <p>Несущая способность грунта — величина, которую оценивают инженерными изысканиями на конкретном пятне, и она может отличаться в соседних точках одной площадки. Плита перекрытия паркинга устроена иначе: это готовая инженерная конструкция с расчётным пределом, заложенным ещё на этапе проектирования самого паркинга, и этот предел один на весь пролёт, а не индивидуален для каждой точки постановки.</p>
    <p>По СП 20.13330.2016 (таблица 8.4) нормативная нагрузка на перекрытие автостоянки для легковых автомобилей — 3,5 кПа распределённой и 20,0 кН сосредоточенной нагрузки; для проезда легковых — 5,0 кПа и 25,0 кН; для стоянки грузовиков массой 3–16 т — уже 5,0 кПа и 90,0 кН. А для техники тяжелее 16 т норма прямо говорит: «нагрузка принимается по заданию на проектирование» — то есть типового табличного значения для этой категории попросту нет, каждый случай считается индивидуально.</p>
    <p>Гружёный автокран на одной выносной опоре создаёт точечную нагрузку на площадке контакта в несколько десятков сантиметров — кратно выше, чем расчёт, заложенный для легкового автомобиля, под который изначально проектировали перекрытие. Поэтому здесь не работает бытовая логика «раз паркинг держит машины — выдержит и кран»: паркинг спроектирован на распределённый вес легковых и части грузового транспорта, а не на сосредоточенную нагрузку от подъёмного сооружения в одной точке.</p>

    <h2 style="margin:32px 0 14px">Чем это отличается от мягкого грунта завода</h2>
    <p>У этой задачи есть сосед на нашем сайте — разбор монтажа на неподготовленной территории завода, где гусеничный кран выигрывает у автокрана именно за счёт распределения нагрузки по ходовой части. Разница между тем случаем и этим принципиальная. Грунт — переменная величина, которую можно улучшить подготовкой (отсыпка, инвентарные плиты) или обойти сменой типа ходовой части. Плита перекрытия — фиксированная конструкция с уже посчитанным пределом; она не становится прочнее от того, что под опору подложили распределительную плиту, — подкладка снижает удельное давление в пятне контакта, но не поднимает расчётный предел самой плиты. Если предел меньше нагрузки от опоры даже с распределением, вопрос решается не подготовкой площадки, а либо более лёгкой машиной, либо переносом точки установки туда, где под плитой есть усиление — обычно это зона над колонной или несущей стеной паркинга, а не середина пролёта.</p>
    <p>Тема не абстрактная, и в ближайшие годы будет встречаться на московских объектах чаще. С 5 августа 2026 года действует постановление Правительства Москвы №2118-ПП: норматив машино-мест теперь привязан к площади квартир (от 0,8 до 1,6 места в зависимости от метража) и почти вдвое поднимает требуемую обеспеченность паркингом в проектах массового сегмента. Там, где раньше хватало двух подземных уровней, застройщикам придётся заглубляться на четыре и больше, — а значит, площадь готовых плит перекрытия, на которые впоследствии может встать кран для последующих очередей строительства или для благоустройства двора, будет расти вместе с этим нормативом, а не наоборот.</p>

    <h2 style="margin:32px 0 14px">Особенности, которые важны на практике</h2>
    <ul>
      <li>Расчётный предел плиты берём из проектной документации паркинга у технического заказчика — это не наша зона ответственности по умолчанию, но без этой цифры сравнивать нагрузку не с чем.</li>
      <li>Инвентарные подкладки под выносные опоры (требование пункта 110 ФНП №461) здесь работают так же, как на грунте: распределяют нагрузку по большей площади и снижают удельное давление, но не заменяют собой поверочный расчёт самой плиты.</li>
      <li>Если паркинг уже полностью готов и сверху устроена гидроизоляция под будущее благоустройство, риск точечного повреждения мембраны есть даже при формально допустимой нагрузке — под подкладку в этом случае добавляют защитный настил.</li>
      <li>Точку установки крана по возможности смещаем к колонне или несущей стене паркинга, а не в центр пролёта: запас несущей способности там обычно выше, хотя это не отменяет необходимость поверочного расчёта.</li>
    </ul>

    <h2 style="margin:32px 0 14px">Итог</h2>
    <p>«Перекрытие держит машины — значит, выдержит и кран» — предположение, которое можно потерять вместе с самой плитой. Автокран на паркинге — это не вопрос грунта и не вопрос подготовки площадки, а вопрос конкретного расчётного предела конкретной плиты, который есть в проектной документации и должен быть сверен до выбора модели крана, а не после того, как техника уже подтверждена на дату.</p>
  </section>
  <section class="section wrap prose" style="padding-top:0;max-width:820px">
    <h2 style="margin-bottom:16px">Норма, по которой это считается</h2>
    <p>Нормативные значения нагрузок на перекрытия и покрытия автостоянок — таблица 8.4 СП 20.13330.2016 «Нагрузки и воздействия» (актуализированная редакция СНиП 2.01.07-85*). Требования к установке подъёмного сооружения на выносные опоры и к применению инвентарных подкладок — Приказ Ростехнадзора от 26.11.2020 №461 (ред. от 16.04.2026), пункт 110 — тот же пункт, на который мы ссылаемся в разборе монтажа на мягком грунте завода. Рост норматива по глубине и объёму подземного паркинга в новых московских проектах — постановление Правительства Москвы от 05.08.2026 №2118-ПП.</p>
    <p>Похожая по формулировке, но принципиально другая по физике задача — работа автокрана на территории завода на мягком грунте, а не на плите паркинга: там опору держит грунт, а не инженерная конструкция, и логика подготовки площадки другая — разбор в примере <a href="/keysy/montazh-oborudovaniya-zavod/" style="color:var(--yellow)">«Монтаж тяжёлого оборудования на территории завода на мягком грунте»</a>. Как считается допустимая нагрузка под опорами на естественном грунте — на странице справочника <a href="/spravochnik/nesushchaya-sposobnost-grunta/" style="color:var(--yellow)">«Несущая способность грунта»</a>. Полный комплект документов на кран и оператора, который может понадобиться техническому заказчику при согласовании поверочного расчёта, — на странице <a href="/documents/dokumenty-na-tehniku-i-operatora/" style="color:var(--yellow)">«Документы на технику и оператора»</a>. Проверить, какие позиции по вашему объекту уже закрыты, можно в <a href="/proverka-dokumentov/" style="color:var(--yellow)">чек-листе допуска</a>.</p>
    <Sources
      checked="21.08.2026"
      items={[
        { text: 'СП 20.13330.2016 «Нагрузки и воздействия» (актуализированная редакция СНиП 2.01.07-85*) — таблица 8.4, нормативные нагрузки на перекрытия автостоянок', href: 'https://docs.cntd.ru/document/456044318' },
        { text: 'gostcheck.ru — сводные значения таблицы 8.4 СП 20.13330.2016 по категориям транспорта', href: 'https://gostcheck.ru/sp/sp-20-13330-2016/table/sp-20-13330-2016-table-8-4' },
        { text: 'Коммерсантъ — постановление Правительства Москвы от 05.08.2026 №2118-ПП: новый норматив машино-мест и требование к глубине подземного паркинга', href: 'https://www.kommersant.ru/doc/8889753' },
        { text: 'КонсультантПлюс — Приказ Ростехнадзора от 26.11.2020 №461 (ред. от 16.04.2026), пункт 110', href: 'https://www.consultant.ru/document/cons_doc_LAW_373321/' },
      ]}
      note="Точные числовые значения таблицы 8.4 приведены по вторичному источнику (gostcheck.ru): прямой текст СП 20.13330.2016 на docs.cntd.ru отдаётся только после партнёрской авторизации. Цифры внутренне непротиворечивы (нагрузка предсказуемо растёт с массой транспорта в каждой следующей категории) и совпадают по порядку величины с независимыми обсуждениями на форуме проектировщиков (forum.dwg.ru), что снижает риск ошибки суммаризатора."
    />
  </section>
</main>
</BaseLayout>
