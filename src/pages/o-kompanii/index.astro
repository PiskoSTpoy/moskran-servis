---
import BaseLayout from '../../layouts/BaseLayout.astro';

const title = 'О компании — МОСКРАН-СЕРВИС';
const description = 'МОСКРАН-СЕРВИС: аренда автокранов и башенного крана в Москве. Кто мы, как работаем и почему сайт честно говорит о том, чего у нас пока нет.';

const team = [
  { role: 'Инженерная служба', desc: 'Отвечает за расчёт грузовысотных характеристик, подбор техники под задачу и содержание технических материалов на сайте — материалов справочника, описаний услуг, ТТХ парка техники.' },
  { role: 'Диспетчерская служба', desc: 'Принимает заявки, согласовывает время подачи техники, координирует оформление пропусков на режимные объекты и нарядов-допусков там, где они требуются.' },
  { role: 'Операторы техники', desc: 'Аттестованные машинисты крана с действующими удостоверениями и допуском по электробезопасности — подробнее о требованиях к аттестации в отдельном разборе справочника.' },
];
const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'О компании', item: 'https://moskran-servis.ru/o-kompanii/' },
  ],
};
---
<BaseLayout title={title} description={description} path="/o-kompanii/" ldExtra={[breadcrumbLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><span>О компании</span>
  </nav>
  <section class="section wrap prose" style="padding-top:8px;max-width:820px">
    <span class="eyebrow">О компании</span>
    <h1 style="margin:14px 0 20px">Кто мы и как работаем</h1>

    <p>МОСКРАН-СЕРВИС — сервис аренды автокранов грузоподъёмностью 16–50 тонн и башенного крана в Москве. Мы новый проект: сайт строится с нуля, и мы сознательно не стали заполнять его тем, чего у нас пока фактически нет — вымышленными сотрудниками с придуманными именами и фотографиями, накрученными отзывами или красивыми, но недостоверными цифрами. Ниже — честно о том, что есть на самом деле.</p>

    <h2 style="margin:32px 0 14px">Что мы делаем</h2>
    <p>Подбираем и подаём автокраны грузоподъёмностью 16–50 тонн и башенный кран для объектов в Москве — с расчётом вылета стрелы и грузовысотной характеристики под конкретную задачу, а не «на глаз». Работаем с типовыми городскими задачами (разгрузка, монтаж, демонтаж, подача материалов) и с более специфичными случаями — режимные объекты с пропускным режимом, работа рядом с воздушными линиями электропередач, площадки со слабым грунтом. Разборы этих случаев — в справочнике и в разделе примеров задач.</p>

    <h2 style="margin:32px 0 14px">Как устроена команда</h2>
    <p>Мы описываем команду по функциональным ролям, а не именами и фотографиями конкретных людей — это сознательное решение, а не недоработка: мы не публикуем вымышленных сотрудников с придуманными биографиями, характерными для многих сайтов в этой нише.</p>
    <div class="team-grid">
      {team.map((t) => (
        <div class="team-card box">
          <h3>{t.role}</h3>
          <p>{t.desc}</p>
        </div>
      ))}
    </div>

    <h2 style="margin:32px 0 14px">Почему на сайте нет отзывов, фото офиса и реальных кейсов с адресами</h2>
    <p>Потому что любой из этих блоков пришлось бы сочинить. Проект новый, заказов через сайт пока не было — значит, нет и клиентов, чьи оценки можно показать. Оценки появятся тогда, когда появится, на что сослаться: карточка организации в картографическом сервисе с настоящими отзывами настоящих людей. Ни днём раньше. То же и с фотографиями: стоковые снимки чужой техники под видом своего парка — это не «оформление сайта», а неверные данные о том, что приедет на объект. В разделе «Примеры задач» лежат расчётные сценарии — как подбирается техника под типовую московскую задачу; они помечены как разбор логики, а не как отчёт о выполненных объектах с адресами и датами.</p>

    <h2 style="margin:32px 0 14px">Документы и реквизиты</h2>
    <p>Регистрационные данные и полисы мы не выкладываем авансом: показывать документ, которого на момент публикации ещё не существует, — то же самое, что нарисовать отзыв. При заявке называем фактический статус прямо, без формулировок вроде «всё оформляется». Что именно требуется по московскому адресу — от ордера на установку временных ограждений до согласования в технической зоне метрополитена — разобрано на странице <a href="/documents/" style="color:var(--yellow)">«Документы»</a>.</p>

    <h2 style="margin:32px 0 14px">Нормативная база, по которой мы работаем</h2>
    <p>Действующие Федеральные нормы и правила промышленной безопасности (Приказ Ростехнадзора №461 от 26.11.2020) — не отменённые ещё в 2014 году ПБ 10-382-00, на которые по инерции продолжают ссылаться некоторые подрядчики в нише. Подробный разбор истории этого перехода — в <a href="/spravochnik/fnp-461-chto-izmenilos/" style="color:var(--yellow)">разборе справочника</a>.</p>
  </section>
  <section class="section wrap"><a class="btn" href="/#zayavka">Оставить заявку →</a></section>
</main>
<style>
  .team-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin: 20px 0; }
  .team-card { padding: 22px; }
  .team-card h3 { font-size: 1rem; text-transform: none; }
  .team-card p { margin-top: 10px; color: var(--muted); font-size: var(--t-md); }
  @media (max-width: 800px) { .team-grid { grid-template-columns: 1fr; } }
</style>
</BaseLayout>
