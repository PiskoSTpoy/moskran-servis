---
// ─────────────────────────────────────────────────────────────────────────────
// ГЛАВНАЯ. Волна 16 — смена архетипа.
//
// Было: hero + 21 секция лендинга (полоса доверия, бегущая строка, счётчики,
// квиз, шаги 01–04, FAQ, форма) — то есть эталонный скелет сети, с которого
// списаны остальные восемь сайтов.
//
// Стало: ЭКРАН ПОИСКА ПО СПРАВОЧНИКУ. Порядок чтения перевёрнут: сначала норма,
// потом техника, потом заявка. Коммерческая часть — один компактный блок внизу.
// Ни бегущей строки, ни stat-bar/trust-bar, ни шагов 01–04, ни hero-иллюстрации:
// у сайта-справочника этих компонентов нет вообще.
//
// Поиск работает по ПРЕДМЕТНОМУ УКАЗАТЕЛЮ (термин → материал), а не по заголовкам:
// человек ищет «наряд-допуск» и «браковка каната», а не «Разбор для заказчика».
// Индекс собирается из src/lib/spravochnik.ts на этапе сборки — без запросов,
// без внешних библиотек, при выключенном JS виден целиком.
// ─────────────────────────────────────────────────────────────────────────────
import BaseLayout from '../layouts/BaseLayout.astro';
import Sources from '../components/Sources.astro';
import PriceDisclaimer from '../components/PriceDisclaimer.astro';
import { PRICES_VALID_UNTIL } from '../lib/prices';
import { TERM_LETTERS, TERMS, ENTRIES, DOCS, OBJECTS, ROLES } from '../lib/spravochnik';

const title = 'Справочник по крановым работам: ФНП №461, допуски — Москва';
const description = 'Поиск по нормам крановых работ: ФНП №461, освидетельствование, наряд-допуск у ЛЭП, стропы, канаты, роли на площадке. А–Я и что изменилось в нормах.';

const CHECKED = '12.08.2026';

// Волна 124. Согласование числительного: в лиде стояло «Здесь 53 разборов», в
// подсказке — «127 терминов ведут на 53 материалов». Обе формы неверны (53 →
// «разбора», «материала»), и обе стоят на первом экране, где текст читается
// за две секунды и любая ошибка согласования выглядит как небрежность.
// Хардкодить правильную форму нельзя: число берётся из ENTRIES и меняется
// вместе со справочником — поэтому форма выбирается правилом.
const plural = (n: number, one: string, few: string, many: string) => {
  const d = n % 10;
  const dd = n % 100;
  if (d === 1 && dd !== 11) return one;
  if (d >= 2 && d <= 4 && (dd < 12 || dd > 14)) return few;
  return many;
};

// Якорь буквы: id и href обязаны совпадать и не содержать символов, которые
// придётся кодировать в адресной строке. «0–9» превращается в «0-9», кириллица
// остаётся как есть (браузеры её кодируют корректно, и в закладке она читаема).
const anchor = (letter: string) => letter.replace('–', '-');

// «Что изменилось в нормах» — только проверенные 12.08.2026 факты с реквизитами.
// Каждая строка обязана отвечать на вопрос «и что мне с этим делать», иначе это
// новостная лента, а не справочник.
const changes = [
  {
    when: '8 июня 2026',
    what: 'ФНП №461 действует в редакции от 16.04.2026 (приказ Ростехнадзора от 16.04.2026 №129).',
    todo: 'Если в договоре или регламенте подрядчика документ назван «в редакции 2024 года» — редакция устарела. Перечень правок этой редакции в открытых источниках на дату проверки не раскрыт, поэтому мы фиксируем только сам факт новой редакции и не пересказываем её содержание.',
    href: '/spravochnik/fnp-461-chto-izmenilos/',
  },
  {
    when: '1 сентября 2025',
    what: 'Правила по охране труда при погрузочно-разгрузочных работах и размещении грузов (приказ Минтруда России от 28.10.2020 №753н) действуют в редакции от 29.04.2025 и рассчитаны до 1 сентября 2027 года.',
    todo: 'Это и есть действующая замена ПОТ РМ-007-98. Ссылка на ПОТ РМ-007-98 в инструкции или в договоре означает недействующий документ.',
    href: '/spravochnik/pot-rm-007-98/',
  },
  {
    when: '1 сентября 2024',
    what: 'Приказом Ростехнадзора от 22.01.2024 №16 из ФНП №461 исключены пункты 143–145 — процедура постановки подъёмного сооружения на учёт с присвоением учётного номера.',
    todo: 'Требовать «учётный номер ПС» в комплекте документов больше не на чем. Регистрация самого опасного производственного объекта в реестре — осталась, и экспертиза промышленной безопасности тоже: обязанность закреплена другими пунктами тех же Правил.',
    href: '/spravochnik/registraciya-krana-rostehnadzor/',
  },
  {
    when: 'действующая норма',
    what: 'Порог по напряжению у воздушной линии — «более 50 В» (ФНП №461, п. 112), а не «42 В», как пишут в отраслевых статьях.',
    todo: 'Цифра 42 В пришла из ПОТ РМ-007-98, прекративших действие. Для крана считается расстояние менее 30 м до крайнего провода — тогда работа только по наряду-допуску.',
    href: '/spravochnik/rabota-krana-ryadom-s-lep/',
  },
  {
    when: '7 марта 2014',
    what: 'Отменены ПБ 10-382-00 «Правила устройства и безопасной эксплуатации грузоподъёмных кранов».',
    todo: 'Двенадцать лет спустя ссылка на ПБ 10-382-00 всё ещё встречается в типовых договорах аренды крана. Это самый быстрый признак того, что документы подрядчика не обновлялись.',
    href: '/spravochnik/fnp-461-chto-izmenilos/',
  },
];

// Компактная коммерческая часть. Формулу расчёта и ставки перенесли из
// пошагового визарда БЕЗ пересчёта: ставка/час × 8 часов × смены, ×1.12 при
// пропускном режиме. Изменилась только подача — один экран вместо двух шагов.
const rates = [
  { t: '16–20 т', v: 2200 },
  { t: '25 т', v: 2600 },
  { t: '32 т', v: 3100 },
  { t: '50 т', v: 3900 },
];
// Волна 124. Две цифры для полосы ставки на первом экране. Обе ВЫЧИСЛЯЮТСЯ из
// того же массива rates, что и калькулятор ниже, — отдельного числа «на глаз»
// на странице не появляется и разойтись с калькулятором физически не может.
// minShift — это ровно то «от 17 600 ₽», которое калькулятор показывает
// значением по умолчанию (ставка × 8 часов × 1 смена).
const minRate = Math.min(...rates.map((r) => r.v));
const minShift = minRate * 8;

const services = [
  { href: '/uslugi/arenda-avtokrana-16-25-tonn/', name: 'Автокран 16–25 т', note: 'разгрузка, лёгкий монтаж, подача материалов' },
  { href: '/uslugi/arenda-avtokrana-25-40-tonn/', name: 'Автокран 25–40 т', note: 'тяжёлые ЖБИ, увеличенный вылет' },
  { href: '/uslugi/arenda-avtokrana-40-50-tonn/', name: 'Автокран 40–50 т', note: 'крупногабарит, согласование маршрута' },
  { href: '/uslugi/kran-na-rezhimnyy-obekt/', name: 'Кран на режимный объект', note: 'пропуск на технику и бригаду' },
  { href: '/uslugi/bashennyy-kran/', name: 'Башенный кран', note: 'монтаж на весь срок стройки' },
  { href: '/uslugi/lyubaya-podyomnaya-tehnika/', name: 'Гусеничный кран, манипулятор, автовышка', note: 'вне нашего профиля — подбираем через партнёрскую сеть' },
];

const okruga = [
  ['cao', 'ЦАО'], ['sao', 'САО'], ['svao', 'СВАО'], ['vao', 'ВАО'], ['yuvao', 'ЮВАО'], ['yuao', 'ЮАО'],
  ['yuzao', 'ЮЗАО'], ['zao', 'ЗАО'], ['szao', 'СЗАО'], ['zelao', 'ЗелАО'], ['tinao', 'ТиНАО'],
];

const collectionLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Справочник по крановым работам',
  description,
  url: 'https://moskran-servis.ru/',
  inLanguage: 'ru-RU',
  isPartOf: { '@id': 'https://moskran-servis.ru/#website' },
  about: DOCS.map((d) => ({ '@type': 'Thing', name: d.full })),
};
---
<BaseLayout title={title} description={description} path="/" ldExtra={[collectionLd]}>
<main>
  <section class="lookup wrap">
    {/* Волна 122 (пилот): фоновое видео hero — распространённый приём отраслевых
        сайтов (video autoplay/muted/loop/playsinline/preload=none/poster/aria-hidden/
        tabindex=-1 позади заголовка + затемняющий scrim), но в СВОЁМ коде и своей
        композиции — не full-bleed на весь экран, как обычно делают, а рамочная
        панель внутри .wrap с жёлтым бордером: сайт нигде больше не выходит за
        wrap, edge-to-edge разрушил бы уже устоявшийся бруталистский язык
        «всё — обведённая коробка» (.lookup__stats, .tool__inner, .pricebar).
        .lookup__media держит postER КАК CSS-ФОН отдельно от <video> — это и есть
        честный prefers-reduced-motion фоллбэк без единой строчки JS: видео
        скрывается медиа-запросом, а фон панели (постер) остаётся на месте сам
        по себе, потому что он не в video, а в background-image контейнера.
        Источник видео/автор/лицензия — Sources в конце страницы + content-plan.md,
        «Волна 122». */}
    <div class="lookup__panel">
      <div class="lookup__media" aria-hidden="true">
        <video class="lookup__video" autoplay muted loop playsinline preload="none" poster="/images/hero/hero-crane-poster.jpg" aria-hidden="true" tabindex="-1">
          <source src="/videos/hero-crane.mp4" type="video/mp4" />
        </video>
        <div class="lookup__scrim"></div>
      </div>
      <div class="lookup__grid">
        <div class="lookup__col">
          <span class="eyebrow">Справочник крановых работ · Москва</span>
          <h1>Найдите норму, а потом уже кран</h1>
          {/* Волна 124. Лид был ОДНИМ абзацем в десять строк (пятнадцать на 320 px)
              и занимал полэкрана телефона сплошной серой стеной — за ним не было
              видно ни поля поиска, ни того, что кран вообще можно заказать.
              Перечисление тем НЕ УДАЛЕНО, а перенесено ниже поля поиска
              (.lookup__topics): там оно и по смыслу уместнее — сначала человек
              видит, что за сайт и сколько стоит кран, потом чем справочник
              наполнен. В лиде остались две фразы исходного текста дословно. */}
          <p class="lookup__lead">Здесь {ENTRIES.length} {plural(ENTRIES.length, 'разбор', 'разбора', 'разборов')} нормативной части крановых работ. Каждый материал привязан к документу и роли на площадке, а не к дате публикации.</p>

          {/* Волна 124 / цена на первом экране. Замер до правки: первое число в
              рублях на главной стояло на 15 350-й точке при высоте страницы
              16 714 — девятнадцатый экран телефона, то есть человек, пришедший
              за ценой крана, не находил её вообще. Указатель А–Я один занимает
              больше десяти экранов и отодвигает коммерческий блок в самый низ.
              Полоса намеренно НЕ перебивает поиск: она узкая, одной строкой
              числа, и ведёт в тот же блок #zayavka, а не заменяет его. Обе
              цифры вычислены из rates (см. комментарий у minRate). */}
          <a class="lookup__rate" href="#zayavka">
            <span class="lookup__rate-k">Нужен сам кран</span>
            {/* Неразрывные пробелы перед ₽ обязательны: на 320 px строка рвалась
                между числом и знаком рубля — «от 17 600» на одной строке, «₽.»
                на следующей. Число в отдельном <span> с nowrap по той же
                причине: сумма не должна разъезжаться на два куска ни при
                какой ширине. */}
            <b class="lookup__rate-v"><span>от {minRate.toLocaleString('ru-RU')}&nbsp;₽</span><i> / час</i></b>
            <span class="lookup__rate-n">Смена 8 часов — от {minShift.toLocaleString('ru-RU')}&nbsp;₽. Рассчитать и оставить заявку →</span>
          </a>

          <form class="lookup__form" role="search" onsubmit="return false">
            <label class="lookup__label" for="q">Поиск по указателю — введите термин, документ или норму</label>
            <input id="q" type="search" class="lookup__input" placeholder="наряд-допуск, освидетельствование, строп, ФНП 461…" autocomplete="off" />
            <p class="lookup__count" id="q-count" role="status">Показано терминов: {TERMS.length}</p>
          </form>

          {/* Перечисление тем — вторая половина прежнего лида, слово в слово.
              Здесь ему и место: человек уже знает, что это за сайт, и читает
              список тем как содержание, а не как преграду перед поиском. */}
          <p class="lookup__topics">Что разбираем: что должно быть в паспорте машины, когда действует освидетельствование, кто подписывает наряд-допуск, как браковать канат и строп, что обязан сделать крановщик при неисправности.</p>

          <p class="lookup__hint">Поиск работает по предметному указателю ниже: {TERMS.length} {plural(TERMS.length, 'термин', 'термина', 'терминов')} ведут на {ENTRIES.length} {plural(ENTRIES.length, 'материал', 'материала', 'материалов')}. Ничего не отправляется на сервер — указатель целиком лежит на странице и работает даже с выключенным JavaScript, просто без фильтрации.</p>

          {/* Быстрые переходы прямо в первом экране: раньше единственным способом
              попасть в раздел был скролл через весь указатель А–Я (десять с лишним
              экранов на телефоне) либо открытие бургер-меню. Здесь — шесть настоящих
              разделов сайта: три якоря на этой же странице и три отдельные страницы,
              каждая уже в навигации выше. Ничего нового не выдумано, только более
              короткий путь к тому, что уже есть. */}
          <nav class="hero__quicknav" aria-label="Быстрые переходы по разделам">
            <a href="#ukazatel">Указатель А–Я</a>
            <a href="/park/">Парк техники</a>
            <a href="/uslugi/lyubaya-podyomnaya-tehnika/">Другая техника</a>
            <a href="/keysy/">Разборы задач</a>
            <a href="/documents/">Документы</a>
            <a href="/faq/">Вопросы</a>
          </nav>
        </div>

        {/* Волна 19: визуальный якорь первого экрана взамен пропавшей hero-иллюстрации.
            Не подъёмный кран во всю ширину (это был стиль лендинга волны 9) — линейная
            техническая схема: документ с найденной строкой (жёлтая подсветка = совпадение
            в указателе), угловые регистрационные метки чертежа, линия размера и едва заметный
            силуэт крана штрихом — три мотива из брифа («документа/печати/крана») в одном
            знаке, а не три разных иконки. Только SVG-примитивы, ни одного растрового ассета.
            Волна 122: теперь поверх видео — заливка var(--bg-2) внутри самого рисунка (см.
            "document" path ниже) даёт ей читаться как непрозрачная плашка над видео, а не
            прозрачное окно; сам штрих-рисунок контрастнее сплошного --bg, видео его не топит. */}
        <div class="lookup__art" aria-hidden="true">
          <svg viewBox="0 0 320 320" role="img" focusable="false">
          <defs>
            <pattern id="lm-dots" width="18" height="18" patternUnits="userSpaceOnUse">
              <circle cx="1.4" cy="1.4" r="1.3" fill="var(--line-strong)" />
            </pattern>
          </defs>

          <rect x="10" y="10" width="300" height="300" fill="url(#lm-dots)" opacity="0.4" />
          <rect x="10" y="10" width="300" height="300" fill="none" stroke="var(--line-strong)" stroke-width="1.4" stroke-dasharray="2 7" />

          <g stroke="var(--yellow)" stroke-width="2.5" stroke-linecap="square" fill="none">
            <path d="M10 30 V10 H30" />
            <path d="M290 10 H310 V30" />
            <path d="M310 290 V310 H290" />
            <path d="M30 310 H10 V290" />
          </g>

          <g stroke="var(--yellow)" stroke-width="2" opacity="0.18" fill="none" stroke-linecap="round">
            <line x1="56" y1="120" x2="56" y2="42" />
            <line x1="56" y1="48" x2="102" y2="48" />
            <line x1="56" y1="48" x2="30" y2="60" />
            <line x1="92" y1="48" x2="92" y2="70" />
            <line x1="40" y1="120" x2="70" y2="120" />
          </g>

          <path d="M110 66 L190 66 L214 90 L214 250 L110 250 Z" fill="var(--bg-2)" stroke="var(--ink)" stroke-width="2.5" stroke-linejoin="round" />
          <path d="M190 66 L190 90 L214 90" fill="none" stroke="var(--ink)" stroke-width="2.5" stroke-linejoin="round" />

          <g stroke="var(--muted)" stroke-width="3.5" stroke-linecap="round">
            <line x1="128" y1="108" x2="196" y2="108" />
            <line x1="128" y1="148" x2="180" y2="148" />
            <line x1="128" y1="168" x2="196" y2="168" />
            <line x1="128" y1="188" x2="170" y2="188" />
          </g>
          <rect x="122" y="121" width="80" height="14" fill="var(--yellow)" />
          <line x1="128" y1="128" x2="196" y2="128" stroke="var(--bg-2)" stroke-width="3.5" stroke-linecap="round" />

          <g stroke="var(--line-strong)" stroke-width="1.4">
            <line x1="110" y1="266" x2="214" y2="266" />
            <line x1="110" y1="260" x2="110" y2="272" />
            <line x1="214" y1="260" x2="214" y2="272" />
          </g>
        </svg>
        </div>
      </div>
    </div>
    <p class="lookup__vidcredit">Фоновое видео — атмосферная иллюстрация «башенный кран на площадке», не конкретный объект и не наша техника. Автор: Abdo Alshreef, <a href="https://www.pexels.com/license/" target="_blank" rel="noopener">Pexels License</a>, <a href="https://www.pexels.com/video/big-crane-26843658/" target="_blank" rel="noopener">Pexels</a>.</p>

    {/* Волна 19: честные метрики САМОГО справочника (метаданные о содержимом сайта),
        а не выдуманные бизнес-цифры вида «14 лет на рынке». Все четыре значения — из
        src/lib/spravochnik.ts и константы CHECKED выше; ничего не захардкожено отдельно,
        разойтись с реальным числом материалов/терминов физически не может. */}
    <div class="lookup__stats" role="note" aria-label="Показатели справочника">
      <div class="lookup__stat">
        <b>{ENTRIES.length}</b>
        <span>материалов в справочнике</span>
      </div>
      <div class="lookup__stat">
        <b>{TERMS.length}</b>
        <span>терминов в указателе А–Я</span>
      </div>
      <div class="lookup__stat">
        <b>{DOCS.length}</b>
        <span>действующих нормативных источников</span>
      </div>
      <div class="lookup__stat lookup__stat--date">
        <b>{CHECKED}</b>
        <span>дата последней сверки фактуры</span>
      </div>
    </div>
  </section>

  <section class="idx wrap" id="ukazatel">
