---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Sources from '../../../components/Sources.astro';

const title = 'Гусеничный кран, манипулятор, автовышка — Москва, партнёрка';
const description = 'Автокран 16–50 т — наш профиль с калькулятором. Остальную спецтехнику — от гусеничного крана до экскаватора и трала — подбираем через партнёрскую сеть.';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Услуги', item: 'https://moskran-servis.ru/#uslugi' },
    { '@type': 'ListItem', position: 3, name: 'Полный спектр спецтехники', item: 'https://moskran-servis.ru/uslugi/lyubaya-podyomnaya-tehnika/' },
  ],
};

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Подбор и подача спецтехники через партнёрскую сеть',
  provider: { '@id': 'https://moskran-servis.ru/#organization' },
  areaServed: 'Москва',
};

// Честная матрица «наше / партнёрское». Числа — те же, что уже стоят на
// /park/ и /uslugi/bashennyy-kran/ (см. models[] в park/index.astro),
// ничего не придумано отдельно для этой страницы.
const rows = [
  {
    type: 'Автокран 16–50 т',
    status: 'Профиль сайта',
    detail: 'Собственная линейка парка, три страницы услуг с открытым калькулятором, помощь автокраном-помощником для монтажа башенных кранов.',
    href: '/park/',
    linkText: 'Парк техники →',
  },
  {
    type: 'Гусеничный кран',
    status: 'Частично в парке',
    detail: '2 модели уже разобраны подробно — XCMG QUY50 (50 т) и SANY SCC550E (55 т). Другой класс или производитель — через партнёрскую сеть.',
    href: '/keysy/rabota-na-stesnennoy-ploshchadke-gusenichnyy/',
    linkText: 'Пример задачи →',
    subtypes: [
      'Лёгкий класс, до 25 т — манёвренность на стеснённой площадке без выносных опор, которые нужны колёсным кранам.',
      'Средний класс, 25–100 т — сюда попадают обе модели нашего парка; основной объём промышленного и энергетического монтажа.',
      'Тяжёлый и сверхтяжёлый класс, от 100 т — подъём крупногабаритного технологического оборудования; в парке нет, только партнёрская сеть.',
      'По стреловому оборудованию — с решётчатой стрелой (выше грузоподъёмность на большом вылете) и телескопической (быстрее готовится к работе на объекте).',
    ],
  },
  {
    type: 'Башенный кран',
    status: 'Частично в парке',
    detail: '2 модели в парке (Liebherr 132 EC-H8, Potain MDT 178) и отдельная услуга с помесячным калькулятором. Другая высота, вылет или класс момента — партнёрская сеть.',
    href: '/uslugi/bashennyy-kran/',
    linkText: 'Услуга и калькулятор →',
    subtypes: [
      'По узлу поворота — нижнеповоротные (крутится вся башня, для небольшой высоты) и верхнеповоротные (поворотный узел наверху, башня неподвижна — обе наши модели такого типа).',
      'По оголовку — классическая схема с вершинной частью и оттяжками (Liebherr в нашем парке) и безоголовочная flat-top схема без выступающих частей (Potain в нашем парке).',
      'По группе грузового момента — от лёгких (порядка 25–60 тм) до тяжёлых и сверхтяжёлых (от 250 тм); наши модели — лёгкий-средний диапазон, более тяжёлые группы — через партнёров.',
    ],
  },
  {
    type: 'Кран-манипулятор',
    status: 'Партнёрская сеть',
    detail: 'В собственном парке нет. Подбираем машину под задачу: типовой диапазон рынка — стрела 3–15 т, борт до 20 т.',
    href: '/spravochnik/avtokran-ili-avtovyshka/',
    linkText: 'Чем отличается от автокрана →',
    subtypes: [
      'Лёгкие — на компактном шасси, для доставки мелких грузов и стройматериалов по городу.',
      'Средние — самый массовый сегмент рынка, под большинство типовых задач на стройке и при разгрузке материалов.',
      'Тяжёлые — на многоосном шасси, для подъёма и перевозки крупногабаритного или тяжёлого оборудования, в том числе на промышленных и портовых объектах.',
      'По назначению — строительные (грузы и материалы), лесовозные (с грейферным захватом под лес) и крано-манипуляторные эвакуаторы (с крюковой платформой для перевозки повреждённой техники).',
    ],
  },
  {
    type: 'Автовышка (АГП)',
    status: 'Партнёрская сеть',
    detail: 'В собственном парке нет. Подбираем машину под задачу: типовой диапазон рынка — высота 18–50 м.',
    href: '/spravochnik/avtokran-ili-avtovyshka/',
    linkText: 'Чем отличается от автокрана →',
    subtypes: [
      'Телескопические — выдвижная секционная стрела, строго вертикальный подъём на большую высоту.',
      'Коленчатые (шарнирные) — несколько шарниров позволяют люльке заходить за препятствия по горизонтали, а не только подниматься вверх.',
      'Комбинированные (коленчато-телескопические) — сочетают оба механизма; самый распространённый тип на рынке сейчас.',
      'Мостовые — люлька опускается ниже уровня шасси, для работы в приямке или под площадкой, а не только вверх.',
    ],
  },
  {
    type: 'Экскаватор',
    status: 'Партнёрская сеть',
    detail: 'В собственном парке нет. Подбираем машину под характер земляных работ — рытьё траншеи, разработка котлована, планировка площадки.',
    href: '/#zayavka',
    linkText: 'Оставить заявку →',
    subtypes: [
      'Гусеничный ход — устойчивость и проходимость на мягком, неровном или обводнённом грунте.',
      'Колёсный ход — своим ходом перемещается между близкими объектами по дороге, без трала на короткое плечо.',
      'Мини-класс — компактная машина для работы во дворе, в стеснённых условиях и рядом с подземными коммуникациями.',
      'Карьерный и тяжёлый класс — масштабная разработка грунта и погрузка на крупном объекте.',
    ],
  },
  {
    type: 'Самосвал',
    status: 'Партнёрская сеть',
    detail: 'В собственном парке нет. Подбираем машину под объём и вид груза — вывоз грунта после земляных работ, подвоз сыпучих материалов на объект.',
    href: '/#zayavka',
    linkText: 'Оставить заявку →',
    subtypes: [
      'Дорожный — рассчитан на дороги общего пользования, вывоз грунта и подвоз материалов на городской объект.',
      'Карьерный (внедорожный) — крупногабаритная техника для работы внутри карьера или большой стройплощадки, по дорогам общего пользования не выезжает.',
      'Шарнирно-сочленённый — рама с изломом посередине для проходимости по бездорожью и раскисшему грунту стройплощадки.',
      'По грузоподъёмности — от малых до тяжёлых классов; конкретный подбираем под объём и вид груза заявки.',
    ],
  },
  {
    type: 'Трал / негабаритная перевозка',
    status: 'Партнёрская сеть',
    detail: 'В собственном парке нет. Подбираем трал под перевозку крупногабаритной или тяжёлой техники между объектами.',
    href: '/spravochnik/markirovka-negabarita-pri-transportirovke/',
    linkText: 'Маркировка негабарита →',
    subtypes: [
      'Низкорамный — низкая погрузочная площадка вписывает высокий груз в габарит дорог общего пользования без спецсогласований по высоте.',
      'Модульный — собирается из секций под нужную длину и ширину конкретного груза, для оборудования нестандартных размеров.',
      'Трал-тяжеловоз — для особо тяжёлых и крупных грузов, площадка наращивается по длине и ширине под конкретную задачу.',
      'Бортовой / платформенный — для техники и грузов, которые укладываются в стандартный габарит без специальной низкой рамы.',
    ],
  },
];

const faqs = [
  {
    q: 'Почему вы не держите гусеничный кран, башенный кран, манипулятор и автовышку в собственном парке целиком?',
    a: 'Потому что это разные рынки техники со своей логикой закупки, хранения и обслуживания — держать в штате весь спектр ради редких заявок значит закладывать эти расходы в цену на всё остальное, включая автокран, который заказывают ежедневно. Мы выбрали профиль — автокран 16–50 т по Москве — и разбираем его настолько подробно, насколько можем отвечать за каждую цифру. Остальное подбираем у проверенных партнёров, а не делаем вид, что оно стоит у нас на площадке.',
  },
  {
    q: 'Чем подбор через партнёрскую сеть отличается от прямого звонка владельцу техники?',
    a: 'Для вас — точкой контакта и ответственностью: заявку, договор, согласование сроков и вопросы по площадке ведём мы, а не вы лично с незнакомой компанией. Для нас — тем, что мы заранее проверяем у партнёра действующий комплект документов на машину (паспорт, освидетельствование, аттестация оператора) по тем же требованиям ФНП №461, что и для собственного парка, прежде чем предлагать технику под вашу задачу.',
  },
  {
    q: 'Почему для партнёрской техники нет калькулятора, как для автокрана?',
    a: 'Потому что ставка партнёрской техники зависит от того, какая конкретно машина свободна на нужную дату у конкретного партнёра, — это не наша фиксированная цена, которую можно закрепить в форме заранее. Публиковать вилку «от» без реальной машины за ней означает или занижать ожидания, или завышать их. Стоимость и сроки по партнёрской технике — это расчёт под конкретную задачу, а не фиксированный тариф; называем цифру после того, как подтверждён конкретный экземпляр техники под ваши параметры.',
  },
  {
    q: 'Что делать, если я не знаю, какая техника нужна — кран, манипулятор или автовышка?',
    a: 'Опишите задачу в заявке своими словами — вес и габариты груза (если он есть), высоту, нужно ли поднимать человека или только груз, стеснена ли площадка. Тип техники подбираем по этим параметрам, а не наоборот: разбор разницы между краном и автовышкой — в справочнике, ссылка ниже.',
  },
  {
    q: 'Экскаватор, самосвал и трал — тоже через партнёрскую сеть, как манипулятор и автовышка?',
    a: 'Да, ровно так же: в собственном парке этой техники нет, под задачу подбираем через проверенного партнёра, а не выдаём подряд первому, кто откликнулся. Экскаватор — под земляные работы, самосвал — под вывоз грунта или подвоз материалов, трал — под перевозку крупногабаритной или тяжёлой техники между объектами. Модель, характеристики и стоимость по этим трём категориям на сайте не публикуем ни в каком виде — называем их только после того, как под вашу заявку подтверждён конкретный экземпляр техники.',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<BaseLayout title={title} description={description} path="/uslugi/lyubaya-podyomnaya-tehnika/" ldExtra={[breadcrumbLd, serviceLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/#uslugi">Услуги</a><span>/</span><span>Полный спектр спецтехники</span>
  </nav>

  <section class="section wrap" style="padding-top:8px">
    <div class="section-head">
      <span class="eyebrow">Полный спектр</span>
      <h1>Нужна не автокран, а другая спецтехника? Подберём через партнёрскую сеть</h1>
      <p>Автокран 16–50 т в Москве — это наш профиль: собственная линейка парка, открытый калькулятор, полный разбор допуска по ФНП №461 на каждой странице услуги. Но реальная заявка не всегда укладывается в один тип машины.</p>
    </div>
  </section>

  <section class="section wrap prose" style="padding-top:0">
    <p>Если для задачи нужен гусеничный кран, башенный кран на длительный монтаж, кран-манипулятор для точечной работы с грузом на высоте, автовышка для подъёма людей, экскаватор для земляных работ, самосвал для вывоза грунта или трал для перевозки крупногабаритной техники — мы не делаем вид, что вся эта техника стоит у нас на площадке. Часть уже в нашем парке и разобрана так же подробно, как автокран (гусеничный и башенный кран — см. таблицу ниже); манипулятор, автовышку, экскаватор, самосвал и трал в собственной линейке не держим вовсе и подбираем их через проверенную партнёрскую сеть. Это тот же принцип, на котором работает вся отрасль аренды спецтехники: ни один подрядчик физически не держит в штате все классы техники сразу, и честная компания говорит об этом прямо, а не изображает безразмерный парк на сайте.</p>

    <table class="spectrum">
      <caption>Что наше, а что — через партнёрскую сеть</caption>
      <thead><tr><th>Техника</th><th>Статус у нас</th><th>Подробности</th><th></th></tr></thead>
      <tbody>
        {rows.map((r) => (
          <tr>
            <td data-label="Техника"><b>{r.type}</b></td>
            <td data-label="Статус у нас"><span class={r.status === 'Профиль сайта' ? 'spectrum__tag spectrum__tag--core' : r.status === 'Партнёрская сеть' ? 'spectrum__tag spectrum__tag--partner' : 'spectrum__tag spectrum__tag--mixed'}>{r.status}</span></td>
            <td data-label="Подробности">
              {r.detail}
              {r.subtypes && (
                <>
                  <p class="spectrum__subhead">Подвиды на рынке</p>
                  <ul class="spectrum__subtypes">
                    {r.subtypes.map((s) => (<li>{s}</li>))}
                  </ul>
                </>
              )}
            </td>
            <td data-label=""><a href={r.href}>{r.linkText}</a></td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="section wrap prose" style="padding-top:0">
    <h2 style="margin-bottom:16px">Где эта техника реально нужна в Москве чаще всего</h2>
    <p>Кроме автокрана, в городе устойчивый спрос на несколько конкретных задач, у каждой свой тип машины. Кран-манипулятор закрывает точечный высотный монтаж и демонтаж — рекламные конструкции и вывески, элементы фасада, узлы освещения, установка кондиционеров: где важна не столько грузоподъёмность, сколько манёвренность стрелы и возможность одной машиной и привезти груз на борту, и поднять его манипулятором. Автовышка нужна там, где на высоте должен работать человек, а не груз — обслуживание фасада, остекление, мойка окон, обрезка деревьев, ремонт освещения: люлька рассчитана на людей и ручной инструмент, а не на строительный груз, поэтому она не заменяет кран и наоборот (разбор разницы — в справочнике, ссылка ниже).</p>
    <p>Требование, общее для всей техники на московских улицах вне зависимости от типа и владельца: грузовой транспорт разрешённой массой свыше 3,5 т обязан иметь пропуск для движения по грузовому каркасу города и быть зарегистрирован в РНИС (Региональной навигационно-информационной системе). Это касается манипулятора и автовышки так же, как автокрана — партнёр, которого мы предлагаем под задачу, обязан иметь действующий пропуск и регистрацию, это часть проверки, а не то, что выясняется по факту выезда на объект.</p>
    <p>Экскаватор, самосвал и трал закрывают смежные задачи, которые нередко идут в одной заявке с краном. Экскаватор нужен под земляные работы — рытьё траншеи под коммуникации, разработку котлована под фундамент, планировку площадки перед монтажом крана. Самосвал вывозит грунт после земляных работ или подвозит сыпучие материалы на объект. Трал перевозит крупногабаритную или тяжёлую технику между объектами — в том числе когда она не может пройти по городским дорогам своим ходом. Это не подъёмные сооружения, и требования ФНП №461 из следующего раздела на них не распространяются — у экскаватора, самосвала и трала другие правила допуска техники и оператора. Партнёра под эту технику проверяем на действующие документы и подтверждённую квалификацию так же внимательно, просто по другому чек-листу — не по крановому.</p>
  </section>

  <section class="section wrap prose" style="padding-top:0">
    <h2 style="margin-bottom:16px">Допуск техники не зависит от того, чей это кран</h2>
    <p>Требования ФНП №461 (приказ Ростехнадзора от 26.11.2020 №461, действующая редакция от 16.04.2026) к паспорту подъёмного сооружения, периодичности технического освидетельствования и квалификации оператора одинаковы для собственной техники и для партнёрской — норма не делает разницы между владельцем и подрядчиком. Перед тем как предложить партнёрскую машину под вашу задачу, мы запрашиваем тот же комплект документов, который держим по своему парку: действующий паспорт с записью последнего освидетельствования, удостоверение оператора и приказы о назначении ответственных лиц. Проверить, какие позиции уже закрыты по конкретному объекту, можно в <a href="/proverka-dokumentov/" style="color:var(--yellow)">чек-листе допуска</a> — он одинаково применим к любому типу грузоподъёмной машины, не только к автокрану.</p>
  </section>

  <section class="section wrap prose qa" style="padding-top:0">
    <h2 style="margin-bottom:22px">Вопросы, которые задают до заказа</h2>
    {faqs.map((f) => (<><h3>{f.q}</h3><p>{f.a}</p></>))}
    <Sources
      checked="17.08.2026"
      items={[
