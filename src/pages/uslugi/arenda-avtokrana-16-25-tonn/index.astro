---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Sources from '../../../components/Sources.astro';
import PriceDisclaimer from '../../../components/PriceDisclaimer.astro';
import { PRICES_VALID_UNTIL } from '../../../lib/prices';

const title = 'Аренда автокрана 16–25 тонн в Москве — расчёт, цены';
const description = 'Автокран 16–25 тонн в аренду в Москве: разгрузка, монтаж, подача материалов на высоту. Разница 16 и 25 т, вылет стрелы, площадка под опоры. Калькулятор.';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Услуги', item: 'https://moskran-servis.ru/#uslugi' },
    { '@type': 'ListItem', position: 3, name: 'Автокраны 16–25 тонн', item: 'https://moskran-servis.ru/uslugi/arenda-avtokrana-16-25-tonn/' },
  ],
};

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Аренда автокрана 16-25 тонн',
  provider: { '@id': 'https://moskran-servis.ru/#organization' },
  areaServed: 'Москва',
  offers: {
    '@type': 'Offer',
    // Аренда, а НЕ продажа. Без явного businessFunction значение по умолчанию —
    // Sell, то есть разметка объявляла бы продажу крана за эту сумму. Техника
    // передаётся во временное пользование (с экипажем, ст. 632 ГК) — LeaseOut.
    businessFunction: 'http://purl.org/goodrelations/v1#LeaseOut',
    priceCurrency: 'RUB',
    price: '2200',
    priceSpecification: { '@type': 'UnitPriceSpecification', price: '2200', priceCurrency: 'RUB', unitText: 'HOUR' },
  },
};

const faqs = [
  {
    q: '16 или 25 тонн — как выбрать?',
    a: '16-тонный кран закрывает большинство задач с грузом до 5-6 тонн на среднем вылете (10-12 м) — это разгрузка фур, монтаж лёгких металлоконструкций, подъём поддонов с кирпичом или блоками. 25-тонный берут, когда либо сам груз тяжелее (плиты перекрытия, крупные ЖБИ, трансформаторы), либо когда кран физически не может подъехать близко к точке подъёма и приходится работать на увеличенном вылете — а грузоподъёмность крана падает с ростом вылета нелинейно, у 25-тонника запас на этот случай больше.',
  },
  {
    q: 'Что такое грузовысотная характеристика и зачем она нужна до заказа?',
    a: 'Это таблица (или график) в паспорте крана, которая показывает, какой вес кран поднимет на каждом конкретном вылете стрелы и на какую высоту. У любого автокрана есть простое правило: чем дальше от крана точка подъёма, тем меньше вес он способен поднять. Если площадка не позволяет подъехать вплотную (стеснённый двор, узкий проезд), нужно заранее посчитать вылет и свериться с грузовысотной характеристикой конкретной модели — иначе кран приедет на объект и физически не сможет выполнить подъём. Мы делаем этот расчёт на этапе согласования заявки, а не по факту приезда техники.',
  },
  {
    q: 'Нужен ли проект производства работ (ППР) для разовой разгрузки?',
    a: 'Для типовых кратковременных операций (разгрузка машины, подъём единичного груза на некритичную высоту) в большинстве случаев достаточно технологической карты и инструктажа на месте — полноценный ППР требуется не всегда. Но если работа ведётся вблизи линий электропередач, рядом с эксплуатируемым зданием, на стеснённой площадке или груз поднимается на высоту с угрозой падения на людей/проезжую часть — ППР обязателен по требованиям промышленной безопасности. Мы уточняем это на этапе приёма заявки и, если требуется, сообщаем заранее, а не после отказа от выезда на месте.',
  },
  {
    q: 'Сколько места нужно крану на площадке?',
    a: 'Для 16-25-тонного автокрана на выносных опорах обычно нужна площадка порядка 5×5–6×6 метров под сами опоры плюс подъездной путь шириной от 3,5 м с твёрдым покрытием, выдерживающим осевую нагрузку — асфальт или уплотнённый щебень, не рыхлый грунт. Если площадка мягкая, под опоры укладываются инвентарные подкладки — мы привозим их с собой, отдельно заказывать не нужно.',
  },
  {
    q: 'Можно ли работать краном без выносных опор, прямо с колёс?',
    a: 'Технически у некоторых моделей есть такая функция, но грузоподъёмность на неопертой технике падает в разы по сравнению с работой на выносных опорах — она годится только для минимальных грузов на минимальном вылете. Для реальных строительных и монтажных задач в этом классе техники практически всегда используются выносные опоры, это не опция «для удобства», а требование безопасности.',
  },
  {
    q: 'Что делать, если после расчёта окажется, что 25-тонник тоже не справится?',
    a: 'Если по факту расчёта вылета и веса выясняется, что задача выходит за пределы диапазона 16–25 тонн, мы предлагаем технику следующего класса (32 или 50 тонн — отдельная линейка в нашем парке) без потери времени на повторную заявку с нуля: пересчитываем сразу по тем же исходным данным.',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<BaseLayout title={title} description={description} path="/uslugi/arenda-avtokrana-16-25-tonn/" ldExtra={[breadcrumbLd, serviceLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/#uslugi">Услуги</a><span>/</span><span>Автокраны 16–25 тонн</span>
  </nav>

  <section class="section wrap" style="padding-top:8px">
    <div class="section-head">
      <span class="eyebrow">Услуга</span>
      <h1>Аренда автокрана 16–25 тонн в Москве</h1>
      <p>Самый востребованный класс техники для города: достаточно грузоподъёмности для большинства строительных и складских задач и при этом манёвренность, чтобы работать во дворах и на стеснённых площадках, где 50-тонной технике попросту не развернуться.</p>
    </div>
  </section>

  <section class="section wrap" style="padding-top:0;padding-bottom:0">
    <div class="rate-line">
      <span class="rate-line__label">Базовая ставка класса</span>
      <p class="rate-line__value">от 2 200 ₽<span class="rate-line__unit"> / час</span></p>
      <p class="rate-line__note">Та же ставка, что в калькуляторе на главной; минимальный заказ — одна смена 8 часов. Подача техники, работы в выходные и пропускной режим объекта (× 1,12) считаются отдельно и называются до подтверждения заявки.</p>
    </div>
    <PriceDisclaimer validUntil={PRICES_VALID_UNTIL} />
  </section>

  <section class="section wrap" style="padding-top:0;padding-bottom:clamp(30px,4vw,48px)">
    <p class="prose" style="color:var(--muted);margin-bottom:22px">Класс лёгкий, требования — те же. Перед подачей автокрана 16–25 т на московский объект проверяется вот этот набор; ссылки в правом столбце ведут в справочник, где каждая строка разобрана отдельно.</p>
    <table class="adm">
      <caption>Карточка допуска техники</caption>
      <thead><tr><th scope="col">Требование</th><th scope="col">Что именно проверяется</th><th scope="col">Срок действия</th><th scope="col">Кто подписывает</th></tr></thead>
      <tbody>
        <tr><td data-label="Требование">Паспорт подъёмного сооружения</td><td data-label="Что именно проверяется">Результаты технического освидетельствования записываются в паспорт с указанием срока следующего. Паспорт без свежей записи не подтверждает ничего: срок проверить нечем.</td><td data-label="Срок действия">актуален по дате последней записи</td><td data-label="Кто подписывает">инженерно-технический работник, ответственный за производственный контроль</td></tr>
        <tr><td data-label="Требование">Частичное техническое освидетельствование</td><td data-label="Что именно проверяется">Осмотр без статических и динамических испытаний: состояние металлоконструкций, канатов, приборов и устройств безопасности.</td><td data-label="Срок действия">не реже одного раза в 12 месяцев</td><td data-label="Кто подписывает">ответственный за производственный контроль при участии ответственного за содержание ПС</td></tr>
        <tr><td data-label="Требование">Полное техническое освидетельствование</td><td data-label="Что именно проверяется">Осмотр плюс испытания: статические — грузом 125 % от паспортной грузоподъёмности, динамические — грузом на 10 % выше паспортной.</td><td data-label="Срок действия">не реже одного раза в 3 года (для редко используемых ПС — раз в 5 лет)</td><td data-label="Кто подписывает">ответственный за производственный контроль при участии ответственного за содержание ПС</td></tr>
        <tr><td data-label="Требование">Квалификация оператора</td><td data-label="Что именно проверяется">Документ о квалификации и действующий результат проверки знаний. Это законный вопрос заказчика, а не проявление недоверия.</td><td data-label="Срок действия">по установленной эксплуатирующей организацией периодичности</td><td data-label="Кто подписывает">комиссия эксплуатирующей организации</td></tr>
        <tr><td data-label="Требование">Приказы о назначении ответственных</td><td data-label="Что именно проверяется">Три разные роли: за производственный контроль, за содержание ПС в работоспособном состоянии, за безопасное производство работ с применением ПС.</td><td data-label="Срок действия">до отмены или замены приказа</td><td data-label="Кто подписывает">руководитель эксплуатирующей организации</td></tr>
        <tr><td data-label="Требование">Установка на выносные опоры</td><td data-label="Что именно проверяется">Если руководство по эксплуатации не разрешает иное, машина ставится на все выносные опоры. Площадка не должна быть свеженасыпанным неутрамбованным грунтом, а уклон — превышать паспортный.</td><td data-label="Срок действия">проверяется перед каждой установкой</td><td data-label="Кто подписывает">оператор ПС и ответственный за безопасное производство работ</td></tr>
        <tr><td data-label="Требование">Технологическая карта или ППР</td><td data-label="Что именно проверяется">Для типовой разгрузки достаточно технологической карты; стеснённая площадка, работа у здания или над проездом требует полноценного проекта производства работ.</td><td data-label="Срок действия">на конкретные работы</td><td data-label="Кто подписывает">технический руководитель эксплуатирующей организации</td></tr>
      </tbody>
    </table>
    <ul class="adm-links">
      <li><a href="/spravochnik/tehnicheskoe-osvidetelstvovanie-krana/">Освидетельствование: частичное и полное →</a></li>
      <li><a href="/spravochnik/nesushchaya-sposobnost-grunta/">Грунт под выносными опорами →</a></li>
      <li><a href="/spravochnik/gruzovysotnaya-harakteristika/">Как читать грузовысотную характеристику →</a></li>
      <li><a href="/spravochnik/ppr-dlya-krana/">Когда ППР обязателен →</a></li>
    </ul>
  </section>
  <section class="section wrap prose" style="padding-top:0">
    <h2 style="margin-bottom:18px">Для каких задач берут кран этого класса</h2>
    <p>Диапазон 16–25 тонн — рабочая лошадка городского строительства и логистики. На практике в эту категорию попадают четыре типа задач.</p>
    <p><b>Разгрузка транспорта.</b> Фура с поддонами кирпича, блоков, мешков сухих смесей, рулонов кровли — самая частая заявка. Груз редко превышает 3-5 тонн за подъём, вылет небольшой (кран подъезжает вплотную к борту машины), поэтому даже 16-тонник справляется с большим запасом.</p>
    <p><b>Монтаж лёгких и средних конструкций.</b> Металлические фермы и колонны лёгких ангаров, элементы каркасов, вентиляционное и климатическое оборудование на кровлю, рекламные конструкции. Здесь важна уже не только грузоподъёмность, но и точность позиционирования — оператор работает по команде монтажника, поднимая конструкцию плавно и без раскачки.</p>
    <p><b>Подача материалов на высоту при отделочных и фасадных работах.</b> Поддоны с утеплителем, облицовочными материалами, лесами — на этаж или на кровлю здания высотой до 10-15 этажей, в пределах вылета и грузовысотной характеристики конкретной модели.</p>
    <p><b>Подъём тяжёлого инженерного оборудования.</b> Трансформаторные подстанции, крупные вентиляционные установки, компрессоры — здесь чаще нужен уже 25-тонник, поскольку сам груз в пределах 4-8 тонн плюс, как правило, требуется увеличенный вылет.</p>
    <p>Отдельная, менее частая, но регулярная задача — <b>демонтаж</b> с обратной логикой: спуск старого оборудования, конструкций после аварийного состояния или элементов при реконструкции. Расчёт здесь даже более консервативный, чем при монтаже: вес демонтируемого элемента часто известен менее точно, чем вес нового груза по паспорту изделия, поэтому мы закладываем больший запас по грузоподъёмности, если точный вес неизвестен.</p>

    <h2 style="margin:36px 0 18px">Типичные технические характеристики техники этого класса</h2>
    <p>Автокраны 16–25 тонн, которые применяются на подобных задачах в Москве, обычно имеют телескопическую стрелу длиной от 21 до 31 метра (зависит от модели и конфигурации), максимальную высоту подъёма крюка порядка 22–34 метров и минимальный радиус разворота, рассчитанный на работу в стеснённых городских условиях — это то, что отличает их от более крупных 32–50-тонных машин, которым для разворота и установки требуется заметно больше пространства.</p>
    <p>На выносных опорах при полном вылете кран занимает площадь порядка 5–6 метров в каждую сторону от оси — именно этот параметр определяет, поместится ли техника во двор или на площадку без выезда на проезжую часть. У части моделей этого класса есть возможность работы на неполных опорах (частичный вылет опор) — это снижает грузоподъёмность, но иногда единственный способ разместить кран на действительно тесной площадке. Уточняем применимость этого режима под конкретный груз при расчёте заявки.</p>

    <h2 style="margin:36px 0 18px">Как рассчитывается вылет стрелы — и почему это не мелочь</h2>
    <p>Ключевая ошибка при самостоятельном заказе крана «на глаз» — не учитывать вылет. Грузоподъёмность, указанная в названии крана (16 или 25 тонн), — это максимум на минимальном вылете, практически у основания стрелы. Стоит крану отъехать от точки подъёма дальше, доступная грузоподъёмность падает — иногда вдвое и больше на удалении 15-18 метров.</p>
    <p>На практике это означает: если ваша площадка не позволяет подъехать вплотную к месту, где нужно поднять груз (забор, соседнее здание, инженерные коммуникации под землёй, где нельзя ставить опоры), нужно заранее прикинуть реальное расстояние от возможной стоянки крана до точки подъёма и вес груза — и свериться с грузовысотной характеристикой. Мы делаем этот расчёт при приёме заявки бесплатно: присылаете примерную схему площадки и вес груза, мы подбираем модель и точку установки, которая физически способна выполнить подъём.</p>
    <p>Отдельный частый случай в Москве — работа рядом с воздушными линиями электропередач или в охранной зоне подземных коммуникаций. Здесь действуют отдельные требования по минимальным расстояниям от стрелы и груза до токоведущих частей — при необходимости мы согласовываем это с сетевой организацией заранее, а не выясняем на месте.</p>

    <h2 style="margin:36px 0 18px">Пример расчёта: разгрузка фуры во дворе жилого дома</h2>
    <p>Разберём типичный случай, чтобы показать логику расчёта на конкретных цифрах, а не абстрактно. Задача: разгрузить фуру с поддонами кирпича (вес одного подъёма — до 2 тонн) во дворе многоквартирного дома, где фура может встать только у края двора, а кран — примерно в 8 метрах от точки разгрузки из-за припаркованных машин и клумбы посередине двора.</p>
    <p>На вылете 8 метров даже базовый 16-тонный кран сохраняет грузоподъёмность в разы больше требуемых 2 тонн — здесь запаса более чем достаточно, и утяжелённая техника не нужна. Другое дело, если бы вес одного подъёма был не 2, а 6-7 тонн (например, крупные бетонные блоки) — тогда на том же вылете 8 метров уже стоило бы проверять грузовысотную характеристику внимательнее, и для части моделей 16-тонного класса такой вес на этом вылете уже может быть на пределе или за пределами возможностей, что потребовало бы 25-тонник.</p>
    <p>Вывод из примера простой: не тоннаж крана сам по себе определяет, справится ли он с задачей, а сочетание веса груза и вылета. Именно поэтому мы просим оба параметра при расчёте, а не только «нужен кран потяжелее на всякий случай» — переплата за более мощный класс техники там, где это не нужно, не идёт на пользу ни одной из сторон.</p>

    <h2 style="margin:36px 0 18px">Чем автокран отличается от манипулятора</h2>
    <p>Отдельный частый вопрос — не спутать заказ с манипулятором (краном-вездеходом на грузовом шасси, часто называемым «кран-манипуляторная установка», КМУ). Манипулятор хорош там, где нужно и привезти груз, и сразу его разгрузить одной машиной, но его грузоподъёмность на вылете обычно ощутимо ниже, чем у полноценного автокрана того же класса по названию, и он не предназначен для монтажных работ с точным позиционированием на высоте. Если задача — именно разгрузка с одновременной доставкой небольших грузов, манипулятор может быть быстрее и дешевле; если нужен монтаж, работа на высоте или груз весом от нескольких тонн — это задача для автокрана. При сомнении, что именно нужно под вашу задачу, опишите её в заявке — подскажем подходящий вариант, даже если это не то, что вы изначально спрашивали.</p>

    <h2 style="margin:36px 0 18px">Что нужно подготовить на площадке</h2>
    <ul>
      <li>Ровная площадка под выносные опоры (5×5 – 6×6 м) с твёрдым покрытием — асфальт, бетон или плотно утрамбованный щебень. На мягком грунте используем инвентарные подкладки под опоры, но полностью зыбкую или заболоченную площадку это не компенсирует.</li>
      <li>Подъездной путь шириной от 3,5 метра для проезда автокрана габаритами примерно с грузовой автомобиль.</li>
      <li>Свободное пространство над точкой подъёма — без проводов, веток, выступающих конструкций соседних зданий в радиусе работы стрелы.</li>
      <li>Если объект с пропускным режимом — пропуск на технику и бригаду оформлен заранее (см. отдельную услугу «Кран на режимный объект»).</li>
    </ul>

    <h2 style="margin:36px 0 18px">Сезонные особенности работы в Москве</h2>
    <p>Зимой на грузоподъёмность и безопасность работ влияют три вещи, о которых стоит помнить при планировании. Во-первых, ветер — у любого крана есть паспортное ограничение по максимальной скорости ветра для безопасной работы, и в открытых продуваемых местах (набережные, широкие проспекты, верхние этажи высотных объектов) это ограничение может стать реальным фактором для переноса работ на другой день, особенно при подъёме парусных грузов вроде листовых материалов. Во-вторых, обледенение площадки под выносными опорами — в гололёд подготовка площадки занимает больше времени: нужна очистка и, при необходимости, противогололёдная обработка перед установкой опор. В-третьих, короткий световой день зимой иногда сокращает реальное окно для работ на открытых площадках без искусственного освещения — это стоит учитывать при планировании смены на декабрь-январь.</p>
    <p>Летом основное ограничение — жара выше определённого порога, при которой часть техники требует более частых перерывов на охлаждение гидравлики, но на практике в Москве это редко становится реальным ограничением для стандартной 8-часовой смены. Более актуальный сезонный фактор — интенсивность дорожного трафика в тёплый сезон, которая может увеличить время подачи техники к объекту в часы пик.</p>

    <h2 style="margin:36px 0 18px">Как проходит выезд техники — по шагам</h2>
    <p>После подтверждения заявки процесс выглядит так. Диспетчер согласовывает точное время подачи техники и присылает контакт оператора для связи в день выезда. Кран прибывает на площадку к согласованному времени, оператор оценивает состояние подъездного пути и площадки на месте (это финальная проверка поверх расчёта, сделанного по фото и данным на этапе заявки) и устанавливает технику на выносные опоры. Дальше — сама работа по согласованному плану: разгрузка, монтаж или подача материалов, под контролем оператора и, где применимо, стропальщика или ответственного от заказчика. После завершения — вывод техники с площадки и, по договорённости, подписание акта выполненных работ на месте или в течение согласованного срока.</p>
    <p>Если в процессе работ выясняется, что реальные условия отличаются от заявленных (например, вес груза оказался больше указанного) — оператор останавливает подъём до пересогласования, а не продолжает работу за пределами грузовысотной характеристики. Это может означать перенос части работ на повторный выезд с техникой большего класса — неприятно по срокам, но это вопрос безопасности, а не перестраховки.</p>

    <h2 style="margin:36px 0 18px">Документы и безопасность</h2>
    <p>Кран эксплуатируется по действующим Федеральным нормам и правилам промышленной безопасности «Правила безопасности опасных производственных объектов, на которых используются подъёмные сооружения» (Приказ Ростехнадзора №461 от 26.11.2020, в действующей редакции) — а не по отменённым ещё в 2014 году ПБ 10-382-00, на которые по инерции продолжают ссылаться некоторые типовые договоры в нише. Оператор аттестован, у крана действующий диагностический ресурс и техническое освидетельствование. По запросу предоставляем комплект документов на технику и допуск оператора вместе с договором.</p>

    <h2 style="margin:36px 0 18px">Как формируется цена</h2>
    <p>Базовая ставка зависит от грузоподъёмности (см. <a href="/#zayavka" style="color:var(--yellow)">ориентир по стоимости на главной</a>) и считается по часам в пределах смены (8 часов), с минимальным заказом от одной смены. На итоговую стоимость влияют: удалённость объекта от точки базирования техники (подаётся отдельно, обсуждается на этапе заявки), необходимость пропуска на режимный объект (+12%, покрывает оформление документов) и работы в выходные и праздничные дни, которые тарифицируются отдельно — это всегда проговаривается до подтверждения заявки, без сюрпризов в акте.</p>

    <h2 style="margin:36px 0 18px">Аренда с экипажем — и почему мы не предлагаем без</h2>
    <p>На рынке спецтехники встречаются два формата: аренда «с экипажем» (кран подаётся вместе с аттестованным оператором подрядчика) и «без экипажа» (техника передаётся заказчику, который обеспечивает своего оператора). Второй формат по закону требует от заказчика собственного аттестованного персонала и, как правило, отдельного договора ответственности — это ощутимо более сложная конструкция с точки зрения промышленной безопасности, и на практике для разовых или нерегулярных задач она почти не встречается за пределами крупных строительных организаций с собственным парком операторов.</p>
    <p>Мы предоставляем технику исключительно с экипажем — это значит, что ответственность за безопасную эксплуатацию крана на весь период работ остаётся на нас, а не перекладывается на заказчика в момент подачи техники. Для подавляющего большинства задач, с которыми к нам обращаются — разгрузка, монтаж, подача материалов, — это и есть нужный формат: вам не требуется держать в штате аттестованного крановщика ради разового или периодического использования техники.</p>

    <h2 style="margin:36px 0 18px">Вопросы, которые стоит задать любому подрядчику до заказа</h2>
    <p>Не только нам — любому, у кого вы заказываете кран этого класса в Москве. Это те вопросы, ответы на которые реально влияют на то, пройдёт ли работа без срывов.</p>
    <ul>
      <li><b>«На какой документ ссылается ваш регламент промышленной безопасности?»</b> Если в ответ звучит «ПБ 10-382-00» без дополнительных уточнений — это явный признак неактуализированной нормативной базы, документ отменён с 2014 года. Подробный разбор — в нашей статье о переходе к ФНП №461.</li>
      <li><b>«Кто рассчитывает вылет стрелы под мою площадку — я сам или вы?»</b> Если подрядчик не предлагает сделать этот расчёт на этапе заявки и полагается на то, что вы сами всё оцените правильно, — риск того, что кран не справится с задачей на месте, выше.</li>
      <li><b>«Что будет, если груз окажется тяжелее заявленного?»</b> Ответ должен быть про безопасность (кран не будет поднимать сверх грузовысотной характеристики), а не про готовность рискнуть «в этот раз, наверное, обойдётся».</li>
      <li><b>«Какой оператор будет на объекте и есть ли у него действующее удостоверение?»</b> Право спросить это есть у любого заказчика — и адекватный подрядчик ответит прямо, а не уклончиво.</li>
    </ul>

    <h2 style="margin:36px 0 18px">Где в Москве чаще всего заказывают этот класс техники</h2>
    <p>По нашей практике заявок, кран этого класса чаще всего заказывают в трёх типах локаций. Плотная жилая застройка внутри Садового кольца и в примыкающих районах ЦАО — там, где важна именно манёвренность машины, а не запредельная грузоподъёмность (подробный разбор специфики работы в ЦАО — на отдельной странице). Территории с частной охраной и корпоративные объекты — бизнес-центры, склады, промышленные площадки, где требуется оформление пропуска на технику (см. услугу «Кран на режимный объект»). И типовая жилая застройка среднего пояса Москвы (за пределами ТТК, но в границах МКАД), где чаще всего это разгрузка при капитальном ремонте фасадов и кровель многоквартирных домов.</p>
    <p>Для каждой из этих локаций логика расчёта одна и та же — вес груза и вылет стрелы, — но набор сопутствующих согласований отличается: для ЦАО это чаще перекрытие проезда, для режимных объектов — пропуск, для типовой застройки — обычно минимум формальностей сверх стандартного заказа.</p>

    <h2 style="margin:36px 0 18px">Что не входит в услугу</h2>
    <p>Стропальщик — если на вашем объекте нет своего человека, отвечающего за строповку груза, предупредите об этом при заявке: в части случаев эту функцию может взять на себя оператор крана, но это не гарантировано автоматически и обсуждается заранее, а не по факту приезда техники. Разгрузка и складирование материала после подъёма — кран поднимает и перемещает груз в указанную точку, дальнейшее перемещение и складирование — задача бригады заказчика. Демонтаж существующих конструкций перед монтажом — отдельная услуга, не часть аренды крана. Если что-то из перечисленного нужно на вашем объекте, обсуждаем на этапе заявки — иногда можем организовать по отдельной договорённости, иногда порекомендуем, к кому обратиться.</p>
  </section>

  <section class="section wrap prose" style="padding-top:0">
    <h2 style="margin-bottom:18px">Коротко: что подготовить перед заявкой</h2>
    <ul>
      <li>Точный вес самого тяжёлого груза — по накладной или паспорту изделия, не на глаз.</li>
      <li>Фото или схема площадки, если подъезд не очевиден издалека — арка, узкий двор, стеснённое место.</li>
      <li>Информация про пропускной режим объекта, если он есть — чтобы заложить время на согласование сразу, а не узнать о нём в день выезда.</li>
      <li>Есть ли на объекте свой стропальщик, или эту роль нужно обсуждать отдельно с оператором.</li>
      <li>Желаемая дата и, если есть ограничения по времени (шум в жилой застройке, режим работы объекта) — предпочтительные часы.</li>
    </ul>
    <p>С этим набором данных расчёт стоимости и подбор модели крана занимает минимум времени — большую часть можно сразу прикинуть через <a href="/#zayavka" style="color:var(--yellow)">ориентир по стоимости на главной</a>, а детали уточнить при подтверждении заявки. Если часть данных пока не собрана — не страшно: начните с заявки в том объёме, что есть, остальное уточним вместе на этапе согласования, до подтверждения даты выезда.</p>
  </section>

