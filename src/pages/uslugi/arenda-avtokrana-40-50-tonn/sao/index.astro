---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Sources from '../../../../components/Sources.astro';
import PriceDisclaimer from '../../../../components/PriceDisclaimer.astro';
import { PRICES_VALID_UNTIL } from '../../../../lib/prices';

const title = 'Автокран 40–50 тонн в САО — реконструкция ипподрома';
const description = 'Тяжёлый автокран 40–50 тонн в САО Москвы: логистика для реконструкции Центрального ипподрома на Беговой — новые конюшни и трибуны. Расчёт онлайн.';

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Автокраны 40–50 тонн', item: 'https://moskran-servis.ru/uslugi/arenda-avtokrana-40-50-tonn/' },
    { '@type': 'ListItem', position: 3, name: 'САО', item: 'https://moskran-servis.ru/uslugi/arenda-avtokrana-40-50-tonn/sao/' },
  ],
};
const serviceLd = {
  '@context': 'https://schema.org', '@type': 'Service', serviceType: 'Аренда автокрана 40-50 тонн в САО',
  provider: { '@id': 'https://moskran-servis.ru/#organization' }, areaServed: 'САО, Москва',
};
---
<BaseLayout title={title} description={description} path="/uslugi/arenda-avtokrana-40-50-tonn/sao/" ldExtra={[breadcrumbLd, serviceLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/uslugi/arenda-avtokrana-40-50-tonn/">Автокраны 40–50 тонн</a><span>/</span><span>САО</span>
  </nav>
  <section class="section wrap" style="padding-top:8px">
    <div class="section-head">
      <span class="eyebrow">Автокран 40–50 т · Северный округ</span>
      <h1>Автокран 40–50 тонн в САО</h1>
      <p>На Беговой улице до 2026 года идёт масштабная реконструкция Центрального Московского ипподрома, работающего с 1834 года. Общая площадь инфраструктуры вырастет более чем в 2,5 раза — с нынешних показателей до 115,1 тысячи квадратных метров, вместимость главной зрительской трибуны почти удвоится, до 2 165 мест. Отдельным блоком строится новый конный двор — конюшни на 882 головы, конноспортивный комплекс с тремя манежами, ветеринарный блок с МРТ и КТ и хостел для спортсменов. Для тяжёлого класса техники это не разовый монтаж, а многолетняя стройка с параллельными этапами — реставрацией исторического главного корпуса и возведением новых корпусов конного двора одновременно.</p>
    </div>
  </section>
  <section class="section wrap" style="padding-top:0;padding-bottom:clamp(28px,4vw,44px)">
    <table class="adm">
      <caption>Карточка допуска: автокран 40–50 т на объекте в САО</caption>
      <thead><tr><th scope="col">Требование</th><th scope="col">Что это значит здесь</th><th scope="col">Основание</th></tr></thead>
      <tbody>
        <tr><td data-label="Требование">Разворот тяжёлой машины на Беговой аллее</td><td data-label="Что это значит здесь">Историческая застройка вокруг ипподрома — плотная и невысокая, свободного места под выносные опоры 40–50-тонного класса на прилегающих проездах меньше, чем на широких магистралях округа. Точку установки подбираем по факту ширины проезда у конкретного корпуса, а не по общей ширине улицы.</td><td data-label="Основание">Паспорт ПС</td></tr>
        <tr><td data-label="Требование">Пропуск на территорию стройки</td><td data-label="Что это значит здесь">Площадка реконструкции огорожена и режимна с первого дня работ: список техники и бригады подаётся генподрядчику заранее, отдельно для зоны реставрации главного корпуса и отдельно для нового конного двора.</td><td data-label="Основание">Регламент площадки</td></tr>
        <tr><td data-label="Требование">Какое освидетельствование действует</td><td data-label="Что это значит здесь">Частичное — не реже раза в 12 месяцев, полное — не реже раза в 3 года; на въезде спрашивают паспорт машины с записью и удостоверение оператора.</td><td data-label="Основание">ФНП №461, п. 165 и 189</td></tr>
        <tr><td data-label="Требование">Перекрытие тротуара у главного корпуса</td><td data-label="Что это значит здесь">Если для установки крана на опоры нужно частично занять тротуар или полосу движения вдоль Беговой улицы — согласование с ГИБДД и префектурой округа, заявку подаём заранее.</td><td data-label="Основание">Регламент ГИБДД</td></tr>
      </tbody>
    </table>
  </section>
  <section class="section wrap prose" style="padding-top:0">
    <h2 style="margin-bottom:18px">Реконструкция ипподрома — где именно нужен тяжёлый класс</h2>
    <p>Главный корпус ипподрома площадью 14,25 тысячи квадратных метров реставрируется с сохранением исторического облика — работы там ведёт узкий круг специализированных подрядчиков, для которых внешняя грузоподъёмная техника нужна точечно: разгрузка кровельных и фасадных материалов, монтаж временных конструкций периметра. Основной объём задач для стороннего тяжёлого крана — это новый конный двор и конноспортивный комплекс: монтаж металлических и железобетонных конструкций манежей, установка кровельных ферм пролётом в десятки метров, подача крупногабаритного технологического оборудования ветеринарного блока. Вес отдельных элементов каркаса манежа заметно превышает то, с чем справляется базовый класс техники, — отсюда и потребность именно в 40–50-тонном сегменте, а не в более лёгкой машине.</p>

    <h2 style="margin:36px 0 18px">Беговая аллея и историческое окружение — теснее, чем на Ходынке</h2>
    <p>В отличие от новой застройки Ходынского поля неподалёку (подробный разбор — на <a href="/geo/sao/">гео-странице САО</a>), проезды вокруг ипподрома — узкие исторические аллеи и переулки, где парковка и разгрузка тяжёлой техники ограничены плотной застройкой и охраняемым озеленением территории. Для 40–50-тонного класса это означает более узкий выбор точек установки крана, чем для лёгкой техники: там, где 16-тонный кран ещё встаёт впритык у бордюра, 50-тонному из-за увеличенного радиуса опор такого места уже недостаточно — в таких случаях ищем альтернативную точку на территории самой стройплощадки, а не на городском проезде.</p>

    <h2 style="margin:36px 0 18px">Пропускной режим стройплощадки</h2>
    <p>Главный корпус ипподрома имеет статус объекта культурного наследия, и территория реконструкции огорожена как единая подрядная площадка на весь срок работ — это обычный режимный порядок допуска техники и бригад по списку, схожий с тем, что применяется на других крупных подрядных объектах города; общий порядок оформления такого пропуска разобран на странице услуги <a href="/uslugi/kran-na-rezhimnyy-obekt/" style="color:var(--yellow)">«Кран на режимный объект»</a>. Отдельно уточняем у генподрядчика, к какой из двух зон площадки (реставрация или новое строительство) относится конкретная заявка — режим допуска у них может отличаться.</p>

    <h2 style="margin:36px 0 18px">Цена для объекта в САО</h2>
    <p>Базовая ставка — от 3 900 ₽/час (см. <a href="/#zayavka" style="color:var(--yellow)">ориентир по стоимости на главной</a>), стандартная для этого класса по Москве. Для площадки внутри периметра режимной стройки закладываем дополнительное время на согласование допуска техники и бригады; для работ, требующих частичного перекрытия тротуара или полосы движения у главного корпуса, — отдельно стоимость согласования с ГИБДД, называем её заранее.</p>
    <PriceDisclaimer validUntil={PRICES_VALID_UNTIL} />
  </section>
  <section class="section wrap prose" style="padding-top:0">
    <h2 style="margin-bottom:18px">Что уточняем до выезда именно здесь</h2>
    <p>Для площадки у главного корпуса и конного двора в первую очередь смотрим на реальную ширину свободного проезда вдоль Беговой аллеи по факту, а не по карте — если для установки опор нужно занимать часть проезжей части или тротуара, порядок согласования с ГИБДД разобран в статье про <a href="/spravochnik/soglasovanie-perekrytiya-proezda/">согласование перекрытия проезда</a>. Второй пункт — комплект документов на въезд техники на огороженную подрядную территорию, он шире, чем для разового объекта в жилой застройке: полный список — на странице <a href="/documents/propusk-na-obekt/">«Пропуск на объект»</a>.</p>
    <Sources
      checked="19.08.2026"
      items={[
        { text: 'Приказ Ростехнадзора от 26.11.2020 №461 (ред. от 16.04.2026): п. 108 — площадка и уклон, п. 110 — выносные опоры, п. 165 и 189 — освидетельствование и запись в паспорт', href: 'https://www.consultant.ru/document/cons_doc_LAW_373321/' },
        { text: 'Интерфакс-Россия — вместимость главной трибуны Центрального ипподрома увеличится вдвое после реконструкции, до 2 165 мест', href: 'https://www.interfax-russia.ru/index.php/realty/projects/vmestimost-glavnoy-tribuny-centralnogo-ippodroma-v-moskve-uvelichitsya-vdvoe-posle-rekonstrukcii' },
        { text: 'Ведомости.Город — реконструкция Московского ипподрома завершится в 2026 году; площадь главного корпуса 14,25 тыс. кв. м, общая площадь инфраструктуры вырастет до 115,1 тыс. кв. м, новый конный двор на 882 лошади', href: 'https://www.vedomosti.ru/gorod/culturalcity/articles/zavershitsya-godu' },
      ]}
    />
  </section>
</main>
<style>
  .adm { width: 100%; border-collapse: collapse; margin: 6px 0 0; font-size: var(--t-md); }
  .adm caption { text-align: left; font-family: var(--display); text-transform: uppercase; font-size: var(--t-sm); color: var(--yellow); letter-spacing: .06em; padding-bottom: 12px; }
  .adm th { text-align: left; font-size: var(--t-xs); text-transform: uppercase; letter-spacing: .06em; color: var(--muted); font-weight: 700; padding: 0 14px 8px 0; border-bottom: 1px solid var(--line-strong); }
  .adm td { padding: 13px 14px 13px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
  .adm td:first-child { width: 24%; font-weight: 700; }
  .adm td:last-child { width: 24%; color: var(--muted); font-size: var(--t-md); }
  @media (max-width: 760px) {
    .adm, .adm tbody, .adm tr, .adm td { display: block; width: 100%; }
    .adm thead { display: none; }
    .adm tr { border-bottom: 1px solid var(--line-strong); padding-bottom: 10px; margin-bottom: 10px; }
    .adm td { border: none; padding: 5px 0; }
    .adm td::before { content: attr(data-label); display: block; font-size: var(--t-xs); text-transform: uppercase; letter-spacing: .06em; color: var(--yellow); margin-bottom: 2px; }
    .adm td:first-child, .adm td:last-child { width: 100%; }
  }
</style>
</BaseLayout>
