---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Sources from '../../../../components/Sources.astro';
import PriceDisclaimer from '../../../../components/PriceDisclaimer.astro';
import { PRICES_VALID_UNTIL } from '../../../../lib/prices';

const title = 'Автокран 40–50 тонн в ЗАО — СберСити';
const description = 'Тяжёлый автокран 40–50 тонн в ЗАО Москвы: логистика для мегапроекта «СберСити» на Рублёво-Архангельском — 695 га за МКАД, метро осенью 2026.';

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Автокраны 40–50 тонн', item: 'https://moskran-servis.ru/uslugi/arenda-avtokrana-40-50-tonn/' },
    { '@type': 'ListItem', position: 3, name: 'ЗАО', item: 'https://moskran-servis.ru/uslugi/arenda-avtokrana-40-50-tonn/zao/' },
  ],
};
const serviceLd = {
  '@context': 'https://schema.org', '@type': 'Service', serviceType: 'Аренда автокрана 40-50 тонн в ЗАО',
  provider: { '@id': 'https://moskran-servis.ru/#organization' }, areaServed: 'ЗАО, Москва',
};
---
<BaseLayout title={title} description={description} path="/uslugi/arenda-avtokrana-40-50-tonn/zao/" ldExtra={[breadcrumbLd, serviceLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/uslugi/arenda-avtokrana-40-50-tonn/">Автокраны 40–50 тонн</a><span>/</span><span>ЗАО</span>
  </nav>
  <section class="section wrap" style="padding-top:8px">
    <div class="section-head">
      <span class="eyebrow">Автокран 40–50 т · Западный округ</span>
      <h1>Автокран 40–50 тонн в ЗАО</h1>
      <p>В районе Кунцево, на Захарковской пойме Москвы-реки за МКАД, с 2012 года строится «СберСити» — квартал Рублёво-Архангельское площадью 695 га (под застройку выделено 461 га), которым владеет и который застраивает Сбербанк. К 2035 году здесь планируют около 5 млн кв. м недвижимости разного назначения: первые очереди жилых кварталов уже сданы и заселены, рядом достраивается одноимённая станция метро Рублёво-Архангельской линии — технический пуск уже состоялся, открытие для пассажиров запланировано на сентябрь 2026 года. Это не точечная стройка внутри сложившегося квартала, а параллельное возведение десятков объектов на огромной прежде незастроенной территории.</p>
    </div>
  </section>
  <section class="section wrap" style="padding-top:0;padding-bottom:clamp(28px,4vw,44px)">
    <table class="adm">
      <caption>Карточка допуска: автокран 40–50 т на объекте в ЗАО</caption>
      <thead><tr><th scope="col">Требование</th><th scope="col">Что это значит здесь</th><th scope="col">Основание</th></tr></thead>
      <tbody>
        <tr><td data-label="Требование">Площадка за МКАД без сложившейся инфраструктуры</td><td data-label="Что это значит здесь">Подъездные пути внутри самой территории Рублёво-Архангельского ещё формируются вместе с застройкой — точку установки и маршрут внутри квартала уточняем по актуальной схеме проезда на момент заявки, а не по старой карте.</td><td data-label="Основание">Схема стройплощадки</td></tr>
        <tr><td data-label="Требование">Параллельные очереди строительства</td><td data-label="Что это значит здесь">Жилые корпуса, школьный кампус, набережная и яхтенная марина возводятся одновременно на разных участках — заявки чаще идут не на одну высотную доминанту, а на монтаж и подачу материалов сразу на нескольких небольших объектах поблизости друг от друга.</td><td data-label="Основание">Логистика площадки</td></tr>
        <tr><td data-label="Требование">Среднеэтажная квартальная застройка</td><td data-label="Что это значит здесь">Концепция «европейского города» подразумевает кварталы средней этажности, а не высотные доминанты, как в Москва-Сити, — для такого профиля обычно достаточно техники этого класса без гуська на удлинении.</td><td data-label="Основание">Грузовысотная характеристика</td></tr>
        <tr><td data-label="Требование">Стройка рядом с открывающейся станцией метро</td><td data-label="Что это значит здесь">К осени 2026 года у площадки открывается пассажирское движение — на подъездах к станции возможны временные ограничения проезда на период финальных работ, уточняем перед выездом.</td><td data-label="Основание">Паспорт ПС</td></tr>
      </tbody>
    </table>
  </section>
  <section class="section wrap prose" style="padding-top:0">
    <h2 style="margin-bottom:18px">СберСити — не точечная стройка в Раменках и не режимный объект в Филях</h2>
    <p>В ЗАО у этого сайта уже разобраны два других сценария: точечная застройка отдельными корпусами в Раменках — на <a href="/uslugi/bashennyy-kran/zao/">странице услуги «Башенный кран в ЗАО»</a> — и закрытая площадка ГКНПЦ им. М.В. Хруничева в Филёвской пойме — на <a href="/uslugi/kran-na-rezhimnyy-obekt/zao/">странице услуги «Кран на режимный объект в ЗАО»</a>. Рублёво-Архангельское — принципиально другой случай: не один периметр с уплотнением существующей застройки и не территория с пропускным режимом действующего предприятия, а огромный прежде пустовавший участок поймы за МКАД, который застраивается кварталами практически с нуля по единому мастер-плану.</p>

    <h2 style="margin:36px 0 18px">Что уже построено и что строится сейчас</h2>
    <p>Первые жилые кварталы сданы и заселены — по проекту это среднеэтажная квартальная застройка «европейского» типа, без высотных доминант. Параллельно ведётся строительство социальной инфраструктуры: планируется семь общеобразовательных школ, тринадцать детских садов, образовательный кампус «Школа 21», медицинские учреждения. Отдельная часть работ — благоустройство набережных, парков и яхтенной марины, а также крытый центр для занятий сёрфингом. Для автокрана 40–50 тонн это означает разнородные по характеру заявки на одной территории: от монтажа модульных конструкций школьного кампуса до подачи материалов на объекты благоустройства набережной — не одна большая задача, а множество параллельных участков в рамках одной стройки.</p>

    <h2 style="margin:36px 0 18px">Метро на площадке — фактор логистики, а не просто удобство</h2>
    <p>Рублёво-Архангельская линия метро должна связать СберСити с деловым центром «Москва-Сити»; станция на территории проекта уже прошла технический пуск, открытие для пассажиров намечено на сентябрь 2026 года. До открытия и в первые недели после него на подъездах к станции возможны временные схемы движения и ограничения на период финальных отделочных и благоустроительных работ — это стоит уточнять отдельно для каждой конкретной точки установки крана рядом со станцией, а не полагаться на общую схему проезда по территории.</p>

    <h2 style="margin:36px 0 18px">Цена для объекта в ЗАО</h2>
    <p>Базовая ставка — от 3 900 ₽/час (см. <a href="/#zayavka" style="color:var(--yellow)">ориентир по стоимости на главной</a>). Территория Рублёво-Архангельского расположена за МКАД, поэтому подача техники сюда чуть дальше, чем до Раменок или Кунцева в центральной части округа, — стоимость подачи для конкретного участка внутри квартала называем по факту адреса и текущей схемы проезда на площадке, а не усреднённо по всему проекту.</p>
    <PriceDisclaimer validUntil={PRICES_VALID_UNTIL} />
  </section>
  <section class="section wrap prose" style="padding-top:0">
    <h2 style="margin-bottom:18px">Что уточняем до выезда именно здесь</h2>
    <p>Для площадки на большой территории с продолжающимся строительством в первую очередь уточняем актуальную схему проезда внутри квартала — она меняется по мере ввода новых участков, и старая схема может не совпадать с текущей. Второй пункт — комплект документов на въезд техники на огороженную стройплощадку, полный список — на странице <a href="/documents/propusk-na-obekt/">«Пропуск на объект»</a>. Периодичность технического освидетельствования техники — та же, что и для любого другого округа: подробности в статье про <a href="/spravochnik/tehnicheskoe-osvidetelstvovanie-krana/">техническое освидетельствование крана</a>.</p>
    <Sources
      checked="19.08.2026"
      items={[
        { text: 'Приказ Ростехнадзора от 26.11.2020 №461 (ред. от 16.04.2026): п. 108 — площадка и уклон, п. 165 и 189 — освидетельствование и запись в паспорт', href: 'https://www.consultant.ru/document/cons_doc_LAW_373321/' },
        { text: 'Krylatskoye.ru — Рублёво-Архангельское (СберСити): 695 га территории, 461 га под застройку, владелец с 2012 года — Сбербанк, ~5 млн кв. м недвижимости к 2035 году, кампус «Школа 21», марина, крытый сёрф-центр', href: 'https://www.krylatskoye.ru/content/today/2026/04/rublevo-arkhangelskoe-chto-eto.html' },
        { text: 'М24.ru — Сергей Собянин назвал ключевые строительные проекты 2026 года: Рублёво-Архангельская линия метро — технический пуск состоялся, открытие в сентябре', href: 'https://www.m24.ru/news/05082026/927536' },
      ]}
    />
  </section>
</main>
<style>
  .adm { width: 100%; border-collapse: collapse; margin: 6px 0 0; font-size: var(--t-md); }
  .adm caption { text-align: left; font-family: var(--display); text-transform: uppercase; font-size: var(--t-sm); color: var(--yellow); letter-spacing: .06em; padding-bottom: 12px; }
  .adm th { text-align: left; font-size: var(--t-xs); text-transform: uppercase; letter-spacing: .06em; color: var(--muted); font-weight: 700; padding: 0 14px 8px 0; border-bottom: 1px solid var(--line-strong); }
  .adm td { padding: 13px 14px 13px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
  .adm td:first-child { width: 24%; font-weight: 700; }
  .adm td:last-child { width: 24%; color: var(--muted); font-size: var(--t-md); }
  @media (max-width: 760px) {
    .adm, .adm tbody, .adm tr, .adm td { display: block; width: 100%; }
    .adm thead { display: none; }
    .adm tr { border-bottom: 1px solid var(--line-strong); padding-bottom: 10px; margin-bottom: 10px; }
    .adm td { border: none; padding: 5px 0; }
    .adm td::before { content: attr(data-label); display: block; font-size: var(--t-xs); text-transform: uppercase; letter-spacing: .06em; color: var(--yellow); margin-bottom: 2px; }
    .adm td:first-child, .adm td:last-child { width: 100%; }
  }
</style>
</BaseLayout>
