---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Sources from '../../../../components/Sources.astro';
import PriceDisclaimer from '../../../../components/PriceDisclaimer.astro';
import { PRICES_VALID_UNTIL } from '../../../../lib/prices';

const title = 'Автокран 40–50 тонн в СЗАО — Мнёвниковская пойма';
const description = 'Тяжёлый автокран 40–50 тонн в СЗАО Москвы: параллельная стройка жилья, спорта и делового центра на Мнёвниковской пойме. Расчёт заявки онлайн.';

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Автокраны 40–50 тонн', item: 'https://moskran-servis.ru/uslugi/arenda-avtokrana-40-50-tonn/' },
    { '@type': 'ListItem', position: 3, name: 'СЗАО', item: 'https://moskran-servis.ru/uslugi/arenda-avtokrana-40-50-tonn/szao/' },
  ],
};
const serviceLd = {
  '@context': 'https://schema.org', '@type': 'Service', serviceType: 'Аренда автокрана 40-50 тонн в СЗАО',
  provider: { '@id': 'https://moskran-servis.ru/#organization' }, areaServed: 'СЗАО, Москва',
};
---
<BaseLayout title={title} description={description} path="/uslugi/arenda-avtokrana-40-50-tonn/szao/" ldExtra={[breadcrumbLd, serviceLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/uslugi/arenda-avtokrana-40-50-tonn/">Автокраны 40–50 тонн</a><span>/</span><span>СЗАО</span>
  </nav>
  <section class="section wrap" style="padding-top:8px">
    <div class="section-head">
      <span class="eyebrow">Автокран 40–50 т · Северо-Западный округ</span>
      <h1>Автокран 40–50 тонн в СЗАО</h1>
      <p>Базовая ставка тяжёлого класса 40–50 тонн в СЗАО — от 3 900 ₽/час, а стоимость подачи на Мнёвниковскую пойму зависит от того, какой въезд на остров открыт на дату заявки: мост «Парус» на Филёвскую пойму откроется только в 2027 году, и до этого часть маршрутов идёт в объезд. Сама пойма даёт не одну постоянную точку работы, а серию разных заявок: жилой квартал «Остров» сдаётся очередями, Международная академия хоккея уже на внешней отделке со сдачей во втором квартале 2027 года, площадка цирка ещё не вышла из бытового городка.</p>
      <p>На Мнёвниковской пойме (район Хорошёво-Мнёвники) одновременно идёт стройка жилого квартала, спортивного комплекса и делового центра — три разных типа объектов на одной территории, каждый на своей стадии готовности. Для тяжёлого класса техники это означает не одну постоянную точку работы, а серию разных по характеру заявок в границах одного логистического узла: от разгрузки ЖБИ на жилой секции до монтажа технологического оборудования на площадке спортивного объекта, который только заложил бытовой городок.</p>
    </div>
  </section>
  <section class="section wrap" style="padding-top:0;padding-bottom:clamp(28px,4vw,44px)">
    <table class="adm">
      <caption>Карточка допуска: автокран 40–50 т на объекте в СЗАО</caption>
      <thead><tr><th scope="col">Требование</th><th scope="col">Что это значит здесь</th><th scope="col">Основание</th></tr></thead>
      <tbody>
        <tr><td data-label="Требование">Разные стадии на соседних участках</td><td data-label="Что это значит здесь">Готовое здание («Галерея Острова»), объект с уже видимой отделкой фасада (хоккейная академия) и площадка с бытовками (цирк) стоят в сотнях метров друг от друга — маршрут и точка постановки крана зависят от конкретного пятна, а не от общей схемы поймы.</td><td data-label="Основание">Схема стройплощадки</td></tr>
        <tr><td data-label="Требование">Подъезд через развивающуюся дорожную сеть</td><td data-label="Что это значит здесь">Северо-Западная хорда уже проложена через остров, но мост «Парус» на Новозаводскую улицу и Филёвскую пойму ещё строится — до его открытия в 2027 году часть маршрутов подачи техники идёт в объезд, уточняем по факту адреса.</td><td data-label="Основание">Схема проезда на дату заявки</td></tr>
        <tr><td data-label="Требование">Крупнопролётные конструкции спортивных объектов</td><td data-label="Что это значит здесь">Ледовая арена и хоккейная академия — это большие пролёты кровли и тяжёлые технологические узлы (холодильное оборудование ледового поля), что чаще требует техники этого класса, чем типовая жилая секция.</td><td data-label="Основание">Грузовысотная характеристика</td></tr>
        <tr><td data-label="Требование">Площадка рядом с метро БКЛ</td><td data-label="Что это значит здесь">Станции «Терехово» и «Мневники» уже работают — рядом действует пешеходный трафик и техническая зона метрополитена мелкого заложения, порядок допуска для точек в 40-метровой зоне разбираем на общей странице услуги «Кран на режимный объект».</td><td data-label="Основание">Приказ Москомархитектуры №52</td></tr>
      </tbody>
    </table>
  </section>
  <section class="section wrap prose" style="padding-top:0">
    <h2 style="margin-bottom:18px">Мнёвниковская пойма — не продолжение Строгинской и Тушинской</h2>
    <p>В СЗАО у этого сайта уже разобрана прибрежная застройка Строгинской и Тушинской поймы — на <a href="/geo/szao/">гео-странице округа</a> и на странице услуги <a href="/uslugi/bashennyy-kran/szao/">«Башенный кран в СЗАО»</a>, где расчёт фундамента ведётся с поправкой на пойменный грунт у самой реки. Мнёвниковская пойма — на другом, южном берегу того же изгиба Москвы-реки, в границах района Хорошёво-Мнёвники, и это принципиально другой случай: не жилой массив у воды с устоявшейся инфраструктурой, а искусственно намытая территория, которую застраивают с нуля последние несколько лет параллельно с прокладкой метро и хорды.</p>

    <h2 style="margin:36px 0 18px">Что уже стоит и что ещё строится</h2>
    <p>Жилой квартал «Остров» частично сдан — секции вводятся очередями, а не единым пуском. Рядом уже работает торговый центр «Галерея Острова» и достраивается многофункциональный комплекс у станции «Мневники». Отдельно, ближе к набережной, идёт стройка Международной академии хоккея Александра Овечкина — по состоянию на 2026 год здание уже находится на этапе внешней отделки, сдача запланирована на второй квартал 2027 года. Ещё один объект, цирк, — на начальной стадии: рабочие только заканчивают бытовой городок, до монтажа несущих конструкций там дальше, чем до открытия хоккейной академии. Для автокрана 40–50 тонн это значит, что заявки с одного и того же почтового индекса могут различаться по задаче почти полностью: подача материалов на отделочный этап одного объекта и подготовительные работы на площадке другого, ещё не вышедшего из нулевого цикла.</p>

    <h2 style="margin:36px 0 18px">Дорожная сеть строится вместе с застройкой</h2>
    <p>Через остров уже проложена Северо-Западная хорда, а рядом с зарядной станцией электробусов заканчивают благоустройство набережных. Но полноценной связи с противоположным, Филёвским берегом пока нет: автомобильно-пешеходный мост «Парус», который соединит Новозаводскую улицу в Филёвской пойме с проектируемым проездом №1165 на Мнёвниковской, должен открыться в 2027 году — до этого момента часть маршрутов подачи техники к площадкам ближе к реке идёт в объезд через основные въезды на остров, а не по прямой линии на карте. Тот же мост, только с другой стороны реки, упоминается на странице услуги <a href="/uslugi/kran-na-rezhimnyy-obekt/zao/">«Кран на режимный объект в ЗАО»</a> — Филёвская пойма ждёт эту же связь как продолжение освоения территории ГКНПЦ им. Хруничева.</p>

    <h2 style="margin:36px 0 18px">Цена работы в СЗАО</h2>
    <p>Базовая ставка — от 3 900 ₽/час (см. <a href="/#zayavka" style="color:var(--yellow)">ориентир по стоимости на главной</a>). Для площадок на Мнёвниковской пойме стоимость подачи техники зависит от того, какой въезд на остров действует на дату заявки, — называем её после уточнения маршрута, а не по прямому расстоянию от МКАД до точки на карте.</p>
    <PriceDisclaimer validUntil={PRICES_VALID_UNTIL} />
  </section>
  <section class="section wrap prose" style="padding-top:0">
    <h2 style="margin-bottom:18px">Что уточняем до выезда именно здесь</h2>
    <p>Для площадки на активно застраиваемой территории в первую очередь уточняем, какой из объектов на пойме нужен — готовый, отделываемый или только начатый: от этого зависит и класс задачи, и доступность подъезда. Несущую способность площадки под опоры на насыпном грунте намытой территории проверяем отдельно, не полагаясь на паспорт соседнего, уже сданного участка — общий разбор в статье про <a href="/spravochnik/nesushchaya-sposobnost-grunta/">несущую способность грунта</a>. Периодичность технического освидетельствования техники — та же, что и для любого другого округа: <a href="/spravochnik/tehnicheskoe-osvidetelstvovanie-krana/">техническое освидетельствование крана</a>.</p>
    <Sources
      checked="21.08.2026"
      items={[
        { text: 'Приказ Ростехнадзора от 26.11.2020 №461 (ред. от 16.04.2026): п. 108 — площадка и уклон, п. 165 и 189 — освидетельствование и запись в паспорт', href: 'https://www.consultant.ru/document/cons_doc_LAW_373321/' },
        { text: 'stroi.mos.ru — стройки района Хорошёво-Мнёвники: транспортная развязка на Мнёвниковской пойме с мостовым сооружением через Москву-реку', href: 'https://stroi.mos.ru/stroitelstvo-v-okrugah-raionah/stroitelstvo-v-szao/horoshevo-mnevniki' },
        { text: 'МСК1.ру — Мнёвниковская пойма, август 2026: ЖК «Остров», станции БКЛ «Терехово» и «Мневники», Международная академия хоккея Александра Овечкина (внешняя отделка, сдача 2 кв. 2027), мост «Парус» (открытие 2027), Северо-Западная хорда', href: 'https://msk1.ru/text/gorod/2026/08/12/76580000/' },
      ]}
      note="Стадия готовности каждого объекта на пойме (жильё, торговый центр, хоккейная академия, цирк) — по состоянию источника на август 2026 года, для конкретной заявки уточняем на дату обращения, а не по этому снимку."
    />
  </section>
</main>
<style>
  .adm { width: 100%; border-collapse: collapse; margin: 6px 0 0; font-size: var(--t-md); }
  .adm caption { text-align: left; font-family: var(--display); text-transform: uppercase; font-size: var(--t-sm); color: var(--yellow); letter-spacing: .06em; padding-bottom: 12px; }
  .adm th { text-align: left; font-size: var(--t-xs); text-transform: uppercase; letter-spacing: .06em; color: var(--muted); font-weight: 700; padding: 0 14px 8px 0; border-bottom: 1px solid var(--line-strong); }
  .adm td { padding: 13px 14px 13px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
  .adm td:first-child { width: 24%; font-weight: 700; }
  .adm td:last-child { width: 24%; color: var(--muted); font-size: var(--t-md); }
  @media (max-width: 760px) {
    .adm, .adm tbody, .adm tr, .adm td { display: block; width: 100%; }
    .adm thead { display: none; }
    .adm tr { border-bottom: 1px solid var(--line-strong); padding-bottom: 10px; margin-bottom: 10px; }
    .adm td { border: none; padding: 5px 0; }
    .adm td::before { content: attr(data-label); display: block; font-size: var(--t-xs); text-transform: uppercase; letter-spacing: .06em; color: var(--yellow); margin-bottom: 2px; }
    .adm td:first-child, .adm td:last-child { width: 100%; }
  }
</style>
</BaseLayout>
