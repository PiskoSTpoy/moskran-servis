const title = 'Аренда автокрана 40–50 тонн в Москве — тяжёлые монтажи';
const description = 'Автокран 40–50 тонн в аренду в Москве: тяжёлые монтажи, крупногабаритное оборудование, увеличенный вылет. Согласование маршрута, расчёт онлайн.';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Услуги', item: 'https://moskran-servis.ru/#uslugi' },
    { '@type': 'ListItem', position: 3, name: 'Автокраны 40–50 тонн', item: 'https://moskran-servis.ru/uslugi/arenda-avtokrana-40-50-tonn/' },
  ],
};

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Аренда автокрана 40-50 тонн',
  provider: { '@id': 'https://moskran-servis.ru/#organization' },
  areaServed: 'Москва',
  offers: {
    '@type': 'Offer',
    // Аренда, а НЕ продажа. Без явного businessFunction значение по умолчанию —
    // Sell, то есть разметка объявляла бы продажу крана за эту сумму. Техника
    // передаётся во временное пользование (с экипажем, ст. 632 ГК) — LeaseOut.
    businessFunction: 'http://purl.org/goodrelations/v1#LeaseOut',
    priceCurrency: 'RUB',
    price: '3900',
    priceSpecification: { '@type': 'UnitPriceSpecification', price: '3900', priceCurrency: 'RUB', unitText: 'HOUR' },
  },
};

const faqs = [
  {
    q: 'Когда 50-тонный кран — это уже избыточно, а когда необходимо?',
    a: 'Избыточно — если задача укладывается в возможности 25–32-тонной техники на нужном вылете: переплата за более тяжёлый класс без технической необходимости не идёт на пользу заказчику. Необходимо — когда либо груз объективно тяжёлый (от 10–12 тонн), либо когда сочетание веса и большого вылета выходит за грузовысотную характеристику 32–40-тонного класса. Точный ответ даёт только расчёт по факту веса и вылета, а не эмпирическое «на всякий случай побольше».',
  },
  {
    q: 'Нужно ли согласовывать проезд крана этого класса по городу?',
    a: 'В большинстве случаев транспортное (нерабочее) положение автокрана 40–50 тонн укладывается в стандартные габариты дорожного движения без спецразрешения. Исключение — отдельные мосты, эстакады и путепроводы с ограничением по нагрузке на конкретном участке маршрута: если путь к объекту проходит через такое сооружение, уточняем допустимость проезда заранее, до дня выезда.',
  },
  {
    q: 'Какой запас времени нужен на подготовку площадки для этого класса техники?',
    a: 'Больше, чем для младших классов: помимо самой площадки под опоры (порядка 8×8–9×9 м) нужно время на оценку грунта — при полном вылете и максимальной загрузке нагрузка на одну выносную опору у техники этого класса может достигать значений, при которых стандартных инвентарных подкладок недостаточно и требуется усиленное основание. Мы оцениваем это по фото или геологическим данным площадки заранее, не по факту установки крана.',
  },
  {
    q: 'Можно ли использовать удлинитель стрелы (гусёк) для увеличения высоты подъёма?',
    a: 'У части моделей этого класса — да, гусёк добавляет несколько метров высоты подъёма ценой снижения грузоподъёмности на увеличенном участке стрелы. Применимость гуська под конкретную задачу (вес груза на итоговой высоте и вылете) считаем при расчёте — это не автоматическая опция «для запаса», а отдельный параметр грузовысотной характеристики.',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<BaseLayout title={title} description={description} path="/uslugi/arenda-avtokrana-40-50-tonn/" ldExtra={[breadcrumbLd, serviceLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/#uslugi">Услуги</a><span>/</span><span>Автокраны 40–50 тонн</span>
  </nav>

  <section class="section wrap" style="padding-top:8px">
    <div class="section-head">
      <span class="eyebrow">Услуга</span>
      <h1>Аренда автокрана 40–50 тонн в Москве</h1>
      <p>Автокран 40–50 тонн — верхняя граница нашей линейки: телескопическая стрела 34–43 метра, высота подъёма крюка порядка 40–52 метров, пятно под выносными опорами 8×8–9×9 метров, базовая ставка от 3 900 ₽/час для 50-тонного класса. Берут его там, где тяжёлый груз и вылет 18–25 метров нужны одновременно, а не по отдельности: на одном только вылете хватило бы и среднего класса.</p>
      <p>Верхняя граница диапазона автокранов в нашей линейке — для задач, где сочетаются тяжёлый груз и увеличенный вылет одновременно, или где сам вес единичного элемента превышает возможности среднего класса техники.</p>
    </div>
  </section>

  <section class="section wrap" style="padding-top:0;padding-bottom:clamp(30px,4vw,48px)">
    <p class="prose" style="color:var(--muted);margin-bottom:22px">У верхнего класса автокранов к нормативной части добавляется транспортная: такую машину надо ещё довезти. Ниже — полный набор, который проверяется до подтверждения даты.</p>
    <table class="adm">
      <caption>Карточка допуска техники</caption>
      <thead><tr><th scope="col">Требование</th><th scope="col">Что именно проверяется</th><th scope="col">Срок действия</th><th scope="col">Кто подписывает</th></tr></thead>
      <tbody>
        <tr><td data-label="Требование">Паспорт подъёмного сооружения</td><td data-label="Что именно проверяется">Результаты технического освидетельствования записываются в паспорт с указанием срока следующего. Паспорт без свежей записи не подтверждает ничего: срок проверить нечем.</td><td data-label="Срок действия">актуален по дате последней записи</td><td data-label="Кто подписывает">инженерно-технический работник, ответственный за производственный контроль</td></tr>
        <tr><td data-label="Требование">Частичное техническое освидетельствование</td><td data-label="Что именно проверяется">Осмотр без статических и динамических испытаний: состояние металлоконструкций, канатов, приборов и устройств безопасности.</td><td data-label="Срок действия">не реже одного раза в 12 месяцев</td><td data-label="Кто подписывает">ответственный за производственный контроль при участии ответственного за содержание ПС</td></tr>
        <tr><td data-label="Требование">Полное техническое освидетельствование</td><td data-label="Что именно проверяется">Осмотр плюс испытания: статические — грузом 125 % от паспортной грузоподъёмности, динамические — грузом на 10 % выше паспортной.</td><td data-label="Срок действия">не реже одного раза в 3 года (для редко используемых ПС — раз в 5 лет)</td><td data-label="Кто подписывает">ответственный за производственный контроль при участии ответственного за содержание ПС</td></tr>
        <tr><td data-label="Требование">Квалификация оператора</td><td data-label="Что именно проверяется">Документ о квалификации и действующий результат проверки знаний. Это законный вопрос заказчика, а не проявление недоверия.</td><td data-label="Срок действия">по установленной эксплуатирующей организацией периодичности</td><td data-label="Кто подписывает">комиссия эксплуатирующей организации</td></tr>
        <tr><td data-label="Требование">Приказы о назначении ответственных</td><td data-label="Что именно проверяется">Три разные роли: за производственный контроль, за содержание ПС в работоспособном состоянии, за безопасное производство работ с применением ПС.</td><td data-label="Срок действия">до отмены или замены приказа</td><td data-label="Кто подписывает">руководитель эксплуатирующей организации</td></tr>
        <tr><td data-label="Требование">Допуск машины в город</td><td data-label="Что именно проверяется">Разрешённая масса заведомо больше 3,5 т, поэтому в границах МКАД нужен пропуск грузового каркаса и регистрация в системе РНИС. Это про машину, а не про объект.</td><td data-label="Срок действия">по сроку действия пропуска</td><td data-label="Кто подписывает">оформляет владелец транспортного средства</td></tr>
        <tr><td data-label="Требование">Маршрут с учётом ограничений</td><td data-label="Что именно проверяется">Мосты и путепроводы с ограничением по массе задают маршрут не меньше, чем адрес объекта. Проверяется до выезда, а не по факту упёршейся машины.</td><td data-label="Срок действия">на конкретный выезд</td><td data-label="Кто подписывает">диспетчер и водитель</td></tr>
      </tbody>
    </table>
    <ul class="adm-links">
      <li><a href="/spravochnik/markirovka-negabarita-pri-transportirovke/">Знак «Крупногабаритный груз» →</a></li>
      <li><a href="/spravochnik/nesushchaya-sposobnost-grunta/">Несущая способность грунта →</a></li>
      <li><a href="/spravochnik/tehnicheskoe-osvidetelstvovanie-krana/">Освидетельствование →</a></li>
      <li><a href="/spravochnik/gruppa-rezhima-krana/">Группа режима работы →</a></li>
    </ul>
  </section>
  <section class="section wrap prose" style="padding-top:0">
    <h2 style="margin-bottom:18px">Для каких задач нужен именно этот класс</h2>
    <p><b>Крупногабаритное инженерное оборудование.</b> Котельные установки, тяжёлые компрессорные станции, крупные градирни — вес единичного элемента нередко превышает 12–15 тонн, а устанавливать его нужно на кровлю или в глубине промышленной площадки.</p>
    <p><b>Тяжёлые монтажи с увеличенным вылетом.</b> Когда кран физически не может подъехать ближе определённой границы (котлован, уже возведённая часть здания, инженерные сети под землёй) и приходится работать на вылете 18–25 метров и больше — на таком расстоянии даже относительно некрупный по абсолютному весу груз может требовать техники этого класса.</p>
    <p><b>Демонтаж тяжёлых конструкций.</b> Спуск крупных элементов при реконструкции или аварийном демонтаже — вес демонтируемого элемента часто известен с меньшей точностью, чем вес нового груза по проектной документации, поэтому для таких задач закладываем повышенный запас по грузоподъёмности.</p>

    <h2 style="margin:36px 0 18px">Технические параметры</h2>
    <p>Автокраны 40–50 тонн этого сегмента обычно имеют телескопическую стрелу длиной 34–43 метра (с возможностью удлинения гуськом у части моделей), максимальную высоту подъёма крюка порядка 40–52 метров. Минимальный радиус разворота у этого класса заметно больше, чем у 16–25-тонной техники — для реально тесных дворов такая машина может физически не подойти, и в подобных случаях либо ищем альтернативную точку установки на площадке, либо предлагаем гусеничный кран, если вылет позволяет обойтись без выносных опор на грунте с ограниченной несущей способностью.</p>
    <p>На полном вылете опор кран занимает площадь порядка 8–9 метров в каждую сторону от оси — это стоит проверять заранее для площадок с ограниченным пространством, а не по факту прибытия техники.</p>

    <h2 style="margin:36px 0 18px">Нагрузка на грунт под выносными опорами</h2>
    <p>Чем тяжелее класс техники, тем больше нагрузка на каждую отдельную выносную опору при полном вылете и максимальной загрузке. Для 40–50-тонного класса это может означать необходимость не просто инвентарных подкладок, а усиленного основания — металлических плит увеличенной площади или, для действительно слабого грунта, предварительной подготовки площадки силами заказчика. Мы оцениваем несущую способность грунта по доступным данным (тип покрытия, наличие подземных коммуникаций, результаты геологических изысканий, если они есть у заказчика) на этапе расчёта заявки — если есть сомнение, просим фото площадки и, при необходимости, рекомендуем консультацию с проектировщиком до выезда техники.</p>

    <h2 style="margin:36px 0 18px">Согласование маршрута к объекту</h2>
    <p>Автокран 40–50 тонн в транспортном положении в большинстве случаев остаётся в пределах стандартных габаритов для проезда по городским дорогам без специального разрешения на перевозку крупногабаритного/тяжеловесного груза — в отличие от гусеничных кранов, которые перевозятся на трале и требуют отдельного оформления. Реальное ограничение маршрута для этого класса — не общие правила дорожного движения, а конкретные мосты и путепроводы с ограничением по массе на отдельных участках: если маршрут к объекту проходит через такое сооружение, уточняем допустимую нагрузку заранее и, если нужно, прокладываем маршрут в объезд.</p>

    <h2 style="margin:36px 0 18px">Что нужно подготовить на площадке</h2>
    <ul>
      <li>Площадка под выносные опоры 8×8–9×9 м с твёрдым покрытием, способным выдержать нагрузку этого класса техники.</li>
      <li>Подъездной путь шириной от 4,5 метров.</li>
      <li>Точный вес груза по проектной документации — для этого класса цена ошибки в оценке веса выше, чем для более лёгкой техники.</li>
      <li>Данные о грунте под предполагаемой точкой установки, если площадка не имеет капитального твёрдого покрытия.</li>
      <li>Схема маршрута подъезда, если объект расположен за пределами МКАД и путь проходит через мосты или путепроводы с возможным ограничением нагрузки.</li>
    </ul>

    <h2 style="margin:36px 0 18px">Документы и безопасность</h2>
    <p>Техника этого класса эксплуатируется по действующим ФНП №461 (Приказ Ростехнадзора от 26.11.2020, актуальная редакция), с более частой периодичностью полного технического освидетельствования по сравнению с лёгкой техникой — из-за повышенной нагрузки на металлоконструкцию. Оператор аттестован на управление техникой соответствующего класса — это отдельная категория допуска, не автоматически совпадающая с правом управления 16–25-тонным краном. По запросу предоставляем документы на технику и удостоверение оператора вместе с договором.</p>

    <h2 style="margin:36px 0 18px">Как формируется цена</h2>
    <p>Базовая ставка — от 3 900 ₽/час для 50-тонного класса (см. <a href="/#zayavka" style="color:var(--yellow)">ориентир по стоимости на главной</a>), минимальный заказ от одной смены. К базовой ставке применимы стандартные надбавки сети услуг: пропускной режим (+12%), работы в выходные/праздники — отдельным тарифом, подача техники — по расстоянию до объекта. Для объектов со сложной логистикой подъезда (через путепроводы с ограничением, через объекты со сложным согласованием проезда) стоимость подачи и сроки называем индивидуально после оценки маршрута.</p>
    <PriceDisclaimer validUntil={PRICES_VALID_UNTIL} />
  </section>

