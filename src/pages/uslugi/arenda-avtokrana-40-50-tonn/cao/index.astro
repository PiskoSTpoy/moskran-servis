---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Sources from '../../../../components/Sources.astro';
import PriceDisclaimer from '../../../../components/PriceDisclaimer.astro';
import { PRICES_VALID_UNTIL } from '../../../../lib/prices';

const title = 'Автокран 40–50 тонн в ЦАО — новая башня Москва-Сити';
const description = 'Тяжёлый автокран 40–50 тонн в ЦАО Москвы: логистика тяжёлого класса рядом со стройплощадкой 400-метровой башни Wildberries в Москва-Сити. Расчёт онлайн.';

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Автокраны 40–50 тонн', item: 'https://moskran-servis.ru/uslugi/arenda-avtokrana-40-50-tonn/' },
    { '@type': 'ListItem', position: 3, name: 'ЦАО', item: 'https://moskran-servis.ru/uslugi/arenda-avtokrana-40-50-tonn/cao/' },
  ],
};
const serviceLd = {
  '@context': 'https://schema.org', '@type': 'Service', serviceType: 'Аренда автокрана 40-50 тонн в ЦАО',
  provider: { '@id': 'https://moskran-servis.ru/#organization' }, areaServed: 'ЦАО, Москва',
};
---
<BaseLayout title={title} description={description} path="/uslugi/arenda-avtokrana-40-50-tonn/cao/" ldExtra={[breadcrumbLd, serviceLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/uslugi/arenda-avtokrana-40-50-tonn/">Автокраны 40–50 тонн</a><span>/</span><span>ЦАО</span>
  </nav>
  <section class="section wrap" style="padding-top:8px">
    <div class="section-head">
      <span class="eyebrow">Автокран 40–50 т · Центральный округ</span>
      <h1>Автокран 40–50 тонн в ЦАО</h1>
      <p>На участке 16/1 по Краснопресненской набережной в комплексе Москва-Сити в августе 2025 года получено разрешение на строительство будущей штаб-квартиры Wildberries — башни высотой около 400 метров и 75 этажей, которая станет выше нынешнего лидера города, «Федерации» (374 м). Для тяжёлого класса техники такая стройка — это не про монтаж самого каркаса небоскрёба (там работают собственные высотные механизмы застройщика), а про логистику вокруг площадки: разгрузку инженерных модулей на складской зоне, монтаж временных сооружений периметра, работы по смежным коммуникациям, которые неизбежно сопровождают проект такого масштаба.</p>
    </div>
  </section>
  <section class="section wrap" style="padding-top:0;padding-bottom:clamp(28px,4vw,44px)">
    <table class="adm">
      <caption>Карточка допуска: автокран 40–50 т в ЦАО</caption>
      <thead><tr><th scope="col">Требование</th><th scope="col">Что это значит здесь</th><th scope="col">Основание</th></tr></thead>
      <tbody>
        <tr><td data-label="Требование">Пропуск на территорию мегастройки</td><td data-label="Что это значит здесь">Площадки такого масштаба, как участок 16/1, режимные с первого дня строительства: список техники и бригады подаётся заранее генподрядчику, а не оформляется на въезде в день работ.</td><td data-label="Основание">Регламент площадки</td></tr>
        <tr><td data-label="Требование">Разворот тяжёлой машины в центре</td><td data-label="Что это значит здесь">40–50-тонный класс занимает под опорами до 8–9 м в каждую сторону — заметно больше, чем базовый класс, а свободного места на большинстве улиц исторической застройки ЦАО именно столько и нет. Точку установки для такой машины подбираем по факту ширины проезда, а не по общему впечатлению «в центре тесно».</td><td data-label="Основание">Паспорт ПС</td></tr>
        <tr><td data-label="Требование">Какое освидетельствование действует</td><td data-label="Что это значит здесь">Частичное — не реже раза в 12 месяцев, полное — не реже раза в 3 года; результат и срок следующего — запись в паспорте машины.</td><td data-label="Основание">ФНП №461, п. 165 и 189</td></tr>
        <tr><td data-label="Требование">Перекрытие проезда рядом с крупным объектом</td><td data-label="Что это значит здесь">Если для установки крана на выносные опоры нужно частично занять проезжую часть или тротуар возле стройплощадки — согласование с ГИБДД и, для магистральных улиц, с префектурой округа. Заявку подаём заранее, а не по факту прибытия техники.</td><td data-label="Основание">Регламент ГИБДД</td></tr>
      </tbody>
    </table>
  </section>
  <section class="section wrap prose" style="padding-top:0">
    <h2 style="margin-bottom:18px">Стройка нового лидера высоты — что это значит для логистики техники</h2>
    <p>Проект будущей штаб-квартиры Wildberries реализует компания РВБ — единая структура маркетплейса Wildberries и группы Russ. Общая площадь комплекса превысит 202 600 кв. м, из них порядка 128 000 кв. м — офисные помещения, рассчитанные на работу около 17 тысяч человек. Завершение стройки запланировано на 2031 год — то есть речь о многолетнем проекте с постоянным потоком подрядных работ вокруг основной башни, а не о разовом монтаже.</p>
    <p>Для проектов такого масштаба основной вертикальный подъём берут на себя собственные краны генподрядчика, рассчитанные на высотное строительство. Но по периметру площадки — на логистических дворах, при монтаже ограждения, временных бытовых городков и инженерных сетей для смежной инфраструктуры — регулярно нужна более манёвренная техника среднего и тяжёлого класса, которую удобнее привлекать со стороны, чем держать в простое на объекте, где основной объём работ выполняет специализированный высотный кран.</p>

    <h2 style="margin:36px 0 18px">Историческая застройка вокруг — не только у башен</h2>
    <p>За пределами самой территории Москва-Сити округ остаётся плотным историческим центром: узкие переулки, дворы-колодцы, дома со статусом объекта культурного наследия — подробный разбор специфики районов ЦАО и логики подбора техники под конкретный двор есть на <a href="/geo/cao/">гео-странице ЦАО</a>. Для 40–50-тонного класса это означает более узкий выбор реальных точек установки, чем для базового класса техники: там, где 16-тонный кран ещё встаёт в арку, 50-тонный из-за увеличенного радиуса разворота и площади под опорами — уже нет, и в таких случаях предлагаем либо более компактную модель, либо альтернативную схему подъезда.</p>

    <h2 style="margin:36px 0 18px">Пропускной режим рядом с режимными объектами округа</h2>
    <p>Помимо крупных строек, часть заявок в ЦАО связана с объектами делового квартала, где действует контрольно-пропускной режим бизнес-центра — общий порядок оформления пропуска для техники и бригады разобран на странице услуги <a href="/uslugi/kran-na-rezhimnyy-obekt/" style="color:var(--yellow)">«Кран на режимный объект»</a>. Для площадок вроде участка 16/1 к этому добавляется отдельная процедура допуска подрядчика на территорию строительства, действующая всё время реализации проекта, а не разово на день работ.</p>

    <h2 style="margin:36px 0 18px">Цена для объекта в ЦАО</h2>
    <p>Базовая ставка — от 3 900 ₽/час (см. <a href="/#zayavka" style="color:var(--yellow)">ориентир по стоимости на главной</a>), стандартная для этого класса по Москве. Для объектов с пропускным режимом крупной стройки закладываем дополнительное время на согласование допуска подрядчика; для адресов с потенциальным перекрытием проезда — отдельно стоимость согласования с ГИБДД, называем её заранее, до подтверждения заказа.</p>
    <PriceDisclaimer validUntil={PRICES_VALID_UNTIL} />
  </section>
  <section class="section wrap prose" style="padding-top:0">
    <h2 style="margin-bottom:18px">Что уточняем до выезда именно здесь</h2>
    <p>Для площадки внутри периметра крупной стройки в первую очередь уточняем несущую способность покрытия временных проездов — на активно эксплуатируемой территории с постоянным движением техники грунт под временными дорогами не всегда рассчитан на дополнительную нагрузку от выносных опор тяжёлого класса (подробный расчёт — в статье про <a href="/spravochnik/nesushchaya-sposobnost-grunta/">несущую способность грунта</a>). Второй пункт — комплект документов на въезд техники на подрядную территорию, он шире, чем для разового объекта в жилой застройке: полный список — на странице <a href="/documents/propusk-na-obekt/">«Пропуск на объект»</a>.</p>
    <Sources
      checked="19.08.2026"
      items={[
        { text: 'Приказ Ростехнадзора от 26.11.2020 №461 (ред. от 16.04.2026): п. 108 — площадка и уклон, п. 110 — выносные опоры, п. 111 — откос выемки, п. 165 и 189 — освидетельствование и запись в паспорт', href: 'https://www.consultant.ru/document/cons_doc_LAW_373321/' },
        { text: 'РБК-Недвижимость — башня высотой почти 400 м на Краснопресненской набережной, уч. 16/1: разрешение на строительство от 6 августа 2025, архитектурное бюро СПИЧ, площадь комплекса 202,6 тыс. кв. м', href: 'https://realty.rbc.ru/news/689341bf9a79471cfbb42e54' },
        { text: 'RB.RU — Wildberries получил разрешение на строительство штаб-квартиры в «Сити»: застройщик РВБ (структура Wildberries и Russ), 75 этажей, около 17 тыс. рабочих мест, завершение к 2031 году', href: 'https://rb.ru/news/400-metrov-nad-moskvoj-wildberries-poluchil-razreshenie-na-stroitelstvo-shtab-kvartiry-v-siti/' },
      ]}
    />
  </section>
</main>
<style>
  .adm { width: 100%; border-collapse: collapse; margin: 6px 0 0; font-size: var(--t-md); }
  .adm caption { text-align: left; font-family: var(--display); text-transform: uppercase; font-size: var(--t-sm); color: var(--yellow); letter-spacing: .06em; padding-bottom: 12px; }
  .adm th { text-align: left; font-size: var(--t-xs); text-transform: uppercase; letter-spacing: .06em; color: var(--muted); font-weight: 700; padding: 0 14px 8px 0; border-bottom: 1px solid var(--line-strong); }
  .adm td { padding: 13px 14px 13px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
  .adm td:first-child { width: 24%; font-weight: 700; }
  .adm td:last-child { width: 24%; color: var(--muted); font-size: var(--t-md); }
  @media (max-width: 760px) {
    .adm, .adm tbody, .adm tr, .adm td { display: block; width: 100%; }
    .adm thead { display: none; }
    .adm tr { border-bottom: 1px solid var(--line-strong); padding-bottom: 10px; margin-bottom: 10px; }
    .adm td { border: none; padding: 5px 0; }
    .adm td::before { content: attr(data-label); display: block; font-size: var(--t-xs); text-transform: uppercase; letter-spacing: .06em; color: var(--yellow); margin-bottom: 2px; }
    .adm td:first-child, .adm td:last-child { width: 100%; }
  }
</style>
</BaseLayout>
