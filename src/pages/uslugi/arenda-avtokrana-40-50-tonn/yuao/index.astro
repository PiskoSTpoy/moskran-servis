---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Sources from '../../../../components/Sources.astro';
import PriceDisclaimer from '../../../../components/PriceDisclaimer.astro';
import { PRICES_VALID_UNTIL } from '../../../../lib/prices';

const title = 'Автокран 40–50 тонн в ЮАО — реновация Нагатинского Затона';
const description = 'Тяжёлый автокран 40–50 тонн в ЮАО Москвы: логистика для реновации Нагатинского Затона — снос 54 домов, новые стартовые площадки. Расчёт онлайн.';

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Автокраны 40–50 тонн', item: 'https://moskran-servis.ru/uslugi/arenda-avtokrana-40-50-tonn/' },
    { '@type': 'ListItem', position: 3, name: 'ЮАО', item: 'https://moskran-servis.ru/uslugi/arenda-avtokrana-40-50-tonn/yuao/' },
  ],
};
const serviceLd = {
  '@context': 'https://schema.org', '@type': 'Service', serviceType: 'Аренда автокрана 40-50 тонн в ЮАО',
  provider: { '@id': 'https://moskran-servis.ru/#organization' }, areaServed: 'ЮАО, Москва',
};
---
<BaseLayout title={title} description={description} path="/uslugi/arenda-avtokrana-40-50-tonn/yuao/" ldExtra={[breadcrumbLd, serviceLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/uslugi/arenda-avtokrana-40-50-tonn/">Автокраны 40–50 тонн</a><span>/</span><span>ЮАО</span>
  </nav>
  <section class="section wrap" style="padding-top:8px">
    <div class="section-head">
      <span class="eyebrow">Автокран 40–50 т · Южный округ</span>
      <h1>Автокран 40–50 тонн в ЮАО</h1>
      <p>В районе Нагатинский Затон программа реновации затронет 54 дома — больше всего на улице Судостроительной (12 адресов) и Затонной улице (10 адресов). Под новое строительство уже выделены стартовые площадки: улица Речников, 18–20, улица Речников, 22 (жилой комплекс более чем на 650 квартир) и улица Судостроительная, 19. В отличие от редевелопмента территории завода ЗИЛ по соседству — это городская программа переселения, где новые дома возводятся впритык к пятиэтажной застройке 1960-х годов, а не на освобождённой промышленной площадке.</p>
    </div>
  </section>
  <section class="section wrap" style="padding-top:0;padding-bottom:clamp(28px,4vw,44px)">
    <table class="adm">
      <caption>Карточка допуска: автокран 40–50 т на объекте в ЮАО</caption>
      <thead><tr><th scope="col">Требование</th><th scope="col">Что это значит здесь</th><th scope="col">Основание</th></tr></thead>
      <tbody>
        <tr><td data-label="Требование">Высота монтажа выше, чем у соседних пятиэтажек</td><td data-label="Что это значит здесь">Дома реновации на этих стартовых площадках заметно выше сносимой типовой застройки — больший вылет и высота подъёма при том же весе панели или монтажного элемента чаще требуют именно 40–50-тонного класса, а не базового.</td><td data-label="Основание">Грузовысотная характеристика</td></tr>
        <tr><td data-label="Требование">Соседство с жилыми домами под расселение</td><td data-label="Что это значит здесь">Часть окружающих пятиэтажек ещё заселена и ждёт очереди на переселение — опасная зона крана при работе рассчитывается с учётом этих домов как жилых, а не как уже освобождённой территории.</td><td data-label="Основание">ФНП №461, п. 112</td></tr>
        <tr><td data-label="Требование">Какое освидетельствование действует</td><td data-label="Что это значит здесь">Частичное — не реже раза в 12 месяцев, полное — не реже раза в 3 года; на въезде спрашивают паспорт машины с записью и удостоверение оператора.</td><td data-label="Основание">ФНП №461, п. 165 и 189</td></tr>
        <tr><td data-label="Требование">Подъезд по дворам старой застройки</td><td data-label="Что это значит здесь">Улицы Судостроительная и Затонная застроены дворами советского типа с более узкими проездами, чем на новых стартовых площадках, — точку установки подбираем по факту ширины конкретного двора.</td><td data-label="Основание">Паспорт ПС</td></tr>
      </tbody>
    </table>
  </section>
  <section class="section wrap prose" style="padding-top:0">
    <h2 style="margin-bottom:18px">Реновация Нагатинского Затона — не редевелопмент ЗИЛа</h2>
    <p>Крупный проект в соседнем Даниловском районе — редевелопмент территории бывшего завода ЗИЛ с жилым кварталом «ЗИЛАРТ» — разобран отдельно, на <a href="/uslugi/bashennyy-kran/yuao/">странице услуги «Башенный кран в ЮАО»</a>: там другая механика площадки, техногенный грунт бывшей промзоны и перенос техники между очередями застройки. Нагатинский Затон — принципиально другой сценарий: снос действующего жилого фонда 1960-х годов (больше всего адресов — на улице Судостроительной и Затонной улице) и параллельное строительство новых домов на уже выделенных стартовых площадках, часть которых расположена в паре кварталов от ещё заселённых пятиэтажек.</p>

    <h2 style="margin:36px 0 18px">Стартовые площадки — разные адреса, разное плечо подачи</h2>
    <p>Улица Речников, 18–20 и улица Речников, 22 (запланировано более 650 квартир) — площадки ближе к набережной затона; улица Судостроительная, 19 — глубже в кварталах старой застройки. Как и для любой программы, растянутой на несколько отдельных адресов, время и стоимость подачи техники считаем по конкретной точке, а не усреднённо по всему району: для площадок у набережной подъезд обычно свободнее, для площадок среди дворов старой застройки — уже, и это напрямую влияет на выбор точки установки крана.</p>

    <h2 style="margin:36px 0 18px">Плотная старая застройка рядом со стройкой</h2>
    <p>Пока часть жителей ещё не переехала в новые дома, у стройплощадок сохраняется соседство с обычной дворовой жизнью — детскими площадками, парковками жильцов, пешеходными маршрутами к подъездам. Опасную зону работы крана в таких условиях рассчитываем строже, чем на площадке без окружающей жилой застройки, и по возможности согласуем время работ так, чтобы минимально пересекаться с активностью двора. Подробный разбор специфики районов округа — на <a href="/geo/yuao/">гео-странице ЮАО</a>.</p>

    <h2 style="margin:36px 0 18px">Цена для объекта в ЮАО</h2>
    <p>Базовая ставка — от 3 900 ₽/час (см. <a href="/#zayavka" style="color:var(--yellow)">ориентир по стоимости на главной</a>), стандартная для этого класса по Москве. Для площадок рядом с заселёнными домами закладываем время на согласование режима работ с управляющей компанией; стоимость подачи техники для конкретного адреса Нагатинского Затона называем по факту расположения площадки, а не усреднённо по району.</p>
    <PriceDisclaimer validUntil={PRICES_VALID_UNTIL} />
  </section>
  <section class="section wrap prose" style="padding-top:0">
    <h2 style="margin-bottom:18px">Что уточняем до выезда именно здесь</h2>
    <p>Для площадки рядом с заселённой старой застройкой в первую очередь уточняем расчёт опасной зоны крана — она соседствует не с пустым участком, а с жилыми домами, детскими и парковочными зонами, что подробно разобрано в статье про <a href="/spravochnik/opasnaya-zona-krana/">опасную зону крана</a>. Второй пункт — комплект документов на въезд техники на огороженную стройплощадку, полный список — на странице <a href="/documents/propusk-na-obekt/">«Пропуск на объект»</a>.</p>
    <Sources
      checked="19.08.2026"
      items={[
        { text: 'Приказ Ростехнадзора от 26.11.2020 №461 (ред. от 16.04.2026): п. 108 — площадка и уклон, п. 112 — опасная зона крана, п. 165 и 189 — освидетельствование и запись в паспорт', href: 'https://www.consultant.ru/document/cons_doc_LAW_373321/' },
        { text: 'renobzor.ru — реновация в районе Нагатинский Затон: 54 дома под снос, больше всего адресов на Судостроительной улице (12) и Затонной улице (10)', href: 'https://renobzor.ru/karta/nagatinskiy-zaton/' },
        { text: 'proren.ru — стартовые площадки реновации Нагатинского Затона: ул. Речников, 18–20 и 22 (более 650 квартир), ул. Судостроительная, 19', href: 'https://proren.ru/renovatsiya/yuao/nagatinskiy-zaton/' },
      ]}
    />
  </section>
</main>
<style>
  .adm { width: 100%; border-collapse: collapse; margin: 6px 0 0; font-size: var(--t-md); }
  .adm caption { text-align: left; font-family: var(--display); text-transform: uppercase; font-size: var(--t-sm); color: var(--yellow); letter-spacing: .06em; padding-bottom: 12px; }
  .adm th { text-align: left; font-size: var(--t-xs); text-transform: uppercase; letter-spacing: .06em; color: var(--muted); font-weight: 700; padding: 0 14px 8px 0; border-bottom: 1px solid var(--line-strong); }
  .adm td { padding: 13px 14px 13px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
  .adm td:first-child { width: 24%; font-weight: 700; }
  .adm td:last-child { width: 24%; color: var(--muted); font-size: var(--t-md); }
  @media (max-width: 760px) {
    .adm, .adm tbody, .adm tr, .adm td { display: block; width: 100%; }
    .adm thead { display: none; }
    .adm tr { border-bottom: 1px solid var(--line-strong); padding-bottom: 10px; margin-bottom: 10px; }
    .adm td { border: none; padding: 5px 0; }
    .adm td::before { content: attr(data-label); display: block; font-size: var(--t-xs); text-transform: uppercase; letter-spacing: .06em; color: var(--yellow); margin-bottom: 2px; }
    .adm td:first-child, .adm td:last-child { width: 100%; }
  }
</style>
</BaseLayout>
