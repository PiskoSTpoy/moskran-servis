---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Sources from '../../../../components/Sources.astro';

const title = 'Автокран 40–50 тонн в Новой Москве — стройка метро';
const description = 'Тяжёлый автокран 40–50 тонн в Новой Москве (ТиНАО): логистика для площадок вдоль Троицкой линии метро и депо «Столбово». Расчёт онлайн.';

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Автокраны 40–50 тонн', item: 'https://moskran-servis.ru/uslugi/arenda-avtokrana-40-50-tonn/' },
    { '@type': 'ListItem', position: 3, name: 'Новая Москва (ТиНАО)', item: 'https://moskran-servis.ru/uslugi/arenda-avtokrana-40-50-tonn/tinao/' },
  ],
};
const serviceLd = {
  '@context': 'https://schema.org', '@type': 'Service', serviceType: 'Аренда автокрана 40-50 тонн в Новой Москве',
  provider: { '@id': 'https://moskran-servis.ru/#organization' }, areaServed: 'ТиНАО, Москва',
};
---
<BaseLayout title={title} description={description} path="/uslugi/arenda-avtokrana-40-50-tonn/tinao/" ldExtra={[breadcrumbLd, serviceLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/uslugi/arenda-avtokrana-40-50-tonn/">Автокраны 40–50 тонн</a><span>/</span><span>Новая Москва (ТиНАО)</span>
  </nav>
  <section class="section wrap" style="padding-top:8px">
    <div class="section-head">
      <span class="eyebrow">Автокран 40–50 т · Новомосковский и Троицкий округа</span>
      <h1>Автокран 40–50 тонн в Новой Москве</h1>
      <p>С октября 2025 года вдоль Калужского шоссе идёт проходка тоннеля второго этапа Троицкой линии метро — 16,8 км от «Новомосковской» до города Троицк с шестью новыми станциями. А 12 августа 2025 года в ТиНАО уже открылось электродепо «Столбово» — 15,8 га территории, свыше 50 зданий и сооружений общей площадью около 100 тысяч квадратных метров. Для тяжёлого класса техники это означает постоянный поток вспомогательных задач вдоль всего коридора строительства, растянутого на много километров, а не точечный объект.</p>
    </div>
  </section>
  <section class="section wrap" style="padding-top:0;padding-bottom:clamp(28px,4vw,44px)">
    <table class="adm">
      <caption>Карточка допуска: автокран 40–50 т на объекте в ТиНАО</caption>
      <thead><tr><th scope="col">Требование</th><th scope="col">Что это значит здесь</th><th scope="col">Основание</th></tr></thead>
      <tbody>
        <tr><td data-label="Требование">Плечо подачи вдоль коридора</td><td data-label="Что это значит здесь">Станции нового участка растянуты от Сосенок (ближе к МКАД) до Троицка (в глубине территории) — расстояние и, соответственно, время подачи техники для этих точек отличается в разы. Считаем логистику по конкретному адресу, а не по единой цифре на весь округ.</td><td data-label="Основание">Условия договора</td></tr>
        <tr><td data-label="Требование">Пропуск на подрядную территорию</td><td data-label="Что это значит здесь">Объекты инфраструктурной стройки такого масштаба — режимные с первого дня: список техники и бригады подаётся заранее генподрядчику территории, а не оформляется на месте в день выезда.</td><td data-label="Основание">Регламент площадки</td></tr>
        <tr><td data-label="Требование">Какое освидетельствование действует</td><td data-label="Что это значит здесь">Частичное — не реже раза в 12 месяцев, полное — не реже раза в 3 года; на въезде спрашивают паспорт машины с записью и удостоверение оператора.</td><td data-label="Основание">ФНП №461, п. 165 и 189</td></tr>
        <tr><td data-label="Требование">Состояние подъездных путей</td><td data-label="Что это значит здесь">Часть территории южнее Коммунарки — в стадии активного развития, и не все подъезды к площадкам вдоль трассы имеют капитальное покрытие. Уточняем состояние дороги к точке работ по фото до выезда техники.</td><td data-label="Основание">Паспорт ПС</td></tr>
      </tbody>
    </table>
  </section>
  <section class="section wrap prose" style="padding-top:0">
    <h2 style="margin-bottom:18px">Депо «Столбово» — уже работающий объект такого масштаба</h2>
    <p>Депо «Столбово» открыто 12 августа 2025 года и первое время обслуживает составы Троицкой линии — после ввода в строй депо «Троицкое», которое достраивают южнее, «Столбово» планируют переключить на Сокольническую линию. На территории уже возведено больше 50 зданий и сооружений: отстойно-ремонтный корпус на 33 канавы с камерой мойки составов, административные, медицинские и бытовые помещения для более чем 1500 будущих рабочих мест. Объект такого размера и профиля даёт представление о масштабе вспомогательных задач по соседству: обслуживание технологического оборудования корпусов, работы по благоустройству территории, монтаж инженерных систем зданий — это тот тип задач, где чаще нужен манёвренный кран среднего и тяжёлого класса со стороны, а не постоянно закреплённая за объектом техника.</p>

    <h2 style="margin:36px 0 18px">Второй этап Троицкой линии — стройка на годы вперёд</h2>
    <p>Новый участок линии длиной 16,8 км идёт вдоль Калужского шоссе через шесть станций — Сосенки, Ракитки, Десна, Кедровая, Ватутинки и конечную Троицк — с завершением, запланированным на 2029 год. Это не разовый проект, а многолетняя стройка, растянутая вдоль всего коридора: вдоль трассы работают подрядчики разного профиля, от прокладки инженерных сетей до благоустройства прилегающих территорий, и потребность в дополнительной технике возникает не только у самого метростроя, но и у смежных подрядчиков на площадках рядом с будущими станциями.</p>

    <h2 style="margin:36px 0 18px">Логистика — по-прежнему главный фактор для этой территории</h2>
    <p>Как и для остальной части ТиНАО (подробнее — на <a href="/geo/tinao/">гео-странице Новой Москвы</a>), расстояние от точки базирования техники остаётся определяющим для стоимости и сроков подачи. Для объектов вдоль нового участка линии это особенно заметно: разброс между ближайшей к МКАД Сосенкой и конечной станцией Троицк — это разница в логистическом плече в разы, а не в проценты, и мы называем стоимость подачи по конкретному адресу, а не усреднённо по всему коридору.</p>

    <h2 style="margin:36px 0 18px">Цена для объекта в ТиНАО</h2>
    <p>Базовая ставка — по грузоподъёмности крана (см. <a href="/#zayavka" style="color:var(--yellow)">ориентир по стоимости на главной</a>), не отличается от остальной Москвы. Стоимость подачи техники для этого округа зависит от конкретного расстояния до объекта вдоль коридора строительства и растёт по мере удаления от МКАД; для площадок с пропускным режимом подрядной территории закладываем время на согласование допуска.</p>
  </section>
  <section class="section wrap prose" style="padding-top:0">
    <h2 style="margin-bottom:18px">Что уточняем до выезда именно здесь</h2>
    <p>Для площадок рядом со стройкой линии и депо в первую очередь смотрим на состояние подъездного пути — на активно застраиваемой территории асфальт на подъезде к площадке нередко временный, а грунт под ним не проверен под нагрузку от выносных опор тяжёлого класса (расчёт — в статье про <a href="/spravochnik/nesushchaya-sposobnost-grunta/">несущую способность грунта</a>). Второй момент — пропускной режим подрядной территории: комплект документов на въезд техники и бригаду для площадки внутри периметра стройки шире разового объекта, полный список — на странице <a href="/documents/propusk-na-obekt/">«Пропуск на объект»</a>.</p>
    <Sources
      checked="19.08.2026"
      items={[
        { text: 'Приказ Ростехнадзора от 26.11.2020 №461 (ред. от 16.04.2026): п. 108 — площадка и уклон, п. 110 — выносные опоры, п. 165 и 189 — освидетельствование и запись в паспорт', href: 'https://www.consultant.ru/document/cons_doc_LAW_373321/' },
        { text: 'Комплекс градостроительной политики и строительства города Москвы — второй этап Троицкой линии метро: 16,8 км вдоль Калужского шоссе, 6 станций, начало проходки в октябре 2025, завершение к 2029 году', href: 'https://stroi.mos.ru/metro/novaia-liniia-mietro-ot-ulitsy-novatorov-tpk-do-ghoroda-troitsk' },
        { text: '«Московская перспектива» — электродепо «Столбово» в ТиНАО: открыто 12 августа 2025, площадь участка 15,8 га, свыше 50 зданий и сооружений, отстойно-ремонтный корпус на 33 канавы', href: 'https://mperspektiva.ru/topics/v-tinao-otkrylos-depo-stolbovo/' },
      ]}
    />
  </section>
</main>
<style>
  .adm { width: 100%; border-collapse: collapse; margin: 6px 0 0; font-size: var(--t-md); }
  .adm caption { text-align: left; font-family: var(--display); text-transform: uppercase; font-size: var(--t-sm); color: var(--yellow); letter-spacing: .06em; padding-bottom: 12px; }
  .adm th { text-align: left; font-size: var(--t-xs); text-transform: uppercase; letter-spacing: .06em; color: var(--muted); font-weight: 700; padding: 0 14px 8px 0; border-bottom: 1px solid var(--line-strong); }
  .adm td { padding: 13px 14px 13px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
  .adm td:first-child { width: 24%; font-weight: 700; }
  .adm td:last-child { width: 24%; color: var(--muted); font-size: var(--t-md); }
  @media (max-width: 760px) {
    .adm, .adm tbody, .adm tr, .adm td { display: block; width: 100%; }
    .adm thead { display: none; }
    .adm tr { border-bottom: 1px solid var(--line-strong); padding-bottom: 10px; margin-bottom: 10px; }
    .adm td { border: none; padding: 5px 0; }
    .adm td::before { content: attr(data-label); display: block; font-size: var(--t-xs); text-transform: uppercase; letter-spacing: .06em; color: var(--yellow); margin-bottom: 2px; }
    .adm td:first-child, .adm td:last-child { width: 100%; }
  }
</style>
</BaseLayout>
