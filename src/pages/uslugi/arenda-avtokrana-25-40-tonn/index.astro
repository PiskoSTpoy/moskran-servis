---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Sources from '../../../components/Sources.astro';
import PriceDisclaimer from '../../../components/PriceDisclaimer.astro';
import { PRICES_VALID_UNTIL } from '../../../lib/prices';

const title = 'Аренда автокрана 25–40 тонн в Москве — тяжёлые грузы';
const description = 'Автокран 25–40 тонн в аренду в Москве: тяжёлые ЖБИ, металлоконструкции, инженерное оборудование. Расчёт вылета и грузовысотной характеристики. Калькулятор.';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Услуги', item: 'https://moskran-servis.ru/#uslugi' },
    { '@type': 'ListItem', position: 3, name: 'Автокраны 25–40 тонн', item: 'https://moskran-servis.ru/uslugi/arenda-avtokrana-25-40-tonn/' },
  ],
};

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Аренда автокрана 25-40 тонн',
  provider: { '@id': 'https://moskran-servis.ru/#organization' },
  areaServed: 'Москва',
  offers: {
    '@type': 'Offer',
    // Аренда, а НЕ продажа. Без явного businessFunction значение по умолчанию —
    // Sell, то есть разметка объявляла бы продажу крана за эту сумму. Техника
    // передаётся во временное пользование (с экипажем, ст. 632 ГК) — LeaseOut.
    businessFunction: 'http://purl.org/goodrelations/v1#LeaseOut',
    priceCurrency: 'RUB',
    price: '2600',
    priceSpecification: { '@type': 'UnitPriceSpecification', price: '2600', priceCurrency: 'RUB', unitText: 'HOUR' },
  },
};

const faqs = [
  {
    q: 'Чем 32-тонный кран принципиально отличается от 25-тонного, если разница в тоннаже не так велика?',
    a: 'Дело не только в паспортном максимуме, а в форме кривой грузовысотной характеристики: у 32-тонной техники запас грузоподъёмности на средних и увеличенных вылетах (12–20 м) обычно шире, чем у 25-тонника на тех же цифрах. То есть при формально небольшой разнице в максимуме на нулевом вылете разница на реальном рабочем вылете часто оказывается куда заметнее — именно она и определяет, справится ли кран с задачей на стеснённой площадке.',
  },
  {
    q: 'Нужен ли кран 40 тонн, если груз весит всего 8–10 тонн?',
    a: 'Может понадобиться, если вылет большой. Груз в 8–10 тонн на вылете 5–6 метров спокойно поднимет и 25-тонник. Тот же груз на вылете 18–20 метров (типично для работы через здание или из глубины площадки) у крана меньшего класса может оказаться за пределами грузовысотной характеристики — тогда нужен более мощный кран не из-за веса самого по себе, а из-за расстояния.',
  },
  {
    q: 'Требуется ли для этого класса техники согласование маршрута перевозки к объекту?',
    a: 'Сам автокран в транспортном (не рабочем) положении обычно укладывается в стандартные габариты дорожного движения без специального разрешения — в отличие от гусеничных или сверхтяжёлых кранов. Отдельное согласование маршрута может потребоваться только для отдельных мостов и эстакад с ограничением по нагрузке на конкретном пути следования — уточняем это при планировании выезда на объекты за пределами обычных городских магистралей.',
  },
  {
    q: 'Какая площадка нужна для установки крана 32–40 тонн?',
    a: 'Больше, чем для 16–25-тонного класса: под выносные опоры обычно требуется порядка 7×7–8×8 метров с твёрдым покрытием, плюс подъездной путь шириной от 4 метров. На мягком или неровном грунте обязательны инвентарные подкладки увеличенной площади — у этого класса нагрузка на опору при полном вылете заметно выше, чем у 16–25-тонной техники, и стандартных подкладок меньшего размера может быть недостаточно.',
  },
  {
    q: 'Можно ли этим краном поднимать груз на высотное здание — 15–20 этажей?',
    a: 'Зависит от конкретной модели и её максимальной высоты подъёма крюка (обычно 32–45 метров у техники этого класса) и от того, на каком вылете фактически будет работать кран. Для зданий выше этого диапазона автокран физически не подходит — там уже нужен либо кран с более длинной стрелой, либо, для длительных монтажных работ на весь срок строительства, башенный кран (см. отдельную услугу).',
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<BaseLayout title={title} description={description} path="/uslugi/arenda-avtokrana-25-40-tonn/" ldExtra={[breadcrumbLd, serviceLd, faqLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/#uslugi">Услуги</a><span>/</span><span>Автокраны 25–40 тонн</span>
  </nav>

  <section class="section wrap" style="padding-top:8px">
    <div class="section-head">
      <span class="eyebrow">Услуга</span>
      <h1>Аренда автокрана 25–40 тонн в Москве</h1>
      <p>Средний тяжёлый класс: берут либо под груз, который объективно тяжелее стандартных 16–25 тонн, либо когда условия площадки вынуждают работать на увеличенном вылете, где запас грузоподъёмности младшего класса уже недостаточен.</p>
    </div>
  </section>

  <section class="section wrap" style="padding-top:0;padding-bottom:0">
    <div class="rate-line">
      <span class="rate-line__label">Базовая ставка класса</span>
      <p class="rate-line__value">от 2 600 ₽<span class="rate-line__unit"> / час</span></p>
      <p class="rate-line__note">Та же ставка, что в калькуляторе на главной; минимальный заказ — одна смена 8 часов. Подача техники, работы в выходные и пропускной режим объекта (× 1,12) считаются отдельно и называются до подтверждения заявки.</p>
    </div>
    <PriceDisclaimer validUntil={PRICES_VALID_UNTIL} />
  </section>

  <section class="section wrap" style="padding-top:0;padding-bottom:clamp(30px,4vw,48px)">
    <p class="prose" style="color:var(--muted);margin-bottom:22px">Средний тяжёлый класс отличается от лёгкого не набором документов, а тем, насколько дорого обходится ошибка в двух строках: опирание и вылет. Карточка допуска — ниже.</p>
    <table class="adm">
      <caption>Карточка допуска техники</caption>
      <thead><tr><th scope="col">Требование</th><th scope="col">Что именно проверяется</th><th scope="col">Срок действия</th><th scope="col">Кто подписывает</th></tr></thead>
      <tbody>
        <tr><td data-label="Требование">Паспорт подъёмного сооружения</td><td data-label="Что именно проверяется">Результаты технического освидетельствования записываются в паспорт с указанием срока следующего. Паспорт без свежей записи не подтверждает ничего: срок проверить нечем.</td><td data-label="Срок действия">актуален по дате последней записи</td><td data-label="Кто подписывает">инженерно-технический работник, ответственный за производственный контроль</td></tr>
        <tr><td data-label="Требование">Частичное техническое освидетельствование</td><td data-label="Что именно проверяется">Осмотр без статических и динамических испытаний: состояние металлоконструкций, канатов, приборов и устройств безопасности.</td><td data-label="Срок действия">не реже одного раза в 12 месяцев</td><td data-label="Кто подписывает">ответственный за производственный контроль при участии ответственного за содержание ПС</td></tr>
        <tr><td data-label="Требование">Полное техническое освидетельствование</td><td data-label="Что именно проверяется">Осмотр плюс испытания: статические — грузом 125 % от паспортной грузоподъёмности, динамические — грузом на 10 % выше паспортной.</td><td data-label="Срок действия">не реже одного раза в 3 года (для редко используемых ПС — раз в 5 лет)</td><td data-label="Кто подписывает">ответственный за производственный контроль при участии ответственного за содержание ПС</td></tr>
        <tr><td data-label="Требование">Квалификация оператора</td><td data-label="Что именно проверяется">Документ о квалификации и действующий результат проверки знаний. Это законный вопрос заказчика, а не проявление недоверия.</td><td data-label="Срок действия">по установленной эксплуатирующей организацией периодичности</td><td data-label="Кто подписывает">комиссия эксплуатирующей организации</td></tr>
        <tr><td data-label="Требование">Приказы о назначении ответственных</td><td data-label="Что именно проверяется">Три разные роли: за производственный контроль, за содержание ПС в работоспособном состоянии, за безопасное производство работ с применением ПС.</td><td data-label="Срок действия">до отмены или замены приказа</td><td data-label="Кто подписывает">руководитель эксплуатирующей организации</td></tr>
        <tr><td data-label="Требование">Грузовая характеристика на рабочем вылете</td><td data-label="Что именно проверяется">В паспорте смотрится не максимум, а строка на том вылете, на котором машина реально встанет. Разница между этими двумя числами и есть причина большинства сорванных подъёмов.</td><td data-label="Срок действия">проверяется при расчёте заявки</td><td data-label="Кто подписывает">ответственный за безопасное производство работ</td></tr>
        <tr><td data-label="Требование">Расстояние до откоса выемки</td><td data-label="Что именно проверяется">Если опоры ставятся у котлована или траншеи, расстояние берётся из приложения к Правилам и зависит от глубины и грунта.</td><td data-label="Срок действия">проверяется перед установкой</td><td data-label="Кто подписывает">ответственный за безопасное производство работ</td></tr>
      </tbody>
    </table>
    <ul class="adm-links">
      <li><a href="/spravochnik/gruzovysotnaya-harakteristika/">Грузовысотная характеристика →</a></li>
      <li><a href="/spravochnik/rasstoyanie-ot-kotlovana/">Расстояние от котлована →</a></li>
      <li><a href="/spravochnik/ustoychivost-krana/">Запас устойчивости против опрокидывания →</a></li>
      <li><a href="/spravochnik/tehnicheskoe-osvidetelstvovanie-krana/">Освидетельствование →</a></li>
    </ul>
  </section>
  <section class="section wrap prose" style="padding-top:0">
    <h2 style="margin-bottom:18px">Для каких задач нужен именно этот класс</h2>
    <p>Три сценария, где 16–25-тонной техники становится недостаточно.</p>
    <p><b>Тяжёлые железобетонные изделия.</b> Плиты перекрытия увеличенного сечения, фундаментные блоки, лестничные марши для монолитного домостроения — вес единичного элемента часто уже за пределами комфортной работы 25-тонника, особенно если монтаж идёт не с прямого подъезда, а с определённого вылета.</p>
    <p><b>Металлоконструкции среднего и крупного пролёта.</b> Фермы промышленных зданий, колонны каркасов ангаров и складов, элементы эстакад — здесь важна не только масса, но и точность позиционирования на подъёме протяжённого элемента, который парусит на ветру сильнее, чем компактный груз того же веса.</p>
    <p><b>Тяжёлое инженерное оборудование.</b> Трансформаторные подстанции, крупные холодильные и вентиляционные установки, компрессорные станции — вес нередко превышает 10 тонн, а устанавливать их часто нужно на кровлю или в глубине площадки, то есть на увеличенном вылете.</p>

    <h2 style="margin:36px 0 18px">Технические параметры техники этого класса</h2>
    <p>Автокраны 25–40 тонн, которые применяются в Москве на подобных задачах, обычно оснащены телескопической стрелой длиной 28–38 метров, максимальная высота подъёма крюка — порядка 32–45 метров в зависимости от конфигурации и удлинителя стрелы (гуська), если он используется. Минимальный радиус разворота больше, чем у 16–25-тонного класса — это стоит учитывать для по-настоящему тесных дворов, где такой техникой развернуться может быть физически сложнее.</p>
    <p>На полном вылете опор кран этого класса занимает площадь порядка 7–8 метров в каждую сторону от оси. Часть моделей допускает работу на неполных опорах со снижением грузоподъёмности — применимость такого режима под конкретную задачу считаем при расчёте заявки, не постфактум.</p>

    <h2 style="margin:36px 0 18px">Расчёт вылета — тот же принцип, но с бо́льшей ценой ошибки</h2>
    <p>Логика расчёта вылета стрелы для этого класса та же, что и для 16–25-тонной техники: паспортная грузоподъёмность — это максимум на минимальном вылете, и она падает по мере удаления точки подъёма от оси крана. Разница в том, что для тяжёлых грузов ошибка в оценке вылета обходится дороже — если 40-тонник не справляется с задачей на месте, замена на технику следующего класса (гусеничный кран или кран большей грузоподъёмности) — это уже не соседняя ступень в линейке, а совсем другой уровень логистики и стоимости. Поэтому для заявок этого класса мы особенно настаиваем на точных исходных данных: вес по паспорту изделия или проектной документации, а не по устной оценке «тонн двадцать пять, наверное».</p>

    <h2 style="margin:36px 0 18px">Пример расчёта: монтаж фермы промышленного здания</h2>
    <p>Задача: поднять металлическую ферму пролёта весом 6 тонн на высоту 12 метров, кран может встать не ближе 14 метров от точки монтажа из-за уже смонтированных соседних конструкций и котлована под фундамент рядом с площадкой. На вылете 14 метров у 25-тонного крана грузоподъёмность обычно уже заметно ниже паспортного максимума — для многих моделей этого класса 6 тонн на таком вылете может оказаться на пределе или за пределами возможностей. 32-тонный кран на том же вылете, как правило, сохраняет достаточный запас. Вывод: не абсолютный вес груза (6 тонн — немного), а сочетание веса и вынужденного вылета определило класс техники.</p>

    <h2 style="margin:36px 0 18px">Что нужно подготовить на площадке</h2>
    <ul>
      <li>Площадка под выносные опоры 7×7–8×8 м с твёрдым покрытием, выдерживающим нагрузку от опоры этого класса техники — асфальт, бетон, плотно утрамбованный щебень.</li>
      <li>Подъездной путь шириной от 4 метров для проезда крупногабаритной техники.</li>
      <li>Точный вес самого тяжёлого элемента по проектной документации или паспорту изделия.</li>
      <li>Схема площадки с указанием, откуда физически возможен подъезд крана и на каком расстоянии от точки подъёма он сможет встать.</li>
      <li>Если объект с пропускным режимом — оформление пропуска заранее (см. услугу «Кран на режимный объект»).</li>
    </ul>

    <h2 style="margin:36px 0 18px">Документы и безопасность</h2>
    <p>Кран эксплуатируется по действующим Федеральным нормам и правилам промышленной безопасности (Приказ Ростехнадзора №461 от 26.11.2020, действующая редакция) — подробный разбор истории перехода от отменённых ПБ 10-382-00 к этому документу — в <a href="/spravochnik/fnp-461-chto-izmenilos/" style="color:var(--yellow)">разборе справочника</a>. Периодичность освидетельствования от класса машины не зависит: частичное — не реже одного раза в 12 месяцев, полное — не реже одного раза в 3 года, и это одинаково для 16-тонного и для 40-тонного крана. По запросу предоставляем страницу паспорта с записью о последнем освидетельствовании вместе с договором.</p>

    <h2 style="margin:36px 0 18px">Как формируется цена</h2>
    <p>Базовая ставка зависит от конкретного класса — 32 или 40 тонн (см. <a href="/#zayavka" style="color:var(--yellow)">ориентир по стоимости на главной</a>), минимальный заказ от одной смены. К базовой ставке применимы те же надбавки, что и для остальной линейки: пропускной режим (+12%), работа в выходные и праздники — тарифицируется отдельно, подача техники — по расстоянию до объекта, называется на этапе согласования заявки.</p>
  </section>

  <section class="section wrap prose qa" style="padding-top:0">
    <h2 style="margin-bottom:22px">Вопросы, которые задают до заказа</h2>
    {faqs.map((f) => (<><h3>{f.q}</h3><p>{f.a}</p></>))}
    <Sources
      checked="12.08.2026"
      items={[
        { text: 'Приказ Ростехнадзора от 26.11.2020 №461 (ред. от 16.04.2026): п. 108 — площадка и уклон, п. 110 — выносные опоры, п. 111 — откос выемки, п. 112 — 30 м до провода и наряд-допуск, п. 138 — пуск в работу, п. 165 — периодичность освидетельствования, п. 167 — кто проводит, п. 171 и 179 — нагрузки при испытаниях, п. 189 — запись в паспорт', href: 'https://www.consultant.ru/document/cons_doc_LAW_373321/' },
        { text: 'Единый транспортный портал Москвы — грузовой каркас: пропуск для ТС с разрешённой массой свыше 3,5 т и регистрация в РНИС', href: 'https://transport.mos.ru/gruzoviki/perevod_ckad' },
      ]}
      note="Ставки и коэффициент за пропускной режим — наши коммерческие условия, а не норматив; ориентир по стоимости с формулой расчёта находится на главной странице."
    />
  </section>

</main>
<style>
  .adm { width: 100%; border-collapse: collapse; margin: 8px 0 0; font-size: var(--t-md); }
  .adm caption { text-align: left; font-family: var(--display); text-transform: uppercase; font-size: var(--t-sm); color: var(--yellow); letter-spacing: .06em; padding-bottom: 12px; }
  .adm th { text-align: left; font-size: var(--t-xs); text-transform: uppercase; letter-spacing: .06em; color: var(--muted); font-weight: 700; padding: 0 14px 8px 0; border-bottom: 1px solid var(--line-strong); }
  .adm td { padding: 13px 14px 13px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
  .adm td:first-child { width: 20%; font-weight: 700; }
  .adm td:nth-child(3) { width: 18%; color: var(--yellow); font-size: var(--t-md); }
  .adm td:last-child { width: 22%; color: var(--muted); font-size: var(--t-sm); }
  .adm-links { list-style: none; margin: 20px 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px 20px; }
  .adm-links a { font-size: var(--t-md); font-weight: 600; text-decoration: none; border-bottom: 1px solid var(--line-strong); padding-bottom: 2px; }
  .adm-links a:hover { color: var(--yellow); border-bottom-color: var(--yellow); }
  .qa h3 { font-size: 1rem; margin-top: 26px; }
  .qa h3:first-of-type { margin-top: 0; }
  .qa p { margin-top: 8px; color: var(--muted); }
  @media (max-width: 860px) {
    .adm, .adm tbody, .adm tr, .adm td { display: block; width: 100%; }
    .adm thead { display: none; }
    .adm tr { border-bottom: 1px solid var(--line-strong); padding-bottom: 12px; margin-bottom: 12px; }
    .adm td { border: none; padding: 5px 0; }
    .adm td::before { content: attr(data-label); display: block; font-size: var(--t-xs); text-transform: uppercase; letter-spacing: .06em; color: var(--yellow); margin-bottom: 2px; }
    .adm td:first-child, .adm td:nth-child(3), .adm td:last-child { width: 100%; }
    .adm-links { grid-template-columns: 1fr; }
  }
</style>

<style>
  /* Волна 39. Ставка этого класса существовала ТОЛЬКО внутри JSON-LD (Offer.price),
     а на самой странице цены не было ни одной — то есть разметка утверждала то,
     чего посетитель не видит. Это прямое расхождение видимого текста и разметки:
     Google за такое снимает расширенные результаты, а человек, пришедший из
     выдачи со ставкой в сниппете, не находил её на странице. Блок повторяет уже
     существующий язык прайса (.model-price на страницах парка): те же токены,
     нулевые радиусы, жёлтое крупное число на --display. */
  .rate-line { border: 1px solid var(--line-strong); background: var(--bg-2); padding: 16px 18px; display: grid; gap: 6px; max-width: 560px; }
  .rate-line__label { font-size: var(--t-xs); text-transform: uppercase; letter-spacing: .06em; color: var(--muted); font-weight: 700; }
  .rate-line__value { margin: 0; font-family: var(--display); font-weight: 400; font-size: var(--t-num); color: var(--yellow); line-height: 1.15; }
  .rate-line__unit { font-family: var(--sans); font-size: var(--t-md); color: var(--ink); font-weight: 600; text-transform: none; }
  .rate-line__note { margin: 0; font-size: var(--t-sm); color: var(--muted); line-height: 1.4; }
</style>
</BaseLayout>
