---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Sources from '../../../../components/Sources.astro';

const title = 'Башенный кран в ЮЗАО — квартал на месте промзоны «Черёмушки»';
const description = 'Башенный кран в Котловке, ЮЗАО: реновационный квартал на месте бывшей промзоны «Черёмушки» — 99 тыс. кв. м рядом с метро «Академическая».';

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Башенный кран', item: 'https://moskran-servis.ru/uslugi/bashennyy-kran/' },
    { '@type': 'ListItem', position: 3, name: 'ЮЗАО', item: 'https://moskran-servis.ru/uslugi/bashennyy-kran/yuzao/' },
  ],
};
const serviceLd = {
  '@context': 'https://schema.org', '@type': 'Service', serviceType: 'Аренда башенного крана в ЮЗАО',
  provider: { '@id': 'https://moskran-servis.ru/#organization' }, areaServed: 'ЮЗАО, Москва',
};

// Сравнение двух промзон округа — обе называются похоже («Черёмушки»/«Воронцово»
// на стыке тех же районов), но это разные номерные территории с разной логикой
// допуска техники: одна — площадка новой реновационной застройки, другая —
// действующие НИИ и депо метро с режимным пропуском.
const compare = [
  { row: 'Номер промзоны', old: '№35 «Воронцово»', neu: '№9 «Черёмушки»' },
  { row: 'Что там сейчас', old: 'Действующие НИИ, депо метро, пищевое производство — десятилетия без сноса', neu: 'Снесённые производственные корпуса, участок готовят под новую застройку' },
  { row: 'Что нужно крану', old: 'Пропуск на территорию с действующим предприятием, часто — режимный', neu: 'Обычный допуск на огороженную стройплощадку нового квартала' },
  { row: 'Какая техника чаще', old: 'Автокран на разовый монтаж/демонтаж оборудования', neu: 'Башенный кран на весь цикл монолитного строительства' },
];
---
<BaseLayout title={title} description={description} path="/uslugi/bashennyy-kran/yuzao/" ldExtra={[breadcrumbLd, serviceLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/uslugi/bashennyy-kran/">Башенный кран</a><span>/</span><span>ЮЗАО</span>
  </nav>

  <section class="section wrap" style="padding-top:8px">
    <div class="section-head">
      <span class="eyebrow">Башенный кран · бывшая промзона «Черёмушки»</span>
      <h1>Башенный кран в ЮЗАО: квартал на месте промзоны «Черёмушки»</h1>
      <p>В районе Котловка, на пересечении улицы Дмитрия Ульянова и Большой Черёмушкинской, на месте бывшей промышленной зоны №9 «Черёмушки» строится реновационный квартал общей площадью более 99 тыс. кв. м — жильё почти на 2 тысячи участников программы реновации, новая местная улица и спортивные площадки на 1,29 га. Для башенного крана это не типовая точечная стройка одного корпуса среди старой застройки, а новый квартал с нуля на расчищенной промышленной территории — с собственным циклом фундаментных работ под несколько зданий подряд.</p>
    </div>
  </section>

  <section class="section wrap prose" style="padding-top:0">
    <h2 style="margin-bottom:18px">Две промзоны округа с похожим названием — разная логика допуска</h2>
    <p>В ЮЗАО у этого сайта уже разобрана промышленная зона №35 «Воронцово» — на странице услуги <a href="/uslugi/kran-na-rezhimnyy-obekt/yuzao/">«Кран на режимный объект в ЮЗАО»</a>. Путать её с промзоной №9 «Черёмушки» не стоит: это разные номерные территории на разных участках округа, и у них противоположная логика допуска техники.</p>
    <table class="compare">
      <caption>Промзона №35 «Воронцово» и промзона №9 «Черёмушки» — не одно и то же</caption>
      <thead><tr><th scope="col"></th><th scope="col">Промзона №35 «Воронцово»</th><th scope="col">Промзона №9 «Черёмушки»</th></tr></thead>
      <tbody>
        {compare.map((c) => (
          <tr>
            <td data-label="">{c.row}</td>
            <td data-label="Промзона №35 «Воронцово»">{c.old}</td>
            <td data-label="Промзона №9 «Черёмушки»">{c.neu}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <p>«Воронцово» — территория, где десятилетиями работают НИИ и электродепо метрополитена и куда кран приезжает по режимному пропуску конкретного предприятия. «Черёмушки» в Котловке — обратный случай: старые производственные корпуса уже снесены, участок готовят под жилой квартал с нуля, и допуск техники — обычный порядок стройплощадки, без пропускной системы действующего режимного соседа.</p>

    <h2 style="margin:36px 0 18px">Не «типовая застройка», а редкое исключение из неё</h2>
    <p>Гео-страница округа описывает Черёмушки, Коньково и Зюзино как максимально типовую жилую застройку 1960-х — капремонт фасадов и кровель без региональных особенностей (подробнее на <a href="/geo/yuzao/">гео-странице ЮЗАО</a>). Квартал на месте промзоны №9 — прямое исключение из этого правила: не ремонт существующих домов, а новое строительство на участке площадью 3,08 га, где до реновации стояли не жилые здания, а промышленные корпуса. Оператора проекта назначило правительство Москвы, инвестиции в редевелопмент участка оцениваются в 19,2 млрд ₽, срок завершения — конец 2028 года.</p>

    <h2 style="margin:36px 0 18px">Что это значит для монтажа и фундамента</h2>
    <p>Квартал строится не одним корпусом, а несколькими зданиями на общей территории новой реновационной застройки — как и на других площадках такого масштаба, для каждого корпуса нужен собственный расчёт фундамента и отдельный пуск крана в работу решением комиссии при монтаже на новом пятне (та же логика, что и на многокорпусных площадках, разобранных на <a href="/uslugi/bashennyy-kran/svao/">странице услуги «Башенный кран в СВАО»</a>). Отдельная особенность площадки на месте бывшей промзоны — грунт, где раньше стояли производственные фундаменты: перед расчётом основания под новый кран уточняем, что именно осталось в грунте после демонтажа старых корпусов, а не считаем участок чистым полем.</p>

    <h2 style="margin:36px 0 18px">Логистика: метро «Академическая» и улица Дмитрия Ульянова</h2>
    <p>Площадка расположена в пешей доступности от станции метро «Академическая», на пересечении улицы Дмитрия Ульянова и Большой Черёмушкинской улицы — обе достаточно широкие для подачи секций башенного крана негабаритным транспортом без объезда через внутриквартальные проезды. Строящаяся рядом новая местная улица по проекту квартала со временем добавит ещё один вариант подъезда, но на период строительства маршрут подачи техники уточняем по актуальной схеме площадки, а не по итоговому генплану квартала.</p>

    <h2 style="margin:36px 0 18px">Что из этого меняет смету</h2>
    <p>Помесячная ставка считается по грузовому моменту крана и не зависит от истории участка — <a href="/uslugi/bashennyy-kran/#price">калькулятор на странице услуги</a> даёт для Котловки ту же цифру, что и для любой другой площадки Москвы. Меняется состав подготовительного этапа: инженерно-геологические изыскания на месте бывшей промзоны и, при необходимости, локальная расчистка грунта от остатков старых фундаментов — это закладывается в график до начала монтажа, а не выясняется при бурении под новый фундамент.</p>
  </section>

  <section class="section wrap prose" style="padding-top:0">
    <Sources
      checked="21.08.2026"
      items={[
        { text: 'Приказ Ростехнадзора от 26.11.2020 №461 (ред. от 16.04.2026): п. 138 — пуск башенного крана в работу решением комиссии при каждом монтаже на новом объекте', href: 'https://www.consultant.ru/document/cons_doc_LAW_373321/' },
        { text: 'mskagency.ru — жилой квартал по реновации на месте промзоны «Черёмушки» в Котловке: 3,08 га между улицами Дмитрия Ульянова и Большой Черёмушкинской, свыше 99 тыс. кв. м, ~60 тыс. кв. м жилья на ~2 тыс. участников программы, инвестиции 19,2 млрд ₽, завершение — конец 2028 года', href: 'https://www.mskagency.ru/materials/3477425' },
        { text: 'kotlovkamedia.ru — тот же проект: спортивные площадки на 1,29 га, новая местная улица, расположение у метро «Академическая»', href: 'https://kotlovkamedia.ru/news/ziloi-kvartal-i-delovye-obekty-poyavyatsya-na-meste-promzony-ceryomuski-v-kotlovke' },
      ]}
      note="Площадь участка, инвестиции и сроки — по данным профильных СМИ на август 2026 года; конкретный застройщик-подрядчик и этажность корпусов на момент проверки источники не называют — эти детали уточняем по факту адреса при приёме заявки, а не указываем на странице приблизительно."
    />
  </section>
</main>
<style>
  .compare { width: 100%; border-collapse: collapse; margin: 6px 0 22px; font-size: var(--t-md); }
  .compare caption { text-align: left; font-family: var(--display); text-transform: uppercase; font-size: var(--t-sm); color: var(--yellow); letter-spacing: .06em; padding-bottom: 12px; }
  .compare th { text-align: left; font-size: var(--t-xs); text-transform: uppercase; letter-spacing: .06em; color: var(--muted); font-weight: 700; padding: 0 16px 8px 0; border-bottom: 2px solid var(--yellow); }
  .compare td { padding: 13px 16px 13px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
  .compare td:first-child { width: 22%; font-weight: 700; color: var(--yellow); }
  @media (max-width: 780px) {
    .compare, .compare tbody, .compare tr, .compare td { display: block; width: 100%; }
    .compare thead { display: none; }
    .compare tr { border-bottom: 2px solid var(--line-strong); padding-bottom: 12px; margin-bottom: 12px; }
    .compare td { border: none; padding: 5px 0; }
    .compare td::before { content: attr(data-label); display: block; font-size: var(--t-xs); text-transform: uppercase; letter-spacing: .06em; color: var(--yellow); margin-bottom: 2px; }
    .compare td:first-child { width: 100%; color: var(--ink); }
    .compare td:first-child::before { content: none; }
  }
</style>
</BaseLayout>
