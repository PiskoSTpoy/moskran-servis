---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Sources from '../../../../components/Sources.astro';

const title = 'Башенный кран в точечной застройке района ЗАО Москвы';
const description = 'Точечная стройка в Раменках: опасная зона башенного крана выходит на чужой двор и проезд. Что это запускает по документам и как зону ограничивают.';

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Башенный кран', item: 'https://moskran-servis.ru/uslugi/bashennyy-kran/' },
    { '@type': 'ListItem', position: 3, name: 'ЗАО', item: 'https://moskran-servis.ru/uslugi/bashennyy-kran/zao/' },
  ],
};
const serviceLd = {
  '@context': 'https://schema.org', '@type': 'Service', serviceType: 'Аренда башенного крана в ЗАО',
  provider: { '@id': 'https://moskran-servis.ru/#organization' }, areaServed: 'ЗАО, Москва',
};

// Куда физически уходит опасная зона в точечной застройке — и что каждый случай
// запускает по документам. Это не «карточка допуска», а разбор одной геометрии.
const spill = [
  {
    where: 'Внутриквартальный проезд',
    triggers: 'Сигнальное ограждение по ГОСТ 23407-78 плюс временная схема движения на период работ, если проезд перекрывается полностью или частично.',
    who: 'ГИБДД и городские службы, отвечающие за организацию движения',
  },
  {
    where: 'Тротуар и пешеходный транзит',
    triggers: 'Ордер на установку временных ограждений — городская процедура со своим сроком, которую запускают раньше, чем заказывают кран.',
    who: 'Город, по порядку из постановления №299-ПП',
  },
  {
    where: 'Эксплуатируемое жилое или офисное здание',
    triggers: 'Решение в проекте производства работ: запретные секторы поворота стрелы либо схема, при которой груз над зданием не проходит. Перенос груза над людьми не согласовывается ничем.',
    who: 'Организация, эксплуатирующая кран, — утверждением ППРк',
  },
  {
    where: 'Земля соседнего собственника',
    triggers: 'Отдельное соглашение о временном использовании территории. Норматива здесь нет — это гражданско-правовой вопрос, и он решается медленнее технических.',
    who: 'Собственник или управляющая организация участка',
  },
];
---
<BaseLayout title={title} description={description} path="/uslugi/bashennyy-kran/zao/" ldExtra={[breadcrumbLd, serviceLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/uslugi/bashennyy-kran/">Башенный кран</a><span>/</span><span>ЗАО</span>
  </nav>

  <section class="section wrap" style="padding-top:8px">
    <div class="section-head">
      <span class="eyebrow">Башенный кран · точечная застройка</span>
      <h1>Башенный кран в точечной застройке ЗАО</h1>
      <p>Раменки и полоса вдоль Кутузовского — это отдельные корпуса, которые встают в уже сложившуюся застройку. Определяющее ограничение здесь не грунт и не подъезд, а геометрия: опасная зона отсчитывается как 5 метров от стрелы и груза плюс поправка на отлёт и почти всегда выходит за забор стройки. Эта страница — про то, что из этого следует и в каком порядке это решается.</p>
    </div>
  </section>

  <section class="section wrap prose" style="padding-top:0">
    <h2 style="margin-bottom:18px">Где на самом деле проходит граница</h2>
    <p>Опасная зона отсчитывается от подвижных рабочих органов машины — для крана это 5 метров от стрелы и груза плюс поправка на возможный отлёт при перемещении. Подробный разбор с требованиями к знакам и ограждению — в статье про <a href="/spravochnik/opasnaya-zona-krana/">опасную зону крана</a>.</p>
    <p>Разница между автокраном и башенным здесь принципиальная, и её регулярно недооценивают на этапе планирования. У автокрана зона — это пятно вокруг машины, ограниченное вылетом на конкретной операции: подъехал, отработал в секторе, уехал. У башенного крана стрела поворачивается на 360°, поэтому в общем случае зона — это круг радиусом полного вылета вокруг башни, действующий весь срок стояния крана. В точечной застройке такой круг гарантированно накрывает что-то, что стройке не принадлежит. Вопрос не «попадём ли», а «во что именно и что с этим делать».</p>
  </section>

  <section class="section wrap" style="padding-top:0">
    <div class="section-head">
      <span class="eyebrow">Разбор по границам</span>
      <h2>Что накрывает зона и что каждый случай запускает</h2>
    </div>
    <table class="spill">
      <thead><tr><th>Куда уходит зона</th><th>Что это запускает</th><th>С кем решается</th></tr></thead>
      <tbody>
        {spill.map((s) => (
          <tr>
            <td data-label="Куда уходит зона">{s.where}</td>
            <td data-label="Что это запускает">{s.triggers}</td>
            <td data-label="С кем решается">{s.who}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="section wrap prose" style="padding-top:0">
    <h2 style="margin-bottom:18px">Три способа уложиться в геометрию</h2>
    <p><b>Сдвинуть башню.</b> Самый дешёвый вариант: точка постановки выбирается так, чтобы рабочий вылет закрывал пятно здания и не выходил на соседей. В точечной застройке он проходит редко — свободного места, из которого достаёт до всей площадки, обычно просто нет.</p>
    <p><b>Ограничить зону принудительно.</b> Если конструкцией крана предусмотрена система ограничения зоны работы, в неё задаются запретные секторы: стрела физически не заходит за заданную границу. Решение принимается не на площадке, а в проекте, и настраивается при пуске крана в работу — вместе с проверкой остальных приборов и устройств безопасности, о которых мы пишем в материалах про <a href="/spravochnik/ogranichitel-gruzopodemnosti/">ограничитель грузоподъёмности</a> и <a href="/spravochnik/konczevye-vyklyuchateli/">концевые выключатели</a>. Плата за такой вариант — сокращение полезной зоны: часть площадки придётся обслуживать иначе.</p>
    <p><b>Развести во времени.</b> Операции, для которых зону не сжать, выносятся в окно, когда проезд или двор можно закрыть. Здесь упираемся в жёсткий потолок: шумные работы в жилой застройке города запрещены с 23:00 до 07:00, и штраф для юридического лица по московскому кодексу — от 40 до 80 тысяч рублей. То есть «сделаем ночью, пока никого нет» в жилых Раменках не работает как план.</p>

    <h2 style="margin:36px 0 18px">Почему здесь не проходит типовой проект</h2>
    <p>Проект производства работ краном обязателен на любом объекте, где применяется грузоподъёмное сооружение, — это не зависит от округа и разобрано в статье про <a href="/spravochnik/ppr-dlya-krana/">ППРк</a>. Но для повторяющихся операций на практике применяют заранее разработанный типовой проект, и вот он в точечной застройке не годится ни в каком виде. Запретные секторы, границы ограждения и порядок работы у края зоны индивидуальны для конкретного адреса: они выводятся из того, что именно стоит вокруг этой площадки. Типовой документ такую границу описать не может по определению.</p>
    <p>Практический вывод для графика: разработка проекта на такой площадке — не формальность на день, а работа, которая ведётся параллельно с согласованием ограждения и доступа. Начинать её после того, как кран уже забронирован, — верный способ оплачивать простой.</p>

    <h2 style="margin:36px 0 18px">Ново-Переделкино и Солнцево — обратный случай</h2>
    <p>В той же ЗАО есть противоположный тип площадок: массовая застройка ближе к МКАД, где вокруг пятна ещё нет ни жилых домов, ни действующих проездов. Там геометрия ничего не ограничивает, и определяющим становится плечо доставки негабаритных секций. Это уже вопрос логистики округа, и он разобран на <a href="/geo/zao/">гео-странице ЗАО</a> — повторять его здесь нет смысла.</p>

    <h2 style="margin:36px 0 18px">Что из этого влияет на смету</h2>
    <p>На саму аренду — ничего: ставка считается по грузовому моменту, и <a href="/uslugi/bashennyy-kran/#price">калькулятор на странице услуги</a> покажет для Раменок ту же цифру, что для любой другой площадки. Влияет другое — то, что стоит перед арендой и оплачивается отдельно: ограждение и знаки по границе зоны, городские процедуры при выходе на проезд или тротуар, соглашения с соседними собственниками. Эти позиции мы называем на этапе расчёта по схеме площадки, а не в день монтажа, потому что дату выезда двигают именно они, а не наличие свободного крана.</p>
  </section>

  <section class="section wrap prose" style="padding-top:0">
    <Sources
      checked="12.08.2026"
      items={[
        { text: 'Приказ Ростехнадзора от 26.11.2020 №461 (ред. от 16.04.2026): производство работ по проекту производства работ кранами; п. 138 — пуск башенного крана в работу решением комиссии', href: 'https://www.consultant.ru/document/cons_doc_LAW_373321/' },
        { text: 'ГОСТ 23407-78 — сигнальное ограждение при выходе опасной зоны за периметр площадки; ГОСТ Р 12.4.026-2001 — знаки на границе зоны' },
        { text: 'Закон г. Москвы от 12.07.2002 №42 и ст. 3.13 КоАП города Москвы — запрет шумных работ с 23:00 до 07:00 и размер штрафа для юридического лица' },
        { text: 'Постановление Правительства Москвы от 19.05.2015 №299-ПП — ордер на установку временных ограждений и размещение временных объектов' },
      ]}
      note="Возможность задать запретные секторы поворота зависит от конструкции и комплектации конкретной машины: это свойство крана, а не универсальное требование Правил."
    />
  </section>
</main>
<style>
  .spill { width: 100%; border-collapse: collapse; font-size: var(--t-md); }
  .spill th {
    text-align: left; font-size: var(--t-xs); text-transform: uppercase; letter-spacing: .06em;
    color: var(--muted); font-weight: 700; padding: 0 18px 10px 0;
    border-bottom: 2px solid var(--yellow);
  }
  .spill td { padding: 15px 18px 15px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
  .spill td:first-child { width: 24%; font-weight: 700; }
  .spill td:last-child { width: 24%; color: var(--muted); font-size: var(--t-md); }
  @media (max-width: 820px) {
    .spill, .spill tbody, .spill tr, .spill td { display: block; width: 100%; }
    .spill thead { display: none; }
    .spill tr { border-bottom: 2px solid var(--line-strong); padding-bottom: 12px; margin-bottom: 12px; }
    .spill td { border: none; padding: 5px 0; }
    .spill td::before {
      content: attr(data-label); display: block; font-size: var(--t-xs); text-transform: uppercase;
      letter-spacing: .06em; color: var(--yellow); margin-bottom: 2px;
    }
    .spill td:first-child, .spill td:last-child { width: 100%; }
  }
</style>
</BaseLayout>
