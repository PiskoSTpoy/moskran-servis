---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Sources from '../../../../components/Sources.astro';

const title = 'Башенный кран в пойме Строгина и Тушина, СЗАО Москвы';
const description = 'Башенный кран на прибрежной площадке СЗАО: почему фундамент в пойме Москвы-реки считают по изысканиям, а не по аналогии с соседним домом.';

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Башенный кран', item: 'https://moskran-servis.ru/uslugi/bashennyy-kran/' },
    { '@type': 'ListItem', position: 3, name: 'СЗАО', item: 'https://moskran-servis.ru/uslugi/bashennyy-kran/szao/' },
  ],
};
const serviceLd = {
  '@context': 'https://schema.org', '@type': 'Service', serviceType: 'Аренда башенного крана в СЗАО',
  provider: { '@id': 'https://moskran-servis.ru/#organization' }, areaServed: 'СЗАО, Москва',
};

// Данные, которые мы запрашиваем ДО расчёта фундамента. Список не декоративный:
// каждая строка отвечает на вопрос «почему без неё расчёт не начинается».
const inputs = [
  {
    what: 'Геология по пятну крана, а не по зданию',
    why: 'Изыскания под дом делаются по контуру дома. Кран нередко стоит в стороне от него — на участке, где скважин не бурили. Разрез в двадцати метрах от точки в пойме может отличаться принципиально.',
  },
  {
    what: 'Отметка грунтовых вод и её сезонный размах',
    why: 'Кран стоит на объекте месяцами и переживает и весенний максимум, и летний минимум. Расчёт ведётся по худшему положению уровня за срок стояния, а не по замеру в день бурения.',
  },
  {
    what: 'Глубина промерзания и поведение грунта при оттаивании',
    why: 'Влагонасыщенный пылеватый грунт пучинист. Плита, принятая по осенним данным, весной может получить неравномерный подъём — а у башни любой перекос умножается на её высоту.',
  },
  {
    what: 'История планировки участка',
    why: 'Если площадку подсыпали, это уже не природный грунт. Правила прямо запрещают устанавливать кран на свеженасыпанный неутрамбованный грунт, и «выглядит ровно» здесь ничего не решает.',
  },
  {
    what: 'Паспортные нагрузки конкретной модели',
    why: 'Фундамент считают не «под башенный кран», а под нагрузки из паспорта конкретной машины: вертикальную составляющую и опрокидывающий момент на максимальном вылете.',
  },
  {
    what: 'План подземных сетей и выемок рядом',
    why: 'Если у пятна проходит траншея или котлован, расстояние от откоса до опор берётся из приложения к Правилам и зависит от глубины и грунта — на слабом грунте это расстояние больше.',
  },
];
---
<BaseLayout title={title} description={description} path="/uslugi/bashennyy-kran/szao/" ldExtra={[breadcrumbLd, serviceLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/uslugi/bashennyy-kran/">Башенный кран</a><span>/</span><span>СЗАО</span>
  </nav>

  <section class="section wrap" style="padding-top:8px">
    <div class="section-head">
      <span class="eyebrow">Башенный кран · пойма Москвы-реки</span>
      <h1>Башенный кран на прибрежной площадке в СЗАО</h1>
      <p>Строгино и Тушино стоят в пойме Москвы-реки, и это единственная причина, по которой у округа есть отдельная страница. Фундамент здесь считается дольше и по другим входным данным: до того как назвать дату монтажа, мы запрашиваем 6 позиций исходных данных по пятну крана, и пока их нет, любой названный срок будет обещанием, а не расчётом. Всё остальное — ставка, порядок монтажа, состав документов — такое же, как в любом другом округе.</p>
    </div>
  </section>

  <section class="section wrap prose" style="padding-top:0">
    <h2 style="margin-bottom:18px">Почему у башенного крана это вообще другая задача</h2>
    <p>Автокран приезжает на смену, встаёт на выносные опоры, отрабатывает и уезжает. Грунт под ним держит нагрузку несколько часов, и если несущей способности не хватает, это видно сразу — по просадке подкладки. Логика подбора площадки под такую работу разобрана отдельно, в статье про <a href="/spravochnik/nesushchaya-sposobnost-grunta/">несущую способность грунта</a>.</p>
    <p>У башенного крана всё иначе по трём пунктам сразу. Во-первых, срок: конструкция стоит на одном месте месяцами и проходит через полный сезонный цикл грунта. Во-вторых, характер нагрузки: помимо постоянного веса, фундамент воспринимает опрокидывающий момент, направление которого меняется вместе с поворотом стрелы, — то есть основание нагружено циклически, а не статически. В-третьих, цена ошибки: у автокрана просадка опоры — это остановка смены, у башни неравномерная осадка плиты — это потеря геометрии всей конструкции, и чем выше башня, тем сильнее у оголовка отзывается миллиметровый перекос у основания. Механику этого мы разбираем в материале про <a href="/spravochnik/ustoychivost-krana/">устойчивость крана</a>.</p>
    <p>Поэтому в пойме мы не переносим сюда практику работы с автокраном. Здесь фундамент — это отдельный проект, а не строка в договоре аренды.</p>
  </section>

  <section class="section wrap" style="padding-top:0">
    <div class="section-head">
      <span class="eyebrow">Входные данные</span>
      <h2>Что мы запрашиваем до того, как назвать дату монтажа</h2>
      <p>Шесть позиций. Пока их нет, любой названный срок будет обещанием, а не расчётом.</p>
    </div>
    <dl class="inputs">
      {inputs.map((i) => (<><dt>{i.what}</dt><dd>{i.why}</dd></>))}
    </dl>
  </section>

  <section class="section wrap prose" style="padding-top:0">
    <h2 style="margin-bottom:18px">Что делать, если изысканий по пятну крана нет</h2>
    <p>Это обычная ситуация, а не форс-мажор: заказчик получил геологию под здание и справедливо считает, что документ по объекту у него есть. Дальше возможны два пути, и оба надо закладывать в календарь заранее.</p>
    <p>Первый — догрузить исходные данные: заказать дополнительные скважины по пятну крана. Это отдельный подряд со своим сроком, и он идёт до проектирования фундамента, а не параллельно ему. Второй — проектировать по имеющимся данным с запасом, приняв худший из встреченных на участке разрез. Такой фундамент выйдет дороже в материалах, зато не удерживает график. Что выгоднее — считается на конкретных цифрах: иногда неделя ожидания скважин дешевле лишнего бетона, иногда наоборот.</p>
    <p>Чего мы не делаем — не принимаем решение «по аналогии с соседним домом». В пойме соседний дом может стоять на другом разрезе.</p>

    <h2 style="margin:36px 0 18px">Что закрывается актом и почему это нельзя отложить</h2>
    <p>Работы по подготовке основания под кран — скрытые: после того как плита забетонирована, проверить, что было под ней, уже невозможно. Поэтому они закрываются <a href="/spravochnik/akt-osvidetelstvovaniya-fundamenta/">актом освидетельствования скрытых работ</a> в момент выполнения, а не задним числом перед приёмкой. На прибрежной площадке этот акт спрашивают внимательнее обычного, и это разумно: именно здесь чаще всего и появляется соблазн «подсыпать и выровнять».</p>

    <h2 style="margin:36px 0 18px">Митино — тот же округ, другая задача</h2>
    <p>СЗАО неоднороден: Митино лежит вне поймы, ближе к МКАД, и по грунтовым условиям это обычная площадка новой застройки без описанной выше специфики. Разница между двумя половинами округа не в удалённости, а в геологии — и определяется она не по административной границе, а по конкретному адресу. Общая картина по округу, включая логистику подачи техники, собрана на <a href="/geo/szao/">гео-странице СЗАО</a>; здесь мы намеренно не повторяем её.</p>

    <h2 style="margin:36px 0 18px">Во что это обходится по времени и деньгам</h2>
    <p>Помесячная ставка от прибрежного расположения не зависит — она считается по грузовому моменту, и <a href="/uslugi/bashennyy-kran/#price">калькулятор на странице услуги</a> даст ту же цифру, что и для любой другой площадки Москвы. Меняется не ставка, а состав подготовительного этапа: изыскания по пятну крана и проектирование фундамента под фактический разрез — это позиции заказчика, и по срокам они идут перед монтажом. Мы называем их в расчёте сразу, чтобы дата пуска крана в работу не оказалась привязана к документу, который ещё не заказан.</p>
  </section>

  <section class="section wrap prose" style="padding-top:0">
    <Sources
      checked="12.08.2026"
      items={[
        { text: 'Приказ Ростехнадзора от 26.11.2020 №461 (ред. от 16.04.2026): п. 108 — запрет установки на свеженасыпанный неутрамбованный грунт и на уклон больше паспортного; п. 111 — расстояние от откоса выемки до опор по приложению к Правилам; п. 138 — пуск башенного крана комиссией', href: 'https://www.consultant.ru/document/cons_doc_LAW_373321/' },
      ]}
      note="Состав входных данных для расчёта фундамента — наша рабочая практика, а не норматив: Правила задают запреты и предельные значения, но не список документов, который подрядчик обязан запросить у заказчика."
    />
  </section>
</main>
<style>
  .inputs { margin: 0; display: grid; gap: 0; }
  .inputs dt {
    font-weight: 700; font-size: var(--t-md); padding: 16px 0 6px;
    border-top: 1px solid var(--line-strong);
  }
  .inputs dt:first-of-type { border-top: 2px solid var(--yellow); }
  .inputs dd { margin: 0 0 16px; color: var(--muted); font-size: var(--t-md); max-width: 68ch; }
  @media (min-width: 900px) {
    .inputs { grid-template-columns: minmax(0, 34%) minmax(0, 1fr); align-items: start; }
    .inputs dt { grid-column: 1; padding-right: 24px; }
    .inputs dd { grid-column: 2; border-top: 1px solid var(--line-strong); padding: 16px 0 0; margin-bottom: 16px; }
    .inputs dd:first-of-type { border-top: 2px solid var(--yellow); }
  }
</style>
</BaseLayout>
