---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Sources from '../../../../components/Sources.astro';

const title = 'Башенный кран на реновации в Зеленограде';
const description = 'Башенный кран на стройке по программе реновации в 19-м микрорайоне Зеленограда: почему дату монтажа определяет не подрядчик, а программа расселения.';

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Башенный кран', item: 'https://moskran-servis.ru/uslugi/bashennyy-kran/' },
    { '@type': 'ListItem', position: 3, name: 'Зеленоград', item: 'https://moskran-servis.ru/uslugi/bashennyy-kran/zelao/' },
  ],
};
const serviceLd = {
  '@context': 'https://schema.org', '@type': 'Service', serviceType: 'Аренда башенного крана в Зеленограде',
  provider: { '@id': 'https://moskran-servis.ru/#organization' }, areaServed: 'Зеленоградский округ, Москва',
};

// Четыре события, которые должны случиться ДО того, как башенный кран
// вообще может выехать на пятно, — и все четыре вне контроля подрядчика.
const gate = [
  { n: '01', t: 'Решение о реновации дома', d: 'Принимается по установленной процедуре; у собственников есть право на исключение дома из программы решением общего собрания — для этого достаточно 1/3 голосов.' },
  { n: '02', t: 'Договор о жилье или компенсация', d: 'Срок заключения договора о предоставлении жилья либо выплаты равноценного денежного возмещения — не менее 90 дней с даты решения о реновации дома. Быстрее эта строка графика идти не может по закону.' },
  { n: '03', t: 'Расселение и вывод дома из эксплуатации', d: 'После завершения расчётов с жителями старый дом выводится из эксплуатации по упрощённым земельно-имущественным процедурам, установленным именно для реновации — это отдельный, ускоренный порядок, а не общий для любого сноса.' },
  { n: '04', t: 'Снос и расчистка пятна', d: 'Только после вывода из эксплуатации площадка физически освобождается под фундамент нового дома — и лишь на этом шаге в графике впервые появляется дата, от которой можно считать монтаж крана.' },
];
---
<BaseLayout title={title} description={description} path="/uslugi/bashennyy-kran/zelao/" ldExtra={[breadcrumbLd, serviceLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/uslugi/bashennyy-kran/">Башенный кран</a><span>/</span><span>Зеленоград</span>
  </nav>

  <section class="section wrap" style="padding-top:8px">
    <div class="section-head">
      <span class="eyebrow">Башенный кран · программа реновации</span>
      <h1>Башенный кран на реновации в Зеленограде</h1>
      <p>До сих пор единственной темой Зеленограда на этом сайте были предприятия электронной промышленности — «Микрон» и «Ангстрем». С июля 2026 года в округе идёт стройка другого типа: по программе реновации на пересечении улиц Советской и Второй Пятилетки, в 19-м микрорайоне, возводится дом переменной этажности до 23 этажей общей площадью 82,6 тыс. кв. м, сдача запланирована на декабрь 2028 года. Для башенного крана здесь важен не грунт и не пропускной режим предприятия, а то, что дату монтажа определяет не строительный график подрядчика, а городская программа расселения.</p>
    </div>
  </section>

  <section class="section wrap" style="padding-top:0">
    <div class="section-head">
      <span class="eyebrow">До даты монтажа</span>
      <h2>Четыре события, которые проходят раньше, чем кран увидит площадку</h2>
      <p>Это не этапы монтажа — это административная цепочка, которая должна завершиться до того, как монтаж вообще можно начать планировать.</p>
    </div>
    <ol class="gate">
      {gate.map((g) => (<li><span class="gate__n">{g.n}</span><div><h3>{g.t}</h3><p>{g.d}</p></div></li>))}
    </ol>
  </section>

  <section class="section wrap prose" style="padding-top:0">
    <h2 style="margin-bottom:18px">Почему это не формальность для графика</h2>
    <p>Особый правовой режим реновации жилищного фонда Москвы установлен Федеральным законом от 01.07.2017 №141-ФЗ — он же задаёт минимальный срок на договор или компенсацию (90 дней) и упрощённые земельно-имущественные процедуры при выводе старых домов из эксплуатации. На практике это значит: площадка под будущий 23-этажный дом на Советской освобождается только после того, как расселены и снесены как минимум пятиэтажки 4 и 6 на той же улице, — а расселение само по себе не ускоряется тем, что кран уже можно было бы забронировать. Мы называем это отдельной строкой в предварительном расчёте, а не переносим риск на дату, которую подрядчик не контролирует.</p>

    <h2 style="margin:36px 0 18px">Переменная этажность — тот же вопрос, что и в СВАО, но на одном адресе</h2>
    <p>Секции дома высотой до 23 этажей требуют более тяжёлого класса крана по грузовому моменту, чем более низкие части того же здания, — тот же принцип, что и на многокорпусной площадке переменной этажности в другом округе сети, см. страницу <a href="/uslugi/bashennyy-kran/svao/">«Башенный кран у Ботанического сада в СВАО»</a>. Разница в том, что там это пять отдельных корпусов одного жилого комплекса, а здесь — секции переменной высоты в границах одного дома на одном фундаменте: подбор класса крана и точки его установки делается под самую высокую часть здания, а не усредняется по фасаду.</p>

    <h2 style="margin:36px 0 18px">Зеленоград остаётся Зеленоградом: расстояние не исчезает</h2>
    <p>Территориальная обособленность округа, разобранная на <a href="/geo/zelao/">гео-странице Зеленограда</a>, никуда не девается и на стройке реновации: порядка 37 км от МКАД по Ленинградскому шоссе — то же расстояние, что и для промышленных объектов, описанных на странице <a href="/uslugi/kran-na-rezhimnyy-obekt/zelao/">«Кран на режимный объект в Зеленограде»</a>. Для башенного крана это означает не разовую поездку, а несколько рейсов негабаритного транспорта под секции башни на монтаже и столько же на демонтаже — логистическое плечо считается по каждому рейсу, а не по одной усреднённой цифре.</p>

    <h2 style="margin:36px 0 18px">Что из этого меняет смету</h2>
    <p>Помесячная ставка от программы реновации не зависит — она считается по грузовому моменту крана, и <a href="/uslugi/bashennyy-kran/#price">калькулятор на странице услуги</a> даст для Советской улицы ту же цифру, что и для любой другой площадки Москвы. Меняется то, что стоит перед арендой: точную дату начала монтажа мы называем только после того, как площадка официально расчищена и передана под строительство, — обещать дату раньше этого момента значило бы обещать то, что не в нашей власти ускорить.</p>
  </section>

  <section class="section wrap prose" style="padding-top:0">
    <Sources
      checked="19.08.2026"
      items={[
        { text: 'Федеральный закон от 01.07.2017 №141-ФЗ «О внесении изменений в Закон Российской Федерации «О статусе столицы Российской Федерации»...» — правовой режим реновации, срок договора/компенсации не менее 90 дней, упрощённые земельно-имущественные процедуры', href: 'https://www.consultant.ru/law/hotdocs/50061.html' },
        { text: 'Приказ Ростехнадзора от 26.11.2020 №461 (ред. от 16.04.2026): п. 138 — пуск башенного крана в работу решением комиссии', href: 'https://www.consultant.ru/document/cons_doc_LAW_373321/' },
      ]}
      note="Адрес, этажность, площадь и сроки строительства дома на Советской — по открытым публикациям о ходе программы реновации в Зеленограде на август 2026 года; точная дата начала монтажа крана определяется по факту расчистки пятна, а не заранее."
    />
  </section>
</main>
<style>
  .gate { list-style: none; counter-reset: g; margin: 0; padding: 0; display: grid; gap: 2px; }
  .gate li { display: grid; grid-template-columns: 52px 1fr; gap: 16px; background: var(--bg-2); padding: 18px 22px 20px; border-left: 3px solid transparent; background-image: var(--hazard-edge); background-repeat: no-repeat; background-size: 3px 100%; background-position: left top; background-origin: border-box; }
  .gate__n { font-family: var(--display); font-size: 1.5rem; color: var(--yellow); line-height: 1.3; }
  .gate h3 { font-size: var(--t-md); margin: 0 0 6px; }
  .gate p { margin: 0; color: var(--muted); font-size: var(--t-md); max-width: 70ch; }
  @media (max-width: 620px) {
    .gate li { grid-template-columns: 34px 1fr; padding: 14px 16px; gap: 12px; }
    .gate__n { font-size: var(--t-h3); }
  }
</style>
</BaseLayout>
