---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Sources from '../../../../components/Sources.astro';

const title = 'Башенный кран у границы Лосиного острова, ВАО Москвы';
const description = 'Башенный кран для реновации в Гольянове и Метрогородке ВАО: площадка у границы охранной зоны нацпарка «Лосиный остров» — что это добавляет к проекту.';

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Башенный кран', item: 'https://moskran-servis.ru/uslugi/bashennyy-kran/' },
    { '@type': 'ListItem', position: 3, name: 'ВАО', item: 'https://moskran-servis.ru/uslugi/bashennyy-kran/vao/' },
  ],
};
const serviceLd = {
  '@context': 'https://schema.org', '@type': 'Service', serviceType: 'Аренда башенного крана в ВАО',
  provider: { '@id': 'https://moskran-servis.ru/#organization' }, areaServed: 'ВАО, Москва',
};

// Чем граница парка отличается от территории парка — по каждому пункту
// понятно, что именно проверяется и почему это не делается на глаз.
const checks = [
  {
    n: '01',
    t: 'Попадает ли пятно в охранную зону',
    d: 'Граница парка и граница охранной зоны вокруг него — разные линии. Вторая проходит дальше в жилую застройку и на карте общего пользования отмечена не всегда явно. Уточняем у дирекции парка до даты монтажа, а не по факту работ.',
  },
  {
    n: '02',
    t: 'Что именно ограничено на этой территории',
    d: 'В охранной зоне запрещена деятельность, способная навредить природным комплексам парка. Это не автоматический запрет на кран, а требование согласовать конкретные работы — и согласование идёт по срокам отдельно от стройки.',
  },
  {
    n: '03',
    t: 'Радиус кроны деревьев вдоль границы',
    d: 'Если площадка примыкает к лесной части парка, разворот стрелы и снос веток при подъёме секций считают отдельно — повреждение древостоя на территории нацпарка не входит в допустимые издержки монтажа, в отличие от обычной городской зелени во дворе.',
  },
];
---
<BaseLayout title={title} description={description} path="/uslugi/bashennyy-kran/vao/" ldExtra={[breadcrumbLd, serviceLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/uslugi/bashennyy-kran/">Башенный кран</a><span>/</span><span>ВАО</span>
  </nav>

  <section class="section wrap" style="padding-top:8px">
    <div class="section-head">
      <span class="eyebrow">Башенный кран · охранная зона нацпарка</span>
      <h1>Башенный кран у границы Лосиного острова в ВАО</h1>
      <p>Гольяново, Метрогородок и часть Богородского примыкают к национальному парку «Лосиный остров» — федеральной особо охраняемой природной территории площадью 12 881 га, а не рядовому городскому скверу. Здесь идёт активная реновация, и площадки нередко стоят вплотную к границе парка или его охранной зоны. Это единственное, что отличает монтаж башенного крана здесь от любого другого округа, — и разбирается это до того, как кран забронирован, а не на площадке.</p>
    </div>
  </section>

  <section class="section wrap prose" style="padding-top:0">
    <h2 style="margin-bottom:18px">Парк федерального значения, а не городской сквер</h2>
    <p>«Лосиный остров» создан постановлением 1983 года как первый в России национальный парк на границе крупного города, его площадь — 12 881 га, из них московская часть примыкает к четырём округам: Метрогородку, Гольянову, Богородскому и частично Сокольникам. Территория живёт по режиму, утверждённому <b>Приказом Минприроды России от 26.03.2012 №82</b> «Об утверждении Положения о национальном парке «Лосиный остров»» (в развитие Постановления Правительства РФ от 29.03.2000 №280), и делится на функциональные зоны — от заповедной до рекреационной, с разным уровнем ограничений.</p>
    <p>У парка есть отдельная охранная зона — самостоятельная территория вокруг границы, порядка 5 874 га, где по <b>статье 3 Федерального закона от 14.03.1995 №33-ФЗ</b> «Об особо охраняемых природных территориях» ограничена хозяйственная деятельность, способная навредить природным комплексам. Разница с обычной городской зелёной зоной принципиальная: там ограничения устанавливает застройщик или проект благоустройства, здесь — федеральный закон и дирекция парка, и обойти это нельзя.</p>
  </section>

  <section class="section wrap" style="padding-top:0">
    <div class="section-head">
      <span class="eyebrow">Проверка до монтажа</span>
      <h2>Что уточняем, если площадка стоит близко к границе</h2>
    </div>
    <ol class="chk">
      {checks.map((c) => (<li><span class="chk__n">{c.n}</span><div><h3>{c.t}</h3><p>{c.d}</p></div></li>))}
    </ol>
  </section>

  <section class="section wrap prose" style="padding-top:0">
    <h2 style="margin-bottom:18px">Гольяново и Богородское — реновация у самой границы</h2>
    <p>Именно в этих двух районах сейчас идёт основной объём строительства по программе реновации, разобранной на <a href="/geo/vao/">гео-странице ВАО</a> в общих чертах. В Гольянове стартовые площадки стоят, в частности, по Амурской и Байкальской улицам, в Богородском — по Игральной улице; часть корпусов уже сдана, часть в работе на 2026 год. Ни одна из этих площадок не находится глубоко в лесном массиве — все они городская жилая застройка, — но близость к границе парка означает, что перед графиком монтажа стоит одна дополнительная строка: подтверждение статуса территории. Пропустить её — риск не штрафа на площадке, а срыва даты, потому что согласование с дирекцией парка идёт по своему регламенту и не ускоряется тем, что кран уже подан к месту работ.</p>
    <p>Требования Правил к самому крану от соседства с парком не меняются — фундамент, устойчивость и порядок пуска в работу разобраны в статье про <a href="/spravochnik/ustoychivost-krana/">устойчивость крана</a> и одинаковы для любой площадки Москвы. Меняется состав подготовительного этапа: там, где обычно нужен только <a href="/spravochnik/ppr-dlya-krana/">проект производства работ</a>, здесь к нему добавляется запрос статуса территории и, если пятно попало в охранную зону, согласование конкретных работ с дирекцией.</p>

    <h2 style="margin:36px 0 18px">Сокольники — другая часть того же соседства</h2>
    <p>Парк «Сокольники» на юге округа — отдельная охраняемая территория с собственным режимом, не входящая в «Лосиный остров», и городская застройка вокруг него живёт по своим правилам благоустройства, а не по федеральному закону об ООПТ. Различие между этими двумя соседствами — то, зачем нужна проверка конкретного адреса, а не общее правило «рядом с парком».</p>

    <h2 style="margin:36px 0 18px">Что из этого меняет смету</h2>
    <p>Помесячная ставка не зависит от близости к парку — она считается по грузовому моменту, и <a href="/uslugi/bashennyy-kran/#price">калькулятор на странице услуги</a> покажет для Гольянова ту же цифру, что и для любого другого округа. Стоимость самой аренды соседство с ООПТ не увеличивает; на срок влияет только время, которое уходит на подтверждение статуса территории до начала работ, — и это единственная позиция, которую стоит закладывать в график заранее, если адрес рядом с границей парка.</p>
  </section>

  <section class="section wrap prose" style="padding-top:0">
    <Sources
      checked="19.08.2026"
      items={[
        { text: 'Федеральный закон от 14.03.1995 №33-ФЗ «Об особо охраняемых природных территориях», ст. 3 — режим охранных зон', href: 'https://www.consultant.ru/document/cons_doc_LAW_6072/' },
        { text: 'Приказ Минприроды России от 26.03.2012 №82 «Об утверждении Положения о национальном парке «Лосиный остров»» (Минюст 20.08.2012 №25218)', href: 'https://www.consultant.ru/document/cons_doc_LAW_134342/' },
        { text: 'Приказ Ростехнадзора от 26.11.2020 №461 (ред. от 16.04.2026): п. 138 — пуск башенного крана в работу решением комиссии', href: 'https://www.consultant.ru/document/cons_doc_LAW_373321/' },
      ]}
      note="Точные границы охранной зоны и перечень площадок, где требуется согласование с дирекцией парка, уточняются по конкретному адресу — общей карты с привязкой к номерам домов в открытом доступе нет."
    />
  </section>
</main>
<style>
  .chk { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .chk li { display: grid; grid-template-columns: 44px 1fr; gap: 16px; background: var(--bg-2); padding: 16px 20px; border-left: 3px solid transparent; background-image: var(--hazard-edge); background-repeat: no-repeat; background-size: 3px 100%; background-position: left top; background-origin: border-box; }
  .chk__n { font-family: var(--display); font-size: 1.3rem; color: var(--yellow); line-height: 1.5; }
  .chk h3 { font-size: var(--t-md); margin: 0 0 6px; }
  .chk p { margin: 0; color: var(--muted); font-size: var(--t-md); max-width: 66ch; }
  @media (max-width: 620px) {
    .chk li { grid-template-columns: 28px 1fr; padding: 14px 16px; gap: 12px; }
    .chk__n { font-size: var(--t-lead); }
  }
</style>
</BaseLayout>
