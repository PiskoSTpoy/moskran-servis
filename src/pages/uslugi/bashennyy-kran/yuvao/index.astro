---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Sources from '../../../../components/Sources.astro';

const title = 'Башенный кран в Некрасовке на бывших полях аэрации, ЮВАО';
const description = 'Башенный кран в Некрасовке ЮВАО: площадка стоит на территории бывших Люберецких полей аэрации — почему фундамент начинается с экологических изысканий.';

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Башенный кран', item: 'https://moskran-servis.ru/uslugi/bashennyy-kran/' },
    { '@type': 'ListItem', position: 3, name: 'ЮВАО', item: 'https://moskran-servis.ru/uslugi/bashennyy-kran/yuvao/' },
  ],
};
const serviceLd = {
  '@context': 'https://schema.org', '@type': 'Service', serviceType: 'Аренда башенного крана в ЮВАО',
  provider: { '@id': 'https://moskran-servis.ru/#organization' }, areaServed: 'ЮВАО, Москва',
};

// Два грунта под одним словом «Некрасовка» — свежая застройка сверху и
// то, что от прежнего использования территории осталось в глубине.
const layers = [
  {
    t: 'То, что видно на площадке',
    d: 'Ровный участок новой застройки: широкие проезды, свежие инженерные сети, ничего похожего на промзону или пойму. По внешнему виду площадка не отличается от любой другой новостройки на окраине округа.',
  },
  {
    t: 'То, что показывают изыскания',
    d: 'До 1963 года территория работала как поля орошения канализационными стоками — часть системы, действовавшей с начала XX века. По итогам экологического обследования в почвах на этой территории фиксировались превышения по ряду тяжёлых металлов. Это не делает площадку непригодной для строительства — жилые кварталы здесь уже возводятся, — но обязывает подтверждать состояние грунта документом, а не полагаться на внешний вид.',
  },
];
---
<BaseLayout title={title} description={description} path="/uslugi/bashennyy-kran/yuvao/" ldExtra={[breadcrumbLd, serviceLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/uslugi/bashennyy-kran/">Башенный кран</a><span>/</span><span>ЮВАО</span>
  </nav>

  <section class="section wrap" style="padding-top:8px">
    <div class="section-head">
      <span class="eyebrow">Башенный кран · техногенный грунт</span>
      <h1>Башенный кран в Некрасовке на полях аэрации</h1>
      <p>Некрасовка — самый молодой район ЮВАО, застроенный почти целиком за последнее десятилетие. Но земля под новыми кварталами — не чистое поле: до 1963 года здесь работали Люберецкие поля аэрации, часть канализационной системы Москвы. Для монтажа башенного крана это значит один дополнительный вопрос к изысканиям, которого не возникает на соседних площадках округа.</p>
    </div>
  </section>

  <section class="section wrap" style="padding-top:0">
    <div class="section-head">
      <span class="eyebrow">Один адрес, два слоя</span>
      <h2>Что видно на площадке — и что скрыто под ней</h2>
    </div>
    <div class="layers">
      {layers.map((l) => (<div class="layers__card"><h3>{l.t}</h3><p>{l.d}</p></div>))}
    </div>
  </section>

  <section class="section wrap prose" style="padding-top:0">
    <h2 style="margin-bottom:18px">Почему это вопрос к изысканиям, а не к несущей способности</h2>
    <p>Обычный вопрос к грунту под башенным краном — выдержит ли он паспортные нагрузки конкретной модели, вертикальную составляющую и опрокидывающий момент. Этому посвящена отдельная статья про <a href="/spravochnik/nesushchaya-sposobnost-grunta/">несущую способность грунта</a>, и в Некрасовке несущая способность обычно не проблема — участок давно спланирован под массовую жилую застройку, и десятки корпусов уже стоят на нём без осадочных нарушений.</p>
    <p>Вопрос здесь другой: что происходит с вынутым грунтом при устройстве котлована под фундамент крана. Если участок относится к территории бывших полей аэрации, инженерно-геологические изыскания по своду правил СП 47.13330.2016 дополняются инженерно-экологическими — отдельным видом изысканий, который проверяет химический состав грунта, а не только его механику. Это не формальность на бумаге: если анализ подтверждает превышения по загрязняющим веществам, вынутый грунт при котловане под фундамент крана нельзя просто вывезти как обычный строительный — с ним обращаются как с отходом определённого класса опасности по Федеральному классификационному каталогу отходов, что меняет и подрядчика на вывоз, и срок этого этапа.</p>
    <p>Разница с пойменным грунтом СЗАО — в самой природе проблемы. Там вопрос в поведении естественного слабого грунта под циклической нагрузкой месяцами, разобранный на странице <a href="/uslugi/bashennyy-kran/szao/">башенного крана в СЗАО</a>. Здесь грунт может быть механически вполне пригоден — проблема не в том, выдержит ли он башню, а в том, что находится в его составе после полувека другого использования территории.</p>

    <h2 style="margin:36px 0 18px">Что закрывает изыскания, а что — нет</h2>
    <p>Экологические изыскания отвечают на вопрос про состав грунта один раз, на этапе проектирования, и не заменяют скрытые работы по устройству самого фундамента: их результат так же закрывается <a href="/spravochnik/akt-osvidetelstvovaniya-fundamenta/">актом освидетельствования</a>, как и на любой другой площадке. Разница в том, что на этой территории пакет документов перед актом на одну позицию длиннее, и запрашивать её стоит на этапе расчёта, а не когда экскаватор уже вскрыл котлован.</p>

    <h2 style="margin:36px 0 18px">Марьино и Люблино рядом — без этой специфики</h2>
    <p>Соседние крупные районы округа, разобранные на <a href="/geo/yuvao/">гео-странице ЮВАО</a>, — обычная советская жилая застройка на естественном грунте без истории промышленного или коммунального использования территории. Разница определяется не удалённостью от центра округа, а тем, что именно было на конкретном участке полвека назад, — и это единственная причина, по которой у Некрасовки есть отдельная страница, а не у всего ЮВАО целиком.</p>

    <h2 style="margin:36px 0 18px">Что из этого меняет смету</h2>
    <p>Помесячная ставка от истории участка не зависит — она считается по грузовому моменту, и <a href="/uslugi/bashennyy-kran/#price">калькулятор на странице услуги</a> даст ту же цифру, что и для любой другой площадки Москвы. Отдельной строкой в расчёте идут инженерно-экологические изыскания там, где участок относится к территории бывших полей аэрации, и вывоз грунта по регламенту обращения с отходами, если анализ подтвердит превышения, — обе позиции называем при расчёте по адресу, а не после того, как котлован уже открыт.</p>
  </section>

  <section class="section wrap prose" style="padding-top:0">
    <Sources
      checked="19.08.2026"
      items={[
        { text: 'СП 47.13330.2016 «Инженерные изыскания для строительства. Основные положения» — состав видов изысканий, включая инженерно-экологические' },
        { text: 'Федеральный закон от 24.06.1998 №89-ФЗ «Об отходах производства и потребления» — обращение с отходами по классам опасности', href: 'https://www.consultant.ru/document/cons_doc_LAW_19109/' },
        { text: 'Приказ Ростехнадзора от 26.11.2020 №461 (ред. от 16.04.2026): п. 108 — запрет установки на свеженасыпанный неутрамбованный грунт', href: 'https://www.consultant.ru/document/cons_doc_LAW_373321/' },
      ]}
      note="Данные о превышениях по тяжёлым металлам — по открытым материалам экологического обследования территории бывших полей аэрации; фактический класс опасности грунта на конкретном пятне определяется анализом изыскателя, а не общей характеристикой района."
    />
  </section>
</main>
<style>
  .layers { display: grid; gap: 14px; }
  .layers__card { background: var(--bg-2); border-left: 3px solid transparent; background-image: var(--hazard-edge); background-repeat: no-repeat; background-size: 3px 100%; background-position: left top; background-origin: border-box; padding: 18px 20px; }
  .layers__card h3 { font-size: var(--t-xs); text-transform: uppercase; letter-spacing: .06em; margin: 0 0 8px; color: var(--muted); }
  .layers__card p { margin: 0; font-size: var(--t-md); }
  @media (min-width: 760px) {
    .layers { grid-template-columns: 1fr 1fr; }
  }
</style>
</BaseLayout>
