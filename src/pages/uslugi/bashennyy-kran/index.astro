  .pricebar__field select { background: var(--bg); border: 1px solid var(--line-strong); color: var(--ink); padding: 11px 12px; min-height: 44px; font-family: inherit; font-size: var(--t-md); }
  .pricebar__check { display: flex; align-items: center; gap: 10px; font-size: var(--t-md); cursor: pointer; min-height: 44px; }
