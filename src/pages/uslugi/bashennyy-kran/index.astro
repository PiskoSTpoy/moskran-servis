</style>
</BaseLayout>

<script>
  function initTowerCalc() {
    const cls = document.getElementById('calc-tm-class') as HTMLSelectElement | null;
    const months = document.getElementById('calc-tm-months') as HTMLSelectElement | null;
    const mount = document.getElementById('calc-tm-mount') as HTMLInputElement | null;
    const total = document.getElementById('calc-tm-total');
    if (!cls || !months || !mount || !total) return;
    const MOUNT_FEE = 380000;
    function recalc() {
      const rate = Number(cls!.selectedOptions[0].dataset.rate);
      const n = Number(months!.value);
      let sum = rate * n;
      if (mount!.checked) sum += MOUNT_FEE;
      total!.textContent = 'от ' + sum.toLocaleString('ru-RU') + ' ₽';
    }
    cls.addEventListener('change', recalc);
    months.addEventListener('change', recalc);
    mount.addEventListener('change', recalc);
    recalc();
  }
  initTowerCalc();
</script>
