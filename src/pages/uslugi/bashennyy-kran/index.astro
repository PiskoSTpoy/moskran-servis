  .okrug-links a:hover { border-color: var(--yellow); color: var(--yellow); }
</style>
<style>
  .adm { width: 100%; border-collapse: collapse; margin: 8px 0 0; font-size: var(--t-md); }
  .adm caption { text-align: left; font-family: var(--display); text-transform: uppercase; font-size: var(--t-sm); color: var(--yellow); letter-spacing: .06em; padding-bottom: 12px; }
  .adm th { text-align: left; font-size: var(--t-xs); text-transform: uppercase; letter-spacing: .06em; color: var(--muted); font-weight: 700; padding: 0 14px 8px 0; border-bottom: 1px solid var(--line-strong); }
  .adm td { padding: 13px 14px 13px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
  .adm td:first-child { width: 20%; font-weight: 700; }
  .adm td:nth-child(3) { width: 18%; color: var(--yellow); font-size: var(--t-md); }
  .adm td:last-child { width: 22%; color: var(--muted); font-size: var(--t-sm); }
  .adm-links { list-style: none; margin: 20px 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px 20px; }
  .adm-links a { font-size: var(--t-md); font-weight: 600; text-decoration: none; border-bottom: 1px solid var(--line-strong); padding-bottom: 2px; }
  .adm-links a:hover { color: var(--yellow); border-bottom-color: var(--yellow); }
  .qa h3 { font-size: 1rem; margin-top: 26px; }
