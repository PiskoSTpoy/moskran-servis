  .pricebar__out-label { display: block; font-size: var(--t-xs); color: var(--muted); }
  .pricebar__note { font-size: var(--t-sm); color: var(--muted); }
  /* Волна 39: явный font-weight: 400. У Russo One ровно одно начертание, а <b> по умолчанию UA получает bold — браузер рисовал СИНТЕТИЧЕСКИЙ жир: обводит контур сам, и на квадратном гротеске это читается как замыленное число, а не как акцент. Именно эти <b> — самые крупные цифры сайта. */
  .pricebar__out b { display: block; font-size: var(--t-num); font-family: var(--display); font-weight: 400; color: var(--yellow); margin-top: 6px; }
  .okrug-links { display: flex; flex-wrap: wrap; gap: 12px; }
