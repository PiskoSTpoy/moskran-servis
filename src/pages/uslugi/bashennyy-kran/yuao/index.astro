---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Sources from '../../../../components/Sources.astro';

const title = 'Башенный кран на редевелопменте завода ЗИЛ, ЮАО Москвы';
const description = 'Башенный кран в ЮАО на территории бывшего завода: обратная засыпка, техзона метро, перенос крана между очередями застройки.';

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Башенный кран', item: 'https://moskran-servis.ru/uslugi/bashennyy-kran/' },
    { '@type': 'ListItem', position: 3, name: 'ЮАО', item: 'https://moskran-servis.ru/uslugi/bashennyy-kran/yuao/' },
  ],
};
const serviceLd = {
  '@context': 'https://schema.org', '@type': 'Service', serviceType: 'Аренда башенного крана в ЮАО',
  provider: { '@id': 'https://moskran-servis.ru/#organization' }, areaServed: 'ЮАО, Москва',
};

// Перенос крана между очередями застройки — не «переставили», а полный цикл.
// Считается как отдельный проект, поэтому расписан по стадиям.
const stages = [
  { n: 'Демонтаж', t: 'Разборка секций сверху вниз автокраном-помощником — та же бригада и та же техника, что и на монтаже. Площадка предыдущей очереди должна быть свободна для их работы, а к этому моменту она обычно уже застроена.' },
  { n: 'Перебазирование', t: 'Секции и стрела уезжают негабаритным транспортом. Даже если новое пятно в трёхстах метрах, машина всё равно тяжеловесная, и правила её движения по территории и городу не меняются.' },
  { n: 'Новый фундамент', t: 'Считается заново, под грунт нового пятна. Плита предыдущей очереди не переносится и не «засчитывается» — это отдельная конструкция под отдельные условия.' },
  { n: 'Повторный пуск в работу', t: 'Ключевая строка графика: решение о пуске принимается комиссией с участием представителя надзорного органа, и это процедура при каждой установке на новом объекте, а не один раз на договор аренды.' },
];
---
<BaseLayout title={title} description={description} path="/uslugi/bashennyy-kran/yuao/" ldExtra={[breadcrumbLd, serviceLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/uslugi/bashennyy-kran/">Башенный кран</a><span>/</span><span>ЮАО</span>
  </nav>

  <section class="section wrap" style="padding-top:8px">
    <div class="section-head">
      <span class="eyebrow">Башенный кран · редевелопмент промзоны</span>
      <h1>Башенный кран на территории бывшего ЗИЛа</h1>
      <p>Стройка на месте работавшего десятилетиями завода отличается от стройки в чистом поле тремя вещами, и все три касаются крана напрямую: у грунта есть биография, под площадкой может проходить техническая зона метрополитена шириной 40 метров в обе стороны от оси действующей линии, а сам проект живёт очередями и длиннее срока одного монтажа.</p>
    </div>
  </section>

  <section class="section wrap prose" style="padding-top:0">
    <h2 style="margin-bottom:18px">Грунт, у которого есть биография</h2>
    <p>Редевелопмент — это не расчистка, а последовательность земляных работ: демонтаж старых фундаментов, выемка и обратная засыпка пазух, перекладка сетей, планировка. К моменту, когда площадка выглядит готовой, значительная часть её верхнего слоя — это грунт, который сюда положили заново. Правила на этот счёт однозначны: устанавливать кран на свеженасыпанный неутрамбованный грунт нельзя, и внешняя ровность площадки к делу не относится.</p>
    <p>От прибрежных площадок в других округах эта задача отличается характером неоднородности. Природный слабый грунт ведёт себя более-менее предсказуемо: он одинаково слаб на всём участке, и расчёт по худшему разрезу закрывает вопрос. Техногенное основание пятнистое: на месте демонтированного фундамента цеха — одно, в двух метрах, где шла засыпанная траншея, — совсем другое. Поэтому здесь мы просим у заказчика не только геологию, но и исполнительную документацию по демонтажу и обратной засыпке: она показывает, где именно копали и чем засыпали. Как это связано с давлением на пятно, разобрано в статье про <a href="/spravochnik/nesushchaya-sposobnost-grunta/">несущую способность грунта</a>.</p>
    <p>Отдельная строка — подземные остатки. Обломки старых конструкций под пятном плиты мешают не тем, что их надо убрать, а тем, что они делают осадку неравномерной, а неравномерная осадка для башни опаснее, чем равномерная и большая.</p>

    <h2 style="margin:36px 0 18px">Техническая зона метрополитена</h2>
    <p>Это ограничение застаёт врасплох чаще прочих, потому что оно не про грунт под краном и не про допуск машины — оно про сам факт производства работ в определённом коридоре. Границы заданы приказом Москомархитектуры: 40 метров в обе стороны от оси действующих линий метрополитена, 20 метров — от строящихся; работы ближе 10 метров ведутся по совместному решению с метрополитеном.</p>
    <p>Практических следствий два. Первое: считать надо от оси в обе стороны, а не от видимого края наземных сооружений — на поверхности линия ничем себя не обозначает. Второе: согласующий здесь не город и не надзорный орган, а метрополитен, и это отдельная процедура со своим сроком, идущая параллельно всему остальному. Если точка постановки крана попадает в коридор, срок проекта определяется этой процедурой, а не готовностью фундамента.</p>

    <h2 style="margin:36px 0 18px">Пропуск, который нужен не один раз</h2>
    <p>На территории масштабной застройки обычно действует единый контрольно-пропускной режим: доступ оформляет застройщик или генподрядчик по своему регламенту, а не по общему городскому порядку. Для автокрана это разовая история — оформили технику и бригаду на смену. Для башенного крана иначе: монтаж идёт несколько дней, и на территорию по очереди заезжает автокран-помощник и каждая машина с секцией. То есть нужен не пропуск, а согласованный график заездов, причём согласованный с общим графиком стройки, где в те же ворота едут бетон и арматура. Порядок оформления и то, чем режим ЗИЛа отличается от охранных зон музеев-заповедников в том же округе, разобраны на странице <a href="/uslugi/kran-na-rezhimnyy-obekt/yuao/">крана на режимный объект в ЮАО</a>.</p>
  </section>

  <section class="section wrap" style="padding-top:0">
    <div class="section-head">
      <span class="eyebrow">Между очередями</span>
      <h2>Что на самом деле означает «перенести кран на соседний участок»</h2>
      <p>На крупном редевелопменте это плановая операция, а не исключение. Но переносится не кран — заново проходится весь цикл, четырьмя стадиями.</p>
    </div>
    <ol class="stages">
      {stages.map((s) => (<li><h3>{s.n}</h3><p>{s.t}</p></li>))}
    </ol>
  </section>

  <section class="section wrap prose" style="padding-top:0">
    <h2 style="margin-bottom:18px">Как это учесть в договоре заранее</h2>
    <p>Если проект многоочередной, возможность переноса оговаривается на этапе первичного монтажа, а не когда первая очередь уже сдана. Причина простая: от этого зависит выбор модели. Кран, который придётся переставлять, разумно брать из тех, чья схема монтажа не завязана на крепление к конкретному зданию, — иначе на новом пятне решение придётся пересобирать целиком. Логистика и остальная застройка округа — на <a href="/geo/yuao/">гео-странице ЮАО</a>.</p>

    <h2 style="margin:36px 0 18px">Из чего складывается стоимость на таком объекте</h2>
    <p>Помесячная ставка зависит только от грузового момента машины: <a href="/uslugi/bashennyy-kran/#price">калькулятор на странице услуги</a> даст для ЗИЛа ту же цифру, что и для любой площадки в городе. Сверх неё на редевелопменте появляются позиции, которых на обычной новой стройке нет: подготовка основания на техногенном грунте, повторный цикл демонтажа и монтажа при переходе между очередями и время на согласование, если пятно попало в <a href="/keysy/podyom-v-tehnicheskoy-zone-metro/" style="color:var(--yellow)">техническую зону метрополитена</a>. Мы называем их в расчёте отдельными строками, а не растворяем в ставке, — так видно, что двигает дату на самом деле.</p>
  </section>

  <section class="section wrap prose" style="padding-top:0">
    <Sources
      checked="12.08.2026"
      items={[
        { text: 'Приказ Ростехнадзора от 26.11.2020 №461 (ред. от 16.04.2026): п. 108 — запрет установки на свеженасыпанный неутрамбованный грунт; п. 138 — пуск башенного крана в работу решением комиссии с участием представителя надзорного органа', href: 'https://www.consultant.ru/document/cons_doc_LAW_373321/' },
        { text: 'Приказ Москомархитектуры от 13.03.2006 №52 — техническая зона метрополитена: 40 м в обе стороны от оси действующих линий, 20 м от строящихся, работы ближе 10 м — по совместному решению' },
      ]}
      note="Требования единого пропускного режима территории устанавливает застройщик или генподрядчик застройки, а не городской норматив: состав документов и порядок подачи заявок уточняются по конкретному участку."
    />
  </section>
</main>
<style>
  .stages { list-style: none; counter-reset: st; margin: 0; padding: 0; display: grid; gap: 2px; }
  .stages li {
    counter-increment: st; position: relative; background: var(--bg-2);
    padding: 18px 22px 20px 64px; border-left: 3px solid transparent; background-image: var(--hazard-edge); background-repeat: no-repeat; background-size: 3px 100%; background-position: left top; background-origin: border-box;
  }
  .stages li::before {
    content: counter(st); position: absolute; left: 22px; top: 18px;
    font-family: var(--display); font-size: 1.5rem; line-height: 1; color: var(--yellow);
  }
  .stages h3 { font-size: var(--t-xs); text-transform: uppercase; letter-spacing: .08em; margin: 0 0 8px; }
  .stages p { margin: 0; color: var(--muted); font-size: var(--t-md); max-width: 72ch; }
  @media (max-width: 620px) {
    .stages li { padding: 16px 18px 18px 54px; }
    .stages li::before { left: 16px; }
  }
</style>
</BaseLayout>
