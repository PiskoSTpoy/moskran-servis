---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Sources from '../../../../components/Sources.astro';

const title = 'Кран на режимный объект в ЮВАО — промзона Капотни, Москва';
const description = 'Кран на режимный объект в ЮВАО: промышленные территории у Московского НПЗ в Капотне, Печатники, Южнопортовый. Оформление пропуска на технику и бригаду.';

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Кран на режимный объект', item: 'https://moskran-servis.ru/uslugi/kran-na-rezhimnyy-obekt/' },
    { '@type': 'ListItem', position: 3, name: 'ЮВАО', item: 'https://moskran-servis.ru/uslugi/kran-na-rezhimnyy-obekt/yuvao/' },
  ],
};
const serviceLd = {
  '@context': 'https://schema.org', '@type': 'Service', serviceType: 'Аренда автокрана с пропуском для режимных объектов ЮВАО',
  provider: { '@id': 'https://moskran-servis.ru/#organization' }, areaServed: 'ЮВАО, Москва',
};
---
<BaseLayout title={title} description={description} path="/uslugi/kran-na-rezhimnyy-obekt/yuvao/" ldExtra={[breadcrumbLd, serviceLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/uslugi/kran-na-rezhimnyy-obekt/">Кран на режимный объект</a><span>/</span><span>ЮВАО</span>
  </nav>
  <section class="section wrap" style="padding-top:8px">
    <div class="section-head">
      <span class="eyebrow">Режимный объект · Юго-Восточный округ</span>
      <h1>Кран на режимный объект в ЮВАО</h1>
      <p>На промышленных территориях ЮВАО пропуск оформляется дольше, чем в среднем по городу: не стандартные 1–2 дня, а 3–5 рабочих дней, а рядом с действующим нефтеперерабатывающим производством в Капотне к пропуску добавляются медицинские допуски бригады и инструктаж по промышленной безопасности предприятия. На самой площадке отдельно подписывается наряд-допуск, если кран или груз оказываются ближе 30 м к крайнему проводу воздушной линии напряжением более 50 В (пункт 112 ФНП №461).</p>
      <p>Округ с самой высокой концентрацией промышленных режимных объектов в сети наших услуг — прежде всего территория, прилегающая к Московскому нефтеперерабатывающему заводу в Капотне, а также складские и производственные зоны Печатников и Южнопортового района.</p>
    </div>
  </section>
  <section class="section wrap" style="padding-top:0;padding-bottom:clamp(28px,4vw,44px)">
    <table class="adm">
      <caption>Карточка допуска: режимный объект в ЮВАО</caption>
      <thead><tr><th scope="col">Требование</th><th scope="col">Что это значит здесь</th><th scope="col">Основание</th></tr></thead>
      <tbody>
        <tr><td data-label="Требование">Какой это режим</td><td data-label="Что это значит здесь">Территории, прилегающие к крупному производству в Капотне, и промышленно-складские зоны Печатников и Южнопортового — самый строгий пропускной режим среди округов, где мы работаем.</td><td data-label="Основание">Регламент предприятия</td></tr>
        <tr><td data-label="Требование">Что подают на пропуск</td><td data-label="Что это значит здесь">Полные данные машины и бригады, а на части объектов дополнительно — сведения о цели работ и точке установки. Требования запрашиваются заранее, а не восстанавливаются по памяти в день выезда.</td><td data-label="Основание">Регламент предприятия</td></tr>
        <tr><td data-label="Требование">Что спрашивают на КПП</td><td data-label="Что это значит здесь">Паспорт машины с записью о техническом освидетельствовании и документ о квалификации оператора; на ряде объектов добавляется вводный инструктаж на территории.</td><td data-label="Основание">ФНП №461, п. 189</td></tr>
        <tr><td data-label="Требование">Что подписывают на площадке</td><td data-label="Что это значит здесь">Наряд-допуск при работе ближе 30 м к крайнему проводу воздушной линии напряжением более 50 В.</td><td data-label="Основание">ФНП №461, п. 112</td></tr>
      </tbody>
    </table>
  </section>
  <section class="section wrap prose" style="padding-top:0">
    <h2 style="margin-bottom:18px">Специфика пропускного режима у Капотни</h2>
    <p>Территории, прилегающие к действующему нефтеперерабатывающему производству, — объекты с наиболее строгим пропускным режимом среди всех, с которыми мы работаем в Москве. Помимо стандартного пропуска на технику и бригаду, для таких объектов обычно требуются дополнительные документы: медицинские допуски бригады, инструктаж по промышленной безопасности предприятия перед началом работ, иногда — дополнительное согласование самого факта проведения грузоподъёмных работ в непосредственной близости к производственным мощностям.</p>
    <p>Срок согласования для таких объектов, как правило, больше стандартных 1-2 дней и ближе к верхней границе диапазона — 3-5 рабочих дней, иногда больше, если требуется согласование с профильными службами предприятия. Мы уточняем точные требования сразу после получения заявки на объект в этой зоне.</p>

    <h2 style="margin:36px 0 18px">Промышленные и складские территории Печатников, Южнопортового</h2>
    <p>Вдоль набережных Москвы-реки в этой части округа сохраняется часть советских производственных и складских территорий — режим здесь обычно менее строгий, чем на территории действующего НПЗ, но всё равно требует оформления пропуска через службу безопасности конкретного предприятия. Список требуемых документов определяет само предприятие и может заметно отличаться от объекта к объекту.</p>

    <h2 style="margin:36px 0 18px">Как мы это учитываем</h2>
    <p>Для любого объекта в ЮВАО с признаками промышленной или производственной территории мы сразу запрашиваем у заказчика точный адрес и, по возможности, контакт службы безопасности — чтобы получить актуальный список требований конкретного предприятия, а не действовать по усреднённому шаблону. Подробный порядок оформления пропуска в целом — на основной странице услуги «Кран на режимный объект».</p>
  </section>
  <section class="section wrap prose" style="padding-top:0">
    <h2 style="margin-bottom:18px">Сроки и дополнительные условия</h2>
    <p>Для объектов с повышенными требованиями закладывайте от трёх до пяти рабочих дней на оформление, а не один-два. Дополнительные условия территории — сопровождение по маршруту, ограничение по времени, запрет на отдельные операции в определённые часы — узнаются вместе с требованиями к пропуску, одним запросом.</p>
    <p>Если работа идёт на границе территории и городского проезда, к внутренней процедуре добавляется городская: ордер на временные ограждения и, при занятии проезжей части, согласование временной схемы движения. Остальная специфика округа — на <a href="/geo/yuvao/">гео-странице ЮВАО</a>.</p>
    <Sources
      checked="12.08.2026"
      items={[
        { text: 'Приказ Ростехнадзора от 26.11.2020 №461 (ред. от 16.04.2026): п. 108 — площадка и уклон, п. 110 — выносные опоры, п. 111 — откос котлована, п. 112 — 30 м до провода и наряд-допуск, п. 138 — пуск башенного крана, п. 165 и 189 — освидетельствование и запись в паспорт', href: 'https://www.consultant.ru/document/cons_doc_LAW_373321/' },
        { text: 'Постановление Правительства Москвы от 19.05.2015 №299-ПП — ордер на установку временных ограждений и размещение временных объектов' },
      ]}
    />
  </section>
</main>
<style>
  .adm { width: 100%; border-collapse: collapse; margin: 6px 0 0; font-size: var(--t-md); }
  .adm caption { text-align: left; font-family: var(--display); text-transform: uppercase; font-size: var(--t-sm); color: var(--yellow); letter-spacing: .06em; padding-bottom: 12px; }
  .adm th { text-align: left; font-size: var(--t-xs); text-transform: uppercase; letter-spacing: .06em; color: var(--muted); font-weight: 700; padding: 0 14px 8px 0; border-bottom: 1px solid var(--line-strong); }
  .adm td { padding: 13px 14px 13px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
  .adm td:first-child { width: 24%; font-weight: 700; }
  .adm td:last-child { width: 24%; color: var(--muted); font-size: var(--t-md); }
  @media (max-width: 760px) {
    .adm, .adm tbody, .adm tr, .adm td { display: block; width: 100%; }
    .adm thead { display: none; }
    .adm tr { border-bottom: 1px solid var(--line-strong); padding-bottom: 10px; margin-bottom: 10px; }
    .adm td { border: none; padding: 5px 0; }
    .adm td::before { content: attr(data-label); display: block; font-size: var(--t-xs); text-transform: uppercase; letter-spacing: .06em; color: var(--yellow); margin-bottom: 2px; }
    .adm td:first-child, .adm td:last-child { width: 100%; }
  }
</style>
</BaseLayout>
