const title = 'Кран на режимный объект в Москве — оформление пропуска';
const description = 'Автокран на объект с пропускным режимом: что нужно для пропуска на технику и бригаду, какие данные готовить заранее, сроки согласования. Оформляем сами.';

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
