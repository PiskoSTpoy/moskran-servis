---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Sources from '../../../../components/Sources.astro';

const title = 'Кран на режимный объект в ЗАО — территория Хруничева';
const description = 'Кран на режимный объект в ЗАО: Филёвская пойма, территория ГКНПЦ им. Хруничева — действующее производство и стройплощадка уживаются в одном периметре.';

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Кран на режимный объект', item: 'https://moskran-servis.ru/uslugi/kran-na-rezhimnyy-obekt/' },
    { '@type': 'ListItem', position: 3, name: 'ЗАО', item: 'https://moskran-servis.ru/uslugi/kran-na-rezhimnyy-obekt/zao/' },
  ],
};
const serviceLd = {
  '@context': 'https://schema.org', '@type': 'Service', serviceType: 'Аренда автокрана с пропуском для режимных объектов ЗАО',
  provider: { '@id': 'https://moskran-servis.ru/#organization' }, areaServed: 'ЗАО, Москва',
};
---
<BaseLayout title={title} description={description} path="/uslugi/kran-na-rezhimnyy-obekt/zao/" ldExtra={[breadcrumbLd, serviceLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/uslugi/kran-na-rezhimnyy-obekt/">Кран на режимный объект</a><span>/</span><span>ЗАО</span>
  </nav>
  <section class="section wrap" style="padding-top:8px">
    <div class="section-head">
      <span class="eyebrow">Режимный объект · Западный округ</span>
      <h1>Кран на режимный объект в ЗАО</h1>
      <p>В Филёвской пойме на территории площадью около 150 гектаров действуют два разных режима допуска: закрытая производственная площадка ГКНПЦ имени Хруничева на Новозаводской улице и освобождённая её часть, где в сентябре 2025 года открыт Национальный космический центр и работает обычный режим стройплощадки с единым КПП генподрядчика. Поэтому первый вопрос по заявке в ЗАО — к какой из двух зон относится точка работ: от этого зависит и список требуемых документов, и реальный срок согласования.</p>
      <p>В районе Филёвский Парк в одном периметре уживаются два разных режима: действующая площадка ГКНПЦ им. М.В. Хруничева на Новозаводской улице и освобождённая часть той же территории в Филёвской пойме, где несколько лет шла стройка Национального космического центра. Для крана это означает не одну процедуру допуска, а как минимум две — и важно заранее понимать, к какой именно точке относится ваш объект.</p>
    </div>
  </section>
  <section class="section wrap" style="padding-top:0;padding-bottom:clamp(28px,4vw,44px)">
    <table class="adm">
      <caption>Карточка допуска: режимный объект в ЗАО</caption>
      <thead><tr><th scope="col">Требование</th><th scope="col">Что это значит здесь</th><th scope="col">Основание</th></tr></thead>
      <tbody>
        <tr><td data-label="Требование">Какой это режим</td><td data-label="Что это значит здесь">На действующей площадке предприятия космического машиностроения — пропускной режим строгого промышленного объекта с непрерывным производством. На освобождённой части территории в пойме, где строился Национальный космический центр, — режим стройплощадки с единым КПП генподрядчика, ближе к порядку на ЗИЛе в ЮАО, чем к режиму самого завода.</td><td data-label="Основание">Регламент территории</td></tr>
        <tr><td data-label="Требование">Что согласуют дополнительно</td><td data-label="Что это значит здесь">Для действующего производства — более длинный срок предварительной подачи данных на технику и бригаду, характерный для предприятий стратегического машиностроения с непрерывным циклом. Для зоны стройки — обычный порядок субподрядчика по списку генподрядчика.</td><td data-label="Основание">Регламент территории</td></tr>
        <tr><td data-label="Требование">Что спрашивают на КПП</td><td data-label="Что это значит здесь">Паспорт машины с записью об освидетельствовании и документ о квалификации оператора — тот же базовый комплект, что и на любом другом режимном объекте сети.</td><td data-label="Основание">ФНП №461, п. 189</td></tr>
        <tr><td data-label="Требование">Подъезд и логистика</td><td data-label="Что это значит здесь">Территория поймы разрезана Москвой-рекой, а транспортная связь с Мнёвниковской поймой на противоположном берегу строится отдельно — два автомобильно-пешеходных моста ещё не заменяют полноценный сквозной проезд. Маршрут подачи техники уточняем по конкретному адресу, а не считаем участок сквозным заранее.</td><td data-label="Основание">Проект развития территории</td></tr>
      </tbody>
    </table>
  </section>
  <section class="section wrap prose" style="padding-top:0">
    <h2 style="margin-bottom:18px">Завод и стройка в одной пойме — но не один режим</h2>
    <p>Территория ГКНПЦ им. М.В. Хруничева в Филёвской пойме исторически занимала около 150 гектаров на Новозаводской улице. Часть этой площади в последние годы высвобождена под гражданскую застройку, и именно там построен комплекс Национального космического центра имени первой в мире женщины-космонавта В.В. Терешковой — здание открыто в сентябре 2025 года. При этом сам центр возводили без применения башенных кранов: несущий объём собирали по технологии самоподъёмной опалубки, которая поднимается по этажам сама, без грузоподъёмного механизма на площадке. Это не значит, что кран заводу не нужен — он нужен для смежных задач: обвязка инженерных систем, монтаж вспомогательных корпусов, работы по благоустройству прилегающей территории, где сохраняется действующее производство.</p>
    <p>Граница между двумя режимами на практике не совпадает с забором в привычном смысле — часть периметра завода официально передана под гражданское развитие, часть продолжает работать в режиме закрытого промышленного объекта. Уточнять, к какой именно части относится точка работ, нужно на этапе заявки, а не по факту прибытия техники к КПП.</p>

    <h2 style="margin:36px 0 18px">Развитие территории продолжается за пределами уже открытого центра</h2>
    <p>Здание космического центра — не финал, а первый крупный объект программы освоения поймы. Проект предусматривает более тесную интеграцию территории с городом, включая строительство двух автомобильно-пешеходных мостов через Москву-реку на Мнёвниковскую пойму на другом берегу. Пока эта связь не достроена, логистика подачи техники к площадкам внутри Филёвской поймы зависит от того, какой въезд на момент работ фактически открыт — это стоит уточнять отдельно, особенно для крупногабаритной техники, которой нужен разворот.</p>

    <h2 style="margin:36px 0 18px">Как мы это учитываем</h2>
    <p>Для объекта в Филёвском Парке мы сначала выясняем, относится ли точка работ к действующему производству Хруничева или к освобождённой части территории — это меняет и список требуемых документов, и реалистичный срок согласования. Общий порядок оформления пропуска на режимный объект в целом — на основной странице услуги; специфика логистики и точечной застройки остальной части округа (Раменки, Кутузовский проспект) — на <a href="/geo/zao/">гео-странице ЗАО</a> и на странице услуги <a href="/uslugi/bashennyy-kran/zao/">«Башенный кран в ЗАО»</a>.</p>
  </section>
  <section class="section wrap prose" style="padding-top:0">
    <h2 style="margin-bottom:18px">Что проверяем до выезда именно здесь</h2>
    <p>Даже для стройплощадки с обычным КПП генподрядчика в пойме реки грунт требует отдельной проверки: правила прямо запрещают ставить подъёмное сооружение на свеженасыпанный неутрамбованный грунт, а пойменные территории почти всегда содержат участки недавней подсыпки — под проездами, вдоль новых коммуникаций (подробный расчёт — в статье про <a href="/spravochnik/nesushchaya-sposobnost-grunta/">несущую способность грунта</a>). На действующей территории завода это менее актуально: капитальные площадки предприятия эксплуатируются десятилетиями и в подготовке грунта под кран, как правило, не нуждаются. Полный комплект документов на въезд техники — на странице <a href="/documents/propusk-na-obekt/">«Пропуск на объект»</a>.</p>
    <Sources
      checked="12.08.2026"
      items={[
        { text: 'Приказ Ростехнадзора от 26.11.2020 №461 (ред. от 16.04.2026): п. 108 — площадка и уклон, п. 111 — откос выемки, п. 165 и 189 — освидетельствование и запись в паспорт', href: 'https://www.consultant.ru/document/cons_doc_LAW_373321/' },
        { text: 'Комплекс градостроительной политики и строительства города Москвы — ход развития территории Национального космического центра в Филёвской пойме', href: 'https://stroi.mos.ru/natsional-nyi-kosmichieskii-tsientr' },
      ]}
      note="Внутренний регламент допуска на действующее производство ГКНПЦ им. Хруничева определяет само предприятие — здесь приведён общий порядок, характерный для режимных промышленных объектов такого профиля, а не выписка из внутреннего документа завода."
    />
  </section>
</main>
<style>
  .adm { width: 100%; border-collapse: collapse; margin: 6px 0 0; font-size: var(--t-md); }
  .adm caption { text-align: left; font-family: var(--display); text-transform: uppercase; font-size: var(--t-sm); color: var(--yellow); letter-spacing: .06em; padding-bottom: 12px; }
  .adm th { text-align: left; font-size: var(--t-xs); text-transform: uppercase; letter-spacing: .06em; color: var(--muted); font-weight: 700; padding: 0 14px 8px 0; border-bottom: 1px solid var(--line-strong); }
  .adm td { padding: 13px 14px 13px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
  .adm td:first-child { width: 24%; font-weight: 700; }
  .adm td:last-child { width: 24%; color: var(--muted); font-size: var(--t-md); }
  @media (max-width: 760px) {
    .adm, .adm tbody, .adm tr, .adm td { display: block; width: 100%; }
    .adm thead { display: none; }
    .adm tr { border-bottom: 1px solid var(--line-strong); padding-bottom: 10px; margin-bottom: 10px; }
    .adm td { border: none; padding: 5px 0; }
    .adm td::before { content: attr(data-label); display: block; font-size: var(--t-xs); text-transform: uppercase; letter-spacing: .06em; color: var(--yellow); margin-bottom: 2px; }
    .adm td:first-child, .adm td:last-child { width: 100%; }
  }
</style>
</BaseLayout>
