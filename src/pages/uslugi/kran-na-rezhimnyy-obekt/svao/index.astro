---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Sources from '../../../../components/Sources.astro';

const title = 'Кран на режимный объект в СВАО — зона ВДНХ и Останкино';
const description = 'Кран на режимный объект в СВАО: территория ВДНХ, Останкинский телецентр — объекты федерального значения с особыми условиями допуска техники.';

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Кран на режимный объект', item: 'https://moskran-servis.ru/uslugi/kran-na-rezhimnyy-obekt/' },
    { '@type': 'ListItem', position: 3, name: 'СВАО', item: 'https://moskran-servis.ru/uslugi/kran-na-rezhimnyy-obekt/svao/' },
  ],
};
const serviceLd = {
  '@context': 'https://schema.org', '@type': 'Service', serviceType: 'Аренда автокрана с пропуском для режимных объектов СВАО',
  provider: { '@id': 'https://moskran-servis.ru/#organization' }, areaServed: 'СВАО, Москва',
};
---
<BaseLayout title={title} description={description} path="/uslugi/kran-na-rezhimnyy-obekt/svao/" ldExtra={[breadcrumbLd, serviceLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/uslugi/kran-na-rezhimnyy-obekt/">Кран на режимный объект</a><span>/</span><span>СВАО</span>
  </nav>
  <section class="section wrap" style="padding-top:8px">
    <div class="section-head">
      <span class="eyebrow">Режимный объект · Северо-Восточный округ</span>
      <h1>Кран на режимный объект в СВАО</h1>
      <p>На режимных территориях СВАО — ВДНХ и Останкинском телецентре — маршрут заезда и точку установки крана согласуют отдельно от самого пропуска, и срок заявки считается по более длинной из двух процедур, а не по пропуску. Второе местное ограничение — контактная сеть: ближе 30 м к крайнему проводу воздушной линии напряжением более 50 В подъём идёт только по наряду-допуску (пункт 112 ФНП №461), и трамвайная с троллейбусной сетью под это определение попадают.</p>
      <p>Специфика округа отличается от промышленных зон остальной части сети: главный источник режимных объектов здесь — не производство, а территория ВДНХ и Останкинского телецентра, объектов федерального значения со своими условиями допуска техники.</p>
    </div>
  </section>
  <section class="section wrap" style="padding-top:0;padding-bottom:clamp(28px,4vw,44px)">
    <table class="adm">
      <caption>Карточка допуска: режимный объект в СВАО</caption>
      <thead><tr><th scope="col">Требование</th><th scope="col">Что это значит здесь</th><th scope="col">Основание</th></tr></thead>
      <tbody>
        <tr><td data-label="Требование">Какой это режим</td><td data-label="Что это значит здесь">ВДНХ и Останкино — территории федерального значения с собственными регламентами доступа, не совпадающими с процедурой обычного предприятия. Для типовой застройки Бибирева, Отрадного и Марьиной рощи действует обычный порядок.</td><td data-label="Основание">Регламент территории</td></tr>
        <tr><td data-label="Требование">Что согласуют дополнительно</td><td data-label="Что это значит здесь">Маршрут заезда и точку установки — на территориях с регламентированным доступом это согласуется отдельно от самого пропуска, и срок считается по более длинной из двух процедур.</td><td data-label="Основание">Регламент территории</td></tr>
        <tr><td data-label="Требование">Что спрашивают на КПП</td><td data-label="Что это значит здесь">Паспорт машины с записью об освидетельствовании и документ о квалификации оператора. Этот комплект одинаков для любого режимного объекта.</td><td data-label="Основание">ФНП №461, п. 189</td></tr>
        <tr><td data-label="Требование">Контактная сеть и линии</td><td data-label="Что это значит здесь">Наряд-допуск нужен при работе ближе 30 м к крайнему проводу воздушной линии или воздушной электрической сети напряжением более 50 В. Трамвайная и троллейбусная контактная сеть под это определение попадает.</td><td data-label="Основание">ФНП №461, п. 112</td></tr>
      </tbody>
    </table>
  </section>
  <section class="section wrap prose" style="padding-top:0">
    <h2 style="margin-bottom:18px">ВДНХ и Останкино — не типовой промышленный пропуск</h2>
    <p>Территория ВДНХ с прилегающими выставочными павильонами и Останкинский телецентр — объекты с собственными регламентами доступа, отличными от процедуры типового промышленного предприятия. Работы в прилегающей к этим объектам застройке (Останкинский район) иногда требуют дополнительного согласования из-за близости охраняемой инфраструктуры связи — это не универсальное правило для всей застройки округа, а специфика именно этой локации.</p>

    <h2 style="margin:36px 0 18px">Как определить, попадает ли ваш объект в эту категорию</h2>
    <p>Если объект расположен в пределах видимости телебашни или на территории, прилегающей непосредственно к ВДНХ, стоит уточнить это на этапе заявки отдельно — для типовой жилой застройки в других частях округа (Бибирево, Отрадное, Марьина роща) действует обычный порядок без специфических ограничений, характерных именно для зоны ВДНХ/Останкино.</p>

    <h2 style="margin:36px 0 18px">Как мы это учитываем</h2>
    <p>Для объектов в зоне ВДНХ/Останкино уточняем требования максимально рано, поскольку процедура здесь может отличаться от стандартной по срокам — общий порядок оформления пропуска на режимный объект в целом описан на основной странице услуги.</p>
  </section>
  <section class="section wrap prose" style="padding-top:0">
    <h2 style="margin-bottom:18px">Как понять, ваш ли это случай</h2>
    <p>Практический признак простой: если объект стоит непосредственно на территории выставки или примыкает к охраняемой инфраструктуре связи, готовьтесь к отдельному регламенту. Для остальной застройки округа порядок обычный, и вся разница сводится к тому, есть ли на объекте КПП.</p>
    <p>В обоих случаях мы просим уточнить требования максимально рано. Разница между «пропуск за день» и «согласование за неделю» определяется не тоннажем крана, а тем, чья это территория. Остальная специфика округа — на <a href="/geo/svao/">гео-странице СВАО</a>.</p>
    <Sources
      checked="12.08.2026"
      items={[
        { text: 'Приказ Ростехнадзора от 26.11.2020 №461 (ред. от 16.04.2026): п. 108 — площадка и уклон, п. 110 — выносные опоры, п. 111 — откос котлована, п. 112 — 30 м до провода и наряд-допуск, п. 138 — пуск башенного крана, п. 165 и 189 — освидетельствование и запись в паспорт', href: 'https://www.consultant.ru/document/cons_doc_LAW_373321/' },
      ]}
    />
  </section>
</main>
<style>
  .adm { width: 100%; border-collapse: collapse; margin: 6px 0 0; font-size: var(--t-md); }
  .adm caption { text-align: left; font-family: var(--display); text-transform: uppercase; font-size: var(--t-sm); color: var(--yellow); letter-spacing: .06em; padding-bottom: 12px; }
  .adm th { text-align: left; font-size: var(--t-xs); text-transform: uppercase; letter-spacing: .06em; color: var(--muted); font-weight: 700; padding: 0 14px 8px 0; border-bottom: 1px solid var(--line-strong); }
  .adm td { padding: 13px 14px 13px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
  .adm td:first-child { width: 24%; font-weight: 700; }
  .adm td:last-child { width: 24%; color: var(--muted); font-size: var(--t-md); }
  @media (max-width: 760px) {
    .adm, .adm tbody, .adm tr, .adm td { display: block; width: 100%; }
    .adm thead { display: none; }
    .adm tr { border-bottom: 1px solid var(--line-strong); padding-bottom: 10px; margin-bottom: 10px; }
    .adm td { border: none; padding: 5px 0; }
    .adm td::before { content: attr(data-label); display: block; font-size: var(--t-xs); text-transform: uppercase; letter-spacing: .06em; color: var(--yellow); margin-bottom: 2px; }
    .adm td:first-child, .adm td:last-child { width: 100%; }
  }
</style>
</BaseLayout>
