---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Sources from '../../../../components/Sources.astro';

const title = 'Кран на режимный объект в ТиНАО — наукоград Троицк';
const description = 'Кран на режимный объект в Новой Москве: десять институтов Троицка, включая ГНЦ РФ ТРИНИТИ — не один периметр на округ, а кластер отдельных пропусков.';

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Кран на режимный объект', item: 'https://moskran-servis.ru/uslugi/kran-na-rezhimnyy-obekt/' },
    { '@type': 'ListItem', position: 3, name: 'ТиНАО', item: 'https://moskran-servis.ru/uslugi/kran-na-rezhimnyy-obekt/tinao/' },
  ],
};
const serviceLd = {
  '@context': 'https://schema.org', '@type': 'Service', serviceType: 'Аренда автокрана с пропуском для режимных объектов ТиНАО',
  provider: { '@id': 'https://moskran-servis.ru/#organization' }, areaServed: 'ТиНАО, Москва',
};
---
<BaseLayout title={title} description={description} path="/uslugi/kran-na-rezhimnyy-obekt/tinao/" ldExtra={[breadcrumbLd, serviceLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/uslugi/kran-na-rezhimnyy-obekt/">Кран на режимный объект</a><span>/</span><span>ТиНАО</span>
  </nav>
  <section class="section wrap" style="padding-top:8px">
    <div class="section-head">
      <span class="eyebrow">Режимный объект · Новая Москва (ТиНАО)</span>
      <h1>Кран на режимный объект в ТиНАО</h1>
      <p>В Троицке не один режимный периметр на весь округ, а 10 отдельных: у ГНЦ РФ ТРИНИТИ, ИЗМИРАН, ИСАН, ИФВД имени Верещагина и остальных институтов наукограда свой КПП у каждого, и пропуск на территорию одного не открывает соседний. Поэтому в заявке нужно точное название института, а не «Троицк, режимный объект»: подрядчика на предприятие Росатома дополнительно согласует руководство профильного подразделения, и это отдельный шаг сверх обычной заявки на пропуск.</p>
      <p>В Троицке — историческом наукограде, вошедшем в состав Москвы вместе со всей территорией ТиНАО, — работает десять научно-исследовательских институтов. Это не одна закрытая территория на весь округ, как завод Хруничева в ЗАО или Курчатовский институт в СЗАО, а кластер из отдельных площадок: у каждого института свой периметр, свой пост охраны и, у части из них, свой согласующий орган. Разбираем, что это значит для крана, и почему подготовку заявки здесь нельзя свести к одной табличке «Троицк — режимный».</p>
    </div>
  </section>
  <section class="section wrap" style="padding-top:0;padding-bottom:clamp(28px,4vw,44px)">
    <table class="adm">
      <caption>Карточка допуска: режимный объект в ТиНАО</caption>
      <thead><tr><th scope="col">Требование</th><th scope="col">Что это значит здесь</th><th scope="col">Основание</th></tr></thead>
      <tbody>
        <tr><td data-label="Требование">Какой это режим</td><td data-label="Что это значит здесь">Не единый периметр, а кластер: ГНЦ РФ ТРИНИТИ (ул. Пушковых, 12), ИЗМИРАН (Калужское ш., 4), ИСАН (Физическая ул., 5), ИФВД им. Верещагина (Калужское ш., 14) и ещё несколько институтов — у каждого отдельная территория и отдельный КПП, адрес одного института не даёт допуска на территорию соседнего.</td><td data-label="Основание">Регламент территории</td></tr>
        <tr><td data-label="Требование">Что согласуют дополнительно</td><td data-label="Что это значит здесь">Для предприятия Госкорпорации «Росатом» (ТРИНИТИ) — представитель подрядчика согласуется руководством профильного подразделения заранее, с последующим уведомлением поста охраны; это отдельный шаг сверх обычной заявки на пропуск. Для институтов РАН порядок ближе к типовому режимному объекту сети.</td><td data-label="Основание">Регламент территории</td></tr>
        <tr><td data-label="Требование">Что спрашивают на КПП</td><td data-label="Что это значит здесь">Паспорт машины со свежей записью об освидетельствовании и удостоверение оператора — базовый комплект, как на любом другом режимном объекте сети.</td><td data-label="Основание">ФНП №461, п. 189</td></tr>
        <tr><td data-label="Требование">Подъезд и логистика</td><td data-label="Что это значит здесь">Институтский кластер стоит вдоль Калужского шоссе и смежных улиц южной части Троицка — обособленно от новой жилой застройки на въезде в округ (Коммунарка, Ватутинки), которая разобрана на гео-странице округа.</td><td data-label="Основание">Схема территории</td></tr>
      </tbody>
    </table>
  </section>
  <section class="section wrap prose" style="padding-top:0">
    <h2 style="margin-bottom:18px">Не один институт, а десять</h2>
    <p>Троицк вошёл в состав Москвы в 2012 году вместе со всей территорией ТиНАО, но задолго до этого сложился как отдельный наукоград — сегодня в его границах работает десять научно-исследовательских институтов. Головное предприятие — АО «ГНЦ РФ ТРИНИТИ» (Троицкий институт инновационных и термоядерных исследований), юридический адрес ул. Пушковых, д. 12, статус государственного научного центра с 1994 года. Институт — предприятие Государственной корпорации по атомной энергии «Росатом», занимается физикой плазмы, управляемым термоядерным синтезом и лазерной физикой; на площадке работают уникальные установки, включая лазерный комплекс «Ангара-5-1» и токамак с сильным полем. Рядом — ИЗМИРАН (Институт земного магнетизма, ионосферы и распространения радиоволн, Калужское ш., 4), ИСАН (Институт спектроскопии РАН, Физическая ул., 5) и ИФВД им. Л.Ф. Верещагина (Институт физики высоких давлений РАН, Калужское ш., 14).</p>
    <p>Для крана разница с ЗАО и СЗАО принципиальная. На Хруничева и на территории Курчатовского института один большой периметр, часть которого уже передана под гражданскую застройку, — там достаточно один раз понять, к какой из двух зон относится точка работ. В Троицке зон не две, а по числу институтов: пропуск на территорию ТРИНИТИ не открывает соседний ИЗМИРАН, и наоборот. Адрес объекта в заявке должен быть точным названием института, а не общим «Троицк, режимный объект» — иначе согласование начинается заново уже на площадке.</p>

    <h2 style="margin:36px 0 18px">Росатом — отдельная процедура допуска подрядчика</h2>
    <p>Для предприятий Госкорпорации «Росатом», к которым относится ТРИНИТИ, действует более строгий порядок допуска стороннего подрядчика, чем на обычном промышленном объекте: представителей подрядной организации согласовывает руководство профильного подразделения предприятия, и только после этого пост охраны уведомляют о плановом проходе или проезде техники. Это не про секретность конкретных работ по подъёму груза — кран не подключается к исследовательской установке и не заходит в лабораторные корпуса, — а про сам факт присутствия стороннего персонала и техники на площадке государственного научного центра. Мы закладываем на этот шаг больше времени, чем на типовой пропуск объекта с частной охраной, и запрашиваем требования заранее, а не в день подачи техники.</p>

    <h2 style="margin:36px 0 18px">Чем это отличается от Хруничева и Курчатовского института</h2>
    <p>На страницах услуги для ЗАО и СЗАО разобран схожий на первый взгляд, но структурно другой случай: один завод или один институт, где часть территории уже открыта под жильё, школу или технопарк, а часть остаётся закрытым производством — там задача заявки сводится к тому, чтобы определить, к какой из двух зон относится точка работ. В Троицке институтский кластер не граничит с редевелопментом на той же площадке — новая жилая застройка округа идёт в другой части ТиНАО, ближе к МКАД и вдоль Калужского шоссе севернее наукограда, и не пересекается территориально с землёй институтов. Здесь другая сложность: не выбор между двумя режимами на одном адресе, а точный выбор одного из десяти отдельных периметров с собственным постом охраны.</p>

    <h2 style="margin:36px 0 18px">Как мы это учитываем</h2>
    <p>Для заявки на объект в Троицке первым делом уточняем точное название и адрес института — этого достаточно, чтобы понять, идёт ли речь о предприятии Росатома с усиленной процедурой допуска подрядчика или об институте РАН с более типовым режимом. Общий порядок оформления пропуска на технику и бригаду — на <a href="/uslugi/kran-na-rezhimnyy-obekt/">основной странице услуги</a>, полный комплект документов — на странице <a href="/documents/propusk-na-obekt/">«Пропуск на объект»</a>. Если у вас задача не на территории научного кластера, а вдоль коридора строящейся Троицкой линии метро в северной части округа — смотрите отдельный разбор на странице услуги <a href="/uslugi/arenda-avtokrana-40-50-tonn/tinao/">«Автокран 40–50 тонн в ТиНАО»</a>. Логистика и остальная застройка округа — на <a href="/geo/tinao/">гео-странице ТиНАО</a>.</p>
  </section>
  <section class="section wrap prose" style="padding-top:0">
    <Sources
      checked="19.08.2026"
      items={[
        { text: 'АО «ГНЦ РФ ТРИНИТИ» — официальный сайт: статус государственного научного центра с 1994 года, предприятие Госкорпорации «Росатом», направления исследований и установки «Ангара-5-1», токамак с сильным полем', href: 'https://www.triniti.ru/company/' },
        { text: 'Rusprofile — ИЗМИРАН (Калужское ш., 4), ИСАН (Физическая ул., 5), ИФВД им. Л.Ф. Верещагина (Калужское ш., 14)', href: 'https://www.rusprofile.ru/id/7793098' },
        { text: 'Троицкий научный центр РАН — состав и профиль институтов наукограда', href: 'https://yras.ru/tnc.html' },
        { text: 'Приказ Ростехнадзора от 26.11.2020 №461 (ред. от 16.04.2026): п. 189 — запись о техническом освидетельствовании в паспорт', href: 'https://www.consultant.ru/document/cons_doc_LAW_373321/' },
      ]}
      note="Внутренний регламент допуска подрядчика на территорию конкретного института — федерального ГНЦ или института РАН — определяет само учреждение; здесь приведён общий порядок, характерный для режимных научных объектов такого профиля, а не выписка из внутренней инструкции конкретного предприятия."
    />
  </section>
</main>
<style>
  .adm { width: 100%; border-collapse: collapse; margin: 6px 0 0; font-size: var(--t-md); }
  .adm caption { text-align: left; font-family: var(--display); text-transform: uppercase; font-size: var(--t-sm); color: var(--yellow); letter-spacing: .06em; padding-bottom: 12px; }
  .adm th { text-align: left; font-size: var(--t-xs); text-transform: uppercase; letter-spacing: .06em; color: var(--muted); font-weight: 700; padding: 0 14px 8px 0; border-bottom: 1px solid var(--line-strong); }
  .adm td { padding: 13px 14px 13px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
  .adm td:first-child { width: 22%; font-weight: 700; }
  .adm td:last-child { width: 22%; color: var(--muted); font-size: var(--t-md); }
  @media (max-width: 760px) {
    .adm, .adm tbody, .adm tr, .adm td { display: block; width: 100%; }
    .adm thead { display: none; }
    .adm tr { border-bottom: 1px solid var(--line-strong); padding-bottom: 10px; margin-bottom: 10px; }
    .adm td { border: none; padding: 5px 0; }
    .adm td::before { content: attr(data-label); display: block; font-size: var(--t-xs); text-transform: uppercase; letter-spacing: .06em; color: var(--yellow); margin-bottom: 2px; }
    .adm td:first-child, .adm td:last-child { width: 100%; }
  }
</style>
</BaseLayout>
