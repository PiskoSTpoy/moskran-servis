---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Sources from '../../../../components/Sources.astro';

const title = 'Кран на режимный объект в ЮЗАО — промзона Воронцово';
const description = 'Кран на режимный объект в ЮЗАО: промзона №35 «Воронцово» на границе Коньково, Черёмушек и Обручевского — НИИ, депо метро и обычное производство рядом.';

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Кран на режимный объект', item: 'https://moskran-servis.ru/uslugi/kran-na-rezhimnyy-obekt/' },
    { '@type': 'ListItem', position: 3, name: 'ЮЗАО', item: 'https://moskran-servis.ru/uslugi/kran-na-rezhimnyy-obekt/yuzao/' },
  ],
};
const serviceLd = {
  '@context': 'https://schema.org', '@type': 'Service', serviceType: 'Аренда автокрана с пропуском для режимных объектов ЮЗАО',
  provider: { '@id': 'https://moskran-servis.ru/#organization' }, areaServed: 'ЮЗАО, Москва',
};
---
<BaseLayout title={title} description={description} path="/uslugi/kran-na-rezhimnyy-obekt/yuzao/" ldExtra={[breadcrumbLd, serviceLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/uslugi/kran-na-rezhimnyy-obekt/">Кран на режимный объект</a><span>/</span><span>ЮЗАО</span>
  </nav>
  <section class="section wrap" style="padding-top:8px">
    <div class="section-head">
      <span class="eyebrow">Режимный объект · Юго-Западный округ</span>
      <h1>Кран на режимный объект в ЮЗАО</h1>
      <p>На стыке районов Коньково, Черёмушки и Обручевский лежит промышленная зона №35 «Воронцово» — в народе её называют просто «Стройплощадкой». В отличие от других округов сети, где режимный объект — это одна понятная категория (завод, музей-заповедник, федеральная территория), здесь на соседних участках уживаются сразу три разных типа допуска, и заранее угадать нужный без адреса не получится.</p>
    </div>
  </section>
  <section class="section wrap" style="padding-top:0;padding-bottom:clamp(28px,4vw,44px)">
    <table class="adm">
      <caption>Карточка допуска: режимный объект в ЮЗАО</caption>
      <thead><tr><th scope="col">Требование</th><th scope="col">Что это значит здесь</th><th scope="col">Основание</th></tr></thead>
      <tbody>
        <tr><td data-label="Требование">Какой это режим</td><td data-label="Что это значит здесь">В «Воронцово» рядом стоят научно-исследовательские институты с историческим статусом закрытых предприятий, электродепо Московского метрополитена и обычное пищевое производство с частной охраной — три разных процедуры допуска в границах одной промзоны.</td><td data-label="Основание">Регламент территории</td></tr>
        <tr><td data-label="Требование">Что согласуют дополнительно</td><td data-label="Что это значит здесь">Если объект граничит с территорией электродепо метрополитена — отдельное согласование самого факта работ с эксплуатирующей организацией, а не только пропуск на въезд; для НИИ — пропускной режим самого учреждения, срок определяет его служба безопасности.</td><td data-label="Основание">Регламент территории</td></tr>
        <tr><td data-label="Требование">Что спрашивают на КПП</td><td data-label="Что это значит здесь">Паспорт машины с записью об освидетельствовании и документ о квалификации оператора — базовый комплект, общий для любого режимного объекта сети.</td><td data-label="Основание">ФНП №461, п. 189</td></tr>
        <tr><td data-label="Требование">За пределами промзоны</td><td data-label="Что это значит здесь">Жилая застройка Академического, Гагаринского районов и остальной части округа — обычный порядок без специфических ограничений промзоны.</td><td data-label="Основание">Регламент территории</td></tr>
      </tbody>
    </table>
  </section>
  <section class="section wrap prose" style="padding-top:0">
    <h2 style="margin-bottom:18px">Промзона «Воронцово» — не один объект, а три разных режима</h2>
    <p>Промышленная зона №35 официально охватывает территорию на стыке районов Обручевский, Черёмушки и Коньково. Исторически здесь сложился научно-производственный кластер: например, Институт проблем управления имени В.А. Трапезникова РАН и Научно-исследовательский институт автоматической аппаратуры имени академика В.С. Семенихина — организации, часть площадей которых десятилетиями существовала в логике закрытых предприятий («почтовых ящиков» советской системы секретности), и это до сих пор влияет на то, как они организуют допуск подрядчиков. Рядом, в той же промзоне, работает электродепо «Калужское» (ТЧ-5) Московского метрополитена — объект транспортной инфраструктуры со своим порядком согласования. И тут же — кондитерско-булочный комбинат «Черёмушки», обычное пищевое производство с частной охраной без специфики секретных или транспортных объектов.</p>
    <p>Практический вывод: адрес внутри «Воронцово» сам по себе не говорит, какая процедура применима, — определяет это конкретный сосед, к территории которого примыкает точка работ. Мы уточняем это в момент приёма заявки по точному адресу, а не действуем по одному усреднённому регламенту «раз промзона — значит долгое согласование».</p>

    <h2 style="margin:36px 0 18px">Работа у объектов метрополитена — отдельная категория по срокам</h2>
    <p>Для площадок, примыкающих к территории электродепо, действует тот же принцип, что и для любых работ в охранной зоне Московского метрополитена: помимо стандартных документов на технику и оператора (полный список — на странице <a href="/documents/propusk-na-obekt/">«Пропуск на объект»</a>) требуется согласование самого факта проведения работ с эксплуатирующей организацией, включая рассмотрение технических параметров — высоты подъёма стрелы, расстояния до охраняемых конструкций и границ опасной зоны (см. общий разбор в статье про <a href="/spravochnik/opasnaya-zona-krana/">опасную зону крана</a>). Реальный срок такой процедуры — от нескольких рабочих дней до двух-трёх недель, и закладывать его нужно заранее, а не в момент, когда кран уже нужен на площадке.</p>

    <h2 style="margin:36px 0 18px">Как мы это учитываем</h2>
    <p>Для объекта в «Воронцово» мы сначала выясняем, к какому именно из трёх типов соседства относится точка работ, — это определяет и список документов, и реалистичный срок. Общий порядок оформления пропуска на режимный объект — на основной странице услуги. Остальная часть округа за пределами промзоны — типовая жилая застройка, разобранная на <a href="/geo/yuzao/">гео-странице ЮЗАО</a> вместе с институтами Академического района, которые организационно отличаются от закрытых предприятий Воронцово.</p>
  </section>
  <section class="section wrap prose" style="padding-top:0">
    <h2 style="margin-bottom:18px">Что проверяем до выезда именно здесь</h2>
    <p>Возраст застройки промзоны — десятилетия, и площадки под кран на территории институтов и депо в среднем не требуют специальной подготовки грунта, характерной для новой стройки. Тем не менее правила прямо запрещают устанавливать кран на площадку с уклоном больше указанного в паспорте машины и без проверки на конкретной точке — это делаем независимо от того, насколько давно эксплуатируется территория.</p>
    <Sources
      checked="12.08.2026"
      items={[
        { text: 'Приказ Ростехнадзора от 26.11.2020 №461 (ред. от 16.04.2026): п. 108 — площадка и уклон, п. 165 и 189 — освидетельствование и запись в паспорт', href: 'https://www.consultant.ru/document/cons_doc_LAW_373321/' },
      ]}
      note="Список организаций и внутренний регламент допуска промзоны «Воронцово» приведён по открытым данным о территории — конкретные требования по вашему адресу уточняем напрямую у службы безопасности объекта, а не выводим из общего профиля зоны."
    />
  </section>
</main>
<style>
  .adm { width: 100%; border-collapse: collapse; margin: 6px 0 0; font-size: var(--t-md); }
  .adm caption { text-align: left; font-family: var(--display); text-transform: uppercase; font-size: var(--t-sm); color: var(--yellow); letter-spacing: .06em; padding-bottom: 12px; }
  .adm th { text-align: left; font-size: var(--t-xs); text-transform: uppercase; letter-spacing: .06em; color: var(--muted); font-weight: 700; padding: 0 14px 8px 0; border-bottom: 1px solid var(--line-strong); }
  .adm td { padding: 13px 14px 13px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
  .adm td:first-child { width: 24%; font-weight: 700; }
  .adm td:last-child { width: 24%; color: var(--muted); font-size: var(--t-md); }
  @media (max-width: 760px) {
    .adm, .adm tbody, .adm tr, .adm td { display: block; width: 100%; }
    .adm thead { display: none; }
    .adm tr { border-bottom: 1px solid var(--line-strong); padding-bottom: 10px; margin-bottom: 10px; }
    .adm td { border: none; padding: 5px 0; }
    .adm td::before { content: attr(data-label); display: block; font-size: var(--t-xs); text-transform: uppercase; letter-spacing: .06em; color: var(--yellow); margin-bottom: 2px; }
    .adm td:first-child, .adm td:last-child { width: 100%; }
  }
</style>
</BaseLayout>
