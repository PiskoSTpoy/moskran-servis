---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Sources from '../../../../components/Sources.astro';

const title = 'Кран на режимный объект в ЮАО — ЗИЛ, музеи-заповедники';
const description = 'Кран на режимный объект в ЮАО: редевелопмент территории завода ЗИЛ, охранные зоны Царицыно и Коломенского. Оформление пропуска на технику и бригаду.';

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Кран на режимный объект', item: 'https://moskran-servis.ru/uslugi/kran-na-rezhimnyy-obekt/' },
    { '@type': 'ListItem', position: 3, name: 'ЮАО', item: 'https://moskran-servis.ru/uslugi/kran-na-rezhimnyy-obekt/yuao/' },
  ],
};
const serviceLd = {
  '@context': 'https://schema.org', '@type': 'Service', serviceType: 'Аренда автокрана с пропуском для режимных объектов ЮАО',
  provider: { '@id': 'https://moskran-servis.ru/#organization' }, areaServed: 'ЮАО, Москва',
};
---
<BaseLayout title={title} description={description} path="/uslugi/kran-na-rezhimnyy-obekt/yuao/" ldExtra={[breadcrumbLd, serviceLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/uslugi/kran-na-rezhimnyy-obekt/">Кран на режимный объект</a><span>/</span><span>ЮАО</span>
  </nav>
  <section class="section wrap" style="padding-top:8px">
    <div class="section-head">
      <span class="eyebrow">Режимный объект · Южный округ</span>
      <h1>Кран на режимный объект в ЮАО</h1>
      <p>Режимный доступ в ЮАО идёт двумя разными путями с разным сроком: на редевелопменте ЗИЛ пропуск оформляет застройщик через единый КПП, и это <a href="/uslugi/kran-na-rezhimnyy-obekt/">обычный пропускной режим — 1–2 рабочих дня</a>, а в охранных зонах Царицына и Коломенского дату задаёт не пропуск, а разрешительная процедура администрации заповедника, где счёт идёт на недели. Если опоры выходят на городской проезд или тротуар за периметром, добавляется ещё и городская часть — ордер на установку временных ограждений по постановлению Правительства Москвы №299-ПП.</p>
      <p>В ЮАО режимный доступ связан с двумя разными типами территорий: строящийся квартал на месте бывшего завода ЗИЛ с единым КПП застройки и охранные зоны музеев-заповедников Царицыно и Коломенское — процедуры для них принципиально разные.</p>
    </div>
  </section>
  <section class="section wrap" style="padding-top:0;padding-bottom:clamp(28px,4vw,44px)">
    <table class="adm">
      <caption>Карточка допуска: режимный объект в ЮАО</caption>
      <thead><tr><th scope="col">Требование</th><th scope="col">Что это значит здесь</th><th scope="col">Основание</th></tr></thead>
      <tbody>
        <tr><td data-label="Требование">Какой это режим</td><td data-label="Что это значит здесь">Территория редевелопмента ЗИЛ работает по единому КПП застройки — пропуск оформляет застройщик или генподрядчик. Охранные зоны музеев-заповедников — принципиально другая процедура, там согласование идёт с администрацией территории.</td><td data-label="Основание">Регламент территории</td></tr>
        <tr><td data-label="Требование">Что согласуют дополнительно</td><td data-label="Что это значит здесь">В охранной зоне объекта культурного наследия отдельно согласуются точка установки, маршрут заезда и сроки работ. Это не пропуск, а разрешительная процедура со своим сроком.</td><td data-label="Основание">Режим охранной зоны</td></tr>
        <tr><td data-label="Требование">Что спрашивают на КПП</td><td data-label="Что это значит здесь">Паспорт машины с записью об освидетельствовании и документ о квалификации оператора.</td><td data-label="Основание">ФНП №461, п. 189</td></tr>
        <tr><td data-label="Требование">Городская часть</td><td data-label="Что это значит здесь">Если техника занимает городской проезд или тротуар за периметром — ордер на установку временных ограждений, а при перекрытии проезжей части ещё и согласованная временная схема движения.</td><td data-label="Основание">Постановление №299-ПП</td></tr>
      </tbody>
    </table>
  </section>
  <section class="section wrap prose" style="padding-top:0">
    <h2 style="margin-bottom:18px">Территория редевелопмента ЗИЛ — единый КПП застройки</h2>
    <p>На территории масштабного редевелопмента бывшего завода имени Лихачёва (жилой квартал «ЗИЛАРТ» и продолжающаяся застройка прилегающих участков) на переходный период часто действует единый пропускной режим общей стройплощадки — аналогично крупным объектам с единым КПП генподрядчика в других округах. Список требований определяет управляющая организация застройки, уточняем это по конкретному адресу.</p>

    <h2 style="margin:36px 0 18px">Охранные зоны Царицыно и Коломенского — согласование с администрацией заповедника</h2>
    <p>Оба музея-заповедника имеют охранный статус — работы в непосредственной близости от границ (включая прилегающую жилую застройку районов Царицыно и Нагатинский затон) могут требовать отдельного согласования с администрацией заповедника, не сводящегося к типовому пропуску. Это принципиально другая процедура, чем для промышленного или коммерческого объекта — она затрагивает сам факт проведения работ спецтехникой рядом с охраняемой территорией, а не только доступ.</p>

    <h2 style="margin:36px 0 18px">Как мы это учитываем</h2>
    <p>Для объекта в ЮАО уточняем тип территории (застройка ЗИЛ или зона у музея-заповедника) на этапе приёма заявки — это определяет, с кем согласовывать доступ и какой реалистичный срок закладывать. Общий порядок оформления пропуска на режимный объект — на основной странице услуги.</p>
  </section>
  <section class="section wrap prose" style="padding-top:0">
    <h2 style="margin-bottom:18px">Что определяет дату выезда</h2>
    <p>На ЗИЛе критический путь — это внутренний регламент застройки: списки подаются заранее, а окно работ согласуется с общим графиком стройки. На территориях музеев-заповедников критический путь другой и длиннее: там дату задаёт разрешительная процедура, а не наличие крана.</p>
    <p>Мы разделяем эти два сценария в первом же разговоре, потому что от этого зависит, о каком сроке вообще идёт речь — о днях или о неделях. Остальная специфика округа — на <a href="/geo/yuao/">гео-странице ЮАО</a>.</p>
    <Sources
      checked="12.08.2026"
      items={[
        { text: 'Приказ Ростехнадзора от 26.11.2020 №461 (ред. от 16.04.2026): п. 108 — площадка и уклон, п. 110 — выносные опоры, п. 111 — откос котлована, п. 112 — 30 м до провода и наряд-допуск, п. 138 — пуск башенного крана, п. 165 и 189 — освидетельствование и запись в паспорт', href: 'https://www.consultant.ru/document/cons_doc_LAW_373321/' },
        { text: 'Постановление Правительства Москвы от 19.05.2015 №299-ПП — ордер на установку временных ограждений и размещение временных объектов' },
      ]}
    />
  </section>
</main>
<style>
  .adm { width: 100%; border-collapse: collapse; margin: 6px 0 0; font-size: var(--t-md); }
  .adm caption { text-align: left; font-family: var(--display); text-transform: uppercase; font-size: var(--t-sm); color: var(--yellow); letter-spacing: .06em; padding-bottom: 12px; }
  .adm th { text-align: left; font-size: var(--t-xs); text-transform: uppercase; letter-spacing: .06em; color: var(--muted); font-weight: 700; padding: 0 14px 8px 0; border-bottom: 1px solid var(--line-strong); }
  .adm td { padding: 13px 14px 13px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
  .adm td:first-child { width: 24%; font-weight: 700; }
  .adm td:last-child { width: 24%; color: var(--muted); font-size: var(--t-md); }
  @media (max-width: 760px) {
    .adm, .adm tbody, .adm tr, .adm td { display: block; width: 100%; }
    .adm thead { display: none; }
    .adm tr { border-bottom: 1px solid var(--line-strong); padding-bottom: 10px; margin-bottom: 10px; }
    .adm td { border: none; padding: 5px 0; }
    .adm td::before { content: attr(data-label); display: block; font-size: var(--t-xs); text-transform: uppercase; letter-spacing: .06em; color: var(--yellow); margin-bottom: 2px; }
    .adm td:first-child, .adm td:last-child { width: 100%; }
  }
</style>
</BaseLayout>
