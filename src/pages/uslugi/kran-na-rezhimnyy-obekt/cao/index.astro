---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Sources from '../../../../components/Sources.astro';

const title = 'Кран на режимный объект в ЦАО — стройка у НИИ Склифосовского';
const description = 'Кран на режимный объект в ЦАО: новый корпус НИИ Склифосовского на Сухаревской площади строят рядом с действующей больницей скорой помощи.';

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Кран на режимный объект', item: 'https://moskran-servis.ru/uslugi/kran-na-rezhimnyy-obekt/' },
    { '@type': 'ListItem', position: 3, name: 'ЦАО', item: 'https://moskran-servis.ru/uslugi/kran-na-rezhimnyy-obekt/cao/' },
  ],
};
const serviceLd = {
  '@context': 'https://schema.org', '@type': 'Service', serviceType: 'Аренда автокрана с пропуском для режимных объектов ЦАО',
  provider: { '@id': 'https://moskran-servis.ru/#organization' }, areaServed: 'ЦАО, Москва',
};
---
<BaseLayout title={title} description={description} path="/uslugi/kran-na-rezhimnyy-obekt/cao/" ldExtra={[breadcrumbLd, serviceLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/uslugi/kran-na-rezhimnyy-obekt/">Кран на режимный объект</a><span>/</span><span>ЦАО</span>
  </nav>
  <section class="section wrap" style="padding-top:8px">
    <div class="section-head">
      <span class="eyebrow">Режимный объект · Центральный округ</span>
      <h1>Кран на режимный объект в ЦАО</h1>
      <p>Общая специфика ЦАО — узкие улицы и согласование перекрытия проезда с ГИБДД — разобрана на гео-странице округа. Здесь другой случай: с 11 ноября 2025 года на Большой Сухаревской площади идёт стройка нового корпуса НИИ скорой помощи имени Склифосовского, а сам институт всё это время продолжает круглосуточно принимать пациентов. Для крана это означает не столько пропускной режим в привычном смысле, сколько согласование маршрута так, чтобы техника ни на минуту не перекрыла заезд машин скорой помощи.</p>
    </div>
  </section>
  <section class="section wrap" style="padding-top:0;padding-bottom:clamp(28px,4vw,44px)">
    <table class="adm">
      <caption>Карточка допуска: режимный объект в ЦАО</caption>
      <thead><tr><th scope="col">Требование</th><th scope="col">Что это значит здесь</th><th scope="col">Основание</th></tr></thead>
      <tbody>
        <tr><td data-label="Требование">Какой это режим</td><td data-label="Что это значит здесь">Смешанный статус: часть площадки у Большой Сухаревской, 3 — действующий стационар НИИ им. Склифосовского, часть — стройплощадка нового корпуса генподрядчика со своим КПП. Это не промышленная секретность, а режим работающей больницы.</td><td data-label="Основание">Регламент территории</td></tr>
        <tr><td data-label="Требование">Что согласуют дополнительно</td><td data-label="Что это значит здесь">Маршрут подачи и стоянки крана — так, чтобы не создавать помех для машин скорой помощи, которые заезжают на территорию непрерывно. Это требование самого профиля учреждения, а не формальность службы безопасности.</td><td data-label="Основание">Регламент территории</td></tr>
        <tr><td data-label="Требование">Что спрашивают на КПП</td><td data-label="Что это значит здесь">Паспорт машины со свежей записью об освидетельствовании и удостоверение оператора — тот же базовый комплект, что и на любом другом режимном объекте сети, плюс данные для пропускной службы генподрядчика стройки нового корпуса.</td><td data-label="Основание">ФНП №461, п. 189</td></tr>
        <tr><td data-label="Требование">Подъезд и логистика</td><td data-label="Что это значит здесь">Большая Сухаревская площадь — узел на границе Садового кольца и проспекта Мира, рядом плотная застройка Сретенки. Точку подачи техники согласуем по присланной схеме площадки, а не по общей оценке района.</td><td data-label="Основание">Схема площадки</td></tr>
      </tbody>
    </table>
  </section>
  <section class="section wrap prose" style="padding-top:0">
    <h2 style="margin-bottom:18px">Действующий институт и стройка нового корпуса — в одном периметре</h2>
    <p>Мэр Москвы Сергей Собянин дал старт строительству нового комплекса НИИ скорой помощи им. Н.В. Склифосовского 11 ноября 2025 года. Проект — свыше 160 тысяч кв. м, шестиэтажный корпус на Большой Сухаревской площади, дом 3, в Мещанском районе, с вертолётной площадкой на кровле для санитарной авиации. Вместо открытого котлована строители сделали монолитную стену в грунте глубиной 25 метров — решение, которое защищает соседние капитальные постройки института от подвижек грунта, но и меняет то, где на площадке физически может встать кран: периметр стены в грунте задаёт границу, за которую выносные опоры не заходят. К концу 2026 года планируют завершить фундаментную плиту по периметру здания и основные работы по бетонированию надземной части, весь комплекс должны сдать в 2028 году.</p>
    <p>Всё это время сам институт — крупнейший в стране центр неотложной помощи — продолжает работать в обычном режиме: приёмное отделение, реанимация и стационар не приостанавливаются на время стройки ни на день. Поэтому статус площадки двойной, и для крана это не абстракция: заявку на объект в этой части ЦАО мы обязательно уточняем — относится ли точка работ к периметру стройки нового корпуса генподрядчика или к территории действующей больницы, потому что состав требований и, главное, ограничения по маршруту у этих двух зон разные.</p>

    <h2 style="margin:36px 0 18px">Чем это отличается от обычного перекрытия проезда в центре</h2>
    <p>На гео-странице ЦАО подробно разобран типовой случай округа: узкий двор или переулок, для установки крана на опоры нужно частично занять проезжую часть, согласование идёт с ГИБДД и, для отдельных улиц, с префектурой. У Сухаревской площади логика другая: ограничение задаёт не ширина проезда, а бесперебойный доступ для автомобилей скорой помощи, который не регулируется дорожными службами и который проверяет сама больница, а не только служба безопасности стройки. Формально это тоже «режимный объект», но требования к маршруту здесь диктует профиль учреждения, а не статус охраняемой территории или памятника архитектуры.</p>

    <h2 style="margin:36px 0 18px">Что мы учитываем при подготовке заявки</h2>
    <p>Для объекта в этой части округа мы сразу уточняем точку работ (периметр нового корпуса или территория действующего стационара), запрашиваем контакт ответственного за пропуска у генподрядчика стройки и заранее закладываем маршрут подачи техники в объезд основных путей проезда скорой помощи. Общий порядок оформления пропуска на технику и бригаду — на <a href="/uslugi/kran-na-rezhimnyy-obekt/">основной странице услуги</a>, полный комплект документов — на странице <a href="/documents/propusk-na-obekt/">«Пропуск на объект»</a>. Логистику и специфику остальной части округа, включая деловые кварталы и историческую застройку, смотрите на <a href="/geo/cao/">гео-странице ЦАО</a>.</p>

    <h2 style="margin:36px 0 18px">Почему грунт здесь тоже стоит уточнять заранее</h2>
    <p>Монолитная стена в грунте на стройке нового корпуса — не единственная причина смотреть на геологию площадки внимательнее обычного: Большая Сухаревская площадь стоит на плотной исторической застройке с подземными коммуникациями возрастом в десятки лет, и расстояние от откоса любой действующей выемки до выносных опоры крана считается по приложению к правилам, а не на глаз. Если для вашей задачи нужен расчёт несущей способности площадки, разбор методики — в статье про <a href="/spravochnik/nesushchaya-sposobnost-grunta/">несущую способность грунта</a>.</p>
  </section>
  <section class="section wrap prose" style="padding-top:0">
    <Sources
      checked="19.08.2026"
      items={[
        { text: 'Российская газета — Собянин дал старт строительству нового комплекса НИИ скорой помощи имени Склифосовского: дата запуска 11.11.2025, технология «стена в грунте» глубиной 25 м, ход бетонных работ', href: 'https://rg.ru/2025/11/11/sobianin-dal-start-stroitelstvu-novogo-kompleksa-nii-skoroj-pomoshchi-imeni-sklifosovskogo.html' },
        { text: 'Профиль — первые этажи нового комплекса НИИ Склифосовского: площадь свыше 160 тыс. кв. м, срок сдачи 2028 год', href: 'https://profile.ru/news/society/pervye-etazhi-novogo-kompleksa-nii-sklifosovskogo-nachali-stroit-v-moskve-1872989/' },
        { text: 'Комплекс градостроительной политики и строительства Москвы — новый корпус НИИ им. Склифосовского с вертолётной площадкой: адрес Б. Сухаревская пл., д. 3, Мещанский район', href: 'https://stroi.mos.ru/news/nii-skoroi-pomoshchi-im-sklifosovskogho-poluchit-korpus-s-viertolietnoi-ploshchadkoi' },
        { text: 'Приказ Ростехнадзора от 26.11.2020 №461 (ред. от 16.04.2026): п. 111 — расстояние от откоса выемки до опор, п. 189 — запись в паспорт об освидетельствовании', href: 'https://www.consultant.ru/document/cons_doc_LAW_373321/' },
      ]}
      note="Внутренний регламент допуска на территорию действующего стационара и правила стройплощадки генподрядчика определяет сама эксплуатирующая организация — здесь приведён общий порядок для объектов такого профиля, а не выписка из внутреннего документа института."
    />
  </section>
</main>
<style>
  .adm { width: 100%; border-collapse: collapse; margin: 6px 0 0; font-size: var(--t-md); }
  .adm caption { text-align: left; font-family: var(--display); text-transform: uppercase; font-size: var(--t-sm); color: var(--yellow); letter-spacing: .06em; padding-bottom: 12px; }
  .adm th { text-align: left; font-size: var(--t-xs); text-transform: uppercase; letter-spacing: .06em; color: var(--muted); font-weight: 700; padding: 0 14px 8px 0; border-bottom: 1px solid var(--line-strong); }
  .adm td { padding: 13px 14px 13px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
  .adm td:first-child { width: 22%; font-weight: 700; }
  .adm td:last-child { width: 22%; color: var(--muted); font-size: var(--t-md); }
  @media (max-width: 760px) {
    .adm, .adm tbody, .adm tr, .adm td { display: block; width: 100%; }
    .adm thead { display: none; }
    .adm tr { border-bottom: 1px solid var(--line-strong); padding-bottom: 10px; margin-bottom: 10px; }
    .adm td { border: none; padding: 5px 0; }
    .adm td::before { content: attr(data-label); display: block; font-size: var(--t-xs); text-transform: uppercase; letter-spacing: .06em; color: var(--yellow); margin-bottom: 2px; }
    .adm td:first-child, .adm td:last-child { width: 100%; }
  }
</style>
</BaseLayout>
