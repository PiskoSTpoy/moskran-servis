---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Sources from '../../../../components/Sources.astro';

const title = 'Кран на режимный объект в СЗАО — Курчатовский институт';
const description = 'Кран на режимный объект в СЗАО: закрытая территория НИЦ «Курчатовский институт» на Щукинском полуострове и соседняя промзона «Октябрьское поле».';

const breadcrumbLd = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://moskran-servis.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Кран на режимный объект', item: 'https://moskran-servis.ru/uslugi/kran-na-rezhimnyy-obekt/' },
    { '@type': 'ListItem', position: 3, name: 'СЗАО', item: 'https://moskran-servis.ru/uslugi/kran-na-rezhimnyy-obekt/szao/' },
  ],
};
const serviceLd = {
  '@context': 'https://schema.org', '@type': 'Service', serviceType: 'Аренда автокрана с пропуском для режимных объектов СЗАО',
  provider: { '@id': 'https://moskran-servis.ru/#organization' }, areaServed: 'СЗАО, Москва',
};
---
<BaseLayout title={title} description={description} path="/uslugi/kran-na-rezhimnyy-obekt/szao/" ldExtra={[breadcrumbLd, serviceLd]}>
<main>
  <nav class="crumbs wrap" aria-label="Хлебные крошки">
    <a href="/">Главная</a><span>/</span><a href="/uslugi/kran-na-rezhimnyy-obekt/">Кран на режимный объект</a><span>/</span><span>СЗАО</span>
  </nav>
  <section class="section wrap" style="padding-top:8px">
    <div class="section-head">
      <span class="eyebrow">Режимный объект · Северо-Западный округ</span>
      <h1>Кран на режимный объект в СЗАО</h1>
      <p>Речь не о грунте прибрежной поймы — эта тема разобрана на странице услуги «Башенный кран в СЗАО». Здесь другой вопрос: район Щукино занимает промзона «Октябрьское поле» площадью 137,44 га, и в её границах находится головная территория НИЦ «Курчатовский институт» — федерального научного центра с единственным учредителем в лице Российской Федерации. Часть промзоны уже отдана под гражданскую застройку, часть остаётся закрытой территорией действующего института, и для крана это два разных пропускных режима на одном и том же адресном ориентире.</p>
    </div>
  </section>
  <section class="section wrap" style="padding-top:0;padding-bottom:clamp(28px,4vw,44px)">
    <table class="adm">
      <caption>Карточка допуска: режимный объект в СЗАО</caption>
      <thead><tr><th scope="col">Требование</th><th scope="col">Что это значит здесь</th><th scope="col">Основание</th></tr></thead>
      <tbody>
        <tr><td data-label="Требование">Какой это режим</td><td data-label="Что это значит здесь">Площадь Академика Курчатова, 1 — юридический адрес головной организации НИЦ «Курчатовский институт», федерального госучреждения с закрытой территорией. Соседние участки бывшей промзоны уже переданы под жильё, школу и технопарк с обычным девелоперским КПП.</td><td data-label="Основание">Регламент территории</td></tr>
        <tr><td data-label="Требование">Что согласуют дополнительно</td><td data-label="Что это значит здесь">Для работ на действующей территории института закладываем более длинный срок подачи данных на технику и бригаду, характерный для федеральных учреждений с ограниченным доступом. Для площадок в границах редевелопмента промзоны — обычный порядок субподрядчика по списку генподрядчика.</td><td data-label="Основание">Регламент территории</td></tr>
        <tr><td data-label="Требование">Что спрашивают на КПП</td><td data-label="Что это значит здесь">Паспорт машины со свежей записью об освидетельствовании и удостоверение оператора — базовый комплект, как на любом другом режимном объекте сети.</td><td data-label="Основание">ФНП №461, п. 189</td></tr>
        <tr><td data-label="Требование">Подъезд и логистика</td><td data-label="Что это значит здесь">Щукинский полуостров ограничен петлёй Москвы-реки: основной въезд — по улице Академика Курчатова от Волоколамского шоссе через Авиационную и Щукинскую улицы; к площадкам редевелопмента — со стороны улиц Максимова, Маршала Бирюзова, Расплетина и Берзарина.</td><td data-label="Основание">Схема территории</td></tr>
      </tbody>
    </table>
  </section>
  <section class="section wrap prose" style="padding-top:0">
    <h2 style="margin-bottom:18px">Закрытый институт и открытая под застройку промзона — на одной территории</h2>
    <p>Промзона «Октябрьское поле» занимает 137,44 га в границах районов Щукино и Хорошёво-Мнёвники — это, по определению самого Комплекса градостроительной политики и строительства Москвы, площадка, где находится «ядерное сердце» страны: головная территория НИЦ «Курчатовский институт», а также НИИ неорганических материалов и ряд производственных площадок. Из общей площади под редевелопмент отдано 47,34 га — та часть, где производство уже не действует: здесь строят жильё, школу на 800 мест, детский сад на 100 мест, поликлинику, технопарк и здание Хорошёвского суда, на территории между улицами Максимова, Берзарина и Маршала Бирюзова.</p>
    <p>Институт при этом сохраняет только те корпуса, которые использует напрямую для исследований, — именно это разделение и определяет, какая часть промзоны остаётся закрытой территорией с федеральным режимом допуска, а какая переходит под обычный пропускной режим строительной площадки девелопера. Для крана разница практична: на закрытой территории институт согласует допуск техники и бригады сам и по собственному регламенту, а на площадках редевелопмента действует стандартная процедура генподрядчика, которую мы проходим так же, как на любой другой московской стройке.</p>

    <h2 style="margin:36px 0 18px">Почему это не тот же случай, что пойма Строгина</h2>
    <p>На странице услуги «Башенный кран в СЗАО» разобран другой вопрос того же округа — расчёт фундамента для прибрежной площадки в Строгинской и Тушинской пойме, где ограничение чисто геологическое: грунт, уровень грунтовых вод, сезонные подвижки. У Щукина ограничение другого рода — не грунт, а статус территории и то, к какой из двух зон (закрытый институт или открытая под застройку промзона) относится точка работ. Оба фактора могут теоретически совпасть на одной площадке, но проверяются они разными способами и в разное время: статус территории — на этапе согласования пропуска, грунт — на этапе расчёта фундамента.</p>

    <h2 style="margin:36px 0 18px">Что мы учитываем при подготовке заявки</h2>
    <p>Для объекта на территории бывшей промзоны «Октябрьское поле» мы сразу уточняем, относится ли точка работ к действующей закрытой территории института или к одному из участков редевелопмента — это меняет и список требуемых документов, и реалистичный срок согласования. Общий порядок оформления пропуска на технику и бригаду — на <a href="/uslugi/kran-na-rezhimnyy-obekt/">основной странице услуги</a>, полный комплект документов — на странице <a href="/documents/propusk-na-obekt/">«Пропуск на объект»</a>. Если у вас задача на прибрежной площадке того же округа, а не в Щукине, — смотрите специфику грунта на странице услуги <a href="/uslugi/bashennyy-kran/szao/">«Башенный кран в СЗАО»</a>. Логистика и остальная застройка округа — на <a href="/geo/szao/">гео-странице СЗАО</a>.</p>
  </section>
  <section class="section wrap prose" style="padding-top:0">
    <Sources
      checked="21.08.2026"
      items={[
        { text: 'РИАМО — «Новая жизнь Октябрьского поля»: 137,44 га общая площадь промзоны, 47,34 га под редевелопмент, НИЦ «Курчатовский институт» в границах промзоны', href: 'https://riamo.ru/articles/aktsenty/novaya-zhizn-oktyabrskogo-polya-chto-poyavitsya-na-territorii-promzony-xl/' },
        { text: 'Rusprofile — НИЦ «Курчатовский институт»: юридический адрес пл. Академика Курчатова, д. 1, единственный учредитель — Российская Федерация', href: 'https://www.rusprofile.ru/id/2332600' },
        { text: 'Электронная Москва — площадь Академика Курчатова: пересечение улиц Маршала Василевского, Маршала Бирюзова, Академика Курчатова и Максимова', href: 'http://mosopen.ru/street/12810' },
        { text: 'Приказ Ростехнадзора от 26.11.2020 №461 (ред. от 16.04.2026): п. 189 — запись о техническом освидетельствовании в паспорт', href: 'https://www.consultant.ru/document/cons_doc_LAW_373321/' },
      ]}
      note="Внутренний регламент допуска на закрытую территорию действующего института определяет само учреждение — здесь приведён общий порядок для федеральных объектов такого профиля, а не выписка из внутреннего документа."
    />
  </section>
</main>
<style>
  .adm { width: 100%; border-collapse: collapse; margin: 6px 0 0; font-size: var(--t-md); }
  .adm caption { text-align: left; font-family: var(--display); text-transform: uppercase; font-size: var(--t-sm); color: var(--yellow); letter-spacing: .06em; padding-bottom: 12px; }
  .adm th { text-align: left; font-size: var(--t-xs); text-transform: uppercase; letter-spacing: .06em; color: var(--muted); font-weight: 700; padding: 0 14px 8px 0; border-bottom: 1px solid var(--line-strong); }
  .adm td { padding: 13px 14px 13px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
  .adm td:first-child { width: 22%; font-weight: 700; }
  .adm td:last-child { width: 22%; color: var(--muted); font-size: var(--t-md); }
  @media (max-width: 760px) {
    .adm, .adm tbody, .adm tr, .adm td { display: block; width: 100%; }
    .adm thead { display: none; }
    .adm tr { border-bottom: 1px solid var(--line-strong); padding-bottom: 10px; margin-bottom: 10px; }
    .adm td { border: none; padding: 5px 0; }
    .adm td::before { content: attr(data-label); display: block; font-size: var(--t-xs); text-transform: uppercase; letter-spacing: .06em; color: var(--yellow); margin-bottom: 2px; }
    .adm td:first-child, .adm td:last-child { width: 100%; }
  }
</style>
</BaseLayout>
